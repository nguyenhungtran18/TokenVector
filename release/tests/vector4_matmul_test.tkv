# -*- coding: utf-8 -*-
"""P5 (R7, 2026-09-28): matmul f32 4-lane tren f32x4, kiem dinh trong Testkit.

Viet kern matvector hoa bang `f32x4` va SO CHINH NO voi matmul scalar tuan
tu tren CUNG du lieu, ngay trong mot chuong trinh. Tu kiem nen khong can
Python - mau nay phai chay duoc trong co gate 62/62 cua compiler.

BAI TOAN PHAI LAM DUNG - DOC KY TRUOCC KHI SUA
--------------------------------------------
Binh thuong `r[i][j] = sum_k a[i][k] * b[k][j]` doc `b` theo COT: buoc nhay
la n, khong nap duoc bang lenh 16 byte. Nen BAT BUOC phai DONG GOI B theo
cot truoc: `pt[j*n+k] = b[k*n+j]`. Lan dau tinh tui nap `b[j*n+k]` (HAO) va
ket qua SAI HOAN TOAN, rel-err ~0.5 - va no trong nhu "SIMD kem chinh xac"
chứ khong phai "kernel doc sai truc". Dung sai 1e-5 bat ngay, nhung so sanh
chi tong se lot qua.

SO SANH DUNG SAI, KHONG SO CHUOI TUYET DOI
------------------------------------------
Day la NOI nghia float doi lan dau (P4). Phep cong 4 tich luy song song roi
gop mot lan cuoi khac thu tu cong tuan tu, nen ket qua LECH o bit cuoi. Bai
nay do DO LAI do lech thay vi doan: `rel = |got - want| / |want|`, chap nhan
neu `rel <= 1e-5` (do o P0: lech hop le <= 1.3e-07, mot loi that 1.8e-02 -
ngan cach 3-4 bac, nen co tri giu tot). Kiem tren TAT CA 1024 phan tu, khong
chi vai probe.
"""

# Ba so ham nay ton tai san cua bo Testkit: `test_summary` + `t` tu viet
# (khong dung tkv_test_lib: ham `check` cua no so sanh 2 CHUOI).


def t(c: "list[i32]", name: "str", got: "f32", expected: "f32") -> "i32":
    """1 ca kiem tra BIT-EXACT. Dung cho phan khong co cong don pho."""
    c[0] = c[0] + 1
    if got == expected:
        print("PASS " + name)
        return 0
    print("FAIL " + name + ": got " + str(got) + " expected " + str(expected))
    c[1] = c[1] + 1
    return 1


def t_approx(c: "list[i32]", name: "str", got: "f32", expected: "f32",
             tol: "f32") -> "i32":
    """1 ca kiem tra SAI SO TUONG DOI. `expected` co the bang 0 - khi do
    dung sai tuyet doi nho hon."""
    c[0] = c[0] + 1
    d = got - expected
    if d < 0.0:
        d = 0.0 - d
    m = expected
    if m < 0.0:
        m = 0.0 - m
    if m < 1.0:
        m = 1.0
    rel = d / m
    if rel <= tol:
        print("PASS " + name + " rel=" + str(rel))
        return 0
    print("FAIL " + name + ": rel=" + str(rel) + " > " + str(tol))
    c[1] = c[1] + 1
    return 1


def test_summary(suite_name: "str", total: "i32", failed: "i32") -> "i32":
    if failed == 0:
        print("ALL PASS " + suite_name + " (" + str(total) + " checks)")
        return 0
    print("FAILED " + suite_name + ": " + str(failed) + "/" + str(total))
    return 1


def _fill(n: "i32", pa: "i64", pb: "i64", pt: "i64", m: "i32") -> "i32":
    """Dung lieu giong het bench f32mm: a=(i%97)*0.1, b=(i%89)*0.07.
    Dien vao 3 con tro tho: `pa` a nguyen, `pb` b nguyen (giu de doi chieu),
    `pt` b DA DONG GOI THEO COT cho vector loop."""
    i = 0
    while i < m:
        av = (i % 97) * 0.1
        bv = (i % 89) * 0.07
        write_f32(pa, i * 4, av)
        write_f32(pb, i * 4, bv)
        i = i + 1
    i = 0
    while i < n:
        j = 0
        while j < n:
            write_f32(pt, (j * n + i) * 4, read_f32(pb, (i * n + j) * 4))
            j = j + 1
        i = i + 1
    return 0


def _mm_scalar(pa: "i64", pb: "i64", r: "list[f64]", n: "i32") -> "i32":
    """Matmul TUAN TU - doc b theo cot truc tiep (buoc nhay n), dung lam chuan."""
    i = 0
    while i < n:
        j = 0
        while j < n:
            s = 0.0
            k = 0
            while k < n:
                s = s + read_f32(pa, (i * n + k) * 4) * read_f32(pb, (k * n + j) * 4)
                k = k + 1
            r[i * n + j] = s
            j = j + 1
        i = i + 1
    return 0


def _mm_vector(pa: "i64", pt: "i64", r: "list[f64]", n: "i32") -> "i32":
    """Matmul 4-LANE: 1 tich luy vector, 1 lan goi v_hsum4 cho ca 32 buoc k."""
    i = 0
    while i < n:
        j = 0
        while j < n:
            acc = f32x4(0.0, 0.0, 0.0, 0.0)
            k = 0
            while k + 3 < n:
                va = v_load4(pa, (i * n + k) * 4)
                vb = v_load4(pt, (j * n + k) * 4)
                acc = acc + va * vb
                k = k + 4
            r[i * n + j] = v_hsum4(acc)
            j = j + 1
        i = i + 1
    return 0


def run() -> "i32":
    c = [0, 0]
    n = 32
    m = n * n
    pa = alloc_bytes(m * 4)
    pb = alloc_bytes(m * 4)
    pt = alloc_bytes(m * 4)
    _fill(n, pa, pb, pt, m)

    rs = []
    rv = []
    i = 0
    while i < m:
        rs.append(0.0)
        rv.append(0.0)
        i = i + 1

    _mm_scalar(pa, pb, rs, n)
    _mm_vector(pa, pt, rv, n)

    # Sai so tuong doi LON NHAT tren tat ca 1024 phan tu. Do bang mot vong
    # thay vi vai probe, de khong bo lo phan tu co lech lon nhat.
    worst = 0.0
    worst_at = 0
    i = 0
    while i < m:
        d = rv[i] - rs[i]
        if d < 0.0:
            d = 0.0 - d
        den = rs[i]
        if den < 0.0:
            den = 0.0 - den
        if den < 1.0:
            den = 1.0
        rel = d / den
        if rel > worst:
            worst = rel
            worst_at = i
        i = i + 1
    print("worst rel-err = " + str(worst) + " tai phan tu " + str(worst_at))
    t_approx(c, "mm4 lan toi da 1024 phan tu", worst, 0.0, 0.00001)

    # Va so sanh truc tiep tren mot vai diem de loi doc duoc
    t_approx(c, "r[0]", rv[0], rs[0], 0.00001)
    t_approx(c, "r[500]", rv[500], rs[500], 0.00001)
    t_approx(c, "r[1023]", rv[1023], rs[1023], 0.00001)

    # Kiem tra phan DONG GOI that su dung: doc lai pt tai 3 vi tri va doi
    # chieu voi pb. Neu `_fill` dong goi sai, vector se doc sai truc ma
    # `worst` se lon - kiem nay bat luon ngay o tap dau.
    t(c, "pt dong goi cot (0,0)", read_f32(pt, 0), read_f32(pb, 0))
    t(c, "pt dong goi cot (0,1)", read_f32(pt, 4), read_f32(pb, n * 4))
    t(c, "pt dong goi cot (1,0)", read_f32(pt, n * 4), read_f32(pb, 4))

    free_bytes(pa)
    free_bytes(pb)
    free_bytes(pt)
    return test_summary("vector4_matmul_test", c[0], c[1])


def main() -> "i32":
    return run()
