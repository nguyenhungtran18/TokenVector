# -*- coding: utf-8 -*-
# GHI NHAN LOI AM THANH cua compiler (2026-09-30).
#
# `datetime()` la ham tra ve thoi diem hien tai (UtcNow) va KHONG tham so.
# `_push_datetime_now` nhan `args` roi BO QUA hoan toan, nen
# `datetime(2026, 9, 30)` - cach Python TAO NGAY - bien dich xanh va tra ve
# Hom nay. Day la dang sai AM THANH: nguoi dung tinh sai ngay ma khong co loi
# bao. Nay no phai loi bien dich noi ro cach tao ngay dung.
#
# Do la bai hoc: mot ham co the "co ten" va "co dang ky" nhung van tra sai am
# thanh. Ten co KHONG chung minh dung - phai doi chieu CPython.
__tkv_import__ = ["tkv_test_lib"]


def run() -> "i32":
    total = 0
    tested = 0

    # --- datetime() 0 tham so: van chay dung ---
    d = datetime()
    n = datetime_ticks(d)
    # str(bool) in ra "True"/"False" - KHONG phai "1"/"0". Da doi chieu
    # CPython 2026-09-30: ca `str(x > 0)` va `str(x)` deu ra "True".
    # (CLAUDE.md tung viet nguoc lai, da sua)
    positive = n > 0
    tested = tested + 1
    total = total + check("datetime_now_is_i64", str(positive), "True")
    s = d.strftime("%Y-%m-%d")
    tested = tested + 1
    total = total + check("datetime_strftime_len", str(len(s)), "10")
    # 2026-09-30 - chuoi ngay luon 10 ky tu cho du 4 so nam
    tested = tested + 1
    total = total + check("datetime_strftime_dash4", str(s[4]), "-")
    tested = tested + 1
    total = total + check("datetime_strftime_dash7", str(s[7]), "-")

    # --- datetime_ticks -> strftime khop nhau (ve chieu doc) ---
    d2 = datetime()
    s2 = d2.strftime("%Y-%m-%d")
    tested = tested + 1
    total = total + check("datetime_roundtrip_len", str(len(s2)), "10")

    # --- ve khong the tao ngay tu so: phai bao loi BIEN DICH ---
    # (xac nhan o negative suite: `datetime(2026, 9, 30)` phai fail build)
    print("expected_build_fail: datetime(2026, 9, 30)")

    return test_summary("datetime_arg_test", total, tested)