# -*- coding: utf-8 -*-
# Ghim cac sua cua vong do 12 mien chua co phep thu nao (2026-09-30):
#   1. f-string voi spec dang SO NGUYEN - truoc do bi phat ra NGUYEN VAN
#   2. int("...") vuot Int64 - truoc do nem OverflowException luc chay
# Gia tri ky vong lay truc tiep tu CPython.
__tkv_import__ = ["tkv_test_lib"]


def run() -> "i32":
    total = 0
    tested = 0
    n = 42
    x = 3.14159

    # --- 1. f-string spec so nguyen ---
    tested = tested + 1
    total = total + check("fs_plain", f"{n}", "42")
    tested = tested + 1
    total = total + check("fs_zeropad", f"{n:05d}", "00042")
    tested = tested + 1
    total = total + check("fs_plus", f"{n:+d}", "+42")
    tested = tested + 1
    total = total + check("fs_hex_lower", f"{n:x}", "2a")
    tested = tested + 1
    total = total + check("fs_hex_upper", f"{n:X}", "2A")
    tested = tested + 1
    total = total + check("fs_float_prec", f"{x:.2f}", "3.14")
    tested = tested + 1
    total = total + check("fs_mixed", f"n={n} x={x:.3f}", "n=42 x=3.142")

    # --- 2. int vuot Int64: phai ra dung BigInteger ---
    big = int("123456789012345678901234567890")
    tested = tested + 1
    total = total + check("big_add", str(big + 1), "123456789012345678901234567891")
    tested = tested + 1
    total = total + check("big_sub", str(big + 1 - big), "1")
    tested = tested + 1
    total = total + check("big_neg", str(int("-99999999999999999999")), "-99999999999999999999")
    tested = tested + 1
    total = total + check("i64_lit", str(int("2147483648")), "2147483648")
    tested = tested + 1
    total = total + check("small_ok", str(int("42") + 1), "43")

    return test_summary("fstring_bigint_test", total, tested)
