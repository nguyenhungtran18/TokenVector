__tkv_import__ = ["tkv_test_lib"]


class Point:
    x: "i32"
    y: "i32"

    def __eq__(self, other: "Point") -> "i32":
        if self.x == other.x:
            if self.y == other.y:
                return 1
        return 0


class Base:
    val: "i32"

    def __eq__(self, other: "Base") -> "i32":
        if self.val == other.val:
            return 1
        return 0


class Sub(Base):
    extra: "i32"


class NoEq:
    v: "i32"


def run() -> "i32":
    total = 0
    tested = 0

    p1 = Point(1, 2)
    p2 = Point(1, 2)
    p3 = Point(9, 9)
    tested = tested + 1
    total = total + check("eq_same_content", str(p1 == p2), "True")
    tested = tested + 1
    total = total + check("eq_diff_content", str(p1 == p3), "False")
    tested = tested + 1
    total = total + check("ne_uses_eq_negated", str(p1 != p3), "True")

    s1 = Sub(5, 10)
    s2 = Sub(5, 20)
    tested = tested + 1
    total = total + check("inherited_dunder_eq", str(s1 == s2), "True")

    n1 = NoEq(7)
    n2 = NoEq(7)
    tested = tested + 1
    total = total + check("no_eq_reference_compare", str(n1 == n2), "False")

    return test_summary("dunder_eq_test", total, tested)
