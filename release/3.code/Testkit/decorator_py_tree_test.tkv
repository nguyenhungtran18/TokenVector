__tkv_import__ = ["tkv_test_lib"]


def logged(f: "func(i32)->i32") -> "func(i32)->i32":
    def wrapper(x: "i32") -> "i32":
        print("calling")
        return f(x)
    return wrapper


@logged
def square(x: "i32") -> "i32":
    return x * x


def doubled(f: "func(i32)->i32") -> "func(i32)->i32":
    def wrapper(x: "i32") -> "i32":
        return f(x) * 2
    return wrapper


@doubled
def add_one(x: "i32") -> "i32":
    return x + 1


def run() -> "i32":
    total = 0
    tested = 0

    tested = tested + 1
    total = total + check("decorated_square", str(square(5)), "25")

    tested = tested + 1
    total = total + check("decorated_doubled_add_one", str(add_one(3)), "8")

    return test_summary("decorator_py_tree_test", total, tested)
