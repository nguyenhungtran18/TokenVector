# -*- coding: utf-8 -*-
"""Ham Python THAT tuong duong json_dumps() cua DSL (Wave 2, 2026-07-29) -
dung cho .tkv 'import' (bi extract_program() bo qua luc bien dich, CHI de
file chay duoc duoi CPython that de doi chieu). separators=(',', ':') de
khop dinh dang GON (khong khoang trang) ma DSL sinh ra."""
import json


def json_dumps(x):
    return json.dumps(x, separators=(',', ':'))
