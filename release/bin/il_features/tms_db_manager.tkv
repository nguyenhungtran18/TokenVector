def ensure_db_manager_class(ctx):
    emitted = ctx.get('emitted_types')
    if emitted is not None and 'TmsDbManager' in emitted:
        return
    if emitted is not None:
        emitted.add('TmsDbManager')
    ctx['extra_classes'].append(_DB_MANAGER_CLASS_IL)


def _push_launch_tms_db_manager(args, scope, out, dtype, ctx):
    ensure_db_manager_class(ctx)
    out.append('    call void TmsDbManager::ShowGui()')
    out.append('    ldc.i4.0')

register_expr_builtin('launch_tms_db_manager', _push_launch_tms_db_manager, 'i32')
