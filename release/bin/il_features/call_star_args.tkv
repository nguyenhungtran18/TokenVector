# -*- coding: utf-8 -*-
"""`f(*xs)` va `f(**kw)` - truyen lap tham so tai DIEM GOI HAM (2026-09-29).

TokenVector bien dich loi goi ham thanh lenh IL `call` voi so tham so
TINH, kiem ngay voi chu ky luc bien dich. `f(*xs)`/`f(**kw)` pha vo chinh
quy tac do. Thay vi doi mo hinh arity (param mang + count - lon, cham,
dong va khong phu hop AOT), lan nay lam DESUGAR tai diem goi: khi thong
tin cua nguon BIET DUOC LUC BIEN DICH, `f(*xs)` duoc noi thanh DUNG N doi
so co dinh roi moi di tiep vao duong `call` da co. Moi so tham so, kiem
tra arity, tham so mac dinh va monomorphize vay ma chay tren danh sach N
doi so da noi - dung y nguyen trang truoc khi ma hoa.

Module nay chay 1 LAN cho moi than ham, ngay TRUOC first-pass (xem
`_first_pass_collect_locals` cua il_codegen) va sua TAI CHO node cua
cay lenh DSL trong cho. Lam vay moi duoc moi vi tri goi: bieu thuc,
`y = f(*xs)`, lenh doc lap `f(*xs)`, goi method `o.m(*xs)`, goi ham long,
va long trong moi bieu thuc (chuoi, danh sach, so sanh, ...) - vi
`expand_star_args_in_stmts` quet SAY cay chứ không dò từng câu lệnh.

NGUON DUOC CHAP NHAN (thong tin TINH):

- `f(*[1, 2, 3])` - list literal ngay tai chinh loi goi: noi thang cac
  phan tu literal vao danh sach doi so, khong can doc list nao;
- `xs = [1, 2, 3]` roi `f(*xs)` - bien duoc gan DUNG MOT list literal
  trong ham nay (`kind` = `assign_list_literal`) va KHONG duoc xuat hien o
  cho khac, nen do dai khong the doi duoc giua khi bien dich. Khi do sinh
  `xs[0]`, `xs[1]`, ... bang node `('index', ten, [('num', 'i')])`;
- `f(**{"a": 1})` va `kw = {"a": 1}` roi `f(**kw)` - tuong ung cho dict
  literal. `**` sinh node `('kwarg', ten_tham_so, gia_tri)` - DUNG DINH
  DANG ma `kwarg_resolve` da xu ly san (sap xep theo chu ky, lap mac
  dinh, bao trung ten, bao khoa la), nen khong viet lai duong phan giai
  tham so moi. Doc gia tri truc tiep tu bien bang `('index', ten, [khoa])`.

NGUON CON LAI bi tu choi RO RANG: bien do ra tu ham, list rong + `.append()`,
`{}` + `d["k"] = ...`, tham so, bien module, bien duoc gan lai, bien bi
dung o cho khac, khoa dict khong phai chuoi literal. Ly do co chu dich: AOT
khong the dem phan tu / doc khoa 1 container luc chay ma van phai sua
chu ky `call` luc bien dich; do la gioi han cua "arity tinh", khong phai
loi soi.

Gioi han LIEN QUAN (khong phai cua `**`): ham nhan `*args`/`**kwargs` trong
CHU KY thi khong duoc goi bang keyword argument - ca `f(a=1)` lan
`f(**kw)`. Quy tac do thuoc `kwarg_resolve`, giong het CPython.
"""


# Node cua loi goi ham: PHAI DUOI CUNG la danh sach tham so
#   ('call', ten, args) / ('method_call', obj, meth, args)
#   ('method_call_expr', base, meth, args)
# Xem parse_factor cua il_core (node 'call') va _POSTFIX_METHOD_BASES.
_CALL_HEADS = ('call', 'method_call', 'method_call_expr')


def _has_star(node):
    """Co node ('star', ...) / ('star2', ...) nao trong cay khong?"""
    if isinstance(node, tuple):
        if node and (node[0] == 'star' or node[0] == 'star2'):
            return True
        for part in node:
            if _has_star(part):
                return True
        return False
    if isinstance(node, list):
        for part in node:
            if _has_star(part):
                return True
        return False
    if isinstance(node, dict):
        for value in node.values():
            if _has_star(value):
                return True
    return False


def _all_strings(node, out):
    """Gom MOI chuoi xuat hien trong cay lenh (hoa cac khoa dict).

    Co y do dung: bien nao THAT su duoc doc/gan deu phai xuat hien bang
    CHUOI o dau nao do trong cay. Gom ca khoa dict (bi thua) chi lam
    phep loai bo nhieu hon - an toan, vi thieu mot lan xuat hien se
    khong phat hien duoc.
    """
    if isinstance(node, str):
        out.add(node)
    elif isinstance(node, tuple):
        for part in node:
            _all_strings(part, out)
    elif isinstance(node, list):
        for part in node:
            _all_strings(part, out)
    elif isinstance(node, dict):
        for key, value in node.items():
            out.add(key)
            _all_strings(value, out)
    return out


def _each_stmt(stmts):
    """Sinh ra TUNG lenh (dict) cua cay, ke ca lenh nam trong than
    if/for/while/try/... - dung de quet toan bo ham 1 lan."""
    if not stmts:
        return
    for stmt in stmts:
        if not isinstance(stmt, dict):
            continue
        yield stmt
        for key in ('body', 'else_body', 'handlers', 'finally_body'):
            found = _each_stmt(stmt.get(key))
            if found is not None:
                for inner in found:
                    yield inner


def _star_var_names(stmts):
    """Tap ten bien duoc lam nguon `*` (dung `('star', ('var', ten))`).

    Ten bi lay o MOI noi xuat hien - 1 bien co the la nguon `*` o nhieu
    loi goi trong cung ham, va moi noi deu duoc kiem chung nhu nhau.
    """
    names = set()

    def visit(node):
        if isinstance(node, tuple):
            if len(node) == 2 and (node[0] == 'star' or node[0] == 'star2'):
                src = node[1]
                if isinstance(src, tuple) and src and src[0] == 'var':
                    names.add(src[1])
                    return
            for part in node:
                visit(part)
        elif isinstance(node, list):
            for part in node:
                visit(part)
        elif isinstance(node, dict):
            for value in node.values():
                visit(value)

    for stmt in _each_stmt(stmts):
        visit(stmt)
    return names


def _holds_star_of(node, name):
    """Cay `node` co chua dung nguon `*<name>` hay `**<name>` khong?"""
    found = []

    def visit(n):
        if isinstance(n, tuple):
            if len(n) == 2 and (n[0] == 'star' or n[0] == 'star2'):
                src = n[1]
                if isinstance(src, tuple) and src and src[0] == 'var' and src[1] == name:
                    found.append(True)
                    return
            for part in n:
                visit(part)
        elif isinstance(n, list):
            for part in n:
                visit(part)
        elif isinstance(n, dict):
            for value in n.values():
                visit(value)

    visit(node)
    return bool(found)


def _static_srcs(stmts, func_name):
    """{ten bien: ('list', phan tu) | ('dict', cap khoa-gia tri)} cho bien
    nguon `*`/`**` co thong tin TINH khi bien dich.

    Quy tac CHI NHAN 2 dang dinh nghia, va chi mot lan:
    - `ten = [a, b, c]` (`kind` = `assign_list_literal`) cho `*`;
    - `ten = {"a": 1}` (`kind` = `assign_dict_literal`) cho `**`.
    Ten do KHONG duoc xuat hien o lenh nao khac. Moi quy tac deu vi tri:
    sai 1 lan la sinh ra so tham so sai HOAC gan sai tham so - nen phai
    CHAC chan chu khong phai 'thuong cham'.

    Tra ve {} khi khong co bien nao lam nguon.
    """
    wanted = _star_var_names(stmts)
    if not wanted:
        return {}
    defined = {}
    for stmt in _each_stmt(stmts):
        name = stmt.get('name')
        if name not in wanted:
            continue
        kind = stmt.get('kind')
        if kind == 'assign_list_literal':
            data = ('list', stmt.get('elements') or [])
        elif kind == 'assign_dict_literal':
            data = ('dict', stmt.get('pairs') or [])
        else:
            raise SyntaxError(
                f"il_codegen: nguon '*'/'**' phai la list/dict literal: '{name}' "
                f"trong ham '{func_name}' duoc gan bang '{kind}' - chi "
                f"'ten = [a, b, c]' / 'ten = {{\"a\": 1}}' (literal MOT dong) moi "
                f"cho thong tin tinh khi bien dich")
        if name in defined:
            raise SyntaxError(
                f"il_codegen: nguon '*'/'**' phai la list/dict literal: '{name}' "
                f"trong ham '{func_name}' bi gan LAI nhieu lan - chi gan 1 literal duoc")
        defined[name] = data
    for name in sorted(wanted):
        if name not in defined:
            raise SyntaxError(
                f"il_codegen: nguon '*'/'**' phai la list/dict literal: '{name}' "
                f"trong ham '{func_name}' khong duoc gan bang literal nao - so phan "
                f"tu/khoa phai tinh duoc luc bien dich")
    for stmt in _each_stmt(stmts):
        name = stmt.get('name')
        is_def = (stmt.get('kind') in ('assign_list_literal', 'assign_dict_literal')
                  and name in wanted)
        strings = _all_strings(stmt, set())
        for candidate in wanted:
            if candidate not in strings:
                continue
            if is_def and candidate == name:
                continue
            if _holds_star_of(stmt, candidate):
                continue
            raise SyntaxError(
                f"il_codegen: nguon '*'/'**' phai la list/dict literal: '{candidate}' "
                f"trong ham '{func_name}' bi DUNG o cho khac - chi chu nhan "
                f"'ten = [...]'/'ten = {{...}}' roi dung ngay trong 'f(*ten)'/"
                f"'f(**ten)' (truong hop nay do dai co the doi len giua khi bien dich)")
    return dict(defined)


def _str_lit_text(node):
    """Gia TRI chuoi cua node `('str_lit', '"a"')` (dau nhay double lam bang
    chuoi nhu `tkv.py` doc noi dung) - None neu khong phai literal chuoi."""
    if not (isinstance(node, tuple) and len(node) == 2 and node[0] == 'str_lit'
            and isinstance(node[1], str)):
        return None
    text = node[1]
    if len(text) >= 2 and text[0] == '"' and text[-1] == '"':
        return text[1:-1]
    return text


def _kwarg_nodes_from_pairs(pairs, func_name, desc, src_name):
    """[(khoa_node, gia_tri_node)] -> [('kwarg', ten_tham_so, gia_tri)].

    Node `('kwarg', ...)` dung DUNG dinh dang ma `kwarg_resolve` xu ly san
    (sap xep theo chu ky, lap mac dinh, bao trung ten/khoa la) - nen `**`
    khong can viet lai 1 duong phan giai tham so moi.
    """
    out = []
    seen = set()
    for k_node, v_node in pairs:
        key = _str_lit_text(k_node)
        if key is None:
            raise SyntaxError(
                f"il_codegen: nguon '**' phai co khoa CHUOI tinh: '{desc}' trong ham "
                f"'{func_name}' - '**{src_name}' co khoa khong phai chuoi literal, "
                f"nen khong gan duoc vao tham so nao luc bien dich")
        if key in seen:
            raise SyntaxError(
                f"il_codegen: nguon '**' co khoa trung ten: '{desc}' trong ham "
                f"'{func_name}' - '{key}' xuat hien 2 lan trong '{src_name}'")
        seen.add(key)
        out.append(('kwarg', key, v_node))
    return out


def _expand_args(args, srcs, func_name, desc):
    """Noi danh sach tham so: thay ('star', nguon) / ('star2', nguon) bang
    cac phan tu that.

    Sau khi noi xong, MOI tham so con lai deu duoc quet tiep voi
    `_expand_node` - can thiet: `f3(*[1, 2])` va `f(str(g(*[3, 4])))` deu
    co loi goi long HON danh sach tham so vua duoc noi.
    """
    flat = []
    for arg in args:
        is_star = (isinstance(arg, tuple) and len(arg) == 2
                   and (arg[0] == 'star' or arg[0] == 'star2'))
        if not is_star:
            flat.append(arg)
            continue
        want_list = (arg[0] == 'star')
        src = arg[1]
        want_kind = 'list' if want_list else 'dict'
        want_text = 'list' if want_list else 'dict'
        if isinstance(src, tuple) and src and src[0] in ('list_literal', 'dict_literal'):
            got_kind = 'list' if src[0] == 'list_literal' else 'dict'
            if got_kind != want_kind:
                raise SyntaxError(
                    f"il_codegen: nguon '{'*' if want_list else '**'}' phai la "
                    f"{want_text} literal: '{desc}' trong ham '{func_name}' - nguon "
                    f"la {got_kind} literal, sai dang")
            if want_list:
                flat.extend(src[1])
            else:
                flat.extend(_kwarg_nodes_from_pairs(
                    src[1], func_name, desc, 'dict literal'))
            continue
        if isinstance(src, tuple) and src and src[0] == 'var':
            name = src[1]
            found = srcs.get(name)
            if found is None or found[0] != want_kind:
                raise SyntaxError(
                    f"il_codegen: nguon '{'*' if want_list else '**'}' phai la "
                    f"{want_text} literal: '{desc}' trong ham '{func_name}' - bien "
                    f"'{name}' khong duoc gan bang 1 {want_text} literal duy nhat")
            if want_list:
                for i in range(len(found[1])):
                    flat.append(('index', name, [('num', str(i))]))
            else:
                # Doc truc tiep tu bien: ('index', ten, [khoa]) - dung key
                # node GOC cua dict literal nen gia tri khoa giong het.
                flat.extend(_kwarg_nodes_from_pairs(
                    [(k_node, ('index', name, [k_node])) for k_node, _v in found[1]],
                    func_name, desc, name))
            continue
        raise SyntaxError(
            f"il_codegen: nguon '{'*' if want_list else '**'}' phai la {want_text} "
            f"literal: '{desc}' trong ham '{func_name}' - chi nhan 'f(*{want_text}"
            f"literal)' hoac bien duoc gan 1 {want_text} literal")
    return [_expand_node(part, srcs, func_name, desc) for part in flat]


def _expand_node(node, srcs, func_name, desc):
    if isinstance(node, tuple):
        head = node[0] if node else None
        if head in _CALL_HEADS and node and isinstance(node[-1], list):
            return node[:-1] + (_expand_args(node[-1], srcs, func_name, desc),)
        if len(node) == 2 and (head == 'star' or head == 'star2'):
            raise SyntaxError(
                f"il_codegen: ham '{func_name}' - con node '{head}' chua duoc noi; "
                f"chi dung trong danh sach tham so cua 1 loi goi ham")
        return tuple(_expand_node(part, srcs, func_name, desc) for part in node)
    if isinstance(node, list):
        return [_expand_node(part, srcs, func_name, desc) for part in node]
    if isinstance(node, dict):
        result = {}
        for key, value in node.items():
            if key == 'args' and isinstance(value, list):
                result[key] = _expand_args(value, srcs, func_name, desc)
            else:
                result[key] = _expand_node(value, srcs, func_name, desc)
        return result
    return node


def expand_star_args_in_stmts(stmts, func_name='?'):
    """Goi 1 LAN cho moi than ham, ngay TRUOC first-pass.

    Tra ve True neu co sua doi (de goi duong danh sach lenh nhe nhat khi
    chuong trinh khong dung `*`/`**` nao - nhanh O(1) qua `_has_star`).
    """
    if not _has_star(stmts):
        return False
    srcs = _static_srcs(stmts, func_name)
    for stmt in _each_stmt(stmts):
        kind = stmt.get('kind')
        expanded = _expand_node(stmt, srcs, func_name, f"lenh '{kind}'")
        stmt.clear()
        stmt.update(expanded)
    return True
