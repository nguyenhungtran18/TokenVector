# -*- coding: utf-8 -*-
"""Sinh / kiem tra muc 7 cua `docs/REFERENCE.md` (danh muc ten da dang ky).

Chuyen tu `gen_builtin_ref.py` sang TokenVector (2026-10-12). Ban Python dung
`ast.parse` de doc cac dict `STR_METHODS` / `*_METHODS`; ban nay quet VAN BAN -
TokenVector khong co module `ast` va dung `ast` thi phai chay CPython, trai yeu
cau repo nay sach hoan toan khi TokenVector da tu host.

Cach dung (tu goc repo):
    dist\\tkvc-tv.exe tools\\gen_builtin_ref.tkv <out.exe> run
    dist\\tkvc-tv.exe tools\\gen_builtin_ref.tkv <out.exe> run --check

Chi ghi giua 2 MARKER `<!-- BEGIN GENERATED ... -->` / `<!-- END GENERATED -->`.
THIEU marker thi FAIL, khong ghi de tai lieu.
"""


def _co_ten(n: "str") -> "bool":
    return 1 if n.find("METHODS") >= 0 else 0


def quet_dict_methods(src: "str", want_str: "bool") -> "list[str]":
    """Khoa cac dict `*METHODS*` trong 1 file.

    `want_str` = 1 lay khoi cua khoi ten chua 'STR_METHOD' (dung voi
    `STR_METHODS` / `STR_METHODS_EXTRA` / `STR_METHODS_EXTRA2`),
    `want_str` = 0 lay cac khoi con lai (`LIST_METHODS`, `DICT_METHODS`,
    `MATCH_METHODS`, `DATE_METHODS`, ...).

    Nhan dang khoi: dong mo `TEN... = {` hoac `TEN... =` roi `{` o dong sau,
    voi TEN chua 'METHODS' va khong phai comment/import. Khoa la cac dong
    tiep theo dang `'khoa':` cho den khi gap dong bat dau bang `}`.
    """
    ra: "list[str]" = []
    lines = src.split(chr(10))
    trong = 0
    la_str_khoi = 0
    for ln in lines:
        s = ln.strip()
        if trong == 0:
            if s == "" or s.startswith("#"):
                continue
            if s.startswith("from ") or s.startswith("import "):
                continue
            if s.find("METHODS") < 0:
                continue
            if s.endswith("{") or s.endswith("="):
                trong = 1
                # kieu cua khoi QUYET DINH o dong khai bao, khong phai o dong
                # khoa. Dong khoa (`'upper': fn`) khong chua 'STR_METHOD' nen
                # neu so o day, ca STR_METHODS lot sang nhom container.
                la_str_khoi = 1 if s.find("STR_METHOD") >= 0 else 0
            continue
        if s.startswith("}"):
            trong = 0
            continue
        if s == "" or s.startswith("#"):
            continue
        q1 = s.find("'")
        if q1 != 0:
            continue
        q2 = s.find("'", q1 + 1)
        if q2 < 0:
            continue
        khoa = s[q1 + 1:q2]
        if khoa == "":
            continue
        if la_str_khoi == want_str:
            ra.append(khoa)
    return ra


def _push(dst: "list[str]", ten: "str") -> "i32":
    """Them `ten` vao `dst` neu chua co. Tra 1 neu da them."""
    for x in dst:
        if x == ten:
            return 0
    dst.append(ten)
    return 1


def _patterns() -> "list[str]":
    """Cac regex, moicai dung LOOKBEHIND de `re_findall` tra ve DUNG ten.

    Da sua de nhan CA HAI chu ky goi:
        compiler Python      register_expr_builtin('ten', ...)
        compiler TokenVector register_expr_builtin(reg, 'ten', ...)
    """
    return [
        "(?<=register_expr_builtin\\(\\s*(?:reg\\s*,\\s*)?')([A-Za-z_]\\w*)",
        "(?<=register_line_parser\\(\\s*(?:reg\\s*,\\s*)?')([\\w]*)",
        "(?<=register_assign_rhs_parser\\(\\s*(?:reg\\s*,\\s*)?')([\\w]*)",
        "(?<=register_stmt_codegen\\(\\s*(?:reg\\s*,\\s*)?')([\\w]*)",
        "(?<=register_macro_expander\\(\\s*(?:reg\\s*,\\s*)?')([\\w]*)",
        "(?<=register_dunder_method\\(\\s*(?:reg\\s*,\\s*)?')([\\w]*)",
        "register_expr_method\\(\\s*(?:reg\\s*,\\s*)?'\\w*'\\s*,\\s*'\\w*'",
    ]


def _nhom(i: "i32") -> "str":
    if i == 0:
        return "HAM BUILTIN (GOI DUOC TRUC TIEP)"
    if i == 1:
        return "DANG CAU LENH (MACRO CAP DONG)"
    if i == 2:
        return "DANG PHAI PHAI CUA PHE GAN"
    if i == 3:
        return "KIEU CAU LENH (SINH IL)"
    if i == 4:
        return "MACRO VIET TAY"
    if i == 5:
        return "DUNDER CUA RECORD"
    return "METHOD THEO KHU VUC"


def _doc_facing(nhom: "str") -> "bool":
    # Cac nhom `REFERENCE.md` phai giai thich TUNG ten (muc 2 + 3 + 4).
    # Con lai la khoa noi bo cua trinh bien dich - muc 1 / §6 mo ta theo HO.
    if nhom == "HAM BUILTIN (GOI DUOC TRUC TIEP)":
        return 1
    if nhom == "METHOD CHUOI (qua dict STR_METHODS)":
        return 1
    if nhom == "METHOD THEO KHU VUC":
        return 1
    if nhom == "METHOD CONTAINER (ten, dung chung nhieu kieu)":
        return 1
    if nhom == "DANG PHAI PHAI CUA PHE GAN":
        return 1
    return 0


def _owner_method(m: "str") -> "str":
    """Tu mot khop `register_expr_method(reg, 'dict', 'items'` lay `dict.items`.

    Regex khong the trả ve ca 2 nhom cap - chi giu nhom cuoi. Nên phai tach
    chuoi: `owner` la chuoi trich dan DAU, `method` la chuoi thu HAI.
    """
    q1 = m.find("'")
    if q1 < 0:
        return ""
    q2 = m.find("'", q1 + 1)
    if q2 < 0:
        return ""
    owner = m[q1 + 1:q2]
    q3 = m.find("'", q2 + 1)
    if q3 < 0:
        return ""
    q4 = m.find("'", q3 + 1)
    if q4 < 0:
        return ""
    meth = m[q3 + 1:q4]
    if owner == "" or meth == "":
        return ""
    return owner + "." + meth


def run() -> "i32":
    # LUU Y: TokenVector chi cho PHAI HANG SO (so) o cap module - chuoi thi
    # khong. Do do moi duong dan/marker la bien CUC BO o day.
    feat = "compiler_bootstrap/compiler/il_features"
    out = "docs/REFERENCE.md"
    begin = "<!-- BEGIN GENERATED: danh muc ten + danh sach file -->"
    end = "<!-- END GENERATED -->"
    argv = sys_argv()
    check = 0
    # `sys_argv()[0]` la duong dan chuong trinh, doi so nguoi dung tu [1].
    ai = 1
    while ai < len(argv):
        if argv[ai] == "--check":
            check = 1
        ai = ai + 1
    files = sorted(os_list_files(feat))
    patterns = _patterns()
    buckets: "dict[str,list[str]]" = {}
    ten_file: "list[str]" = []
    for p in files:
        if path_suffix(p) != ".tkv":
            continue
        fn = path_basename(p)
        ten_file.append(fn)
        src = path_read_text(p)
        pi = 0
        while pi < len(patterns):
            nhom = _nhom(pi)
            if buckets.get(nhom) == None:
                buckets[nhom] = []
            cur = buckets[nhom]
            hits = re_findall(patterns[pi], src)
            hi = 0
            while hi < len(hits):
                if pi == 6:
                    nm = _owner_method(hits[hi])
                    if nm != "":
                        _push(cur, nm)
                else:
                    _push(cur, hits[hi])
                hi = hi + 1
            pi = pi + 1
        nhom_s = "METHOD CHUOI (qua dict STR_METHODS)"
        if buckets.get(nhom_s) == None:
            buckets[nhom_s] = []
        cur_s = buckets[nhom_s]
        khoas = quet_dict_methods(src, 1)
        ki = 0
        while ki < len(khoas):
            _push(cur_s, "str." + khoas[ki])
            ki = ki + 1
        nhom_c = "METHOD CONTAINER (ten, dung chung nhieu kieu)"
        if buckets.get(nhom_c) == None:
            buckets[nhom_c] = []
        cur_c = buckets[nhom_c]
        khoac = quet_dict_methods(src, 0)
        kci = 0
        while kci < len(khoac):
            _push(cur_c, khoac[kci])
            kci = kci + 1
    if not path_exists(out):
        print("THIEU " + out)
        return 2
    text = path_read_text(out)
    b_at = text.find(begin)
    e_at = text.find(end)
    if b_at < 0 or e_at < 0:
        print("KHONG THAY MARKER trong " + out)
        print("  Can dong: " + begin)
        print("  va dong: " + end)
        print("Script KHONG ghi de tai lieu - hay them marker roi chay lai.")
        return 2
    if check == 1:
        hand = text[0:b_at] + text[e_at:]
        # `re_findall` tra ve TOAN BO match, khong phai nhom bat - nen phai
        # dung lookbehind/dahead de match CHINH LA ten, bo cap backtick. Neu
        # de literal `` `...` `` trong pattern thi ket qua se la "`foo`" con
        # `need` la "foo" - khong khop gi ca va bao "chua ghi ten nao".
        seen = re_findall("(?<=`)([A-Za-z_]\\w*(?:\\.[a-z_]+)?)(?=`)", hand)
        need: "list[str]" = []
        for key in sorted(buckets.keys()):
            if _doc_facing(key) == 0:
                continue
            for x in buckets[key]:
                _push(need, x)
        missing: "list[str]" = []
        for x in need:
            co = 0
            for y in seen:
                if y == x:
                    co = 1
            if co == 0:
                missing.append(x)
        if len(missing) > 0:
            print("REFERENCE.md CHUA GHI " + str(len(missing)) + " ten da dang ky:")
            for x in missing:
                print("  - " + x)
            return 1
        print("REFERENCE.md: " + str(len(need)) + "/" + str(len(need)) + " ten da duoc ghi.")
        return 0
    body: "list[str]" = []
    body.append("### Danh muc ten da dang ky")
    body.append("")
    body.append("**Dung de:** truoc khi **them mot ham**, **doi mot kieu** hay tao file")
    body.append("moi trong `compiler_bootstrap/compiler/il_features/`, kiem danh muc nay va")
    body.append("kiem tra file da ton tai chua. Da co mot lan: tao `bytes_type.tkv` de bo")
    body.append("sung ham `bytes()` nhung file do **da ton tai** va la module that cua")
    body.append("compiler - ghi de lam hong ca buoc bien dich.")
    body.append("")
    body.append("**CANH BAO - co ten khong nghia la co dung duoc.** Muc nay lay tu")
    body.append("`register_*`, no chi chung minh *co entry dang ky*, KHONG chung minh")
    body.append("*tinh nang chay duoc den cuoi*. Hay **probe that** roi tin ket qua.")
    body.append("")
    total = 0
    for key in sorted(buckets.keys()):
        names = sorted(buckets[key])
        total = total + len(names)
        body.append("**" + key + " (" + str(len(names)) + ")**")
        body.append("")
        i = 0
        while i < len(names):
            line = "`" + names[i] + "`"
            j = i + 1
            while j < len(names) and j < i + 8:
                line = line + " `" + names[j] + "`"
                j = j + 1
            body.append(line)
            i = i + 8
        body.append("")
    body.append("**Tong so ten da dang ky: " + str(total) + "**")
    body.append("")
    body.append("### File trong `compiler_bootstrap/compiler/il_features/`")
    body.append("")
    body.append("| File | Kich thuoc (ky tu) |")
    body.append("|---|---|")
    for fn in ten_file:
        body.append("| `" + fn + "` | " + str(len(path_read_text(path_join(feat, fn)))) + " |")
    body.append("")
    path_write_text(out, text[0:b_at + len(begin)] + "\n" + "\n".join(body) + "\n" + text[e_at:])
    print("da sinh khoi danh muc trong " + out + " (" + str(total) + " ten, " + str(len(ten_file)) + " file)")
    return 0