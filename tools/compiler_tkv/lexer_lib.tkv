# -*- coding: utf-8 -*-
# LEXER DAU TIEN cua compiler TokenVector-that.
#
# DAY LA PHAN Dau cua rao ② (thay `ast.parse` cua Python). No lam dung 1 phan
# viec doc lap va kiem chung duoc: CHUOI NGUON TokenVector -> danh sach token.
# Chua parse cau truc (khong xay AST) - do do khong phu thuoc gi vao parser
# Python, va chay duoc trong mot assembly TokenVector thuan.
#
# Hien tai day la "token dong" - dung de chung minh kien truc, chua phan biang
# token nham ky (string/docstring/so/ky tu) o muc chuoi.
#
# ## Vì sao viet bang TokenVector chu khong dung regex cua CPython
# Compiler phai doc nguon TokenVector ma KHONG phu thuoc CPython. TokenVector
# co `re_match`/`re_search` nhung hay that hon viet vong lap ky tu: khong regex
# nao doc het nguon ma nhan duoc (multi-line string, comment, so hex, escape).

def is_digit(c: "str") -> "bool":
    return c >= "0" and c <= "9"


def is_alpha(c: "str") -> "bool":
    if c >= "a" and c <= "z":
        return True
    if c >= "A" and c <= "Z":
        return True
    return c == "_"


def is_space(c: "str") -> "bool":
    return c == " " or c == chr(9) or c == chr(10) or c == chr(13)


def is_ident_char(c: "str") -> "bool":
    if is_alpha(c):
        return True
    return is_digit(c)


def is_nl(c: "str") -> "bool":
    return c == chr(10) or c == chr(13)


def num_len(src: "str", i: "i32") -> "i32":
    """Do dai MOT so nguyen/thuc ngay tai `i`.

    Nhan ca chu so `0x` / `0o` / `0b` (va gia tri cua chung), phan thap phan
    `.` + chu so, va dau gach duong `_` long giua chu so. Khong nhan dang thuc
    `1e5` hay `1.5e-3` - TokenVector THAT co ho tro nhung chua test; xem
    README.md muc "Con lai".
    """
    ln = len(src)
    j = i
    if j + 1 < ln and src[j] == "0":
        c1 = src[j + 1]
        if c1 == "x" or c1 == "X" or c1 == "o" or c1 == "O" or c1 == "b" or c1 == "B":
            j = j + 2
            while j < ln:
                c = src[j]
                if is_hex_digit(c) or c == "_":
                    j = j + 1
                else:
                    break
            return j - i
    while j < ln:
        c = src[j]
        if is_digit(c) or c == "_":
            j = j + 1
        else:
            break
    if j + 1 < ln and src[j] == "." and j + 1 < ln and is_digit(src[j + 1]):
        j = j + 1
        while j < ln:
            c = src[j]
            if is_digit(c) or c == "_":
                j = j + 1
            else:
                break
    return j - i


def is_hex_digit(c: "str") -> "bool":
    if c >= "0" and c <= "9":
        return True
    if c >= "a" and c <= "f":
        return True
    return c >= "A" and c <= "F"


def op_len(src: "str", i: "i32") -> "i32":
    """Do dai toan tu nhieu ky tu tai `i`, hoac 0 neu khong phai.

    Thu tu DAI nhat truoc: `**` truoc `*`, `==` truoc `=`. Khong ton tai toan tu
    3 ky tu nao trong TokenVector, nen kiem toi da 2.
    """
    ln = len(src)
    if i + 1 >= ln:
        return 0
    two = src[i:i + 2]
    if two == "**" or two == "//" or two == "==" or two == "!=" or two == "<=" or two == ">=" or two == "->":
        return 2
    if i + 1 < ln and src[i + 1] == "=":
        c = src[i]
        if c == "+" or c == "-" or c == "*" or c == "/" or c == "%" or c == "&" or c == "|" or c == "^":
            return 2
    c = src[i]
    if c == "=" or c == "<" or c == ">" or c == "+" or c == "-" or c == "*" or c == "/" or c == "%" or c == "|" or c == "&" or c == "^":
        return 1
    return 0


def skip_comment(src: "str", i: "i32") -> "i32":
    """Tu `#` den het dong (khong giu dau xuong dong)."""
    ln = len(src)
    j = i
    while j < ln:
        if src[j] == chr(10):
            break
        j = j + 1
    return j


def skip_string(src: "str", i: "i32") -> "i32":
    """Tu vi tri `i` (dang o dau dau `"`) den HET chuoi, kem ca dau ket.
    Tra ve chi so ngay SAU dau ket.

    TokenVector khong co escape trong chuoi (chuoi tho viet nguoc nguon doc,
    con chuoi nguon thi escape chi nen...). Nguon TokenVector THAT khong the
    escape, nen chuoi chi dung `\` de CHINH escape: chuoi tho phai ra `\\`.
    Vi vay moi dau `\` deu bo qua ke ca ky tu ngay sau.

    Chuoi 3 dau nhay (docstring, co the xuong nhieu dong) duoc xu ly nhu 1
    khoi: bat dau khi gap 3 dau nhay, ket thuc khi gap 3 dau nhay lien tiep.

    KHONG xu ly `\` nhu escape trong khoi 3 nhay: TokenVector khong co escape
    trong chuoi, `\` la ky tu binh thuong. Neu dem `\` o day, noi dung co `\'`
    se lam lech dem va cat nham sai - da gap o file test that.
    """
    ln = len(src)
    q = chr(34)
    bs = chr(92)
    j = i
    if i + 2 < ln and src[i + 1] == q and src[i + 2] == q:
        j = i + 3
        while j < ln:
            if src[j] == q and j + 2 < ln and src[j + 1] == q and src[j + 2] == q:
                return j + 3
            j = j + 1
        return ln
    j = i + 1
    while j < ln:
        c = src[j]
        if c == bs:
            j = j + 2
            continue
        if c == q:
            return j + 1
        j = j + 1
    return ln


def bs_nl() -> "str":
    """GIU LAI: du thu hien dinh dang `<do-dai>:<token>` nen ham nay khong con
    duoc dung. No duoc giu lai de nho rang phuong phap escape ky tu (thay
    xuong dong bang 2 ky tu) KHONG an toan: mot chuoi nguon that chua ky tu do
    se bi bien doi. Da gap that o `projects/tour.tkv`."""
    return chr(92) + "n"


def count_lines(src: "str") -> "i32":
    """Dem so dong cua nguon - ham nho, dung de smoke test DLL."""
    n = 0
    i = 0
    ln = len(src)
    while i < ln:
        if src[i] == chr(10):
            n = n + 1
        i = i + 1
    return n


def tokenize(src: "str") -> "list[str]":
    """Tach nguon thanh token. Tra ve list CHOI (string), moi token 1 phan tu.

    Token: `ID:<ten>` cho ky tu danh tinh, `NUM:<chuoi>` cho so,
    `PUNCT:<ky tu>` cho dau cau, `NL` cho xuong dong, `EOF` cho het.
    """
    out = []
    i = 0
    ln = len(src)
    q = chr(34)
    while i < ln:
        c = src[i]
        if is_space(c):
            if c == chr(10):
                out.append("NL")
            i = i + 1
            continue
        if c == q:
            out.append("STR:" + src[i:skip_string(src, i)])
            i = skip_string(src, i)
            continue
        if c == chr(35):
            i = skip_comment(src, i)
            continue
        if is_alpha(c):
            j = i
            while j < ln and is_ident_char(src[j]):
                j = j + 1
            out.append("ID:" + src[i:j])
            i = j
            continue
        if is_digit(c):
            k = num_len(src, i)
            out.append("NUM:" + src[i:i + k])
            i = i + k
            continue
        ol = op_len(src, i)
        if ol > 0:
            out.append("PUNCT:" + src[i:i + ol])
            i = i + ol
            continue
        out.append("PUNCT:" + c)
        i = i + 1
    out.append("EOF")
    return out


def main() -> "i32":
    # `run <input.tkv> <output.txt>`: doc nguon, tach token, ghi ra file.
    # TokenVector khong co `subprocess` nen day la CUA nguon TokenVector de
    # compiler goi: no bien dich file nay thanh exe roi chay no (xem
    # probe_bridge.py). Cau truc nay da duoc chung minh chay that o BƯỚC 0.
    #
    # DINH DANG KET QUA - `<do-dai>:<token>` moi dong, do dai dem ky tu. KHONG
    # dung 1 token 1 dong: mot token chua xuong dong (chuoi nhieu dong) se bi
    # cat vun. KHONG dung ky tu escape thay the (nhu `\` + `n`): chuoi nguon
    # THAT co chua ky tu do, nen no bi pha - da gap o `projects/tour.tkv`.
    # Do dai la duy nhat cach khong nhap mang.
    argv = sys_argv()
    if len(argv) < 3:
        print("dung: lexer.exe <input> <output>")
        return 1
    src = path_read_text(argv[1])
    toks = tokenize(src)
    out = ""
    i = 0
    n = len(toks)
    while i < n:
        t = toks[i]
        out = out + str(len(t)) + ":" + t + chr(10)
        i = i + 1
    path_write_text(argv[2], out)
    print("tokens=" + str(len(toks)))
    return 0
