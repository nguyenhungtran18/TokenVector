# -*- coding: utf-8 -*-
"""Vong tu-host viet bang TokenVector (thay `_scratch/vong.sh` + `dung_tv.py`, khong con Python).

Doc danh sach file trong `compiler_src/ds_gop.txt` (moi dong mot duong dan), bo
cac dong `__tkv_import__`, roi gop thanh MOT nguon `NGUON`, sau do:

    g1 = tv2s(nguon)     # the he HIEN TAI bien dich nguon
    g2 = g1(nguon)       # g1 bien dich LAI CHINH NO -> the he ke tiep
    g1.il == g2.il       -> g1 == g2: DA DINH, in `IL_IDENTICAL`

Y NGHIA - can phan biet ro, de doc nham:
day KHONG phai phep so sanh "ban cu" voi "ban moi". `tv2s` la the he hien tai;
g1 la the he sinh ra tu chinh no; g2 la the he sinh ra tu g1. KHI g1 bien dich
lai chinh no ma ra CHINH g1 (g1 == g2), thi moi the he sinh ra deu giong het
the he sinh ra no - do la DIEM BAT DONG.

`g1 != g2` KHONG co nghia la loi, va cung khong phai dot ngung goc. Do la TIEN
HOA: neu vong truoc da nang cap mot the he moi vao `tv2s`, the he do co the
bien dich nguon ra mot thu khac (vi du doi nghia sinh ma). Khi do `vong` TU
nang cap g2 thanh `tv2s` va in ra yeu cau chay lai; vong sau lai bien dich
tu g2, va vong lap lai cho den khi `IL_IDENTICAL` - luc do compiler da on dinh
va ngung lai.

HAI NHANH NANG CAP (xem `main`):
  - `IL_IDENTICAL` -> copy g1 len `dist\tkvc-tv.exe`. Vi `g1.il == g2.il` hai
    file nay CUNG mot chuong trinh, nen copy file nao cung tuong duong; chon g1
    vi g1 chinh la san pham cua `tv2s` hien tai.
  - `IL KHAC NHAU` -> copy g2 len `dist\tkvc-tv.exe`, vi g2 moi la the he mang
    y nghia moi va phai duoc tu kiem lai o vong sau.

Cach dung (tu goc du an):  tools\vong.exe
Dich lan dau: dist\tkvc-tv.exe tools\vong.tkv tools\vong.exe main
"""

DS = "compiler_src\\ds_gop.txt"
THU_MUC = "build\\selfhost"
NGUON = "build\\selfhost\\tv_gop.tkv"
TV2S = "dist\\tkvc-tv.exe"


def gop_nguon() -> "i32":
    """Ghi NGUON tu danh sach file; tra so file gop (0 neu loi)."""
    ds = read_file(DS).split(chr(10))
    ra = ""
    so = 0
    for duong in ds:
        d = duong.strip()
        if d == "":
            continue
        if not path_exists(d):
            print("THIEU FILE: " + d)
            return 0
        phan = []
        for dong in read_file(d).replace(chr(13), "").split(chr(10)):
            if not dong.startswith("__tkv_import__"):
                phan.append(dong)
        ra = ra + chr(10).join(phan) + chr(10)
        so = so + 1
    write_file(NGUON, ra)
    return so


def dich(trinh_dich: "str", ra_exe: "str") -> "i32":
    """Dich NGUON bang `trinh_dich` thanh ra_exe; in 3 dong cuoi cua log neu loi. Tra ma thoat."""
    log = ra_exe + ".log"
    # Xoa san pham cu: neu khong, dich LOI van thay tep tu lan truoc va vong bao thanh cong gia.
    il_cu = ra_exe[:len(ra_exe) - 4] + ".il"
    if path_exists(ra_exe):
        os_remove(ra_exe)
    if path_exists(il_cu):
        os_remove(il_cu)
    ma = proc_run("cmd.exe", "/c " + trinh_dich + " \"" + NGUON + "\" \"" + ra_exe + "\" > \"" + log + "\" 2>&1")
    if ma != 0 or not path_exists(ra_exe):
        print("LOI dich bang " + trinh_dich + " (ma " + str(ma) + "): xem " + log)
        return 1
    return 0


def main() -> "i32":
    _bo = os_mkdir(THU_MUC)
    so = gop_nguon()
    if so == 0:
        return 2
    print("gop " + str(so) + " file")
    if dich(TV2S, THU_MUC + "\\g1.exe") != 0:
        return 3
    print("g1 xong")
    if dich(THU_MUC + "\\g1.exe", THU_MUC + "\\g2.exe") != 0:
        return 4
    print("g2 xong")
    il1 = read_file(THU_MUC + "\\g1.il")
    il2 = read_file(THU_MUC + "\\g2.il")
    if il1 != il2:
        # g1 != g2 KHONG phai loi. Do la TIEN HOA: `tv2s` hien tai co the moi
        # la the he moi sinh ra o vong truoc, va no bien dich nguon ra thu khac
        # voi the he sinh ra no (vi du doi nghia sinh ma). Vay thang cap g2 -
        # the he moi nhat - len `tv2s`, roi vong sau se bien dich lai tu g2.
        print("IL KHAC NHAU: g1.il (" + str(len(il1)) + " ky tu) != g2.il (" + str(len(il2)) + " ky tu) - thang cap g2 lam tv2s, chay lai vong")
        _c3 = proc_run("cmd.exe", "/c copy /Y \"" + THU_MUC + "\\g2.exe\" \"" + TV2S + "\" > nul")
        _c4 = proc_run("cmd.exe", "/c copy /Y \"" + THU_MUC + "\\g2.il\" \"" + THU_MUC + "\\tv2s.il\" > nul")
        return 5
    print("IL_IDENTICAL")
    _c1 = proc_run("cmd.exe", "/c copy /Y \"" + THU_MUC + "\\g1.exe\" \"" + TV2S + "\" > nul")
    _c2 = proc_run("cmd.exe", "/c copy /Y \"" + THU_MUC + "\\g1.il\" \"" + THU_MUC + "\\tv2s.il\" > nul")
    return 0
