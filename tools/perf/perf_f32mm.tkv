# -*- coding: utf-8 -*-
# Kernel f32 matmul cho perf_gate.ps1 - BI LOI 10% ngay im lang khi
# compile_binop doi cach chon khuon toan hang (2026-10-13), khong mot
# gate nao bat vi deu chi test tinh DUNG.
def _z32(n: "i32") -> "list[f32]":
    out = []
    i = 0
    while i < n:
        out.append(0.0)
        i = i + 1
    return out


def _mm32(a: "list[f32]", b: "list[f32]", r: "list[f32]", n: "i32") -> "i32":
    i = 0
    while i < n:
        j = 0
        while j < n:
            s = a[i * n] * b[j]
            kk = 1
            while kk < n:
                s = s + a[i * n + kk] * b[kk * n + j]
                kk = kk + 1
            r[i * n + j] = s
            j = j + 1
        i = i + 1
    return 0


def main() -> "i32":
    reps = 100
    n = 32
    m = n * n
    a = _z32(m)
    b = _z32(m)
    r = _z32(m)
    i = 0
    while i < m:
        a[i] = ((i % 97) * 0.1)
        i = i + 1
    i = 0
    while i < m:
        b[i] = ((i % 89) * 0.07)
        i = i + 1
    k = 0
    cs = 0.0
    while k < reps:
        _mm32(a, b, r, n)
        cs = 0.0
        i = 0
        while i < m:
            cs = cs + r[i]
            i = i + 1
        k = k + 1
    print("sum=" + str(cs))
    return 0