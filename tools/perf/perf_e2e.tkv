# -*- coding: utf-8 -*-
# Kernel elementwise cho perf_gate.ps1: r[i] = a[i] + b[i].
# Doi tuong CHINH phan bounds check - chiem ~96% thoi gian.
def main() -> "i32":
    n = 262144
    half = n // 2
    a = []
    b = []
    r = []
    i = 0
    while i < n:
        a.append(0.0)
        i = i + 1
    i = 0
    while i < half:
        b.append(0.0)
        i = i + 1
    i = 0
    while i < half:
        r.append(0.0)
        i = i + 1
    i = 0
    while i < n:
        a[i] = ((i % 97) * 0.1)
        i = i + 1
    i = 0
    while i < half:
        b[i] = ((i % 4) + 1.0)
        i = i + 1
    reps = 20
    k = 0
    cs = 0.0
    while k < reps:
        i = 0
        while i < half:
            r[i] = a[i] + b[i]
            i = i + 1
        i = 0
        while i < half:
            r[i] = a[half + i] + b[i]
            i = i + 1
        cs = 0.0
        i = 0
        while i < half:
            cs = cs + r[i]
            i = i + 1
        k = k + 1
    print("sum=" + str(cs))
    return 0