# -*- coding: utf-8 -*-
"""tra_ten - Tra xem TEN da duoc dang ky trong compiler TokenVector khong.

KHONG goi compiler. Phep quet danh muc nam trong module dung chung
`danh_muc_ten_lib`; file nay chi la giao dien dong lenh.

Dung
  tra_ten.exe <ten.txt>          tra cac ten trong file
"""
__tkv_import__ = "danh_muc_ten_lib"


def main() -> "i32":
    tham = sys_argv()
    dm_quet()
    if len(tham) < 2:
        chat = 0
        kha = 0
        i = 0
        while i < len(DM_TEN):
            if DM_CHAC[i] == 1:
                chat = chat + 1
            else:
                kha = kha + 1
            i = i + 1
        print("quet " + str(DM_SO_FILE) + " file -> " + str(len(DM_TEN))
              + " ten: CHAC=" + str(chat) + ", KHA=" + str(kha)
              + "  (SO_KHA truoc day dem so khoa-moi; giu de so do)")
        print("SO_KHA=" + str(DM_SO_KHA))
        i = 0
        dem = 0
        while i < len(DM_TEN) and dem < 20:
            if DM_CHAC[i] == 1:
                print("   " + DM_TEN[i] + "   CHAC")
                dem = dem + 1
            i = i + 1
        return 0
    ds = dm_tach_ten(read_file(tham[1]))
    chat = 0
    kha = 0
    thieu = 0
    i = 0
    while i < len(ds):
        r = dm_tra(ds[i])
        if r == 2:
            chat = chat + 1
            print("  CHAC   " + ds[i])
        if r == 1:
            kha = kha + 1
            print("  KHA    " + ds[i])
        if r == 0:
            thieu = thieu + 1
            print("  THIEU  " + ds[i])
        i = i + 1
    print("")
    print("CHAC  : " + str(chat))
    print("KHA   : " + str(kha))
    print("THIEU : " + str(thieu))
    return 0
