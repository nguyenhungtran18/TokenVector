# -*- coding: utf-8 -*-
"""Ham Python THAT (chay duoi CPython that) cho re_match/re_sub - ten
PHANG khop cu phap DSL (khong '.') - cung mo hinh voi _file_io_helpers.py
(extract_program() bo qua 'from X import ...', chi dung de doi chieu
CPython)."""
import re


def re_match(pattern: str, s: str) -> int:
    return 1 if re.match(pattern, s) else 0


def re_sub(pattern: str, repl: str, s: str) -> str:
    return re.sub(pattern, repl, s)
