# -*- coding: utf-8 -*-
"""Kiem thu Moc 22: Static threading wrapper thread_spawn, thread_join, thread_sleep."""
import sys
import subprocess
from pathlib import Path

sys_path = Path(__file__).parent.parent.parent
if str(sys_path) not in sys.path:
    sys.path.insert(0, str(sys_path))

from tkv_compile import compile_tkv_cli

def test_static_threading():
    p = '''def background_task() -> "i32":
    thread_sleep(50)
    return 0

def run() -> "str":
    t = thread_spawn(background_task)
    thread_join(t)
    return "THREAD_OK"'''
    
    SRC = Path('scratch/m22_thread.tkv')
    EXE = Path('scratch/m22_thread.exe')
    SRC.write_text(p, encoding='utf-8')
    compile_tkv_cli(SRC, EXE, entry_name='run')
    proc = subprocess.run([str(EXE)], capture_output=True, text=True)
    tkv_val = proc.stdout.strip()
    assert tkv_val == "THREAD_OK", f"Mismatch: {repr(tkv_val)} (err={proc.stderr!r})"
    print("PASS: test_static_threading", tkv_val)

if __name__ == '__main__':
    test_static_threading()
    print("ALL MOC 22 TESTS PASSED!")
