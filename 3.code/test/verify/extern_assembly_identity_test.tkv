# -*- coding: utf-8 -*-
"""Kiem thu hoi quy identity cho `__tkv_extern_assembly__`/`__tkv_extern_method__`
(R3, 2026-09-23 - case R3Test.dll private unsigned, khong strong-name).

Dung 1 R3Test.dll THAT (dung bang ilasm cua .NET Framework co san tren may,
unsigned + version 0.0.0.0 - giong het `csc /target:library` mac dinh), roi
build+chay 3 case bang chinh `dist/tkvc.exe` (artifact ship di):

  A. bare string  = "R3Test"  -> FileLoadException Framework identity
     (Version=4.0.0.0 + b77a...) - DUNG theo thiet ke (bare = GAC Framework),
     khoa hanh vi nay lai de ai doi y nghia cung phai sua test.
  B. tuple         = ("R3Test", None, None) -> chay dung, Add42(8) = 50.
  C. full identity inline -> chay dung, Add42(8) = 50.

Chay: python 3.code/test/verify/extern_assembly_identity_test.tkv
(chi stdlib, khong import gi tu source - khong thoi theo layout repo)."""
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve()
REPO = HERE.parent.parent.parent.parent  # .../3.code/test/verify -> repo root
TKVC = REPO / '3.code' / 'dist' / 'tkvc.exe'

R3TEST_IL = """.assembly R3Test { .ver 0:0:0:0 }
.module R3Test.dll
.class public abstract auto ansi sealed beforefieldinit R3Test
       extends [mscorlib]System.Object
{
  .method public hidebysig static int32 Add42(int32 x) cil managed
  {
    .maxstack 8
    ldarg.0
    ldc.i4.s 42
    add
    ret
  }
}
"""

TMPL = """# -*- coding: utf-8 -*-
{pragma}
__tkv_extern_method__ = [
    {{"name": "r3_add", "assembly": {asm!r}, "class": "R3Test",
     "method": "Add42", "params": ["i32"], "returns": "i32"}}
]

def run() -> "str":
    v = r3_add(8)
    print(v)
    return "ok"
"""


def _find_ilasm():
    for root in (Path(r'C:\WINDOWS\Microsoft.NET\Framework64'),
                 Path(r'C:\WINDOWS\Microsoft.NET\Framework')):
        if not root.exists():
            continue
        cands = sorted((sub / 'ilasm.exe' for sub in root.iterdir()
                        if (sub / 'ilasm.exe').exists()),
                       key=lambda p: p.parent.name, reverse=True)
        if cands:
            return str(cands[0])
    raise RuntimeError('khong tim thay ilasm.exe (.NET Framework 4.x)')


def _run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def test_extern_assembly_identity():
    assert TKVC.exists(), f'thieu compiler ship di: {TKVC}'
    tmp = Path(tempfile.mkdtemp(prefix='r3test_'))
    ilasm = _find_ilasm()
    (tmp / 'R3Test.il').write_text(R3TEST_IL, encoding='utf-8')
    r = _run([ilasm, '/dll', str(tmp / 'R3Test.il'),
              f'/output={tmp / "R3Test.dll"}'])
    assert (tmp / 'R3Test.dll').exists(), f'ilasm that bai: {r.stdout}\n{r.stderr}'

    cases = [
        ('bare', '__tkv_extern_assembly__ = "R3Test"', 'R3Test'),
        ('tuple', '__tkv_extern_assembly__ = [("R3Test", None, None)]', 'R3Test'),
        ('full', '',
         'R3Test, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null'),
    ]
    failures = []
    for cname, pragma, asm in cases:
        src = tmp / f'r3_{cname}.tkv'
        exe = tmp / f'r3_{cname}.exe'
        src.write_text(TMPL.format(pragma=pragma, asm=asm), encoding='utf-8')
        b = _run([str(TKVC), 'build', str(src), '--out', str(exe),
                  '--entry', 'run'])
        if b.returncode != 0:
            failures.append((cname, 'build', b.stdout, b.stderr))
            continue
        dll_dst = exe.parent / 'R3Test.dll'
        if (tmp / 'R3Test.dll').resolve() != dll_dst.resolve():
            shutil.copy2(tmp / 'R3Test.dll', dll_dst)
        p = _run([str(exe)])
        out = (p.stdout or '') + (p.stderr or '')
        if cname == 'bare':
            # Khoa hanh vi thiet ke: bare = GAC Framework -> FileLoadException.
            if p.returncode == 0 or 'Version=4.0.0.0' not in out \
                    or 'b77a5c561934e089' not in out:
                failures.append((cname, 'doi FileLoadException Framework identity',
                                 p.stdout, p.stderr))
            else:
                print(f'PASS [{cname}]: FileLoadException Framework identity (dung thiet ke)')
        else:
            if p.returncode != 0 or '50' not in (p.stdout or ''):
                failures.append((cname, 'doi in 50 + exit 0',
                                 p.stdout, p.stderr))
            else:
                print(f'PASS [{cname}]: Add42(8) = 50')
    if failures:
        print('SAI LECH:')
        for f in failures:
            print(' ', f)
        sys.exit(1)
    print('EXTERN_ASSEMBLY_IDENTITY (bare/tuple/full): PASS - 3/3.')


if __name__ == '__main__':
    test_extern_assembly_identity()
