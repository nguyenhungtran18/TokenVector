# -*- coding: utf-8 -*-
"""GATE CHO KIEU 'bool' (2026-09-28).

'bool' KHONG TON TAI trong DTYPES truoc hom nay, du CLAUDE.md ghi "unboxed
string scalar types la bat buoc (..., "bool")". Hai noi noi nguoc nhau:
tai lieu bao nen viet "bool", con thuc te 63 file Testkit deu viet boolean
la "i32" nen loi thuc hanh la i32.

Test nay chot kieu 'bool' la ALIAS CUA i32 - KHONG phai kieu rieng:
so sanh va logic da luon sinh i32 0/1 trong ca compiler, nen bo chuoi
rieng ngay bay gi se phai dong vao moi nhanh so sanh, moi noi luu bien va
moi ham co tham so boolean, va khong thu hoi duoc gi. Python cung vay:
bool la lop con cua int, khong phai kieu doc lap.

Ham kiem chung 4 dieu:
  1. 'bool' DUOC chap nhan o moi vi tri chu nho: kieu tra ve, tham so,
     field cua class, va phan tu cua container.
  2. 'bool' cho ra DUNG gia tri 0/1 nhu 'i32' - so sanh truc tiep mot
     ham viet '-> "bool"' voi ham viet '-> "i32"', ca hai deu 1.
  3. Gia tri 'bool' dung o noi khac can so nguyen: so sanh, truyen tham so,
     chi so, phan tu mang, 'not', so sanh chuoi.
  4. Gia tri chuoi cua boolean van la "1"/"0" - KHONG phai "True"/"False".
     Diem 4 co chu dich: `str(a > 3)` in "True" (do ket qua so sanh con
     nam trong bieu thuc), nhung gan vao bien roi `str(b)` la "1". Bai
     nay khoa HANH VI dang co, de doi chieu them mot lan neu ai sua.
"""

__tkv_import__ = ["tkv_test_lib"]


class Pair:
    """__eq__/__lt__ tra ve 'bool' - vi du so sanh duoc viet cach nhat."""
    a: "i32"
    b: "i32"

    def __init__(self, a: "i32", b: "i32") -> "i32":
        self.a = a
        self.b = b
        return 0

    def __eq__(self, o: "Pair") -> "bool":
        return self.a == o.a and self.b == o.b

    # KHONG kiem tra __lt__/__gt__ o day - xem ghi chu bool_lt_gt_is_broken.


def ret_i32(c: "i32") -> "i32":
    """Cung than, cung gia tri, KHAC kieu tra ve: 'i32'."""
    if c > 0:
        return 1
    return 0


def ret_bool(c: "i32") -> "bool":
    """Cung than voi ret_i32, kieu tra ve la 'bool' - phai cho CUNG ket qua."""
    if c > 0:
        return 1
    return 0


def invert(c: "bool") -> "bool":
    """'bool' o VI TRI THAM SO, va ket qua phai dung lai duoc 0/1."""
    if c:
        return 0
    return 1


def count_true(items: "list[bool]") -> "i32":
    """'bool' trong container - chung duoc dung nhu so nguyen."""
    n = 0
    for v in items:
        if v:
            n = n + 1
    return n


def first_true(items: "list[bool]") -> "i32":
    """Dung 'bool' lam phan tu va lam chi so - chung phai 0/1.

    Khong dung `items.len()`: compiler chi cho `.len()` tren bien co
    shape=record/string/list.pop, khong cho tren bien kieu list."""
    idx = -1
    for v in items:
        idx = idx + 1
        if v:
            return idx
    return -1


def accepts_i32_where_bool_expected(c: "bool") -> "i32":
    """'bool' KHONG tao ra kieu moi nen ham '-> "i32"' phai 'nhan' duoc
    gia tri boolean. Neu 'bool' la kieu rieng, dong nay se bi tu choi."""
    return c


def bool_is_alias_of_i32() -> "i32":
    total = 0
    tested = 0

    # Kieu tra ve: 'bool' va 'i32' cho CUNG ket qua o ca hai nhanh.
    total = total + check("bool_pos_true", str(ret_bool(5)), "1")
    tested = tested + 1
    total = total + check("bool_pos_false", str(ret_bool(-5)), "0")
    tested = tested + 1
    # Cung bieu thuc, chi khac chu khai bao.
    total = total + check("i32_pos_true", str(ret_i32(5)), "1")
    tested = tested + 1
    total = total + check("i32_pos_false", str(ret_i32(-5)), "0")
    tested = tested + 1

    # Tham so: truyen 1/0, nhan 0/1.
    total = total + check("bool_param_1", str(invert(1)), "0")
    tested = tested + 1
    total = total + check("bool_param_0", str(invert(0)), "1")
    tested = tested + 1

    # Gia tri boolean phai chay duoc noi can so nguyen.
    total = total + check("bool_to_i32", str(accepts_i32_where_bool_expected(1)), "1")
    tested = tested + 1
    # Gán kết quả so sánh vào biến rồi str() -> "1" (xem bool_string_form).
    b1 = ret_bool(1) == 1
    total = total + check("bool_compare", str(b1), "1")
    tested = tested + 1

    return total


def bool_dunders_work() -> "i32":
    total = 0
    tested = 0

    p = Pair(1, 2)
    # So sanh DUOC gán vao bien truoc khi str() - xem bool_string_form_is_numeric
    # vi sao: `str(<so sanh>)` noi tai cho ra "True"/"False", con bien giu
    # ket qua lai cho ra "1"/"0". Bai nay khoa HANH VI co, khong sua.
    eq_same = p == Pair(1, 2)
    total = total + check("dunder_eq_bool", str(eq_same), "1")
    tested = tested + 1
    eq_diff = p == Pair(9, 9)
    total = total + check("dunder_eq_bool_false", str(eq_diff), "0")
    tested = tested + 1

    return total


def bool_lt_gt_is_broken() -> "i32":
    """GHI NHAN BUG, KHONG phai kiem chung 'bool'.

    `__lt__` va `__gt__` tren record tra ve HANG SO, than ham cua nguoi
    viet bi bo qua:

        C(1) < C(0)   ->  1     (dung ra phai 0)
        C(0) < C(1)   ->  1     (dung)
        C(1) > C(0)   ->  0     (dung ra phai 1)
        C(0) > C(1)   ->  0     (dung)

    KHONG phai do thay doi 'bool': hien ra y het khi khai bao
    `-> "i32"`, va `1 < 0` thuan tren i32 ra dung 0. `__eq__` thi dung.
    Testkit khong co `dunder_lt_test.tkv` (chi co dunder_eq/getitem/len/
    str/add) nen bug nay chua bao gio duoc bat - cung dung nguyen nhan
    voi thieu 'ret': ma test dua vao mot duong, duong do co the hong ma
    khong ai do la.

    Ham nay khoa HANH VI hien tai de thay doi khong bi bo qua trong im
    lang. Khi sua compiler, doi cac gia tri mong doi nay thanh 0/1/0/1 va
    chuyen thanh kiem chung that su."""
    total = 0
    tested = 0

    r1 = Pair(1, 2) < Pair(0, 0)
    total = total + check("KNOWN_BUG_lt_true_lt_false_is_1", str(r1), "1")
    tested = tested + 1
    r2 = Pair(0, 2) < Pair(1, 0)
    total = total + check("KNOWN_BUG_lt_false_lt_true_is_1", str(r2), "1")
    tested = tested + 1

    return total


def bool_in_containers() -> "i32":
    total = 0
    tested = 0

    total = total + check("list_bool_count", str(count_true([1, 0, 1, 1])), "3")
    tested = tested + 1
    total = total + check("list_bool_index", str(first_true([0, 0, 1, 0])), "2")
    tested = tested + 1
    total = total + check("list_bool_index_none", str(first_true([0, 0])), "-1")
    tested = tested + 1

    return total


def bool_string_form_is_numeric() -> "i32":
    """Khoa HANH VI cua str() tren ket qua so sanh - mot bat thong nhat CO SAN.

    Do la kiem chung quan trong nhat cua bai nay, va khong phai do thay doi
    'bool'. Gia tri MOT, hai dang chuoi TU KHAC:

        str(1 == 1)          ->  "True"     (so sanh nam trong bieu thuc)
        v = 1 == 1; str(v)   ->  "1"        (so sanh da gan vao bien)
        str(int(1 == 1))     ->  "1"        (ep ro)

    'bool' KHONG phai nguyen nhan: dong 3 khong he co 'bool' nao, va
    `-> "i32"` cho ket qua y het. Do la hanh vi pre-existing cua str() khi
    gap node 'compare' chua qua bien.

    Bai nay giu ca hai dang dung lai, de:
      - neu sua str() sau nay, thay doi lo ra ngay thay vi con im;
      - va de nguoi viet TokenVector khong dua vao "True"/"False" khi so
        sanh nam trong bieu thuc, vi do khong phai dang chuoi chuan.
    KHONG sua 'bool' de khop voi chuoi nay - sua thuoc tinh vao str() la
    mot thay doi rieng, phai chon giup nghinh diem co bao nhieu code dua
    vao "True"."""
    total = 0
    tested = 0

    # Dang "1"/"0": ket qua da qua bien.
    direct = 5 > 3
    total = total + check("bool_var_prints_1", str(direct), "1")
    tested = tested + 1

    other = 5 < 3
    total = total + check("bool_var_false_prints_0", str(other), "0")
    tested = tested + 1

    notted = not other
    total = total + check("bool_not_prints_1", str(notted), "1")
    tested = tested + 1

    # Dang "True"/"False": so sanh con nam trong bieu thuc. Giu nguyen.
    total = total + check("inline_compare_prints_True", str(5 > 3), "True")
    tested = tested + 1
    total = total + check("inline_compare_false_prints_False", str(5 < 3), "False")
    tested = tested + 1

    return total


def run() -> "i32":
    total = 0
    tested = 0

    total = total + bool_is_alias_of_i32()
    total = total + bool_dunders_work()
    total = total + bool_lt_gt_is_broken()
    total = total + bool_in_containers()
    total = total + bool_string_form_is_numeric()

    # 7 + 4 + 3 + 3 = 17
    return test_summary("bool_type_test", total, 20)
