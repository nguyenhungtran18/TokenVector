"""GATE CHO `del` (2026-09-29, Giai doan 2 cua PLAN).

`del` xoá PHAN TU container va khoa dict. KHONG xoá bien - xem ghi chu cua
`compiler/il_features/del_stmt.tkv` de biet ly do: local TokenVector co kieu
khai bao san, `del x` tao trai thai "khong con binding", va muon tao duoc
trai thai do thi moi noi dung bien deu phai kiem tra - bien `NameError` thanh
gia tri rac, tuc LOI SAI chu khong phai loi on ao.

`del lst[i]` **DIEU CHIEU (re-index)** cac phan tu sau do, dung nhu Python:
`List<T>.RemoveAt` lam viec do nen day la hanh vi dung, khong phai dien giai
rieng. Test nay khoa lai hanh vi do - mot cai sai o day se lam lech chi so o
mot lo chay rat dai ma rat kho thay.

Gia tri mong doi doi chieu CPython truoc khi viet.
"""

__tkv_import__ = ["tkv_test_lib"]


def list_delete() -> "i32":
    """Xoa giua, dau, cuoi - va kiem tra DAI CHI SO doi dung."""
    total = 0
    lst = [10, 20, 30, 40, 50]
    del lst[2]
    s = ""
    j = 0
    while j < len(lst):
        s = s + str(lst[j]) + ";"
        j = j + 1
    total += check("xoa giua", s, "10;20;40;50;")
    total += check("len sau", str(len(lst)), "4")
    del lst[0]
    total += check("xoa dau phai khong dieu chieu lai", str(lst[0]) + " len=" + str(len(lst)), "20 len=3")
    del lst[2]
    total += check("xoa cuoi", str(lst[0]) + " " + str(lst[1]) + " len=" + str(len(lst)), "20 40 len=2")
    return total


def list_delete_by_var() -> "i32":
    """Chi so la BIEN chu khong phai hang so."""
    lst = [1, 2, 3, 4]
    k = 2
    del lst[k]
    s = ""
    j = 0
    while j < len(lst):
        s = s + str(lst[j]) + ";"
        j = j + 1
    return check("xoa theo bien", s, "1;2;4;")


def dict_delete() -> "i32":
    """Xoa khoa - `Dictionary.Remove` tra bool nen phai bo ket qua."""
    total = 0
    d = {"a": 1, "b": 2, "c": 3}
    del d["b"]
    # `str(<so sanh>)` noi tuyen in "True"/"False"; phai gan bien roi moi str()
    # moi ra "1"/"0". Day la quy tac da ghi trong CLAUDE.md.
    gone = "b" in d
    total += check("len sau xoa khoa", str(len(d)), "2")
    total += check("khoa da xoa", str(gone), "0")
    total += check("khoa con lai", str(d["a"] + d["c"]), "4")
    d["b"] = 9
    total += check("them lai duoc", str(d["b"]), "9")
    return total


def dict_delete_by_expr() -> "i32":
    """Khoa tu bien chu khong phai hang so - `Remove` nhan kieu khoa dung."""
    d = {"a": 1, "b": 2}
    key = "a"
    del d[key]
    gone = "a" in d
    return check("xoa theo bien", str(len(d)) + " a=" + str(gone), "1 a=0")


def list_of_lists() -> "i32":
    """Xoa tren list cu phan tu la container - can dung kieu phan tu."""
    lst = [[1, 2], [3, 4], [5, 6]]
    del lst[0]
    first = lst[0]
    total = 0
    total += check("len", str(len(lst)), "2")
    total += check("dau da doi chieu", str(len(first)), "2")
    total += check("noi dung", str(lst[0][0]), "3")
    return total


def run() -> "i32":
    total = 0
    total += list_delete()
    total += list_delete_by_var()
    total += dict_delete()
    total += dict_delete_by_expr()
    total += list_of_lists()
    # 4 + 1 + 4 + 1 + 3
    return test_summary("del_stmt_test", total, 13)
