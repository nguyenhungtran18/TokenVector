# -*- coding: utf-8 -*-
"""GATE CHO slice co buoc `a[i:j:k]` (2026-09-28).

.NET khong co API cat theo buoc: `List<T>.GetRange(start, count)` va
`String.Substring(start, count)` deu lay CONTIGUOUS, khong nhay duoc. Nen buoc
phai sinh VONG LAP: doc tung phan tu vao List moi (list) hoac StringBuilder moi
(string, roi ToString()).

CHOT PHAM VI - buoc DUONG only. Buoc am can doi chieu so sanh (i > stop thay
vi i < stop), sua moc am, va sua dieu kien thoat vong lap. Nhieu truong hop moi
truong hop de sai, nen tu choi ro rang hon la de sinh IL sai. Linter chan
`a[::-1]` truoc ca khi bien dich bat dau.

Mot chi tiet parse: `a[::2]` - dau ':' thu HAI khong phai bat dau `stop` ma la
dau phan cach buoc. Dua no cho parse_expr se loi ngay. Da tach truoc khi quyet
dinh co parse `stop` hay khong.

Gia tri mong doi tinh tay, doi chieu CPython 3.11 tren cung bo case.
"""

__tkv_import__ = ["tkv_test_lib"]


def list_step() -> "i32":
    total = 0
    tested = 0
    a = [0, 1, 2, 3, 4, 5]
    b = a[::2]
    total += check("a[::2] length", str(len(b)), "3")
    tested += 1
    total += check("a[::2] values", str(b[0]) + "," + str(b[1]) + "," + str(b[2]), "0,2,4")
    tested += 1
    c = a[1:5:2]
    total += check("a[1:5:2]", str(len(c)) + "=" + str(c[0]) + "," + str(c[1]), "2=1,3")
    tested += 1
    d = a[2:]
    total += check("a[2:] no step", str(len(d)) + "=" + str(d[0]) + "," + str(d[3]), "4=2,5")
    tested += 1
    e = a[:4:3]
    total += check("a[:4:3]", str(len(e)) + "=" + str(e[0]) + "," + str(e[1]), "2=0,3")
    tested += 1
    return total


def string_step() -> "i32":
    total = 0
    tested = 0
    s = "abcdef"
    t = s[::2]
    total += check("s[::2] value", t, "ace")
    tested += 1
    u = s[1:5:2]
    total += check("s[1:5:2] value", u, "bd")
    tested += 1
    v = s[::3]
    total += check("s[::3] value", v, "ad")
    tested += 1
    return total


def step_of_one() -> "i32":
    """`a[i:j:1]` giong het `a[i:j]` - phai ra ket qua nhu nhau, va khong duoc
    pham vi them vao ma khi buoc la 1 (duong GetRange/Substring da co san)."""
    total = 0
    tested = 0
    a = [0, 1, 2, 3, 4, 5]
    b = a[::1]
    total += check("a[::1] full", str(len(b)) + "=" + str(b[5]), "6=5")
    tested += 1
    s = "abcdef"
    t = s[::1]
    total += check("s[::1] full", t, "abcdef")
    tested += 1
    return total


def boundary_steps() -> "i32":
    total = 0
    tested = 0
    a = [0, 1, 2, 3, 4, 5]
    # buoc lon hon danh sach -> chi phan tu dau
    b = a[::7]
    total += check("step larger than list", str(len(b)) + "=" + str(b[0]), "1=0")
    tested += 1
    # moc rong -> ket qua rong
    c = a[3:3:2]
    total += check("empty bounds", str(len(c)), "0")
    tested += 1
    # moc dung het -> khong duoc loi ra ngoai pham vi
    d = a[4:6:1]
    total += check("step to exact end", str(len(d)) + "=" + str(d[0]) + "," + str(d[1]), "2=4,5")
    tested += 1
    e = "abc"
    f = e[1:3:1]
    total += check("string step to exact end", f, "bc")
    tested += 1
    return total


def result_is_independent() -> "i32":
    """Ket qua la container MOI, khong phai alias cua nguon - sua ket qua khong
    duoc doi nguon (va nguoc lai)."""
    total = 0
    tested = 0
    a = [1, 2, 3, 4, 5]
    b = a[::2]
    b.append(99)
    total += check("append does not touch source", str(len(a)) + "=" + str(len(b)), "5=4")
    tested += 1
    s = "abcde"
    t = s[::2]
    total += check("string slice length", str(len(t)) + "=" + str(len(s)), "3=5")
    tested += 1
    return total


def run() -> "i32":
    total = 0
    total += list_step()
    total += string_step()
    total += step_of_one()
    total += boundary_steps()
    total += result_is_independent()
    # 5 + 3 + 2 + 4 + 2
    return test_summary("slice_step_test", total, 16)
