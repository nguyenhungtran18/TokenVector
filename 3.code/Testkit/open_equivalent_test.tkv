# -*- coding: utf-8 -*-
# PHUONG AN TUONG DUONG cho `open()` - TokenVector khong co `open()` dang ham.
#
# Khong phai vi thieu ham: handle cua `with open(...)` la StreamReader/
# StreamWriter thuan .NET, khong co kieu rieng nen `h.read()` khong dispatch
# duoc. Hai chuc nang do da co san o dang HAM:
#   doc  -> `path_read_text(p)`
#   ghi  -> `path_write_text(p, s)`
#
# Bai nay CUNG la noi sinh ra `os_remove()` (2026-09-30): file tam test ghi
# ra se CON LAI va lam bang chay rac trong repo, ma TokenVector khong co ham
# nao xoa duoc MOT FILE (`shutil_rmtree` chi xoa cay thu muc). Bai nay da
# phai doi duong vao TEMP de lau cai rat - nen moi them `os_remove()`.
#
# Ghi vao TEMP va TU DON LAI bang `os_remove()`. Xem docs/REFERENCE.md 7.11.
__tkv_import__ = ["tkv_test_lib"]


def run() -> "i32":
    total = 0
    tested = 0
    # Chuoi thang trong ham, KHONG dung bien cap module: `p = _BIEN_MODULE`
    # lam `_infer_dtype` nem KeyError o first-pass (da gap: co loi KeyError
    # '_PATH_TMP' trong il_codegen.py declare_scalar).
    p = "C:/Windows/Temp/tkv_open_equiv_test.txt"
    path_write_text(p, "hello")
    tested = tested + 1
    total = total + check("open_equiv_file_created", str(file_exists(p)), "1")
    s = path_read_text(p)
    tested = tested + 1
    total = total + check("open_equiv_read", str(s), "hello")
    tested = tested + 1
    total = total + check("open_equiv_len", str(len(s)), "5")
    path_write_text(p, "bye")
    s2 = path_read_text(p)
    tested = tested + 1
    total = total + check("open_equiv_overwrite", str(s2), "bye")
    path_write_text(p, "a" + chr(10) + "b")
    s3 = path_read_text(p)
    tested = tested + 1
    total = total + check("open_equiv_multiline_len", str(len(s3)), "3")

    # --- DON DEP: xoa file tam, va xac nhan xoa that ---
    cleaned = os_remove(p)
    tested = tested + 1
    total = total + check("cleanup_removed", str(cleaned), "1")
    gone = 1 - file_exists(p)
    tested = tested + 1
    total = total + check("cleanup_gone", str(gone), "1")
    # goi lan 2 phai tra 0 (khong nem loi) - de chay lai nhieu lan deu duoc
    again = os_remove(p)
    tested = tested + 1
    total = total + check("cleanup_idempotent", str(again), "0")

    return test_summary("open_equivalent_test", total, tested)