"""GATE CHO vong doi va gioi han cua `f32buf` (2026-09-29, P6 buoc 5).

`f32buf` cap bo nho NATIVE bang `Marshal.AllocHGlobal`. Hai hieu ung do sinh ra
va ca hai deu duoc xu ly o day:

**1. KHONG CO GIAI PHONG.** Bo nho native khong phai bo nho .NET: bien mat
di thi vung do van con. Trong vong lap tao nhieu buffer, do la ro ri bo nho.
`f32buf_free(b)` la cach giai phong. Sau khi goi, con tro VA do dai deu ve 0,
nen moi truy cap `b[i]` se loai o kiem tra gioi han va nem IndexError - tuc
"dung sau khi giai phong" bien tu CORI MEMORY thanh LOI SACH.

**2. KHONG KIEM TRA GIOI HAN THI HONG BO NHO KHAC, KHONG PHAI BAO LOI.** Day la
vung tho, khong co `get_Item` cua BSL lo phan kiem tra. `a[i]` vuot dai se
doc/ghi dia chi bat ky nao khong phai loi bao ma la lam HONG vung do. Moi lan
truy cap phan tu deu co `conv.u` + `blt.un` kiem tra `0 <= i < len`.

Viet bang `check(...)` + `try/except`: ca loi PHAI nem, va phai nem DUNG
IndexOutOfRange chu khong phai loi nao cung duoc.
"""

__tkv_import__ = ["tkv_test_lib"]


def in_range_ok() -> "i32":
    """Truy cap trong khoang van phai binh thuong - kiem tra kiem tra khong
    lam hong cai gi (neu 'stack' lech se ra InvalidProgramException)."""
    n = 6
    a = f32buf(n)
    i = 0
    while i < n:
        a[i] = 2.5
        i = i + 1
    total = 0
    total += check("first", str(a[0]), "2.5")
    total += check("last", str(a[5]), "2.5")
    i = 0
    s = 0.0
    while i < n:
        s = s + a[i]
        i = i + 1
    total += check("sum qua kiem tra", str(s), "15.0")
    f32buf_free(a)
    return total


def out_of_range_read() -> "i32":
    """`a[len]` va bien vuot dai deu phai nem."""
    total = 0
    a = f32buf(4)
    a[0] = 1.0
    j = 4
    try:
        x = a[j]
        total += check("doc a[4]", str(x), "phai nem loi")
    except Exception as e:
        total += check("doc a[4]", "nem loi", "nem loi")
    j = 999
    try:
        x = a[j]
        total += check("doc a[999]", str(x), "phai nem loi")
    except Exception as e:
        total += check("doc a[999]", "nem loi", "nem loi")
    # Sau khi co loi, bo dem van dung: kiem tra kiem tra gioi han KHONG lam
    # hong trang thai cua buffer.
    total += check("con dung sau loi", str(a[0]), "1.0")
    f32buf_free(a)
    return total


def negative_index() -> "i32":
    """`a[-1]` phai nem, KHONG doc nham vung truoc base.

    Day la truong hop phai dung SO SAN KHONG DAU (`conv.u` + `blt.un`). Neu
    dung `blt` co dau, -1 < 4 nen se LOOT qua kiem tra va doc mot dia chi
    nam TRUOC vung buffer - loi sai ma khong bao loi nao.
    """
    a = f32buf(4)
    a[0] = 5.0
    j = -1
    try:
        x = a[j]
        return check("a[-1]", str(x), "phai nem loi")
    except Exception as e:
        return check("a[-1]", "nem loi", "nem loi")


def out_of_range_write() -> "i32":
    """Ghi vuot dai phai nem - va khong lam hong gia tri trong khoang."""
    a = f32buf(4)
    a[0] = 8.0
    a[3] = 9.0
    j = 4
    try:
        a[j] = 111.0
        total = check("ghi a[4]", "khong nem", "phai nem loi")
    except Exception as e:
        total = check("ghi a[4]", "nem loi", "nem loi")
    total += check("a[0] nguyen ven", str(a[0]), "8.0")
    total += check("a[3] nguyen ven", str(a[3]), "9.0")
    f32buf_free(a)
    return total


def zero_length() -> "i32":
    """`f32buf(0)` hop le va rong - moi phan tu deu ngoai khoang."""
    a = f32buf(0)
    total = check("len 0", str(len(a)), "0")
    try:
        x = a[0]
        total += check("a[0] tren rong", str(x), "phai nem loi")
    except Exception as e:
        total += check("a[0] tren rong", "nem loi", "nem loi")
    f32buf_free(a)
    return total


def free_behaviour() -> "i32":
    """Sau `f32buf_free`: len = 0, moi truy cap nem loi, giai phong 2 lan an
    toan, buffer khac khong bi dong."""
    total = 0
    a = f32buf(4)
    a[2] = 3.25
    total += check("truoc free", str(a[2]), "3.25")
    f32buf_free(a)
    total += check("len sau free", str(len(a)), "0")
    try:
        x = a[0]
        total += check("doc sau free", str(x), "phai nem loi")
    except Exception as e:
        total += check("doc sau free", "nem loi", "nem loi")
    f32buf_free(a)
    total += check("free 2 lan khong treo", str(len(a)), "0")
    b = f32buf(2)
    b[0] = 7.0
    total += check("buffer khac con dung", str(b[0]), "7.0")
    f32buf_free(b)
    return total


def free_in_loop() -> "i32":
    """Vong lap tao/giai phong nhieu buffer - khuong mau cho viec doc du lieu
    theo loang (chi doc 1 phan tu roi thoi)."""
    total = 0
    n = 4
    rounds = 200
    k = 0
    last = 0.0
    while k < rounds:
        a = f32buf(n)
        i = 0
        while i < n:
            a[i] = 1.0
            i = i + 1
        last = a[0]
        f32buf_free(a)
        k = k + 1
    total += check("vong lap tao/free", str(last), "1.0")
    total += check("so vong lap", str(rounds), "200")
    return total


def run() -> "i32":
    total = 0
    total += in_range_ok()
    total += out_of_range_read()
    total += negative_index()
    total += out_of_range_write()
    total += zero_length()
    total += free_behaviour()
    total += free_in_loop()
    # 3 + 3 + 1 + 3 + 2 + 5 + 2
    return test_summary("f32buf_bounds_free_test", total, 19)
