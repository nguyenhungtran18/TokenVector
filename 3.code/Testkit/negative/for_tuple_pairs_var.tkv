# EXPECT-SUBSTRING: chi ho tro list literal
# -*- coding: utf-8 -*-
# `for a, b in ...` hien chi ho tro list literal chua cac tuple literal.
# Bien list-cua-tuple phai bi tu choi ro rang vi duong doc `List<T>.Add(!0)`
# khong chay duoc voi tuple chua TkvInt, khong duoc sinh IL sai am tham.
# Dau ngoac don quanh `top` co chu dich: no dua nguon bien qua line-parser
# `for_tuple_pairs` de first-pass tu choi ro rang, thay vi macro text
# `for_in_kvlist` xu ly nham truoc.
def make_empty() -> "list[(i32, i32)]":
    return []


def run() -> "i32":
    top = make_empty()
    for i, j in (top):
        print(str(i) + str(j))
    return 0
