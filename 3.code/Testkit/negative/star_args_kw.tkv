# EXPECT-SUBSTRING: chua ho tro '**kwargs'
# -*- coding: utf-8 -*-
# `**kw` CHUA duoc ho tro (khac `*xs`). Loi phai noi ro phan vi, khong bao
# chung chung "khong parse duoc" - nguoi dung can biet la con thieu gi.
# Ly do: `**kw` len doi khoa -> phai doi ca duong chon tham so theo TEN, khac
# `*xs` chi tach danh sach VI TRI. Do la vi tri ke trong roadmap.
def f1(a: "i32") -> "i32":
    return a


def run() -> "i32":
    kw = {"a": 1}
    return f1(**kw)
