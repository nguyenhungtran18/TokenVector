# -*- coding: utf-8 -*-
"""R6: literal i64 + typeflow + int() parse 64-bit (UPSTREAM_REQUIREMENTS R6).

Truoc R6 (2026-09-28) `int("2147483648")` emit Int32::Parse nem
OverflowException that. Nay `_int_return_dtype` trong int_builtin.tkv suy
i64 khi literal CHAC CHAN vuot int32 nen emit Int64::Parse - va KHONG doi
gi khi literal vua int32 (van Int32.Parse).
"""


def t(c: "list[i32]", name: "str", got: "str", expected: "str") -> "i32":
    c[0] = c[0] + 1
    if got == expected:
        print("PASS " + name)
        c[1] = c[1] + 1
    else:
        print("FAIL " + name + " got=" + got + " expected=" + expected)
    return 0


def take_i64(v: "i64") -> "i64":
    return v


def test_summary(title: "str", total: "i32", tested: "i32") -> "i32":
    print("")
    print("=== " + title + ": " + str(total) + "/" + str(tested) + " PASS ===")
    if total == tested:
        return 0
    return 1


def run() -> "i32":
    c = [0, 0]

    # ---- lit.u64: literal nguyen >= 2^31
    big = 2147483648
    t(c, "lit.u64", str(big), "2147483648")

    # ---- add.u64: 2^30 + 2^30 == 2^31 (typeflow qua bien dem)
    t(c, "add.u64", str(1073741824 + 1073741824), "2147483648")

    # ---- str.u64
    t(c, "str.u64", str(big), "2147483648")

    # ---- parse.u64: CHINH acceptance test bi FAIL truoc R6
    t(c, "parse.u64", str(int("2147483648")), "2147483648")
    t(c, "parse.u64.neg", str(int("-2147483649")), "-2147483649")
    t(c, "parse.u64.max", str(int("9223372036854775807")), "9223372036854775807")

    # ---- hex literal (0x80000002 == 2^31 + 2 == 2147483650)
    t(c, "hex", str(0x80000002), "2147483650")

    # ---- HANH VI CU GIU NGUYEN: literal vua i32 van di Int32.Parse
    t(c, "in.range", str(int("5")), "5")
    t(c, "in.range.i32max", str(int("2147483647")), "2147483647")
    t(c, "in.range.i32min", str(int("-2147483648")), "-2147483648")
    t(c, "plain.i32", str(42), "42")

    # ---- noi canh i64 thi Int64.Parse (duoc tu truoc R6 - phai giu)
    t(c, "ctx.i64", str(take_i64(int("2147483648"))), "2147483648")
    t(c, "ctx.i64.small", str(take_i64(int("7"))), "7")

    # ---- int64() ban 64-bit rieng: khong doi
    t(c, "int64.builtin", str(int64("2147483648")), "2147483648")
    t(c, "int64.from.i32", str(int64(5)), "5")

    # ---- bien dem dem 2^31 (typeflow qua bien, khong phai literal)
    half = 1073741824
    acc = half
    acc = acc + half
    t(c, "typeflow.var", str(acc), "2147483648")

    return test_summary("i64_int_test", c[1], c[0])
