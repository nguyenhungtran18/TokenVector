# -*- coding: utf-8 -*-
# `key=` / `reverse=` cho `min`/`max`/`sum`/`sorted` (2026-10-02).
#
# Nguon toi: CLAUDE.md/REFERENCE.md ghi "`key=` ho` o TANG PARSER" - **SAI**,
# va lai sai theo 2 lan. Parser (`il_core._parse_one_call_arg`) da tra
# `('kwarg', ten, expr)` dung cach tu 2026-08-28. Thu toi thuc su lam hong la
# MACRO TEXT-LEVEL `min/max` (stdlib_aggregates.tkv): no dem dau phay nen
# `max(xs, key=f)` bi viet lai thanh ternary `(xs > (key=f) ? xs : (key=f))`
# va parser bao loi tren `=`.
#
# Moi gia tri ky vong deu doi chieu voi CPython 3.14 (tru `sum(key=)` - xem
# ghi chu ben duoi).
__tkv_import__ = ["tkv_test_lib"]


def neg(v: "int") -> "int":
    return 0 - v


def neg_i32(v: "i32") -> "i32":
    return 0 - v


def by_len(s: "str") -> "i32":
    return len(s)


def zero(v: "int") -> "int":
    return 0


def join_i32(xs: "list[i32]") -> "str":
    out = ""
    i = 0
    while i < len(xs):
        if i > 0:
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    return out


# --- max/min theo khoa: tra ve PHAN TU, KHONG phai khoa ---
def max_neg(xs: "list[int]") -> "int":
    return max(xs, key=neg)


def min_neg(xs: "list[int]") -> "int":
    return min(xs, key=neg)


# --- khi trung khoa: phan tu DAU tien duoc giu (giong Python) ---
def tie_max(xs: "list[int]") -> "int":
    return max(xs, key=zero)


def tie_min(xs: "list[int]") -> "int":
    return min(xs, key=zero)


# --- khoa KHAC kieu voi phan tu (so -> chuoi) ---
def longest(xs: "list[str]") -> "str":
    return max(xs, key=by_len)


# --- sorted: tra ve LIST MOI, khong sua list goc ---
def sorted_neg(xs: "list[i32]") -> "str":
    ys = sorted(xs, key=neg_i32)
    return join_i32(ys) + "|" + join_i32(xs)


def sorted_len(words: "list[str]") -> "str":
    ys = sorted(words, key=by_len)
    return ys[0] + "/" + ys[1] + "/" + ys[2]


def sorted_rev(xs: "list[i32]") -> "str":
    ys = sorted(xs, reverse=True)
    return join_i32(ys)


def sorted_both(xs: "list[i32]") -> "str":
    ys = sorted(xs, key=neg_i32, reverse=True)
    return join_i32(ys)


# `sorted` DUOC phep khoa kieu 'str' (khac min/max/sum): no so sanh qua
# `List<ValueTuple<K,T>>.Sort()` cua .NET, noi ValueTuple co san IComparable
# theo K. `min/max/sum` thi PHAI chan vi do phat truc tiep `cgt`/`clt`.
def ident(s: "str") -> "str":
    return s


def sorted_str_key(words: "list[str]") -> "str":
    ys = sorted(words, key=ident)
    return ys[0] + "/" + ys[1] + "/" + ys[2]


# --- min/max variadic (macro text-level) PHAI CON CHAY ---
def variadic(a: "i32", b: "i32") -> "i32":
    return max(a, b) * 100 + min(a, b)


def variadic3(a: "i32", b: "i32", c: "i32") -> "i32":
    return max(a, max(b, c))


def plain(xs: "list[i32]") -> "i32":
    return max(xs) * 10 + min(xs) + sum(xs)


def run() -> "i32":
    total = 0
    tested = 0

    tested = tested + 1
    total = total + check("max_key", str(max_neg([3, 1, 2])), "1")
    tested = tested + 1
    total = total + check("min_key", str(min_neg([3, 1, 2])), "3")
    tested = tested + 1
    total = total + check("tie_max", str(tie_max([5, 5, 1])), "5")
    tested = tested + 1
    total = total + check("tie_min", str(tie_min([5, 5, 1])), "5")
    tested = tested + 1
    total = total + check("key_other_dtype", longest(["ccc", "a", "bb"]), "ccc")
    tested = tested + 1
    total = total + check("sorted_key", sorted_neg([3, 1, 2]), "3,2,1|3,1,2")
    tested = tested + 1
    total = total + check("sorted_key_str", sorted_len(["ccc", "a", "bb"]), "a/bb/ccc")
    tested = tested + 1
    total = total + check("sorted_reverse", sorted_rev([1, 3, 2]), "3,2,1")
    tested = tested + 1
    total = total + check("sorted_key_reverse", sorted_both([3, 1, 2]), "1,2,3")
    tested = tested + 1
    total = total + check("sorted_str_key", sorted_str_key(["ccc", "a", "bb"]), "a/bb/ccc")
    tested = tested + 1
    total = total + check("variadic_maxmin", str(variadic(3, 9)), "903")
    tested = tested + 1
    total = total + check("variadic_nested", str(variadic3(3, 9, 5)), "9")
    tested = tested + 1
    total = total + check("plain_no_key", str(plain([4, 1, 7])), "83")

    # `sum(xs, key=f)` - KHONG ton tai o CPython (builtin `sum` khong chap
    # nhan `key`, tra TypeError). TokenVector chap nhan noi dung MOT SU
    # MO RONG: cong tong KHOA. Ghi ro o day de khong ai doc nham la parity.
    # (Nguon la 1 bien, khong phai list literal: `sum()`/min/max/sorted yeu
    # cau 1 BIEN list - gioi han co san, xem REFERENCE.md.)
    xsum = [3, 1, 2]
    s1 = sum(xsum, key=neg)
    tested = tested + 1
    total = total + check("sum_key_extension", str(s1), "-6")

    return test_summary("agg_key_test", total, tested)