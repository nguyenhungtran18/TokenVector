# -*- coding: utf-8 -*-
"""GATE CHO `in` tren record (2026-09-28).

`v in rec` truoc day bao "'in' hien CHI ho tro dict/set/list/chuoi" - record
khong co nhanh nao, du record do viet day du `__contains__`. Cac dunder khac
(__eq__, __add__, __getitem__, __len__, __enter__) deu duoc noi san; `in` la
thieu mot.

Noi nay dung CUNG khuon voi compile_compare/__getitem__: goi
`callvirt instance int32 Rec::__contains__(kieu_tham_so)`, nen kiem chu ky
dunder ngay tai compile time - thieu tham so hoac tra ve sai kieu thi bao loi
bien dich chu khong nem gi luc chay.

Gioi HAN (khong sua trong lan nay, vi la hanh vi co chu dich):
`v in <bieu thuc>` - vd `5 in Box(5)` - van bi tu choi. `_expr_in` yeu cau ben
phai la MOT TEN BIEN de doc TypeAnn tu scope; bai nay kiem do.
"""

__tkv_import__ = ["tkv_test_lib"]


class Box:
    """`__init__` nhan DUNG 1 field da khai bao - quy tac cua du an
    (xem CLAUDE.md: '__init__ must take exactly the declared fields')."""
    target: "i32"

    def __init__(self, target: "i32") -> "i32":
        self.target = target
        return 0

    def __contains__(self, v: "i32") -> "i32":
        if v == self.target:
            return 1
        return 0


def in_on_record() -> "i32":
    total = 0
    tested = 0

    b = Box(5)
    c = Box(99)
    r1 = 5 in b
    total = total + check("record_in_present", str(r1), "1")
    tested = tested + 1
    r2 = 7 in b
    total = total + check("record_in_absent", str(r2), "0")
    tested = tested + 1
    # Bien khac - chung kieu, khai bao gia tri khac
    r3 = 5 in c
    total = total + check("record_in_other_object", str(r3), "0")
    tested = tested + 1
    r4 = 99 in c
    total = total + check("record_in_other_object_true", str(r4), "1")
    tested = tested + 1

    return total


def not_in_on_record() -> "i32":
    """'x not in rec' la 'not' tren ket qua - phai phu dinh dung."""
    total = 0
    tested = 0

    b = Box(5)
    r1 = 7 not in b
    total = total + check("record_not_in_absent", str(r1), "1")
    tested = tested + 1
    r2 = 5 not in b
    total = total + check("record_not_in_present", str(r2), "0")
    tested = tested + 1

    return total


def other_containers_untouched() -> "i32":
    """list/dict/chuoi di duong cu khong doi - bat buoc chay lai."""
    total = 0
    tested = 0

    lst = [1, 2]
    r1 = 1 in lst
    total = total + check("list_in_present", str(r1), "1")
    tested = tested + 1
    r2 = 9 in lst
    total = total + check("list_in_absent", str(r2), "0")
    tested = tested + 1

    d = {}
    d["k"] = 1
    r3 = "k" in d
    total = total + check("dict_in_present", str(r3), "1")
    tested = tested + 1
    r4 = "z" in d
    total = total + check("dict_in_absent", str(r4), "0")
    tested = tested + 1

    s = "abc"
    r5 = "b" in s
    total = total + check("str_in_present", str(r5), "1")
    tested = tested + 1
    r6 = "z" in s
    total = total + check("str_in_absent", str(r6), "0")
    tested = tested + 1

    return total


def run() -> "i32":
    total = 0
    tested = 0

    total = total + in_on_record()
    total = total + not_in_on_record()
    total = total + other_containers_untouched()

    # 4 + 2 + 6 = 12
    return test_summary("record_contains_test", total, 12)
