# -*- coding: utf-8 -*-
# Ham ngoai bang cua compiler (2026-09-30) - xem
# docs/BUILTIN_REFERENCE.md de sinh lai danh muc nay.
#
# Kiem `bytes(...)`: kieu `bytes` (List<uint8>, shape='bytes') DA TON TAI
# voi dang literal `b"..."`, thieu 3 CONSTRUCTOR. Buoc nho phai DOC file
# `bytes_type.tkv` truoc khi sua - da co mot lan tao file moi cung ten va
# ghi de mat module that cua compiler.
__tkv_import__ = ["tkv_test_lib"]


def run() -> "i32":
    total = 0
    tested = 0

    # --- bytes(n): n byte 0 ---
    a = bytes(3)
    tested = tested + 1
    total = total + check("bytes_repeat_len", str(len(a)), "3")
    tested = tested + 1
    total = total + check("bytes_repeat_val", str(a[0]), "0")
    tested = tested + 1
    total = total + check("bytes_repeat_last", str(a[2]), "0")
    z = bytes(0)
    tested = tested + 1
    total = total + check("bytes_zero", str(len(z)), "0")

    # --- bytes([...]) ---
    c = bytes([65, 66, 67])
    tested = tested + 1
    total = total + check("bytes_list_len", str(len(c)), "3")
    tested = tested + 1
    total = total + check("bytes_list_first", str(c[0]), "65")
    tested = tested + 1
    total = total + check("bytes_list_last", str(c[2]), "67")

    # --- bytes("chuoi", "utf-8") ---
    d = bytes("hi", "utf-8")
    tested = tested + 1
    total = total + check("bytes_str_len", str(len(d)), "2")
    tested = tested + 1
    total = total + check("bytes_str_val", str(d[1]), "105")
    # ky tu 2 byte: phai ra 6 byte voi byte dau 195, KHONG phai 5 byte
    # (ord('e') = 233 la CODE POINT, khong phai byte UTF-8)
    e = bytes("héllo", "utf-8")
    tested = tested + 1
    total = total + check("bytes_utf8_len", str(len(e)), "6")
    tested = tested + 1
    total = total + check("bytes_utf8_first", str(e[1]), "195")

    # --- dang literal (ton tai truoc do, ghim lai) ---
    f = b"abc"
    tested = tested + 1
    total = total + check("bytes_literal_len", str(len(f)), "3")
    tested = tested + 1
    total = total + check("bytes_literal_val", str(f[0]), "97")

    return test_summary("bytes_ctor_test", total, tested)