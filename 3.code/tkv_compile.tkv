class TranspileError(Exception):
    pass


def _annotation_to_type_str(node, ctx_name):
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    raise TranspileError(
        f"{ctx_name}: annotation phai la STRING kieu DSL (vd x: \"f32[4]\", -> \"f32\"), "
        f"gap {ast.dump(node)}")


def _default_literal_to_str(node, ctx_name):
    """Doi 1 ast default-value node (Python that, vd 'b: "i32" = 10' hoac
    '= -5' hoac '= "Hello"') sang van ban literal ma typed_dsl_parser.py's
    tokenizer hieu duoc ('= 10'/'= -5'/'= "Hello"') - CHI ho tro so
    (int/float, ke ca am qua UnaryOp USub) va chuoi (xem
    Param.default_node trong typed_dsl_parser.py, gioi han co y thuc)."""
    if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.USub) and \
            isinstance(node.operand, ast.Constant) and isinstance(node.operand.value, (int, float)):
        return f'-{node.operand.value}'
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)) and \
            not isinstance(node.value, bool):
        return str(node.value)
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return f'"{node.value}"'
    raise TranspileError(
        f"{ctx_name}: gia tri mac dinh chi ho tro literal so/chuoi (khong tham chieu bien), "
        f"gap {ast.dump(node)}")


INFERRED_DTYPE_MARKER = 'inferred'


def _params_with_defaults(func_node, args_to_check, ctx_name, allow_inferred=False):
    """args_to_check da bo 'self' (neu co, xem _extract_record_method_sig_line) -
    func_node.args.defaults CANH PHAI (right-aligned) voi TOAN BO
    func_node.args.args, nhung vi 'self' KHONG BAO GIO co default, cat
    duoi (tail) cua args_to_check van dung voi defaults.

    allow_inferred (Task 2/5, duck-typing-inference, 2026-08-17): True CHI
    cho ham top-level THAT (tkv_compile.py's vong lap tree.body) - khi
    True VA a.annotation is None, KHONG raise loi - gan dtype dac biet
    INFERRED_DTYPE_MARKER ('inferred') thay vi annotation DSL that. Mac
    dinh False, giu nguyen hanh vi cu (raise TranspileError) o MOI diem
    goi khac (method-trong-class, nested-def, macro @deco)."""
    n_defaults = len(func_node.args.defaults)
    parts = []
    for i, a in enumerate(args_to_check):
        if a.annotation is None:
            if allow_inferred:
                arg_name = _rename_reserved_identifiers(a.arg)
                default_idx = i - (len(args_to_check) - n_defaults)
                if default_idx >= 0:
                    lit = _default_literal_to_str(func_node.args.defaults[default_idx],
                                                   f"{ctx_name} tham so '{a.arg}'")
                    parts.append(f"{arg_name}: {INFERRED_DTYPE_MARKER} = {lit}")
                else:
                    parts.append(f"{arg_name}: {INFERRED_DTYPE_MARKER}")
                continue
            raise TranspileError(f"{ctx_name}: tham so '{a.arg}' thieu annotation kieu DSL")
        t = _annotation_to_type_str(a.annotation, f"{ctx_name} tham so '{a.arg}'")
        arg_name = _rename_reserved_identifiers(a.arg)
        default_idx = i - (len(args_to_check) - n_defaults)
        if default_idx >= 0:
            lit = _default_literal_to_str(func_node.args.defaults[default_idx],
                                           f"{ctx_name} tham so '{a.arg}'")
            parts.append(f"{arg_name}: {t} = {lit}")
        else:
            parts.append(f"{arg_name}: {t}")
    return parts


def _extract_signature_line(func_node, allow_varargs=False, allow_inferred=False):
    """allow_varargs (Phase 5.1, 2026-08-11): True CHI cho ham top-level -
    '*args: T'/'**kwargs: T' dong nhat kieu (xem parse_param trong
    typed_dsl_parser.py). Decorator/method van BI CHAN (goi voi
    allow_varargs=False, gioi han co y thuc - xem checklist).

    allow_inferred (Task 2/5, duck-typing-inference, 2026-08-17): True CHI
    cho ham top-level THAT - truyen xuong _params_with_defaults, cho phep
    tham so thuong (khong phai *args/**kwargs) thieu annotation duoc gan
    dtype 'inferred'. Mac dinh False."""
    if func_node.args.kwonlyargs:
        raise TranspileError(f"ham '{func_node.name}': chua ho tro tham so keyword-only")
    if not allow_varargs and (func_node.args.vararg or func_node.args.kwarg):
        raise TranspileError(f"ham '{func_node.name}': chi ho tro tham so thuong (khong *args/**kwargs/keyword-only)")
    parts = _params_with_defaults(func_node, func_node.args.args, f"ham '{func_node.name}'",
                                   allow_inferred=allow_inferred)
    if allow_varargs:
        if func_node.args.vararg is not None:
            va = func_node.args.vararg
            if va.annotation is None:
                raise TranspileError(f"ham '{func_node.name}': '*{va.arg}' thieu annotation kieu DSL")
            t = _annotation_to_type_str(va.annotation, f"ham '{func_node.name}' tham so '*{va.arg}'")
            parts.append(f"*{_rename_reserved_identifiers(va.arg)}: {t}")
        if func_node.args.kwarg is not None:
            kw = func_node.args.kwarg
            if kw.annotation is None:
                raise TranspileError(f"ham '{func_node.name}': '**{kw.arg}' thieu annotation kieu DSL")
            t = _annotation_to_type_str(kw.annotation, f"ham '{func_node.name}' tham so '**{kw.arg}'")
            parts.append(f"**{_rename_reserved_identifiers(kw.arg)}: {t}")
    if func_node.returns is None:
        raise TranspileError(f"ham '{func_node.name}': thieu return-type annotation (vd -> \"f32\":)")
    ret_t = _annotation_to_type_str(func_node.returns, f"ham '{func_node.name}' return type")
    func_name = _rename_reserved_identifiers(func_node.name)
    # 'async def' (Phase 4, 2026-08-11) - prefix 'async' vao dong chu ky
    # VAN BAN de typed_dsl_parser.py's parse_signature nhan dien (xem
    # Signature.is_async).
    prefix = "async " if isinstance(func_node, ast.AsyncFunctionDef) else ""
    return f"{prefix}{func_name}({', '.join(parts)}) -> {ret_t}:"


def _func_type_signature(func_node):
    """(list kieu tham so, kieu tra ve) cua 1 ham top-level (khong tinh
    'self') - dung de so sanh chu ky luc mo rong decorator tuy bien
    (_expand_custom_decorator, Phase 4, 2026-08-11)."""
    parts = []
    for a in func_node.args.args:
        if a.annotation is None:
            raise TranspileError(f"ham '{func_node.name}': tham so '{a.arg}' thieu annotation")
        parts.append(_annotation_to_type_str(a.annotation, f"ham '{func_node.name}' tham so '{a.arg}'"))
    if func_node.returns is None:
        raise TranspileError(f"ham '{func_node.name}': thieu return-type annotation")
    ret_t = _annotation_to_type_str(func_node.returns, f"ham '{func_node.name}' return type")
    return parts, ret_t


def _expand_custom_decorator(node, deco_node, source_lines):
    """'@deco' truoc 1 ham top-level (Phase 4, 2026-08-11) - desugar THANG
    thanh macro luc bien dich (KHONG dung ha tang func-delegate/closure
    runtime): tuong duong Python that 'f = deco(f)' nhung vi 'deco' o day
    BAT BUOC chi la 1 TEMPLATE thuan tuy (khong side-effect nao khac
    ngoai dinh nghia + tra ve 1 ham long - kiem tra RO RANG ben duoi),
    macro nay INLINE TRUC TIEP than 'wrapper' cua 'deco' lam than ham
    CONG KHAI moi cho 'f' - doi ten ham GOC thanh 1 ten AN (hidden) va
    doi MOI LOI GOI toi tham so bi bat (vd 'f(...)') trong than 'wrapper'
    thanh loi goi ten an do. Ket qua: hanh vi giong het 'f = deco(f)' that
    (vi 'deco' khong lam gi khac ngoai tra ve wrapper), nhung KHONG can mo
    phong "chay 1 lan luc nap module" - thu tuc AOT tinh khong co khai
    niem do.

    GIOI HAN CO Y THUC (thu hep pham vi, quyet dinh cua nguoi dung sau khi
    can nhac gia tri/effort qua 2 agent creative+critical): 'deco' CHI
    duoc nhan DUNG 1 tham so (chinh ham bi trang tri), than 'deco' CHI
    duoc gom DUNG 2 cau lenh (1 'def wrapper(...):' long + 1
    'return wrapper' - khong gi khac, macro nay KHONG BAO GIO thuc su goi
    'deco' luc chay nen moi side-effect khac se KHONG BAO GIO xay ra),
    chu ky 'wrapper' PHAI khop CHINH XAC (so luong + kieu tham so, kieu
    tra ve) voi chu ky ham goc 'f' VA voi kieu 'func(...)->...' ma 'deco'
    tu khai bao cho tham so/return cua no. Khong ho tro decorator co tham
    so (vd '@deco(x)'), khong ho tro decorator tren method trong class,
    khong ho tro xep chong nhieu decorator."""
    deco_name = deco_node.name
    public_name = node.name

    if (deco_node.args.vararg or deco_node.args.kwarg or deco_node.args.kwonlyargs
            or deco_node.args.defaults or len(deco_node.args.args) != 1):
        raise TranspileError(
            f"decorator '@{deco_name}' tren ham '{public_name}': 'def {deco_name}(...)' "
            f"phai nhan DUNG 1 tham so (chinh ham bi trang tri), khong *args/**kwargs/"
            f"tham so mac dinh")

    if len(deco_node.body) != 2 or not isinstance(deco_node.body[0], ast.FunctionDef) or \
            not (isinstance(deco_node.body[1], ast.Return) and
                 isinstance(deco_node.body[1].value, ast.Name) and
                 deco_node.body[1].value.id == deco_node.body[0].name):
        raise TranspileError(
            f"decorator '@{deco_name}' tren ham '{public_name}': than '{deco_name}' PHAI gom "
            f"DUNG 2 cau lenh - 1 'def wrapper(...):' long roi 'return wrapper' - khong ho tro "
            f"logic nao khac (macro nay khong bao gio thuc su GOI '{deco_name}' luc chay)")

    wrapper_node = deco_node.body[0]
    param_name = deco_node.args.args[0].arg

    orig_param_types, orig_ret_t = _func_type_signature(node)
    wrap_param_types, wrap_ret_t = _func_type_signature(wrapper_node)
    if orig_param_types != wrap_param_types or orig_ret_t != wrap_ret_t:
        raise TranspileError(
            f"decorator '@{deco_name}' tren ham '{public_name}': chu ky 'wrapper' trong "
            f"'{deco_name}' ({', '.join(wrap_param_types)} -> {wrap_ret_t}) phai KHOP CHINH XAC "
            f"voi chu ky '{public_name}' ({', '.join(orig_param_types)} -> {orig_ret_t}) - "
            f"decorator tuy bien hien CHI ho tro cung chu ky (khong doi kieu tham so/tra ve)")

    if deco_node.args.args[0].annotation is None:
        raise TranspileError(
            f"ham '{deco_name}': tham so '{param_name}' thieu annotation kieu DSL (ham dung lam "
            f"'@deco' PHAI khai annotation day du, KHONG duoc dung tham so kieu suy tu dong "
            f"'inferred')")
    deco_param_ann = _annotation_to_type_str(
        deco_node.args.args[0].annotation, f"ham '{deco_name}' tham so '{param_name}'")
    if deco_node.returns is None:
        raise TranspileError(f"ham decorator '{deco_name}': thieu return-type annotation")
    deco_ret_ann = _annotation_to_type_str(deco_node.returns, f"ham '{deco_name}' return type")
    for label, ann in (('tham so', deco_param_ann), ('return', deco_ret_ann)):
        ta = _parse_type_ann_str(ann, record_names=frozenset())
        if ta.shape != 'func' or list(ta.func_params or []) != orig_param_types or ta.dtype != orig_ret_t:
            raise TranspileError(
                f"ham decorator '{deco_name}': annotation {label} '{ann}' phai la "
                f"'func({', '.join(orig_param_types)}) -> {orig_ret_t}' (khop chu ky '{public_name}')")

    hidden_name = f'__deco_{deco_name}_{public_name}'

    orig_sig_line = _extract_signature_line(node)
    orig_name_token = _rename_reserved_identifiers(node.name)
    hidden_sig_line = orig_sig_line.replace(orig_name_token + '(', hidden_name + '(', 1)
    hidden_body_lines = _body_source_lines(source_lines, node)
    hidden_start_line = node.body[0].lineno

    wrapper_sig_line = _extract_signature_line(wrapper_node)
    wrapper_name_token = _rename_reserved_identifiers(wrapper_node.name)
    public_sig_line = wrapper_sig_line.replace(wrapper_name_token + '(', orig_name_token + '(', 1)

    header_idx = wrapper_node.lineno - 1
    indent = len(source_lines[header_idx]) - len(source_lines[header_idx].lstrip(' '))
    start = wrapper_node.body[0].lineno - 1
    end = wrapper_node.body[-1].end_lineno
    raw_body = source_lines[start:end]
    dedented = [ln[indent:] if len(ln) > indent else ln.lstrip(' ') for ln in raw_body]
    call_re = re.compile(r'\b' + re.escape(param_name) + r'\s*\(')
    public_body_lines = [call_re.sub(hidden_name + '(', ln) for ln in dedented]
    public_start_line = wrapper_node.body[0].lineno

    return ((hidden_sig_line, hidden_body_lines, hidden_start_line),
            (public_sig_line, public_body_lines, public_start_line))


def _body_source_lines(source_lines, func_node, hoisted=None):
    """hoisted (2026-08-03): list OUT-parameter - moi 'def' long KHONG bat
    bien nao se duoc CHUYEN LEN top-level (doi ten '<ngoai>__<long>') va
    append vao day duoi dang (sig_line, body_lines) - xem _hoist_nested_def."""
    if not func_node.body:
        raise TranspileError(f"ham '{func_node.name}': than ham rong")
    start = func_node.body[0].lineno
    end = func_node.body[-1].end_lineno
    lines = list(source_lines[start - 1:end])
    _rewrite_nested_defs(func_node, lines, start, hoisted=hoisted)
    return lines


def _reads_outer_names(inner, outer):
    """True neu than ham long CO doc 1 ten von la local/tham so cua ham
    ngoai (2026-08-03). Dung de biet 'nonlocal' co THAT SU can hay khong -
    ham long doc lap hoan toan thi khong can (va Python cung khong cho
    viet 'nonlocal' rong)."""
    own = {a.arg for a in inner.args.args}
    for node in ast.walk(inner):
        if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Store):
            own.add(node.id)
    outer_names = {a.arg for a in outer.args.args}
    for node in outer.body:
        for sub in ast.walk(node):
            if isinstance(sub, ast.Name) and isinstance(sub.ctx, ast.Store):
                outer_names.add(sub.id)
    for node in ast.walk(inner):
        if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Load):
            if node.id not in own and node.id in outer_names:
                return True
    return False



def _hoist_nested_def(inner, outer, lines, body_start_lineno, hoisted):
    """Chuyen 1 'def' long KHONG bat bien nao len top-level (2026-08-03).

    Ham long khong bat bien thi KHONG phai closure - no chi la 1 ham thuong
    dat nham cho. Truoc day bi tu choi o CA HAI tang (transpile doi dong
    'nonlocal', ma Python khong cho viet rong; codegen bao "khong bat bien
    nao"), du day la cach viet rat thuong gap.

    - Ten moi '<ham_ngoai>__<ham_long>' - tranh dung do voi ham top-level
      co san VA voi ham long CUNG TEN trong 1 ham khac.
    - Cac dong cua no bi xoa khoi than ham ngoai (thanh dong RONG - giu
      nguyen so dong, cung cach da lam voi dong 'nonlocal').
    - Cac LOI GOI trong than ham ngoai duoc doi sang ten moi.

    GIOI HAN (ghi ro): chi doi LOI GOI. Neu ham long duoc truyen di nhu 1
    GIA TRI (function reference) thi ten cu khong con -> bao loi "bien chua
    duoc khai bao" RO RANG luc bien dich, khong sai am tham."""
    start_idx = inner.lineno - body_start_lineno
    end_idx = inner.end_lineno - body_start_lineno
    indent = len(lines[start_idx]) - len(lines[start_idx].lstrip(' '))
    inner_lines = [ln[indent:] if len(ln) > indent else ln.lstrip(' ')
                   for ln in lines[start_idx + 1:end_idx + 1]]
    new_name = f'{outer.name}__{inner.name}'
    sig_line = _extract_signature_line(inner)
    old_name = _rename_reserved_identifiers(inner.name)
    sig_line = sig_line.replace(old_name + '(', new_name + '(', 1)
    # 'def' long BEN TRONG ham long: xu ly de quy TRUOC khi cat ra, de moi
    # tang deu duoc nang len top-level.
    _rewrite_nested_defs(inner, inner_lines, inner.body[0].lineno, hoisted=hoisted)
    hoisted.append((sig_line, inner_lines, inner.body[0].lineno))
    for i in range(start_idx, end_idx + 1):
        lines[i] = ''
    call_re = re.compile(r'\b' + re.escape(inner.name) + r'\s*\(')
    for i, ln in enumerate(lines):
        if ln:
            lines[i] = call_re.sub(new_name + '(', ln)


def _rewrite_nested_defs(func_node, lines, body_start_lineno, inherited_captures=None,
                          hoisted=None):
    """Closure that (Buoc 4, 2026-07-29 - xem project-tokenvector-wave2-
    status memory, 'checkpoint tach session'): sua TAI CHO (in-place, GIU
    NGUYEN so dong) 1 'def long' (nested FunctionDef) truc tiep ben trong
    than 1 ham - (a) dong header 'def ten(...) -> "kieu":' duoc doi ve dang
    KHONG dau ngoac kep quanh annotation (giong het sig_line top-level, tai
    dung _extract_signature_line), de il_codegen.py's nested_def line-
    parser (il_features/closures.py) parse duoc THANG qua parse_typed_
    signature; (b) dong 'nonlocal x' (BAT BUOC ve mat cu phap de file .tkv
    con la Python HOP LE, chay duoc that duoi CPython - xem triet ly module
    nay) duoc XOA (thanh dong rong) vi il_codegen.py KHONG co khai niem
    'nonlocal' - bien bi bat duoc suy tu chinh phan tich bien tu do (xem
    il_features/closures.py's fpw_nested_def), khong can khai bao rieng.

    Slice thu hai (2026-07-29, N>=1 bien bi bat): N>=1 bien trong 1 dong
    'nonlocal a, b, ...' - MOI bien PHAI la 1 LOCAL cua ham NGOAI (gan qua
    '=' thuong, khai bao TRUOC ham long trong thu tu van ban nguon) HOAC
    (B3, Phase C.1, 2026-07-29) 1 THAM SO cua ham NGOAI (chi hop le neu
    kieu THAM CHIEU - kiem tra dtype cu the o tang duoi, xem il_features/
    closures.py's fpw_nested_def) - vi pham bat ky dieu kien nao o day se
    bao loi RO RANG (TranspileError) thay vi de il_codegen.py that bai kho
    hieu hon o tang duoi.

    Phase C.2 (2026-07-29): HO TRO N>=1 def long SONG SONG truc tiep trong
    CUNG 1 ham (khong con gioi han DUNG 1) - MOI def long duoc rewrite +
    kiem tra DOC LAP (vong lap duoi). CUNG ho tro def-long-TRONG-def-long
    (2+ tang, vd 'inner' nam trong 'mid' nam trong 'ham_ngoai') - DE QUY
    vao THAN cua tung 'inner' de tim + rewrite cac def long SAU HON NUA
    (tham so 'inherited_captures': tap ten bien MA CHINH 'func_node' nay DA
    tu bat tu 1 tang NGOAI HON NUA - neu 1 def-con-cua-func_node bat lai 1
    ten trong tap nay, KHONG can kiem tra '_check_captured_declared_before'
    (bien do von KHONG PHAI local THAT su cua func_node, ma la 1 tham chieu
    chuyen tiep tu tang xa hon - viec box/chuyen-tiep CELL dung 1 chuoi da
    duoc _load_boxed_cell_ref ho tro san, xem il_codegen.py))."""
    if inherited_captures is None:
        inherited_captures = set()
    nested = [n for n in func_node.body if isinstance(n, ast.FunctionDef)]
    if not nested:
        return
    outer_params = {a.arg for a in func_node.args.args}
    for inner in nested:
        header_idx = inner.lineno - body_start_lineno
        indent = len(lines[header_idx]) - len(lines[header_idx].lstrip(' '))
        sig_line = _extract_signature_line(inner)  # vd 'inc() -> i32:' (khong dau ngoac kep)
        lines[header_idx] = ' ' * indent + f'def {sig_line}'

        if not inner.body or not isinstance(inner.body[0], ast.Nonlocal):
            if _reads_outer_names(inner, func_node):
                raise TranspileError(
                    f"ham long '{inner.name}' (trong ham '{func_node.name}'): BAT BUOC dong DAU "
                    f"TIEN trong than ham long phai la 'nonlocal <ten>, ...' (khai bao (cac) bien "
                    f"bi bat - dung cu phap Python THAT de file van chay duoc dung duoi CPython)")
            # (2026-08-03) Ham long KHONG dung bien nao cua ham ngoai thi
            # KHONG can 'nonlocal' - va Python that cung khong cho viet
            # 'nonlocal' rong. Truoc day van bat buoc, khien cach viet
            # thuong gap nhat ('def helper' thuan tuy, khong bat gi) bi tu
            # choi vo ly.
            if hoisted is None:
                _rewrite_nested_defs(inner, lines, body_start_lineno, inherited_captures)
                continue
            _hoist_nested_def(inner, func_node, lines, body_start_lineno, hoisted)
            continue
        nonlocal_node = inner.body[0]
        nl_idx = nonlocal_node.lineno - body_start_lineno
        lines[nl_idx] = ''

        for captured_name in nonlocal_node.names:
            if captured_name in outer_params:
                # B3 (Phase C.1, 2026-07-29, xem project-tokenvector-wave2-status
                # memory): bat 1 THAM SO cua ham ngoai gio HOP LE (da bind san
                # luc vao ham, khong can "khai bao truoc" nhu local) NEU no la
                # kieu THAM CHIEU (list/dict/record/func...) - viec kiem tra
                # dtype cu the (scalar van CHUA ho tro bat qua tham so) nam o
                # tang duoi (il_features/closures.py's fpw_nested_def, co day
                # du TypeAnn luc do, o day chi la buoc tien xu ly cu phap THO,
                # chua biet dtype).
                continue
            if captured_name in inherited_captures:
                # Phase C.2: 'func_node' (vd 'mid') TU NO cung dang bat lai
                # ten nay tu 1 tang xa hon (vd 'a' tu 'make_deep') - khong
                # phai local THAT cua func_node nen KHONG kiem tra "khai bao
                # truoc", chi chuyen tiep (chain) nguyen ven.
                continue
            _check_captured_declared_before(func_node, inner, captured_name)

        # De quy: 'inner' co the CUNG co def long rieng cua no - tap
        # inherited_captures cho vong de quy nay = MOI ten 'inner' se NHAN
        # LAI duoi dang closure_field (tham so THAM CHIEU cua chinh no +
        # MOI ten no vua bat o vong nay).
        inner_inherited = {p.arg for p in inner.args.args} | set(nonlocal_node.names)
        _rewrite_nested_defs(inner, lines, body_start_lineno, inherited_captures=inner_inherited)


def _check_captured_declared_before(func_node, inner, captured_name):
    declared_before = any(
        isinstance(st, ast.Assign) and len(st.targets) == 1 and
        isinstance(st.targets[0], ast.Name) and st.targets[0].id == captured_name and
        st.lineno < inner.lineno
        for st in func_node.body)
    if not declared_before:
        raise TranspileError(
            f"ham '{func_node.name}': bien bi bat '{captured_name}' phai duoc khai bao qua "
            f"1 phep gan thuong ('{captured_name} = ...') TRUOC ham long '{inner.name}' trong "
            f"thu tu van ban nguon")


def _extract_record_method_sig_line(class_node, method_node, is_static=False):
    """Nhu _extract_signature_line, nhung BO QUA tham so dau tien ('self'
    - khong duoc co annotation, khac cac tham so khac) - khoang trong ngon
    ngu #1 (method that tren record). 'self' duoc il_codegen.py TU dong
    bind vao scope (xem gen_il_method/_Scope.add_self), khong xuat hien
    trong dong chu ky sinh ra o day.

    is_static=True (Wave 1 Nhom B, 2026-07-29 - '@staticmethod'): method
    KHONG co 'self' - tat ca tham so (ke ca tham so DAU) deu can annotation
    kieu binh thuong, giong 1 ham top-level, xem _extract_record_def."""
    if is_static:
        if method_node.args.args and method_node.args.args[0].arg == 'self':
            raise TranspileError(
                f"method '{method_node.name}' cua class '{class_node.name}': "
                f"'@staticmethod' khong duoc co tham so 'self'")
        args_to_check = method_node.args.args
    else:
        if not method_node.args.args or method_node.args.args[0].arg != 'self':
            raise TranspileError(
                f"method '{method_node.name}' cua class '{class_node.name}': tham so DAU TIEN "
                f"phai la 'self' (giong Python that)")
        if method_node.args.args[0].annotation is not None:
            raise TranspileError(
                f"method '{method_node.name}' cua class '{class_node.name}': 'self' khong duoc "
                f"co annotation kieu")
        args_to_check = method_node.args.args[1:]
    if method_node.args.vararg or method_node.args.kwarg or method_node.args.kwonlyargs:
        raise TranspileError(
            f"method '{method_node.name}': chi ho tro tham so thuong (khong *args/**kwargs/"
            f"keyword-only)")
    parts = _params_with_defaults(method_node, args_to_check, f"method '{method_node.name}'")
    m_name = _rename_reserved_identifiers(method_node.name)
    # 'async def' method tren record (Task 3, 2026-08-12) - cung prefix
    # 'async ' nhu _extract_signature_line (ham top-level) de
    # typed_dsl_parser.py's parse_signature nhan dien (Signature.is_async).
    prefix = "async " if isinstance(method_node, ast.AsyncFunctionDef) else ""
    if method_node.returns is None:
        return f"{prefix}{m_name}({', '.join(parts)}):"
    ret_t = _annotation_to_type_str(method_node.returns, f"method '{method_node.name}' return type")
    return f"{prefix}{m_name}({', '.join(parts)}) -> {ret_t}:"


def _extract_interface_def(class_node, source_lines):
    """Phase C.4 (2026-07-29, xem project-tokenvector-wave2-status memory -
    huong F da chot: mixin = CIL interface). Parse 1 'class dang interface'
    (danh dau qua '@interface' o CLASS, khong phai method) - CHI cho phep
    khai bao METHOD (chu ky + 1 than THAT SU KHONG DUOC BIEN DICH, thuong
    la 'pass'/'...' - giong stub trong Python that, chi can hop le cu phap
    de file van chay duoc that duoi CPython, KHONG anh huong CIL sinh ra -
    interface method LUON abstract, khong co than). KHONG duoc co field
    (AnnAssign), KHONG '__init__', KHONG '@staticmethod'/'@property'.

    Tra ve dict {ten_method: sig_line} (sig_line dang 'ten(...) -> kieu:',
    KHONG dau ngoac kep - dung LAI _extract_record_method_sig_line)."""
    if class_node.bases or class_node.keywords:
        raise TranspileError(
            f"class '{class_node.name}': '@interface' khong duoc co base class rieng "
            f"(interface la goc, khong ke thua interface khac)")
    methods = {}
    for stmt in class_node.body:
        if isinstance(stmt, ast.Expr) and isinstance(stmt.value, ast.Constant) and \
                isinstance(stmt.value.value, str):
            continue  # docstring cua class
        if not isinstance(stmt, ast.FunctionDef):
            raise TranspileError(
                f"class '{class_node.name}' (@interface): CHI ho tro khai bao method (chu ky + "
                f"1 than stub 'pass'/'...' - khong bien dich) - gap {type(stmt).__name__} o dong "
                f"{stmt.lineno}")
        if stmt.decorator_list:
            raise TranspileError(
                f"method '{stmt.name}' cua interface '{class_node.name}': khong ho tro decorator "
                f"(interface method luon la instance abstract)")
        if stmt.name in methods:
            raise TranspileError(f"interface '{class_node.name}': trung ten method '{stmt.name}'")
        sig_line = _extract_record_method_sig_line(class_node, stmt, is_static=False)
        methods[stmt.name] = sig_line
    if not methods:
        raise TranspileError(f"interface '{class_node.name}': khong co method nao")
    return methods


_EXCEPTION_BASE_NAME = 'Exception'


def _extract_record_def(class_node, source_lines, known_records=None, known_interfaces=None):
    """Parse 1 'class dang record' (huong tiep theo sau tuple/nhieu gia
    tri tra ve, va khoang trong ngon ngu #1 - "method that tren record"):
    field khai bao dang AnnAssign (khong gia tri khoi tao), TOI DA 1
    '__init__' (bi qua luc bien dich, chi de file van la Python that
    chay duoc), va 0+ method THAT (tham so dau '(self)', khong annotation).

    Ke thua (B1, 2026-07-29, xem project-tokenvector-wave2-status memory):
    HO TRO 1 base class DUY NHAT ('(object)'/khong ngoac van tuong duong
    "khong ke thua" nhu truoc) - base PHAI la 1 record DA khai bao TRUOC DO
    trong CUNG file (known_records: dict ten->fields DA parse xong, theo
    THU TU xuat hien - giong quy uoc Python that: dùng truoc khi dinh nghia
    la loi). KHONG ho tro da ke thua GIUA 2 RECORD (nhieu base la record
    cung luc). KHONG nested class.

    Da ke thua qua interface (Phase C.4, 2026-07-29 - huong F da chot,
    "mixin = CIL interface"): CAC base SAU base DAU TIEN (neu co) PHAI la
    ten 1 '@interface' DA khai bao truoc do (known_interfaces: dict ten->
    {method:sig}) - vd 'class Dog(Animal, Flyable, Swimmable):' = ke thua
    THAT tu Animal (record) + implements Flyable/Swimmable (interface,
    method Dog TU VIET, CLR tu anh xa qua ten+chu ky trung khop, KHONG can
    field/state chia se). Tra ve THEM `interface_names: list[str]`.

    Tra ve (fields: list[(field_name, dtype_str)] - DA FLATTEN, field cua
    base (neu co) DUNG THEO THU TU TRUOC, roi den field RIENG cua class
    nay - giu dinh dang list[(name,dtype)] CU de MOI noi khac dung
    'records' dict (il_type_str, record_feature.py...) KHONG can doi gi;
    methods_raw: list[(sig_line, body_lines, is_static, is_property)] - CHI
    method RIENG cua class nay (KHONG lap lai method ke thua tu base - CLR tu
    dispatch qua v-table, xem gen_record_types); base_name: ten class cha
    hoac None; interface_names: list ten interface duoc implement)."""
    known_records = known_records or {}
    known_interfaces = known_interfaces or {}
    all_bases = [b for b in class_node.bases if not (isinstance(b, ast.Name) and b.id == 'object')]
    if class_node.keywords:
        raise TranspileError(f"class '{class_node.name}': khong ho tro tham so keyword trong base class")
    for b in all_bases:
        if not isinstance(b, ast.Name):
            raise TranspileError(
                f"class '{class_node.name}': base class phai la 1 TEN DON GIAN "
                f"(vd 'class Dog(Animal):'), gap {ast.dump(b)} o dong {class_node.lineno}")
    # 'Exception' la base DAC BIET (Giai doan 3, 2026-08-03): khong phai
    # record do nguoi dung khai bao ma la System.Exception cua .NET - cho
    # phep 'class MyError(Exception):' de co exception TU DINH NGHIA dung
    # duoc voi 'raise'/'except'. Van la Python hop le (Exception co san).
    record_bases_found = [b.id for b in all_bases
                          if b.id in known_records or b.id == _EXCEPTION_BASE_NAME]
    interface_names = [b.id for b in all_bases if b.id in known_interfaces]
    unknown_bases = [b.id for b in all_bases
                     if b.id not in known_records and b.id not in known_interfaces
                     and b.id != _EXCEPTION_BASE_NAME]
    if unknown_bases:
        raise TranspileError(
            f"class '{class_node.name}': base {sorted(unknown_bases)} chua duoc khai bao la "
            f"'class dang record' HOAC '@interface' TRUOC DO trong file (phai dinh nghia TRUOC "
            f"derived, giong quy uoc Python that)")
    base_name = record_bases_found[0] if record_bases_found else None
    # Phase 3.1 (2026-08-11, port tu cay .tkv tu-host): CHO PHEP nhieu base
    # la record (khac gioi han "1 base RECORD DUY NHAT" ban dau) - CLR chi
    # cho 1 base class THAT (extends), nen base_info gom CA CHUOI cac
    # record-base tim thay khi > 1 (dung boi gen_record_types/_field_owner_
    # class/_method_owner_class de resolve field/method qua toan bo pha he,
    # KHONG chi base dau tien).
    base_info = record_bases_found if len(record_bases_found) > 1 else base_name
    own_fields = []
    # base 'Exception' KHONG dong gop field nao (field cua System.Exception
    # la cua .NET, khong nam trong he thong record cua DSL). Gop field TU
    # MOI record-base tim thay (khong chi base dau tien) - 1 base sau vi
    # thuc te la '@interface' se tra ve [] (interface khong co field trong
    # known_records) nen khong anh huong truong hop pho bien (1 base).
    base_fields = []
    for b in record_bases_found:
        sec_f = known_records.get(b, [])
        for f_tuple in sec_f:
            if f_tuple not in base_fields:
                base_fields.append(f_tuple)
    fields = list(base_fields)
    # (2026-08-13) Chan field TRUNG TEN THAT giua nhieu base da ke thua (vd
    # class Combo(BaseA, BaseB) voi ca 2 base cung khai bao field 'val' KHAC
    # dtype). Neu khong chan o day, CIL sinh field theo ten tho, se crash
    # MissingFieldException luc chay. Field kim cuong HOP LE (2 base cung 1
    # to tien chung, field den tu to tien do) KHONG duoc chan nham: 2 owner
    # khac nhau nhung f_tuple (ten, dtype) GIONG HET nhau -> day la ke thua
    # hop le qua to tien chung, khong phai collision. Chi collision THAT khi
    # cung 1 ten field nhung f_tuple KHAC NHAU giua cac owner (dtype khac,
    # hoac field khac ban chat) tu 2 base doc lap.
    _field_owner_tuples = {}
    for b in record_bases_found:
        for f_tuple in known_records.get(b, []):
            fn = f_tuple[0]
            _field_owner_tuples.setdefault(fn, set()).add(f_tuple)
    _collisions = {fn: tuples for fn, tuples in _field_owner_tuples.items() if len(tuples) > 1}
    if _collisions:
        details = '; '.join(
            f"'{fn}' co dtype khac nhau giua cac base: {sorted(str(t) for t in tuples)}"
            for fn, tuples in _collisions.items())
        raise TranspileError(
            f"class '{class_node.name}': field trung ten giua nhieu base da ke thua ({details}) - "
            f"CIL sinh field theo ten tho, khong phan biet duoc field trung ten tu base khac nhau "
            f"(se crash MissingFieldException luc chay neu khong chan o day). Doi ten field o 1 "
            f"trong cac base de tranh trung.")
    methods_raw = []
    init_sigs = {}
    for stmt in class_node.body:
        if isinstance(stmt, ast.Expr) and isinstance(stmt.value, ast.Constant) and \
                isinstance(stmt.value.value, str):
            continue  # docstring cua class
        if isinstance(stmt, ast.FunctionDef) and stmt.name == '__init__':
            # BO QUA HOAN TOAN luc transpile (khong dung de sinh CIL - .ctor
            # THAT duoc gen_record_types() tu sinh tu chinh cac field ben
            # duoi) - CHI de file .tkv van la Python HOP LE, chay duoc that
            # (vd 'Point(1.0, 2.0)' goi duoc duoi CPython that khi doi
            # chieu ket qua), giong dung tinh than '.tkv van la Python that'
            # da xac lap tu Buoc 9 (doi ten .py->.tkv).
            #
            # 2026-09-25: giu LAI sig_line cua no trong `init_sigs` (KHONG
            # dua vao methods_raw - neu dua, .ctor se bi bien dich thanh 1
            # method ten '__init__' khong hop le CIL). Dung cho
            # _resolve_inferred_record_fields: field khai bao dtype
            # 'inferred' (field tro toi class o module KHAC) lay kieu THAT
            # tu tham so cung ten cua __init__.
            init_sigs[class_node.name] = (
                _extract_record_method_sig_line(class_node, stmt, is_static=False),
                _body_source_lines(source_lines, stmt))
            continue
        if isinstance(stmt, (ast.FunctionDef, ast.AsyncFunctionDef)):
            # Method THAT (khong phai __init__) - KHOANG TRONG #1, khac
            # __init__: co bien dich THAT sang CIL instance method (xem
            # gen_il_method), khong chi bo qua.
            #
            # '@staticmethod' (Wave 1 Nhom B, 2026-07-29): method KHONG
            # 'self' - bien dich thanh CIL 'static' (nhu 1 ham top-level)
            # thay vi 'instance', van goi duoc qua cu phap CO SAN
            # 'obj.method(...)' (giong Python that: staticmethod goi qua
            # INSTANCE van hop le).
            # '@property' (Phase C.3, 2026-07-29, xem project-tokenvector-
            # wave2-status memory - huong B da chot: desugar AST TRUOC khi
            # vao compile_attr, 0 dong thay doi o compile_attr/gen_record_
            # types): method la 1 GETTER binh thuong (instance, CHI nhan
            # 'self', co return type) - 'obj.propname' (doc, KHONG goi ())
            # o BAT KY dau trong chuong trinh se duoc desugar THANH
            # 'obj.propname()' (goi method that) TRUOC KHI parse xuong
            # il_codegen.py (xem _desugar_property_reads, goi tu cuoi
            # _parse_program_ast SAU KHI da biet DU property_names toan
            # chuong trinh). CHI ho tro GETTER (doc) - KHONG ho tro setter
            # (@x.setter) - gan '.propname = value' se tu nhien bao loi ro
            # rang o tang duoi (field khong ton tai) vi KHONG duoc desugar.
            # '@classmethod'/decorator tuy bien khac KHONG duoc ho tro (can
            # 'cls' runtime, ngoai pham vi).
            decorator_names = [d.id for d in stmt.decorator_list if isinstance(d, ast.Name)]
            unsupported = set(decorator_names) - {'staticmethod', 'property'}
            if unsupported:
                raise TranspileError(
                    f"method '{stmt.name}' cua class '{class_node.name}': decorator "
                    f"{sorted(unsupported)} chua duoc ho tro (chi '@staticmethod'/'@property')")
            is_static = 'staticmethod' in decorator_names
            is_property = 'property' in decorator_names
            if is_static and is_property:
                raise TranspileError(
                    f"method '{stmt.name}' cua class '{class_node.name}': '@staticmethod' va "
                    f"'@property' khong the dung CUNG luc")
            if is_property and len(stmt.args.args) != 1:
                raise TranspileError(
                    f"method '{stmt.name}' cua class '{class_node.name}': '@property' (getter) "
                    f"CHI duoc nhan dung 1 tham so 'self', khong tham so nao khac")
            sig_line = _extract_record_method_sig_line(class_node, stmt, is_static=is_static)
            body_lines = _body_source_lines(source_lines, stmt)
            methods_raw.append((sig_line, body_lines, is_static, is_property))
            continue
        if not isinstance(stmt, ast.AnnAssign) or stmt.value is not None:
            raise TranspileError(
                f"class '{class_node.name}': 'class dang record' chi ho tro cac dong "
                f"khai bao field DON THUAN 'ten: \"dtype\"' (khong gia tri mac dinh), "
                f"1 '__init__' TUY CHON (bi qua luc bien dich), va cac method THAT "
                f"(tham so dau '(self)') - gap {type(stmt).__name__} o dong {stmt.lineno}")
        if not isinstance(stmt.target, ast.Name):
            raise TranspileError(f"class '{class_node.name}': field o dong {stmt.lineno} phai la 1 ten don")
        dtype = _annotation_to_type_str(stmt.annotation, f"class '{class_node.name}' field '{stmt.target.id}'")
        # Field KHONG vo huong (container 'list[str]'/'dict[k,v]', hoac 1
        # class khac) GIU NGUYEN VAN BAN o day - ten class trong CUNG file
        # co the khai bao SAU ('class A: b: "B"'), nen viec phan giai doi
        # sang _resolve_record_field_types(), chay khi da biet DU ten cac
        # record (2026-08-03, dot 1).
        if stmt.target.id in dict(base_fields):
            raise TranspileError(
                f"class '{class_node.name}': field '{stmt.target.id}' da co san o base class "
                f"'{base_name}' - khong duoc khai bao lai (ghi de field ke thua chua ho tro)")
        fields.append((stmt.target.id, dtype))
    if not fields:
        raise TranspileError(f"class '{class_node.name}': record khong co field nao")
    return fields, methods_raw, base_name, base_info, interface_names, init_sigs


def _extract_namedtuple_def(assign_node):
    """'Point = namedtuple("Point", ["x", "y"])' hoac dang chuoi cach nhau
    boi khoang trang 'namedtuple("Point", "x y")' (Phase 3.2, 2026-08-11,
    nguoi dung chon "kieu built-in moi hoan chinh" - KHONG syntax sugar
    tren dict/tuple co san). Desugar NGAY O TANG PARSE thanh field list
    dung dinh dang (name, dtype) HET NHU 1 record record thuong (xem
    _extract_record_def) - field MAC DINH kieu "i32" (DSL khong co dynamic
    typing, khong the suy tu gia tri runtime luc bien dich). Ten record
    dung TEN BIEN duoc GAN ('Point' o 've trai') - tham so typename dau
    tien CHI de kiem tra dang hop le, khong dung lam ten (giong Python
    that cho phep 2 ten khac nhau nhung o day don gian hoa: PHAI GIONG
    ten bien, tranh 2 ten khac nhau cho cung 1 kieu gay nham lan doc code).

    Tra ve (record_name, fields: list[(name, "i32")])."""
    record_name = assign_node.targets[0].id
    call = assign_node.value
    if len(call.args) < 2 or call.keywords:
        raise TranspileError(
            f"'{record_name} = namedtuple(...)': can dung 2 tham so vi tri "
            f"(typename:str, field_names:list[str] hoac str cach nhau boi "
            f"khoang trang), khong ho tro tham so keyword")
    typename_node, fields_node = call.args[0], call.args[1]
    if not (isinstance(typename_node, ast.Constant) and isinstance(typename_node.value, str)):
        raise TranspileError(f"'{record_name} = namedtuple(...)': tham so dau (typename) phai la 1 chuoi")
    if typename_node.value != record_name:
        raise TranspileError(
            f"'{record_name} = namedtuple(\"{typename_node.value}\", ...)': typename phai GIONG "
            f"ten bien duoc gan ('{record_name}') - chua ho tro 2 ten khac nhau")
    if isinstance(fields_node, ast.Constant) and isinstance(fields_node.value, str):
        field_names = fields_node.value.replace(',', ' ').split()
    elif isinstance(fields_node, (ast.List, ast.Tuple)) and fields_node.elts and \
            all(isinstance(e, ast.Constant) and isinstance(e.value, str) for e in fields_node.elts):
        field_names = [e.value for e in fields_node.elts]
    else:
        raise TranspileError(
            f"'{record_name} = namedtuple(...)': tham so thu 2 (field_names) phai la 1 list "
            f"chuoi hoac 1 chuoi cach nhau boi khoang trang, vd ['x','y'] hoac \"x y\"")
    if not field_names:
        raise TranspileError(f"'{record_name} = namedtuple(...)': can it nhat 1 field")
    return record_name, [(fn, 'i32') for fn in field_names]


_FUNC_NAME_RE = re.compile(r'^(\w+)\(')

# 2026-09-25: 1 field record khai bao bang TEN CLASS don thuan (khong
# container, khong dtype vo huong) - vi du 'session: "InferenceSession"'.
# Regex nay nhan dien dang do; viec tra loi loai ten ra khoi danh sach
# class cua module hien tai do _resolve_deferred_record_field_types().
_BARE_CLASS_NAME_RE = re.compile(r'^\w+$')

# 2026-09-25: cac tu khoa container hop le trong 1 spec kieu
# ('list[...]'/'dict[...,...]' - xem _parse_container_spec_str). Moi 2 ten
# nay la 'ten' chu khong phai ten class.
_CONTAINER_KEYWORDS = frozenset(('list', 'dict'))

# Identifier trong 1 spec kieu - dung cho _mentions_unknown_class.
_IDENT_RE = re.compile(r'[A-Za-z_]\w*')


def _mentions_unknown_class(spec, dtypes):
    """True neu 1 spec kieu ('InferenceSession' / 'list[InferenceSession]' /
    'dict[str, GenRequest]') chua 1 TEN chua biet - dau hieu rang no tro
    toi 1 class o MODULE KHAC, chua the giai o thoi diem parse tung file
    (xem _resolve_deferred_record_field_types)."""
    for ident in _IDENT_RE.findall(spec):
        if ident in dtypes or ident in _CONTAINER_KEYWORDS:
            continue
        return True
    return False


def _desugar_property_reads(body_lines, property_names):
    """@property (Phase C.3, 2026-07-29, xem project-tokenvector-wave2-
    status memory - huong B da chot): rewrite VAN BAN THO 'obj.propname'
    (truy cap kieu FIELD, KHONG co '()') THANH 'obj.propname()' (goi
    method THAT) cho MOI ten trong 'property_names' - ap dung TOAN CUC
    theo TEN (khong scope theo tung kieu record cu the, don gian hoa co
    y thuc: 2 record KHAC NHAU dat CUNG 1 ten property se CHIA SE quy tac
    desugar - chap nhan duoc vi ten property thuong mang tinh mo ta ro
    rang, giong quy uoc dat ten bien khac trong DSL).

    CHI desugar dang DOC (khong theo sau '(' - tranh sua 'obj.propname()'
    da la 1 loi goi that thanh 2 cap ngoac). KHONG xu ly dang GHI ('obj.
    propname = value') - @property setter CHUA ho tro, dang GHI se KHONG
    duoc desugar nen tu nhien bao loi ro rang o tang duoi (field khong ton
    tai, vi 'propname' khong phai field THAT cua record)."""
    if not property_names:
        return body_lines
    prop_re = re.compile(r'\b(\w+)\.(' + '|'.join(re.escape(p) for p in property_names) + r')\b(?!\s*\()')
    return [prop_re.sub(lambda mo: f'{mo.group(1)}.{mo.group(2)}()', line) for line in body_lines]


_EXTERN_METHOD_KEYS = {'name', 'assembly', 'class', 'method', 'params', 'returns'}
_EXTERN_METHOD_REQUIRED = {'name', 'assembly', 'class', 'method', 'returns'}


def _parse_extern_method_dict_literal(node):
    """__tkv_extern_method__ (Task 2, 2026-08-14 - xem docs/superpowers/
    plans/2026-08-14-extern-method.md): parse 1 phan tu dict-literal cua
    pragma thanh dict Python thuong ({'name':..., 'assembly':..., 'class':
    ..., 'method':..., 'params': [...], 'returns':...}) - validate SHAPE
    (dict, key hop le, value dung kieu) o day; validate NGHIEP VU (dtype
    hop le, assembly da khai bao, trung ten builtin...) la Task 3."""
    if not isinstance(node, ast.Dict):
        raise TranspileError(
            "__tkv_extern_method__: moi phan tu phai la 1 dict voi cac key "
            "name/assembly/class/method/params/returns")
    result = {}
    for k, v in zip(node.keys, node.values):
        if not (isinstance(k, ast.Constant) and isinstance(k.value, str)):
            raise TranspileError("__tkv_extern_method__: key dict phai la chuoi")
        key = k.value
        if key not in _EXTERN_METHOD_KEYS:
            raise TranspileError(
                f"__tkv_extern_method__: key '{key}' khong hop le - chi chap nhan "
                f"{sorted(_EXTERN_METHOD_KEYS)}")
        if key == 'params':
            if not isinstance(v, ast.List):
                raise TranspileError("__tkv_extern_method__: 'params' phai la 1 list chuoi")
            params = []
            for elt in v.elts:
                if not (isinstance(elt, ast.Constant) and isinstance(elt.value, str)):
                    raise TranspileError("__tkv_extern_method__: moi phan tu 'params' phai la chuoi")
                params.append(elt.value)
            result['params'] = params
        else:
            if not (isinstance(v, ast.Constant) and isinstance(v.value, str)):
                raise TranspileError(f"__tkv_extern_method__: gia tri '{key}' phai la chuoi")
            result[key] = v.value
    result.setdefault('params', [])
    missing = _EXTERN_METHOD_REQUIRED - result.keys()
    if missing:
        raise TranspileError(
            f"__tkv_extern_method__: thieu key bat buoc {sorted(missing)}")
    return result


_EXTERN_CLASS_KEYS = {'name', 'assembly', 'class', 'ctor', 'methods', 'properties', 'static_methods',
                     'static_fields'}
_EXTERN_CLASS_REQUIRED = {'name', 'assembly', 'class', 'ctor', 'methods'}
_EXTERN_CLASS_METHOD_KEYS = {'name', 'params', 'returns'}
_EXTERN_CLASS_METHOD_REQUIRED = {'name', 'params', 'returns'}
_EXTERN_CLASS_PROPERTY_KEYS = {'name', 'dtype', 'readonly'}
_EXTERN_CLASS_PROPERTY_REQUIRED = {'name', 'dtype'}
_EXTERN_CLASS_STATIC_FIELD_KEYS = {'name', 'dtype', 'value'}
_EXTERN_CLASS_STATIC_FIELD_REQUIRED = {'name', 'dtype'}


def _parse_str_list_literal(node, ctx_label):
    if not isinstance(node, ast.List):
        raise TranspileError(f"{ctx_label} phai la 1 list")
    out = []
    for elt in node.elts:
        if not (isinstance(elt, ast.Constant) and isinstance(elt.value, str)):
            raise TranspileError(f"{ctx_label}: moi phan tu phai la string literal")
        out.append(elt.value)
    return out


def _parse_extern_class_method_dict_literal(node):
    if not isinstance(node, ast.Dict):
        raise TranspileError("__tkv_extern_class__'s 'methods': moi phan tu phai la 1 dict-literal")
    result = {}
    for k_node, v_node in zip(node.keys, node.values):
        if not (isinstance(k_node, ast.Constant) and isinstance(k_node.value, str)):
            raise TranspileError("__tkv_extern_class__'s method dict: key phai la string literal")
        key = k_node.value
        if key not in _EXTERN_CLASS_METHOD_KEYS:
            raise TranspileError(
                f"__tkv_extern_class__'s method dict: key {key!r} khong hop le, "
                f"chi chap nhan {sorted(_EXTERN_CLASS_METHOD_KEYS)}")
        if key == 'params':
            result[key] = _parse_str_list_literal(v_node, "__tkv_extern_class__'s method 'params'")
        else:
            if not (isinstance(v_node, ast.Constant) and isinstance(v_node.value, str)):
                raise TranspileError(f"__tkv_extern_class__'s method dict: key {key!r} phai la string literal")
            result[key] = v_node.value
    missing = _EXTERN_CLASS_METHOD_REQUIRED - set(result.keys())
    if missing:
        raise TranspileError(f"__tkv_extern_class__'s method dict thieu key bat buoc: {sorted(missing)}")
    return result


def _parse_extern_class_property_dict_literal(node):
    """__tkv_extern_class__ (Task 1, extern-class-property): parse 1 phan tu
    dict-literal cua key 'properties' thanh dict Python thuong ({'name':...,
    'dtype':..., 'readonly':...}) - validate SHAPE o day (dict, key hop le,
    value dung kieu); 'readonly' mac dinh True neu vang mat. Validate NGHIEP
    VU (dtype hop le, collision voi 'methods'...) la o compile_tkv_cli."""
    if not isinstance(node, ast.Dict):
        raise TranspileError("__tkv_extern_class__'s 'properties': moi phan tu phai la 1 dict-literal")
    result = {}
    for k_node, v_node in zip(node.keys, node.values):
        if not (isinstance(k_node, ast.Constant) and isinstance(k_node.value, str)):
            raise TranspileError("__tkv_extern_class__'s property dict: key phai la string literal")
        key = k_node.value
        if key not in _EXTERN_CLASS_PROPERTY_KEYS:
            raise TranspileError(
                f"__tkv_extern_class__'s property dict: key {key!r} khong hop le, "
                f"chi chap nhan {sorted(_EXTERN_CLASS_PROPERTY_KEYS)}")
        if key == 'readonly':
            if not (isinstance(v_node, ast.Constant) and isinstance(v_node.value, bool)):
                raise TranspileError("__tkv_extern_class__'s property 'readonly' phai la True/False")
            result[key] = v_node.value
        else:
            if not (isinstance(v_node, ast.Constant) and isinstance(v_node.value, str)):
                raise TranspileError(f"__tkv_extern_class__'s property dict: key {key!r} phai la string literal")
            result[key] = v_node.value
    missing = _EXTERN_CLASS_PROPERTY_REQUIRED - set(result.keys())
    if missing:
        raise TranspileError(f"__tkv_extern_class__'s property dict thieu key bat buoc: {sorted(missing)}")
    result.setdefault('readonly', True)
    return result


def _parse_extern_class_static_field_dict_literal(node):
    """__tkv_extern_class__ 'static_fields' (P1, 2026-09-23): parse 1 phan tu
    dict-literal cua key 'static_fields' thanh dict Python thuong ({'name':...,
    'dtype':...[, 'value':...]}) - field TINH cua class .NET (vd String.Empty,
    Int32.MaxValue), doc qua 'ldsfld' (KHONG phai callvirt get_X nhu property).

    'value' (tuy chon, string): hang so BIEN DICH cho field dang literal/const
    (vd Int32.MaxValue = "2147483647") - const KHONG co dia chi runtime nen
    'ldsfld' se nem MissingFieldException; co 'value' thi compiler noi tuyen
    hang so (ldc/ldstr) thay vi doc field. CHI cho phep voi dtype vo huong/
    string/enum; validate CHI TIET o compile_tkv_cli (can _is_valid_extern_dtype)."""
    if not isinstance(node, ast.Dict):
        raise TranspileError("__tkv_extern_class__'s 'static_fields': moi phan tu phai la 1 dict-literal")
    result = {}
    for k_node, v_node in zip(node.keys, node.values):
        if not (isinstance(k_node, ast.Constant) and isinstance(k_node.value, str)):
            raise TranspileError("__tkv_extern_class__'s static-field dict: key phai la string literal")
        key = k_node.value
        if key not in _EXTERN_CLASS_STATIC_FIELD_KEYS:
            raise TranspileError(
                f"__tkv_extern_class__'s static-field dict: key {key!r} khong hop le, "
                f"chi chap nhan {sorted(_EXTERN_CLASS_STATIC_FIELD_KEYS)}")
        if not (isinstance(v_node, ast.Constant) and isinstance(v_node.value, str)):
            raise TranspileError(f"__tkv_extern_class__'s static-field dict: key {key!r} phai la string literal")
        result[key] = v_node.value
    missing = _EXTERN_CLASS_STATIC_FIELD_REQUIRED - set(result.keys())
    if missing:
        raise TranspileError(f"__tkv_extern_class__'s static-field dict thieu key bat buoc: {sorted(missing)}")
    return result


def _validate_extern_static_field_value(_f, _decl_name):
    """Validate 'value' (hang so noi tuyen) cua 1 static field - goi tu
    compile_tkv_cli SAU khi dtype da hop le. Tra None neu khong co 'value';
    raise TranspileError neu dtype khong ho tro const noi tuyen hoac value
    khong parse duoc ve dung kieu."""
    if 'value' not in _f:
        return None
    _dtype, _val = _f['dtype'], _f['value']
    if _dtype == 'str':
        return None
    if _dtype == 'bool':
        if _val not in ('True', 'False', 'true', 'false', '1', '0'):
            raise TranspileError(
                f"__tkv_extern_class__: static field {_f['name']!r} cua {_decl_name!r} "
                f"co 'value' {_val!r} khong phai bool (chi 'True'/'False'/'1'/'0')")
        return None
    if _dtype in ('i32', 'i64', 'u64') or (isinstance(_dtype, str) and _dtype.startswith('enum:')):
        try:
            _num = int(_val, 0)
        except ValueError:
            raise TranspileError(
                f"__tkv_extern_class__: static field {_f['name']!r} cua {_decl_name!r} "
                f"co 'value' {_val!r} khong phai so nguyen")
        _lo, _hi = (-(2 ** 31), 2 ** 31 - 1) if _dtype == 'i32' else \
            (0, 2 ** 64 - 1) if _dtype == 'u64' else (-(2 ** 63), 2 ** 63 - 1)
        if _dtype.startswith('enum:'):
            _lo, _hi = -(2 ** 31), 2 ** 31 - 1
        if not (_lo <= _num <= _hi):
            raise TranspileError(
                f"__tkv_extern_class__: static field {_f['name']!r} cua {_decl_name!r} "
                f"co 'value' {_val!r} ngoai khoang {_dtype} ({_lo}..{_hi})")
        if _dtype == 'u64' and _num > 2 ** 63 - 1:
            raise TranspileError(
                f"__tkv_extern_class__: static field {_f['name']!r} cua {_decl_name!r} "
                f"co 'value' {_val!r} vuot qua int64 - 'u64' const noi tuyen v1 chi ho tro "
                f"gia tri vua int64 (lon hon can doc qua field that)")
        return None
    if _dtype in ('f32', 'f64'):
        try:
            float(_val)
        except ValueError:
            raise TranspileError(
                f"__tkv_extern_class__: static field {_f['name']!r} cua {_decl_name!r} "
                f"co 'value' {_val!r} khong phai so thuc")
        return None
    raise TranspileError(
        f"__tkv_extern_class__: static field {_f['name']!r} cua {_decl_name!r} "
        f"co 'value' nhung dtype {_dtype!r} khong ho tro const noi tuyen "
        f"(chi i32/i64/u64/f32/f64/str/bool/enum) - bo 'value' de doc qua ldsfld")


def _parse_extern_class_dict_literal(node):
    """__tkv_extern_class__ (Task 1, 2026-08-18 - xem docs/superpowers/
    plans/extern-class): parse 1 phan tu dict-literal cua pragma thanh dict
    Python thuong ({'name':..., 'assembly':..., 'class':..., 'ctor': [...],
    'methods': [...]}) - validate SHAPE (dict, key hop le, value dung kieu)
    o day; validate NGHIEP VU (dtype hop le, assembly da khai bao...) la
    Task 3, giong het cach lam voi _parse_extern_method_dict_literal."""
    if not isinstance(node, ast.Dict):
        raise TranspileError("__tkv_extern_class__ phai la 1 list cac dict-literal")
    result = {}
    for k_node, v_node in zip(node.keys, node.values):
        if not (isinstance(k_node, ast.Constant) and isinstance(k_node.value, str)):
            raise TranspileError("__tkv_extern_class__: key phai la string literal")
        key = k_node.value
        if key not in _EXTERN_CLASS_KEYS:
            raise TranspileError(
                f"__tkv_extern_class__: key {key!r} khong hop le, "
                f"chi chap nhan {sorted(_EXTERN_CLASS_KEYS)}")
        if key == 'ctor':
            result[key] = _parse_str_list_literal(v_node, "__tkv_extern_class__'s 'ctor'")
        elif key == 'methods':
            if not isinstance(v_node, ast.List):
                raise TranspileError("__tkv_extern_class__'s 'methods' phai la 1 list")
            result[key] = [_parse_extern_class_method_dict_literal(m) for m in v_node.elts]
        elif key == 'properties':
            if not isinstance(v_node, ast.List):
                raise TranspileError("__tkv_extern_class__'s 'properties' phai la 1 list")
            result[key] = [_parse_extern_class_property_dict_literal(p) for p in v_node.elts]
        elif key == 'static_methods':
            # Task 2 (Phase 9d Part A, 2026-08-26): 'static_methods' dung
            # CHUNG shape voi 'methods' (dict {'name','params','returns'}) -
            # tai su dung y het _parse_extern_class_method_dict_literal,
            # KHONG viet ham parse rieng.
            if not isinstance(v_node, ast.List):
                raise TranspileError("__tkv_extern_class__'s 'static_methods' phai la 1 list")
            result[key] = [_parse_extern_class_method_dict_literal(m) for m in v_node.elts]
        elif key == 'static_fields':
            # P1 (2026-09-23): 'static_fields' - field TINH (ldsfld), shape
            # {'name','dtype'} qua ham parse rieng o tren.
            if not isinstance(v_node, ast.List):
                raise TranspileError("__tkv_extern_class__'s 'static_fields' phai la 1 list")
            result[key] = [_parse_extern_class_static_field_dict_literal(f) for f in v_node.elts]
        else:
            if not (isinstance(v_node, ast.Constant) and isinstance(v_node.value, str)):
                raise TranspileError(f"__tkv_extern_class__: key {key!r} phai la string literal")
            result[key] = v_node.value
    result.setdefault('properties', [])
    result.setdefault('static_methods', [])
    result.setdefault('static_fields', [])
    missing = _EXTERN_CLASS_REQUIRED - set(result.keys())
    if missing:
        raise TranspileError(f"__tkv_extern_class__ thieu key bat buoc: {sorted(missing)}")
    return result


_EXTERN_PINVOKE_KEYS = {'name', 'dll', 'symbol', 'convention', 'params', 'returns'}
_EXTERN_PINVOKE_REQUIRED = {'name', 'dll', 'symbol', 'convention', 'returns'}


def _parse_extern_pinvoke_dict_literal(node):
    """__tkv_extern_pinvoke__ (Task 2, 2026-08-17 - xem docs/superpowers/
    plans/2026-08-17-extern-pinvoke.md): parse 1 phan tu dict-literal cua
    pragma thanh dict Python thuong ({'name':..., 'dll':..., 'symbol':
    ..., 'convention':..., 'params': [...], 'returns':...}) - validate SHAPE
    (dict, key hop le, value dung kieu) o day; validate NGHIEP VU (dtype
    hop le, sinh pinvokeimpl, dang ky dong builtin...) la Task 3."""
    if not isinstance(node, ast.Dict):
        raise TranspileError(
            "__tkv_extern_pinvoke__: moi phan tu phai la 1 dict voi cac key "
            "name/dll/symbol/convention/params/returns")
    result = {}
    for k, v in zip(node.keys, node.values):
        if not (isinstance(k, ast.Constant) and isinstance(k.value, str)):
            raise TranspileError("__tkv_extern_pinvoke__: key dict phai la chuoi")
        key = k.value
        if key not in _EXTERN_PINVOKE_KEYS:
            raise TranspileError(
                f"__tkv_extern_pinvoke__: key '{key}' khong hop le - chi chap nhan "
                f"{sorted(_EXTERN_PINVOKE_KEYS)}")
        if key == 'params':
            if not isinstance(v, ast.List):
                raise TranspileError("__tkv_extern_pinvoke__: 'params' phai la 1 list chuoi")
            params = []
            for elt in v.elts:
                if not (isinstance(elt, ast.Constant) and isinstance(elt.value, str)):
                    raise TranspileError("__tkv_extern_pinvoke__: moi phan tu 'params' phai la chuoi")
                params.append(elt.value)
            result['params'] = params
        else:
            if not (isinstance(v, ast.Constant) and isinstance(v.value, str)):
                raise TranspileError(f"__tkv_extern_pinvoke__: gia tri '{key}' phai la chuoi")
            result[key] = v.value
    result.setdefault('params', [])
    missing = _EXTERN_PINVOKE_REQUIRED - result.keys()
    if missing:
        raise TranspileError(
            f"__tkv_extern_pinvoke__: thieu key bat buoc {sorted(missing)}")
    return result


# R1 (2026-09-22, __tkv_struct__): struct blittable cho pinvoke 2 chieu.
_STRUCT_FIELD_IL = {'i16': 'int16', 'i32': 'int32', 'i64': 'int64',
                    'f32': 'float32', 'f64': 'float64'}
_STRUCT_DTYPE_RE = re.compile(r'^[A-Za-z_]\w*$')
_STRUCT_PTR_RE = re.compile(r'^([A-Za-z_]\w*)\*$')


def _pinvoke_param_il(p):
    """IL text cho 1 pinvoke param: scalar qua bang, 'Name*' (R1) thanh
    'valuetype Name&' (managed pointer - blittable struct marshal truc
    tiep, khong can pin/unmanaged copy), 'ptr' (F4a) thanh 'native int'
    (con tro native opague: IntPtr/HWND/COM... - phia TokenVector la i64)."""
    if p == 'ptr':
        return 'native int'
    _m = _STRUCT_PTR_RE.match(p) if isinstance(p, str) else None
    if _m is not None:
        return f'valuetype {_m.group(1)}&'
    return _EXTERN_DTYPE_TO_IL[p]


def _parse_struct_dict_literal(node):
    """Parse 1 phan tu dict-literal cua __tkv_struct__ thanh
    {'name':..., 'fields': [(fname, fdtype), ...]} - vd
    {"name": "Point", "fields": [["x", "i32"], ["y", "i32"]]}.
    Field dtype CHI 5 kieu blittable (i16/i32/i64/f32/f64) - dam bao
    struct co the marshal thang qua pinvoke ma khong can custom marshaler."""
    if not isinstance(node, ast.Dict):
        raise TranspileError("__tkv_struct__: moi phan tu phai la 1 dict {'name', 'fields'}")
    result = {}
    for k, v in zip(node.keys, node.values):
        if not (isinstance(k, ast.Constant) and isinstance(k.value, str)):
            raise TranspileError("__tkv_struct__: key dict phai la chuoi")
        key = k.value
        if key not in ('name', 'fields'):
            raise TranspileError(
                f"__tkv_struct__: key '{key}' khong hop le - chi chap nhan 'name'/'fields'")
        if key == 'name':
            if not (isinstance(v, ast.Constant) and isinstance(v.value, str)):
                raise TranspileError("__tkv_struct__: 'name' phai la chuoi")
            if not _STRUCT_DTYPE_RE.match(v.value):
                raise TranspileError(
                    f"__tkv_struct__: 'name' = {v.value!r} khong phai identifier hop le")
            result['name'] = v.value
        else:
            if not isinstance(v, ast.List) or not v.elts:
                raise TranspileError("__tkv_struct__: 'fields' phai la 1 list KHAC RONG cac [ten, kieu]")
            fields = []
            seen = set()
            for elt in v.elts:
                if not (isinstance(elt, ast.List) and len(elt.elts) == 2 and
                        all(isinstance(e, ast.Constant) and isinstance(e.value, str)
                            for e in elt.elts)):
                    raise TranspileError(
                        "__tkv_struct__: moi field phai la ['ten', 'kieu'] (chuoi), "
                        "kieu trong i16/i32/i64/f32/f64")
                fname, fdtype = elt.elts[0].value, elt.elts[1].value
                if not _STRUCT_DTYPE_RE.match(fname):
                    raise TranspileError(
                        f"__tkv_struct__: ten field {fname!r} khong phai identifier hop le")
                if fdtype not in _STRUCT_FIELD_IL:
                    raise TranspileError(
                        f"__tkv_struct__: field '{fname}' kieu {fdtype!r} khong ho tro - "
                        f"chi {sorted(_STRUCT_FIELD_IL)} (blittable cho pinvoke)")
                if fname in seen:
                    raise TranspileError(
                        f"__tkv_struct__: field '{fname}' khai TRUNG LAP")
                seen.add(fname)
                fields.append((fname, fdtype))
            result['fields'] = fields
    if set(result) != {'name', 'fields'}:
        raise TranspileError("__tkv_struct__: moi dict can du 'name' + 'fields'")
    return result


def _struct_il_lines(struct_defs):
    """Sinh khoi '.class ... sequential ... ValueType' cho MOI struct -
    ghep vao extra_classes (ngoai class chuong trinh chinh) trong
    compile_tkv_cli. Kem 1 .ctor nhan DU fields (de new_X(a, b) dung
    newobj) - struct khong field thi chi co fields (dung newobj .ctor
    mac dinh ngam)."""
    lines = []
    for sname, sdef in struct_defs.items():
        fields = sdef['fields']
        lines.append(f'.class public sequential ansi sealed beforefieldinit {sname}')
        lines.append('       extends [mscorlib]System.ValueType')
        lines.append('{')
        for fname, fdtype in fields:
            lines.append(f'  .field public {_STRUCT_FIELD_IL[fdtype]} \'{fname}\'')
        params = ', '.join(f'{_STRUCT_FIELD_IL[t]} \'{n}\'' for n, t in fields)
        lines.append(f'  .method public hidebysig specialname rtspecialname instance void .ctor({params}) cil managed')
        lines.append('  {')
        lines.append('    .maxstack 8')
        for fname, fdtype in fields:
            lines.append('    ldarg.0')
            lines.append(f'    ldarg {_il_ctor_arg_index(fields, fname)}')
            lines.append(f'    stfld {_STRUCT_FIELD_IL[fdtype]} {sname}::\'{fname}\'')
        lines.append('    ret')
        lines.append('  }')
        lines.append('}')
    return lines


def _il_ctor_arg_index(fields, fname):
    """Chi so ldarg (1-based, ke ca this=0) cua field trong .ctor."""
    for i, (n, _t) in enumerate(fields):
        if n == fname:
            return i + 1
    raise AssertionError(f"field {fname!r} khong ton tai (loi noi bo compiler)")


def _make_struct_ctor_codegen(struct_name, fields):
    """Factory codegen cho builtin 'new_<Struct>' (R1): new_Point(a, b) /
    new_SystemTime() - newobj .ctor de lai 1 GIA TRI valuetype tren stack
    (dung duoc o MOI vi tri bieu thuc, khong can temp). Chap nhan 0 arg
    (zero-init: day defaults + full .ctor, tranh goi .ctor mac dinh ngam
    cua valuetype chua kiem chung) hoac DU arg (theo thu tu fields)."""
    il_param_types = [_STRUCT_FIELD_IL[t] for _n, t in fields]
    _zero_il = {'i16': ['    ldc.i4.0'], 'i32': ['    ldc.i4.0'],
                'i64': ['    ldc.i8 0'], 'f32': ['    ldc.r4 0.0'],
                'f64': ['    ldc.r8 0.0']}

    def _codegen(args, scope, out, dtype, ctx):
        if len(args) != 0 and len(args) != len(fields):
            raise SyntaxError(
                f"il_codegen: 'new_{struct_name}(...)' can 0 hoac {len(fields)} tham so "
                f"(theo thu tu fields {[n for n, _t in fields]}), duoc goi voi {len(args)}")
        compile_expr = ctx['compile_expr']
        if not args:
            for _fname, fdtype in fields:
                out.extend(_zero_il[fdtype])
        else:
            for arg_node, (fname, fdtype) in zip(args, fields):
                compile_expr(arg_node, scope, out,
                             'i32' if fdtype == 'i16' else fdtype, ctx)
                if fdtype == 'i16':
                    out.append('    conv.i2')
        out.append(f'    newobj instance void {struct_name}::.ctor({", ".join(il_param_types)})')
    return _codegen


# Task 3 (2026-08-14, __tkv_extern_method__): bang dtype DSL -> ten kieu CIL
# dung trong chu ky 'call' - doi chieu IL_SCALAR (il_core.py) de khong lech
# chinh ta ('int32'/'float64'/'string'...). Khong dua 'object'/'thread' vao
# day - Phase 1 CHI ho tro scalar co ban (xem spec "Pham vi KHONG lam").
#
# Phase 9b (2026-08-24, bool): 'bool' la 1 ngoai le CO CHU DICH cua nguyen
# tac tren - KHONG phai "mo rong tuy tien". .NET IL 'bool' tuong thich
# bit-for-bit voi 'int32' tren CIL evaluation stack (0/1, khong can
# conv.* chuyen doi), CHI khac ten kieu trong CHU KY method (dung de .NET
# runtime resolve overload luc nap assembly - sai ten kieu la nguyen nhan
# MissingMethodException, xem bai hoc Critical 2 cua Phase 9a). TokenVector
# KHONG co kieu bool rieng - gia tri phia TokenVector LUON la i32 (0/1),
# 'bool' O DAY chi la 1 NHAN CHO CHU KY IL, khong phai 1 dtype TokenVector
# moi (KHONG dua vao typed_dsl_parser.py's DTYPES - xem Global Constraints
# cua plan Phase 9b). _widen_if_needed (il_codegen.py) da xac nhan AN TOAN
# no-op voi dtype la 'bool' (khong khop nhanh if nao, khong KeyError) -
# khong can sua gi them o codegen.
_EXTERN_DTYPE_TO_IL = {'i32': 'int32', 'i64': 'int64', 'f32': 'float32',
                        'f64': 'float64', 'str': 'string', 'bool': 'bool',
                        # Task 3 (RamGuard TokenVector Rewrite, 2026-08-31):
                        # 'u64' - mirror 'bool'/'enum:...', can vi 1 so
                        # property BCL that (vd ComputerInfo.
                        # AvailablePhysicalMemory) tra ve System.UInt64,
                        # callvirt doi khop CHINH XAC chu ky 'unsigned
                        # int64' - dung 'int64' gay MissingMethodException
                        # (xem task-3-report.md). Gia tri PHIA TOKENVECTOR
                        # van la i64 thuong qua _tokenvector_facing_dtype.
                        'u64': 'unsigned int64',
                        # Phase 9d Part B (2026-08-27): 'object' CHAP NHAN
                        # BAT KY handle-type __tkv_extern_class__ nao lam
                        # tham so (System.Object passthrough) - dtype nay
                        # KHONG can validate rieng vi _expr_var's
                        # widen_if_needed la no-op an toan voi moi dtype
                        # KHONG phai so (da xac nhan qua doc code, xem
                        # Architecture cua plan Phase 9d Part B), va CIL
                        # cho phep nap MOI reference type vao vi tri tham
                        # so khai 'object' ma khong can castclass. 'type'
                        # la dtype rieng cho System.Type (dung voi
                        # typeof(ClassName), xem Task 3) - IL text cua no
                        # LA CHUOI DAC BIET 'type' o day (khong phai IL
                        # that), duoc _il_ctor_param_type short-circuit
                        # thanh 'class [mscorlib]System.Type' truoc khi
                        # dung (xem duoi, mirror enum:... cua Phase 9c) -
                        # entry nay trong _EXTERN_DTYPE_TO_IL CHI can co
                        # mat de _is_valid_extern_dtype/validate loops
                        # cong nhan 'type' la 1 dtype hop le, GIA TRI
                        # 'type' o day KHONG bao gio duoc dung truc tiep
                        # lam van ban IL (luon di qua short-circuit rieng).
                        'object': 'object', 'type': 'type'}

# Phase 9c (2026-08-26, enum): dtype "tham so hoa" cho tham so/return la 1
# .NET enum (underlying Int32) - KHONG the la 1 hang so co dinh nhu 'bool'
# vi moi enum co 1 ten kieu CIL rieng ('valuetype [Assembly]Full.Name').
# Dinh dang: "enum:<ten-assembly>:<FullName>" - ca 2 phan deu PHAI khop
# _EXTERN_ASSEMBLY_NAME_RE/_EXTERN_CLASS_NAME_RE (chan injection vao van
# ban CIL, giong moi validate khac trong file nay).
#
# QUAN TRONG (final review Phase 9c, Important #3): dinh dang nay CHI GIA
# DINH (khong xac minh) rang underlying type cua enum la System.Int32 -
# viec dam bao dieu do la trach nhiem CUA BEN SINH ra dtype string nay
# (tools/tkv_bind/type_map.py::map_enum, kiem tra underlyingType truoc khi
# tra ve). Regex nay KHONG the (va khong) tu kiem tra underlying type -
# 1 file .tkv viet tay dung dtype 'enum:...' cho 1 enum KHONG backed boi
# Int32 (vd Byte/Int16/Int64) se BI SAI LECH AM THAM (silently misbehave):
# CIL signature dung ten kieu enum that (dung), nhung TokenVector van doi
# xu voi gia tri tren stack nhu i32 thuong (_tokenvector_facing_dtype) ->
# sai do rong/dau, khong loi bien dich ro rang. Mo rong dinh dang trong
# tuong lai (vd them truong thu 4 "enum:<assembly>:<FullName>:<underlying>")
# se can thiet de compiler tu ve (self-defending) truoc truong hop nay -
# NGOAI PHAM VI final review nay (documentation-only fix).
_EXTERN_ENUM_DTYPE_RE = re.compile(
    r'^enum:(?P<assembly>[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)'
    r':(?P<full_name>[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)$')

# R13 (2026-09-26): container dtype cho __tkv_extern_method__ -
# "list[<scalar>]" trong 'params'/'returns'. LY DO: truoc day ABI cua
# extern method CHI scalar, nen KHONG goi duoc 1 ham .NET/TokenVector nhan
# hoac tra List<T> (vd 1 thu vien byte codec viet bang .tkv, build bang
# `tkvc build --target library`, goi qua __tkv_extern_method__).
#
# VI SAO AN TOAN: TokenVector BIEU DIEN list[i64] BANG CHINH
# System.Collections.Generic.List`1<int64> (xem il_features/list_type.tkv
# ::il_container_type_of_spec) - 1 REFERENCE TYPE cua mscorlib. Mat khau
# chuan cua .NET: truyen/trả reference type giua 2 assembly KHONG can
# marshaling gi, khac 'ptr' native (F4a) hay struct truyen dia chi. nen
# can IT DUY NHAT la sinh dung ten kieu trong CHU KY - gia tri tren stack
# da la reference dung roi.
#
# HANH VI o ben trong TokenVector: _widen_if_chi_... co ten chinh xac la
# _widen_if_needed - CHI ep int<->float, co no-op voi 'list[...]' (xem
# il_codegen.py::_widen_if_needed dong ~1611: chi khi actual/requested
# deu thuoc _INT_DTYPES/_FLOAT_DTYPES moi hanh dong), nen truyen list
# qua ham extern KHONG can ep them gi.
#
# PHAM VI: chi 1 LOP. Phan tu CHI scalar trong _EXTERN_DTYPE_TO_IL
# (i32/i64/f32/f64/str/bool/u64) - chua mo list long nhau (list[list[i64]])
# hay dict; 2 dang do dien ra o phan tu nen can ban co ve generic variance
# va can test rieng, de o phase sau.
_EXTERN_LIST_DTYPE_RE = re.compile(r'^list\[(?P<elem>[a-z0-9_]+)\]$')


def _is_valid_extern_dtype(dtype):
    """True neu dtype la 1 scalar co dinh (_EXTERN_DTYPE_TO_IL) HOAC 1
    dtype enum hop le dinh dang 'enum:<assembly>:<FullName>' (Phase 9c).
    KHONG kiem tra extern_class_defs/container o day - nguoi goi tu ket
    hop voi cac dieu kien do, giong het pattern '_dtype not in
    _EXTERN_DTYPE_TO_IL and _dtype not in extern_class_defs' da co.

    LUU Y (final review Phase 9c, Important #3): dinh dang 'enum:...' o
    day CHI xac nhan cu phap (2 phan dot-separated identifier hop le),
    KHONG xac minh underlying type cua enum thuc su la System.Int32 -
    dieu do do ben sinh dtype dam bao (tools/tkv_bind/type_map.py::
    map_enum). Xem comment tai dinh nghia _EXTERN_ENUM_DTYPE_RE ve rui ro
    khi 1 file .tkv viet tay dung dtype nay cho enum khong backed Int32."""
    return dtype in _EXTERN_DTYPE_TO_IL or bool(_EXTERN_ENUM_DTYPE_RE.match(dtype)) or _extern_list_elem(dtype) is not None


def _extern_list_elem(dtype):
    """R13 (2026-09-26): tra ve 'tieu hoa phan tu' cua dtype dang
    'list[<scalar>]' (vd 'list[i64]' -> 'i64'), HOAC None neu khong phai
    container hop le. Kiem tra phan tu quay lai 1 dtype scalar hop le nen
    'list[gia_vay]'/'' rong bi tu choi o day - error message cua caller
    (validate) se bao cho nguoi dung. Dung chung cho _is_valid_extern_dtype
    va _extern_il_type_text de 2 noi KHONG lech quy tac."""
    m = _EXTERN_LIST_DTYPE_RE.match(dtype)
    if m is None:
        return None
    elem = m.group('elem')
    return elem if elem in _EXTERN_DTYPE_TO_IL else None


def _extern_il_type_text(dtype):
    """Van ban kieu CIL dung trong chu ky 'call'/'callvirt'/'newobj' cho 1
    dtype da qua _is_valid_extern_dtype. Scalar co dinh -> tra thang
    _EXTERN_DTYPE_TO_IL[dtype] (hanh vi CU, khong doi). dtype enum ->
    'valuetype [assembly]FullName' (Phase 9c) - GIA TRI tren stack van la
    1 i32 thuong (enum Int32-backed tuong thich bit-for-bit), CHI ten kieu
    trong chu ky la khac 'int32'."""
    if dtype == 'type':
        # Critical 2 (final review Phase 9d Part B, 2026-08-27): 'type'
        # KHONG duoc short-circuit o day truoc fix nay - _EXTERN_DTYPE_TO_IL
        # co khoa 'type' -> 'type' (CHI la placeholder validation, khong
        # phai IL that, xem chu thich tai _EXTERN_DTYPE_TO_IL) nen nhanh
        # 'il is not None' ben duoi se tra thang chuoi 'type' theo NGHIA
        # DEN - sinh chu ky IL sai ('call ... Method(type)'), ilasm that bai
        # voi loi cu phap. Mirror y het short-circuit da co cua
        # _il_ctor_param_type (il_codegen.py) - dung LAI cung 1 chuoi IL
        # ('class [mscorlib]System.Type'). Sau Critical 2's fix o
        # _validate_and_register_extern_method/_validate_and_register_
        # extern_pinvoke (tu choi 'type' truoc khi toi day), nhanh nay
        # thuc te KHONG con duong goi tu 2 diem do nua - giu lai de
        # _extern_il_type_text() TU THAN AN TOAN (defense-in-depth) neu co
        # diem goi moi trong tuong lai quen kiem tra truoc.
        return 'class [mscorlib]System.Type'
    if dtype == 'ptr':
        # F4a (2026-09-23): con tro native (IntPtr/HWND/COM interface* -
        # vd Marshal.GetIUnknownForObject tra IntPtr) - chu ky IL
        # 'native int', phia TokenVector la i64 (xem _tokenvector_facing_dtype).
        return 'native int'
    if dtype in il_codegen._EXTERN_CLASS_DEFS:
        # Phase 9e (2026-08-27): handle-type (vd 'Sb') lam dtype cho
        # __tkv_extern_method__ - mirror y het IL text mau
        # _make_extern_class_method_codegen dung cho instance method
        # (f"[{decl['assembly']}]{decl['class']}"), CHI khac 'class ' prefix
        # vi day la chu ky tham so/return, khong phai call_target.
        _decl = il_codegen._EXTERN_CLASS_DEFS[dtype]
        if _decl['class'].startswith('generic:'):
            return _extern_class_ref(_decl)
        return f"class [{_decl['assembly']}]{_decl['class']}"
    il = _EXTERN_DTYPE_TO_IL.get(dtype)
    if il is not None:
        return il
    # R13 (2026-09-26): 'list[<scalar>]' -> List`1<elem>. TEN KIEU dung
    # y het il_codegen::il_type_str (dong ~210) va il_features/list_type.tkv
    # ::il_container_type_of_spec (dong ~88) - 3 noi nay phai ra CUNG 1
    # kieu CLR, neu khong 1 bien 'list[i64]' o 2 ben lech nhau 1 ky tu
    # backtick/Assembly la MissingMethodException luc nap assembly.
    #
    # GHI CHU QUAN TRONG (do bang thuc nghiem 2026-09-26): 'list[i64]'
    # KHONG phai "chi danh nghia" - compiler SUY ra kieu CLR that tu
    # annotation (do lenh 'out = []' trong ham co kieu tra ve 'list[i64]'
    # sinh ra newobj List`1<int64>::.ctor()). Chi khi danh nghia element
    # hoan toan khong xuat hien (vd bien 'xs = []' khong annotation, khong
    # co context) moi sinh List`1<TkvInt>. Do do goi 1 ham extern voi
    # 'list[i64]' VOI 1 bien thuoc loai 'List<TkvInt>' se doc sai offset
    # (test THAT: truyen list do ra lenh co the bao loi - nguoi goi phai
    # truyen 1 bien thuoc co kieu List<int64> that, vi du bien nhan tu 1
    # ham co kieu tra ve 'list[i64]'). Xem R14 ve viec tu chan truong hop
    # do o compile time.
    _elem = _extern_list_elem(dtype)
    if _elem is not None:
        return f'class [mscorlib]System.Collections.Generic.List`1<{_EXTERN_DTYPE_TO_IL[_elem]}>'
    m = _EXTERN_ENUM_DTYPE_RE.match(dtype)
    if m is None:
        raise KeyError(dtype)
    return f"valuetype [{m.group('assembly')}]{m.group('full_name')}"


# P2 (2026-09-23, generic BCL): kieu generic .NET trong 'class' cua
# __tkv_extern_class__ - cu phap 'generic:<Full.Name`Arity>[arg1,arg2]':
# vd 'generic:System.Collections.Generic.List`1[str]'. 'Full' van cam
# injection nhu _EXTERN_CLASS_NAME_RE (them backtick+arity); arg v1 CHI
# scalar/enum/handle (khong generic long/container - bao ro rang).
_GENERIC_CLASS_RE = re.compile(
    r'^generic:(?P<full>[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*`[0-9]+)'
    r'\[(?P<args>.+)\]$')


def _split_generic_args(arg_text):
    """Cat args generic theo dau phay CAP NGOAI (bo qua phay trong '[]'
    long nhau de bao loi ro thay vi cat sai)."""
    parts, depth, cur = [], 0, ''
    for ch in arg_text:
        if ch == '[':
            depth += 1
        elif ch == ']':
            depth -= 1
        if ch == ',' and depth == 0:
            parts.append(cur.strip())
            cur = ''
        else:
            cur += ch
    parts.append(cur.strip())
    return [p for p in parts if p != '']


def _parse_generic_class_ref(class_str, ctx_label):
    """Parse 'generic:...' thanh (full, [args]) - validate SHAPE (regex,
    arity khop so args). Validate NGHIA (arg hop le) la
    _validate_generic_class_ref (can extern_class_defs)."""
    m = _GENERIC_CLASS_RE.match(class_str)
    if m is None:
        raise TranspileError(
            f"{ctx_label}: 'class' {class_str!r} khong dung cu phap generic "
            f"('generic:<Full.Name`Arity>[arg1,arg2]', vd "
            f"'generic:System.Collections.Generic.List`1[str]')")
    full = m.group('full')
    args = _split_generic_args(m.group('args'))
    try:
        arity = int(full.rsplit('`', 1)[1])
    except ValueError:
        raise TranspileError(f"{ctx_label}: arity generic khong hop le trong {full!r}")
    if len(args) != arity:
        raise TranspileError(
            f"{ctx_label}: generic {full!r} can dung {arity} type-args, nhan duoc "
            f"{len(args)} ({args!r})")
    if any(not a for a in args):
        raise TranspileError(f"{ctx_label}: type-arg rong trong {class_str!r}")
    return full, args


def _validate_generic_class_ref(decl, extern_class_defs):
    """Validate NGHIA type-args (scalar/enum/handle da khai) - goi tu
    compile_tkv_cli SAU khi extern_class_defs du (giong validate dtype)."""
    ctx_label = f"__tkv_extern_class__ {decl.get('name')!r}"
    full, args = _parse_generic_class_ref(decl['class'], ctx_label)
    for a in args:
        if a.startswith('generic:') or '[' in a:
            raise TranspileError(
                f"{ctx_label}: type-arg {a!r} long nhau chua ho tro (v1 chi "
                f"scalar/enum/handle don)")
        if not _is_valid_extern_dtype(a) and a not in extern_class_defs:
            if not _validate_extern_class_container_dtype(
                    a, extern_class_defs, f"generic arg cua {ctx_label}"):
                raise TranspileError(
                    f"{ctx_label}: type-arg {a!r} khong hop le (chi scalar/enum "
                    f"hoac 1 handle type da khai trong CUNG pragma)")
    return full, args


def _generic_arg_il(arg, extern_class_defs):
    """IL text cho 1 type-arg (scalar/enum/handle don, da validate)."""
    if arg in extern_class_defs:
        _d = extern_class_defs[arg]
        return f"class [{_d['assembly']}]{_d['class']}"
    return _extern_il_type_text(arg)


def _generic_placeholder_il(want_dtype, decl):
    """IL text cho 1 param/return KHAI 'T' (type-arg) cua generic decl: '!' +
    vi tri (vd Add(str) tren List`1[str] -> 'Add(!0)') - CLR resolve method
    tren instantiation QUA placeholder (viet thang 'string' -> ilasm cho qua
    nhung runtime MissingMethodException, da xac minh that). Tra None neu
    khong phai generic hoac dtype khong phai type-arg (caller dung IL thuong)."""
    if not decl['class'].startswith('generic:'):
        return None
    _full, _args = _parse_generic_class_ref(
        decl['class'], f"__tkv_extern_class__ {decl.get('name')!r}")
    if want_dtype in _args:
        return f'!{_args.index(want_dtype)}'
    return None


def _extern_class_param_il(want_dtype, decl, extern_class_defs=None):
    """IL text param/return cho method/ctor extern-class: placeholder '!N'
    neu la type-arg generic, nguoc lai _il_ctor_param_type nhu cu."""
    _ph = _generic_placeholder_il(want_dtype, decl)
    if _ph is not None:
        return _ph
    return il_codegen._il_ctor_param_type(want_dtype, il_codegen._EXTERN_CLASS_DEFS)


def _extern_class_ref(decl, extern_class_defs=None):
    """Tham chieu kieu IL cho 1 decl (caller tu ghep '::method'/ldtoken -
    KHONG tu them prefix). Non-generic: '[assembly]Full' (hanh vi cu).
    Generic: 'class [assembly]Full<args>' - prefix 'class ' BAT BUOC khi
    co instantiation '<...>' (ilasm khong parse duoc '<' sau tokem
    assembly-qualified tran, da xac minh that), mirror cach e2e_test.il
    goi List`1 (co prefix) - xem il_list_type (angle '<>', khong '[]')."""
    _defs = extern_class_defs if extern_class_defs is not None else il_codegen._EXTERN_CLASS_DEFS
    _cls = decl['class']
    if _cls.startswith('generic:'):
        _full, _args = _parse_generic_class_ref(_cls, f"__tkv_extern_class__ {decl.get('name')!r}")
        _arg_ils = [_generic_arg_il(a, _defs) for a in _args]
        # NGOAC NHON '<>' (khong phai '[]' - '[]' la array, vd 'int32[]') -
        # mirror il_list_type (il_features/list_type.tkv). Prefix 'class '
        # (xem docstring): bat buoc khi co '<...>'.
        return f"class [{decl['assembly']}]{_full}<{','.join(_arg_ils)}>"
    return f"[{decl['assembly']}]{_cls}"


def _tokenvector_facing_dtype(dtype):
    """Phase 9b (bool, 2026-08-24): quy doi 1 dtype KHAI BAO trong pragma
    (co the la 'bool') sang dtype PHIA TOKENVECTOR dung cho type inference
    (register_expr_builtin's return_dtype, TypeAnn cua ket qua method/
    property-getter extern-class). TokenVector KHONG co kieu bool ban dia -
    gia tri LUON la i32 (0/1) o phia goi/nhan. CHI dung ham nay o cac diem
    DANG KY/type-inference; KHONG dung trong cac factory sinh chu ky IL
    thuc su (_make_extern_static_call_codegen va tuong duong o extern-
    class) - noi do PHAI giu nguyen 'bool' de .NET runtime resolve dung
    overload (sai ten kieu la MissingMethodException, xem Critical 2 Phase
    9a). None (vd return_dtype=None cho ham 'void') di qua khong doi.
    Phase 9c (2026-08-26): mo rong cho dtype enum 'enum:...' - cung quy
    doi ve i32, cung ly do het voi bool - TokenVector khong co kieu enum
    rieng, gia tri LUON la i32 phia goi/nhan."""
    if dtype == 'bool':
        return 'i32'
    if dtype == 'u64':
        # Task 3 (RamGuard TokenVector Rewrite, 2026-08-31): mirror 'bool' -
        # TokenVector khong co kieu unsigned rieng, gia tri PHIA TOKENVECTOR
        # LUON la i64 thuong (IL_SCALAR chi co i32/i64/f32/f64). 'u64' o
        # day CHI la nhan cho chu ky IL (_EXTERN_DTYPE_TO_IL), khong phai
        # 1 dtype TokenVector moi.
        return 'i64'
    if dtype == 'ptr':
        # F4a (2026-09-23, __tkv_vtable__/IntPtr): con tro native (IL
        # 'native int', vd IntPtr/HWND/COM interface*) - phia TokenVector
        # LUON la i64 thuong (giong 'u64'/'bool': chi la nhan chu ky IL,
        # khong phai 1 dtype TokenVector moi, KHONG dua vao DTYPES).
        return 'i64'
    if isinstance(dtype, str) and dtype.startswith('enum:'):
        return 'i32'
    if isinstance(dtype, str) and dtype.startswith('array['):
        # Phase 9g (2026-08-27): dtype khai bao la 1 mang .NET that (dung
        # cho chu ky IL that su goi method .NET), nhung PHIA TOKENVECTOR
        # (type inference, bien nhan ket qua, code nguoi dung thao tac)
        # LUON thay day la 1 list[T] binh thuong - gia tri THAT SU tren
        # stack da duoc marshal thanh List<T> ngay sau loi goi (xem
        # il_codegen._marshal_extern_return_array), nen quy doi dtype ve
        # 'list[T]' o day la DUNG voi gia tri thuc te tai thoi diem dtype
        # nay duoc dung cho type inference/khai bao bien.
        #
        # Phase 9i (2026-08-28): DOI thanh DE QUY (truoc day slice PHANG
        # 'list[' + dtype[7:] - SAI voi 'array[array[i32]]' vi con thua 1
        # dau ']' cua lop ngoai chua bi cat, vd cho ket qua sai
        # 'list[array[i32]]]' co 3 dau ']' khong khop 2 dau '['). De quy:
        # 'array[array[i32]]' -> inner='array[i32]' -> de quy tiep ->
        # 'list[i32]' -> boc 1 lop 'list[...]' nua -> 'list[list[i32]]'
        # DUNG. Voi dtype 1 cap cu ('array[i32]'), inner='i32' KHONG bat
        # dau 'array[' nen de quy tra ve 'i32' nguyen ven (khop dieu kien
        # dung 'return dtype' o cuoi ham) - HANH VI CU 100% khong doi.
        inner = dtype[len('array['):-1]
        return 'list[' + _tokenvector_facing_dtype(inner) + ']'
    return dtype


# Phase 9g (2026-08-27): grammar CHUOI GON cho dtype 'array[T]' - CHI 5
# kieu scalar {i32,i64,f32,f64,str} (KHONG 'bool' - xem Global Constraints
# cua plan nay), KHONG dung _parse_type_ann_str (khac han 'list[T]' - do
# la kieu TokenVector THAT, con 'array[T]' CHI ton tai o bien extern, khong
# co gia tri "TypeAnn shape='array'" nao trong he thong kieu TokenVector).
_EXTERN_ARRAY_DTYPE_RE = re.compile(r'^array\[(i32|i64|f32|f64|str)\]$')
# Phase 9i (2026-08-28): grammar cho 'array[array[T]]' - DUNG DUY NHAT 1
# cap long (T van chi 5 scalar, khong ho tro long them 1 cap nua - vd
# 'array[array[array[i32]]]' KHONG khop regex nay, tu dong bi tu choi o
# _validate_extern_class_container_dtype ma khong can code rieng chan).
_EXTERN_NESTED_ARRAY_DTYPE_RE = re.compile(
    r'^array\[array\[(i32|i64|f32|f64|str)\]\]$')


def _validate_extern_class_container_dtype(_dtype, extern_class_defs, ctx_label):
    """Task 1 (extern-class-list, 2026-08-18) + Task 1 (extern-class-dict,
    2026-08-19): validate 1 dtype string KHONG khop _EXTERN_DTYPE_TO_IL/
    extern_class_defs truc tiep - xu ly 2 dang container: 'list[T]' (T =
    scalar hop le HOAC 1 handle type da khai) va 'dict[K,V]' (K = CHI
    scalar - parser tu ep dieu nay san, xem typed_dsl_parser.py dong
    222-233; V = scalar HOAC 1 handle type da khai, giong T cua list).
    Dung parse_type_ann_str (compiler/typed_dsl_parser.py) de parse va
    tai dung logic validate dtype cua no (record_names KHONG truyen vao -
    extern_class field khong tham chieu record). Tu choi container-cua-
    container (list/dict long nhau) bang check elem_ta.shape sau khi
    parse. Raise TranspileError (khong phai SyntaxError) de dong nhat voi
    cac nhanh validate khac trong ham goi - ctx_label la doan mo ta ngu
    canh (vd ten method/'ctor') de gop vao message loi cho de debug.
    Neu _dtype KHONG bat dau bang 'list[' hoac 'dict[' (khong phai
    container ho tro), tra ve False - nguoi goi tu quyet dinh raise loi cu
    (message khac nhau giua 4 diem goi nen khong gop vao day)."""
    if _dtype.startswith('list['):
        try:
            _list_ta = _parse_type_ann_str(_dtype, extern_class_names=set(extern_class_defs))
        except SyntaxError as e:
            raise TranspileError(
                f"__tkv_extern_class__: {ctx_label} dung dtype {_dtype!r} khong hop le - {e}")
        if _list_ta.elem_ta is not None and _list_ta.elem_ta.shape in ('list', 'dict'):
            # Phase 7 (2026-08-19): 'list[list[T]]' (T scalar, DUNG 2 lop)
            # duoc CHO PHEP - truoc day CHAN TUYET DOI moi 'list'/'dict'
            # long nhau. Van CHAN: (a) elem_ta.shape=='dict' (khong lam
            # list[dict[...]] o lan nay), (b) elem_ta.shape=='list' NHUNG
            # LOP TRONG DO LAI long them 1 lop nua (elem_ta.elem_ta is not
            # None - tuc 3 lop tro len), (c) elem_ta.shape=='list' va T
            # (dtype cua lop trong cung) la handle-type (nam trong
            # extern_class_defs) - chi ho tro T scalar trong lan nay.
            #
            # BUG THAT tim thay o phien nay (regression tu ban vet Phase 7
            # dau tien): dieu kien o TREN truoc day la 'elem_ta is not
            # None' KHONG kem 'shape in (list, dict)' - 'list[HandleType]'
            # (vd 'list[Sb]') CUNG co elem_ta != None (parser boc
            # TypeAnn(Sb, 'extern_class') lam elem_ta cho MOI dtype IDENT
            # khong phai scalar thuong, xem typed_dsl_parser.py's parse_type_ann,
            # nhanh 'list'), nen bi lot vao nhanh nay VA bi tu choi NHAM
            # (elem_ta.shape=='extern_class' != 'list' -> is_ok_list_of_list=False)
            # - phat hien qua extern_class_list_parse_test.py's
            # 'list_handle_return_accepted' bi tu choi nham. Them dieu
            # kien 'shape in (list, dict)' o TREN de CHI vao nhanh nay khi
            # THAT SU la container long nhau (list/dict o trong), giu
            # nguyen duong 'list[HandleType]' don gian (elem_ta.shape==
            # 'extern_class') di thang qua 'return True' ben duoi, KHONG
            # dong cham gi (giong het hanh vi TRUOC Phase 7).
            is_ok_list_of_list = (
                _list_ta.elem_ta.shape == 'list'
                and _list_ta.elem_ta.elem_ta is None
                and _list_ta.elem_ta.dtype not in extern_class_defs
            )
            if not is_ok_list_of_list:
                raise TranspileError(
                    f"__tkv_extern_class__: {ctx_label} dung dtype {_dtype!r} - KHONG ho tro "
                    f"container-cua-container dang nay (chi ho tro dung 'list[list[T]]' voi "
                    f"T la dtype vo huong, khong ho tro dict long nhau/3 lop tro len/T la "
                    f"handle-type)")
        return True
    if _dtype.startswith('dict['):
        try:
            _dict_ta = _parse_type_ann_str(_dtype, extern_class_names=set(extern_class_defs))
        except SyntaxError as e:
            raise TranspileError(
                f"__tkv_extern_class__: {ctx_label} dung dtype {_dtype!r} khong hop le - {e}")
        # K (khoa) da bi parser tu ep ve DTYPES (scalar) TRUOC KHI toi
        # day - 1 K khong hop le (vd 1 ten handle type) da lam
        # parse_type_ann_str tu raise SyntaxError o tren roi, KHONG can
        # kiem tra rieng K o day.
        if _dict_ta.elem_ta is not None and _dict_ta.elem_ta.shape in ('list', 'dict'):
            raise TranspileError(
                f"__tkv_extern_class__: {ctx_label} dung dtype {_dtype!r} - KHONG ho tro "
                f"container-cua-container (list/dict long nhau)")
        return True
    if _dtype.startswith('array['):
        if _EXTERN_ARRAY_DTYPE_RE.match(_dtype):
            return True
        # Phase 9i (2026-08-28): 'array[array[T]]' - DUNG 1 cap long, T
        # van chi 5 scalar (KHONG handle-type, KHONG bool/enum, KHONG long
        # them 1 cap nua - regex da tu gioi han dieu do, xem dinh nghia
        # _EXTERN_NESTED_ARRAY_DTYPE_RE). Check TRUOC nhanh handle-type
        # ben duoi - neu khong, '_elem' se la 'array[i32]' (khong nam
        # trong extern_class_defs) va bi rot xuong raise nham.
        if _EXTERN_NESTED_ARRAY_DTYPE_RE.match(_dtype):
            return True
        # Phase 9j (2026-08-28): 'array[array[Widget]]' - T (phan tu
        # TRONG) la 1 handle-type DA khai (khong phai 5 scalar) - mo rong
        # Phase 9i giong het cach Phase 9h mo rong array[T] 1 cap. KHONG
        # sua nested_array_extern.py (codegen da tong quat theo inner_elem
        # tu Phase 9i, xem dieu tra plan nay) - CHI can cho qua validate.
        if _dtype.startswith('array[array[') and _dtype.endswith(']]'):
            _inner = _dtype[len('array[array['):-2]
            if _inner in extern_class_defs:
                return True
        # Phase 9h (2026-08-27): 'array[T]' voi T la 1 handle-type DA khai
        # (nam trong extern_class_defs) - mo rong ngoai 5 scalar Phase 9g,
        # dung idiom marshal GIONG HET (ToArray()/List<T>::.ctor(IEnumerable<T>)),
        # chi khac IL text phan tu (xem _il_array_elem_type, il_codegen.py).
        _elem = _dtype[len('array['):-1]
        if _elem in extern_class_defs:
            return True
        raise TranspileError(
            f"__tkv_extern_class__: {ctx_label} dung dtype {_dtype!r} khong hop le - "
            f"'array[T]' chi ho tro T la 1 trong {{'i32','i64','f32','f64','str'}}, "
            f"'array[array[T]]' (T cung tap do, DUNG 1 cap long), 1 handle-type DA khai "
            f"qua __tkv_extern_class__ trong file nay, hoac 'array[array[HandleType]]' "
            f"(HandleType DA khai, DUNG 1 cap long) (khong ho tro "
            f"bool/enum/handle-type CHUA khai/mang 2 chieu vuong T[,]/long qua 1 cap)")
    return False

# Regex ten class .NET hop le (vd 'System.Math', 'MyLib.Foo_Bar') va ten
# method don gian (khong dau cham, vd 'Pow') - dung de validate buoc 2/3
# cua _validate_and_register_extern_method (KHONG phai validate day du CLI
# ten .NET, chi chan cac gia tri ro rang sai/injection vao chuoi IL).
_EXTERN_CLASS_NAME_RE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$')
_EXTERN_METHOD_NAME_RE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*$')
# Regex ten assembly .NET hop le (vd 'System.Math', 'MyLib.Foo_Bar') - dung de
# validate buoc (1) cua _validate_and_register_extern_method (fix review
# finding M2: 'assembly' truoc day chi check membership, khong check FORMAT -
# cung dang regex voi _EXTERN_CLASS_NAME_RE vi ten assembly .NET cung theo
# quy tac chu/so/gach duoi/dau cham).
_EXTERN_ASSEMBLY_NAME_RE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$')

# 3 assembly .NET GAC mac dinh LUON co san (khong can nguoi dung khai bao qua
# __tkv_extern_assembly__) - hang so module-level DUY NHAT, dung CHUNG boi ca
# declared_assembly_names (validate __tkv_extern_method__) LAN seen_extern
# (dedupe '.assembly extern' phat sinh) trong compile_tkv_cli (fix review
# finding M4: truoc day 2 noi tu viet lai literal set nay, de lech neu sua 1
# cho ma quen cho kia).
_DEFAULT_GAC_ASSEMBLIES = frozenset({'mscorlib', 'System', 'System.Core'})

# R3 (2026-09-22): full assembly identity cho extern_method/extern_class
# (mo managed DLL rieng - C# shim OpenH264/AccessKit).
_FULL_IDENTITY_VERSION_RE = re.compile(r'^\d+(\.\d+){0,3}$')
_FULL_IDENTITY_TOKEN_RE = re.compile(r'^[0-9a-fA-F]+$')


def _parse_full_assembly_identity(assembly_str, ctx_label):
    """'OpenH264Shim, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null'
    -> (simple_name, pubkeytoken, version) theo quy uoc tuple cua
    __tkv_extern_assembly__ (ten, token_hex_or_None, version_or_None).
    Ten don ('System.Xml') -> (ten, None, None) - goi TI THI (khong tu
    dang ky, van phai khai bao/khac nhu cu). Culture duoc chap nhan va
    bo qua (CLR bind khong can). PublicKeyToken=null/None (khong phan
    biet hoa) -> None (khong ky ten manh). Token hex lien ('b77a...') duoc
    chuyen sang dang byte-cach-nhau ('B7 7A ...') ma '.assembly extern'
    doi hoi; dang da-cach-san giu nguyen."""
    parts = [p.strip() for p in assembly_str.split(',')]
    simple_name = parts[0]
    if not _EXTERN_ASSEMBLY_NAME_RE.match(simple_name):
        raise TranspileError(
            f"{ctx_label}: ten assembly {simple_name!r} (trich tu {assembly_str!r}) khong phai ten "
            f"assembly .NET hop le")
    version = None
    token = None
    for part in parts[1:]:
        if '=' not in part:
            raise TranspileError(
                f"{ctx_label}: phan {part!r} trong identity {assembly_str!r} phai dang 'Key=Value' "
                f"(vd 'Version=1.0.0.0', 'Culture=neutral', 'PublicKeyToken=null')")
        key, _, value = (s.strip() for s in part.partition('='))
        lk = key.lower()
        if lk == 'version':
            if not _FULL_IDENTITY_VERSION_RE.match(value):
                raise TranspileError(
                    f"{ctx_label}: Version={value!r} khong hop le (can 'major[.minor[.build[.revision]]]' so)")
            version = value
        elif lk == 'publickeytoken':
            if value.lower() in ('null', 'none'):
                token = None
            else:
                compact = value.replace(' ', '')
                if not _FULL_IDENTITY_TOKEN_RE.match(compact) or len(compact) % 2 != 0:
                    raise TranspileError(
                        f"{ctx_label}: PublicKeyToken={value!r} khong hop le (can chuoi hex chan do dai hoac 'null')")
                token = ' '.join(compact[i:i + 2].upper() for i in range(0, len(compact), 2))
        elif lk == 'culture':
            continue  # CLR bind khong can culture cho .assembly extern
        else:
            raise TranspileError(
                f"{ctx_label}: khoa {key!r} khong ho tro trong assembly identity "
                f"(chi 'Version'/'Culture'/'PublicKeyToken')")
    return simple_name, token, version


def _ensure_extern_assembly(assembly_str, extern_assemblies, declared_assembly_names, ctx_label):
    """Dung chung cho __tkv_extern_method__ VA __tkv_extern_class__ (R3).
    Tra ve TEN DON dung cho '[asm]' refs. Ten don cu: doi chieu nhu cu
    (khong tu dang ky). Full identity (co dau ','): tu them
    (ten, token, version) vao extern_assemblies (de vong phat '.assembly
    extern' phia sau sinh dung identity) + declared_assembly_names neu
    ten chua co; neu ten DA co thi doi chieu token/version khop (lech ->
    TranspileError ON AO thay vi FileLoadException luc chay)."""
    if ',' not in assembly_str:
        return assembly_str
    simple_name, token, version = _parse_full_assembly_identity(assembly_str, ctx_label)
    for asm_name, pkt, ver in extern_assemblies:
        if asm_name == simple_name:
            # 'DEFAULT' == token+version chuan .NET Framework GAC (xem vong
            # phat '.assembly extern' trong compile_tkv_cli).
            norm_pkt = 'B7 7A 5C 56 19 34 E0 89' if pkt == 'DEFAULT' else pkt
            norm_ver = '4.0.0.0' if ver == 'DEFAULT' else ver
            if norm_pkt != token or norm_ver != version:
                raise TranspileError(
                    f"{ctx_label}: identity {assembly_str!r} mau thuan voi khai bao "
                    f"__tkv_extern_assembly__ truoc do cua '{simple_name}' "
                    f"(token={norm_pkt!r}, version={norm_ver!r})")
            declared_assembly_names.add(simple_name)
            return simple_name
    extern_assemblies.append((simple_name, token, version))
    declared_assembly_names.add(simple_name)
    return simple_name


def _make_extern_static_call_codegen(assembly, dotnet_class, method_name,
                                      param_dtypes, return_dtype):
    """Factory tra ve codegen_fn dung chu ky EXPR_BUILTIN_CODEGEN hien co
    (fn(args, scope, out, dtype, ctx), doi chieu
    il_features/stdlib_math.py::_make_math_func_compiler) - goi 1 static
    method .NET NGOAI qua 'call'. KHAC _make_math_func_compiler: MOI tham
    so ep theo dung dtype khai bao RIENG vi tri cua no (params_dtypes[i]),
    khong ep dong loat 1 dtype - vd System.Math::Pow(f64,f64) nhung 1 ham
    khac co the la (i32,f64). Tinh truoc il_param_types/il_ret_type/
    call_prefix NGOAI closure (chi tinh 1 lan luc dang ky, khong tinh lai
    moi lan goi bieu thuc)."""
    il_param_types = [_extern_il_type_text(d) for d in param_dtypes]
    il_ret_type = 'void' if return_dtype is None else _extern_il_type_text(return_dtype)
    call_prefix = f'    call {il_ret_type} [{assembly}]{dotnet_class}::{method_name}'

    def _codegen(args, scope, out, dtype, ctx):
        if len(args) != len(param_dtypes):
            raise SyntaxError(
                f"il_codegen: '{method_name}' (extern [{assembly}]{dotnet_class}) can dung "
                f"{len(param_dtypes)} tham so, duoc goi voi {len(args)}")
        for arg_node, want_dtype in zip(args, param_dtypes):
            # Phase 9b fix-of-fix (bool, 2026-08-25): il_param_types (tren) da
            # tinh SAN tu want_dtype THO (giu 'bool' cho chu ky IL) - o day
            # dtype truyen vao compile_expr phai la dtype PHIA TOKENVECTOR
            # (i32 thay bool), khong dung want_dtype tho truc tiep.
            # Critical 2 (final review Phase 9d Part B): 'object'/'type' bi
            # tu choi TRUOC diem nay o dang ky (_validate_and_register_
            # extern_method) - nen tai day want_dtype KHONG BAO GIO la
            # 'object'/'type' (chi con lai de code tu-tai-lieu-hoa/phong thu
            # neu validate thay doi trong tuong lai, _compile_extern_object_arg
            # van AN TOAN goi duoc voi moi dtype khac).
            # F4a: 'ptr' (con tro native) - phia TokenVector la i64, can
            # 'conv.i' de thanh 'native int' dung chu ky call.
            il_codegen._compile_extern_object_arg(arg_node, scope, out, want_dtype, ctx)
            if want_dtype == 'ptr':
                out.append('    conv.i')
        out.append(f'{call_prefix}({", ".join(il_param_types)})')
        # F4a: return 'ptr' - stack dang la 'native int', can 'conv.i8'
        # thanh i64 phia TokenVector (dispatch chung sau do widen no-op
        # an toan vi stack THAT SU la int64).
        if return_dtype == 'ptr':
            out.append('    conv.i8')
        # Khong can widen thu cong o day (khac compile_pow/...): builtin nay
        # dang ky voi return_dtype != None (xem _validate_and_register_
        # extern_method), nen dispatch chung _expr_call (il_codegen.py) TU
        # goi widen_if_needed(return_dtype, dtype, out) sau khi ham nay tra
        # ve - xem chu thich o register_expr_builtin('pow', ...) giai thich
        # vi sao widen 2 lan la BUG.
    return _codegen


# Task 4 (extern-class, 2026-08-18): instance method (callvirt) codegen.
#
# PHAT HIEN QUAN TRONG lech voi brief goc: brief gia dinh khoa dang ky
# trong EXPR_METHOD_CODEGEN la (ten_class, method_name) (vd ('Sb',
# 'ToString')) - giong het cach __tkv_extern_method__ dang ky builtin THEO
# TEN HAM. Doc THAT compile_method_call (compiler/il_features/
# record_feature.py dong 231-232):
#     _, _, obj_ta = scope[obj_name]
#     registered = EXPR_METHOD_CODEGEN.get((obj_ta.shape or obj_ta.dtype, method_name))
# obj_ta.shape cua MOI bien extern-class deu la CHUOI HANG 'extern_class'
# (Task 2, typed_dsl_parser.py dong 305) - KHONG PHAI ten class rieng cua
# no. Vi 'shape' uu tien truoc 'or dtype', khoa THAT SU la
# ('extern_class', method_name): DUY NHAT 1 khoa cho MOI extern-class cung
# khai 1 ten method (vd ca 'Sb' lan 1 handle-type khac deu co 'ToString'
# se CUNG tra cuu 1 khoa). Vi vay KHONG THE dong cung assembly/class/
# param_dtypes/return_dtype vao closure luc dang ky (khac han
# _make_extern_static_call_codegen o tren) - closure phai tu phan giai
# class THUC cua bien nhan (obj_ta.dtype, vd 'Sb') O MOI LAN GOI, qua
# il_codegen._EXTERN_CLASS_DEFS (bien module-level, xem Task 2/3). 2 he
# qua thiet ke:
#   1) Dang ky idempotent theo method_name (khong theo (class, method)):
#      2 extern-class KHAC nhau cung khai 1 ten method la BINH THUONG (vd
#      C# thuc te nhieu class deu co ToString()) - lan dang ky thu 2 tro
#      di CHI BO QUA (closure dau tien da tu phan giai dung cho MOI bien),
#      khong raise ValueError nhu brief gia dinh (brief's dup-check dua
#      tren khoa SAI nen se raise oan cho truong hop hop le nay).
#   2) object nhan CHUA duoc load san len stack luc registered(...) duoc
#      goi (compile_method_call goi THANG voi node con nguyen TEN BIEN o
#      node[1], KHONG phai gia tri da o tren stack) - closure phai tu goi
#      ctx['load_var_ref'](obj_name, scope, out) truoc, khac ban nhap cua
#      brief (bien nhan dau tien duoc coi la "da san tren stack").
def _extern_class_method_lookup(class_name, method_name):
    """Tra (decl, method_def) cho 1 (ten-class-handle-type-THUC, ten-method)
    - tra cuu DONG qua il_codegen._EXTERN_CLASS_DEFS (dang active trong
    pham vi 1 lan compile_tkv_cli, xem ghi chu tren)."""
    decl = il_codegen._EXTERN_CLASS_DEFS.get(class_name)
    if decl is None:
        raise SyntaxError(
            f"il_codegen: extern-class '{class_name}' khong ton tai trong pham vi bien dich nay")
    for m in decl['methods']:
        if m['name'] == method_name:
            return decl, m
    # Task 2 (extern-class-property, 2026-08-18): 'get_X' KHONG nam that
    # trong decl['methods'] (chi 'properties') - tong hop 1 method-dict GIA
    # tai cho ('name': 'get_X', 'params': [], 'returns': prop['dtype']) de
    # tai dung TOAN BO pipeline _make_extern_class_method_codegen/
    # _make_extern_class_method_return_ta san co (Option (a) - sua CHINH ham
    # tra cuu nay, khong dong method-dict gia vao decl['methods'] that vi se
    # anh huong validate dup-check o duoi qua _seen_method_names).
    if method_name.startswith('get_'):
        prop_name = method_name[len('get_'):]
        for p in decl.get('properties') or []:
            if p['name'] == prop_name:
                return decl, {'name': method_name, 'params': [], 'returns': p['dtype']}
    # Task 3 (extern-class-property, 2026-08-18): tuong tu 'get_X' o tren -
    # 'set_X' cung KHONG nam that trong decl['methods'], tong hop 1
    # method-dict gia voi 1 tham so (kieu cua property) va 'returns':
    # 'void'. LUU Y: khong dung method-dict nay qua
    # _make_extern_class_method_codegen (no goi _il_ctor_param_type(m['returns'], ...)
    # se KeyError vi IL_SCALAR khong co khoa 'void', roi goi widen_if_needed
    # vo dieu kien nhu the co gia tri tren stack - SAI cho 1 lenh void) - phai
    # dung _make_extern_class_property_setter_codegen rieng (xem duoi).
    if method_name.startswith('set_'):
        prop_name = method_name[len('set_'):]
        for p in decl.get('properties') or []:
            if p['name'] == prop_name:
                return decl, {'name': method_name, 'params': [p['dtype']], 'returns': 'void'}
    raise SyntaxError(
        f"il_codegen: extern-class '{class_name}' khong co method '{method_name}'")


def _make_extern_class_method_return_ta(method_name):
    """Factory tra 1 ham 1-tham-so fn(obj_ta) -> TypeAnn dung dung chu ky
    return_ta_fn cua register_expr_method (xac nhan qua _infer_dtype/
    _get_container_ta trong il_codegen.py: goi 'resolver(obj_ta)' 1 tham
    so DUY NHAT) - TypeAnn tra ve PHU THUOC ca obj_ta.dtype (ten class
    THUC cua bien nhan) lan method_name (dong bo boc ngoai), khong phai 1
    hang so tinh (2 extern-class khac nhau cung ten method co the tra kieu
    KHAC nhau)."""
    def _return_ta(obj_ta):
        _decl, m = _extern_class_method_lookup(obj_ta.dtype, method_name)
        ret = m['returns']
        if ret in il_codegen._EXTERN_CLASS_DEFS:
            return TypeAnn(ret, 'extern_class')
        # Phase 9g (2026-08-27): quy doi 'array[T]' -> 'list[T]' TRUOC khi
        # check startswith, de dtype nay CUNG di qua nhanh _parse_type_ann_str
        # ben duoi (TypeAnn shape='list' dung) thay vi roi xuong nhanh cuoi
        # (TypeAnn(dtype='list[str]', shape=None) SAI - gay KeyError khi
        # dung bien do sau nay, giong bug da ghi nhan o Task 2 extern-class-list).
        # Identity voi 'list[T]'/'dict[K,V]' that (khong doi hanh vi cu).
        ret = _tokenvector_facing_dtype(ret)
        if ret.startswith('list[') or ret.startswith('dict['):
            # Task 2 (extern-class-list, 2026-08-18) + Task 2 (extern-
            # class-dict, 2026-08-19): method/property-getter tra ve
            # 'list[T]'/'dict[K,V]' PHAI duoc khai bao voi shape='list'/
            # 'dict' dung (qua _parse_type_ann_str, da qua validate o
            # Task 1's _validate_extern_class_container_dtype) - truoc day
            # roi ve nhanh 'return TypeAnn(ret, None)' o duoi, tao ra
            # TypeAnn co dtype=CA CHUOI ('dict[str,i32]') va shape=None ->
            # il_type_str/_local_il_type sau do tra cuu
            # IL_SCALAR['dict[str,i32]'] va nem KeyError khi khai bao
            # local nhan ket qua method/property nay.
            return _parse_type_ann_str(ret, extern_class_names=set(il_codegen._EXTERN_CLASS_DEFS))
        # Phase 9b (bool): 'ret' o day la dtype PHIA IL-signature (co the la
        # 'bool'), nhung TypeAnn tra ve day la dtype PHIA TOKENVECTOR (dung
        # cho type inference cua bien nhan ket qua) - TokenVector KHONG co
        # kieu bool rieng, phai quy doi 'bool' -> 'i32' O DAY, KHONG dung
        # 'ret' tho. Cac dtype con lai (i32/i64/f32/f64/str) giu nguyen.
        return TypeAnn(_tokenvector_facing_dtype(ret), None)
    return _return_ta


def _make_extern_class_method_codegen(method_name):
    """Factory tra codegen_fn dung CHUNG cho MOI extern-class khai method
    trung ten 'method_name' (xem ghi chu khoi tren ve ly do khong the dong
    cung assembly/class/param_dtypes nhu _make_extern_static_call_codegen).
    Chu ky closure: fn(node, scope, out, dtype, ctx) - dung CHU KY THAT cua
    EXPR_METHOD_CODEGEN (xac nhan qua compile_method_call, KHONG phai ban
    nhap fn(obj_name, args, scope, out, dtype, ctx) cua brief)."""
    def _codegen(node, scope, out, dtype, ctx):
        obj_name, _mname, args = node[1], node[2], node[3]
        _, _, obj_ta = scope[obj_name]
        decl, m = _extern_class_method_lookup(obj_ta.dtype, method_name)
        param_dtypes = m['params']
        if len(args) != len(param_dtypes):
            raise SyntaxError(
                f"il_codegen: method {method_name!r} tren {decl['class']!r} ky vong "
                f"{len(param_dtypes)} tham so, nhan duoc {len(args)}")
        ctx['load_var_ref'](obj_name, scope, out)
        il_params = []
        for arg_node, want_dtype in zip(args, param_dtypes):
            il_params.append(_extern_class_param_il(want_dtype, decl))
            # Phase 9b fix-of-fix (bool, 2026-08-25): il_params (chu ky IL)
            # giu want_dtype THO ('bool'); dtype truyen vao compile_expr phai
            # la dtype PHIA TOKENVECTOR - xem _tokenvector_facing_dtype.
            # Critical 1 + Important 1 (final review Phase 9d Part B): box
            # gia tri value-type khi want_dtype=='object' + tu choi dtype
            # thuc te khac 'type' khi want_dtype=='type'.
            il_codegen._compile_extern_object_arg(arg_node, scope, out, want_dtype, ctx)
        il_ret_type = _extern_class_param_il(m['returns'], decl)
        call_target = _extern_class_ref(decl)
        out.append(
            f"    callvirt instance {il_ret_type} {call_target}::{method_name}"
            f"({', '.join(il_params)})")
        il_codegen._marshal_extern_return_array(m['returns'], out, ctx)
        # widen_if_needed la no-op an toan khi actual_dtype la 1 ten class
        # handle-type (khong khop int/float set nao ca, xem _widen_if_needed
        # trong il_codegen.py dong 1044) - goi VO DIEU KIEN, khong can if
        # rieng cho truong hop tra ve scalar vs handle-type. 'actual' dtype
        # truyen vao PHAI la dtype PHIA TOKENVECTOR (Critical 1b, final
        # review Phase 9b) - m['returns'] tho co the la 'bool', nhung gia
        # tri THAT SU tren stack luc nay da la i32 (0/1, tu callvirt tra ve
        # kieu IL 'bool' - bit-for-bit tuong thich i32 tren stack, xem chu
        # thich _EXTERN_DTYPE_TO_IL o tren) nen widen phai so sanh tu i32,
        # khong phai tu chuoi 'bool' (widen_if_needed khong nhan dien 'bool'
        # la 1 dtype so - se bo qua sai 1 truong hop can widen i32->f32/f64).
        ctx['widen_if_needed'](_tokenvector_facing_dtype(m['returns']), dtype, out)
    return _codegen


def _make_extern_class_property_setter_codegen(method_name):
    """Task 3 (extern-class-property, 2026-08-18): factory RIENG cho
    'set_X' - KHONG the tai dung _make_extern_class_method_codegen o tren
    vi 2 ly do: (1) m['returns']=='void' se lam
    il_codegen._il_ctor_param_type('void', ...) nem KeyError (IL_SCALAR
    khong co khoa 'void' - xem il_core.py), (2) callvirt tra ve void
    KHONG day gia tri nao len stack, nen goi widen_if_needed(...) VO DIEU
    KIEN nhu _make_extern_class_method_codegen lam se sai (widen tuong
    tren dinh stack 1 gia tri KHONG TON TAI). Chu ky closure GIONG HET
    _make_extern_class_method_codegen: fn(node, scope, out, dtype, ctx),
    node = ('method_call', obj_name, method_name, args) (fake_node dung
    boi codegen_attr_assign trong record_feature.py)."""
    def _codegen(node, scope, out, dtype, ctx):
        obj_name, _mname, args = node[1], node[2], node[3]
        _, _, obj_ta = scope[obj_name]
        decl, m = _extern_class_method_lookup(obj_ta.dtype, method_name)
        param_dtypes = m['params']
        if len(args) != len(param_dtypes):
            raise SyntaxError(
                f"il_codegen: setter {method_name!r} tren {decl['class']!r} ky vong "
                f"{len(param_dtypes)} tham so, nhan duoc {len(args)}")
        ctx['load_var_ref'](obj_name, scope, out)
        il_params = []
        for arg_node, want_dtype in zip(args, param_dtypes):
            il_params.append(_extern_class_param_il(want_dtype, decl))
            # Phase 9b fix-of-fix (bool, 2026-08-25): xem chu thich tuong tu
            # o _make_extern_class_method_codegen - il_params giu want_dtype
            # THO, compile_expr nhan dtype PHIA TOKENVECTOR.
            # Critical 1 + Important 1 (final review Phase 9d Part B): box
            # gia tri value-type khi want_dtype=='object' + tu choi dtype
            # thuc te khac 'type' khi want_dtype=='type'.
            il_codegen._compile_extern_object_arg(arg_node, scope, out, want_dtype, ctx)
        call_target = _extern_class_ref(decl)
        out.append(
            f"    callvirt instance void {call_target}::{method_name}"
            f"({', '.join(il_params)})")
        # KHONG goi widen_if_needed: setter la void, khong co gia tri
        # tren stack de widen.
    return _codegen


def _make_extern_class_method_void_codegen(method_name):
    """Phase 9a (2026-08-24): factory RIENG cho method instance
    'returns':'void' - mirror HET _make_extern_class_property_setter_codegen
    (2 ly do giong het: (1) _il_ctor_param_type('void',...) se KeyError,
    (2) callvirt void khong day gia tri len stack nen KHONG duoc goi
    widen_if_needed). Khac setter O CHO: khong gioi han 1 tham so - dung
    param_dtypes THAT cua method (co the 0..N tham so), va TEN method
    trong IL la method_name that (khong phai 'set_X')."""
    def _codegen(node, scope, out, dtype, ctx):
        obj_name, _mname, args = node[1], node[2], node[3]
        _, _, obj_ta = scope[obj_name]
        decl, m = _extern_class_method_lookup(obj_ta.dtype, method_name)
        param_dtypes = m['params']
        if len(args) != len(param_dtypes):
            raise SyntaxError(
                f"il_codegen: method {method_name!r} tren {decl['class']!r} ky vong "
                f"{len(param_dtypes)} tham so, nhan duoc {len(args)}")
        ctx['load_var_ref'](obj_name, scope, out)
        il_params = []
        for arg_node, want_dtype in zip(args, param_dtypes):
            il_params.append(_extern_class_param_il(want_dtype, decl))
            # Phase 9b fix-of-fix (bool, 2026-08-25): xem chu thich tuong tu
            # o _make_extern_class_method_codegen - il_params giu want_dtype
            # THO, compile_expr nhan dtype PHIA TOKENVECTOR.
            # Critical 1 + Important 1 (final review Phase 9d Part B): box
            # gia tri value-type khi want_dtype=='object' + tu choi dtype
            # thuc te khac 'type' khi want_dtype=='type'.
            il_codegen._compile_extern_object_arg(arg_node, scope, out, want_dtype, ctx)
        call_target = _extern_class_ref(decl)
        out.append(
            f"    callvirt instance void {call_target}::{method_name}"
            f"({', '.join(il_params)})")
        # Khong widen: method void khong co gia tri tren stack.
    return _codegen


def _compile_extern_static_class_method_call(node, scope, out, dtype, ctx,
                                              class_name, method_name, args):
    """Codegen 'ClassName.Method(args)' - static method tren 1 class DA duoc
    khai __tkv_extern_class__ (Phase 9d Part A, Task 3). Goi TU
    compile_method_call (compiler/il_features/record_feature.py) khi
    obj_name KHONG nam trong scope (tuc KHONG phai 1 bien) NHUNG co trong
    il_codegen._EXTERN_CLASS_DEFS (tuc la 1 ten class da khai). KHAC
    _make_extern_class_method_codegen (khong load receiver qua
    ctx['load_var_ref'], dung 'call' thay vi 'callvirt' - static method
    khong co 'this'). KHAC _make_extern_static_call_codegen (builtin
    __tkv_extern_method__): KHONG dang ky qua EXPR_BUILTIN_CODEGEN/
    EXPR_METHOD_CODEGEN toan cuc theo TEN method don thuan (se dung do ten
    khi 2 class KHAC nhau cung khai 1 static method trung ten, vd ca
    Widget.Describe() lan Gadget.Describe()) - tra cuu THANG qua
    il_codegen._EXTERN_CLASS_DEFS[class_name]['static_methods'], vi
    class_name da namespace san O CHINH node AST (obj_name), khong co nguy
    co dung do. Mirror phan xu ly widen/void tu _make_extern_class_method_
    codegen/_make_extern_class_method_void_codegen (xem 2 ham do o tren) -
    m['returns'] == 'void' PHAI di duong rieng giong het ly do da giai
    thich o _make_extern_class_method_void_codegen's docstring
    (_il_ctor_param_type('void', ...) se KeyError, va 'call void ...' khong
    day gia tri len stack nen KHONG duoc goi widen_if_needed)."""
    decl = il_codegen._EXTERN_CLASS_DEFS[class_name]
    m = next((mm for mm in decl.get('static_methods', [])
              if mm['name'] == method_name), None)
    if m is None:
        raise SyntaxError(
            f"il_codegen: extern-class '{class_name}' khong co static "
            f"method '{method_name}'")
    param_dtypes = m['params']
    if len(args) != len(param_dtypes):
        raise SyntaxError(
            f"il_codegen: static method {method_name!r} tren {class_name!r} "
            f"ky vong {len(param_dtypes)} tham so, nhan duoc {len(args)}")
    call_target = _extern_class_ref(decl)
    il_params = []
    for arg_node, want_dtype in zip(args, param_dtypes):
        il_params.append(_extern_class_param_il(want_dtype, decl))
        # Phase 9b fix-of-fix (bool, 2026-08-25) convention: il_params (chu
        # ky IL) giu want_dtype THO ('bool'); dtype truyen vao compile_expr
        # phai la dtype PHIA TOKENVECTOR - xem _tokenvector_facing_dtype.
        # Critical 1 + Important 1 (final review Phase 9d Part B, them boi
        # fix nay - khong nam trong 5 diem goi liet ke trong finding goc,
        # nhung la 1 diem goi THAT SU khac cua cung param_dtypes co the
        # chua 'object'/'type' [static method khai trong __tkv_extern_class__,
        # goi qua cu phap ClassName.Method()] - ap dung CUNG fix de nhat
        # quan, tranh bo sot 1 duong dan bi crash tuong tu):
        # box gia tri value-type khi want_dtype=='object' + tu choi dtype
        # thuc te khac 'type' khi want_dtype=='type'.
        il_codegen._compile_extern_object_arg(arg_node, scope, out, want_dtype, ctx)
    if m['returns'] == 'void':
        out.append(
            f"    call void {call_target}::{method_name}"
            f"({', '.join(il_params)})")
        # Khong widen: method void khong co gia tri tren stack.
        return
    il_ret_type = _extern_class_param_il(m['returns'], decl)
    out.append(
        f"    call {il_ret_type} {call_target}::{method_name}"
        f"({', '.join(il_params)})")
    il_codegen._marshal_extern_return_array(m['returns'], out, ctx)
    ctx['widen_if_needed'](_tokenvector_facing_dtype(m['returns']), dtype, out)


# Task 3 (2026-08-17, __tkv_extern_pinvoke__): whitelist calling convention
# ho tro cho pinvokeimpl - chi 2 gia tri pho bien nhat tren Windows (spec
# KHONG yeu cau ho tro 'thiscall'/'fastcall').
_EXTERN_CONVENTIONS = {'cdecl', 'stdcall'}

# Fix Critical (2026-08-17, review Task 3 __tkv_extern_pinvoke__): tap ten
# builtin THAT SU la void - dang ky qua register_expr_builtin voi
# return_dtype=None CO CHU DICH vi ham khong tra gia tri gi (hien tai: extern
# pinvoke voi returns='void'). KHAC voi ~27 builtin co san (pow/sorted/
# random/sum/min/max/...) CUNG dang ky return_dtype=None trong
# EXPR_BUILTIN_DTYPE nhung vi ly do "khong suy duoc dtype tinh TU CHINH NO"
# (dtype phu thuoc ngu canh/tham so goi) - hai truong hop CUNG gia tri None
# nhung Y NGHIA KHAC NHAU, KHONG the phan biet qua EXPR_BUILTIN_DTYPE don
# thuan (xem review finding CRITICAL: heuristic "return_dtype is None => void"
# sai, gay regression that cho cac builtin co san khi goi DANG LENH DOC LAP).
# _validate_and_register_extern_pinvoke TU THEM vao tap nay khi dang ky
# (returns == 'void'), va tu don trong finally cua compile_tkv_cli giong
# EXPR_BUILTIN_CODEGEN/EXPR_BUILTIN_DTYPE de tranh ro ri process-global.
EXTERN_VOID_BUILTIN_NAMES = set()


def _make_extern_pinvoke_call_codegen(hidden_name, param_dtypes, return_dtype):
    """Task 3 (2026-08-17, __tkv_extern_pinvoke__): factory TUONG TU
    _make_extern_static_call_codegen o tren, nhung goi 1 hidden method
    pinvokeimpl BEN TRONG CHINH class chuong trinh hien tai (khong phai
    [assembly]class ben ngoai) - dung _class_name(ctx) giong cach
    stdlib_cjson.py lam (doc ctx['class_name'], fallback 'Program').
    return_dtype co the la None (ham 'void' - Phase 2 CHO PHEP, khac
    Phase 1). R1 (2026-09-22): tham so struct 'Name*' truyen DIA CHI cua
    1 bien struct (ldloca) - doi so PHAI la ten bien don kieu struct."""
    il_param_types = [_pinvoke_param_il(d) for d in param_dtypes]
    il_ret_type = 'void' if return_dtype is None else _pinvoke_param_il(return_dtype)

    def _class_name(ctx):
        return (ctx or {}).get('class_name') or 'Program'

    def _codegen(args, scope, out, dtype, ctx):
        if len(args) != len(param_dtypes):
            raise SyntaxError(
                f"il_codegen: '{hidden_name}' (extern pinvoke) can dung "
                f"{len(param_dtypes)} tham so, duoc goi voi {len(args)}")
        compile_expr = ctx['compile_expr']
        for arg_node, want_dtype in zip(args, param_dtypes):
            _pm = _STRUCT_PTR_RE.match(want_dtype) if isinstance(want_dtype, str) else None
            if _pm is not None:
                # Dia chi cua bien struct (managed pointer 'valuetype&').
                if not (isinstance(arg_node, tuple) and arg_node[0] == 'var'):
                    raise SyntaxError(
                        f"il_codegen: tham so struct '{want_dtype}' can 1 ten bien struct don "
                        f"(vd 'cur_pos(p)' - khong truyen truc tiep 'new_Point(...)' hay bieu thuc)")
                try:
                    _, _, _ta = scope[arg_node[1]]
                except (KeyError, SyntaxError):
                    raise SyntaxError(
                        f"il_codegen: '{arg_node[1]}' khong phai bien struct da khai bao")
                if _ta.shape != 'struct' or _ta.dtype != _pm.group(1):
                    raise SyntaxError(
                        f"il_codegen: tham so struct '{want_dtype}' can bien kieu struct "
                        f"'{_pm.group(1)}', gap '{arg_node[1]}' kieu {_ta.dtype!r}/shape {_ta.shape!r}")
                ctx['load_var_addr'](arg_node[1], scope, out)
                continue
            # Phase 9b fix-of-fix (bool, 2026-08-25): il_param_types (tren) da
            # tinh SAN tu want_dtype THO (giu 'bool' cho chu ky IL) - o day
            # dtype truyen vao compile_expr phai la dtype PHIA TOKENVECTOR.
            # F4a: 'ptr' (con tro native) - phia TokenVector la i64, can
            # 'conv.i' de thanh 'native int' dung chu ky pinvoke.
            compile_expr(arg_node, scope, out, _tokenvector_facing_dtype(want_dtype), ctx)
            if want_dtype == 'ptr':
                out.append('    conv.i')
        out.append(f'    call {il_ret_type} {_class_name(ctx)}::{hidden_name}'
                    f'({", ".join(il_param_types)})')
        # F4a: return 'ptr' - stack dang la 'native int', can 'conv.i8'
        # thanh i64 phia TokenVector (dispatch chung sau do widen no-op
        # an toan vi stack THAT SU la int64).
        if return_dtype == 'ptr':
            out.append('    conv.i8')
        # Khong widen thu cong o day - giong _make_extern_static_call_codegen,
        # dispatch chung (_expr_call/codegen_call_stmt) tu lo widen qua
        # return_dtype dang ky voi register_expr_builtin.
    return _codegen


# Regex ten file thu vien native hop le (vd 'msvcrt.dll', 'my-lib_v2.dll',
# 'libX11.so', 'libvulkan.so.1', 'libfoo.dylib') - chu/so/gach duoi/gach
# ngang/dau cham/khoang trang, PHAI ket thuc '.dll' (Windows) HOAC '.so'
# (Linux, kem version so '.so.1...' neu co) HOAC '.dylib' (macOS), KHONG
# duoc chua '..'/'/'/'\\' (chan path traversal/injection vao chuoi IL).
# R7 (2026-09-22): mo rong tu '.dll'-only sang ca Linux/macOS (truoc day
# linter tu choi cang libvulkan.so/libatspi.so ke ca khi chi build).
_EXTERN_DLL_NAME_RE = re.compile(r'^[\w\-. ]+\.(dll|so(\.\d+)*|dylib)$')
# Regex ten symbol C hop le (identifier C chuan).
_EXTERN_SYMBOL_NAME_RE = re.compile(r'^[A-Za-z_]\w*$')


def _validate_and_register_extern_pinvoke(decl, pinvoke_decl_lines_out):
    """Task 3 (2026-08-17, __tkv_extern_pinvoke__): validate 1 decl da
    parse SHAPE boi _parse_extern_pinvoke_dict_literal, 6 buoc THEO DUNG
    THU TU trong spec, moi buoc fail rieng 1 TranspileError. Sau khi qua
    het: sinh hidden method '__pinvoke_{name}', APPEND 1 dong
    'pinvokeimpl' vao pinvoke_decl_lines_out, dang ky builtin qua
    register_expr_builtin (returns='void' -> return_dtype=None, KHAC
    Phase 1 la truong hop DAU TIEN cho phep void)."""
    name = decl['name']
    dll = decl['dll']
    symbol = decl['symbol']
    convention = decl['convention']
    params = decl['params']
    returns = decl['returns']

    # (1) dll phai khop regex ten file thu vien native hop le.
    if not _EXTERN_DLL_NAME_RE.match(dll):
        raise TranspileError(
            f"__tkv_extern_pinvoke__ '{name}': 'dll' = {dll!r} khong phai ten file thu vien native hop le "
            f"(vd 'msvcrt.dll'/'libX11.so'/'libfoo.dylib' - chu/so/gach duoi/gach ngang/dau cham/khoang trang, phai ket "
            f"thuc '.dll'/'.so'/'.dylib', khong duoc chua duong dan)")
    # (2) symbol phai khop regex identifier C hop le.
    if not _EXTERN_SYMBOL_NAME_RE.match(symbol):
        raise TranspileError(
            f"__tkv_extern_pinvoke__ '{name}': 'symbol' = {symbol!r} khong phai identifier C "
            f"hop le (vd 'sqrt')")
    # (3) convention phai nam trong whitelist.
    if convention not in _EXTERN_CONVENTIONS:
        raise TranspileError(
            f"__tkv_extern_pinvoke__ '{name}': 'convention' = {convention!r} khong hop le - "
            f"chi ho tro {sorted(_EXTERN_CONVENTIONS)}")
    # (4) moi params phai nam trong bang dtype ho tro, HOAC la con tro
    # struct 'Name*' (R1 - struct khai qua __tkv_struct__ trong CUNG chuong
    # trinh, truyen dia chi managed 'valuetype Name&' - mo GetCursorPos/
    # GetSystemTime/OpenH264...).
    for i, p in enumerate(params):
        _pm = _STRUCT_PTR_RE.match(p) if isinstance(p, str) else None
        if _pm is not None:
            if _pm.group(1) not in il_codegen._STRUCT_DEFS:
                raise TranspileError(
                    f"__tkv_extern_pinvoke__ '{name}': params[{i}] = {p!r} - struct "
                    f"'{_pm.group(1)}' chua duoc khai bao qua __tkv_struct__")
        elif p != 'ptr' and p not in _EXTERN_DTYPE_TO_IL:
            raise TranspileError(
                f"__tkv_extern_pinvoke__ '{name}': params[{i}] = {p!r} khong phai dtype hop le - "
                f"chi ho tro {sorted(_EXTERN_DTYPE_TO_IL)} hoac 'ptr' (con tro native) "
                f"hoac con tro struct 'TenStruct*'")
        # Critical 2 (final review Phase 9d Part B, 2026-08-27): 'object'/
        # 'type' duoc Task 2 them vao _EXTERN_DTYPE_TO_IL de _il_ctor_
        # param_type/il_type_str (chi dung boi __tkv_extern_class__) short-
        # circuit dung - nhung viec them do lam __tkv_extern_pinvoke__ (kiem
        # tra membership TRUC TIEP tren _EXTERN_DTYPE_TO_IL, khong qua
        # _is_valid_extern_dtype) AM THAM chap nhan 2 dtype nay, du plan
        # Phase 9d Part B noi RO KHONG dung/mo rong __tkv_extern_pinvoke__.
        # marshaling P/Invoke cho object/System.Type CHUA duoc thiet ke/rao
        # xet (ngoai pham vi fix nay) - tu choi RO RANG thay vi de lot am
        # tham roi that bai kho hieu o ilasm/luc chay.
        if p in ('object', 'type'):
            raise TranspileError(
                f"__tkv_extern_pinvoke__ '{name}': params[{i}] = {p!r} chua duoc ho tro - "
                f"dtype 'object'/'type' CHI ho tro tren __tkv_extern_class__ (method/ctor), "
                f"chua co thiet ke marshaling P/Invoke cho dtype nay (Phase 9d Part B)")
    # (5) returns phai la 'void' HOAC nam trong bang dtype scalar (KHAC
    # Phase 1 - Phase 2 CHO PHEP void).
    if returns != 'void' and returns != 'ptr' and returns not in _EXTERN_DTYPE_TO_IL:
        raise TranspileError(
            f"__tkv_extern_pinvoke__ '{name}': returns = {returns!r} khong phai dtype hop le - "
            f"chi ho tro 'void' hoac {sorted(_EXTERN_DTYPE_TO_IL)} hoac 'ptr' (con tro native)")
    if returns in ('object', 'type'):
        raise TranspileError(
            f"__tkv_extern_pinvoke__ '{name}': returns = {returns!r} chua duoc ho tro - "
            f"dtype 'object'/'type' CHI ho tro tren __tkv_extern_class__ (method/ctor), "
            f"chua co thiet ke marshaling P/Invoke cho dtype nay (Phase 9d Part B)")
    # (6) name phai la identifier Python hop le.
    if not name.isidentifier():
        raise TranspileError(
            f"__tkv_extern_pinvoke__: 'name' = {name!r} khong phai identifier hop le")

    hidden_name = f'__pinvoke_{name}'
    return_dtype = None if returns == 'void' else returns
    if isinstance(returns, str) and _STRUCT_PTR_RE.match(returns):
        raise TranspileError(
            f"__tkv_extern_pinvoke__ '{name}': returns = {returns!r} - con tro struct lam gia tri "
            f"tra ve CHUA ho tro (v1 chi ho tro struct* lam THAM SO out/in). "
            f"Dung tham so out thay the.")
    il_ret_type = 'void' if return_dtype is None else _pinvoke_param_il(return_dtype)
    il_param_types = [_pinvoke_param_il(p) for p in params]
    il_param_list = ', '.join(il_param_types)
    pinvoke_decl_lines_out.append(
        f'.method public hidebysig static pinvokeimpl("{dll}" as "{symbol}" {convention})\n'
        f'    {il_ret_type} {hidden_name}({il_param_list}) cil managed preservesig {{}}')

    codegen_fn = _make_extern_pinvoke_call_codegen(hidden_name, params, return_dtype)
    # Phase 9b fix-of-fix (bool, 2026-08-25): giong _validate_and_register_
    # extern_method - 'return_dtype' tho (co the la 'bool') PHAI giu nguyen
    # cho codegen_fn (IL call signature can dung 'bool' de .NET resolve
    # dung method). Nhung gia tri dang ky voi register_expr_builtin phai la
    # dtype PHIA TOKENVECTOR (i32 thay bool) - dung _tokenvector_facing_dtype
    # de quy doi, an toan voi return_dtype=None (void) vi ham do tra ve None
    # khong doi khi dtype != 'bool'.
    register_expr_builtin(name, codegen_fn, _tokenvector_facing_dtype(return_dtype))
    if return_dtype is None:
        # Fix Critical (2026-08-17): danh dau RIENG "ham nay THAT SU void" -
        # xem EXTERN_VOID_BUILTIN_NAMES o tren, dung boi codegen_call_stmt
        # (file_io.py) thay cho heuristic sai "return_dtype is None => void".
        EXTERN_VOID_BUILTIN_NAMES.add(name)


# F4a (2026-09-23, __tkv_vtable__): goi ham qua con tro vtable (COM raw,
# callback native) bang lenh CIL 'calli' - mo consume COM khong wrapper
# (D3D11 truc tiep, IUnknown::AddRef/Release...). Khai bao:
# __tkv_vtable__ = [{"name": "unk_addref", "convention": "stdcall",
#                    "params": [], "returns": "i32"}]
# Sinh builtin 'unk_addref(iface, slot, *args)' - iface: i64 bien don
# (con tro interface opaque), slot: so thu tu slot vtable (i32), args
# theo khai bao. Emitter TU resolve 'fn = *(iface + slot*8)' (doc that
# 2026-09-23: shape cu '(iface, fn-pointer)' la footgun - truyen nham
# slot-number vao cho con tro la goi vao dia chi = slot -> AV cam).
# Mac dinh co 'this' an (COM method: iface la doi so dau tien). Ham
# native TU DO (vd lay qua GetProcAddress - KHONG co this): them
# '"this": "false"' vao decl - sig calli bo 'native int' dau, iface chi
# dung de resolve fn (van can o dang cell 2 muc: cell->fn, xem rawfn).
# 'ptr' (F4a): param/return la con tro native (IL 'native int', phia
# TokenVector la i64) - dung cho IntPtr/HWND/COM... ma bang scalar
# khong bieu dien duoc (int64 != native int tren IL stack).
_VTABLE_KEYS = {'name', 'convention', 'params', 'returns', 'this'}
_VTABLE_REQUIRED = {'name', 'convention', 'returns'}


def _parse_vtable_dict_literal(node):
    """__tkv_vtable__ (F4a): parse 1 phan tu dict-literal cua pragma thanh
    dict Python thuong ({'name':..., 'convention':..., 'params': [...],
    'returns':..., 'kind': 'vtable'}) - validate SHAPE (dict, key hop le,
    value dung kieu) o day; validate NGHIEP VU (dtype, convention, dang ky
    builtin calli...) la _validate_and_register_vtable. 'kind' la marker
    noi bo de vong dang ky phan biet voi entry pinvoke (2 loai DI CHUNG
    list 'extern_pinvokes' de KHONG phai sua tuple extract/merge - xem
    nhanh pragma __tkv_vtable__ trong _parse_program_ast)."""
    if not isinstance(node, ast.Dict):
        raise TranspileError(
            "__tkv_vtable__: moi phan tu phai la 1 dict voi cac key "
            "name/convention/params/returns")
    result = {}
    for k, v in zip(node.keys, node.values):
        if not (isinstance(k, ast.Constant) and isinstance(k.value, str)):
            raise TranspileError("__tkv_vtable__: key dict phai la chuoi")
        key = k.value
        if key not in _VTABLE_KEYS:
            raise TranspileError(
                f"__tkv_vtable__: key '{key}' khong hop le - chi chap nhan "
                f"{sorted(_VTABLE_KEYS)}")
        if key == 'params':
            if not isinstance(v, ast.List):
                raise TranspileError("__tkv_vtable__: 'params' phai la 1 list chuoi")
            params = []
            for elt in v.elts:
                if not (isinstance(elt, ast.Constant) and isinstance(elt.value, str)):
                    raise TranspileError("__tkv_vtable__: moi phan tu 'params' phai la chuoi")
                params.append(elt.value)
            result['params'] = params
        else:
            if not (isinstance(v, ast.Constant) and isinstance(v.value, str)):
                raise TranspileError(f"__tkv_vtable__: gia tri '{key}' phai la chuoi")
            result[key] = v.value
    result.setdefault('params', [])
    missing = _VTABLE_REQUIRED - result.keys()
    if missing:
        raise TranspileError(
            f"__tkv_vtable__: thieu key bat buoc {sorted(missing)}")
    result['kind'] = 'vtable'
    return result


def _vtable_il_sig(param_dtypes, return_dtype, convention, has_this=True):
    """Chuoi callsite cho 'calli': COM method (has_this) =
    'unmanaged stdcall int32(native int, ...)' ('native int' DAU TIEN la
    'this' ngam dinh); ham tu do (this=false) = khong co 'native int'
    dau. 'ptr'/struct* -> 'native int' THO (KHAC pinvoke: pinvoke co
    marshaling nen dung duoc managed 'valuetype&'; calli KHONG marshal -
    byref managed trong chu ky unmanaged gay crash luc chay - phai truyen
    dia chi tho + conv.i, an toan vi struct local la stack slot (GC khong
    doi stack). Scalar qua bang. 'bool' CAM o day (BOOL 4-byte native vs
    bool 1-byte IL - lech stack am tham; dung 'i32' cho BOOL/HRESULT)."""
    il_params = [_vtable_param_il(p) for p in param_dtypes]
    il_ret = 'void' if return_dtype is None else _vtable_param_il(return_dtype)
    callconv = 'stdcall' if convention == 'stdcall' else 'cdecl'
    inner = ', '.join((['native int'] if has_this else []) + il_params)
    return f'unmanaged {callconv} {il_ret}({inner})'


def _vtable_param_il(p):
    """IL text cho 1 param/return cua __tkv_vtable__ (goi _pinvoke_param_il
    cho scalar/'ptr', NHUNG struct* ve 'native int' - xem _vtable_il_sig)."""
    _m = _STRUCT_PTR_RE.match(p) if isinstance(p, str) else None
    if _m is not None:
        return 'native int'
    return _pinvoke_param_il(p)


def _make_vtable_call_codegen(param_dtypes, return_dtype, convention, has_this=True):
    """Factory codegen cho 1 entry __tkv_vtable__ (xem khoi comment F4a).
    has_this=True (COM method): 'ten(iface, slot, *args)' - day 'this'
    truoc, day args, resolve fn CUOI. has_this=False (ham tu do):
    'ten(base, slot, *args)' - day args truoc, resolve fn CUOI (khong
    can temp vi fn luon tinh sau cung tu base+slot). 'iface'/'base' BAT
    BUOC la ten bien don (nap lai lan 2 vo side-effect).

    Thu tu stack cho 'calli' (ECMA-335: con tro ham nam TREN CUNG).
    So hoc con tro tren mien i64 (add int64 verifiable), chi conv.i tai
    bien ReadInt64. 'ptr'/struct* param: dia chi tho + conv.i (i64->
    native int); return 'ptr': conv.i8 sau calli."""
    callsite = _vtable_il_sig(param_dtypes, return_dtype, convention, has_this)
    _VT_MARSHAL = '[mscorlib]System.Runtime.InteropServices.Marshal'

    def _codegen(args, scope, out, dtype, ctx):
        if len(args) != len(param_dtypes) + 2:
            raise SyntaxError(
                f"il_codegen: loi goi vtable can dung {len(param_dtypes) + 2} tham so "
                f"(iface, slot, {len(param_dtypes)} doi so), duoc goi voi {len(args)}")
        compile_expr = ctx['compile_expr']
        iface_node, slot_node = args[0], args[1]
        if not (isinstance(iface_node, tuple) and iface_node[0] == 'var'):
            raise SyntaxError(
                f"il_codegen: doi so 'iface' cua loi goi vtable phai la 1 TEN BIEN don "
                f"(vd 'p = get_iface(...); r = unk_addref(p, 1)' - khong truyen truc tiep "
                f"bieu thuc vi emitter can nap lai dia chi interface khi resolve vtable)")
        # 'this' an (COM method): giua lai duoi day stack cho calli.
        # Ham tu do: KHONG day this (sig calli khong co 'native int' dau).
        if has_this:
            compile_expr(iface_node, scope, out, 'i64', ctx)
            out.append('    conv.i')
        # Args khai bao ('ptr' + struct* xu ly rieng nhu pinvoke).
        for arg_node, want_dtype in zip(args[2:], param_dtypes):
            _pm = _STRUCT_PTR_RE.match(want_dtype) if isinstance(want_dtype, str) else None
            if _pm is not None:
                if not (isinstance(arg_node, tuple) and arg_node[0] == 'var'):
                    raise SyntaxError(
                        f"il_codegen: tham so struct '{want_dtype}' can 1 ten bien struct don")
                try:
                    _, _, _ta = scope[arg_node[1]]
                except (KeyError, SyntaxError):
                    raise SyntaxError(
                        f"il_codegen: '{arg_node[1]}' khong phai bien struct da khai bao")
                if _ta.shape != 'struct' or _ta.dtype != _pm.group(1):
                    raise SyntaxError(
                        f"il_codegen: tham so struct '{want_dtype}' can bien kieu struct "
                        f"'{_pm.group(1)}', gap '{arg_node[1]}' kieu {_ta.dtype!r}/shape {_ta.shape!r}")
                # Dia chi THO (native int) cho calli - KHAC pinvoke (managed&
                # + marshaling, crash luc chay): xem _vtable_il_sig.
                ctx['load_var_addr'](arg_node[1], scope, out)
                out.append('    conv.i')
                continue
            compile_expr(arg_node, scope, out, _tokenvector_facing_dtype(want_dtype), ctx)
            if want_dtype == 'ptr':
                out.append('    conv.i')
        # fn resolve: COM (has_this) = 2 muc (iface -> vtbl -> fn[slot]);
        # ham tu do = 1 muc (base TRO TOI MANG con tro ham -> fn[slot]).
        # Sau do thong nhat: slot*8 (i64), add, doc fn - fn TREN CUNG.
        compile_expr(iface_node, scope, out, 'i64', ctx)
        out.append('    conv.i')
        if has_this:
            out.append(f'    call int64 {_VT_MARSHAL}::ReadInt64(native int)')
        out.append('    conv.i8')
        try:
            _slot_d = ctx['infer_dtype'](slot_node, scope, ctx.get('func_table'),
                                         ctx.get('records'), ctx.get('record_methods'))
        except Exception:
            _slot_d = None
        compile_expr(slot_node, scope, out, 'i64' if _slot_d == 'i64' else 'i32', ctx)
        out.append('    conv.i8')
        out.append('    ldc.i8 8')
        out.append('    mul')
        out.append('    add')
        out.append('    conv.i')
        out.append(f'    call int64 {_VT_MARSHAL}::ReadInt64(native int)')
        out.append('    conv.i')
        out.append(f'    calli {callsite}')
        if return_dtype == 'ptr':
            out.append('    conv.i8')
        # Giong pinvoke/extern_method: khong widen thu cong - dispatch
        # chung tu lo qua return_dtype dang ky (facing).
    return _codegen


def _validate_and_register_vtable(decl):
    """F4a: validate 1 decl __tkv_vtable__ da parse SHAPE, roi dang ky
    builtin calli - mirror _validate_and_register_extern_pinvoke (KHONG
    dll/symbol/pinvokeimpl - con tro ham resolve luc chay tu iface+slot).
    'void' returns -> EXTERN_VOID_BUILTIN_NAMES (goi dang lenh doc lap).
    'this'='false' (tuy chon): ham native tu do, sig calli khong co this."""
    name = decl['name']
    convention = decl['convention']
    params = decl['params']
    returns = decl['returns']
    this_opt = decl.get('this', 'true')
    if this_opt not in ('true', 'false'):
        raise TranspileError(
            f"__tkv_vtable__ '{name}': 'this' = {this_opt!r} khong hop le - "
            f"chi 'true' (COM method, mac dinh) hoac 'false' (ham tu do)")
    has_this = this_opt == 'true'

    if convention not in _EXTERN_CONVENTIONS:
        raise TranspileError(
            f"__tkv_vtable__ '{name}': 'convention' = {convention!r} khong hop le - "
            f"chi ho tro {sorted(_EXTERN_CONVENTIONS)}")
    for i, p in enumerate(params):
        _pm = _STRUCT_PTR_RE.match(p) if isinstance(p, str) else None
        if _pm is not None:
            # Struct blittable truyen dia chi THO (native int) - xem
            # _vtable_il_sig (mo COM method co struct params, F-4a).
            if _pm.group(1) not in il_codegen._STRUCT_DEFS:
                raise TranspileError(
                    f"__tkv_vtable__ '{name}': params[{i}] = {p!r} - struct "
                    f"'{_pm.group(1)}' chua duoc khai bao qua __tkv_struct__")
        elif p != 'ptr' and p not in _EXTERN_DTYPE_TO_IL:
            raise TranspileError(
                f"__tkv_vtable__ '{name}': params[{i}] = {p!r} khong phai dtype hop le - "
                f"chi ho tro {sorted(_EXTERN_DTYPE_TO_IL)}, 'ptr' (con tro native) "
                f"hoac con tro struct 'TenStruct*'")
        if p in ('object', 'type'):
            raise TranspileError(
                f"__tkv_vtable__ '{name}': params[{i}] = {p!r} chua duoc ho tro - "
                f"dtype 'object'/'type' khong co kieu IL on dinh cho chu ky 'calli'")
        if p == 'bool':
            raise TranspileError(
                f"__tkv_vtable__ '{name}': params[{i}] = 'bool' chua duoc ho tro - calli "
                f"KHONG marshal (bool IL 1-byte vs BOOL native 4-byte lech stack am tham) - "
                f"dung 'i32' cho BOOL/HRESULT/VARIANT_BOOL tuy truong hop")
    if returns != 'void' and returns != 'ptr' and returns not in _EXTERN_DTYPE_TO_IL:
        raise TranspileError(
            f"__tkv_vtable__ '{name}': returns = {returns!r} khong phai dtype hop le - "
            f"chi ho tro 'void' hoac {sorted(_EXTERN_DTYPE_TO_IL)} hoac 'ptr'")
    if returns in ('object', 'type'):
        raise TranspileError(
            f"__tkv_vtable__ '{name}': returns = {returns!r} chua duoc ho tro - "
            f"dtype 'object'/'type' khong co kieu IL on dinh cho chu ky 'calli'")
    if returns == 'bool':
        raise TranspileError(
            f"__tkv_vtable__ '{name}': returns = 'bool' chua duoc ho tro - calli KHONG "
            f"marshal (bool IL 1-byte vs BOOL native 4-byte) - dung 'i32'")
    if not name.isidentifier():
        raise TranspileError(
            f"__tkv_vtable__: 'name' = {name!r} khong phai identifier hop le")

    return_dtype = None if returns == 'void' else returns
    codegen_fn = _make_vtable_call_codegen(params, return_dtype, convention, has_this)
    register_expr_builtin(name, codegen_fn, _tokenvector_facing_dtype(return_dtype))
    if return_dtype is None:
        EXTERN_VOID_BUILTIN_NAMES.add(name)


# F4b (2026-09-23, __tkv_callback__): delegate non-generic cho callback
# native (EnumWindows, UIA handler, D3D...). Ly do can class RIENG (thay
# vi tai dung Func<...>): Marshal.GetFunctionPointerForDelegate TU CHOI
# delegate generic (ArgumentException, xac minh that) - can 1 kieu
# non-generic thua MulticastDelegate voi .ctor/Invoke 'runtime managed'.
# Khai bao:
# __tkv_callback__ = [{"name": "WndEnumProc", "params": ["i64", "i64"],
#                      "returns": "i32"}]
# Sinh (1) class 'WndEnumProcDelegate' (extra_classes) + (2) builtin
# 'callback_WndEnumProc(f)' - f PHAI la TEN ham top-level khop chu ky
# (ldnull + ldftn + newobj class rieng; KHONG nhan bien 'func'/lambda vi
# instance Func<...> san KHONG cast duoc sang class rieng). Stub nguoc
# mac dinh la stdcall/Winapi (dung moi API Win32; tren x64 moi convention
# nhu nhau). Giu song bang GCHandle leak-by-design (xem builtin).
# P2 (2026-09-23): them (a) key 'convention' ('stdcall'/'cdecl', vang mat
# = IL cu khong attribute) - phat .custom UnmanagedFunctionPointer (can
# cho x86); (b) builtin 'callback_keep_<name>(f)' - root delegate trong
# static list (thay vi GCHandle) + 'callback_free_all()' - giai phong TAT
# CA delegate da keep (Clear) - lifetime co quan ly thay vi leak vinh vien.
# Gioi han v1: params/returns chi so (i32/i64/f32/f64, void cho returns)
# - 'int' (struct TkvInt, KHONG blittable - stub that bai luc chay),
# 'str'/'bool'/'ptr'/struct* chua ho tro.
_CALLBACK_KEYS = {'name', 'params', 'returns', 'convention'}
_CALLBACK_REQUIRED = {'name', 'returns'}
_CALLBACK_SCALARS = frozenset({'i32', 'i64', 'f32', 'f64'})
_CALLBACK_CONVENTIONS = frozenset({'stdcall', 'cdecl'})


def _parse_callback_dict_literal(node):
    """__tkv_callback__ (F4b): parse 1 phan tu dict-literal thanh dict
    Python ({'name':..., 'params': [...], 'returns':..., 'kind':
    'callback'}) - validate SHAPE o day; validate NGHIEP VU + sinh class
    delegate + dang ky builtin la _validate_and_register_callback."""
    if not isinstance(node, ast.Dict):
        raise TranspileError(
            "__tkv_callback__: moi phan tu phai la 1 dict voi cac key "
            "name/params/returns")
    result = {}
    for k, v in zip(node.keys, node.values):
        if not (isinstance(k, ast.Constant) and isinstance(k.value, str)):
            raise TranspileError("__tkv_callback__: key dict phai la chuoi")
        key = k.value
        if key not in _CALLBACK_KEYS:
            raise TranspileError(
                f"__tkv_callback__: key '{key}' khong hop le - chi chap nhan "
                f"{sorted(_CALLBACK_KEYS)}")
        if key == 'params':
            if not isinstance(v, ast.List):
                raise TranspileError("__tkv_callback__: 'params' phai la 1 list chuoi")
            params = []
            for elt in v.elts:
                if not (isinstance(elt, ast.Constant) and isinstance(elt.value, str)):
                    raise TranspileError("__tkv_callback__: moi phan tu 'params' phai la chuoi")
                params.append(elt.value)
            result['params'] = params
        else:
            if not (isinstance(v, ast.Constant) and isinstance(v.value, str)):
                raise TranspileError(f"__tkv_callback__: gia tri '{key}' phai la chuoi")
            result[key] = v.value
    result.setdefault('params', [])
    missing = _CALLBACK_REQUIRED - result.keys()
    if missing:
        raise TranspileError(
            f"__tkv_callback__: thieu key bat buoc {sorted(missing)}")
    result['kind'] = 'callback'
    return result


def _callback_delegate_il_lines(decl):
    """Khoi '.class' delegate non-generic cho 1 decl (ghep vao
    extra_classes): thua MulticastDelegate, .ctor(object, native int) +
    Invoke(...) 'runtime managed' (CLR tu sinh than). Ten class
    '<name>Delegate' - tranh dung builtin 'callback_<name>'.
    P2: 'convention' hien -> .custom UnmanagedFunctionPointerAttribute
    (cdecl=1/stdcall=2, enum CallingConvention int32) - can cho x86;
    vang mat = IL cu (khong attribute)."""
    cname = decl['name'] + 'Delegate'
    params = decl['params']
    returns = decl['returns']
    il_params = [il_codegen._il_scalar_or_handle(p) for p in params]
    il_ret = 'void' if returns == 'void' else il_codegen._il_scalar_or_handle(returns)
    arg_list = ', '.join(f'{t} \'p{i}\'' for i, t in enumerate(il_params))
    lines = [
        f'.class public auto ansi sealed beforefieldinit {cname}',
        '       extends [mscorlib]System.MulticastDelegate',
        '{',
    ]
    _conv = decl.get('convention')
    if _conv is not None:
        _conv_val = '02 00 00 00' if _conv == 'stdcall' else '01 00 00 00'
        lines.append(
            '  .custom instance void '
            '[mscorlib]System.Runtime.InteropServices.UnmanagedFunctionPointerAttribute'
            '::.ctor(valuetype '
            '[mscorlib]System.Runtime.InteropServices.CallingConvention)'
            f' = ( 01 00 {_conv_val} 00 00 )')
    lines.extend([
        '  .method public hidebysig specialname rtspecialname',
        '          instance void .ctor(object \'object\', native int \'method\') runtime managed',
        '  {',
        '  }',
        '  .method public hidebysig virtual',
        f'          instance {il_ret} Invoke({arg_list}) runtime managed',
        '  {',
        '  }',
        '}',
    ])
    return lines


def _cb_keepalive_il_lines():
    """1 class static 'CbKeepAlive' (P2, 2026-09-23): root cac delegate da
    'callback_keep_X' trong 1 List<object> tinh (thay GCHandle leak) +
    ReleaseAll() (Clear) cho 'callback_free_all()'. Phat 1 LAN/chuong
    trinh co >=1 __tkv_callback__ (guard o diem goi)."""
    _list = 'class [mscorlib]System.Collections.Generic.List`1<object>'
    return [
        '.class public auto ansi abstract sealed beforefieldinit CbKeepAlive',
        '       extends [mscorlib]System.Object',
        '{',
        f'  .field private static {_list} _kept',
        '  .method private hidebysig specialname rtspecialname static void .cctor() cil managed',
        '  {',
        '    .maxstack 8',
        f'    newobj instance void {_list}::.ctor()',
        f'    stsfld {_list} CbKeepAlive::_kept',
        '    ret',
        '  }',
        '  .method public hidebysig static void Keep(object \'d\') cil managed',
        '  {',
        '    .maxstack 8',
        f'    ldsfld {_list} CbKeepAlive::_kept',
        '    ldarg.0',
        f'    callvirt instance void {_list}::Add(!0)',
        '    ret',
        '  }',
        '  .method public hidebysig static void ReleaseAll() cil managed',
        '  {',
        '    .maxstack 8',
        f'    ldsfld {_list} CbKeepAlive::_kept',
        f'    callvirt instance void {_list}::Clear()',
        '    ret',
        '  }',
        '}',
    ]


def _make_callback_ctor_codegen(decl):
    """Factory builtin 'callback_<name>(f)' (F4b): f la TEN ham top-level
    khop chu ky khai bao -> ldnull + ldftn + newobj Delegate rieng ->
    GCHandle.Alloc + pop (giu song, leak co chu y - native co the giu con
    tro sau khi ham tra ve) -> GetFunctionPointerForDelegate -> i64."""
    cname = decl['name'] + 'Delegate'
    want_params = list(decl['params'])
    want_ret = None if decl['returns'] == 'void' else decl['returns']

    def _codegen(args, scope, out, dtype, ctx):
        if len(args) != 1:
            raise SyntaxError(
                f"il_codegen: 'callback_{decl['name']}(...)' chi nhan dung 1 tham so "
                f"(ten 1 ham top-level khop chu ky (({', '.join(want_params)}) -> "
                f"{decl['returns']}))")
        arg_node = args[0]
        if not (isinstance(arg_node, tuple) and arg_node[0] == 'var'):
            raise SyntaxError(
                f"il_codegen: 'callback_{decl['name']}(...)' chi nhan TEN 1 ham top-level "
                f"(khong nhan bien 'func'/lambda - instance Func<...> khong chuyen duoc "
                f"sang delegate rieng '{cname}')")
        fname = arg_node[1]
        func_table = (ctx or {}).get('func_table') or {}
        if fname not in func_table:
            raise SyntaxError(
                f"il_codegen: 'callback_{decl['name']}(...)' - '{fname}' khong phai 1 ham "
                f"top-level da khai bao")
        callee = func_table[fname]
        callee_params = [il_codegen._norm_param_dtype(p.type_ann) for p in callee.params]
        callee_ret = il_codegen._norm_param_dtype(callee.return_type) if callee.return_type else None
        if callee_params != want_params or callee_ret != want_ret:
            raise SyntaxError(
                f"il_codegen: ham '{fname}' (({', '.join(callee_params)}) -> {callee_ret}) "
                f"khong khop chu ky callback 'callback_{decl['name']}' "
                f"((({', '.join(want_params)}) -> {decl['returns']})) - delegate binding "
                f"doi khop CHINH XAC")
        class_name = (ctx or {}).get('class_name') or 'Program'
        params_il = ', '.join(il_codegen._il_scalar_or_handle(d) for d in callee_params)
        ret_il = il_codegen._il_scalar_or_handle(callee_ret)
        out.append('    ldnull')
        out.append(f'    ldftn {ret_il} {class_name}::{il_codegen._il_ident(fname)}({params_il})')
        out.append(f'    newobj instance void {cname}::.ctor(object, native int)')
        out.append('    dup')
        out.append('    call valuetype [mscorlib]System.Runtime.InteropServices.GCHandle '
                   '[mscorlib]System.Runtime.InteropServices.GCHandle::Alloc(object)')
        out.append('    pop')
        out.append('    call native int [mscorlib]System.Runtime.InteropServices.Marshal::'
                   'GetFunctionPointerForDelegate(class [mscorlib]System.Delegate)')
        out.append('    conv.i8')
    return _codegen


def _make_callback_keep_codegen(decl):
    """Factory builtin 'callback_keep_<name>(f)' (P2): giong callback_<name>
    (f phai la TEN ham top-level khop chu ky) nhung root delegate trong
    CbKeepAlive (dup + Keep) thay vi GCHandle leak - giai phong sau bang
    'callback_free_all()'. Tra i64 (con tro ham native) nhu ban goc."""
    cname = decl['name'] + 'Delegate'
    want_params = list(decl['params'])
    want_ret = None if decl['returns'] == 'void' else decl['returns']

    def _codegen(args, scope, out, dtype, ctx):
        if len(args) != 1:
            raise SyntaxError(
                f"il_codegen: 'callback_keep_{decl['name']}(...)' chi nhan dung 1 tham so "
                f"(ten 1 ham top-level khop chu ky (({', '.join(want_params)}) -> "
                f"{decl['returns']}))")
        arg_node = args[0]
        if not (isinstance(arg_node, tuple) and arg_node[0] == 'var'):
            raise SyntaxError(
                f"il_codegen: 'callback_keep_{decl['name']}(...)' chi nhan TEN 1 ham top-level "
                f"(khong nhan bien 'func'/lambda - instance Func<...> khong chuyen duoc "
                f"sang delegate rieng '{cname}')")
        fname = arg_node[1]
        func_table = (ctx or {}).get('func_table') or {}
        if fname not in func_table:
            raise SyntaxError(
                f"il_codegen: 'callback_keep_{decl['name']}(...)' - '{fname}' khong phai 1 ham "
                f"top-level da khai bao")
        callee = func_table[fname]
        callee_params = [il_codegen._norm_param_dtype(p.type_ann) for p in callee.params]
        callee_ret = il_codegen._norm_param_dtype(callee.return_type) if callee.return_type else None
        if callee_params != want_params or callee_ret != want_ret:
            raise SyntaxError(
                f"il_codegen: ham '{fname}' (({', '.join(callee_params)}) -> {callee_ret}) "
                f"khong khop chu ky callback 'callback_keep_{decl['name']}' "
                f"((({', '.join(want_params)}) -> {decl['returns']})) - delegate binding "
                f"doi khop CHINH XAC")
        class_name = (ctx or {}).get('class_name') or 'Program'
        params_il = ', '.join(il_codegen._il_scalar_or_handle(d) for d in callee_params)
        ret_il = il_codegen._il_scalar_or_handle(callee_ret)
        out.append('    ldnull')
        out.append(f'    ldftn {ret_il} {class_name}::{il_codegen._il_ident(fname)}({params_il})')
        out.append(f'    newobj instance void {cname}::.ctor(object, native int)')
        out.append('    dup')
        out.append('    call void CbKeepAlive::Keep(object)')
        out.append('    call native int [mscorlib]System.Runtime.InteropServices.Marshal::'
                   'GetFunctionPointerForDelegate(class [mscorlib]System.Delegate)')
        out.append('    conv.i8')
    return _codegen


def _make_callback_free_all_codegen():
    """Factory builtin 'callback_free_all()' (P2): CbKeepAlive.ReleaseAll()
    (Clear - tha TAT CA delegate da keep, cho GC thu hoi) - tra 0 i64 de
    goi dang lenh doc lap (mirror free_bytes)."""

    def _codegen(args, scope, out, dtype, ctx):
        if len(args) != 0:
            raise SyntaxError("il_codegen: callback_free_all() khong nhan tham so")
        out.append('    call void CbKeepAlive::ReleaseAll()')
        out.append('    ldc.i8 0')
    return _codegen


def _validate_and_register_callback(decl):
    """F4b: validate 1 decl __tkv_callback__ roi dang ky builtin
    'callback_<name>' (tra i64 - con tro ham native) + 'callback_keep_<name>'
    (root delegate, tu giai phong bang 'callback_free_all'). Ten class delegate
    '<name>Delegate' + ten builtin duoc kiem trung toan cuc qua
    register_expr_builtin (ValueError on ao). 'convention' (tuy chon):
    'stdcall'/'cdecl' - hien tren class delegate (mac dinh vang mat)."""
    name = decl['name']
    params = decl['params']
    returns = decl['returns']
    if not name.isidentifier():
        raise TranspileError(
            f"__tkv_callback__: 'name' = {name!r} khong phai identifier hop le")
    for i, p in enumerate(params):
        if p not in _CALLBACK_SCALARS:
            raise TranspileError(
                f"__tkv_callback__ '{name}': params[{i}] = {p!r} khong ho tro - v1 chi "
                f"{sorted(_CALLBACK_SCALARS)} (so blittable; 'int' la struct TkvInt khong "
                f"blittable, 'str'/'bool'/'ptr' chua ho tro)")
    if returns != 'void' and returns not in _CALLBACK_SCALARS:
        raise TranspileError(
            f"__tkv_callback__ '{name}': returns = {returns!r} khong ho tro - v1 chi "
            f"'void' hoac {sorted(_CALLBACK_SCALARS)}")
    if decl.get('convention') is not None and decl['convention'] not in _CALLBACK_CONVENTIONS:
        raise TranspileError(
            f"__tkv_callback__ '{name}': 'convention' = {decl['convention']!r} khong hop le - "
            f"chi {sorted(_CALLBACK_CONVENTIONS)}")
    codegen_fn = _make_callback_ctor_codegen(decl)
    register_expr_builtin(f'callback_{name}', codegen_fn, 'i64')
    keep_fn = _make_callback_keep_codegen(decl)
    register_expr_builtin(f'callback_keep_{name}', keep_fn, 'i64')


# F4c (2026-09-23, __tkv_com_class__): phoi 1 record ra COM (CCW) - mo
# UIA provider that, D3D plugin... Khai bao:
# __tkv_com_class__ = [{"record": "Answer", "guid": "AAAAAAAA-1111-...-...",
#                       "interface": "IAnswer", "interface_guid": "BBBB-...",
#                       "methods": [{"name": "GetAnswer", "params": [], "returns": "i32"}]}]
# - 'record' PHAI la 1 class-record CUNG chuong trinh: method instance
#   THAT bien dich qua pipeline record co san (tai dung 100%, khong
#   pipeline moi); 'methods' la TAP CON method instance cua record, khop
#   chu ky CHINH XAC (so sanh qua _norm_param_dtype, ke ca ten sau rename).
# - Compiler: (1) them 'interface' vao record_interfaces[record] -> class
#   co 'implements IFace' (co che san nhu @interface mixin); (2) phat
#   '.custom ComVisible(true)+Guid' len class (qua com_attrs ->
#   gen_record_types); (3) sinh '.class interface IFace' voi Guid +
#   InterfaceType(IsIUnknown) + method abstract kem PreserveSig
#   (extra_classes, giong struct lines R1).
# - PreserveSig: giu chu ky native == managed (tat bien doi HRESULT/
#   [out,retval] mac dinh cua interop) - bat buoc de F4a calli goi truc
#   tiep dung chu ky khai bao.
# - Gioi han v1: method params/returns CHI so blittable (i32/i64/f32/f64,
#   +void cho returns) - 'bool' (CCW phoi VARIANT_BOOL 2-byte, lech voi
#   'bool' 4-byte cua calli), 'str' (BSTR - calli khong giai phong dung
#   allocator, corrupt heap), 'int' (struct TkvInt khong blittable),
#   container/record/handle-type deu CAM. UIA can BSTR/HRESULT-out la
#   F4c+ (di duong out-ptr + SysAllocString thu cong).
_COM_KEYS = {'record', 'guid', 'interface', 'interface_guid', 'methods'}
_COM_REQUIRED = {'record', 'guid', 'interface', 'interface_guid', 'methods'}
_COM_METHOD_KEYS = {'name', 'params', 'returns'}
_COM_METHOD_REQUIRED = {'name', 'params', 'returns'}
_COM_DTYPES = frozenset({'i32', 'i64', 'f32', 'f64'})
_COM_GUID_RE = re.compile(
    r'^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-'
    r'[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$')


def _parse_com_method_dict_literal(node):
    if not isinstance(node, ast.Dict):
        raise TranspileError(
            "__tkv_com_class__'s 'methods': moi phan tu phai la 1 dict-literal")
    result = {}
    for k_node, v_node in zip(node.keys, node.values):
        if not (isinstance(k_node, ast.Constant) and isinstance(k_node.value, str)):
            raise TranspileError("__tkv_com_class__'s method dict: key phai la string literal")
        key = k_node.value
        if key not in _COM_METHOD_KEYS:
            raise TranspileError(
                f"__tkv_com_class__'s method dict: key {key!r} khong hop le, "
                f"chi chap nhan {sorted(_COM_METHOD_KEYS)}")
        if key == 'params':
            if not isinstance(v_node, ast.List):
                raise TranspileError("__tkv_com_class__'s method 'params' phai la 1 list chuoi")
            plist = []
            for elt in v_node.elts:
                if not (isinstance(elt, ast.Constant) and isinstance(elt.value, str)):
                    raise TranspileError(
                        "__tkv_com_class__'s method 'params': moi phan tu phai la chuoi")
                plist.append(elt.value)
            result['params'] = plist
        else:
            if not (isinstance(v_node, ast.Constant) and isinstance(v_node.value, str)):
                raise TranspileError(
                    f"__tkv_com_class__'s method dict: key {key!r} phai la string literal")
            result[key] = v_node.value
    result.setdefault('params', [])
    missing = _COM_METHOD_REQUIRED - set(result.keys())
    if missing:
        raise TranspileError(
            f"__tkv_com_class__'s method dict thieu key bat buoc: {sorted(missing)}")
    return result


def _parse_com_class_dict_literal(node):
    """__tkv_com_class__ (F4c): parse 1 phan tu dict-literal thanh dict
    Python - validate SHAPE o day; validate NGHIEP VU (record ton tai,
    chu ky khop, guid dung dang) la _validate_and_register_com_class (can
    record_defs/record_methods, chay trong compile_tkv_cli)."""
    if not isinstance(node, ast.Dict):
        raise TranspileError(
            "__tkv_com_class__: moi phan tu phai la 1 dict voi cac key "
            "record/guid/interface/interface_guid/methods")
    result = {}
    for k, v in zip(node.keys, node.values):
        if not (isinstance(k, ast.Constant) and isinstance(k.value, str)):
            raise TranspileError("__tkv_com_class__: key dict phai la chuoi")
        key = k.value
        if key not in _COM_KEYS:
            raise TranspileError(
                f"__tkv_com_class__: key '{key}' khong hop le - chi chap nhan "
                f"{sorted(_COM_KEYS)}")
        if key == 'methods':
            if not isinstance(v, ast.List) or not v.elts:
                raise TranspileError(
                    "__tkv_com_class__: 'methods' phai la 1 list KHAC RONG cac dict-literal")
            result['methods'] = [_parse_com_method_dict_literal(m) for m in v.elts]
        else:
            if not (isinstance(v, ast.Constant) and isinstance(v.value, str)):
                raise TranspileError(f"__tkv_com_class__: gia tri '{key}' phai la chuoi")
            result[key] = v.value
    missing = _COM_KEYS - set(result.keys())
    if missing:
        raise TranspileError(
            f"__tkv_com_class__: thieu key bat buoc {sorted(missing)}")
    return result


def _com_guid_blob(guid):
    """Phan blob SerString cho GuidAttribute: 1 byte do dai (guid LUON 36
    ky tu -> 0x24) + 16 byte guid (bo gach noi, IN HOA, cach nhau)."""
    raw = guid.replace('-', '')
    hexpairs = ' '.join(raw[i:i + 2].upper() for i in range(0, 32, 2))
    return f'24 {hexpairs}'


def _com_custom_lines(kind, guid=None):
    """Dong '.custom' (ECMA-335: prolog 01 00 + fixed args + 00 00 named)
    cho 4 attribute COM v1 - blob co dinh, da doi chieu dinh dang .NET:
    ComVisible(bool=true), Guid(string), InterfaceType(int32 IsIUnknown=1
    - ComInterfaceType underlying int32), PreserveSig(void)."""
    if kind == 'comvisible':
        return ['  .custom instance void '
                '[mscorlib]System.Runtime.InteropServices.ComVisibleAttribute'
                '::.ctor(bool) = ( 01 00 01 00 00 )']
    if kind == 'guid':
        return [f'  .custom instance void '
                f'[mscorlib]System.Runtime.InteropServices.GuidAttribute'
                f'::.ctor(string) = ( 01 00 {_com_guid_blob(guid)} 00 00 )']
    if kind == 'interfacetype':
        return ['  .custom instance void '
                '[mscorlib]System.Runtime.InteropServices.InterfaceTypeAttribute'
                '::.ctor(int32) = ( 01 00 01 00 00 00 00 00 )']
    if kind == 'preservesig':
        return ['  .custom instance void '
                '[mscorlib]System.Runtime.InteropServices.PreserveSigAttribute'
                '::.ctor() = ( 01 00 00 00 )']
    raise AssertionError(f"loai .custom COM khong ho tro: {kind!r} (loi noi bo compiler)")


def _com_interface_il_lines(decl):
    """Khoi '.class interface IFace' (ghep vao extra_classes): Guid +
    InterfaceType(IsIUnknown) + method abstract kem PreserveSig. Chu ky
    method DUNG helper _il_scalar_or_handle nhu phia record de 2 ben KHOP
    nhau tuyet doi (dieu kien CLR map implicit interface impl)."""
    iface = decl['interface']
    lines = [f'.class interface public abstract auto ansi {iface}', '{']
    lines.extend(_com_custom_lines('interfacetype'))
    lines.extend(_com_custom_lines('guid', decl['interface_guid']))
    for m in decl['methods']:
        il_params = [il_codegen._il_scalar_or_handle(p) for p in m['params']]
        il_ret = 'void' if m['returns'] == 'void' else il_codegen._il_scalar_or_handle(m['returns'])
        arg_list = ', '.join(f"{t} 'p{i}'" for i, t in enumerate(il_params))
        lines.append(f'  .method public hidebysig newslot abstract virtual instance '
                     f"{il_ret} '{m['name']}'({arg_list}) cil managed")
        lines.append('  {')
        lines.extend(_com_custom_lines('preservesig'))
        lines.append('  }')
    lines.append('}')
    return lines


def _validate_and_register_com_class(decl, record_defs, record_methods, record_interfaces,
                                     com_attrs_out, iface_lines_out):
    """F4c: validate 1 decl __tkv_com_class__ (can record_defs/record_methods
    nen chay trong compile_tkv_cli SAU _build_record_methods): record ton
    tai; guid dung dang; method la TAP CON method instance (khong static)
    cua record, khop chu ky CHINH XAC. Tac dong: (1) record_interfaces[rec]
    += interface (class co 'implements'); (2) com_attrs_out[rec] += .custom
    class; (3) iface_lines_out += khoi interface. KHONG dang ky builtin
    (khong can finally-pop)."""
    rec = decl['record']
    iface = decl['interface']
    if not rec.isidentifier():
        raise TranspileError(f"__tkv_com_class__: 'record' = {rec!r} khong phai identifier hop le")
    if rec not in record_defs:
        raise TranspileError(
            f"__tkv_com_class__: record {rec!r} chua duoc khai bao 'class {rec}(...)' "
            f"trong chuong trinh")
    if not iface.isidentifier():
        raise TranspileError(f"__tkv_com_class__: 'interface' = {iface!r} khong phai identifier hop le")
    if iface in record_defs:
        raise TranspileError(
            f"__tkv_com_class__: 'interface' = {iface!r} trung ten voi record/class da khai bao - "
            f"doi ten khac")
    if iface in EXPR_BUILTIN_CODEGEN:
        raise TranspileError(
            f"__tkv_com_class__: 'interface' = {iface!r} trung ten voi builtin co san - doi ten khac")
    for gkey in ('guid', 'interface_guid'):
        if not _COM_GUID_RE.match(decl[gkey]):
            raise TranspileError(
                f"__tkv_com_class__ '{rec}': '{gkey}' = {decl[gkey]!r} khong phai GUID hop le "
                f"(can dang 'XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX' hex)")
    seen_methods = set()
    rec_methods = record_methods.get(rec, {})
    for m in decl['methods']:
        mname = m['name']
        if not mname.isidentifier():
            raise TranspileError(
                f"__tkv_com_class__ '{rec}': ten method {mname!r} khong phai identifier hop le")
        if mname in seen_methods:
            raise TranspileError(
                f"__tkv_com_class__ '{rec}': method {mname!r} khai TRUNG LAP")
        seen_methods.add(mname)
        for i, p in enumerate(m['params']):
            if p not in _COM_DTYPES:
                raise TranspileError(
                    f"__tkv_com_class__ '{rec}': method {mname!r} params[{i}] = {p!r} khong ho tro - "
                    f"v1 chi so blittable {sorted(_COM_DTYPES)}")
        if m['returns'] != 'void' and m['returns'] not in _COM_DTYPES:
            raise TranspileError(
                f"__tkv_com_class__ '{rec}': method {mname!r} returns = {m['returns']!r} khong ho tro - "
                f"v1 chi 'void' hoac so blittable {sorted(_COM_DTYPES)}")
        if mname not in rec_methods:
            raise TranspileError(
                f"__tkv_com_class__ '{rec}': method {mname!r} khong ton tai tren record '{rec}' - "
                f"cac method co san: {sorted(rec_methods)}")
        msig = rec_methods[mname]
        if getattr(msig, 'is_static', False):
            raise TranspileError(
                f"__tkv_com_class__ '{rec}': method {mname!r} la '@staticmethod' - COM can "
                f"method instance (co 'self')")
        got_params = [il_codegen._norm_param_dtype(p.type_ann) for p in msig.params]
        got_ret = il_codegen._norm_param_dtype(msig.return_type) if msig.return_type else None
        want_ret = None if m['returns'] == 'void' else m['returns']
        if got_params != list(m['params']) or got_ret != want_ret:
            raise SyntaxError(
                f"il_codegen: method '{rec}.{mname}' (({', '.join(got_params)}) -> {got_ret}) "
                f"khong khop khai bao COM (({', '.join(m['params'])}) -> {m['returns']}) - "
                f"CLR doi khop CHINH XAC ten+chu ky cho implicit interface impl")
    record_interfaces.setdefault(rec, []).append(iface)
    com_attrs_out.setdefault(rec, []).extend(_com_custom_lines('comvisible'))
    com_attrs_out[rec].extend(_com_custom_lines('guid', decl['guid']))
    iface_lines_out.extend(_com_interface_il_lines(decl))


def _validate_and_register_extern_method(decl, declared_assembly_names, extern_assemblies=None):
    """Task 3 (2026-08-14): validate 1 decl da parse SHAPE boi
    _parse_extern_method_dict_literal, roi dang ky dong qua
    register_expr_builtin (il_dispatch.py) - 7 buoc THEO DUNG THU TU trong
    spec, moi buoc fail rieng 1 TranspileError liet ke ro gia tri sai +
    gia tri hop le mong doi."""
    name = decl['name']
    assembly = decl['assembly']
    dotnet_class = decl['class']
    method_name = decl['method']
    params = decl['params']
    returns = decl['returns']

    # R3 (2026-09-22): 'assembly' full identity ("Shim, Version=1.0.0.0,
    # Culture=neutral, PublicKeyToken=null") tu dang ky .assembly extern
    # dung - mo managed DLL rieng (C# shim). Ten don van nhu cu.
    if ',' in assembly:
        if extern_assemblies is None:
            raise TranspileError(
                f"__tkv_extern_method__ '{name}': assembly full identity {assembly!r} can "
                f"compile_tkv_cli truyen extern_assemblies (loi noi bo compiler)")
        assembly = _ensure_extern_assembly(
            assembly, extern_assemblies, declared_assembly_names,
            f"__tkv_extern_method__ '{name}'")
        decl['assembly'] = assembly
    # (1) assembly phai khop regex ten assembly .NET hop le (fix M2), ROI
    # phai da duoc khai bao (extern_assemblies hoac 3 assembly mac dinh luon
    # co san mscorlib/System/System.Core).
    if not _EXTERN_ASSEMBLY_NAME_RE.match(assembly):
        raise TranspileError(
            f"__tkv_extern_method__ '{name}': 'assembly' = {assembly!r} khong phai ten assembly "
            f".NET hop le (vd 'System.Xml' - chu/so/gach duoi/dau cham, bat dau bang chu hoac gach duoi)")
    if assembly not in declared_assembly_names:
        raise TranspileError(
            f"__tkv_extern_method__ '{name}': assembly '{assembly}' chua duoc khai bao qua "
            f"__tkv_extern_assembly__ - cac assembly da biet: {sorted(declared_assembly_names)}")
    # (2) class phai khop regex ten class .NET hop le.
    if not _EXTERN_CLASS_NAME_RE.match(dotnet_class):
        raise TranspileError(
            f"__tkv_extern_method__ '{name}': 'class' = {dotnet_class!r} khong phai ten class "
            f".NET hop le (vd 'System.Math' - chu/so/gach duoi/dau cham, bat dau bang chu hoac gach duoi)")
    # (3) method phai khop regex identifier don gian (khong dau cham).
    if not _EXTERN_METHOD_NAME_RE.match(method_name):
        raise TranspileError(
            f"__tkv_extern_method__ '{name}': 'method' = {method_name!r} khong phai identifier "
            f".NET don gian hop le (vd 'Pow' - khong duoc chua dau cham)")
    # (4) moi params phai nam trong bang dtype ho tro (F4a: them 'ptr').
    for i, p in enumerate(params):
        if p != 'ptr' and not _is_valid_extern_dtype(p) and p not in il_codegen._EXTERN_CLASS_DEFS:
            raise TranspileError(
                f"__tkv_extern_method__ '{name}': params[{i}] = {p!r} khong phai dtype hop le - "
                f"chi ho tro {sorted(_EXTERN_DTYPE_TO_IL)} hoac 'ptr' (con tro native) hoac 1 handle type da khai trong "
                f"__tkv_extern_class__ hoac container 'list[<scalar>]'")
        # (Phase 9k, 2026-08-31): 'object'/'type' truoc day BI TU CHOI o day
        # vi _extern_il_type_text (dung boi _make_extern_static_call_codegen
        # ben duoi) chua co short-circuit dung cho 'type', va codegen argument
        # (_compile_extern_object_arg) chua ton tai. CA HAI da duoc bo sung
        # tu Phase 9d Part B/9e (xem _extern_il_type_text's nhanh 'type' va
        # il_codegen._compile_extern_object_arg - ca 2 da AN TOAN voi moi
        # dtype, tu ghi ro trong chinh docstring cua chung la "phong thu cho
        # tuong lai neu validate thay doi"). Phat hien qua tkv-bind chay THAT
        # tren NuGet Newtonsoft.Json: JsonConvert.SerializeObject(object)
        # bi bo qua vi gioi han nay - xac nhan ha tang codegen da san sang,
        # chi con validate chan nham. Go bo chan, cho phep 'object'/'type'
        # tren __tkv_extern_method__ giong het __tkv_extern_class__. Test
        # compile+run that xac nhan (xem test/verify/extern_method_object_test.py).
    # (5) returns phai nam trong bang dtype scalar HOAC 'void' (Phase 9a mo
    # rong: void OK, nhung CHI khi ham duoc goi dang LENH DOC LAP - xem
    # buoc (7) duoi ve cach dang ky EXTERN_VOID_BUILTIN_NAMES, va
    # file_io.py::codegen_call_stmt ve cach dispatch. Goi ham void TRONG
    # bieu thuc (vd 'x = ten_ham()') se tu bao loi o nhanh khac (khong co
    # gia tri de gan) - khong can chan rieng o day.
    if (returns != 'void' and returns != 'ptr' and not _is_valid_extern_dtype(returns)
            and returns not in il_codegen._EXTERN_CLASS_DEFS):
        raise TranspileError(
            f"__tkv_extern_method__ '{name}': returns = {returns!r} khong phai dtype hop le - "
            f"chi ho tro 'void' hoac {sorted(_EXTERN_DTYPE_TO_IL)} hoac 'ptr' (con tro native) hoac 1 handle type da khai "
            f"trong __tkv_extern_class__ hoac container 'list[<scalar>]'")
    # (Phase 9k, 2026-08-31): xem chu thich tuong tu o nhanh params[i] ben
    # tren - go bo chan 'object'/'type' cho returns, ha tang codegen da san
    # sang (return_dtype 'object' di qua duong _expr_call/widen_if_needed
    # CHUNG nhu moi extern-method khac, khong can nhanh rieng).
    # (6) name phai la identifier Python hop le (dung lam ten builtin goi
    # duoc trong code .tkv).
    if not name.isidentifier():
        raise TranspileError(
            f"__tkv_extern_method__: 'name' = {name!r} khong phai identifier hop le")
    # (7) qua het validate - tao codegen + dang ky. void (Phase 9a) dang ky
    # return_dtype=None + them vao EXTERN_VOID_BUILTIN_NAMES (giong het
    # _validate_and_register_extern_pinvoke lam voi pinvoke) de
    # file_io.py::codegen_call_stmt nhan ra day la builtin THAT SU void khi
    # goi dang lenh doc lap - guard chong trung ten co san trong
    # register_expr_builtin se tu bung ValueError neu 'name' da duoc dang
    # ky boi builtin khac.
    return_dtype = None if returns == 'void' else returns
    codegen_fn = _make_extern_static_call_codegen(assembly, dotnet_class, method_name, params, return_dtype)    # Phase 9b (bool): 'return_dtype' o tren PHAI giu nguyen 'bool' (neu co)
    # cho codegen_fn - .NET runtime can thay dung 'bool' trong chu ky
    # call/callvirt de resolve method (xem Critical 2, Phase 9a). Nhung gia
    # tri dang ky voi register_expr_builtin la dtype PHIA TOKENVECTOR (dung
    # cho type inference cua bien nhan ket qua qua EXPR_BUILTIN_DTYPE) -
    # TokenVector KHONG co kieu bool rieng nen phai quy doi 'bool' -> 'i32'
    # RIENG o day, KHONG dung return_dtype tho.
    tkv_return_dtype = _tokenvector_facing_dtype(return_dtype)
    # Phase 9e (2026-08-27): return_dtype la 1 handle-type da khai qua
    # __tkv_extern_class__ -> dang ky return_shape='extern_class' de bien
    # nhan ket qua duoc gan TypeAnn(dtype=<handle class>, shape=
    # 'extern_class'), cho phep goi tiep instance method tren ket qua tra
    # ve (giong het cach bien tao qua ctor 'Sb()' duoc gan shape).
    _return_shape = 'extern_class' if return_dtype in il_codegen._EXTERN_CLASS_DEFS else None
    # R13 (2026-09-26): return_dtype dang 'list[<scalar>]' -> dang ky
    # return_ta=TypeAnn(elem, 'list') de bien nhan ket qua duoc gan DUNG
    # kieu CLR (List<int64> - xem chu thich R13 o _extern_il_type_text).
    # KHONG duoc chi truyen chuoi 'list[i64]' lam tkv_return_dtype:
    # convention cua TokenVector la TypeAnn.dtype = TIEU HOA PHAN TU +
    # shape='list' (xem _parse_type_ann_str), nen TypeAnn(dtype=
    # 'list[i64]', shape=None) se lam len()/index()/append() bao "khong
    # phai list" (test THAT). Dung lai _parse_type_ann_str - cung duong
    # voi nhanh extern-class o _make_extern_class_return_ta (dong ~2040)
    # nen 2 duong khong lech.
    _ret_elem = _extern_list_elem(return_dtype)
    if _ret_elem is not None:
        register_expr_builtin(name, codegen_fn, _ret_elem,
                              return_ta=_parse_type_ann_str(return_dtype))
        return
    register_expr_builtin(name, codegen_fn, tkv_return_dtype, return_shape=_return_shape)
    if return_dtype is None:
        EXTERN_VOID_BUILTIN_NAMES.add(name)


# R11 (D3): ten dac biet khong bao gio la bien local can kiem tra
# (doc ma khong gan trong ham la hop le): cau lenh rieng (print/open),
# ham dac biet KHONG qua registry (len/abs/typeof/bool/range...),
# introspection, exception pho bien, ham cap cao co the khong nam trong
# registry luc parse (enumerate/zip/...). Ten builtin dang ky that
# (str/int/sum/...) lay dong tu EXPR_BUILTIN_CODEGEN luc goi. Tap nay
# thua (generous) la AN TOAN: ten thua chi chuyen ve mach bao loi hien
# co, khong bao gio bien code dung thanh loi.
_R11_EXTRA_SKIP = frozenset({
    'print', 'open', 'range', 'super', 'isinstance', 'hasattr', 'getattr',
    'setattr', 'callable', 'enumerate', 'zip', 'map', 'filter', 'reversed',
    'len', 'abs', 'typeof', 'bool', 'all', 'any', 'ord', 'repr', 'format',
    'iter', 'next', 'id', 'dir', 'vars', 'globals', 'locals', 'issubclass',
    'compile', 'eval', 'exec', 'input', 'exit', 'quit', 'help', 'hex',
    'oct', 'bin', 'round', 'pow', 'divmod', 'sum', 'min', 'max', 'sorted',
    'Exception', 'BaseException', 'ValueError', 'KeyError', 'TypeError',
    'IndexError', 'AttributeError', 'RuntimeError', 'StopIteration',
    'NotImplementedError', 'NotImplemented', 'OverflowError',
    'ZeroDivisionError', 'ArithmeticError', 'LookupError', 'IOError',
    'OSError', 'Ellipsis',
    # Ten kieu dung trong isinstance()/tiep nhan (doc hop le, mach hien
    # co tu quyet dinh co ho tro hay khong).
    'bytearray', 'bytes', 'list', 'dict', 'set', 'frozenset', 'tuple',
    'str', 'int', 'float', 'bool', 'complex', 'object', 'type',
    'Counter', 'defaultdict', 'deque',
})


def _collect_imported_top_names(source_path, import_names, _depth=0, _visited=None):
    """R11 (D3): ten top-level (ham/hang/class) cua cac file duoc import -
    chung duoc GORP vao pham vi file hien tai (extract_program_file gop
    pairs), nen doc trong ham la hop le. Chi phan tich NONG (ast.parse lay
    ten, de quy import voi visited + depth cap), that bai o dau bo qua o
    do (mach import hien co se bao loi that sau)."""
    if _depth > 8:
        return set()
    if _visited is None:
        _visited = set()
    out = set()
    try:
        base_dir = Path(source_path).parent
    except Exception:
        return out
    for imp_name in import_names or ():
        try:
            imp_path = _find_module_path(imp_name, base_dir)
        except Exception:
            continue
        if imp_path is None or str(imp_path) in _visited:
            continue
        _visited.add(str(imp_path))
        try:
            imp_text = Path(imp_path).read_text(encoding='utf-8')
            imp_tree = ast.parse(imp_text)
        except Exception:
            continue
        for node in imp_tree.body:
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                out.add(node.name)
            elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                    isinstance(node.targets[0], ast.Name):
                out.add(node.targets[0].id)
            elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
                out.add(node.target.id)
        # De quy: ten tu import-cua-import (vd helper dung chung).
        sub_imports = []
        for node in imp_tree.body:
            if isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                    isinstance(node.targets[0], ast.Name) and \
                    node.targets[0].id == '__tkv_import__':
                v = node.value
                if isinstance(v, ast.Constant) and isinstance(v.value, str):
                    sub_imports.append(v.value)
                elif isinstance(v, ast.List):
                    for e in v.elts:
                        if isinstance(e, ast.Constant) and isinstance(e.value, str):
                            sub_imports.append(e.value)
            elif isinstance(node, ast.Import):
                for a in node.names:
                    if a.name != 'tkv_import_hook':
                        sub_imports.append((a.asname or a.name).split('.')[0])
            elif isinstance(node, ast.ImportFrom) and node.module:
                sub_imports.append(node.module.split('.')[0])
        out |= _collect_imported_top_names(imp_path, sub_imports, _depth + 1, _visited)
    return out


def _shallow_import_names(tree):
    """Ten module import o cap top-level (nhe, chi phuc vu R11 skip) -
    mirror tap hop ma vong lap _parse_program_ast thu thap (khong thay
    the vong lap do)."""
    names = []
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and \
                node.targets[0].id == '__tkv_import__':
            v = node.value
            if isinstance(v, ast.Constant) and isinstance(v.value, str):
                names.append(v.value)
            elif isinstance(v, ast.List):
                for e in v.elts:
                    if isinstance(e, ast.Constant) and isinstance(e.value, str):
                        names.append(e.value)
        elif isinstance(node, ast.Import):
            for a in node.names:
                if a.name != 'tkv_import_hook':
                    names.append(a.name.split('.')[0])
        elif isinstance(node, ast.ImportFrom) and node.module:
            names.append(node.module.split('.')[0])
    return names


def _module_skip_names(tree):
    """Ten cap module doc trong ham la hop le ma khong can gan trong ham:
    hang so, ham/class, module import, ten extern (method/pinvoke/class
    tu pragma - dang ky dong SAU luc parse)."""
    names = set()
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            names.add(node.name)
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name):
            tname = node.targets[0].id
            names.add(tname)
            # Ten extern/class that nam TRONG value cua pragma.
            if tname in ('__tkv_extern_method__', '__tkv_extern_pinvoke__',
                         '__tkv_extern_class__', '__tkv_struct__') and isinstance(node.value, ast.List):
                for elt in node.value.elts:
                    if isinstance(elt, ast.Dict):
                        for k, v in zip(elt.keys, elt.values):
                            if isinstance(k, ast.Constant) and k.value == 'name' and \
                                    isinstance(v, ast.Constant) and isinstance(v.value, str):
                                names.add(v.value)
        elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
            names.add(node.target.id)
        elif isinstance(node, ast.Import):
            for a in node.names:
                names.add(a.asname or a.name.split('.')[0])
        elif isinstance(node, ast.ImportFrom):
            for a in node.names:
                if a.name != '*':
                    names.add(a.asname or a.name)
    return names


def _check_use_before_def(func_name, func_node, skip_names=None, inherited=None):
    """R11 (2026-09-22, D3): bien doc TRUOC khi gan trong CUNG ham -> loi
    compile ON AO thay vi chay voi gia tri mac dinh 0/null am tham
    (truoc day 'if x == 1: ...; x = 1' van build+run, x ngam la 0).

    Phan tich definite-assignment don gian tren ast THAT (file .tkv la
    Python hop le): duyet statements theo thu tu, tap 'assigned' truyen
    xuong cac block. Gop (merge) CHI o 2 cho chac chan: if/else (giao 2
    nhanh) va try (giao body + MOI handler) + finally (luon chay). Vong
    lap (for/while): body DUOC GOP xuoi (R3, 2026-09-24) - bien gan trong
    body van nhin thay SAU loop, mirror ngu nghia codegen cu (local ton
    tai sau loop, doc default 0/null neu loop khong chay lan nao). Bao 2 dang:
    (a) forward-ref: ten DA DUOC gan o dau do trong ham nhung doc truoc
        (chac chan bug - khong false-positive).
    (b) never-resolved: ten khong gan o dau, khong phai param/global/
        hang module/ham top-level/builtin/extern (bao thay cho KeyError
        traceback xau xi cua mach suy kieu; message noi ro de phan biet).
    Ham long/lambda: kiem tra RIENG voi seeds thua huong (lexical scope -
    doc bien ngoai gan muon van hop le vi than ham chay sau); than
    lambda khong soat (don gian, tranh bao oan).
    """
    stored = set()
    for n in ast.walk(func_node):
        if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Store):
            stored.add(n.id)
        elif isinstance(n, ast.arg):
            stored.add(n.arg)
        elif isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
            if n is not func_node:
                stored.add(n.name)
        elif isinstance(n, (ast.Import,)):
            for a in n.names:
                stored.add(a.asname or a.name.split('.')[0])
        elif isinstance(n, ast.ImportFrom):
            for a in n.names:
                if a.name != '*':
                    stored.add(a.asname or a.name)
    # ast.walk tim Store ca trong lambda/comprehension long - cac ten do
    # co the chi la local-ben-trong, NHUNG van tinh vao 'stored' de tranh
    # false-positive (chi lam giam phat hien, khong bao gio bao oan).
    assigned = set(inherited or ())
    for a in func_node.args.args:
        assigned.add(a.arg)
    if func_node.args.vararg:
        assigned.add(func_node.args.vararg.arg)
    if func_node.args.kwarg:
        assigned.add(func_node.args.kwarg.arg)
    for a in func_node.args.kwonlyargs:
        assigned.add(a.arg)
    skip_names = set(skip_names or ())
    # Ten o vi tri GOI (ten ham/builtin/macro/cau lenh) thuoc khong gian
    # ten RIENG (mach goi ham tu validate) - khong phai bien: 'check(...)',
    # 'Counter(...)', 'seed(1)', 'np.zeros(...)' (lay ca root attribute).
    for n in ast.walk(func_node):
        if isinstance(n, ast.Call):
            for m in ast.walk(n.func):
                if isinstance(m, ast.Name):
                    skip_names.add(m.id)

    def _target_names(t):
        out = []
        for n in ast.walk(t):
            if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Store):
                out.append(n.id)
        return out

    def _block_diverges(stmts):
        # True neu block CHAC CHAN khong roi xuong cau lenh tiep theo (moi
        # duong deu return/raise/break/continue) - dung de gop assigned
        # dung khi 1 nhanh divergent (vd 'else: raise ...' thi bien gan o
        # cac nhanh if/elif van nhin thay sau, R3b 2026-09-24). Conservative:
        # chi bao True khi chac chan (if thieu else -> False; vong lap/try ->
        # False), khong bao gio sai theo huong bao oan.
        for s in stmts:
            if isinstance(s, (ast.Return, ast.Raise, ast.Break, ast.Continue)):
                return True
            if isinstance(s, ast.If):
                if s.orelse and _block_diverges(s.body) and _block_diverges(s.orelse):
                    return True
        return False

    def _err(name, lineno, never):
        if never:
            raise TranspileError(
                f"ham '{func_name}': bien '{name}' chua duoc khai bao (dong {lineno}) - "
                f"khong phai tham so, bien local, hang so module, ham top-level hay builtin. "
                f"Kiem tra ten bien (typo?) hoac gan gia tri truoc khi dung.")
        raise TranspileError(
            f"ham '{func_name}': bien '{name}' duoc dung truoc khi gan (dong {lineno}) - "
            f"compiler cu tu gan gia tri mac dinh 0/null am tham. Gan bien truoc khi dung.")

    def _is_dunder(name):
        return len(name) > 4 and name.startswith('__') and name.endswith('__')

    def _expr(e):
        # Doc bieu thuc theo thu tu danh gia (gan don: NamedExpr value
        # truoc, target sau; lambda: defaults truoc, than bo qua).
        if e is None:
            return
        if isinstance(e, ast.Name):
            if isinstance(e.ctx, ast.Load):
                if e.id not in assigned and e.id not in skip_names and not _is_dunder(e.id):
                    if e.id in stored:
                        _err(e.id, getattr(e, 'lineno', '?'), False)
                    else:
                        _err(e.id, getattr(e, 'lineno', '?'), True)
            elif isinstance(e.ctx, ast.Store):
                assigned.add(e.id)
            return
        if isinstance(e, ast.NamedExpr):
            _expr(e.value)
            assigned.add(e.target.id)
            return
        if isinstance(e, ast.Lambda):
            for d in e.args.defaults:
                _expr(d)
            for d in e.args.kw_defaults:
                _expr(d)
            return  # than lambda chay muon - khong soat
        if isinstance(e, (ast.ListComp, ast.SetComp, ast.GeneratorExp, ast.DictComp)):
            for gen in e.generators:
                _expr(gen.iter)
                for t in _target_names(gen.target):
                    assigned.add(t)
                for cond in gen.ifs:
                    _expr(cond)
            if isinstance(e, ast.DictComp):
                _expr(e.key)
                _expr(e.value)
            else:
                _expr(e.elt)
            return
        for child in ast.iter_child_nodes(e):
            if isinstance(child, ast.expr):
                _expr(child)

    def _block(stmts):
        for s in stmts:
            _stmt(s)

    def _stmt(s):
        if isinstance(s, (ast.FunctionDef, ast.AsyncFunctionDef)):
            for d in s.args.defaults:
                _expr(d)
            for d in s.args.kw_defaults:
                _expr(d)
            # Decorator o day CHI duoc la ten ham top-level (validate rieng
            # boi mach decorator) - khong soat nhu bien (tranh bao oan).
            assigned.add(s.name)
            # Kiem tra than ham long voi seeds thua huong (lexical scope).
            _check_use_before_def(f"{func_name}.{s.name}", s, skip_names,
                                  inherited=(stored | assigned | (inherited or frozenset())))
            return
        if isinstance(s, ast.ClassDef):
            for dec in s.decorator_list:
                _expr(dec)
            for b in s.bases:
                _expr(b)
            assigned.add(s.name)
            return
        if isinstance(s, ast.Return):
            _expr(s.value)
            return
        if isinstance(s, ast.Assign):
            _expr(s.value)
            for t in s.targets:
                _expr(t)  # _expr Name-Store tu add (dung thu tu targets)
            return
        if isinstance(s, ast.AnnAssign):
            if s.value is not None:
                _expr(s.value)
                _expr(s.target)
            return  # khong value -> khong binding runtime, khong add
        if isinstance(s, ast.AugAssign):
            # 'x += e' vua doc vua ghi x: kiem tra doc truoc.
            if isinstance(s.target, ast.Name):
                t = s.target
                _expr(ast.Name(id=t.id, ctx=ast.Load(), lineno=t.lineno,
                               col_offset=t.col_offset))
            else:
                _expr(s.target)
            _expr(s.value)
            return
        if isinstance(s, ast.Expr):
            _expr(s.value)
            return
        if isinstance(s, ast.If):
            _expr(s.test)
            saved = set(assigned)
            _block(s.body)
            after_body = set(assigned)
            body_div = _block_diverges(s.body)
            assigned.clear()
            assigned.update(saved)
            _block(s.orelse)
            after_else = set(assigned)
            else_div = _block_diverges(s.orelse)
            assigned.clear()
            assigned.update(saved)
            # R3b (2026-09-24): nhanh divergent (return/raise - vd 'else:
            # raise ValueError') khong roi xuong -> gop tu nhanh CON LAI,
            # khong giao (giao voi nhanh divergent se xoa oan bien gan o
            # nhanh kia, vd 'b0' gan o MOI nhanh if/elif + else-raise).
            if not s.orelse:
                pass  # co the khong vao nhanh if -> khong gop
            elif body_div and else_div:
                pass  # khong toi duoc (giu saved, bao thu)
            elif body_div:
                assigned.update(after_else)
            elif else_div:
                assigned.update(after_body)
            else:
                assigned.update(after_body & after_else)  # ca 2 nhanh gan
            return
        if isinstance(s, ast.While):
            _expr(s.test)
            # R3: body duoc gop xuoi (khong reset ve saved) - bien gan
            # trong body nhin thay sau loop (mirror codegen cu). Test van
            # kiem TRUOC body (lan dau chua chay body).
            _block(s.body)
            _block(s.orelse)
            return
        if isinstance(s, (ast.For, ast.AsyncFor)):
            _expr(s.iter)
            for t in _target_names(s.target):
                assigned.add(t)
            # R3: nhu While (bien gan trong body nhin thay sau loop).
            _block(s.body)
            _block(s.orelse)
            return
        if isinstance(s, ast.With):
            for item in s.items:
                _expr(item.context_expr)
                if item.optional_vars:
                    for t in _target_names(item.optional_vars):
                        assigned.add(t)
            _block(s.body)  # with-body luon chay (neu vao duoc) -> gop tiep
            return
        if isinstance(s, ast.Try):
            saved = set(assigned)
            _block(s.body)
            body_set = set(assigned)
            # orelse chay sau body (khong exception) -> thay body assigns.
            assigned.clear()
            assigned.update(body_set)
            _block(s.orelse)
            orelse_new = set(assigned) - body_set
            handler_sets = []
            for h in s.handlers:
                assigned.clear()
                assigned.update(saved)
                if h.type:
                    _expr(h.type)
                if h.name:
                    assigned.add(h.name)
                _block(h.body)
                handler_sets.append(set(assigned))
            # Gop: (giao body + MOI handler) + (moi tu orelse) - truong hop
            # pho bien 'try: x = int(s) except: x = 0' duoc gop dung.
            merged = set(body_set)
            for hs in handler_sets:
                merged &= hs
            merged |= orelse_new
            assigned.clear()
            assigned.update(saved)
            assigned.update(merged)
            saved2 = set(assigned)
            _block(s.finalbody)  # finally luon chay -> gop tiep
            return
        if isinstance(s, ast.Raise):
            _expr(s.exc)
            _expr(s.cause)
            return
        if isinstance(s, ast.Assert):
            _expr(s.test)
            _expr(s.msg)
            return
        if isinstance(s, (ast.Import, ast.ImportFrom)):
            for a in s.names:
                if a.name == '*':
                    continue
                assigned.add(a.asname or (a.name.split('.')[0] if isinstance(s, ast.Import) else a.name))
            return
        if isinstance(s, ast.Global):
            assigned.update(s.names)
            return
        if isinstance(s, ast.Nonlocal):
            assigned.update(s.names)
            return
        if isinstance(s, ast.Delete):
            return
        if isinstance(s, (ast.Pass, ast.Break, ast.Continue)):
            return
        # Match/case (linter gioi han pattern hang so/wildcard - khong
        # binding moi): soat scrutinee + cac body voi tap hien tai.
        if hasattr(ast, 'Match') and isinstance(s, ast.Match):
            _expr(s.subject)
            for case in s.cases:
                saved = set(assigned)
                _block(case.body)
                assigned.clear()
                assigned.update(saved)
            return
        for child in ast.iter_child_nodes(s):
            if isinstance(child, ast.expr):
                _expr(child)
            elif isinstance(child, ast.stmt):
                _stmt(child)

    _block(func_node.body)


def _parse_program_ast(source_text, source_path=None, extra_r11_skip=None):
    """Parse THUAN 1 file nguon TokenVector (`.tkv`) THAT - KHONG doc file
    nao khac, KHONG resolve import - chi tra ve THANG PHAN NOI DUNG cua
    CHINH file nay: (record_defs, record_methods_raw, record_bases, pairs,
    import_names). record_bases (B1, 2026-07-29): dict ten-record ->
    ten-class-cha (hoac None neu khong ke thua) - xem _extract_record_def.
    import_names: list ten module (KHONG co duoi '.tkv') lay tu bien
    module-level '__tkv_import__' (xem extract_program_file - khoang
    trong ngon ngu #3, "import module TokenVector khac"). 'import X'/
    'from X import Y' THAT (cu phap Python chuan) van duoc BO QUA nhu
    truoc gio (chi de file chay duoc duoi CPython that, vd numpy/helper
    module rieng cua File I/O) - '__tkv_import__' la co che RIENG, MOI,
    danh cho cross-file GIUA CAC FILE .tkv (khac hoan toan y nghia)."""
    tree = ast.parse(source_text)
    source_lines = source_text.split('\n')
    record_defs = {}
    record_methods_raw = {}
    # 2026-09-25: sig_line cua '__init__' tung class - nguon kieu THAT cho
    # field khai bao dtype 'inferred' (xem _resolve_inferred_record_fields).
    record_init_sigs = {}
    record_bases = {}
    module_consts = {}
    module_globals = {}
    record_interfaces = {}
    interface_defs = {}
    pairs = []
    # Task 3/5 (duck-typing-inference, 2026-08-17): dict ten-ham-top-level ->
    # ast.FunctionDef/AsyncFunctionDef GOC (CHI gom ham co >=1 tham so thieu
    # annotation, tuc se thanh dtype 'inferred'). Luu AST GOC (chua goi
    # collect_inferred_constraints() ngay o day) vi tai DAY record_defs CHUA
    # day du (vong lap tree.body con dang chay, record khai bao SAU chua
    # thay) - _params_with_defaults's dtype 'inferred' khong can record_names
    # de PARSE, nhung 1 tham so KHAC (co annotation) cua CUNG ham co the
    # tham chieu record khai bao sau -> parse_typed_signature() se that bai
    # neu goi som. Doi den luc sig_body_pairs duoc xay (compile_tkv_cli/
    # _transpile_extracted, sau khi TOAN BO file/import da duyet xong,
    # record_defs day du) moi parse Signature that va goi
    # collect_inferred_constraints(), gan ket qua vao sig.inferred_constraints
    # - gan CUNG kieu voi module_consts/module_globals (dict cap-module
    # threading xuyen extract_program/extract_program_file/compile_tkv_cli).
    inferred_ast_nodes_by_func = {}
    import_names = []
    extern_assemblies = []
    extern_methods = []
    extern_pinvokes = []
    extern_classes = []
    struct_defs = {}  # R1 (2026-09-22, __tkv_struct__): ten -> {'fields': [...]}
    com_classes = []  # F4c (2026-09-23, __tkv_com_class__): list decl phoi record ra COM
    # Decorator tuy bien tren ham top-level (Phase 4, 2026-08-11, xem
    # _expand_custom_decorator): pre-pass tim MOI ham top-level duoc dung
    # lam '@deco' - ham do la 1 TEMPLATE thuan tuy (macro luc bien dich),
    # KHONG duoc tu no bien dich thanh 1 ham binh thuong (chu ky cua no
    # dung 'func(...)->...' - shape ma parse_signature CHUA ho tro cho
    # tham so/return ham THAT, se bao loi neu di qua duong thuong).
    top_level_funcs = {n.name: n for n in tree.body if isinstance(n, ast.FunctionDef)}
    # R11 (D3): tap ten duoc phep doc trong ham ma khong can gan trong ham
    # (hang module/ham top-level/extern/builtin) - tinh 1 lan cho ca file.
    try:
        _r11_builtin_names = set(EXPR_BUILTIN_CODEGEN)
    except NameError:
        _r11_builtin_names = set()
    r11_skip = _module_skip_names(tree) | _R11_EXTRA_SKIP | _r11_builtin_names
    # R2 (2026-09-24): hop nhat skip ke thua tu file cha (toan cuc merge -
    # ten cua MOI module trong closure import cua file GOC deu nhin thay
    # duoc tu file nay, ke ca khong import truc tiep).
    if extra_r11_skip:
        r11_skip |= set(extra_r11_skip)
    # R11 (D3): ten tu file import (gop pham vi luc merge) - can
    # source_path de locate file; khong co thi bo qua (mach import hien
    # co bao loi that sau, khong false-positive o day).
    if source_path is not None:
        try:
            r11_skip |= _collect_imported_top_names(source_path, _shallow_import_names(tree))
        except Exception:
            pass
    decorator_template_names = set()
    for n in tree.body:
        if isinstance(n, ast.FunctionDef) and len(n.decorator_list) == 1 and \
                isinstance(n.decorator_list[0], ast.Name) and \
                n.decorator_list[0].id in top_level_funcs:
            decorator_template_names.add(n.decorator_list[0].id)
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            if isinstance(node, ast.FunctionDef) and node.name in decorator_template_names:
                continue  # chi la template cho 1 '@deco' khac, khong tu no la 1 ham
            if node.decorator_list:
                if isinstance(node, ast.FunctionDef) and len(node.decorator_list) == 1 and \
                        isinstance(node.decorator_list[0], ast.Name) and \
                        node.decorator_list[0].id in top_level_funcs:
                    deco_node = top_level_funcs[node.decorator_list[0].id]
                    hidden_pair, public_pair = _expand_custom_decorator(node, deco_node, source_lines)
                    pairs.append(hidden_pair)
                    pairs.append(public_pair)
                    continue
                raise TranspileError(
                    f"ham '{node.name}': decorator khong duoc ho tro. Hien CHI ho tro '@deco' "
                    f"khi 'deco' la 1 ham top-level KHAC duoc khai bao trong CUNG file, dang "
                    f"'def deco(f: \"func(...)->...\") -> \"func(...)->...\":' voi than gom DUNG "
                    f"1 'def wrapper(...):' long + 'return wrapper' (xem _expand_custom_decorator)")
            # ast.AsyncFunctionDef (Phase 4, 2026-08-11) - 'async def' o
            # top-level, xem _extract_signature_line ('async ' prefix).
            # 'async def' lam record method (Task 3, 2026-08-12): xem
            # _extract_record_def (nhan ca ast.AsyncFunctionDef) va
            # _extract_record_method_sig_line ('async ' prefix).
            sig_line = _extract_signature_line(node, allow_varargs=True, allow_inferred=True)
            if any(a.annotation is None for a in node.args.args):
                # Task 3/5 (duck-typing-inference): giu lai AST GOC de goi
                # collect_inferred_constraints() sau, xem ghi chu
                # inferred_ast_nodes_by_func o tren.
                inferred_ast_nodes_by_func[node.name] = node
            hoisted = []
            body_lines = _body_source_lines(source_lines, node, hoisted=hoisted)
            # R11 (2026-09-22, D3): bien doc truoc khi gan -> loi compile
            # ON AO (thay vi chay voi gia tri mac dinh am tham).
            _check_use_before_def(node.name, node, r11_skip)
            pairs.append((sig_line, body_lines, node.body[0].lineno))
            # 'def' long khong bat bien nao da duoc nang len top-level -
            # them vao chuong trinh nhu ham binh thuong.
            pairs.extend(hoisted)
        elif isinstance(node, ast.ClassDef):
            if node.name in record_defs or node.name in interface_defs:
                raise TranspileError(f"trung ten class '{node.name}'")
            is_interface = any(isinstance(d, ast.Name) and d.id == 'interface' for d in node.decorator_list)
            if is_interface:
                # Phase C.4 (2026-07-29): '@interface' - mixin CIL interface
                # (huong F), KHONG phai 1 record (khong field/state).
                interface_defs[node.name] = _extract_interface_def(node, source_lines)
                continue
            fields, methods_raw, base_name, base_info, interface_names, init_sigs = _extract_record_def(
                node, source_lines, known_records=record_defs, known_interfaces=interface_defs)
            record_defs[node.name] = fields
            record_methods_raw[node.name] = methods_raw
            record_init_sigs.update(init_sigs)
            record_bases[node.name] = base_info
            record_interfaces[node.name] = interface_names
            # R11 (2026-09-22, D3): nhu ham top-level, ap cho moi method.
            for _m in node.body:
                if isinstance(_m, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    _check_use_before_def(f"{node.name}.{_m.name}", _m, r11_skip)
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and node.targets[0].id == '__tkv_import__':
            # Co che IMPORT RIENG cua TokenVector (khoang trong ngon ngu #3):
            # 'import' THAT cua Python KHONG dung duoc de tham chieu 1 file
            # .tkv khac (Python's import machinery chi tim '.py', khong
            # biet '.tkv') - dung 1 phep GAN chuoi/list-chuoi HOP LE 100%
            # (chay duoc that duoi CPython, khong lam gi luc runtime, giong
            # tinh than annotation-la-string da dung xuyen suot du an) lam
            # PRAGMA rieng cho compiler doc.
            v = node.value
            if isinstance(v, ast.Constant) and isinstance(v.value, str):
                import_names = [v.value]
            elif isinstance(v, ast.List) and v.elts and \
                    all(isinstance(e, ast.Constant) and isinstance(e.value, str) for e in v.elts):
                import_names = [e.value for e in v.elts]
            else:
                raise TranspileError(
                    "__tkv_import__ phai la 1 chuoi hoac list chuoi (ten file .tkv KHONG co "
                    "duoi '.tkv', vd __tkv_import__ = 'shapes' hoac ['shapes', 'utils'])")
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and node.targets[0].id == '__tkv_extern_assembly__':
            # Co che MO RONG (Wave 3, 2026-07-29, xem project-tokenvector-
            # wave2-status memory - "package ecosystem"): khai bao THEM 1
            # hoac nhieu '.assembly extern' vao IL sinh ra, de cac stdlib
            # function MOI (vd http_get dung [System]) hoac tuong lai
            # (DB/thu vien .NET khac) co the tham chieu assembly ngoai
            # mscorlib/System/System.Core da co san CUNG SAN, KHONG can sua
            # tay phan header IL trong compile_tkv_cli() moi lan them 1
            # thu vien moi. Moi phan tu: 1 chuoi ten (dung publickeytoken/
            # version CHUAN cua .NET Framework GAC, da XAC MINH THAT qua
            # ilasm.exe - System.Xml.XmlConvert.EncodeName() chay dung voi
            # CUNG 1 token 'B7 7A 5C 56 19 34 E0 89' + ver 4:0:0:0 giong
            # mscorlib/System/System.Core), HOAC 1 tuple 3 phan tu (ten,
            # publickeytoken_hex_or_None, version_or_None) cho assembly
            # RIENG/thu vien ngoai KHONG dung token chuan .NET Framework
            # (vd 1 .dll private dat canh file .exe, publickeytoken=None
            # nghia la KHONG ky ten manh - .assembly extern bare)."""
            v = node.value
            elts = v.elts if isinstance(v, ast.List) else [v]
            for e in elts:
                if isinstance(e, ast.Constant) and isinstance(e.value, str):
                    if ',' in e.value:
                        # F-3 remainder (2026-09-23): full identity string ngay
                        # trong pragma assembly (vd "R3Test, Version=0.0.0.0,
                        # Culture=neutral, PublicKeyToken=null") - parse ra
                        # (ten, token, version) that thay vi de ten tho co dau
                        # phay rot xuong IL gay loi assemble (truoc day).
                        _sn, _tk, _ver = _parse_full_assembly_identity(
                            e.value, '__tkv_extern_assembly__')
                        extern_assemblies.append((_sn, _tk, _ver))
                    else:
                        extern_assemblies.append((e.value, 'DEFAULT', 'DEFAULT'))
                elif isinstance(e, ast.Tuple) and len(e.elts) == 3:
                    parts = []
                    for sub in e.elts:
                        if isinstance(sub, ast.Constant) and (sub.value is None or isinstance(sub.value, str)):
                            parts.append(sub.value)
                        else:
                            raise TranspileError(
                                "__tkv_extern_assembly__ tuple 3 phan tu phai la (ten:str, "
                                "publickeytoken:str_hoac_None, version:str_hoac_None)")
                    extern_assemblies.append(tuple(parts))
                else:
                    raise TranspileError(
                        "__tkv_extern_assembly__ phai la 1 chuoi/list chuoi (ten assembly .NET "
                        "Framework GAC chuan, vd 'System.Xml') hoac tuple 3 phan tu (ten, "
                        "publickeytoken_hex_or_None, version_or_None) cho assembly rieng")
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and node.targets[0].id == '__tkv_extern_method__':
            # Pragma khai bao goi 1 static method .NET NGOAI (Task 2,
            # 2026-08-14 - xem docs/superpowers/plans/2026-08-14-extern-
            # method.md): moi phan tu la 1 dict-literal shape co dinh, chi
            # PARSE SHAPE o day (validate nghiep vu + dang ky dong builtin
            # la Task 3, trong compile_tkv_cli, sau khi co ca
            # extern_assemblies de doi chieu 'assembly' da khai bao chua).
            v = node.value
            if not isinstance(v, ast.List):
                raise TranspileError("__tkv_extern_method__ phai la 1 list cac dict")
            for elt in v.elts:
                extern_methods.append(_parse_extern_method_dict_literal(elt))
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and node.targets[0].id == '__tkv_extern_pinvoke__':
            # Pragma khai bao goi 1 ham trong DLL native qua P/Invoke
            # (Phase 2, 2026-08-17 - xem docs/superpowers/plans/2026-08-17-
            # extern-pinvoke.md): moi phan tu la 1 dict-literal shape co
            # dinh, chi PARSE SHAPE o day (validate nghiep vu + sinh
            # pinvokeimpl + dang ky dong builtin la Task 3, trong
            # compile_tkv_cli).
            v = node.value
            if not isinstance(v, ast.List):
                raise TranspileError("__tkv_extern_pinvoke__ phai la 1 list cac dict")
            for elt in v.elts:
                extern_pinvokes.append(_parse_extern_pinvoke_dict_literal(elt))
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and node.targets[0].id == '__tkv_extern_class__':
            # Pragma khai bao 1 handle-type .NET NGOAI (ctor + methods)
            # (Task 1, 2026-08-18 - xem docs/superpowers/plans/extern-class):
            # moi phan tu la 1 dict-literal shape co dinh, chi PARSE SHAPE o
            # day (validate nghiep vu + codegen la cac Task sau, giong het
            # cach lam voi __tkv_extern_method__/__tkv_extern_pinvoke__).
            v = node.value
            if not isinstance(v, ast.List):
                raise TranspileError("__tkv_extern_class__ phai la 1 list cac dict")
            for elt in v.elts:
                extern_classes.append(_parse_extern_class_dict_literal(elt))
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and node.targets[0].id == '__tkv_struct__':
            # R1 (2026-09-22): pragma khai bao struct blittable cho pinvoke
            # 2 chieu (mo H.264 decode, HarfBuzz full, text-measure chuan).
            # Moi phan tu la 1 dict {'name', 'fields'} - chi PARSE SHAPE o
            # day (validate nghiep vu + codegen o compile_tkv_cli).
            v = node.value
            if not isinstance(v, ast.List):
                raise TranspileError("__tkv_struct__ phai la 1 list cac dict {'name', 'fields'}")
            for elt in v.elts:
                _sd = _parse_struct_dict_literal(elt)
                if _sd['name'] in struct_defs:
                    raise TranspileError(
                        f"__tkv_struct__: struct {_sd['name']!r} khai bao TRUNG LAP")
                struct_defs[_sd['name']] = {'fields': _sd['fields']}
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and node.targets[0].id == '__tkv_vtable__':
            # F4a (2026-09-23): pragma khai bao goi ham qua con tro vtable
            # bang 'calli' (COM raw/callback native). Moi phan tu la 1
            # dict-literal shape co dinh, chi PARSE SHAPE o day. DI CHUNG
            # list 'extern_pinvokes' voi marker 'kind'='vtable' (KHONG sua
            # tuple extract/merge - vong dang ky re nhanh theo marker) -
            # dedup trung ten am tham van ON AO qua register_expr_builtin
            # giong het pinvoke (ValueError ro rang).
            v = node.value
            if not isinstance(v, ast.List):
                raise TranspileError("__tkv_vtable__ phai la 1 list cac dict")
            for elt in v.elts:
                extern_pinvokes.append(_parse_vtable_dict_literal(elt))
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and node.targets[0].id == '__tkv_callback__':
            # F4b (2026-09-23): pragma khai bao delegate non-generic cho
            # callback native. DI CHUNG list 'extern_pinvokes' voi marker
            # 'kind'='callback' (ly do nhu __tkv_vtable__ - khong sua tuple).
            v = node.value
            if not isinstance(v, ast.List):
                raise TranspileError("__tkv_callback__ phai la 1 list cac dict")
            for elt in v.elts:
                extern_pinvokes.append(_parse_callback_dict_literal(elt))
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and node.targets[0].id == '__tkv_com_class__':
            # F4c (2026-09-23): pragma phoi 1 record ra COM (CCW). Moi phan
            # tu la 1 dict-literal shape co dinh, chi PARSE SHAPE o day
            # (validate nghiep vu can record_defs/record_methods nen lam o
            # compile_tkv_cli, giong __tkv_struct__).
            v = node.value
            if not isinstance(v, ast.List):
                raise TranspileError("__tkv_com_class__ phai la 1 list cac dict")
            for elt in v.elts:
                _cd = _parse_com_class_dict_literal(elt)
                if any(d['record'] == _cd['record'] or d['interface'] == _cd['interface']
                       for d in com_classes):
                    raise TranspileError(
                        f"__tkv_com_class__: record {_cd['record']!r} hoac interface "
                        f"{_cd['interface']!r} khai bao TRUNG LAP")
                com_classes.append(_cd)
        elif isinstance(node, ast.Import):
            # 'import X' (Phase 6.2, 2026-08-11) - port TU cay .tkv tu-host
            # (da co san, DA chay that - xem _find_module_path/
            # extract_program_file): coi MOI 'import X'/'from X import ...'
            # nhu 1 module TokenVector can resolve/gop (giong __tkv_import__),
            # KHONG con phan biet "thu vien ngoai" - TokenVector khong co
            # khai niem goi qua 'X.ten()' (qualified access), cac thu vien
            # chuan (os/re/random/...) deu di qua builtin ham thang
            # (os_list_files/re_findall/...), KHONG qua 'import os'.
            # Ngoai le duy nhat: 'tkv_import_hook' (marker rieng, giong
            # '__tkv_import__') - dong nay chi CHAY THAT duoi CPython de
            # dang ky FileFinder path_hook cho '.tkv' (xem tkv_import_hook.py)
            # khi file can 'from X import ...' HOAT DONG dung luc chay
            # `python file.tkv` truc tiep - KHONG phai 1 module TokenVector.
            for alias in node.names:
                if alias.name == 'tkv_import_hook':
                    continue
                import_names.append(alias.name)
            continue
        elif isinstance(node, ast.ImportFrom):
            if node.module:
                import_names.append(node.module)
            continue
        elif isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) and \
                isinstance(node.value.value, str):
            continue  # module docstring
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and node.targets[0].id == 'interface':
            # '@interface' (Phase C.4, 2026-07-29) KHONG phai decorator co
            # san cua Python that - file .tkv PHAI TU dinh nghia 1 shim
            # (vd 'interface = lambda cls: cls') de van CHAY DUOC that duoi
            # CPython (giong tinh than '.tkv van la Python that' xuyen suot
            # du an) - compiler CHI can biet TEN 'interface' xuat hien o
            # decorator_list cua 1 class, KHONG quan tam GIA TRI THAT cua
            # no, nen bo qua HOAN TOAN dong gan nay (khong yeu cau dang
            # lambda cu the, chi can 1 TEN don gian giong '__tkv_import__').
            continue
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and \
                isinstance(node.targets[0], ast.Name) and isinstance(node.value, ast.Call) and \
                ((isinstance(node.value.func, ast.Name) and node.value.func.id == 'namedtuple') or
                 (isinstance(node.value.func, ast.Attribute) and node.value.func.attr == 'namedtuple')):
            # collections.namedtuple (Phase 3.2, 2026-08-11): desugar THANH
            # 1 record binh thuong NGAY O TANG PARSE - tai su dung 100%
            # pipeline record co san (gen_record_types/record_feature.py)
            # ben duoi, KHONG runtime wrapper (xem _extract_namedtuple_def).
            record_name, fields = _extract_namedtuple_def(node)
            if record_name in record_defs or record_name in interface_defs:
                raise TranspileError(f"trung ten class '{record_name}' (namedtuple)")
            record_defs[record_name] = fields
            record_methods_raw[record_name] = []
            record_bases[record_name] = None
            record_interfaces[record_name] = []
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and                 isinstance(node.targets[0], ast.Name) and                 isinstance(node.value, ast.Constant) and                 isinstance(node.value.value, (int, float, str)) and                 not isinstance(node.value.value, bool):
            # HANG SO cap module (2026-08-03): 'MAX = 10' / 'NAME = "x"'.
            # CHI nhan HANG so/chuoi - KHONG phai bien toan cuc that (khong
            # gan lai duoc, khong co o nho): moi noi dung se duoc thay bang
            # chinh hang so do luc bien dich. Bien toan cuc GHI DUOC la 1
            # thu khac han (can .field static + ngu nghia doc/ghi xuyen
            # ham) - chua lam, va cach viet quen thuoc nhat trong script
            # la hang so.
            module_consts[node.targets[0].id] = node.value.value
        elif isinstance(node, ast.AnnAssign) and node.value is not None and \
                isinstance(node.target, ast.Name):
            # BIEN toan cuc GHI DUOC ('global', 2026-08-11): 'counter: "i32" = 0'
            # o cap module - PHAN BIET voi hang so o tren qua AnnAssign (co
            # annotation kieu) thay vi Assign thuong. Sinh 1 '.field private
            # static' THAT (xem gen_il_program/build_generic_main) - doc/ghi
            # xuyen ham qua tu khoa 'global x' trong than ham (xem
            # il_codegen.py's _extract_global_decls). Thu hep pham vi co y:
            # CHI nhan gia tri khoi tao la 1 hang so/chuoi don gian (giong
            # module_consts), KHONG bieu thuc phuc tap.
            gname = node.target.id
            if gname in module_consts:
                raise TranspileError(
                    f"'{gname}' da khai bao la hang so module (Assign khong annotation) - "
                    f"khong the vua la hang so vua la bien global (AnnAssign)")
            gdtype = _annotation_to_type_str(node.annotation, f"bien module-level '{gname}'")
            if gdtype not in ('i32', 'i64', 'f32', 'f64', 'str'):
                raise TranspileError(
                    f"bien module-level '{gname}': 'global' hien CHI ho tro kieu vo huong "
                    f"(i32/i64/f32/f64/str), khong ho tro container/record")
            if not isinstance(node.value, ast.Constant) or isinstance(node.value.value, bool):
                raise TranspileError(
                    f"bien module-level '{gname}': gia tri khoi tao phai la 1 hang so/chuoi "
                    f"don gian (giong hang so module), khong phai bieu thuc")
            module_globals[gname] = (gdtype, node.value.value)
        else:
            raise TranspileError(
                f"Chi ho tro dinh nghia ham/class-record top-level, HANG SO cap module "
                f"(vd MAX = 10), bien global co kieu (vd 'counter: \"i32\" = 0'), "
                f"(va '__tkv_import__') trong "
                f"1 file TokenVector; gap {type(node).__name__} o dong {node.lineno} (bien "
                f"module-level khac/... chua ho tro)")
    if not pairs:
        raise TranspileError("File khong co ham top-level nao co annotation kieu DSL")

    # @property (Phase C.3, 2026-07-29): gom TEN property TOAN CHUONG TRINH
    # (moi record_methods_raw[*] hien la 4-tuple co is_property, xem
    # _extract_record_def) - PHAI lam SAU KHI het vong lap tren (property co
    # the khai bao o 1 class xuat hien SAU 1 ham/method dung no trong van
    # ban nguon), roi desugar 'obj.propname' -> 'obj.propname()' tren TOAN
    # BO body_lines (ham top-level LAN method record) TRUOC KHI tra ve -
    # tra record_methods_raw VE LAI dang 3-tuple cu (sig_line, body_lines,
    # is_static) de _build_record_methods/gen_record_types KHONG can doi gi.
    property_names = set()
    for methods_raw in record_methods_raw.values():
        for sig_line, _body_lines, _is_static, is_property in methods_raw:
            if is_property:
                m = re.match(r'^(\w+)\(', sig_line)
                if m:
                    property_names.add(m.group(1))

    if property_names:
        pairs[:] = [(sig_line, _desugar_property_reads(body_lines, property_names), start_line)
                    for sig_line, body_lines, start_line in pairs]
        for rname, methods_raw in record_methods_raw.items():
            record_methods_raw[rname] = [
                (sig_line, _desugar_property_reads(body_lines, property_names), is_static)
                for sig_line, body_lines, is_static, _is_property in methods_raw]
    else:
        for rname, methods_raw in record_methods_raw.items():
            record_methods_raw[rname] = [
                (sig_line, body_lines, is_static)
                for sig_line, body_lines, is_static, _is_property in methods_raw]

    _resolve_record_field_types(record_defs, extern_class_names={d['name'] for d in extern_classes})
    return (record_defs, record_methods_raw, record_bases, record_interfaces, interface_defs, pairs,
            import_names, extern_assemblies, extern_methods, extern_pinvokes, extern_classes, struct_defs,
            com_classes, module_consts, module_globals, inferred_ast_nodes_by_func, record_init_sigs)


# 2026-09-25: 'self.<field> = <rhs>' trong body method - dung cho suy kieu
# field dtype 'inferred' (xem _infer_inferred_fields_from_bodies).
_SELF_FIELD_ASSIGN_RE = re.compile(r'^\s*self\.(\w+)\s*=(?!=)\s*(.+?)\s*$')

# 'ten(' - loi goi/co truc (constructor record, ham top-level, ham cua stdlib).
_CALL_RHS_RE = re.compile(r'^(\w+)\s*\(')

# 'ten' - 1 bien trong method.
_BARE_RHS_RE = re.compile(r'^(\w+)$')

# 'local = <rhs>' - de truy nguoc bien cuc bo ve bieu thuc gan no.
_LOCAL_ASSIGN_RE = re.compile(r'^\s*(\w+)\s*=(?!=)\s*(.+?)\s*$')


def _func_return_type_of(sig_line):
    """'f(a: i64) -> Foo:' -> 'Foo' (hoac None). Doc bang regex tren
    sig_line THO (khong parse lai) - chi can TEN kieu tra ve de suy field."""
    m = re.search(r'\)\s*->\s*([^:]+):\s*$', sig_line)
    return m.group(1).strip() if m else None


def _rhs_type_of(rhs, record_names, extern_class_names, local_types, func_ret):
    """Kieu cua 1 ve phai gan 'self.<field> = <rhs>' - hoac None neu khong
    suy duoc. CHI xet 3 dang co the quyet dinh CHAC CHAN (2026-09-25):

      - 'Ten(...)'   : constructor cua 1 class da biet -> field kieu class
      - 'f(...)'     : ham TOP-LEVEL co kieu tra ve da biet
      - 'ten'        : bien cuc bo, truy nguoc ve bieu thuc gan no

    KHONG doan gi khi ve phai la bieu thuc tong hop (pho bien nhat trong
    code that) - de _resolve_inferred_record_fields() / loi ro rang lo
    phan con lai, thay vi sinh kieu sai."""
    rhs = rhs.strip()
    m_call = _CALL_RHS_RE.match(rhs)
    if m_call:
        callee = m_call.group(1)
        if callee in record_names:
            return TypeAnn(callee, 'record')
        if callee in extern_class_names:
            return TypeAnn(callee, 'extern_class')
        ret = func_ret.get(callee)
        if ret and ret in record_names:
            return TypeAnn(ret, 'record')
        if ret and ret in extern_class_names:
            return TypeAnn(ret, 'extern_class')
        return None
    m_bare = _BARE_RHS_RE.match(rhs)
    if m_bare:
        return local_types.get(m_bare.group(1))
    return None


def _infer_inferred_fields_from_bodies(record_defs, record_methods_raw, pairs,
                                       extern_class_names, record_names=None,
                                       record_init_sigs=None):
    """Suy kieu cho field khai bao dtype 'inferred' tu body method
    (2026-09-25) - chay trong _build_record_methods, SAU khi da gop record
    cua cac module import (nen 'record_names' da day du).

    Nguon suy: dong gan 'self.<field> = <rhs>'. 3 dang ve phai co the quyet
    dinh CHAC CHAN duoc xet o _rhs_type_of: constructor class, ham top-level
    co kieu tra ve, va bien cuc bo (truy nguoc ngan qua). Duoc vi du nhu
    'self.batcher = _db' voi '_db = DynamicBatcher(...)' trong
    tv/server/cont_batcher.tkv (DynamicBacker o tv/server/batcher.tkv -
    module KHAC, nen bat buoc chay sau khi gop import).

    Day la BUOC 2 cua 2 buoc; buoc 1 (_resolve_inferred_record_fields) lay
    kieu tu tham so __init__. Truong hop con lai sau ca 2 buoc van bao loi
    RO RANG - khong doan."""
    record_names = set(record_defs) if record_names is None else record_names
    func_ret = {}
    for entry in (pairs or []):
        sig_line = entry[0]
        m = _FUNC_NAME_RE.match(sig_line)
        if m:
            func_ret[m.group(1)] = _func_return_type_of(sig_line)
    for rname, fields in record_defs.items():
        if not any(isinstance(dt, str) and dt == INFERRED_DTYPE_MARKER
                   for _, dt in fields):
            continue
        targets = {fn for fn, dt in fields
                   if isinstance(dt, str) and dt == INFERRED_DTYPE_MARKER}
        found = {}
        # Body '__init__' XEM TRUOC body method thuong: field duoc gan trong
        # __init__ moi la nguon suy truc tiep nhat (vidu
        # 'self.batcher = _db' trong __init__ cua ContBatcher).
        bodies = []
        init_entry = (record_init_sigs or {}).get(rname)
        if init_entry and len(init_entry) > 1 and init_entry[1]:
            bodies.append(init_entry[1])
        for _sig_line, body_lines, _is_static in record_methods_raw.get(rname, []):
            bodies.append(body_lines)
        for body_lines in bodies:
            local_types = {}
            for raw in body_lines:
                m_self = _SELF_FIELD_ASSIGN_RE.match(raw)
                if m_self and m_self.group(1) in targets and m_self.group(1) not in found:
                    ta = _rhs_type_of(m_self.group(2), record_names,
                                      extern_class_names, local_types, func_ret)
                    if ta is not None:
                        found[m_self.group(1)] = ta
                    continue
                m_loc = _LOCAL_ASSIGN_RE.match(raw)
                if m_loc:
                    ta = _rhs_type_of(m_loc.group(2), record_names,
                                      extern_class_names, local_types, func_ret)
                    if ta is not None:
                        local_types[m_loc.group(1)] = ta
        if not found:
            continue
        record_defs[rname] = [(fn, found.get(fn, dt)) for fn, dt in fields]


def _resolve_deferred_record_field_types(record_defs, record_names,
                                         extern_class_names=frozenset()):
    """Giai field record con lai dang TEN CLASS chua ro kieu (2026-09-25).

    _resolve_record_field_types() (chay trong _parse_program_ast, TUNG file
    rieng) giu NGUYEN chuoi khi field tro toi 1 class o module KHAC -
    vi luc do `record_names` chi co class cua file dang parse. Ham nay
    chay SAU khi da GOP record cua moi module import, nen `record_names`
    da day du: doi chuoi thanh TypeAnn(ten, 'record').

    Neu van khong khop (gom ca typos - nguoi viet sai ten class) thi bao
    loi RO RANG, dung hon im lang bo qua de sinh IL sai."""
    for rname, fields in record_defs.items():
        resolved = []
        for fname, dtype in fields:
            if isinstance(dtype, str) and dtype not in DTYPES \
                    and _mentions_unknown_class(dtype, DTYPES):
                try:
                    ta = _parse_type_ann_str(dtype, record_names=record_names,
                                             extern_class_names=extern_class_names)
                except SyntaxError:
                    missing = sorted({i for i in _IDENT_RE.findall(dtype)
                                      if i not in DTYPES and i not in _CONTAINER_KEYWORDS
                                      and i not in record_names
                                      and i not in extern_class_names})
                    raise TranspileError(
                        f"class '{rname}' field '{fname}': dtype {dtype!r} tro toi class "
                        f"{missing} khong tim thay - chua khai bao trong file nay, trong module "
                        f"import nao, hay ten sai chinh xac?")
                resolved.append((fname, ta))
                continue
            resolved.append((fname, dtype))
        record_defs[rname] = resolved


def _resolve_record_field_types(record_defs, extern_class_names=frozenset()):
    """Doi kieu field KHONG vo huong tu VAN BAN sang TypeAnn, SAU KHI da
    biet du ten cac record trong file (2026-08-03, dot 1): field co the la
    1 container ('list[str]', 'dict[str,f64]'), 1 record khac ('Node'), hay
    container CUA record ('list[Node]') - ke ca khai bao SAU (tham chieu
    tien, vd 'class Node: next: "Node"'). Field vo huong GIU NGUYEN dang
    chuoi dtype nhu cu (khong doi dinh dang du lieu da co).
    extern_class_names (Task 2, extern-class, 2026-08-18): ten cac
    handle-type khai bao qua __tkv_extern_class__ trong CUNG file - chap
    nhan lam kieu field y het 1 record (thread xuong _parse_type_ann_str)."""
    record_names = set(record_defs)
    for rname, fields in record_defs.items():
        resolved = []
        for fname, dtype in fields:
            if not isinstance(dtype, str) or dtype in DTYPES:
                resolved.append((fname, dtype))
                continue
            if dtype in record_names:
                resolved.append((fname, TypeAnn(dtype, 'record')))
                continue
            if _BARE_CLASS_NAME_RE.match(dtype) or _mentions_unknown_class(dtype, DTYPES):
                # 2026-09-25: spec tro toi 1 class o MODULE KHAC (import) -
                # tai thoi diem nay `record_names` CHI co class cua file dang
                # parse nen chua biet no co that khong (va _parse_type_ann_str
                # se nem loi vi ten la). Giu NGUYEN van ban, de
                # _resolve_deferred_record_field_types() giai sau khi da GOP
                # record cua cac module import. Van bao loi ro rang neu den
                # luc do van khong giai duoc - khong im lang bo qua.
                resolved.append((fname, dtype))
                continue
            try:
                ta = _parse_type_ann_str(dtype, record_names=record_names,
                                          extern_class_names=extern_class_names)
            except SyntaxError as e:
                raise TranspileError(
                    f"class '{rname}' field '{fname}': dtype {dtype!r} khong hop le "
                    f"(vo huong: {sorted(DTYPES)}; container: 'list[...]'/'dict[khoa,gia_tri]'; "
                    f"hoac ten 1 class da khai bao trong file) - {e}")
            if ta.shape not in ('list', 'dict'):
                raise TranspileError(
                    f"class '{rname}' field '{fname}': dtype {dtype!r} khong hop le - field chi "
                    f"duoc la VO HUONG {sorted(DTYPES)}, 1 class da khai bao, hoac container "
                    f"'list[...]'/'dict[khoa,gia_tri]'")
            resolved.append((fname, ta))
        record_defs[rname] = resolved


def extract_program(source_text):
    """Parse mot file nguon TokenVector (`.tkv`) THAT tu VAN BAN THO
    (khong co duong dan file that), tra ve (record_defs, record_methods_raw,
    record_bases, record_interfaces, interface_defs, pairs) - xem
    _parse_program_ast. KHONG ho tro '__tkv_import__' (can duong dan thu
    muc de tim file import - dung extract_program_file() / compile_tkv_cli()
    / transpile_file() cho truong hop do)."""
    (record_defs, record_methods_raw, record_bases, record_interfaces,
     interface_defs, pairs, import_names, extern_assemblies, extern_methods,
     extern_pinvokes, extern_classes, struct_defs, com_classes, module_consts, module_globals,
     inferred_ast_nodes_by_func, record_init_sigs) = _parse_program_ast(source_text)
    if import_names:
        raise TranspileError(
            f"file co '__tkv_import__'/'import X'/'from X import ...' = {import_names!r} nhung "
            f"duoc goi qua extract_program(source_text) (khong co duong dan file that) - dung "
            f"extract_program_file(tkv_path) hoac compile_tkv_cli()/transpile_file() (co duong "
            f"dan) de import cheo file hoat dong")
    return (record_defs, record_methods_raw, record_bases, record_interfaces, interface_defs, pairs,
            extern_assemblies, extern_methods, extern_pinvokes, extern_classes, struct_defs, com_classes,
            module_consts, module_globals, inferred_ast_nodes_by_func, record_init_sigs)


_PROJECT_ROOT = Path(__file__).parent.resolve()


def _find_module_path(imp_name, base_dir):
    """Tim file module cho 1 ten import (Phase 6.2, 2026-08-11 - port
    NGUYEN VEN tu cay .tkv tu-host, da chay THAT o do): uu tien file
    '.tkv' (native TokenVector) truoc '.py' (fallback, hiem dung), tim
    trong thu muc cua file dang bien dich, roi 'stdlib/'/'vendor/' (cung
    cho tuong doi/goc du an), roi moi thu muc trong sys.path."""
    candidates = [
        base_dir / f'{imp_name}.tkv',
        base_dir / imp_name / '__init__.tkv',
        base_dir / 'stdlib' / f'{imp_name}.tkv',
        base_dir / 'stdlib' / imp_name / '__init__.tkv',
        _PROJECT_ROOT / 'stdlib' / f'{imp_name}.tkv',
        _PROJECT_ROOT / 'stdlib' / imp_name / '__init__.tkv',
        base_dir / 'vendor' / f'{imp_name}.tkv',
        base_dir / 'vendor' / imp_name / '__init__.tkv',
        base_dir / f'{imp_name}.py',
        base_dir / imp_name / '__init__.py',
        base_dir / 'vendor' / f'{imp_name}.py',
        base_dir / 'vendor' / imp_name / '__init__.py',
    ]
    for cand in candidates:
        if cand.exists():
            return cand.resolve()
    for sp in sys.path:
        sp_dir = Path(sp)
        if not sp_dir.exists():
            continue
        sp_cands = [
            sp_dir / f'{imp_name}.tkv',
            sp_dir / imp_name / '__init__.tkv',
            sp_dir / f'{imp_name}.py',
            sp_dir / imp_name / '__init__.py',
        ]
        for cand in sp_cands:
            if cand.exists():
                return cand.resolve()
    return None


def extract_program_file(tkv_path, _visited=None, _inherited_r11_skip=None):
    """Nhu extract_program(), nhung doc THANG tu 1 file that (co duong dan)
    va DE QUY giai quyet '__tkv_import__' (khoang trong ngon ngu #3 - chia
    du an thanh nhieu file .tkv) - tim file '<ten>.tkv' trong CUNG thu muc
    voi file dang xu ly, gop TOAN BO ham/record/method cua no vao ket qua
    CHUNG (bao loi RO RANG neu trung ten ham/class giua 2 file - khong
    am tham ghi de). _visited: tap duong dan TUYET DOI da xu ly (chong
    import vong lap - vd A import B, B import lai A: lan gap lai A THU
    HAI se bi BO QUA thay vi de quy vo han, vi noi dung A da duoc gop
    roi tu lan dau).

    Gioi han da biet (@property, Phase C.3, 2026-07-29): desugar
    'obj.propname'->'obj.propname()' (xem _desugar_property_reads) chay
    RIENG trong _parse_program_ast cua TUNG file (theo property_names CHI
    cua file DO) - 1 property khai bao o file A se KHONG duoc desugar
    trong ham/method cua file B dang '__tkv_import__' A (van hoat dong binh
    thuong neu dung TRONG CUNG 1 file, truong hop pho bien nhat)."""
    tkv_path = Path(tkv_path).resolve()
    if _visited is None:
        _visited = {str(tkv_path)}
    source_text = tkv_path.read_text(encoding='utf-8')
    (record_defs, record_methods_raw, record_bases, record_interfaces,
     interface_defs, pairs, import_names, extern_assemblies, extern_methods,
     extern_pinvokes, extern_classes, struct_defs, com_classes, module_consts, module_globals,
     inferred_ast_nodes_by_func, record_init_sigs) = _parse_program_ast(source_text, tkv_path,
                                                      extra_r11_skip=_inherited_r11_skip)
    func_names = {m.group(1) for sig_line, _, _start in pairs if (m := _FUNC_NAME_RE.match(sig_line))}
    # R2 (2026-09-24): tap skip truyen cho file con = ke thua tu cha +
    # tops cua CHINH file nay + closure import cua file nay (mo rong dan
    # moi tang - file con nhin thay siblings qua closure cua cha).
    try:
        _own_tops = _module_skip_names(ast.parse(source_text))
    except Exception:
        _own_tops = set()
    try:
        _own_closure = _collect_imported_top_names(tkv_path, import_names)
    except Exception:
        _own_closure = set()
    _child_r11_skip = set(_inherited_r11_skip or ()) | _own_tops | _own_closure

    for imp_name in import_names:
        imp_path = _find_module_path(imp_name, tkv_path.parent)
        if imp_path is None:
            raise TranspileError(
                f"file '{tkv_path.name}': import module '{imp_name}' khong tim thay trong "
                f"thu muc hien tai hoac site-packages ({sys.path!r})")
        if str(imp_path) in _visited:
            continue
        _visited.add(str(imp_path))
        (imp_record_defs, imp_record_methods_raw, imp_record_bases, imp_record_interfaces,
         imp_interface_defs, imp_pairs, imp_extern_assemblies, imp_extern_methods,
         imp_extern_pinvokes, imp_extern_classes, imp_struct_defs, imp_com_classes, imp_module_consts,
         imp_module_globals,
         imp_inferred_ast_nodes_by_func, imp_record_init_sigs) = extract_program_file(imp_path, _visited,
                                                            _child_r11_skip)
        imp_func_names = {m.group(1) for sig_line, _, _start in imp_pairs if (m := _FUNC_NAME_RE.match(sig_line))}

        dup_funcs = func_names & imp_func_names
        if dup_funcs:
            raise TranspileError(
                f"trung ten ham {sorted(dup_funcs)} giua file '{tkv_path.name}' va import "
                f"'{imp_name}.tkv'")
        dup_records = set(record_defs) & set(imp_record_defs)
        if dup_records:
            raise TranspileError(
                f"trung ten class {sorted(dup_records)} giua file '{tkv_path.name}' va import "
                f"'{imp_name}.tkv'")
        dup_interfaces = set(interface_defs) & set(imp_interface_defs)
        if dup_interfaces:
            raise TranspileError(
                f"trung ten interface {sorted(dup_interfaces)} giua file '{tkv_path.name}' va "
                f"import '{imp_name}.tkv'")
        # R1: struct trung ten giua file goc va import -> loi ro rang.
        dup_structs = set(struct_defs) & set(imp_struct_defs)
        if dup_structs:
            raise TranspileError(
                f"trung ten struct {sorted(dup_structs)} giua file '{tkv_path.name}' va import "
                f"'{imp_name}.tkv'")

        # F4c: COM decl trung record/interface giua file goc va import.
        dup_com_ifaces = {d['interface'] for d in com_classes} & \
            {d['interface'] for d in imp_com_classes}
        if dup_com_ifaces:
            raise TranspileError(
                f"trung ten COM interface {sorted(dup_com_ifaces)} giua file '{tkv_path.name}' va "
                f"import '{imp_name}.tkv'")
        dup_com_recs = {d['record'] for d in com_classes} & \
            {d['record'] for d in imp_com_classes}
        if dup_com_recs:
            raise TranspileError(
                f"trung record COM {sorted(dup_com_recs)} giua file '{tkv_path.name}' va "
                f"import '{imp_name}.tkv' (moi record chi 1 decl COM)")

        pairs.extend(imp_pairs)
        func_names |= imp_func_names
        record_defs.update(imp_record_defs)
        record_methods_raw.update(imp_record_methods_raw)
        record_init_sigs.update(imp_record_init_sigs)
        record_bases.update(imp_record_bases)
        record_interfaces.update(imp_record_interfaces)
        interface_defs.update(imp_interface_defs)
        extern_assemblies.extend(imp_extern_assemblies)
        extern_methods.extend(imp_extern_methods)
        extern_pinvokes.extend(imp_extern_pinvokes)
        extern_classes.extend(imp_extern_classes)
        struct_defs.update(imp_struct_defs)
        com_classes.extend(imp_com_classes)
        # Hang so cap module cua file IMPORT dung duoc trong file goc (giong
        # ham/record) - trung ten thi file GOC thang (khai bao gan hon).
        for k, v in imp_module_consts.items():
            module_consts.setdefault(k, v)
        # Bien global cua file IMPORT (2026-08-11) - cung quy uoc: trung
        # ten thi file GOC thang.
        for k, v in imp_module_globals.items():
            module_globals.setdefault(k, v)
        # Task 3/5 (duck-typing-inference): AST goc cua ham 'inferred' o
        # file IMPORT - dup_funcs o tren da dam bao khong trung ten voi file
        # goc nen .update() an toan (khong ghi de nham).
        inferred_ast_nodes_by_func.update(imp_inferred_ast_nodes_by_func)

    return (record_defs, record_methods_raw, record_bases, record_interfaces, interface_defs, pairs,
            extern_assemblies, extern_methods, extern_pinvokes, extern_classes, struct_defs, com_classes,
            module_consts, module_globals, inferred_ast_nodes_by_func, record_init_sigs)


def _resolve_inferred_record_fields(record_defs, record_init_sigs, record_names,
                                    extern_class_names=frozenset()):
    """Field record khai bao dtype 'inferred' - LAY KIEU THAT tu tham so
    cung ten cua '__init__' (2026-09-25).

    Repo TokenVector.Inference dung quy uoc: khi field tro toi 1 class
    KHONG khai bao trong cung file (cross-module, vd
    'class GenRequest: cache: "inferred"' trong tv/server/cont_batcher.tkv
    khi 'AttentionKvCache' o tv/runtime/kv_cache.tkv), nguoi viet dat
    'inferred' thay vi ten class - vi ten class la 1 DUA CHI, khong nen
    hardcode o noi ghi. Compiler thi phai tra lai kieu THAT cho field
    do. Nguon THAT la CHINH '__init__': field cung ten voi tham so
    __init__ da duoc gan kieu day du ('cache: "AttentionKvCache"'), va
    record_defs da gop field cua base truoc field rieng nen kieu cua
    field thua van nam trong __init__ tuong ung.

    'inferred' la dtype CO CHUC NANG cho THAM SO ham (monomorphize, xem
    INFERRED_DTYPE_MARKER) - kieu do resolve duoc o CALL SITE. Field
    record thi KHONG co call site de resolve (1 class = 1 kieu), nen
    phai giai o day; neu khong tim thay tham so __init__ tương ứng thi
    giu nguyen 'inferred' va de loi cua il_codegen bao ro rang (dung
    hon im lang dien ro shape IL sai)."""
    for rname, fields in list(record_defs.items()):
        if not any(isinstance(dt, str) and dt == INFERRED_DTYPE_MARKER
                   for _, dt in fields):
            continue
        init_ta_by_param = {}
        init_entry = (record_init_sigs or {}).get(rname)
        init_sig_line = init_entry[0] if init_entry else None
        if init_sig_line:
            m_sig = parse_typed_signature(init_sig_line, record_names=record_names,
                                          extern_class_names=extern_class_names)
            for p in m_sig.params:
                if p.name == 'self' or p.type_ann is None:
                    continue
                init_ta_by_param.setdefault(p.name, p.type_ann)
        if not init_ta_by_param:
            continue
        resolved = []
        for fname, dtype in fields:
            if isinstance(dtype, str) and dtype == INFERRED_DTYPE_MARKER \
                    and fname in init_ta_by_param:
                ta = init_ta_by_param[fname]
                if ta is not None and ta.dtype != INFERRED_DTYPE_MARKER:
                    resolved.append((fname, ta))
                    continue
            resolved.append((fname, dtype))
        record_defs[rname] = resolved


def _build_record_methods(record_defs, record_methods_raw, record_bases=None,
                           extern_class_names=frozenset(), record_init_sigs=None,
                           pairs=None):
    """Parse TAT CA sig_line THO cua method (record_methods_raw) thanh
    Signature THAT - lam RIENG, SAU khi record_defs (fields) da biet DU
    (khong lam ben trong extract_program) de method co the tham chieu
    BAT KY record nao trong file (ke ca khai bao SAU no) qua record_names.

    record_bases (B1, 2026-07-29): dict ten-record -> ten-class-cha (hoac
    None) - neu co, 'record_methods' tra ve la VIEW DA GOP (method ke thua
    tu to tien + method RIENG, method RIENG de len SAU nen THANG method ke
    thua neu trung ten - dung khi 1 CALL SITE (vd 'dog.speak()') can biet
    Signature cua 1 method du no dinh nghia o Dog hay o Animal). KHONG
    truyen (None, mac dinh) tuong duong record_bases rong - hanh vi CU
    (chi method RIENG cua tung record), an toan cho MOI caller khong ke
    thua. record_method_bodies LUON CHI method RIENG (khong lap - CLR tu
    dispatch method ke thua qua v-table, xem gen_record_types) - KHONG bi
    anh huong boi gop nay.

    Tra ve (record_methods: {ten-record: {ten-method: Signature}} - DA GOP
    neu co record_bases, record_method_bodies: {ten-record: [(Signature,
    body_lines), ...]} - CHI method RIENG)."""
    record_bases = record_bases or {}
    record_names = set(record_defs)
    _resolve_inferred_record_fields(record_defs, record_init_sigs, record_names,
                                    extern_class_names)
    _infer_inferred_fields_from_bodies(record_defs, record_methods_raw, pairs,
                                       extern_class_names, record_names,
                                       record_init_sigs)
    _resolve_deferred_record_field_types(record_defs, record_names, extern_class_names)
    record_methods_own = {}
    record_method_bodies = {}
    for rname, methods_raw in record_methods_raw.items():
        sigs = {}
        bodies = []
        for sig_line, body_lines, is_static in methods_raw:
            m_sig = parse_typed_signature(sig_line, record_names=record_names,
                                           extern_class_names=extern_class_names)
            m_sig.is_static = is_static
            if m_sig.name in sigs:
                raise TranspileError(f"class '{rname}': trung ten method '{m_sig.name}'")
            sigs[m_sig.name] = m_sig
            bodies.append((m_sig, body_lines))
        record_methods_own[rname] = sigs
        record_method_bodies[rname] = bodies

    for rname in record_defs:
        bases = record_bases.get(rname)
        if isinstance(bases, list) and len(bases) > 1:
            # Phase 3.1 (2026-08-11) - bases[1:] khong dong gop field nhung
            # DONG GOP method MAC DINH (default method body, neu co) khi
            # record chinh CHUA tu dinh nghia method cung ten - giong y
            # tuong "default method" cua Java interface, tranh nguoi dung
            # phai chep lai body giong het nhau cho moi record implement.
            #
            # Fix MRO da-base (2026-08-13, muc 6.10): bases[1:] KHONG CHI la
            # '@interface' - co the la record THAT (vd 'class Duck(Flyer,
            # Swimmer)'). Truoc day vong lap CHI duyet bases[1:], BO SOT
            # bases[0] hoan toan - ket qua: khi 2+ base CUNG override 1
            # method trung ten, base CUOI "thang" mot cach tinh co (vi chi
            # no duoc copy chu dong vao day, con base[0] le ra dua vao CIL
            # 'extends' that + _method_owner_class fallback, nhung fallback
            # do khong bao gio chay vi 'isinstance(base, str)' luon False
            # khi base la LIST da-base) - SAI so voi CPython that (da xac
            # nhan qua spike: 'Duck(Flyer, Swimmer)' ca 2 override 'speak',
            # CPython tra ve 'flyer-speak' - base DAU TIEN thang theo MRO,
            # khong phai base cuoi). Duyet CA 'bases' (bao gom bases[0]) de
            # base DAU TIEN duoc uu tien dung ('own_names' add truoc thi
            # base do thang - giu nguyen than vong lap, chi doi pham vi).
            own_names = {m[0].name for m in record_method_bodies.get(rname, [])}
            for sec in bases:
                for m_sig, b_lines in record_method_bodies.get(sec, []):
                    if m_sig.name not in own_names:
                        record_method_bodies[rname].append((m_sig, b_lines))
                        own_names.add(m_sig.name)
                        record_methods_own[rname][m_sig.name] = m_sig

    record_methods = {}
    for rname in record_defs:
        visited = set()
        queue = [rname]
        chain = []
        while queue:
            cur = queue.pop(0)
            if cur in visited:
                continue
            visited.add(cur)
            chain.append(cur)
            bases = record_bases.get(cur)
            if isinstance(bases, list):
                queue.extend(bases)
            elif bases:
                queue.append(bases)
        merged = {}
        for c in reversed(chain):  # goc truoc, roi den con - con THANG neu trung ten (override)
            merged.update(record_methods_own.get(c, {}))
        record_methods[rname] = merged
    return record_methods, record_method_bodies, record_methods_own


def _build_sig_body_pairs(pairs, record_defs, record_methods, inferred_ast_nodes_by_func=None,
                           extern_class_names=frozenset()):
    """Parse TOAN BO `pairs` (sig_line VAN BAN) thanh Signature THAT, GAN
    THEM `sig.inferred_constraints` (Task 3/5, duck-typing-inference,
    2026-08-17) cho MOI Signature co >=1 tham so dtype 'inferred' - goi
    collect_inferred_constraints() voi AST GOC luu trong
    `inferred_ast_nodes_by_func` (xem _parse_program_ast). Dat RIENG ham
    nay (thay vi lap lai list-comprehension o 2 noi) de compile_tkv_cli va
    _transpile_extracted dung CHUNG 1 logic, tranh 2 noi lech nhau.

    `sig.inferred_constraints` LUON duoc gan (dict[param_name -> list[Constraint]],
    RONG {} neu ham khong co tham so inferred nao hoac inferred_ast_nodes_by_func
    khong duoc truyen) - Task 4 co the doc thang `sig.inferred_constraints`
    ma khong can hasattr()."""
    inferred_ast_nodes_by_func = inferred_ast_nodes_by_func or {}
    sig_body_pairs = []
    for sig_line, body_lines, start_line in pairs:
        # Task 2 (extern-class, 2026-08-18): boc SyntaxError thanh
        # TranspileError - dong nhat voi cach _resolve_record_field_types
        # da lam (field dung ten kieu chua khai bao), giup mot ten
        # handle-type chua khai bao qua __tkv_extern_class__ (hoac bat ky
        # loi cu phap chu ky nao khac) bao loi qua 1 loai exception ON
        # DINH (TranspileError) thay vi SyntaxError tho tu tang parser noi
        # bo - khong doi NOI DUNG thong bao loi, chi doi LOAI exception.
        try:
            sig = parse_typed_signature(sig_line, record_names=set(record_defs),
                                         extern_class_names=extern_class_names)
        except SyntaxError as e:
            raise TranspileError(str(e))
        func_node = inferred_ast_nodes_by_func.get(sig.name)
        if func_node is not None:
            sig.inferred_constraints = collect_inferred_constraints(
                sig, func_node, record_defs, record_methods)
        else:
            sig.inferred_constraints = {}
        sig_body_pairs.append((sig, body_lines, start_line))
    return sig_body_pairs


def _transpile_extracted(record_defs, record_methods_raw, pairs, class_name, with_guards,
                          module_consts=None, extra_classes=None, module_globals=None,
                          inferred_ast_nodes_by_func=None, record_init_sigs=None):
    """Phan CHUNG cua transpile_program/transpile_file - nhan ket qua da
    extract (tu 1 file don le HOAC da gop nhieu file qua
    extract_program_file/__tkv_import__), sinh CIL method that."""
    record_methods, _, _ = _build_record_methods(record_defs, record_methods_raw,
                                                 record_init_sigs=record_init_sigs)
    sig_body_pairs = _build_sig_body_pairs(pairs, record_defs, record_methods,
                                            inferred_ast_nodes_by_func)
    return gen_il_program(sig_body_pairs, class_name=class_name, with_guards=with_guards,
                           records=record_defs, record_methods=record_methods,
                           module_consts=module_consts, extra_classes=extra_classes,
                           module_globals=module_globals)


def transpile_program(source_text, class_name='Program', with_guards=True,
                       extra_classes=None):
    """Pipeline day du: source TokenVector (`.tkv`) THAT -> list CIL
    method (dung gen_il_program - da co func_table cho goi ham cheo nhau).
    LUU Y: neu source co 'class dang record', KHONG dung ham nay truc tiep
    de ra 1 file .il hoan chinh - method_lines tra ve CHUA co cac '.class
    value' cua record (xem compile_tkv_cli, noi ghep gen_record_types()
    RIENG ben ngoai class chuong trinh chinh). KHONG ho tro '__tkv_import__'
    (xem extract_program) - dung transpile_file() cho file co import cheo."""
    (record_defs, record_methods_raw, _rb, _ri, _idefs, pairs, _ea, _em, _ep, _ec, _st, _cc,
     module_consts, module_globals, inferred_ast_nodes_by_func, _ris) = extract_program(source_text)
    return _transpile_extracted(record_defs, record_methods_raw, pairs, class_name, with_guards,
                                 module_consts=module_consts, extra_classes=extra_classes,
                                 module_globals=module_globals,
                                 inferred_ast_nodes_by_func=inferred_ast_nodes_by_func)


def transpile_file(tkv_path, class_name='Program', with_guards=True,
                    extra_classes=None):
    """Nhu transpile_program, nhung doc THANG tu file (co duong dan) nen
    ho tro '__tkv_import__' (khoang trong ngon ngu #3 - import module
    TokenVector khac) qua extract_program_file()."""
    (record_defs, record_methods_raw, _rb, _ri, _idefs, pairs, _ea, _em, _ep, _ec, _st, _cc,
     module_consts, module_globals, inferred_ast_nodes_by_func,
     record_init_sigs) = extract_program_file(tkv_path)
    return _transpile_extracted(record_defs, record_methods_raw, pairs, class_name, with_guards,
                                 module_consts=module_consts, extra_classes=extra_classes,
                                 module_globals=module_globals,
                                 inferred_ast_nodes_by_func=inferred_ast_nodes_by_func,
                                 record_init_sigs=record_init_sigs)


# ============================================================
# CLI tu dong (huong tiep theo sau ROADMAP.md 9 buoc): tu truoc gio moi
# vi du/test trong session deu phai TU TAY viet 1 method Main() bang IL
# (doc argv, goi ham, in ket qua) - tuc TokenVector moi dung duoc "qua
# script Python", chua phai "cong cu bien dich that goi tu dong lenh".
# build_generic_main()/compile_tkv_cli() tu dong sinh Main() cho BAT KY
# ham entry nao co tham so/return VO HUONG (i32/i64/f32/f64/str) - khong
# them tinh nang ngon ngu moi, chi dong goi lai ha tang codegen DA CO va
# DA VERIFY (parse argv theo dtype, in ket qua) thanh 1 lenh `tkv build`.
#
# Gioi han THAT (chua ho tro): tham so/return la mang/list/dict - argv la
# chuoi PHANG, chua co quy uoc serialize container ro rang; se bao loi
# ro rang (CliError) thay vi doan mo.
# ============================================================

class CliError(Exception):
    pass


_CLI_PARSE_SEQ = {
    'i32': ['call int32 [mscorlib]System.Int32::Parse(string)'],
    'i64': ['call int64 [mscorlib]System.Int64::Parse(string)'],
    'f32': ['call class [mscorlib]System.Globalization.CultureInfo '
            '[mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()',
            'call float32 [mscorlib]System.Single::Parse(string, '
            'class [mscorlib]System.IFormatProvider)'],
    'f64': ['call class [mscorlib]System.Globalization.CultureInfo '
            '[mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()',
            'call float64 [mscorlib]System.Double::Parse(string, '
            'class [mscorlib]System.IFormatProvider)'],
    'str': [],  # argv[i] da la string san, khong can Parse
}

_CLI_PRINT_SEQ = {
    'i32': ['call instance string [mscorlib]System.Int32::ToString()'],
    'i64': ['call instance string [mscorlib]System.Int64::ToString()'],
    'f32': ['call class [mscorlib]System.Globalization.CultureInfo '
            '[mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()',
            'call instance string [mscorlib]System.Single::ToString(class [mscorlib]System.IFormatProvider)'],
    'f64': ['call class [mscorlib]System.Globalization.CultureInfo '
            '[mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()',
            'call instance string [mscorlib]System.Double::ToString(class [mscorlib]System.IFormatProvider)'],
    'str': [],  # ket qua da la string, in thang khong can ToString
}


def _global_init_lines(module_globals, class_name):
    """Sinh cac dong IL khoi tao TAT CA bien module-level GHI DUOC ('global',
    2026-08-11) - goi 1 LAN DUY NHAT dau Main(), TRUOC khi goi ham entry.
    Tranh dung '.cctor' (chua kiem chung trong codebase nay, cung tinh than
    ghi chu o il_features/logging_feature.py) - khoi tao TRUC TIEP trong
    than Main la duong da kiem chung an toan (giong cach CLI doc argv)."""
    lines = []
    for gname, (gdtype, gval) in (module_globals or {}).items():
        il_t = IL_SCALAR[gdtype]
        fname = "'" + gname + "'"
        if gdtype == 'str':
            escaped = str(gval).replace(chr(92), chr(92) * 2).replace('"', chr(92) + '"')
            lines.append(f'    ldstr "{escaped}"')
        else:
            lines.append(f'    {IL_LDC_OP[gdtype]} {gval}')
        lines.append(f'    stsfld {il_t} {class_name}::{fname}')
    return lines


def _stathread_custom_line():
    """1 dong '.custom' [STAThread] cho Main (P2, 2026-09-23 - UIA STA-only):
    blob giong _com_custom_lines('preservesig') (attribute khong tham so)."""
    return ('    .custom instance void [mscorlib]System.STAThreadAttribute'
            '::.ctor() = ( 01 00 00 00 )')


def _extract_apartment(tkv_path):
    """Doc pragma module-level '__tkv_apartment__' tu file entry CHINH (P2,
    2026-09-23): 'STA' -> 'STA' (Main gan [STAThread]); vang mat/'MTA' ->
    None (mac dinh MTA, hanh vi cu). Gia tri khac -> TranspileError.
    Trich RIENG ngoai _parse_program_ast (khong mo rong tuple plumbing)
    vi day la thuoc tinh cua DIEM VAO (Main), chi file entry co y nghia."""
    try:
        _text = Path(tkv_path).read_text(encoding='utf-8')
    except OSError:
        return None
    try:
        _tree = ast.parse(_text)
    except SyntaxError:
        return None
    for _node in _tree.body:
        if isinstance(_node, ast.Assign) and len(_node.targets) == 1 and \
                isinstance(_node.targets[0], ast.Name) and _node.targets[0].id == '__tkv_apartment__':
            _v = _node.value
            if not (isinstance(_v, ast.Constant) and isinstance(_v.value, str)):
                raise TranspileError("__tkv_apartment__ phai la 1 chuoi ('STA' hoac 'MTA')")
            if _v.value not in ('STA', 'MTA'):
                raise TranspileError(
                    f"__tkv_apartment__ = {_v.value!r} khong hop le (chi 'STA' hoac 'MTA')")
            return 'STA' if _v.value == 'STA' else None
    return None


def _build_main_tuple(sig, class_name, body, module_globals=None, entrypoint=True, apartment=None):
    """Phan duoi cua build_generic_main cho ham tra ValueTuple: doc tung
    ItemN qua ldflda (field cua struct - can DIA CHI de goi ToString tren
    value type, cung ly do voi str() builtin) roi noi thanh '(a, b)'."""
    dtypes = sig.return_type.tuple_dtypes
    tup_il = il_type_str(sig.return_type)
    body.append('    stloc.0')
    body.append('    ldstr "("')
    for i, d in enumerate(dtypes, start=1):
        if i > 1:
            body.append('    ldstr ", "')
            body.append('    call string [mscorlib]System.String::Concat(string, string)')
        # Kieu cua field PHAI ghi bang PLACEHOLDER generic ('!0', '!1'...)
        # chu KHONG phai kieu da the the ('int32') - neu khong, CLR bao
        # MissingFieldException LUC CHAY (da gap that o day). Cung quy uoc
        # voi '!0' cua List::get_Item o cac module khac.
        if d == 'str':
            body.append('    ldloc.0')
            body.append(f'    ldfld !{i - 1} {tup_il}::Item{i}')
        else:
            body.append('    ldloca.s 0')
            body.append(f'    ldflda !{i - 1} {tup_il}::Item{i}')
            body.extend(f'    {op}' for op in _CLI_PRINT_SEQ[d])
            if d in ('f32', 'f64'):
                body.append('    dup')
                body.append('    ldstr "."')
                body.append('    callvirt instance bool [mscorlib]System.String::Contains(string)')
                body.append(f'    brtrue cli_tup{i}_hasdot')
                body.append('    ldstr ".0"')
                body.append('    call string [mscorlib]System.String::Concat(string, string)')
                body.append(f'    br cli_tup{i}_end')
                body.append(f'  cli_tup{i}_hasdot:')
                body.append(f'  cli_tup{i}_end:')
        body.append('    call string [mscorlib]System.String::Concat(string, string)')
    body.append('    ldstr ")"')
    body.append('    call string [mscorlib]System.String::Concat(string, string)')
    body.append('    call void [mscorlib]System.Console::WriteLine(string)')
    body.append('    ret')
    method = [
        '  .method public static void Main(string[] args) cil managed',
        '  {',
    ]
    if entrypoint:
        method.append('    .entrypoint')
    if entrypoint and apartment == 'STA':
        method.append(_stathread_custom_line())
    method.append('    .maxstack 8')
    method.append(f'    .locals init ({tup_il} __cli_ret)')
    method += _global_init_lines(module_globals, class_name)
    method += body
    method.append('  }')
    return method



def _cli_default_literal(param, sig):
    """1 lenh IL day GIA TRI MAC DINH cua 1 tham so len stack (2026-08-03).
    CHI nhan hang so/chuoi - bieu thuc mac dinh phuc tap thi bao loi RO
    RANG thay vi sinh ma sai."""
    node = param.default_node
    dtype = param.type_ann.dtype
    if node[0] == 'str_lit' and dtype == 'str':
        return f'ldstr {node[1]}'
    if node[0] == 'num' and dtype in IL_LDC_OP:
        return f'{IL_LDC_OP[dtype]} {node[1]}'
    if node[0] == 'neg' and node[1][0] == 'num' and dtype in IL_LDC_OP:
        return f'{IL_LDC_OP[dtype]} -{node[1][1]}'
    raise CliError(
        f"tkv build: tham so '{param.name}' cua ham '{sig.name}' co gia tri mac dinh "
        f"khong phai hang so don gian - CLI tu dong chi day duoc hang so/chuoi. "
        f"Truyen du doi so khi chay, hoac doi mac dinh thanh 1 hang.")


def build_generic_main(sig, class_name, module_globals=None, entrypoint=True, apartment=None):
    """Sinh 1 method Main(string[] args) TU DONG cho ham entry `sig`: doc
    N tham so vo huong tu argv THEO DUNG THU TU tham so (parse dung dtype,
    InvariantCulture cho f32/f64 - xem bug locale that da sua o Buoc 1-3),
    goi ham, in ket qua ra stdout. R10 (2026-09-22): entrypoint=False cho
    --target library (DLL khong co diem vao, Main chi la static method).
    apartment='STA' + entrypoint: gan [STAThread] len Main (P2, 2026-09-23,
    COM STA-only nhu UIA - lay tu pragma __tkv_apartment__, xem _extract_apartment)."""
    for p in sig.params:
        if p.type_ann.shape is not None or p.type_ann.dtype not in _CLI_PARSE_SEQ:
            raise CliError(
                f"tkv build: tham so '{p.name}' cua ham '{sig.name}' co "
                f"dtype={p.type_ann.dtype!r} shape={p.type_ann.shape!r} - CLI tu "
                f"dong hien CHI ho tro tham so VO HUONG (i32/i64/f32/f64/str), "
                f"khong ho tro mang/list/dict (argv la chuoi phang, chua co quy "
                f"uoc serialize container).")
    if sig.return_type is None:
        raise CliError(
            f"tkv build: ham '{sig.name}' khong co return type - CLI tu dong "
            f"can in ket qua nen ham entry BAT BUOC phai return gia tri.")
    is_tuple_ret = sig.return_type.shape == 'tuple'
    if is_tuple_ret:
        bad = [d for d in sig.return_type.tuple_dtypes if d not in _CLI_PRINT_SEQ]
        if bad:
            raise CliError(
                f"tkv build: ham '{sig.name}' tra tuple co phan tu kieu {bad} - CLI tu "
                f"dong chi in duoc phan tu VO HUONG (i32/i64/f32/f64/str).")
    elif sig.return_type.shape is not None or sig.return_type.dtype not in _CLI_PRINT_SEQ:
        raise CliError(
            f"tkv build: ham '{sig.name}' return dtype={sig.return_type.dtype!r} "
            f"shape={sig.return_type.shape!r} - CLI tu dong hien CHI ho tro "
            f"return VO HUONG (i32/i64/f32/f64/str) hoac tuple cac gia tri vo huong.")

    body = []
    for i, p in enumerate(sig.params):
        if p.default_node is None:
            body.append('    ldarg.0')
            body.append(f'    ldc.i4 {i}')
            body.append('    ldelem.ref')
            body.extend(f'    {op}' for op in _CLI_PARSE_SEQ[p.type_ann.dtype])
            continue
        # Tham so CO GIA TRI MAC DINH (2026-08-03): truoc day Main van doc
        # thang argv[i] -> chay 'ham.exe 4' cho ham f(a, b=3) nem
        # IndexOutOfRangeException kho hieu (bug THAT tim ra bang
        # scratch/probe_runtime.py). Nay: thieu doi so thi dung mac dinh.
        default_il = _cli_default_literal(p, sig)
        miss_lbl = f'cli_def{i}_miss'
        done_lbl = f'cli_def{i}_done'
        body.append('    ldarg.0')
        body.append('    ldlen')
        body.append('    conv.i4')
        body.append(f'    ldc.i4 {i}')
        body.append(f'    ble {miss_lbl}')
        body.append('    ldarg.0')
        body.append(f'    ldc.i4 {i}')
        body.append('    ldelem.ref')
        body.extend(f'    {op}' for op in _CLI_PARSE_SEQ[p.type_ann.dtype])
        body.append(f'    br {done_lbl}')
        body.append(f'  {miss_lbl}:')
        body.append(f'    {default_il}')
        body.append(f'  {done_lbl}:')

    params_il = ', '.join(il_type_str(p.type_ann) for p in sig.params)
    ret_il = il_type_str(sig.return_type)
    # Ten ham cung phai boc nhay don (2026-08-03): 'flags' la tu khoa
    # ILASM - 1 ham ten do lam ca file khong assemble duoc. Xem
    # _il_ident trong il_codegen.py (cung ly do, o vi tri goi).
    body.append(f"    call {ret_il} {class_name}::'{sig.name}'({params_il})")

    if is_tuple_ret:
        # Ham tra TUPLE lam entry CLI (2026-08-03): in ra dang '(a, b)' -
        # dung het cua Python de doi chieu duoc THANG. Truoc day bi tu
        # choi hoan toan, du tuple dung NOI BO van chay tot.
        return _build_main_tuple(sig, class_name, body, module_globals=module_globals,
                                 entrypoint=entrypoint, apartment=apartment)

    ret_dtype = sig.return_type.dtype
    if ret_dtype == 'str':
        body.append('    call void [mscorlib]System.Console::WriteLine(string)')
        locals_decl = ''
    else:
        # Can DIA CHI (khong the lay dia chi 1 gia tri TAM tren stack) de
        # goi ToString() - instance method tren value type - cung ly do da
        # ap dung cho str() builtin trong il_codegen.py.
        body.append('    stloc.0')
        body.append('    ldloca.s 0')
        body.extend(f'    {op}' for op in _CLI_PRINT_SEQ[ret_dtype])
        if ret_dtype in ('f32', 'f64'):
            # BUG THAT tim thay qua chinh test CLI moi (sample_cli_smoke2.tkv,
            # scale_f32(3.5, 2.0) in ra "7" thay vi "7.0") - CUNG 1 loi
            # locale/format da sua truoc do trong str() builtin cua
            # il_codegen.py (Single/Double.ToString() bo dau cham cho so
            # tron) nhung quen ap dung lai o day - vong lap "them dau .0
            # neu thieu" giong het pattern da xac minh.
            body.append('    dup')
            body.append('    ldstr "."')
            body.append('    callvirt instance bool [mscorlib]System.String::Contains(string)')
            body.append('    brtrue cli_ret_hasdot')
            body.append('    ldstr ".0"')
            body.append('    call string [mscorlib]System.String::Concat(string, string)')
            body.append('    br cli_ret_end')
            body.append('  cli_ret_hasdot:')
            body.append('  cli_ret_end:')
        body.append('    call void [mscorlib]System.Console::WriteLine(string)')
        locals_decl = ret_il
    body.append('    ret')

    method = [
        '  .method public static void Main(string[] args) cil managed',
        '  {',
    ]
    if entrypoint:
        method.append('    .entrypoint')
    if entrypoint and apartment == 'STA':
        method.append(_stathread_custom_line())
    method.append('    .maxstack 8')
    if locals_decl:
        method.append(f'    .locals init ({locals_decl} __cli_ret)')
    method += _global_init_lines(module_globals, class_name)
    method += body
    method.append('  }')
    return method


def _compute_record_overrides(record_bases, record_methods):
    """B1 (2026-07-29): tra ve dict ten-record -> set ten-method DA xuat
    hien o BAT KY to tien nao (base/base-cua-base...) - dung de
    gen_record_types() quyet dinh 'virtual' (override, method da co slot
    tu to tien) vs 'newslot virtual' (lan dau xuat hien, mo slot moi) cho
    method RIENG cua record do. record_methods: {ten-record: {ten-method:
    Signature}} (tu _build_record_methods) - CHI method RIENG (khong lap
    lai method ke thua), nen di CA chuoi to tien la du (khong bi dem
    trung method cua chinh no)."""
    overrides = {}
    for name in record_methods:
        seen = set()
        visited = set()
        queue = []
        b = record_bases.get(name)
        if isinstance(b, list):
            queue.extend(b)
        elif b:
            queue.append(b)
        while queue:
            cur = queue.pop(0)
            if cur in visited:
                continue
            visited.add(cur)
            seen.update(record_methods.get(cur, {}))
            next_b = record_bases.get(cur)
            if isinstance(next_b, list):
                queue.extend(next_b)
            elif next_b:
                queue.append(next_b)
        overrides[name] = seen
    return overrides


def compile_tkv_cli(tkv_path, out_exe, entry_name=None, class_name='TKVApp', debug=False,
                    target='exe', subsystem=None, emit_il=False):
    """Bien dich 1 file `.tkv` THAT thanh `.exe` GOI DUOC TU DONG LENH
    TRUC TIEP (tu dong sinh Main(), khong can tu tay viet IL nhu moi vi
    du truoc day trong session) - argv[0..] anh xa THEO THU TU tham so
    cua ham entry, in ket qua ra stdout.

    entry_name=None: neu file chi co 1 ham, dung ham do; neu nhieu ham,
    can co 1 ham ten 'main' hoac phai truyen entry_name ro rang. Ho tro
    '__tkv_import__' (khoang trong ngon ngu #3) qua extract_program_file -
    entry_name co the la ham dinh nghia trong file IMPORT, khong chi file
    goc (func_table gop CA HAI).

    R10 (2026-09-22): target='library' ra managed DLL (khong .entrypoint,
    Main chi la static method thuong - goi duoc tu assembly khac; bien
    module-global chi duoc khoi tao khi Main duoc goi - chuong trinh dung
    global nen tu goi Main() 1 lan luc khoi dong). target='exe' nhu cu.
    subsystem='windows' (GUI, khong console) / 'console' / None (mac dinh
    ilasm, console) - truyen thang /SUBSYSTEM cho ilasm."""
    (record_defs, record_methods_raw, record_bases, record_interfaces,
     interface_defs, pairs, extern_assemblies, extern_methods, extern_pinvokes, extern_classes,
     struct_defs, com_classes, module_consts, module_globals,
     inferred_ast_nodes_by_func, record_init_sigs) = extract_program_file(tkv_path)

    # Task 2 (extern-class, 2026-08-18): extern_class_defs (ten handle-type
    # -> decl dict goc {'name','assembly','class','ctor','methods'}) - dung
    # boi il_type_str (qua bien module-level _EXTERN_CLASS_DEFS, xem finally
    # -pop duoi) va boi parse_typed_signature/parse_type_ann_str (qua
    # extern_class_names, tap TEN don thuan) de chap nhan Sb lam dtype
    # tham so/return/field. Trung ten giua CAC entry CUNG 1 pragma da duoc
    # Task 1's _parse_extern_class_dict_literal xac nhan KHONG can validate
    # them o day (parse shape khong kiem trung - kiem o day, truoc khi
    # dung lam dict-key, de bao loi ro rang thay vi entry sau am tham de
    # len entry truoc).
    extern_class_defs = {}
    for _decl in extern_classes:
        if _decl['name'] in extern_class_defs:
            raise TranspileError(
                f"__tkv_extern_class__: ten {_decl['name']!r} khai bao TRUNG LAP "
                f"trong cung 1 pragma")
        extern_class_defs[_decl['name']] = _decl
    extern_class_names = frozenset(extern_class_defs)

    # R1 (2026-09-22, __tkv_struct__): struct trung ten record/extern-class/
    # builtin/ham top-level -> loi ro rang NGAY (tranh resolve nham am tham
    # o cac tang sau). Dat day (sau khi extern_class_defs/record_defs du).
    for _sname in struct_defs:
        if _sname in record_defs:
            raise TranspileError(
                f"__tkv_struct__: struct {_sname!r} trung ten voi record/class cung ten - doi ten khac")
        if _sname in extern_class_defs:
            raise TranspileError(
                f"__tkv_struct__: struct {_sname!r} trung ten voi extern-class cung ten - doi ten khac")
        if _sname in EXPR_BUILTIN_CODEGEN:
            raise TranspileError(
                f"__tkv_struct__: struct {_sname!r} trung ten voi builtin co san - doi ten khac")

    record_methods, record_method_bodies, record_methods_own = _build_record_methods(
        record_defs, record_methods_raw, record_bases=record_bases,
        extern_class_names=extern_class_names, record_init_sigs=record_init_sigs,
        pairs=pairs)
    record_overrides = _compute_record_overrides(record_bases, record_methods)
    sig_body_pairs = _build_sig_body_pairs(pairs, record_defs, record_methods,
                                            inferred_ast_nodes_by_func,
                                            extern_class_names=extern_class_names)
    func_table = {sig.name: sig for sig, _, _start in sig_body_pairs}

    # R10 (2026-09-22): validate target/subsystem som (truoc khi bien dich).
    if target not in ('exe', 'library'):
        raise CliError(f"tkv build: --target {target!r} khong hop le (chi 'exe'/'library')")
    _subsystem_map = {'windows': 2, 'console': 3, None: None}
    if subsystem not in _subsystem_map:
        raise CliError(f"tkv build: --subsystem {subsystem!r} khong hop le (chi 'windows'/'console')")
    subsystem_flag = _subsystem_map[subsystem]

    if entry_name is None:
        if len(sig_body_pairs) == 1:
            entry_name = sig_body_pairs[0][0].name
        elif 'main' in func_table:
            entry_name = 'main'
        elif target == 'library':
            # Thu vien: khong bat buoc entry (xuat TAT CA ham top-level) -
            # Main duoc bo qua, bien global khong tu khoi tao (xem docstring).
            entry_name = None
        else:
            raise CliError(
                f"tkv build: file co {len(sig_body_pairs)} ham ({', '.join(func_table)}), "
                f"khong ro entry point nao - dat ten 1 ham la 'main' hoac chi ro entry_name.")
    if entry_name is not None and entry_name not in func_table:
        raise CliError(f"tkv build: khong tim thay ham entry '{entry_name}' trong {tkv_path}")

    # Task 3 (2026-08-14, __tkv_extern_method__): dang ky dong CAC builtin
    # extern method NGAY TRUOC gen_il_program (de dung duoc TRONG CUNG luot
    # compile nay) - declared_assembly_names gop ten cac assembly da khai
    # bao qua __tkv_extern_assembly__ (extern_assemblies LUON la list tuple
    # 3 phan tu (ten, pubkeytoken_or_'DEFAULT'_or_None, version_or_'DEFAULT'
    # _or_None) - xem Task 1's dieu tra) voi 3 assembly mac dinh luon co san.
    # try/finally BOC TOAN BO phan con lai cua ham (khong chi gen_il_program)
    # - EXPR_BUILTIN_CODEGEN/EXPR_BUILTIN_DTYPE la dict CAP MODULE, khong tu
    # reset giua 2 lan goi compile_tkv_cli trong CUNG process; bat cu
    # exception nao giua chung (ilasm loi, gen_il_program loi...) van phai
    # trigger pop, neu khong "ro ri" sang lan compile file khac tiep theo.
    declared_assembly_names = ({asm_name for asm_name, _pkt, _ver in extern_assemblies} |
                                _DEFAULT_GAC_ASSEMBLIES)

    # Task 3 (extern-class, 2026-08-18): validate MOI entry extern_classes
    # TRUOC khi dung lam dict-key/dang ky (extern_class_defs da build o
    # tren, nhung CHUA validate noi dung - chi Task 1 xac nhan trung ten
    # CUNG pragma). TAI DUNG regex/helper da co san cho __tkv_extern_method__
    # (_EXTERN_ASSEMBLY_NAME_RE khong dung o day vi 'class' o day validate
    # rieng qua regex ten class .NET - _EXTERN_CLASS_NAME_RE da co san, xem
    # _validate_and_register_extern_method) thay vi viet lai logic.
    for _decl in extern_classes:
        if not _decl['name'].isidentifier():
            raise TranspileError(
                f"__tkv_extern_class__: 'name' {_decl['name']!r} khong phai identifier hop le")
        if _decl['name'] in EXPR_BUILTIN_CODEGEN or _decl['name'] in record_defs:
            raise ValueError(
                f"__tkv_extern_class__: ten {_decl['name']!r} DA duoc dang ky truoc do "
                f"(trung voi builtin hoac record co san) - doi ten khac")
        # R3 (2026-09-22): 'assembly' full identity - giong extern_method.
        if ',' in _decl['assembly']:
            _decl['assembly'] = _ensure_extern_assembly(
                _decl['assembly'], extern_assemblies, declared_assembly_names,
                f"__tkv_extern_class__ {_decl['name']!r}")
        if _decl['assembly'] not in declared_assembly_names:
            raise TranspileError(
                f"__tkv_extern_class__: assembly {_decl['assembly']!r} chua duoc khai qua "
                f"__tkv_extern_assembly__ - cac assembly da biet: {sorted(declared_assembly_names)}")
        if not _EXTERN_CLASS_NAME_RE.match(_decl['class']):
            if _decl['class'].startswith('generic:'):
                # P2 (generic BCL): 'generic:Full`N[args]' - validate shape +
                # type-args o ham rieng (can extern_class_defs cho handle).
                _validate_generic_class_ref(_decl, extern_class_defs)
            else:
                raise TranspileError(
                    f"__tkv_extern_class__: 'class' {_decl['class']!r} khong dung dinh dang ten "
                    f"class .NET hop le (vd 'System.Text.StringBuilder')")
        for _pdtype in _decl['ctor']:
            if not _is_valid_extern_dtype(_pdtype) and _pdtype not in extern_class_defs:
                if not _validate_extern_class_container_dtype(
                        _pdtype, extern_class_defs, f"'ctor' cua {_decl['name']!r}"):
                    raise TranspileError(
                        f"__tkv_extern_class__: 'ctor' cua {_decl['name']!r} dung dtype "
                        f"{_pdtype!r} khong ho tro (chi {sorted(_EXTERN_DTYPE_TO_IL)} hoac 1 "
                        f"handle type da khai trong CUNG pragma)")

    # Task 4 (extern-class, 2026-08-18): validate MOI method cua MOI decl -
    # CUNG vong lap voi validate ctor o tren de nhat quan, nhung tach RIENG
    # (khong gop 1 vong for) vi kiem tra dup ten method la THEO TUNG decl
    # (1 decl khong duoc khai 2 method trung ten), khac han kiem tra dup
    # 'name' cua decl (theo TOAN BO extern_classes, da lam o Task 1).
    for _decl in extern_classes:
        _seen_method_names = set()
        for _m in _decl['methods']:
            if _m['name'] in _seen_method_names:
                raise TranspileError(
                    f"__tkv_extern_class__: method {_m['name']!r} khai TRUNG LAP "
                    f"trong {_decl['name']!r}")
            _seen_method_names.add(_m['name'])
            if not _EXTERN_METHOD_NAME_RE.match(_m['name']):
                raise TranspileError(
                    f"__tkv_extern_class__: method name {_m['name']!r} sai dinh dang")
            for _pdtype in _m['params']:
                if not _is_valid_extern_dtype(_pdtype) and _pdtype not in extern_class_defs:
                    if not _validate_extern_class_container_dtype(
                            _pdtype, extern_class_defs,
                            f"method {_m['name']!r} cua {_decl['name']!r}"):
                        raise TranspileError(
                            f"__tkv_extern_class__: method {_m['name']!r} cua {_decl['name']!r} "
                            f"dung dtype tham so {_pdtype!r} khong ho tro (chi "
                            f"{sorted(_EXTERN_DTYPE_TO_IL)} hoac 1 handle type da khai trong "
                            f"CUNG pragma)")
            # Phase 9a mo rong (2026-08-24): 'returns':'void' CHO PHEP -
            # xem _make_extern_class_method_void_codegen (dispatch rieng,
            # KHONG dung chung _make_extern_class_method_codegen vi ham do
            # goi il_codegen._il_ctor_param_type('void',...) se KeyError
            # (IL_SCALAR khong co khoa 'void') roi widen_if_needed VO DIEU
            # KIEN nhu co gia tri tren stack - SAI cho callvirt void. Nhanh
            # nay CHI CON kiem tra dtype thuoc extern_class_defs neu can -
            # 'void' khong nam trong _EXTERN_DTYPE_TO_IL/extern_class_defs
            # nen phai tach RIENG truoc nhanh do (xem duoi).
            if _m['returns'] != 'void' and not _is_valid_extern_dtype(_m['returns']) and _m['returns'] not in extern_class_defs:
                if not _validate_extern_class_container_dtype(
                        _m['returns'], extern_class_defs,
                        f"method {_m['name']!r} cua {_decl['name']!r}"):
                    raise TranspileError(
                        f"__tkv_extern_class__: method {_m['name']!r} cua {_decl['name']!r} "
                        f"returns {_m['returns']!r} khong ho tro (chi {sorted(_EXTERN_DTYPE_TO_IL)} "
                        f"hoac 1 handle type da khai trong CUNG pragma)")

    # Task 2 (Phase 9d Part A, 2026-08-26, static_methods): validate MOI
    # entry 'static_methods' cua MOI decl - CUNG cau truc voi vong lap
    # validate 'methods' o tren (tai dung y het _EXTERN_METHOD_NAME_RE,
    # _is_valid_extern_dtype, _validate_extern_class_container_dtype cho
    # tung tham so/return), CHI KHAC 1 diem quan trong ve pham vi dedup:
    #
    # __tkv_extern_method__ dung 1 tap `seen_static_names` TOAN CUC (ca file)
    # de dedup ten static method, vi CAC static method do duoc dang ky thanh
    # 1 ham top-level DUY NHAT trong khong gian ten global cua chuong trinh
    # (khong co "class" nao gan/phan tach chung). Nguoc lai, static_methods
    # o day thuoc VE 1 class (goi qua `ClassName.Method()` - xem Task 3/4 se
    # lam codegen), nen 2 class KHAC nhau hoan toan duoc phep dung CHUNG 1
    # ten static method (vd ca System.Text.StringBuilder va System.String
    # deu co the co static method "Foo" ma khong xung dot) - dedup CHI can
    # THEO TUNG decl (per-class), giong het cach 'methods' dedup theo tung
    # decl (_seen_method_names o vong lap tren), KHONG phai global nhu
    # __tkv_extern_method__'s seen_static_names.
    #
    # Rieng TRONG CUNG 1 class, static method KHONG duoc trung ten voi
    # instance method (methods) CUNG class do - vi ca hai deu se anh xa
    # thanh 1 "pseudo-method-name" tren cung class trong codegen sau nay
    # (Task 3/4), tranh nham lan goi tinh vs goi qua instance.
    for _decl in extern_classes:
        _seen_method_names = set(m['name'] for m in _decl['methods'])
        # M5 (final review Phase 9d Part A, 2026-08-26): check trung ten o
        # tren CHI so voi 'methods' (instance), thieu 'properties' cua CHINH
        # class - _render() hien KHONG tung sinh 'properties' nen rui ro
        # THAP trong thuc te, nhung 1 pragma viet tay van co the khai
        # 'properties' + 'static_methods' trung ten ma khong bi chan o day
        # (defense-in-depth, cung ly do voi check 'methods' o duoi).
        _seen_property_names = set(p['name'] for p in (_decl.get('properties') or []))
        _seen_static_method_names = set()
        for _m in _decl.get('static_methods') or []:
            if _m['name'] in _seen_static_method_names:
                raise TranspileError(
                    f"__tkv_extern_class__: static method {_m['name']!r} khai TRUNG LAP "
                    f"trong {_decl['name']!r}")
            _seen_static_method_names.add(_m['name'])
            if _m['name'] in _seen_method_names:
                raise TranspileError(
                    f"__tkv_extern_class__: static method {_m['name']!r} cua {_decl['name']!r} "
                    f"TRUNG TEN voi 1 method (instance) DA khai trong 'methods' cua CHINH class "
                    f"nay - doi ten khac")
            if _m['name'] in _seen_property_names:
                raise TranspileError(
                    f"__tkv_extern_class__: static method {_m['name']!r} cua {_decl['name']!r} "
                    f"TRUNG TEN voi 1 property DA khai trong 'properties' cua CHINH class nay - "
                    f"doi ten khac")
            if _m['name'] in set(f['name'] for f in (_decl.get('static_fields') or [])):
                raise TranspileError(
                    f"__tkv_extern_class__: static method {_m['name']!r} cua {_decl['name']!r} "
                    f"TRUNG TEN voi 1 static field DA khai trong 'static_fields' cua CHINH class "
                    f"nay - doi ten khac")
            if not _EXTERN_METHOD_NAME_RE.match(_m['name']):
                raise TranspileError(
                    f"__tkv_extern_class__: static method name {_m['name']!r} sai dinh dang")
            for _pdtype in _m['params']:
                if not _is_valid_extern_dtype(_pdtype) and _pdtype not in extern_class_defs:
                    if not _validate_extern_class_container_dtype(
                            _pdtype, extern_class_defs,
                            f"static method {_m['name']!r} cua {_decl['name']!r}"):
                        raise TranspileError(
                            f"__tkv_extern_class__: static method {_m['name']!r} cua {_decl['name']!r} "
                            f"dung dtype tham so {_pdtype!r} khong ho tro (chi "
                            f"{sorted(_EXTERN_DTYPE_TO_IL)} hoac 1 handle type da khai trong "
                            f"CUNG pragma)")
            if _m['returns'] != 'void' and not _is_valid_extern_dtype(_m['returns']) and _m['returns'] not in extern_class_defs:
                if not _validate_extern_class_container_dtype(
                        _m['returns'], extern_class_defs,
                        f"static method {_m['name']!r} cua {_decl['name']!r}"):
                    raise TranspileError(
                        f"__tkv_extern_class__: static method {_m['name']!r} cua {_decl['name']!r} "
                        f"returns {_m['returns']!r} khong ho tro (chi {sorted(_EXTERN_DTYPE_TO_IL)} "
                        f"hoac 1 handle type da khai trong CUNG pragma)")

    # SUA CRITICAL 2-cua-fix (2026-08-24, re-review sau Critical 1/2): kiem
    # tra NHAT QUAN void-ness giua CAC decl KHAC NHAU cung khai 1 ten method
    # phai chay o day - TRUOC vong lap dang ky EXPR_METHOD_CODEGEN ben duoi -
    # va CHI dung du lieu decl da parse (_m['returns']), KHONG dung trang
    # thai dang ky nao ca. Ly do: ban truoc dat check nay BEN TRONG vong lap
    # dang ky (dan xen voi register_expr_method) nen khi phat hien lech va
    # raise TranspileError, vong lap da dang ky XONG 1 vai method truoc do
    # vao EXPR_METHOD_CODEGEN (module-level dict) roi moi raise - dang ky do
    # KHONG duoc don don vi finally-cleanup cua compile_tkv_cli chi pop
    # nhung ten da nam trong registered_extern_class_method_names, ma vong
    # lap bi abort giua chung nen list nay dung nhung con thieu cac ten SAU
    # diem raise van co the da dang ky mot phan - ket qua: 1 factory "mo coi"
    # con lai trong EXPR_METHOD_CODEGEN sang lan compile_tkv_cli() KE TIEP
    # trong CUNG process, khien 1 chuong trinh HOAN TOAN hop le nhung tinh
    # co dung lai dung ten method do "thua ke" nham factory cu. Gom check
    # nay thanh 1 pass RIENG, chay TRUOC moi register_expr_method, dam bao
    # neu raise thi CHUA co gi duoc dang ky - khong con gi de don don.
    _extern_class_method_void_by_name = {}
    for _decl in extern_classes:
        for _m in _decl['methods']:
            _mname = _m['name']
            _is_void = _m['returns'] == 'void'
            _prev_void = _extern_class_method_void_by_name.get(_mname)
            if _prev_void is not None and _prev_void != _is_void:
                raise TranspileError(
                    f"__tkv_extern_class__: method {_mname!r} da duoc khai "
                    f"voi kieu tra ve KHAC (void vs co gia tri) tu 1 extern-class "
                    f"khac trong cung file ({_decl['name']!r} khai "
                    f"'returns': {_m['returns']!r}) - phai NHAT QUAN void hoac "
                    f"co gia tri cho MOI class khai method cung ten {_mname!r}")
            _extern_class_method_void_by_name[_mname] = _is_void

    # Task 1 (extern-class-property, 2026-08-18): validate MOI property cua
    # MOI decl - dup ten property (theo TUNG decl), dinh dang ten, dtype hop
    # le, va collision guard voi pseudo-method get_X/set_X ma Task 2/3 se
    # dang ky - phai kiem tra o day (truoc khi dang ky EXPR_METHOD_CODEGEN)
    # de bat loi som, tranh dang ky trung ten method THAT.
    for _decl in extern_classes:
        _seen_method_names = set(m['name'] for m in _decl['methods'])
        _seen_prop_names = set()
        for _p in _decl['properties']:
            if _p['name'] in _seen_prop_names:
                raise TranspileError(
                    f"__tkv_extern_class__: property {_p['name']!r} khai TRUNG LAP "
                    f"trong {_decl['name']!r}")
            _seen_prop_names.add(_p['name'])
            if not re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', _p['name']):
                raise TranspileError(f"__tkv_extern_class__: property name {_p['name']!r} sai dinh dang")
            if not _is_valid_extern_dtype(_p['dtype']) and _p['dtype'] not in extern_class_defs:
                if not _validate_extern_class_container_dtype(
                        _p['dtype'], extern_class_defs,
                        f"property {_p['name']!r} cua {_decl['name']!r}"):
                    raise TranspileError(
                        f"__tkv_extern_class__: property {_p['name']!r} cua {_decl['name']!r} "
                        f"dung dtype {_p['dtype']!r} khong ho tro")
            _get_name = f"get_{_p['name']}"
            _set_name = f"set_{_p['name']}"
            if _get_name in _seen_method_names or _set_name in _seen_method_names:
                raise TranspileError(
                    f"__tkv_extern_class__: property {_p['name']!r} cua {_decl['name']!r} "
                    f"sinh ten pseudo-method {_get_name!r}/{_set_name!r} TRUNG voi 1 method "
                    f"THAT da khai trong 'methods' - doi ten method hoac property")

    # P1 (2026-09-23, static_fields): validate MOI static field cua MOI decl -
    # dup ten (theo TUNG decl), dinh dang ten, dtype hop le (scalar/extern-
    # class/container, KHONG 'void'), va collision voi methods/static_methods/
    # properties CUNG decl (tranh nham lan 'Class.X' la field hay method).
    for _decl in extern_classes:
        _seen_names = (set(m['name'] for m in _decl['methods'])
                       | set(m['name'] for m in (_decl.get('static_methods') or []))
                       | set(p['name'] for p in _decl['properties']))
        _seen_field_names = set()
        for _f in _decl.get('static_fields') or []:
            if _f['name'] in _seen_field_names:
                raise TranspileError(
                    f"__tkv_extern_class__: static field {_f['name']!r} khai TRUNG LAP "
                    f"trong {_decl['name']!r}")
            _seen_field_names.add(_f['name'])
            if not re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', _f['name']):
                raise TranspileError(f"__tkv_extern_class__: static field name {_f['name']!r} sai dinh dang")
            if _f['name'] in _seen_names:
                raise TranspileError(
                    f"__tkv_extern_class__: static field {_f['name']!r} cua {_decl['name']!r} "
                    f"TRUNG TEN voi 1 method/property DA khai cua CHINH class nay - doi ten khac")
            if not _is_valid_extern_dtype(_f['dtype']) and _f['dtype'] not in extern_class_defs:
                if not _validate_extern_class_container_dtype(
                        _f['dtype'], extern_class_defs,
                        f"static field {_f['name']!r} cua {_decl['name']!r}"):
                    raise TranspileError(
                        f"__tkv_extern_class__: static field {_f['name']!r} cua {_decl['name']!r} "
                        f"dung dtype {_f['dtype']!r} khong ho tro")
            _validate_extern_static_field_value(_f, _decl['name'])

    registered_extern_names = []
    pinvoke_decl_lines = []
    registered_pinvoke_names = []
    # Task 4 (extern-class, 2026-08-18): dang ky dong method - khoa THAT SU
    # trong EXPR_METHOD_CODEGEN chi la ('extern_class', method_name) (xem
    # ghi chu lon o _make_extern_class_method_codegen), nen dang ky
    # IDEMPOTENT theo method_name (bo qua neu method_name nay DA duoc dang
    # ky boi 1 decl khac TRONG CUNG lan compile - closure tu phan giai
    # dung class luc goi qua obj_ta.dtype, khong can dang ky lai).
    #
    # SUA CRITICAL 2 (2026-08-24, final review Phase 9a): idempotent-theo-
    # ten CHI an toan khi CA HAI decl dung CHUNG 1 cap factory/dispatch,
    # tuc CUNG void-ness. Kiem tra NHAT QUAN void-ness gio da chuyen thanh
    # 1 pass RIENG chay TRUOC vong lap nay (xem block _extern_class_method_
    # void_by_name o tren, canh vong lap validate method) - dam bao neu co
    # lech void/co-gia-tri giua 2 decl thi raise TranspileError TRUOC KHI
    # bat ky register_expr_method nao chay, nen vong lap dang ky nay khong
    # con can theo doi void-ness nua, chi con idempotent don gian theo ten.
    registered_extern_class_method_names = []
    for _decl in extern_classes:
        for _m in _decl['methods']:
            _mname = _m['name']
            _key = ('extern_class', _mname)
            if _key in EXPR_METHOD_CODEGEN:
                continue
            if _m['returns'] == 'void':
                # Phase 9a: khong dung return_ta_fn (khong co gia tri de
                # suy TypeAnn) - dang ky voi return_dtype=None, KHONG
                # result_shape (result_shape bat buoc di kem return_ta_fn,
                # xem register_expr_method's docstring). _stmt_method_call_stmt
                # (il_codegen.py) se tu nhan ra qua EXPR_METHOD_DTYPE
                # tra ve None + khong tim thay trong EXPR_METHOD_SHAPE de
                # QUYET dinh khong 'pop' (xem Step 6 file nay).
                register_expr_method(
                    'extern_class', _mname,
                    _make_extern_class_method_void_codegen(_mname))
            else:
                register_expr_method(
                    'extern_class', _mname,
                    _make_extern_class_method_codegen(_mname),
                    return_ta_fn=_make_extern_class_method_return_ta(_mname),
                    result_shape='extern_class')
            registered_extern_class_method_names.append(_mname)
    # Task 2 (extern-class-property, 2026-08-18): dang ky dong getter
    # 'get_X' cho MOI property khai trong 'properties' - dung LAI CHINH
    # _make_extern_class_method_codegen/_make_extern_class_method_return_ta
    # (khong can factory rieng, xem sua _extern_class_method_lookup o tren
    # de no tu tong hop method-dict gia cho 'get_X'). Idempotent theo
    # method_name giong vong lap methods o tren (2 extern-class khac nhau
    # cung ten property la hop le).
    registered_extern_class_property_names = []
    for _decl in extern_classes:
        for _p in _decl['properties']:
            _getter_name = f"get_{_p['name']}"
            _getter_key = ('extern_class', _getter_name)
            if _getter_key in EXPR_METHOD_CODEGEN:
                continue
            register_expr_method(
                'extern_class', _getter_name,
                _make_extern_class_method_codegen(_getter_name),
                return_ta_fn=_make_extern_class_method_return_ta(_getter_name),
                result_shape='extern_class')
            registered_extern_class_property_names.append(_getter_name)
            # Task 3 (extern-class-property, 2026-08-18): dang ky them
            # setter 'set_X' CHI KHI property khai readonly=False - dung
            # factory rieng _make_extern_class_property_setter_codegen
            # (void-safe, xem docstring cua no). Idempotent theo
            # method_name giong het getter, gop chung 1 list
            # registered_extern_class_property_names de finally-pop duoi
            # don CA HAI khong can code rieng.
            if not _p['readonly']:
                _setter_name = f"set_{_p['name']}"
                _setter_key = ('extern_class', _setter_name)
                if _setter_key not in EXPR_METHOD_CODEGEN:
                    register_expr_method(
                        'extern_class', _setter_name,
                        _make_extern_class_property_setter_codegen(_setter_name),
                        return_ta_fn=None,
                        result_shape=None)
                    registered_extern_class_property_names.append(_setter_name)
    # Task 2 (extern-class, 2026-08-18): set bien module-level TAM THOI cua
    # il_codegen.py's il_type_str NGAY TRUOC gen_il_program (CUNG try/finally
    # voi EXPR_BUILTIN_CODEGEN/EXPR_BUILTIN_DTYPE o duoi) - xem giai thich
    # day du tai il_codegen.py's _EXTERN_CLASS_DEFS docstring.
    il_codegen._EXTERN_CLASS_DEFS = extern_class_defs
    # 2026-09-21 (groupby_apply): cung set ban ghi record cho
    # _il_scalar_or_handle - cho phep 'func(DataFrame)->DataFrame' v.v.
    il_codegen._RECORD_DEFS = record_defs if record_defs else {}
    # R1 (2026-09-22, __tkv_struct__): ten struct -> {'fields'} cho
    # il_type_str/compile_attr/attr_assign + validate pinvoke 'Name*'.
    # Dat TRUOC dang ky extern (pinvoke can tra cuu).
    il_codegen._STRUCT_DEFS = {k: {'fields': list(v['fields'])} for k, v in struct_defs.items()}
    # R1: builtin 'new_<Struct>' dang ky dong (can truoc gen_il_program de
    # dung duoc trong cung luot compile) - pop trong finally chung duoi.
    registered_struct_names = []
    for _sname, _sdef in struct_defs.items():
        _ctor_name = f'new_{_sname}'
        if _ctor_name in EXPR_BUILTIN_CODEGEN:
            raise TranspileError(
                f"__tkv_struct__: ten constructor '{_ctor_name}' trung voi builtin/ham co san - "
                f"doi ten struct {_sname!r}")
        register_expr_builtin(_ctor_name, _make_struct_ctor_codegen(_sname, _sdef['fields']),
                              _sname, return_shape='struct')
        registered_struct_names.append(_ctor_name)
    # F4c: validate COM decls (can record_methods de doi chieu chu ky -
    # record_methods da build xong o tren) + mutation record_interfaces
    # (class co 'implements') + gom .custom class + interface IL. KHONG
    # dang ky builtin (khong can finally-pop).
    com_attrs = {}
    com_interface_lines = []
    seen_com_ifaces = set()
    seen_com_records = set()
    for _cdecl in com_classes:
        _iname = _cdecl['interface']
        _rname = _cdecl['record']
        if _iname in seen_com_ifaces:
            raise TranspileError(
                f"__tkv_com_class__: interface {_iname!r} khai bao TRUNG LAP")
        if _rname in seen_com_records:
            raise TranspileError(
                f"__tkv_com_class__: record {_rname!r} da co 1 khai bao COM (moi record chi 1 interface)")
        seen_com_ifaces.add(_iname)
        seen_com_records.add(_rname)
        _validate_and_register_com_class(_cdecl, record_defs, record_methods, record_interfaces,
                                         com_attrs, com_interface_lines)
    try:
        for decl in extern_methods:
            _validate_and_register_extern_method(decl, declared_assembly_names, extern_assemblies)
            registered_extern_names.append(decl['name'])

        # Task 3 (2026-08-17, __tkv_extern_pinvoke__): dang ky dong CAC
        # builtin pinvoke - CUNG khoi try/finally voi extern_methods o tren
        # (khong tao try/finally rieng thu 2), pop trong CUNG finally duoi.
        # F4a: entry mang marker 'kind'='vtable' di nhanh calli rieng.
        # F4b: entry 'kind'='callback' sinh class delegate + builtin rieng.
        callback_class_lines = []
        for decl in extern_pinvokes:
            kind = decl.get('kind')
            if kind == 'vtable':
                _validate_and_register_vtable(decl)
                registered_pinvoke_names.append(decl['name'])
            elif kind == 'callback':
                _validate_and_register_callback(decl)
                registered_pinvoke_names.append(f"callback_{decl['name']}")
                registered_pinvoke_names.append(f"callback_keep_{decl['name']}")
                if not callback_class_lines:
                    # P2: class root delegate + builtin free DUNG 1 LAN cho
                    # ca chuong trinh (khong theo tung decl).
                    if 'CbKeepAlive' in record_defs or 'CbKeepAlive' in extern_class_defs:
                        raise TranspileError(
                            "ten noi bo 'CbKeepAlive' (lop root delegate cho "
                            "'callback_keep_*') trung voi record/extern-class cung ten - "
                            "doi ten record/extern-class do")
                    register_expr_builtin('callback_free_all',
                                          _make_callback_free_all_codegen(), 'i64')
                    registered_pinvoke_names.append('callback_free_all')
                    callback_class_lines.extend(_cb_keepalive_il_lines())
                callback_class_lines.extend(_callback_delegate_il_lines(decl))
            else:
                _validate_and_register_extern_pinvoke(decl, pinvoke_decl_lines)
                registered_pinvoke_names.append(decl['name'])

        # extra_classes (Buoc 4 - closure that, 2026-07-29): OUT-parameter cua
        # gen_il_program - moi 'def long' trong chuong trinh se append vao day
        # 1 hoac nhieu khoi '.class' MOI (cell/closure, xem il_features/
        # closures.py) can ghep RIENG vao IL text, giong het cach lam voi
        # record_type_lines o duoi.
        extra_classes = []
        # R1: khoi '.class' valuetype cho MOI struct - chen DAU TIEN de
        # khai bao kieu co mat truoc moi method su dung (ilasm khong doi
        # hoi thu tu, nhung de doc IL de hon).
        if struct_defs:
            extra_classes.append(_struct_il_lines(struct_defs))
        # F4b: class delegate non-generic cho MOI __tkv_callback__ - chen
        # sau struct (khai bao kieu truoc method dung, de doc IL).
        if callback_class_lines:
            extra_classes.append(callback_class_lines)
        # F4c: '.class interface' COM (Guid/InterfaceType/PreserveSig).
        if com_interface_lines:
            extra_classes.append(com_interface_lines)
        # emitted_types (2026-08-13, sua cung __str__ record): 1 set CHUNG giua
        # gen_il_program (ham top-level) va gen_record_types (method tren
        # record) ben duoi - truoc day moi ham tu tao set RIENG, khien 1 dtype
        # dung o CA hai noi (vd TkvStr, khi 1 record __str__ goi str()/+ ben
        # trong than method) bi ensure_class() sinh '.class' 2 LAN -> ilasm loi
        # 'Duplicate method declaration'. Xem il_codegen.py's gen_il_program.
        emitted_types = set()
        # Task 4/5 (2026-08-17, duck-typing-inference): monomorphize cua
        # tham so 'inferred' - `monomorphize_cache`/`pending_monomorphize`
        # la 2 BIEN CUC BO cua CHINH lan goi compile_tkv_cli nay (khoi tao
        # moi o day, KHONG phai dict module-level nhu EXPR_BUILTIN_CODEGEN)
        # - TU DONG khong ro ri sang lan goi compile_tkv_cli tiep theo
        # trong CUNG process (khong can finally-pop thu cong, khac
        # __tkv_extern_method__/__tkv_extern_pinvoke__ o tren - kien truc
        # cho phep dung bien cuc bo o day nen uu tien no, dung theo brief).
        #
        # Vong lap FIXPOINT (Task 1 report - tom tat rui ro #3): 1 ham
        # 'inferred' KHI resolve xong (thanh 1 Signature monomorphize MOI,
        # xem il_features/duck_typing.py's resolve_call_site) co the TU NO
        # goi tiep 1 ham 'inferred' KHAC voi kieu cu the MOI - moi lan goi
        # gen_il_program se sinh THEM cac phan tu vao pending_monomorphize
        # (qua _expr_call, il_codegen.py) neu gap loi goi nhu vay - can lap
        # lai cho toi khi KHONG con phan tu MOI nao. gen_il_program duoc
        # goi LAI TREN TOAN BO 'sig_body_pairs' (da mo rong them cac ham
        # monomorphize) MOI vong - AN TOAN khong sinh trung '.method' vi
        # CHI ket qua cua LAN GOI CUOI CUNG duoc dung lam 'method_lines'
        # (cac lan goi truoc bi bo ket qua, khong noi chuoi tich luy) -
        # extra_classes/emitted_types la 2 object CHIA SE xuyen MOI lan goi
        # (dedupe san co, xem gen_il_program's docstring) nen tai-bien-dich
        # cac ham DA compile roi khong sinh '.class' trung.
        _MAX_MONOMORPHIZE_ROUNDS = 1000
        monomorphize_cache = {}
        pending_monomorphize = []
        method_lines = gen_il_program(sig_body_pairs, class_name=class_name, records=record_defs,
                                       record_methods=record_methods, extra_classes=extra_classes,
                                       record_bases=record_bases, module_consts=module_consts,
                                       module_globals=module_globals,
                                       source_path=str(tkv_path), debug=debug,
                                       emitted_types=emitted_types,
                                       monomorphize_cache=monomorphize_cache,
                                       pending_monomorphize=pending_monomorphize)
        _monomorphize_rounds = 0
        while pending_monomorphize:
            _monomorphize_rounds += 1
            if _monomorphize_rounds > _MAX_MONOMORPHIZE_ROUNDS:
                raise CliError(
                    f"tkv build: vong lap monomorphize tham so 'inferred' vuot qua "
                    f"{_MAX_MONOMORPHIZE_ROUNDS} vong lap - nghi ngo co bug logic gay "
                    f"de quy vo han giua cac ham dung tham so kieu suy tu dong.")
            new_pairs = pending_monomorphize[:]
            pending_monomorphize.clear()
            sig_body_pairs.extend(new_pairs)
            method_lines = gen_il_program(sig_body_pairs, class_name=class_name, records=record_defs,
                                           record_methods=record_methods, extra_classes=extra_classes,
                                           record_bases=record_bases, module_consts=module_consts,
                                           module_globals=module_globals,
                                           source_path=str(tkv_path), debug=debug,
                                           emitted_types=emitted_types,
                                           monomorphize_cache=monomorphize_cache,
                                           pending_monomorphize=pending_monomorphize)
        main_method = (build_generic_main(func_table[entry_name], class_name, module_globals=module_globals,
                                              entrypoint=(target == 'exe'),
                                              apartment=_extract_apartment(tkv_path))
                         if entry_name is not None else [])
        record_type_lines = gen_record_types(record_defs, record_method_bodies=record_method_bodies,
                                              record_methods=record_methods, class_name=class_name,
                                              func_table=func_table, record_bases=record_bases,
                                              record_overrides=record_overrides,
                                              record_interfaces=record_interfaces,
                                              interface_defs=interface_defs,
                                              module_consts=module_consts,
                                              record_methods_own=record_methods_own,
                                              # F4c: '.custom' COM cho record lam coclass.
                                              com_class_attrs=com_attrs,
                                              # Task 3 (2026-08-12): CUNG 1 list
                                              # extra_classes voi gen_il_program o
                                              # tren - 'async def' method tren
                                              # record can ghi '.class' closure
                                              # cua no vao day de duoc ghep vao IL
                                              # text (extra_class_lines o duoi),
                                              # neu khong ilasm.exe bao 'Reference
                                              # to undefined class'.
                                              extra_classes=extra_classes,
                                              emitted_types=emitted_types,
                                              source_path=str(tkv_path), debug=debug)
        extra_class_lines = [line for block in extra_classes for line in block]

        # DB that qua P/Invoke sqlite3.dll (Wave 3, 2026-07-29 - xem
        # il_features/stdlib_sqlite.py) - CHI ghep 6 khai bao pinvokeimpl vao
        # class chuong trinh KHI THAT SU dung it nhat 1 ham db_* (tranh khai
        # bao pinvoke thua/doi hoi sqlite3.dll canh file .exe cho chuong
        # trinh khong dung DB).
        sqlite_decl_lines = (SQLITE_PINVOKE_DECL_LINES
                              if any(_uses_sqlite(body_lines) for _sig, body_lines, _start in pairs)
                              else [])

        # --- BEGIN GEMINI ADDED CODE: cJSON P/Invoke Extraction ---
        cjson_decl_lines = (CJSON_PINVOKE_DECL_LINES
                              if any(_uses_cjson(body_lines) for _sig, body_lines, _start in pairs)
                              else [])
        http_server_decl_lines = (HTTP_SERVER_CIL_DECL_LINES
                      if any('http_server_generate(' in line
                         for _sig, body_lines, _start in pairs
                         for line in body_lines)
                      else [])
        # --- END GEMINI ADDED CODE ---

        # Co che MO RONG (Wave 3, 2026-07-29, "package ecosystem" - xem
        # __tkv_extern_assembly__ trong _parse_program_ast, project-tokenvector-
        # wave2-status memory): THEM cac '.assembly extern' do nguoi dung khai
        # bao, ngoai 3 assembly LUON CO SAN (mscorlib/System.Core/System).
        # 'DEFAULT'/'DEFAULT' = dung publickeytoken+version CHUAN .NET Framework
        # (da xac minh THAT qua ilasm.exe voi System.Xml - CUNG 1 token/ver
        # ap dung cho moi assembly GAC chuan cua Framework 4.0). Dedupe theo
        # ten (khong khai bao lai mscorlib/System/System.Core du nguoi dung
        # lo khai bao trung).
        _default_pubkeytoken = 'B7 7A 5C 56 19 34 E0 89'
        extern_lines = []
        seen_extern = set(_DEFAULT_GAC_ASSEMBLIES)
        for asm_name, pubkeytoken, version in extern_assemblies:
            if asm_name in seen_extern:
                continue
            seen_extern.add(asm_name)
            # R3 (2026-09-22): '.ver' BAT BUOC dang dau HAI CHAM ('1:0:0:0')
            # - ilasm bao 'syntax error at token 1.0' voi dau CHAM
            # ('1.0.0.0', cach viet .NET thuong) - loi THAT khi verify
            # TestShim (Phase 9k viet dots, chua verify end-to-end).
            ver_il = version.replace('.', ':') if version and version != 'DEFAULT' else version
            if pubkeytoken == 'DEFAULT' and version == 'DEFAULT':
                extern_lines.append(
                    f'.assembly extern {asm_name} {{ .publickeytoken = ({_default_pubkeytoken} ) .ver 4:0:0:0 }}\n')
            elif pubkeytoken and version:
                extern_lines.append(
                    f'.assembly extern {asm_name} {{ .publickeytoken = ({pubkeytoken} ) .ver {ver_il} }}\n')
            elif version:
                # (Phase 9k, 2026-08-31): phat hien qua compile+run THAT tren
                # NuGet Newtonsoft.Json (khong ky ten manh/khong pubkeytoken,
                # nhung CO version that 13.0.0.0) - truoc day nhanh nay KHONG
                # TON TAI, 'version' bi ROI MAT khi pubkeytoken=None du nguoi
                # dung DA khai qua tuple 3 phan tu - ilasm tu dien .ver
                # 0:0:0:0 cho '.assembly extern X {}' (khong co dau '.ver'),
                # CLR loader tu choi load file that (13.0.0.0 != 0.0.0.0) voi
                # FileLoadException "manifest definition does not match".
                # Assembly khong ky ten manh VAN can .ver khop dung de CLR
                # bind (khong phai "khop bat ky version" nhu tung gia dinh).
                extern_lines.append(f'.assembly extern {asm_name} {{ .ver {ver_il} }}\n')
            elif pubkeytoken:
                extern_lines.append(
                    f'.assembly extern {asm_name} {{ .publickeytoken = ({pubkeytoken} ) }}\n')
            else:
                extern_lines.append(f'.assembly extern {asm_name} {{}}\n')

        il_text = (
            f'.assembly extern mscorlib {{}}\n'
            f'.assembly extern System.Core {{ .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }}\n'
            # System.Text.RegularExpressions.Regex (re_match/re_sub, Wave 2
            # 2026-07-29) nam trong assembly "System" (KHAC "System.Core" o
            # tren) - can khai bao rieng, xac minh THAT qua ilasm.exe (thieu
            # se FileNotFoundException luc CHAY, khong phai luc assemble).
            f'.assembly extern System {{ .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }}\n'
            # System.Numerics.BigInteger - duong CHAM cua kieu 'int' (so nguyen
            # vo han chu so, moc 6 buoc 2 2026-08-05, xem il_features/int_type.py).
            # Khai bao LUON: 1 dong '.assembly extern' khong dung den khong ton
            # gi luc chay va re hon la doi khai bao theo tung chuong trinh.
            f'.assembly extern System.Numerics {{ .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }}\n'
            + ''.join(extern_lines)
            + f'.assembly {class_name} {{}}\n.module {class_name}.{"dll" if target == "library" else "exe"}\n\n'
            + '\n'.join(record_type_lines) + ('\n\n' if record_type_lines else '')
            + '\n'.join(extra_class_lines) + ('\n\n' if extra_class_lines else '')
            + f'.class public auto ansi {class_name} extends [mscorlib]System.Object\n{{\n'
            + '\n'.join(method_lines) + '\n' + '\n'.join(main_method) + '\n'
            + '\n'.join(sqlite_decl_lines) + ('\n' if sqlite_decl_lines else '')
            # --- BEGIN GEMINI ADDED CODE: cJSON P/Invoke Injection ---
            + '\n'.join(cjson_decl_lines) + ('\n' if cjson_decl_lines else '')
            # --- END GEMINI ADDED CODE ---
            + '\n'.join(http_server_decl_lines) + ('\n' if http_server_decl_lines else '')
            + '\n'.join(pinvoke_decl_lines) + ('\n' if pinvoke_decl_lines else '')
            + '}\n'
        )
        # Di qua assemble_il_to_exe (tokenvector_compile.py) chu khong tu goi
        # ilasm: o do co buoc 'on dinh' tranh duong tinh gia cua Defender voi
        # mot PE vua dung xong - xem docstring cua no.
        # R10 (2026-09-22): target library -> assemble /dll (khong Main).
        try:
            if emit_il:
                with open(str(out_exe) + '.il', 'w', encoding='utf-8') as _f:
                    _f.write(il_text)
            if target == 'library':
                return assemble_il_to_dll(il_text, out_exe, debug=debug, subsystem=subsystem_flag)
            return assemble_il_to_exe(il_text, out_exe, debug=debug, subsystem=subsystem_flag)
        except TokenVectorError as e:
            raise CliError(str(e))
    finally:
        for _nm in registered_extern_names:
            EXPR_BUILTIN_CODEGEN.pop(_nm, None)
            EXPR_BUILTIN_DTYPE.pop(_nm, None)
            EXTERN_VOID_BUILTIN_NAMES.discard(_nm)
        for _nm in registered_pinvoke_names:
            EXPR_BUILTIN_CODEGEN.pop(_nm, None)
            EXPR_BUILTIN_DTYPE.pop(_nm, None)
            EXTERN_VOID_BUILTIN_NAMES.discard(_nm)
        # R1: go dang ky builtin 'new_<Struct>' + cleanup shape registry.
        for _nm in registered_struct_names:
            EXPR_BUILTIN_CODEGEN.pop(_nm, None)
            EXPR_BUILTIN_DTYPE.pop(_nm, None)
            EXPR_BUILTIN_SHAPE.pop(_nm, None)
            EXPR_BUILTIN_RESULT_SHAPE.pop(_nm, None)
            EXPR_BUILTIN_TEMPS.pop(_nm, None)
        for _mname in registered_extern_class_method_names:
            _key = ('extern_class', _mname)
            EXPR_METHOD_CODEGEN.pop(_key, None)
            EXPR_METHOD_SHAPE.pop(_key, None)
            EXPR_METHOD_RESULT_SHAPE.pop(_key, None)
        for _getter_name in registered_extern_class_property_names:
            _key = ('extern_class', _getter_name)
            EXPR_METHOD_CODEGEN.pop(_key, None)
            EXPR_METHOD_SHAPE.pop(_key, None)
            EXPR_METHOD_RESULT_SHAPE.pop(_key, None)
        il_codegen._EXTERN_CLASS_DEFS = {}
        il_codegen._RECORD_DEFS = {}
        il_codegen._STRUCT_DEFS = {}
