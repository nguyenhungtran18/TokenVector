# _fpp_for/_fpp_while_if/_fpp_try da chuyen sang il_features/control_flow.py
# (fpp_for/fpp_while_if/fpp_try), Phase 1 buoc 9, 2026-07-28.


def _fpp_assign_scalar(stmt, ctx):
    infer_scope = ctx['infer_scope']
    name = stmt['name']
    if name not in infer_scope._d:
        rhs_node = stmt['rhs_node']
        records = ctx['records']
        if records and rhs_node[0] == 'call' and rhs_node[1] in records:
            infer_scope.set(name, TypeAnn(rhs_node[1], 'record'))
        elif rhs_node[0] == 'call' and rhs_node[1] in _EXTERN_CLASS_DEFS:
            # Task 4 (extern-class, 2026-08-18): doi xung voi declare_scalar's
            # nhanh moi o tren - PRESCAN rieng (tham chieu xuoi), can lap lai
            # o day cung ly do cac nhanh khac lam vay (xem docstring nhanh
            # index ben duoi).
            infer_scope.set(name, TypeAnn(rhs_node[1], 'extern_class'))
        elif rhs_node[0] == 'index' and _index_src_is_nested_container(rhs_node[1], infer_scope):
            # Giong nhanh trong declare_scalar (xem docstring o do) - can
            # lap lai o day vi _fpp_assign_scalar la 1 PRESCAN rieng cho
            # tham chieu xuoi (vd bien dung truoc khai bao trong nhanh
            # if/else), khong dung chung code voi declare_scalar.
            _, _, outer_ta = infer_scope[rhs_node[1]]
            infer_scope.set(name, outer_ta.elem_ta)
        elif _shaped_return_ta_of_call(rhs_node, ctx['func_table'], infer_scope,
                                        ctx.get('records')) is not None:
            infer_scope.set(name, _shaped_return_ta_of_call(rhs_node, ctx['func_table'],
                                                            infer_scope, ctx.get('records')))
        else:
            try:
                inferred = (_infer_dtype(rhs_node, infer_scope, ctx['func_table'], records, ctx['record_methods'])
                            or _infer_literal_dtype(rhs_node))
            except KeyError:
                inferred = None
            # muc Q follow-up (2026-08-19): KHONG fallback ve ctx['body_dtype']
            # nua khi ca 2 nhanh suy kieu that (_infer_dtype/_infer_literal_dtype)
            # deu that bai - truoc day gan BUA 1 gia tri co the SAI (thuong 'i32'),
            # bi 'khoa cung' boi declare_scalar's co che declared_names truoc
            # khi gia tri DUNG kip tinh o pass sau (xem BUGS_TODO muc Q). Prescan
            # nay la best-effort THUAN TUY (doc docstring dau ham) - bo qua
            # (khong set gi vao infer_scope) AN TOAN HON gan SAI, vi 'ten vang
            # mat trong infer_scope' da la tin hieu 'chua biet' duoc
            # declare_scalar's defer hieu dung san - KHONG can them state moi.
            if inferred:
                # Task 3 review fix (extern-class-list, 2026-08-18): doi xung
                # voi nhanh moi trong declare_scalar (xem docstring o do) -
                # PRESCAN rieng nen phai lap lai o day cung ly do cac nhanh
                # khac lam vay.
                if inferred in _EXTERN_CLASS_DEFS:
                    shape = 'extern_class'
                elif records and inferred in records:
                    shape = 'record'
                else:
                    shape = None
                infer_scope.set(name, TypeAnn(inferred, shape))


