# gen_il_guard_lines/_stmts_end_in_return da chuyen sang
# il_features/control_flow.py (Phase 1 buoc 9, 2026-07-28) - gen_il_function
# (duoi day) goi lai qua import THANG (ham thuan, khong can ctx-injection).


def _codegen_stmts(stmts, scope: _Scope, body: list, body_dtype: str, ctx: dict, sig: Signature):
    """Sinh CIL DE QUY tu cay Stmt - for/if deu dung CUNG so khoi
    brfalse/br/nhan (if don gian hon ternary: KHONG can temp-local/hop
    nhat gia tri vi statement khong tao gia tri tren stack, chi co
    nhanh/nhay).

    Phase 0 dispatch-table: than ham chi con la vong lap mong tra cuu
    STMT_CODEGEN[kind] - logic that nam trong cac ham _stmt_XXX phia
    duoi, dang ky qua register_stmt_codegen() luc module nap. GIU
    NGUYEN loi (khong them raise khi kind la) so voi ban if/elif cu -
    day la 1 lo hong co san, ngoai pham vi refactor nay."""
    source_path_il = ctx.get('source_path_il')
    for stmt in stmts:
        if source_path_il and stmt.get('src_line'):
            body.append(f"    .line {stmt['src_line']} '{source_path_il}'")
        fn = STMT_CODEGEN.get(stmt['kind'])
        if fn:
            fn(stmt, scope, body, body_dtype, ctx, sig, _codegen_stmts)


