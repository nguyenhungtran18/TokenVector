# _fpp_for/_fpp_while_if/_fpp_try da chuyen sang il_features/control_flow.py
# (fpp_for/fpp_while_if/fpp_try), Phase 1 buoc 9, 2026-07-28.


def _fpp_assign_scalar(stmt, ctx):
    infer_scope = ctx['infer_scope']
    name = stmt['name']
    if name not in infer_scope._d:
        rhs_node = stmt['rhs_node']
        records = ctx['records']
        if records and rhs_node[0] == 'call' and rhs_node[1] in records:
            infer_scope.set(name, TypeAnn(rhs_node[1], 'record'))
        elif rhs_node[0] == 'index' and _index_src_is_nested_container(rhs_node[1], infer_scope):
            # Giong nhanh trong declare_scalar (xem docstring o do) - can
            # lap lai o day vi _fpp_assign_scalar la 1 PRESCAN rieng cho
            # tham chieu xuoi (vd bien dung truoc khai bao trong nhanh
            # if/else), khong dung chung code voi declare_scalar.
            _, _, outer_ta = infer_scope[rhs_node[1]]
            infer_scope.set(name, outer_ta.elem_ta)
        elif _shaped_return_ta_of_call(rhs_node, ctx['func_table'], infer_scope,
                                        ctx.get('records')) is not None:
            infer_scope.set(name, _shaped_return_ta_of_call(rhs_node, ctx['func_table'],
                                                            infer_scope, ctx.get('records')))
        else:
            try:
                inferred = (_infer_dtype(rhs_node, infer_scope, ctx['func_table'], records, ctx['record_methods'])
                            or _infer_literal_dtype(rhs_node) or ctx['body_dtype'])
            except KeyError:
                inferred = None
            if inferred:
                shape = 'record' if (records and inferred in records) else None
                infer_scope.set(name, TypeAnn(inferred, shape))


