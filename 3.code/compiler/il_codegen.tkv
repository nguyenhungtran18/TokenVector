# declare_scalar_int da chuyen sang il_features/control_flow.py (chi
# 'for' - fpw_for - dung, Phase 1 buoc 9, 2026-07-28).


class _DtypeOnlyScope:
    """Micro-scope CHI de tra dtype (khong index) - dung cho _infer_dtype
    trong first-pass, TRUOC KHI _Scope THAT duoc xay (can khai bao local
    xong moi biet idx). Tuong thich cach _infer_dtype truy cap
    scope[name][2].dtype giong _Scope that."""

    def __init__(self):
        self._d = {}

    def __contains__(self, name):
        return name in self._d

    def __getitem__(self, name):
        return ('local', None, self._d[name])

    def get(self, name, default=None):
        return ('local', None, self._d[name]) if name in self._d else default

    def set(self, name, type_ann):
        self._d[name] = type_ann


# _find_first_append_dtype da chuyen sang il_features/list_type.py's
# find_first_append_dtype() - Phase 1 buoc 1 (2026-07-28) - dung chung
# boi ca list/set (set truyen kind='set_add').


# _find_first_dict_assign_dtypes da chuyen sang il_features/dict_type.py's
# find_first_dict_assign_dtypes (Phase 1 buoc 2, 2026-07-28).


# _contains_break_continue/_contains_return da chuyen sang
# il_features/control_flow.py (Phase 1 buoc 9, 2026-07-28).


def tkvint_class_il():
    """Cac dong '.class TkvInt' o muc TOP-LEVEL, cho nhung noi TU RAP file
    .il (tokenvector_compile.compile_model, alphaai_codegen) thay vi di
    qua gen_il_program. Tu 2026-08-05 hang so nguyen mac dinh la 'int' nen
    hau nhu ham nao cung tham chieu TkvInt::*; thieu dinh nghia thi ilasm
    bao 'Reference to undefined class TkvInt' - loi THAT o ca hai cho tren."""
    blocks = []
    _int_type.ensure_class({'emitted_types': set(), 'extra_classes': blocks})
    return [line for block in blocks for line in block]


def _container_arg_hints(stmts, func_table, sig=None):
    """Ten bien -> TypeAnn CONTAINER ma no BAT BUOC phai co, suy tu cho no
    duoc dung lam THAM SO (2026-08-05, lat 4).

    Ly do ton tai: tu khi hang so nguyen mac dinh la 'int', 'xs = [1, 2,
    3]' sinh List<TkvInt>. Neu ngay sau do 'xs' duoc truyen vao mot ham
    khai bao 'lst: "list[i32]"' thi hai kieu KHONG khop, va - day moi la
    phan te - khong co duong ep kieu nao cho container: chuyen doi doi
    hoi chep ca list. Truoc ban va nay, IL sinh ra van assemble duoc va
    chuong trinh nem BadImageFormatException / OverflowException voi mot
    chi so rac luc CHAY (loi THAT: il_reserved_name_test, list_return_test).

    Nen chu thich cua ham nhan DUOC UU TIEN hon phong doan tu hang so:
    chu thich la y muon TUONG MINH cua nguoi viet, hang so thi khong.
    Chi ap dung cho tham so CONTAINER - vo huong da co thu hep co kiem
    tra qua _widen_if_needed, khong can (va khong nen) doan truoc."""
    hints = {}

    # 'return result' trong mot ham khai bao '-> "list[i32]"': chinh chu
    # thich TRA VE la y muon tuong minh, manh hon phong doan tu hang so
    # ('result.append(1)' nay suy ra 'int'). Thieu nhanh nay, make_list()
    # dung List<TkvInt> o cho khai bao List<int32> - CLR doc struct nhu
    # mot con so va ToI32 nem "chi so int qua lon" (list_return_test).
    ret_ta = getattr(sig, 'return_type', None) if sig is not None else None
    if ret_ta is not None and ret_ta.shape in ('list', 'dict', 'set'):
        def visit_ret(stmt_list):
            for st in stmt_list:
                node = st.get('expr_node')
                if (st.get('kind') == 'return' and isinstance(node, tuple)
                        and len(node) >= 2 and node[0] == 'var'):
                    hints.setdefault(node[1], ret_ta)
                for key in ('body', 'else_body', 'finally_body'):
                    sub = st.get(key)
                    if sub:
                        visit_ret(sub)
                for _exc, hbody in st.get('handlers') or []:
                    visit_ret(hbody)
        visit_ret(stmts)

    if not func_table:
        return hints

    def visit(node):
        if isinstance(node, tuple):
            if len(node) >= 3 and node[0] == 'call':
                callee = func_table.get(node[1])
                args = node[2]
                if callee is not None and isinstance(args, (list, tuple)):
                    for arg, param in zip(args, callee.params):
                        pta = param.type_ann
                        if pta is None or pta.shape not in ('list', 'dict', 'set'):
                            continue
                        if isinstance(arg, tuple) and len(arg) >= 2 and arg[0] == 'var':
                            hints.setdefault(arg[1], pta)
                        elif (isinstance(arg, tuple) and len(arg) >= 3
                              and arg[0] == 'method_call' and isinstance(arg[1], str)):
                            # Goi TRUC TIEP, khong qua bien trung gian:
                            # 'f(d.keys())', 'f(xs.copy())'.
                            if arg[2] in ('keys', 'values'):
                                hints.setdefault(('__recv__', arg[2], arg[1]), pta.dtype)
                            elif arg[2] == 'copy':
                                hints.setdefault(arg[1], pta)
            for sub in node[1:]:
                visit(sub)
        elif isinstance(node, list):
            for item in node:
                visit(item)
        elif isinstance(node, dict):
            for value in node.values():
                visit(value)

    visit(stmts)

    # MOT mat xich nua: 'ks = d.keys()' roi 'f(ks)' voi f nhan
    # list[i32] - luc do KHOA cua 'd' phai la i32. Khong lan buoc nay thi
    # 'd[10] = "a"' suy khoa ra 'int' va Dictionary<TkvInt,string>.keys()
    # cho List<TkvInt> o cho can List<int32> (expr_recv_dependent_test).
    # Chi lan qua keys()/values(): hai method nay mang THANG kieu cua
    # nguoi nhan, khong bien doi gi.
    def visit_recv(stmt_list):
        for st in stmt_list:
            rhs = st.get('rhs_node')
            name = st.get('name')
            if (name in hints and isinstance(rhs, tuple) and len(rhs) >= 3
                    and rhs[0] == 'method_call' and rhs[2] in ('keys', 'values')
                    and isinstance(rhs[1], str)):
                hints.setdefault(('__recv__', rhs[2], rhs[1]), hints[name].dtype)
            for key in ('body', 'else_body', 'finally_body'):
                sub = st.get(key)
                if sub:
                    visit_recv(sub)
            for _exc, hbody in st.get('handlers') or []:
                visit_recv(hbody)
    visit_recv(stmts)
    return hints


def _first_pass_collect_locals(stmts, sig: Signature, body_dtype: str, func_table: dict = None,
                                records: dict = None, record_methods: dict = None,
                                extra_declared: dict = None):
    """Duyet cay Stmt (KHONG parse lai bieu thuc - da parse 1 lan trong
    _parse_block), khai bao local (.locals init) + temp cho ternary long
    nhau. Tra ve (locals_decl, tern_temp_of_id, needs_epilogue, boxed_names,
    nested_closures) - tern_temp_of_id khoa boi id(node AST ternary) vi
    CUNG 1 object se duoc dung lai o second-pass codegen (khong con can
    khop THU TU duyet nhu ban truoc).

    extra_declared (Buoc 4 - closure that, 2026-07-29): dict ten->TypeAnn
    CAC bien DA co san TRUOC KHI duyet (vd bien bi bat, tham chieu qua
    field cua closure - xem gen_il_function's closure_captures) - duoc
    XEM NHU DA khai bao (declared_names/infer_scope) nhung KHONG them vao
    locals_decl (khong can .locals rieng, chung khong phai local THAT su
    cua ham dang bien dich). boxed_names: tap ten cac local cua CHINH ham
    nay BI 1 ham long (kind='nested_def') BAT - xem il_features/closures.py's
    fpw_nested_def; nested_closures: dict ten ham long -> metadata (dung
    cho _expr_call/_infer_dtype nhan dien loi goi 'inc()' khong qua
    func_table thong thuong).

    Phase 0 dispatch-table: walk()/_pre_register_infer_scope() gio chi
    con la vong lap mong tra cuu FIRST_PASS_WALK/FIRST_PASS_PRESCAN theo
    kind - logic that nam trong cac ham _fpw_XXX/_fpp_XXX module-level
    phia duoi, dang ky luc module nap. KHAC voi _codegen_stmts/_compile_expr
    (handler nhan tham so RIENG LE) - o day cac ham _fpw_XXX/_fpp_XXX
    nhan 1 dict 'ctx' gom TOAN BO state dung chung (locals_decl/
    declared_names/infer_scope/declare_*/collect_ternary_temps/walk_fn/
    needs_epilogue) vi so luong tham so can thiet qua nhieu (>10) de liet
    ke rieng tung cai gon gang - CAC closure declare_scalar/declare_array/
    declare_list/declare_set/declare_dict/declare_named/collect_ternary_temps
    VAN dinh nghia O DAY (dong goi state locals_decl/declared_names/
    infer_scope dung chung) dung theo cam ket cua ke hoach da duyet - khong
    tach ra file rieng duoc neu khong tai cau truc lon hon (ngoai pham vi
    refactor nay). GIU NGUYEN loi walk() KHONG raise khi kind la (vd
    'break'/'continue' - khong co gi de quet ternary/khai bao) - giong
    _codegen_stmts, day la hanh vi CU, khong phai lo hong moi."""
    locals_decl = []
    tern_temp_of_id = {}
    needs_epilogue = [False]
    boxed_names = set()
    nested_closures = {}
    declared_names = set(p.name for p in sig.params)
    infer_scope = _DtypeOnlyScope()
    for p in sig.params:
        infer_scope.set(p.name, p.type_ann)
    for ex_name, ex_ta in (extra_declared or {}).items():
        declared_names.add(ex_name)
        infer_scope.set(ex_name, ex_ta)

    def declare_scalar(name, rhs_node):
        if name not in declared_names:
            if not walk_ctx.get('final_pass'):
                # Ve phai co the tham chieu 1 bien dang bi HOAN khai bao
                # (2026-08-03, dot 3) - vd 'ks = seen.keys()' khi 'seen'
                # con cho suy kieu. Hoan luon cau lenh nay, thu lai sau.
                try:
                    _probe_names_declared(rhs_node, infer_scope)
                except KeyError:
                    defer(lambda: declare_scalar(name, rhs_node))
                    return
            declared_names.add(name)
            if _record_is_record_ctor_rhs(rhs_node, records):
                # 'p = Point(1.0, 2.0)' - khai bao bien kieu record (KHONG
                # phai vo huong f32/i32/... thong thuong), xem 'call' trong
                # _compile_expr.
                ta = TypeAnn(rhs_node[1], 'record')
            elif rhs_node[0] == 'index' and _index_src_is_nested_container(rhs_node[1], infer_scope):
                # Wave 2 (2026-07-29), container long nhau: 'row = outer[i]'
                # khi 'outer' la List<List<T>>/List<Dict<K,V>> - phan tu
                # DOC RA cung la 1 container (khong phai vo huong), tai
                # dung THANG elem_ta cua 'outer' lam TypeAnn cua 'row' (2
                # bien tro CHUNG 1 "hinh dang" kieu, dung cach il_type_str
                # tinh IL type se khop nhau tu dong).
                _, _, outer_ta = infer_scope[rhs_node[1]]
                ta = outer_ta.elem_ta
            elif _shaped_return_ta_of_call(rhs_node, func_table, infer_scope, records) is not None:
                ta = _shaped_return_ta_of_call(rhs_node, func_table, infer_scope, records)
            else:
                # Suy dtype THAT tu ve phai (vd = "chuoi" -> 'str') thay vi
                # luon ep body_dtype - can THIET de 1 ham co the vua co bien
                # so vua co bien string (xem _infer_dtype).
                inferred = (_infer_dtype(rhs_node, infer_scope, func_table, records, record_methods,
                                          nested_closures)
                            or _infer_literal_dtype(rhs_node) or body_dtype)
                if inferred == 'i32' and body_dtype == 'int':
                    # 'total = 1' trong 1 ham khai bao '-> int': hang so
                    # nguyen KHONG co do rong co dinh (xem _infer_literal_dtype)
                    # nen 'i32' chi la phong doan mac dinh. Trong ngu canh
                    # 'int' (vo han chu so) phong doan dung phai la 'int' -
                    # neu khong thi 'total = total * i' tran im lang y het
                    # truoc khi co kieu 'int', tuc tinh nang moi vo dung.
                    inferred = 'int'
                # 'p = points[i]' / 'for p in points:' (macro mo rong thanh
                # 'p = points[__idx]') - khoang trong ngon ngu #2, List
                # chua record: dtype suy duoc CO THE la ten 1 record (khi
                # doc phan tu tu 1 list-cua-record) - phai gan shape=
                # 'record' (KHONG phai None) de 'p.field'/'p.method()' sau
                # do dung duoc, khac truong hop vo huong thong thuong.
                shape = 'record' if (records and inferred in records) else None
                ta = TypeAnn(inferred, shape)
            locals_decl.append((name, ta))
            infer_scope.set(name, ta)
        else:
            if name in infer_scope:
                try:
                    _, _, existing_ta = infer_scope[name]
                    new_dtype = (_infer_dtype(rhs_node, infer_scope, func_table, records, record_methods, nested_closures)
                                 or _infer_literal_dtype(rhs_node))
                    if new_dtype and existing_ta.dtype != 'object' and new_dtype != existing_ta.dtype:
                        obj_ta = TypeAnn('object', None)
                        infer_scope.set(name, obj_ta)
                        for idx, (loc_name, loc_ta) in enumerate(locals_decl):
                            if loc_name == name:
                                locals_decl[idx] = (name, obj_ta)
                                break
                except Exception:
                    pass

    def declare_array(name, type_ann):
        if name not in declared_names:
            declared_names.add(name)
            locals_decl.append((name, type_ann))
            infer_scope.set(name, type_ann)

    def declare_named(name, ta):
        """Khai bao 1 local voi TypeAnn DA BIET SAN (khong can suy dtype
        tu bieu thuc) - dung cho key_var/val_var cua 'for k, v in d.items():'
        (dtype lay THANG tu dict_ta.key_dtype/dtype) va cac local AN (hidden)
        enumerator/KeyValuePair (ten DUY NHAT qua id(stmt), khong trung ten
        nguoi dung nen khong can kiem tra declared_names)."""
        if name not in declared_names:
            declared_names.add(name)
            locals_decl.append((name, ta))
            infer_scope.set(name, ta)

    def collect_ternary_temps(expr_node):
        """Ten giu NGUYEN (30+ noi goi trong il_features/*.py) nhung tu
        Giai doan 0.2 nhom 3 (2026-08-03) lam THEM 1 viec: cap phat hidden
        local cho cac method can vong lap ('s.count(x)'/'s.title()'/
        's.zfill(n)') - xem EXPR_METHOD_TEMPS trong il_dispatch.py. Moc o
        DAY vi day la diem DUY NHAT da duoc goi tu MOI vi tri co bieu thuc
        (return/gan/dieu kien if-while/bien vong lap/doi so ham) - them
        moc moi rieng se bo sot vi tri."""
        _declare_slice_temps(expr_node, {'declare_named': declare_named,
                                         'TypeAnn': TypeAnn})
        for tern_node in _walk_ternaries_preorder(expr_node):
            tern_temp_of_id[id(tern_node)] = len(locals_decl)
            t_dtype = (_infer_dtype(tern_node, infer_scope, func_table, records, record_methods) or body_dtype)
            locals_decl.append((f'__tern{len(tern_temp_of_id)}', TypeAnn(t_dtype, None)))
        for div_node in _walk_intdiv_nodes(expr_node):
            # '//' va '%' tren SO NGUYEN can 4 o nho de sinh dung ngu
            # nghia floor cua Python (2026-08-03) - xem compile_binop.
            # Dtype suy tu chinh toan hang; khong suy duoc (tham chieu
            # xuoi) thi bo qua, pass 2 se bao loi RO RANG.
            d = (_infer_dtype(div_node[2], infer_scope, func_table, records, record_methods) or
                 _infer_dtype(div_node[3], infer_scope, func_table, records, record_methods))
            if d not in _INT_DTYPES:
                continue
            for suffix in ('a', 'b', 'q', 'r'):
                declare_named(f'__idiv{id(div_node)}_{suffix}', TypeAnn(d, None))
        for call_node in _walk_call_nodes(expr_node):
            if call_node[0] == 'call':
                # Nhom 7 (2026-08-03): builtin dang ham ('json_dumps(lst)')
                # cung can hidden local - truoc do chi 'method_call' co moc.
                temps_fn = EXPR_BUILTIN_TEMPS.get(call_node[1])
                if temps_fn:
                    temps_fn(call_node, walk_ctx)
                continue
            try:
                _, _, obj_ta = infer_scope[call_node[1]]
            except KeyError:
                # Bien chua khai bao tai diem nay (tham chieu xuoi) -
                # best-effort bo qua, GIONG quy uoc da co cua
                # find_first_append_dtype; loi that (neu co) se lo ra RO
                # RANG o pass 2 khi tra cuu scope.
                continue
            temps_fn = EXPR_METHOD_TEMPS.get((_shape_key(obj_ta), call_node[2]))
            if temps_fn:
                temps_fn(call_node, walk_ctx)

    def walk(stmt_list):
        for stmt in stmt_list:
            fn = FIRST_PASS_WALK.get(stmt['kind'])
            if fn:
                fn(stmt, walk_ctx)

    # HOAN khai bao (2026-08-03, dot 3): 1 container co the CHUA suy duoc
    # kieu tai luc gap no vi manh moi nam o BIEN KHAI BAO SAU (vd
    # 'labels = []' roi 'for sh in shapes: labels.append(sh.label())' -
    # 'sh' chua co trong infer_scope). Truoc day cho nay am tham lay
    # body_dtype (kieu TRA VE cua ham) lam kieu phan tu - nguon cua 5 bug
    # sai am tham. Nay: hoan lai, thu lai SAU KHI di het than ham, luc do
    # moi bien khac da co kieu. Chi bao loi khi da het cach.
    deferred = []

    def defer(fn):
        deferred.append(fn)

    walk_ctx = {
        'locals_decl': locals_decl, 'declared_names': declared_names, 'infer_scope': infer_scope,
        'func_table': func_table, 'records': records, 'body_dtype': body_dtype, 'sig': sig,
        # record_methods (2026-08-03): can cho find_first_append_dtype suy
        # duoc 'lst.append(obj.method())' - thieu no thi list chua record
        # bi khai bao nham theo body_dtype.
        'record_methods': record_methods,
        'declare_scalar': declare_scalar, 'declare_array': declare_array,
        'declare_named': declare_named,
        'collect_ternary_temps': collect_ternary_temps, 'walk_fn': walk,
        'defer': defer, 'final_pass': False,
        'needs_epilogue': needs_epilogue,
        # Tiem them cho list_type.declare_list/set_type.declare_set (Phase
        # 1 buoc 1, 2026-07-28) - cac ham nay o file rieng, khong the
        # import truc tiep _infer_dtype/_contains_float_literal/_INT_DTYPES
        # (circular import), nen nhan qua ctx nhu moi core-callable khac.
        'stmts': stmts, 'infer_dtype': _infer_dtype, 'infer_literal_dtype': _infer_literal_dtype,
        'container_arg_hints': _container_arg_hints(stmts, func_table, sig),
        'contains_float_literal': _contains_float_literal, 'int_dtypes': _INT_DTYPES,
        'TypeAnn': TypeAnn,
        # Closure that (Buoc 4, 2026-07-29) - xem il_features/closures.py's
        # fpw_nested_def/codegen_nested_def.
        'boxed_names': boxed_names, 'nested_closures': nested_closures,
        'cell_class_name': _cell_class_name,
    }

    def _pre_register_infer_scope(stmt_list):
        """Dang ky TRUOC ca bien vong lap 'for' LAN bien vo huong thuong
        (assign_scalar) vao infer_scope (CHI de tra dtype, KHONG dung
        locals_decl/declared_names - viec do van do walk() lam DUNG THU
        TU sau) - can THIET vi declare_list/declare_dict (goi tu walk()
        khi gap 'lst = []'/'d = {}') quet CA CAY tim '.append(...)'/
        'd[k]=...' DAU TIEN, co the roi TOI 1 bien duoc gan o NAM SAU
        trong cay (vd trong than 1 'for') truoc khi walk() tuan tu kip
        dang ky bien do - 2 bug that tim thay 2026-07-28 tu AI-port:
        (1) 'lst.append(i)' voi 'i' la bien vong lap for, (2) 'd[c]=1'
        voi 'c' la 1 bien thuong gan trong cung than for ('c = s[i]').
        Suy dtype o day dung CHINH XAC logic cua declare_scalar (best-
        effort, fallback body_dtype) - khi walk() thuc su chay toi cung
        statement do, no tinh lai y HET (idempotent, khong dang ky trung
        vao locals_decl vi declared_names van rieng)."""
        for st in stmt_list:
            fn = FIRST_PASS_PRESCAN.get(st['kind'])
            if fn:
                fn(st, prescan_ctx)

    prescan_ctx = {
        'infer_scope': infer_scope, 'func_table': func_table, 'records': records,
        'record_methods': record_methods, 'body_dtype': body_dtype, 'prescan_fn': _pre_register_infer_scope,
    }

    _pre_register_infer_scope(stmts)
    # LUOT 0 (2026-08-03, dot 3): di 1 luot "do thu", CHI de bom kieu cua
    # cac bien vao infer_scope roi VUT BO moi khai bao. Nho vay luot that
    # ben duoi khong con phu thuoc THU TU xuat hien: 'seen[w] = ...' suy
    # duoc kieu khoa du 'w' la bien vong lap khai bao sau; 'labels.append(
    # sh.label())' suy duoc kieu phan tu du 'sh' khai bao sau. Truoc day
    # cho nay am tham lay body_dtype (kieu TRA VE cua ham) lam kieu -
    # nguon cua 5 bug sai am tham trong 1 phien. Moi loi o luot 0 deu bo
    # qua: no chi la phong doan, luot THAT ben duoi moi la noi bao loi.
    _probe_declared = set(declared_names)
    _probe_locals = list(locals_decl)
    try:
        walk(stmts)
    except Exception:
        pass
    deferred = []
    declared_names.clear()
    declared_names.update(_probe_declared)
    locals_decl[:] = _probe_locals
    tern_temp_of_id.clear()
    needs_epilogue[0] = False
    boxed_names.clear()
    nested_closures.clear()

    walk(stmts)
    while deferred:
        pending, deferred = deferred, []
        before = len(pending)
        for fn in pending:
            fn()
        if len(deferred) >= before:
            # Khong tien trien them - vong sau se chay o che do 'cuoi cung'
            # (cac declare_* se nem loi RO RANG thay vi hoan tiep).
            walk_ctx['final_pass'] = True
            for fn in deferred:
                fn()
            deferred = []
    if needs_epilogue[0]:
        # __ret_tmp: bien tam giu gia tri tra ve khi 'return' xay ra BEN
        # TRONG try/except (xem _contains_return o tren) - CHI khai bao khi
        # THAT SU can, tranh local thua cho ham khong dung try/except.
        ret_ta = sig.return_type if sig.return_type is not None else TypeAnn(body_dtype, None)
        locals_decl.append(('__ret_tmp', ret_ta))
        infer_scope.set('__ret_tmp', ret_ta)
    # Local NHAP cho kieu 'int' (moc 6 buoc 2, 2026-08-05): duong nhanh
    # cua +/-/* PHAI noi tuyen (ket luan dat nhat cua spike 1) nen no can
    # cho do toan hang - 4 local dung CHUNG cho ca ham, chi cap phat khi
    # ham THAT SU dung 'int'. Xem il_features/int_type.py.
    #
    # 2026-08-05 (lat 4 - 'int' thanh mac dinh toan cuc): cap phat VO DIEU
    # KIEN. Dieu kien "ham nay co dung 'int' khong" tinh tu tham so/kieu
    # tra ve/local KHONG the dung duoc nua vi no bo sot moi truong hop
    # gian tiep: ham long BAT mot cell 'int' (loi THAT: "bien
    # '__tkvint_b' chua duoc khai bao"), phan tu list[int], gia tri dict.
    # Bon local thua trong mot ham khong dung 'int' re hon nhieu so voi
    # mot dieu kien khong bao gio du.
    if True:
        for _sname, _sdtype in _int_type.scratch_locals():
            if _sname not in declared_names:
                declared_names.add(_sname)
                _sta = TypeAnn(_sdtype, None)
                locals_decl.append((_sname, _sta))
                infer_scope.set(_sname, _sta)
    return locals_decl, tern_temp_of_id, needs_epilogue[0], boxed_names, nested_closures


# _fpw_for/_fpw_while/_fpw_if/_fpw_try/_fpw_return/_fpw_raise da chuyen
# sang il_features/control_flow.py (Phase 1 buoc 9, 2026-07-28).


def _fpw_idx_assign(stmt, ctx):
    for idx_node in stmt['idx_nodes']:
        ctx['collect_ternary_temps'](idx_node)
    ctx['collect_ternary_temps'](stmt['rhs_node'])


# _fpw_attr_assign da chuyen sang il_features/record_feature.py's
# fpw_attr_assign (Phase 1 buoc 8, 2026-07-28).


def _declare_slice_temps(node, ctx):
    """Khai bao local an '__slice<id>_start' cho MOI node 'slice' nam bat
    ky dau trong cay bieu thuc (khong chi khi slice la node goc cua RHS).
    Can tu 2026-08-03 khi '<bieu thuc>.method(...)' cho phep viet
    's[i:j].strip()' - slice luc do nam LONG ben trong, nhanh cu bo sot
    va gay 'bien __sliceN_start chua duoc khai bao' luc codegen."""
    if not isinstance(node, tuple):
        return
    if node and node[0] == 'slice':
        ctx['declare_named'](f'__slice{id(node)}_start', ctx['TypeAnn']('i32', None))
        ctx['declare_named'](f'__slice{id(node)}_stop', ctx['TypeAnn']('i32', None))
        ctx['declare_named'](f'__slice{id(node)}_count', ctx['TypeAnn']('i32', None))
    for sub in node:
        if isinstance(sub, tuple):
            _declare_slice_temps(sub, ctx)
        elif isinstance(sub, list):
            for item in sub:
                _declare_slice_temps(item, ctx)


def _probe_names_declared(node, infer_scope):
    """Nem KeyError neu cay bieu thuc tham chieu 1 TEN chua co trong
    infer_scope - dung de biet co nen HOAN khai bao lai hay khong
    (2026-08-03, dot 3). Chi xet cac tag mang ten bien o node[1]."""
    if not isinstance(node, tuple):
        return
    if node and node[0] in ('var', 'attr', 'method_call', 'index', 'slice', 'shape', 'in'):
        if isinstance(node[1], str):
            infer_scope[node[1]]
    for sub in node[1:]:
        if isinstance(sub, tuple):
            _probe_names_declared(sub, infer_scope)
        elif isinstance(sub, list):
            for item in sub:
                _probe_names_declared(item, infer_scope)


def _fpw_assign_scalar(stmt, ctx):
    ctx['declare_scalar'](stmt['name'], stmt['rhs_node'])
    ctx['collect_ternary_temps'](stmt['rhs_node'])


def _fpw_assign_typed_decl(stmt, ctx):
    # Phase 3.3 (2026-08-11) - kieu DA BIET SAN tu chinh cu phap khai bao
    # ('name: "func(...)->..." = ...'), khong can suy tu ve phai nhu
    # declare_scalar - dung declare_named CO SAN (da dung cho key_var/
    # val_var cua dict.items()/local an).
    ctx['declare_named'](stmt['name'], stmt['type_ann'])
    if stmt['type_ann'].shape == 'defaultdict':
        # Phase 3.2 (2026-08-11): can 1 local AN de giu delegate factory
        # (System.Func`1<V>) tach khoi chinh Dictionary<K,V> - xem
        # il_features/defaultdict_type.py's compile_assign_defaultdict_new.
        ctx['declare_named'](f'__defaultdict_factory_{stmt["name"]}',
                              TypeAnn(stmt['type_ann'].dtype, 'func', func_params=[]))
    ctx['collect_ternary_temps'](stmt['rhs_node'])


def _fpw_assign_zeros1d(stmt, ctx):
    ctx['declare_array'](stmt['name'], TypeAnn(ctx['body_dtype'], [stmt['dim']]))


def _fpw_assign_zeros2d(stmt, ctx):
    ctx['declare_array'](stmt['name'], TypeAnn(ctx['body_dtype'], [stmt['dim0'], stmt['dim1']]))


