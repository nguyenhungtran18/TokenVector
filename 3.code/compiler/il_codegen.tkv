_CELL_CLASS_NAMES = {'i32': 'I32Cell', 'i64': 'I64Cell', 'f32': 'F32Cell',
                      'f64': 'F64Cell', 'str': 'StrCell', 'int': 'IntCell'}


def _cell_class_name(dtype: str) -> str:
    return _CELL_CLASS_NAMES[dtype]


# _EXTERN_CLASS_DEFS (Task 2, extern-class, 2026-08-18): bien module-level
# TAM THOI, set/reset (finally-pop, giong het pattern EXPR_BUILTIN_CODEGEN/
# EXPR_BUILTIN_DTYPE o il_dispatch.py) boi tkv_compile.py's compile_tkv_cli
# NGAY TRUOC gen_il_program moi luot compile - ten handle-type ->
# decl dict goc cua pragma ({'name','assembly','class','ctor','methods'}).
# Ly do dung bien module-level thay vi them tham so 'ctx'/'extern_class_defs'
# vao il_type_str: ham nay co TOI 85 diem goi (records: dict truyen VI TRI,
# khong phai qua 1 ctx dict) rai khap il_codegen.py/il_features/*.py - sua
# chu ky se phai doi CA 85 diem goi, rui ro cao/cong suc lon so voi loi
# ich (chi 1 nhanh moi can doc them 1 bang tra cuu). KHONG tu reset giua 2
# lan goi compile_tkv_cli trong CUNG process - caller PHAI tu pop trong
# finally (xem tkv_compile.py's compile_tkv_cli, cung khoi finally voi
# EXPR_BUILTIN_CODEGEN/EXPR_BUILTIN_DTYPE).
_EXTERN_CLASS_DEFS = {}


def _il_scalar_or_handle(dtype):
    # muc P follow-up (2026-08-19): tra kieu IL cho 1 dtype co the la vo
    # huong (qua IL_SCALAR) HOAC 1 handle type extern-class (qua
    # _EXTERN_CLASS_DEFS) - dung o CA 2 noi tinh chu ky tham so/tra ve cua
    # 1 'func' reference: il_type_str's shape=='func' (kieu Func`N cua bien
    # 'func') VA _compile_funcref_arg (chu ky ldftn khi truyen thang 1 ten
    # ham lam callback, vd map(to_str, xs: list[Sb])) - ca 2 truoc day deu
    # tra thang IL_SCALAR[dtype], nem KeyError voi handle type.
    elem = IL_SCALAR.get(dtype)
    if elem is not None:
        return elem
    if _EXTERN_CLASS_DEFS and dtype in _EXTERN_CLASS_DEFS:
        d = _EXTERN_CLASS_DEFS[dtype]
        return f"class [{d['assembly']}]{d['class']}"
    raise SyntaxError(
        f"il_codegen: kieu {dtype!r} khong hop le cho tham so/tra ve cua "
        f"'func(...)' - phai la dtype vo huong hoac 1 handle type da khai "
        f"qua __tkv_extern_class__")


def il_type_str(type_ann: TypeAnn, records: dict = None) -> str:
    # Wave 2 (2026-07-29) - container long nhau: khi elem_ta duoc gan (List
    # chua List/Dict khac, hoac Dict co GIA TRI la List/Dict khac), DE QUY
    # goi lai chinh minh de tinh kieu IL cua phan tu/gia tri long ben trong,
    # thay vi tra thang qua il_list_type/il_dict_type (2 ham do CHI nhan
    # dtype vo huong/ten record - khong bieu dien duoc 1 container khac).
    if type_ann.shape == 'list':
        if type_ann.elem_ta is not None:
            inner = il_type_str(type_ann.elem_ta, records)
            return f'class [mscorlib]System.Collections.Generic.List`1<{inner}>'
        return il_list_type(type_ann.dtype, records, _EXTERN_CLASS_DEFS)
    if type_ann.shape in ('bytearray', 'bytes'):
        # muc 6.8 (3/4 va 4/4, 2026-08-13): List<uint8> - CHI khac List<i32>
        # cua list[i32] o KICH THUOC phan tu, xem bytearray_type.py/
        # bytes_type.py dau file. 'bytes' TAI DUNG NGUYEN VEN kieu IL nay
        # (chi khac o cach tao - unroll hang so, va o cho .append() bi chan).
        return _il_bytearray_type()
    if type_ann.shape in ('set', 'frozenset'):
        return il_set_type(type_ann.dtype, records, _EXTERN_CLASS_DEFS)
    if type_ann.shape == 'file':
        return _il_file_type(type_ann.dtype)
    if type_ann.shape == 'strbuf':
        # Local AN cho phep don chuoi trong vong lap (il_features/
        # str_accum.py) - khong bao gio la kieu do NGUOI DUNG viet ra.
        return 'class [mscorlib]System.Text.StringBuilder'
    if type_ann.shape in ('dict', 'defaultdict', 'counter'):
        # 'defaultdict'/'counter' (Phase 3.2, 2026-08-11): vat ly VAN LA
        # Dictionary<K,V> giong het 'dict' - chi khac hanh vi doc chi so
        # bi thieu (xem il_features/defaultdict_type.py, counter_type.py)
        # - CHUA ho tro long nhau (gia tri luon vo huong, khac 'dict' co
        # the long qua elem_ta).
        if type_ann.elem_ta is not None:
            inner = il_type_str(type_ann.elem_ta, records)
            # Final-review round 3 (docs/BUGS_TODO.md muc F, 2026-08-20):
            # truoc day tra IL_SCALAR[type_ann.key_dtype] TRUC TIEP, nem
            # KeyError THO neu key_dtype khong hop le - khac cach
            # il_container_type_of_spec (list_type.py) xu ly tinh huong
            # tuong duong bang SyntaxError ro rang. Doi sang
            # il_list_elem_ilstr (khoi xay dung CHUNG, da import san dong
            # 40) - cho input hop le (key luon scalar, bat bien ngon ngu)
            # cho KET QUA GIONG HET (IL_SCALAR.get(dtype) la nhanh DAU
            # TIEN cua ham do); cho input khong hop le, gio bao loi ro
            # rang thay vi KeyError kho hieu.
            key = il_list_elem_ilstr(type_ann.key_dtype, records, _EXTERN_CLASS_DEFS)
            return f'class [mscorlib]System.Collections.Generic.Dictionary`2<{key}, {inner}>'
        return il_dict_type(type_ann.key_dtype, type_ann.dtype, records, _EXTERN_CLASS_DEFS)
    if type_ann.shape == 'dict_enumerator':
        # Task 3 (extern-class-dict, 2026-08-19): truoc day thieu
        # _EXTERN_CLASS_DEFS o day khien khai bao local AN
        # '__dictiter{id}_en' (dict_type.py's fpw_for_in_dict_items) nem
        # KeyError khi V=HandleType - day la duong goi THAT SU khi
        # _local_il_type (il_codegen.py's gen_il_function) tinh kieu IL cho
        # locals_decl, khac han dict_type.py's codegen_for_in_dict_items
        # (dung truc tiep il_dict_enumerator_type voi extern_class_defs).
        return il_dict_enumerator_type(type_ann.key_dtype, type_ann.dtype, _EXTERN_CLASS_DEFS)
    if type_ann.shape == 'dict_kvpair':
        return il_kvpair_type(type_ann.key_dtype, type_ann.dtype, _EXTERN_CLASS_DEFS)
    if type_ann.shape == 'tuple':
        return il_tupleN_type(type_ann.tuple_dtypes)
    if type_ann.shape == 'record':
        # B1 (2026-07-29): doi tu 'valuetype' (struct) sang 'class' (reference
        # type) - can thiet de ho tro ke thua/da hinh THAT (struct KHONG the
        # ke thua lan nhau trong CIL/CLR, xem spike probe_inheritance.il).
        return f'class {type_ann.dtype}'  # type_ann.dtype = ten class record
    if type_ann.shape == 'extern_class':
        # Task 2 (extern-class, 2026-08-18): handle-type .NET NGOAI, khac
        # 'record' o cho assembly-qualified (class do compiler TU SINH
        # khong can, class .NET co san BAT BUOC can [assembly]Ten.Day.Du).
        decl = _EXTERN_CLASS_DEFS[type_ann.dtype]
        return f"class [{decl['assembly']}]{decl['class']}"
    if type_ann.shape == 'regex_match':
        # json_get_str (2026-07-30, xem il_features/stdlib_json_get.py) -
        # local AN giu 1 doi tuong System.Text.RegularExpressions.Match
        # (reference type, khong can dia chi).
        return 'class [System]System.Text.RegularExpressions.Match'
    if type_ann.shape == 'regex_matches':
        # re_findall (batch 5.5b, 2026-08-12) - local AN giu 1 doi tuong
        # System.Text.RegularExpressions.MatchCollection (reference type),
        # can Count + indexer de duyet trich .Value tung Match.
        return 'class [System]System.Text.RegularExpressions.MatchCollection'
    if type_ann.shape == 'generator':
        # Generator LAZY THAT (Wave 3, 2026-07-29, thay the hoan toan B2(c)'s
        # eager-list desugar - xem gen_il_generator_function/project-
        # tokenvector-wave2-status memory). type_ann.dtype = TEN CLASS
        # state-machine da sinh (quy uoc giong 'record'/'refclass': dtype
        # la ten class, khong phai dtype vo huong).
        return f'class {type_ann.dtype}'
    if type_ann.shape == 'refclass':
        # Closure that (Buoc 4): 1 THAM CHIEU toi 1 class REFERENCE TYPE tu
        # sinh (cell/closure) - type_ann.dtype = ten class do, giong quy uoc
        # 'record' o tren nhung dung 'class' (khong phai 'valuetype').
        return f'class {type_ann.dtype}'
    if type_ann.shape == 'func':
        # "Function reference" hep (Wave 3, 2026-07-29) - System.Func`N co
        # san trong System.Core (KHONG phai mscorlib - xac minh THAT qua
        # spike_funcref.il, xem plan indexed-meandering-lampson.md). N =
        # so tham so + 1 (tra ve). Goi Invoke() PHAI dung ky hieu generic
        # mo (!0/!1/...), KHONG thay truc tiep dtype - thay truc tiep vao
        # chu ky Invoke se assemble duoc nhung nem MissingMethodException
        # luc CHAY (da xac nhan qua spike doc lap).
        #
        # muc P follow-up (2026-08-19): callback nhan/tra handle type (vd
        # 'f: func(Sb)->str' dung trong map(f, xs: list[Sb])) can fallback
        # qua _EXTERN_CLASS_DEFS - xem _il_scalar_or_handle dau file.
        n = len(type_ann.func_params)
        parts = [_il_scalar_or_handle(p) for p in type_ann.func_params] + [_il_scalar_or_handle(type_ann.dtype)]
        return f'class [System.Core]System.Func`{n + 1}<{", ".join(parts)}>'
    if type_ann.shape is None:
        if type_ann.dtype == 'Exception':
            # 'except BuiltinType as e:' voi BuiltinType KHONG phai record
            # tu dinh nghia (Phase 6.9/6.3, 2026-08-12, port tu cay .tkv
            # tu-host) - bien 'e' duoc khai bao dtype sentinel 'Exception'
            # (khong phai 1 class TokenVector THAT), anh xa thang sang
            # System.Exception (lop co san nhat, du de .Message hoat dong
            # voi MOI loai loi CLR).
            return 'class [mscorlib]System.Exception'
        if type_ann.dtype == 'type':
            # Phase 9d Part B (2026-08-27): dtype co dinh 'type' (System.
            # Type) - danh cho bien local nhan ket qua tra ve 1 method/
            # ctor extern-class co returns='type' (vd 1 bien giu
            # typeof(ClassName), Task 3). 'type' KHONG nam trong IL_SCALAR
            # (mirror y het nhanh 'enum:...' cua _il_ctor_param_type o
            # tren - short-circuit RIENG, TRANH sua IL_SCALAR/il_core.py,
            # Global Constraint cua plan Phase 9d Part B).
            return 'class [mscorlib]System.Type'
        # muc P follow-up (2026-08-19): 1 so duong suy dtype (vd bien nhan
        # ket qua choice(xs: list[Sb])) gan dtype='Sb' nhung KHONG gan lai
        # shape='extern_class' (van de o noi suy luan do, khong phai o day)
        # - fallback qua _EXTERN_CLASS_DEFS thay vi nem KeyError thang, xem
        # _il_scalar_or_handle dau file.
        return _il_scalar_or_handle(type_ann.dtype)
    return il_array_rank_type(type_ann.dtype, len(type_ann.shape))




def _walk_ternaries_preorder(node):
    """Duyet pre-order (nut cha truoc con) tim tat ca node 'ternary' long
    nhau trong 1 AST - dung CHUNG boi first-pass (khai bao temp local) va
    second-pass (codegen) de 2 ben gan chi so temp GIONG HET NHAU (khong
    dung id(node) vi 2 pass parse lai bieu thuc 2 lan, ra 2 object khac
    nhau du cung noi dung - dung THU TU duyet lam "khoa" chung thay vi
    danh tinh object)."""
    if not isinstance(node, tuple):
        return
    tag = node[0]
    if tag == 'ternary':
        yield node
        yield from _walk_ternaries_preorder(node[1])
        yield from _walk_ternaries_preorder(node[2])
        yield from _walk_ternaries_preorder(node[3])
    elif tag in ('binop', 'compare', 'boolop'):
        yield from _walk_ternaries_preorder(node[2])
        yield from _walk_ternaries_preorder(node[3])
    elif tag == 'in':
        yield from _walk_ternaries_preorder(node[1])
        yield from _walk_ternaries_preorder(node[2])
    elif tag == 'index':
        for idx_node in node[2]:
            yield from _walk_ternaries_preorder(idx_node)
    elif tag == 'index_expr':
        # '<bieu thuc>[i]' (2026-08-03) - PHAI duyet ca co so lan chi so,
        # neu khong thi method can bien an nam ben trong ('s.count(x)'...)
        # se khong duoc cap phat o first-pass.
        yield from _walk_ternaries_preorder(node[1])
        yield from _walk_ternaries_preorder(node[2])
    elif tag in ('neg', 'not'):
        yield from _walk_ternaries_preorder(node[1])
    elif tag == 'call':
        for arg_node in node[2]:
            yield from _walk_ternaries_preorder(arg_node)
    elif tag == 'method_call':
        for arg_node in node[3]:
            yield from _walk_ternaries_preorder(arg_node)
    # 'num' / 'var' / 'shape' / 'attr': khong co node con


def _shape_key(type_ann):
    """Khoa tra cuu EXPR_METHOD_* (Giai doan 0.2 nhom 3): container dung
    shape ('list'/'dict'/'set'), vo huong dung dtype ('str') - khop dung
    cach compile_method_call phan nhanh san (xem il_features/record_feature.py)."""
    return type_ann.shape or type_ann.dtype


def _walk_call_nodes(node):
    """Giai doan 0.2 nhom 3 (2026-08-03), mo rong o nhom 7: duyet tim MOI
    node 'method_call' VA 'call' trong 1 AST bieu thuc - de first-pass cap
    phat hidden local cho cac builtin/method can vong lap ('s.count(x)',
    'json_dumps(lst)'..., xem EXPR_METHOD_TEMPS/EXPR_BUILTIN_TEMPS trong
    il_dispatch.py). Caller loc theo node[0] de biet tra cuu registry nao.

    Cau truc de quy GIONG _walk_ternaries_preorder o tren (cung tap tag co
    node con) nhung giu RIENG 2 ham: ternary can THU TU pre-order de danh
    chi so temp, o day chi can DUYET HET - gop lai se ep 1 ben mang rang
    buoc cua ben kia."""
    if not isinstance(node, tuple):
        return
    tag = node[0]
    if tag == 'method_call':
        yield node
        for arg_node in node[3]:
            yield from _walk_call_nodes(arg_node)
    elif tag == 'call':
        yield node
        for arg_node in node[2]:
            yield from _walk_call_nodes(arg_node)
    elif tag == 'ternary':
        yield from _walk_call_nodes(node[1])
        yield from _walk_call_nodes(node[2])
        yield from _walk_call_nodes(node[3])
    elif tag in ('binop', 'compare', 'boolop'):
        yield from _walk_call_nodes(node[2])
        yield from _walk_call_nodes(node[3])
    elif tag == 'in':
        yield from _walk_call_nodes(node[1])
        yield from _walk_call_nodes(node[2])
    elif tag == 'index':
        for idx_node in node[2]:
            yield from _walk_call_nodes(idx_node)
    elif tag == 'index_expr':
        # '<bieu thuc>[i]' (2026-08-03) - PHAI duyet ca co so lan chi so,
        # neu khong thi method can bien an nam ben trong ('s.count(x)'...)
        # se khong duoc cap phat o first-pass.
        yield from _walk_call_nodes(node[1])
        yield from _walk_call_nodes(node[2])
    elif tag in ('neg', 'not'):
        yield from _walk_call_nodes(node[1])
    elif tag == 'list_literal':
        for el_node in node[1]:
            yield from _walk_call_nodes(el_node)


def _walk_intdiv_nodes(node):
    """Duyet tim moi node binop '//' hoac '%' trong 1 AST bieu thuc
    (2026-08-03). Chung can 4 hidden local de sinh dung ngu nghia FLOOR
    cua Python (xem compile_binop trong il_features/operators.py)."""
    if not isinstance(node, tuple):
        return
    tag = node[0]
    if tag == 'binop':
        if node[1] in ('//', '%'):
            yield node
        yield from _walk_intdiv_nodes(node[2])
        yield from _walk_intdiv_nodes(node[3])
    elif tag == 'ternary':
        yield from _walk_intdiv_nodes(node[1])
        yield from _walk_intdiv_nodes(node[2])
        yield from _walk_intdiv_nodes(node[3])
    elif tag in ('compare', 'boolop'):
        yield from _walk_intdiv_nodes(node[2])
        yield from _walk_intdiv_nodes(node[3])
    elif tag == 'in':
        yield from _walk_intdiv_nodes(node[1])
        yield from _walk_intdiv_nodes(node[2])
    elif tag == 'index':
        for idx_node in node[2]:
            yield from _walk_intdiv_nodes(idx_node)
    elif tag == 'index_expr':
        yield from _walk_intdiv_nodes(node[1])
        yield from _walk_intdiv_nodes(node[2])
    elif tag in ('neg', 'not'):
        yield from _walk_intdiv_nodes(node[1])
    elif tag == 'call':
        for arg_node in node[2]:
            yield from _walk_intdiv_nodes(arg_node)
    elif tag == 'method_call':
        for arg_node in node[3]:
            yield from _walk_intdiv_nodes(arg_node)
    elif tag == 'list_literal':
        for el_node in node[1]:
            yield from _walk_intdiv_nodes(el_node)



def _method_call_expr_receiver_ta(base_node, scope, func_table=None, records=None,
                                   record_methods=None):
    """TypeAnn DAY DU (dtype=ten class THUC + shape) cua NGUOI NHAN 1
    'method_call_expr' ('<base_node>.method(...)') - dung RIENG cho
    _infer_dtype's nhanh 'method_call_expr' (bug fix, 2026-08-28) de nhan
    dien duoc truong hop nguoi nhan la 1 extern-class (handle-type) lay ra
    tu 1 bieu thuc index ('row2[0].getValue()') thay vi chi la chuoi hang/
    ket qua ham nhu gia dinh ban dau cua tag nay. Tra None neu khong xac
    dinh duoc (caller fallback ve bang string-method nhu truoc)."""
    if not isinstance(base_node, tuple):
        return None
    tag0 = base_node[0]
    if tag0 == 'index':
        # 'row2[0]' - TypeAnn cua PHAN TU chinh la elem_ta cua TypeAnn khai
        # container (list[HandleType] luu elem_ta=TypeAnn(class,'extern_class'),
        # xem typed_dsl_parser.py's nhanh 'list'); container scalar thuong
        # (vd list[i32]) khong co elem_ta -> ghep tam TypeAnn(dtype, None).
        try:
            container_ta = scope[base_node[1]][2]
        except (KeyError, SyntaxError):
            return None
        if container_ta.shape == 'record':
            # Cung quy uoc voi nhanh 'index' o duoi (dong ~456): TypeAnn
            # cua 1 bien record LA TEN CLASS, khong phai dtype phan tu -
            # khong lien quan extern-class, tra None cho caller fallback.
            return None
        if container_ta.elem_ta is not None:
            return container_ta.elem_ta
        return TypeAnn(container_ta.dtype, None)
    if tag0 == 'index_expr':
        return _index_expr_result_ta(base_node, scope, func_table, records)
    # Boc try/except (dong bo voi _index_expr_result_ta dong ~1862 va
    # _compile_len_of_expr dong ~1887 - cung 1 loi goi _infer_dtype de quy
    # tren mot base_node BAT KY): receiver phuc tap (vd ket qua 1 method
    # call khac chua ho tro suy dtype) co the khien _infer_dtype raise loi
    # la (KeyError/SyntaxError tu scope tra cuu ben trong) thay vi tra None
    # gon gang - khong bat se lam lo traceback la ra ngoai caller thay vi
    # fallback an toan ve None nhu quy uoc cua ham nay.
    try:
        base_dtype = _infer_dtype(base_node, scope, func_table, records, record_methods)
    except Exception:
        base_dtype = None
    if base_dtype is None:
        return None
    if _EXTERN_CLASS_DEFS and base_dtype in _EXTERN_CLASS_DEFS:
        return TypeAnn(base_dtype, 'extern_class')
    return TypeAnn(base_dtype, None)


def _infer_dtype(node, scope, func_table=None, records=None, record_methods=None, nested_closures=None):
    """Suy ra dtype THAT cua 1 bieu thuc tu chinh no (khong dua vao dtype
    'boi canh' tu ben ngoai truyen vao) - can THEM khi them 'str' vao DSL,
    vi truoc day MOI bien vo huong trong 1 ham deu dung CHUNG 1 dtype
    (body_dtype) nen khong can suy luan; nay 1 ham co the vua co bien so
    (f32/...) vua co bien string, phai biet DUNG dtype cua TUNG bieu thuc
    con (vd toan hang cua '+'/so sanh) thay vi ep theo dtype cua ham. Tra
    ve None neu khong xac dinh duoc (vd so nguyen/thuc "boi hinh" - ldc
    van hoat dong voi bat ky dtype nao caller yeu cau, khong can suy ra)."""
    if not isinstance(node, tuple):
        return None
    tag = node[0]
    if tag == 'str_lit':
        return 'str'
    if tag == 'var':
        return scope[node[1]][2].dtype
    if tag == 'index':
        # 'r[i]' - mac dinh dtype PHAN TU chinh la dtype cua TypeAnn cua
        # container (dung cho list/mang - TypeAnn cua mang luu san dtype
        # PHAN TU, khong phai dtype cua ban than container). Rieng record
        # (__getitem__, 6.5 muc 4, 2026-08-13): TypeAnn.dtype cua 1 bien
        # record LA TEN CLASS ('Box'), khong phai dtype phan tu - phai tra
        # cuu qua record_methods['__getitem__'].return_type.dtype, neu
        # khong se tra ve sai 'Box' -> hidden temp local bi khai bao kieu
        # 'Box' (khong ton tai trong IL_SCALAR) -> KeyError luc gen locals_sig.
        container_ta = scope[node[1]][2]
        if container_ta.shape == 'record':
            if record_methods:
                dunder = record_methods.get(container_ta.dtype, {}).get('__getitem__')
                if dunder and dunder.return_type:
                    return dunder.return_type.dtype
            return None
        return container_ta.dtype
    if tag == 'method_call_expr':
        # B4 (2026-08-05, sua doc lap tren 2 nhanh, gop lai): TRUOC day CHI
        # '"sep".join(lst)' dung tag nay nen hardcode 'str' la du - tu khi
        # method_call_expr mo rong ho tro CA cac method khac tren BIEU
        # THUC nhan (vd 'f().find(x)', xem _compile_str_method_on_expr
        # trong il_features/string_join.py), hardcode nay sai AM THAM cho
        # find/startswith/endswith (tra ve i32, khong phai str) -
        # 'str(f().find(x))' vi vay tuong nham la "da la str roi" nen
        # KHONG sinh ma chuyen doi, cong i32 tho vao thang list[str]. Tra
        # cuu GIONG HET nhanh 'method_call' o duoi (dong ~554) - MOT
        # nguon su that duy nhat, khong hardcode rieng.
        #
        # Bug fix (2026-08-28): _POSTFIX_METHOD_BASES (il_core.py:479)
        # cho phep '.method()' di sau CA 1 'index' ('row2[0].getValue()',
        # row2: list[HandleType]) - node nay CUNG di qua tag
        # 'method_call_expr' (khong chi chuoi hang/ket qua ham nhu comment
        # cu gia dinh). Hardcode 'str' o tren SAI HOAN TOAN cho truong hop
        # nay: 'getValue' khong phai string-method nen roi vao nhanh mac
        # dinh 'str', khien 'call ... System.Console::WriteLine(string)'
        # duoc phat cho 1 gia tri i32 THAT tren stack -> ilasm khong kiem
        # tra generic argument nen van assemble duoc, runtime doc nham bit
        # int32 thanh string reference (NullReferenceException hoac in
        # dong trong). Phai tra cuu dung kieu THAT cua NGUOI NHAN truoc khi
        # fallback ve bang string-method: neu nguoi nhan la 1 extern-class
        # (handle-type khai qua __tkv_extern_class__, vd phan tu cua
        # list[HandleType] roi qua index), dung LAI CHINH bang tra cuu
        # EXPR_METHOD_SHAPE/EXPR_METHOD_DTYPE ma nhanh 'method_call' o duoi
        # (dong ~764) dung cho 'obj.Method()' thong thuong - MOT nguon su
        # that duy nhat, khong tu suy lai rieng o day.
        recv_ta = _method_call_expr_receiver_ta(node[1], scope, func_table, records, record_methods)
        if recv_ta is not None and recv_ta.shape == 'extern_class':
            # Finding 1 (review fix, 2026-08-28): mirror CHINH XAC guard cua
            # nhanh 'method_call' o duoi (dong ~819-829) - neu method la
            # 'returns':'void' THAT SU (khong co entry trong EXPR_METHOD_DTYPE/
            # EXPR_METHOD_SHAPE nhung DA dang ky trong EXPR_METHOD_CODEGEN) thi
            # phai bao loi RO RANG ngay tai day. Thieu guard nay: 'v =
            # r[0].Bump()' (Bump void, receiver la 1 phan tu index cua
            # list[HandleType]) compile SACH nhung declare_scalar fallback ve
            # body_dtype (return None roi xuong _STR_METHOD_RETURN_DTYPE cu bi
            # bo qua vi nhanh nay return truoc) - trong khi codegen_fn THAT SU
            # chi sinh 'callvirt instance void ...' (khong day gia tri len
            # stack) -> 'stloc' sau do doc gia tri KHONG TON TAI tren stack ->
            # InvalidProgramException luc chay (am tham qua ilasm).
            _mkey1 = (_shape_key(recv_ta), node[2])
            if (_mkey1 not in EXPR_METHOD_DTYPE
                    and _mkey1 not in EXPR_METHOD_SHAPE
                    and _mkey1 in EXPR_METHOD_CODEGEN):
                import tkv_compile
                raise tkv_compile.TranspileError(
                    f"il_codegen: method {node[2]!r} tren __tkv_extern_class__ la "
                    f"'returns':'void' - khong co gia tri de dung trong bieu thuc "
                    f"(vd gan bien '= <expr>.{node[2]}(...)'), chi goi duoc dang "
                    f"LENH DOC LAP ('<expr>.{node[2]}(...)' mot minh tren 1 dong)")
            resolver = EXPR_METHOD_SHAPE.get((_shape_key(recv_ta), node[2]))
            if resolver:
                return resolver(recv_ta).dtype
            registered = EXPR_METHOD_DTYPE.get((_shape_key(recv_ta), node[2]))
            if registered:
                return registered
            return None
        return _STR_METHOD_RETURN_DTYPE.get(node[2], 'str')
    if tag == 'index_expr':
        # '<bieu thuc>[i]' (2026-08-03) - dtype phan tu cua container ma
        # bieu thuc ben trai tra ve (vd s.split(",")[0] -> 'str').
        res_ta = _index_expr_result_ta(node, scope, func_table, records)
        return res_ta.dtype if res_ta is not None else None
    if tag == 'attr':
        # 'obj.field' - can bang records (ten class -> danh sach field) de
        # tra dtype THAT cua field do; khong co bang nay (vd cac noi goi
        # _infer_dtype cu chua duoc cap nhat truyen records) thi khong suy
        # duoc (None), caller fallback ve body_dtype - AN TOAN nhung co the
        # sai neu record field khac body_dtype (chi anh huong goi thieu
        # records, khong phai loi logic).
        obj_ta = scope[node[1]][2]
        if obj_ta.dtype == 'complex' and node[2] in ('real', 'imag', 'magnitude'):
            # Muc 6.8 (2/4, 2026-08-13): ca 3 thuoc tinh cua 'complex' deu
            # tra f64 (xem complex_type.py's compile_attr).
            return 'f64'
        if obj_ta.shape == 'dict_kvpair' and node[2] in ('key', 'val'):
            return obj_ta.key_dtype if node[2] == 'key' else obj_ta.dtype
        if records and (obj_ta.shape == 'record' or obj_ta.dtype in records):
            # 'obj_ta.dtype in records' (2026-08-03): bien nhan ket qua 1
            # method tra ve record ('t = self.take(toks)') duoc khai bao
            # qua declare_scalar nen shape=None du dtype la ten record -
            # van phai tra dung dtype cua field.
            fd = dict(records.get(obj_ta.dtype, [])).get(node[2])
            # Field container luu TypeAnn -> dtype cua PHAN TU/GIA TRI.
            return fd.dtype if (fd is not None and not isinstance(fd, str)) else fd
        return None
    # 2026-08-03: 3 nhanh de quy nay TRUOC DAY danh roi records/
    # record_methods -> 'str(t.pos + 1)' (attr NAM TRONG 1 binop) khong
    # suy duoc kieu du 'str(t.pos)' thi duoc. Truyen tiep day du.
    if tag == 'binop':
        left_dtype = _infer_dtype(node[2], scope, func_table, records, record_methods)
        right_dtype = _infer_dtype(node[3], scope, func_table, records, record_methods)
        # __add__ tren record (6.5 muc 5, 2026-08-13): '+' theo CUNG lop loi
        # voi 'index'/__getitem__ o tren - neu toan hang la 1 bien record co
        # dinh nghia __add__, dtype cua CA bieu thuc 'a + b' la return_type
        # cua __add__ (vd 'i32'), KHONG PHAI ten class ('Point') nhu dtype
        # THAT cua toan hang. Truoc day nhanh nay chi 'or' dtype toan hang ->
        # 'x = p1 + p2' bi khai bao SAI kieu 'Point' (hidden temp local kieu
        # class khong ton tai trong IL_SCALAR / sai stack shape) -> 'str(x)'
        # bao loi "record 'Point' khong co __str__" du gia tri that la i32.
        if node[1] == '+' and record_methods:
            for operand_dtype in (left_dtype, right_dtype):
                if operand_dtype and operand_dtype in record_methods:
                    dunder = record_methods[operand_dtype].get('__add__')
                    if dunder and dunder.return_type:
                        return dunder.return_type.dtype
        return left_dtype or right_dtype
    if tag == 'ternary':
        return (_infer_dtype(node[2], scope, func_table, records, record_methods)
                or _infer_dtype(node[3], scope, func_table, records, record_methods))
    if tag in ('compare', 'boolop', 'not', 'in'):
        # BUG THAT (2026-08-05 lat 4): bon tag nay TRUOC DAY khong co
        # nhanh nao - _infer_dtype tra None, caller roi ve
        # _infer_literal_dtype quet CA CAY tim hang so dau tien. Tu khi
        # hang so nguyen mac dinh la 'int', 'ok = idx < 0 or idx >= n'
        # bat duoc so '0' va khai bao 'ok' la TkvInt, trong khi gia tri
        # THAT tren stack la int32 0/1 cua 'clt' -> ghi mot int32 vao o
        # nho cua mot struct: AccessViolationException luc chay
        # (manual_chat_11_test). Ket qua so sanh/logic LUON la int32 0/1,
        # khong phu thuoc toan hang - khai bao thang, dung doan.
        return 'i32'
    if tag == 'neg':
        return _infer_dtype(node[1], scope, func_table, records, record_methods)
    if tag == 'await':
        # 'await task_expr' (Phase 4, 2026-08-11) - dtype cua ca bieu thuc
        # CHINH LA dtype cua gia tri BEN TRONG Task<T> (T=dtype tra ve THAT
        # cua ham async, xem il_features/async_await.py) - suy tiep tren
        # node ben trong (thuong la 1 'call' toi ham func_table, van tra
        # dtype RAW dung vi func_table.return_type khong bi anh huong boi
        # is_async, chi CODEGEN moi boc Task<T>). BUG THAT phat hien qua
        # test that ('total = await f(5) + await f(10)'): THIEU nhanh nay
        # truoc day khien _infer_dtype tra None cho tag 'await', declare_
        # scalar roi ve mac dinh 'int' (TkvInt) sai hoan toan - sinh IL
        # lon xon (2 lenh 'call' Task chay truoc, chi 1 callvirt get_Result
        # xen giua 1 'add.ovf' tren 1 THAM CHIEU Task) -> NullReferenceException
        # luc chay do goi get_Result() tren gia tri da bi pha hong.
        return _infer_dtype(node[1], scope, func_table, records, record_methods)
    if tag == 'call':
        name = node[1]
        # Phase 9a (2026-08-24, __tkv_extern_method__ 'returns':'void'):
        # goi 1 builtin THAT SU void (dang ky trong tkv_compile.EXTERN_VOID_
        # BUILTIN_NAMES, xem _validate_and_register_extern_method/
        # _validate_and_register_extern_pinvoke) O VI TRI GIA TRI (vd
        # 'x = gc_collect()') phai bao loi RO RANG ngay tai day - neu khong
        # se roi fallback body_dtype (declare_scalar), khai bao bien 1 dtype
        # BAT KY trong khi codegen_fn that su chi sinh 'call void ...'
        # (khong day gia tri nao len stack) -> 'stloc' sau do doc gia tri
        # KHONG TON TAI tren stack (IL sai ngan xep, am tham qua ilasm).
        # Import lazy (khong o dau file) vi tkv_compile.py -> il_codegen.py
        # o CAP MODULE, import nguoc se circular - giong quy uoc
        # file_io.py::_extern_void_builtin_names().
        import tkv_compile
        # Fix Critical 1 (2026-08-24, final review Phase 9a): phong thu
        # them lop - ngoai discard() o tkv_compile.py's finally block (don
        # dep EXTERN_VOID_BUILTIN_NAMES giua cac lan goi compile_tkv_cli),
        # doi hoi THEM 'name' con dang ky trong EXPR_BUILTIN_CODEGEN (builtin
        # THAT SU con hieu luc trong compile unit hien tai) - tranh truong
        # hop state cu con sot trong EXTERN_VOID_BUILTIN_NAMES tu bao loi
        # sai cho 1 ten khong con la builtin nao ca.
        if (name in tkv_compile.EXTERN_VOID_BUILTIN_NAMES
                and name in tkv_compile.EXPR_BUILTIN_CODEGEN):
            raise tkv_compile.TranspileError(
                f"il_codegen: '{name}' la 1 ham 'void' (__tkv_extern_method__/"
                f"__tkv_extern_pinvoke__) - khong co gia tri de dung trong bieu "
                f"thuc (vd gan bien '= {name}(...)'), chi goi duoc dang LENH DOC "
                f"LAP ('{name}(...)' mot minh tren 1 dong)")
        if records and name in records:
            # 'Point(1.0, 2.0)' - khoi tao 1 record - dtype cua ca bieu
            # thuc CHINH LA ten record (khop quy uoc TypeAnn(record_name,
            # 'record') dung o moi noi khac). Can THIET de 'lst.append(
            # Point(...))' suy dung dtype phan tu cua list (khoang trong
            # ngon ngu #2 - "List chua record").
            return name
        if name == 'typeof':
            # Phase 9d Part B (2026-08-27): dtype cua bieu thuc typeof(...)
            # LUON la 'type' (System.Type), khong phu thuoc ClassName nao -
            # khac han cac builtin khac o duoi (vd 'abs' giu dtype doi so).
            return 'type'
        if name == 'abs':
            # abs() giu nguyen kieu doi so (Math.Abs co overload rieng).
            return _infer_dtype(node[2][0], scope, func_table, records,
                                record_methods) if node[2] else None
        if name == 'round':
            # round() KHONG con di duong _MATH_FUNCS chung (xem
            # _compile_round_builtin, 2026-08-05) - 1 doi so tra INT
            # (Python round(x) khong ndigits tra int), 2 doi so tra f64
            # (round(x,n) tra float). 'round' VAN con trong _MATH_FUNCS
            # dict (dung cho _expr_call's nhanh chung cu, nay bi chan
            # truoc boi 'if name == round' o do) nen PHAI tach rieng o
            # day, dat TRUOC 'if name in _MATH_FUNCS:' ngay duoi - cung
            # lop loi voi B4 (mot cho suy dtype quen cap nhat theo mot
            # cho codegen da doi).
            return 'i32' if len(node[2]) == 1 else 'f64'
        if name in _stdlib_math_funcs_names:
            # 2026-08-03: truoc day tra None -> caller fallback ve
            # body_dtype, nen 'r = round(v)' trong 1 ham TRA VE 'str' bi
            # khai bao kieu string -> KeyError 'str' luc sinh 'conv.<dtype>'.
            # Moi ham trong _MATH_FUNCS deu goi overload float64 cua
            # System.Math (xem _expr_call) nen ket qua LUON la f64 - dung
            # luon ngu nghia Python (math.sqrt/floor... tra float). Cung
            # LOAI bug da ghi cho 'len' ngay ben duoi.
            return 'f64'
        if name == 'len':
            # BUG THAT phat hien qua vi du that (word_stats.tkv, 2026-07-29):
            # KHONG co nhanh rieng cho 'len' truoc day -> roi vao fallback
            # body_dtype cua ham dang bien dich (xem declare_scalar) - SAI
            # bat cu khi nao ham tra ve khac i32/i64 (vd ham tra 'str'):
            # bien nhan 'n = len(...)' bi khai bao SAI kieu 'string' trong
            # khi gia tri THAT luc chay la int32 - gay type confusion CIL
            # that (stloc vao slot string nhung la bit pattern int32), dan
            # toi NullReferenceException khi dung bien do sau nay (vd
            # str(n) hay String.Concat) - _expr_call's nhanh 'len' luon
            # tra ve int32 that su (widen tu i32), nen o day PHAI khai bao
            # cung 'i32' thay vi de fallback sai.
            return 'i32'
        if name == 'str':
            return 'str'
        if name == 'fmt_float':
            return 'str'
        if name == 'read_file':
            return 'str'
        if name == 'file_exists':
            return 'i32'
        if name == 'pow':
            return None
        if name in ('math_pi', 'math_e'):
            return 'f64'
        if name == 'math_gcd':
            return None
        if name in ('path_join', 'path_basename', 'path_dirname'):
            return 'str'
        if name in ('path_exists', 'path_isfile', 'path_isdir'):
            return 'i32'
        if name in ('random', 'randint', 'uniform', 'randrange'):
            return None
        if name == 'xml_encode_name':
            return 'str'
        if name == 're_match':
            return 'i32'
        if name == 're_sub':
            return 'str'
        if name == 're_search':
            return 'i32'
        if name == 're_fullmatch':
            return 'i32'
        if name in EXPR_BUILTIN_DTYPE_FN:
            # dtype phu thuoc tham so (sum/min/max cua 1 list) - xem
            # EXPR_BUILTIN_DTYPE_FN trong il_dispatch.py.
            return EXPR_BUILTIN_DTYPE_FN[name](node[2], scope, func_table)
        if name in EXPR_BUILTIN_DTYPE:
            # Giai doan 0.2 (2026-08-03): builtin dang ky qua
            # register_expr_builtin - xem EXPR_BUILTIN_CODEGEN o tren.
            return EXPR_BUILTIN_DTYPE[name]
        if func_table and name in func_table:
            callee = func_table[name]
            return callee.return_type.dtype if callee.return_type else None
        if nested_closures and name in nested_closures:
            # Closure that (Buoc 4): goi 1 ham long CUA CHINH ham dang bien
            # dich (vd 'a = inc()') - 'inc' KHONG nam trong func_table (chi
            # co ham top-level), suy dtype tu chinh Signature cua no da luu
            # trong nested_closures (xem il_features/closures.py).
            nested_sig = nested_closures[name]['nested_sig']
            return nested_sig.return_type.dtype if nested_sig.return_type else None
        return None
    if tag == 'method_call':
        # Phase 9d Part A, Task 3 (2026-08-26): 'ClassName.Method()' -
        # node[1] co the la TEN CLASS (extern-class da khai
        # __tkv_extern_class__), KHONG phai 1 bien - scope[node[1]] se
        # KeyError (khac han 'obj.method()' thong thuong, node[1] luon la 1
        # bien da khai). Dung try/except (KHONG dung 'in scope') vi
        # _DtypeOnlyScope (dung trong first-pass, o tren) KHONG dinh nghia
        # __contains__/__len__/__iter__ - 'in' se roi vao old-style
        # iteration protocol qua __getitem__(int), gay KeyError SAI (tra
        # so nguyen thay vi ten bien). Dtype cua bieu thuc nay KHONG suy
        # duoc tu day (khong co obj_ta de tra cuu resolver theo shape) -
        # tra ve None dung quy uoc cua ham nay ("khong xac dinh duoc", xem
        # docstring dau ham) de caller (declare_scalar/...) fallback ve
        # body_dtype/literal thay vi crash KeyError tho.
        try:
            obj_ta = scope[node[1]][2]
        except (KeyError, SyntaxError):
            # Critical fix (Phase 9d Part A final review, C1, 2026-08-26):
            # obj_name khong nam trong scope nghia la day la 'ClassName.
            # Method()' (static method tren 1 extern-class), KHONG phai
            # 'obj.method()'. node[1]/node[2] (ten class/method) da BIET
            # TINH o day - TRA VE None (nhu truoc fix) khien caller
            # (declare_scalar/... quanh dong ~3169) fallback SAI ve
            # body_dtype (dtype tra ve cua HAM DANG BIEN DICH, khong lien
            # quan) trong khi codegen_fn THAT SU sinh 'call <returns thuc>'
            # - dtype khai bao cho bien local lech voi dtype tren stack ->
            # 'stloc'/'ldloc' sai kieu, ilasm am tham CHAP NHAN (khong bao
            # loi) va sinh gia tri SAI (bit pattern bi doc nham kieu). Tra
            # cuu THANG return dtype that qua _EXTERN_CLASS_DEFS (mirror
            # cach tkv_compile._compile_extern_static_class_method_call
            # tra cuu 'returns', va cach obj_ta o nhanh instance-method
            # ngay duoi day dung obj_ta de resolve dtype).
            #
            # NEW-I1 (final review, 2026-08-26): bang '_Scope' THAT (dung o
            # MOI vi tri goi khac vi tri assignment truc tiep khong-annotate
            # - vd 'print(W.Val())', 'x = W.Val() + 1.0', 'if W.Describe() >
            # 0:') co __getitem__ RAISE 'SyntaxError' (xem class _Scope o
            # tren, dong ~1058-1060), KHONG PHAI 'KeyError'. Chi '_DtypeOnlyScope'
            # (dung RIENG cho first-pass, xem class o duoi) moi raise
            # KeyError qua self._d[name]. Truoc fix nay, 'except KeyError'
            # CHI bat duoc truong hop scope la _DtypeOnlyScope (tinh co
            # dung trong 1 nhanh first-pass cu the) - o MOI vi tri khac
            # (scope la _Scope that), SyntaxError roi thang len tren, khong
            # bao gio cham toi logic tra cuu _EXTERN_CLASS_DEFS ben duoi ->
            # bao loi "bien 'W' chua duoc khai bao" SAI (W la 1 extern-class
            # hop le, chi khong phai bien). Bat CA HAI loai de logic nay
            # hoat dong DONG NHAT bat ke scope nao dang duoc dung.
            try:
                decl = _EXTERN_CLASS_DEFS[node[1]]
                m = next((mm for mm in decl.get('static_methods', [])
                          if mm['name'] == node[2]), None)
                if m is not None:
                    import tkv_compile
                    return tkv_compile._tokenvector_facing_dtype(m['returns'])
            except (KeyError, TypeError):
                pass
            return None
        # Phase 9a (2026-08-24, __tkv_extern_class__ method 'returns':'void'):
        # doi voi 'call' (extern static/pinvoke), Task 1 da chan void o
        # DAY qua EXTERN_VOID_BUILTIN_NAMES; nhung extern-class instance
        # method di qua NHANH RIENG ('method_call', khong phai 'call') nen
        # khong duoc bao ve boi guard do - neu khong co guard nay, 'x =
        # s.Clear()' (Clear la void) se roi vao 'return None' o cuoi nhanh,
        # declare_scalar se khai bao bien VOI 1 dtype BAT KY trong khi
        # codegen_fn that su chi sinh 'callvirt instance void ...' (khong
        # day gia tri len stack) -> 'stloc' sau do doc gia tri KHONG TON TAI
        # tren stack (IL sai ngan xep, am tham qua ilasm - dung loi Task 1
        # da phat hien va sua cho nhanh 'call'). Nhan dien qua CUNG dau
        # hieu voi _stmt_method_call_stmt: shape=='extern_class' + method
        # KHONG co entry trong EXPR_METHOD_DTYPE/EXPR_METHOD_SHAPE nhung
        # DA dang ky trong EXPR_METHOD_CODEGEN (tuc la 1 void method THAT,
        # khong phai "chua dang ky ten").
        _mkey0 = (_shape_key(obj_ta), node[2])
        if (obj_ta.shape == 'extern_class'
                and _mkey0 not in EXPR_METHOD_DTYPE
                and _mkey0 not in EXPR_METHOD_SHAPE
                and _mkey0 in EXPR_METHOD_CODEGEN):
            import tkv_compile
            raise tkv_compile.TranspileError(
                f"il_codegen: method {node[2]!r} tren __tkv_extern_class__ la "
                f"'returns':'void' - khong co gia tri de dung trong bieu thuc "
                f"(vd gan bien '= {node[1]}.{node[2]}(...)'), chi goi duoc dang "
                f"LENH DOC LAP ('{node[1]}.{node[2]}(...)' mot minh tren 1 dong)")
        resolver = EXPR_METHOD_SHAPE.get((_shape_key(obj_ta), node[2]))
        if resolver:
            # Nhom 5: method tra container, dtype PHU THUOC doi tuong nhan.
            return resolver(obj_ta).dtype
        registered = EXPR_METHOD_DTYPE.get((_shape_key(obj_ta), node[2]))
        if registered:
            # Giai doan 0.2 nhom 3 (2026-08-03): method dang ky qua
            # register_expr_method - uu tien TRUOC bang _STR_METHOD_RETURN_DTYPE
            # cu (bang do khong biet cac method moi dang ky).
            return registered
        if obj_ta.shape is None and obj_ta.dtype == 'str':
            # Mac dinh 'str' (dung cho upper/lower/strip/replace/join cua
            # string_methods_batch2.py) - nhom rieng nao tra ve dtype KHAC
            # (vd startswith/endswith/find -> i32, xem batch3) phai tu khai
            # bao trong _STR_METHOD_RETURN_DTYPE de tranh suy sai dtype khi
            # gan ket qua vao 1 bien (vd 'a = s.startswith(x)').
            return _STR_METHOD_RETURN_DTYPE.get(node[2], 'str')
        if obj_ta.shape == 'list' and node[2] == 'pop':
            return obj_ta.dtype
        if obj_ta.shape == 'list' and node[2] == 'index':
            return 'i32'
        if obj_ta.shape == 'dict' and node[2] in ('get', 'pop', 'setdefault'):
            return obj_ta.dtype
        if obj_ta.shape == 'file' and node[2] == 'read':
            return 'str'
        if record_methods:
            m_sig = record_methods.get(obj_ta.dtype, {}).get(node[2])
            if m_sig and m_sig.return_type:
                return m_sig.return_type.dtype
        return None
    if tag == 'slice':
        # 'name[i:j]' - CHI suy dtype cho truong hop STRING (ket qua van
        # la scalar 'str', di qua nhanh assign_scalar chung); truong hop
        # LIST (ket qua la 1 list MOI, can ca dtype+shape) do
        # il_features/slicing.py's try_rhs_list_slice tu xu ly rieng
        # (khong di qua declare_scalar/_infer_dtype).
        src_ta = scope[node[1]][2]
        if src_ta.shape is None and src_ta.dtype == 'str':
            return 'str'
        return None
    return None  # 'num'/'shape'/'compare'/'boolop': dtype co dinh (numeric/i32), khong can suy


def _shaped_return_ta_of_call(rhs_node, func_table, infer_scope=None, records=None):
    """Tra 1 gia tri CO SHAPE (list/dict/set/tuple/record/func/refclass...)
    ra tu 1 loi goi ham TOP-LEVEL (vd 'lst = make_list()'/'inc =
    make_counter()') - tra ve THANG TypeAnn day du cua callee.return_type
    (KHONG chi dtype) de bien ben trai duoc khai bao DUNG hinh dang, thay
    vi rot mat shape qua nhanh suy dtype thuong (_infer_dtype's 'call' chi
    tra ve chuoi dtype, khong mang shape). Ban dau (Buoc 4, 2026-07-29) CHI
    ap dung cho shape='func' (tra closure ra ngoai lam gia tri) - TONG QUAT
    HOA (2026-07-29, cung ngay, B2(a)+(b)) sang BAT KY shape khac None, vi
    cung 1 van de kien truc (rot shape) xay ra voi MOI ham tra ve container/
    gia-tri-co-hinh-dang, khong rieng 'func' - vd 'list[i32]' vua them cu
    phap parse (typed_dsl_parser.py) can chinh nhanh nay de hoat dong dung.
    An toan voi truong hop record: cho ket qua GIONG HET nhanh cu ('record'
    shape suy tu dtype=ten-record da co san tu truoc), khong regress. Tra
    None neu khong khop (fallback ve nhanh suy luan cu, vd return_type=None
    hoac shape=None/scalar thuong)."""
    if func_table and rhs_node[0] == 'call' and rhs_node[1] in func_table:
        callee = func_table[rhs_node[1]]
        if callee.return_type is not None and callee.return_type.shape is not None:
            return callee.return_type
    # Giai doan 0.2 nhom 4 (2026-08-03): builtin/method THU VIEN tra ve
    # container ('os_list_files(p)' -> list[str], 's.split(sep)' ->
    # list[str]) - MO RONG dung nhanh nay (thay vi them 1 duong khai bao
    # rieng nhu ban cu lam qua ASSIGN_RHS_PARSERS) vi ban chat van la
    # "loi goi tra ve gia tri CO HINH DANG", giong het ham nguoi dung.
    if rhs_node[0] == 'call':
        full_ta = EXPR_BUILTIN_RETURN_TA.get(rhs_node[1])
        if full_ta is not None:
            return full_ta
        shaped = EXPR_BUILTIN_SHAPE.get(rhs_node[1])
        if shaped:
            elem_dtype = shaped[0]
            if elem_dtype is None:
                # Builtin tra container ma DTYPE PHU THUOC THAM SO
                # ('sorted(xs)' -> list dtype cua chinh xs, 2026-08-03) -
                # hoi EXPR_BUILTIN_DTYPE_FN, khong doan.
                fn = EXPR_BUILTIN_DTYPE_FN.get(rhs_node[1])
                if fn is not None and infer_scope is not None:
                    elem_dtype = fn(rhs_node[2], infer_scope, func_table)
            if elem_dtype is not None:
                return TypeAnn(elem_dtype, shaped[1])
            return None
    if rhs_node[0] == 'attr' and infer_scope is not None:
        # MOT nhanh 'attr' DUY NHAT (gop lai o final-review I3,
        # 2026-08-19): truoc day co 2 nhanh 'attr' rieng, nhanh THU NHAT
        # co dieu kien `and records` va `return None` som -> nhanh THU HAI
        # (property extern-class co shape container) KHONG BAO GIO chay
        # duoc khi chuong trinh co bat ky record nao trong CUNG file (code
        # chet - repro that: extern-class co property list[i32] + 1 record
        # Point cung file -> build fail voi thong bao cu).
        try:
            obj_ta = infer_scope[rhs_node[1]][2]
        except KeyError:
            return None
        # (a) 'xs = self.items' (2026-08-03): field CONTAINER cua record -
        # tra ve TypeAnn day du de bien ben trai duoc khai bao dung
        # List<T>/Dictionary<K,V> thay vi 1 bien vo huong.
        if records:
            fd = dict(records.get(obj_ta.dtype, [])).get(rhs_node[2])
            if fd is not None and not isinstance(fd, str):
                return fd
        # (b) Phase 7 follow-up (2026-08-19, list[list[T]]): 'd = m.Data'
        # voi 'm' la 1 handle-type (__tkv_extern_class__) va 'Data' 1
        # property CO HINH DANG (list[...]/dict[...]) - nhanh (a) chi tra
        # cuu qua `records` (record THUONG), rot mat shape cho extern-class
        # (bien ben trai bi khai bao vo huong SAI, vd 'i32' mac dinh). Tai
        # dung DUNG pipeline get_X pseudo-method da dang ky qua
        # EXPR_METHOD_SHAPE (xem tkv_compile.py's vong lap
        # 'registered_extern_class_property_names') thay vi viet lai logic
        # tra cuu property.
        if obj_ta.shape == 'extern_class':
            resolver2 = EXPR_METHOD_SHAPE.get(('extern_class', f'get_{rhs_node[2]}'))
            if resolver2 is not None:
                return resolver2(obj_ta)
        return None
    if rhs_node[0] == 'method_call' and infer_scope is not None:
        try:
            _, _, obj_ta = infer_scope[rhs_node[1]]
        except KeyError:
            # Important 2 (review Phase 9g, 2026-08-27): rhs_node[1] khong
            # nam trong scope co nghia day la 'ClassName.Method()' (static
            # method tren 1 extern-class), KHONG phai 'obj.method()' - mirror
            # CHINH XAC logic _infer_dtype's nhanh 'method_call' (dong ~727
            # phia tren, xem chu thich C1 o do ve ly do try/except KeyName)
            # NHUNG tra ve TypeAnn DAY DU (shape dung) thay vi 1 dtype string
            # tho. Thieu nhanh nay: 'names = ArrayApi.MakeNames(3)' (static
            # method tra 'array[str]', quy doi 'list[str]' qua
            # _tokenvector_facing_dtype) se roi xuong nhanh else cua
            # declare_scalar (_infer_dtype tra ve chuoi 'list[str]' THO,
            # khong TypeAnn) -> declare_scalar's kiem tra o duoi (dong
            # ~3433-3439) khong nhan dien 'list[str]' la 1 container (chi
            # kiem _EXTERN_CLASS_DEFS/records) -> TypeAnn(dtype='list[str]',
            # shape=None) SAI -> KeyError IL_SCALAR['list[str]'] luc khai
            # bao local, DUNG BUG PATTERN Step 3's
            # _make_extern_class_method_return_ta da tung sua (tkv_compile.py).
            decl = _EXTERN_CLASS_DEFS.get(rhs_node[1])
            if decl is None:
                return None
            m = next((mm for mm in decl.get('static_methods', [])
                      if mm['name'] == rhs_node[2]), None)
            if m is None:
                return None
            import tkv_compile
            ret = tkv_compile._tokenvector_facing_dtype(m['returns'])
            if ret in _EXTERN_CLASS_DEFS:
                return TypeAnn(ret, 'extern_class')
            if isinstance(ret, str) and (ret.startswith('list[') or ret.startswith('dict[')):
                return parse_type_ann_str(ret, extern_class_names=set(_EXTERN_CLASS_DEFS))
            return None
        resolver = EXPR_METHOD_SHAPE.get((_shape_key(obj_ta), rhs_node[2]))
        if resolver:
            # Nhom 5 (2026-08-03): kieu tra ve PHU THUOC doi tuong nhan
            # ('d.keys()' -> list[key_dtype cua d]) nen phai goi ham phan
            # giai, khong tra duoc bang 1 cap (dtype, shape) tinh.
            return resolver(obj_ta)
    return None


def _index_src_is_nested_container(src_name, infer_scope):
    """Wave 2 (2026-07-29): True khi 'src_name[i]' doc ra 1 CONTAINER khac
    (List/Dict), khong phai gia tri vo huong/record - dung boi
    declare_scalar/_fpp_assign_scalar de biet co nen tai dung elem_ta thay
    vi suy dtype qua _infer_dtype (ham do CHI tra ve 1 dtype STRING, khong
    bieu dien duoc "phan tu la 1 container khac"). An toan voi tham chieu
    xuoi/bien chua khai bao (tra False, roi ve nhanh cu)."""
    try:
        _, _, src_ta = infer_scope[src_name]
    except KeyError:
        return False
    return src_ta.shape in ('list', 'dict') and src_ta.elem_ta is not None


def _infer_literal_dtype(node):
    """BUG THAT tim thay qua AlphaAI stress-test (2026-07-28, 'd[c] = 1'
    trong 1 ham TRA VE str): '1' la 1 hang so KHONG CO dtype co dinh
    (ldc hoat dong voi bat ky dtype nao caller yeu cau - dung y cua
    _infer_dtype tra None cho 'num'), nhung khi dung de SUY dtype cua 1
    local/dict-value MOI (khong co manh moi nao khac), _first_pass_collect_locals
    truoc day fallback THANG ve body_dtype (dtype tra ve cua CA HAM) - SAI
    khi ham tra ve 'str' nhung gia tri that su la so (vd dict dem tan
    suat trong ham tra ve chuoi ky tu pho bien nhat) -> IL_LDC_OP['str']
    KeyError that (khong co ma lenh 'ldc' cho string). Doan tot hon: nhin
    CHINH cu phap hang so (co dau '.' hay khong) truoc khi roi vao
    body_dtype - CHI ap dung cho node 'num' (khong doi ngu nghia cac tag
    khac cua _infer_dtype)."""
    if isinstance(node, tuple) and node[0] == 'slice':
        # BUG THAT (2026-08-05, P094): 'lst2[-1:5]' - quet-ca-cay o duoi
        # tung LEN DUOC vao chi so bat dau/ket thuc cua slice ('-1', '5')
        # va nham coi hang so DO la dtype cua CA bieu thuc slice, trong
        # khi ket qua that su la 1 LIST (container) khi nguon la list -
        # dan toi khai bao local tam sai kieu 'int' o first-pass, pass 2
        # sinh IL ep list vao TkvInt -> MissingMethodException LUC CHAY
        # (te hon ban compile_gap cu). Slice la nut DOI HINH DANG (co the
        # tra ve list MOI) - khong duoc coi cac hang so BEN TRONG chi so
        # cua no la dai dien cho dtype cua toan bo ket qua. _infer_dtype o
        # tren (dong 587) da xu ly rieng truong hop str; con lai (list) co
        # tinh tra None de pass 2 tu bao loi ro rang, khong doan mo.
        return None
    if isinstance(node, tuple) and node[0] not in ('num',):
        # 2026-08-03 (dot 3): hang so nam LONG trong 1 bieu thuc - vd
        # 'd[k] = d.get(k, 0) + 1' (mau dem tan suat pho bien nhat cua
        # Python): nhanh suy kieu that THAT BAI vi 'd' dang duoc khai bao
        # (tu tham chieu), con nhanh hang so cu chi nhin node NGOAI CUNG
        # (mot 'binop') nen cung tra None -> roi ve body_dtype = 'str' ->
        # dict dem so bi khai bao Dictionary<string,string>. Quet ca cay
        # tim hang so dau tien.
        for sub in node[1:]:
            if isinstance(sub, tuple):
                found = _infer_literal_dtype(sub)
                if found:
                    return found
            elif isinstance(sub, list):
                for item in sub:
                    found = _infer_literal_dtype(item)
                    if found:
                        return found
        return None
    if isinstance(node, tuple) and node[0] == 'num':
        # 2026-08-03: hang so co dau '.' suy ra 'f64' (truoc day 'f32').
        # Python CHI co 1 kieu so thuc = double; 'result = 0.0' roi sau do
        # 'result = <gia tri f64>' truoc day khai bao bien la float32 nen
        # MAT DO CHINH XAC am tham (0.1 + 0.2 in ra 0.300000011920929 thay
        # vi 0.30000000000000004) - bug THAT tim qua tools/tkvcalc.tkv.
        # Day chi la fallback khi KHONG con manh moi nao khac; cho nao da
        # khai bao f32 ro rang (tham so/field) van dung f32.
        return 'f64' if '.' in node[1] else 'int'
    return None


def _neg_literal_int(node):
    """Neu node la 1 HANG SO NGUYEN AM tai compile-time ('-N' qua tag
    'neg', vd 'lst[-1]') - tra ve N (int DUONG); nguoc lai None. Dung cho
    chi so am (Wave 3, 2026-07-29, muc tieu Claude tu tin viet code that -
    'lst[-1]' la cu phap Python RAT pho bien) - CHI ho tro HANG SO tai
    compile-time (vd 'lst[-1]'/'lst[-2]'), KHONG ho tro bieu thuc am DONG
    (vd 'lst[-i]'/'lst[j-1]') vi can 1 hidden-local de tranh tinh 2 lan
    'name' (giong han che cua list.count()/json_dumps() o vi tri bieu
    thuc bat ky) - 'index' xuat hien QUA pho bien de gioi han RHS-only
    nhu 2 ham do, nen CHON gioi han hep hon (chi hang so) thay vi kien
    truc phuc tap hon."""
    if isinstance(node, tuple) and node[0] == 'neg' and isinstance(node[1], tuple) and node[1][0] == 'num':
        text = node[1][1]
        if '.' not in text:
            return int(text)
    return None


def _contains_float_literal(node):
    """True neu BAT KY hang so nao trong cay con nay nhin RO RANG la float
    (co dau '.') - duyet nong (binop/compare/neg/ternary), dung de phat
    hien truong hop hang so float bi CHON SAU trong 1 bieu thuc con (vd
    'n / 2.0' - '2.0' nam trong binop, khong phai node ngoai cung) ma
    _infer_dtype/​_infer_literal_dtype tren CHINH node ngoai cung se bo lo."""
    if not isinstance(node, tuple):
        return False
    tag = node[0]
    if tag == 'num':
        return '.' in node[1]
    if tag in ('binop', 'compare'):
        return _contains_float_literal(node[2]) or _contains_float_literal(node[3])
    if tag == 'neg':
        return _contains_float_literal(node[1])
    if tag == 'ternary':
        return _contains_float_literal(node[2]) or _contains_float_literal(node[3])
    return False


def _resolve_compare_operand_dtype(left, right, scope, func_table, dtype,
                                    records=None, record_methods=None):
    """BUG THAT tim thay qua AlphaAI stress-test (2026-07-28, 'i > n / 2.0'
    trong 1 ham voi n:i32): operand_dtype cu cua 'compare' CHI dung de
    kiem tra 'str' roi BI BO QUA cho nhanh so hoc - 2 toan hang van duoc
    bien dich bang dtype TO TIEN (vd body_dtype='i32' vi ham tra ve i32),
    khien '2.0' (nam SAU trong binop 'n / 2.0', khong phai node ngoai
    cung) bi ep dtype='i32' -> 'ldc.i4 2.0' - LOI CU PHAP ILASM THAT. Ham
    nay CHI dung rieng cho 'compare' (AN TOAN doi dtype toan hang o day
    vi ket qua so sanh LUON LA i32 0/1 bat ke chon dtype nao cho toan
    hang, KHONG anh huong ngu canh ben ngoai - khac 'binop' noi KET QUA
    chinh no con duoc dung tiep, khong sua o do de tranh pha vo hanh vi
    dang dung): neu ca 2 toan hang deu KHONG suy ra float truc tiep nhung
    CO hang so float o dau do sau trong cay (vd trong 1 phep chia long
    nhau), uu tien float cho CA HAI toan hang (widen 1 chieu, dung ngu
    nghia Python that: int / float -> float)."""
    # records/record_methods (2026-08-03): thieu 2 bang nay thi 'obj.m()'
    # va 'obj.field' KHONG suy duoc dtype -> roi ve `dtype` cua NGU CANH
    # (vd ham dang tra ve 'str') -> 'lx.at_end() == 0' bi coi la SO SANH
    # CHUOI, sinh 'ldstr 0' loi. Cung LOAI bug da ghi cho 'len' o tren.
    d = (_infer_dtype(left, scope, func_table, records, record_methods)
         or _infer_dtype(right, scope, func_table, records, record_methods)
         or dtype)
    if d in _INT_DTYPES and (_contains_float_literal(left) or _contains_float_literal(right)):
        return 'f32'
    return d


class _Scope:
    """Anh xa ten bien -> (kind, index_hoac_None, TypeAnn).
    kind = 'arg' | 'local' | 'selfarg' ('self' trong 1 instance method -
    xem add_self, khac 'arg' o cach lay dia chi, xem _load_var_addr) |
    'boxed' | 'closure_field' (Buoc 4 - closure that, 2026-07-29, xem
    project-tokenvector-wave2-status memory):
      - 'boxed': 1 local cua HAM NGOAI bi 1 ham long BAT - TypeAnn van la
        TypeAnn VO HUONG goc (logic dtype khong doi, moi noi khac VAN coi
        no la scalar binh thuong), nhung slot local THAT su giu 1 THAM
        CHIEU toi 1 'cell' object (xem _cell_class_name) - idx la chi so
        local nhu 'local' thuong, CHI khac o cach _load_var_ref/
        _stmt_assign_scalar doc/ghi (qua ldfld/stfld, khong ldloc/stloc
        truc tiep gia tri).
      - 'closure_field': 1 bien bi bat, DOC/GHI TU BEN TRONG chinh ham
        long (than method cua closure class) - khong phai local/tham so
        cua method do, ma la 1 FIELD cua 'self' (the hien closure). idx
        la tuple (closure_class_name, field_name), KHONG phai so nguyen."""

    def __init__(self):
        self.vars = {}
        self.class_name = 'Program'

    def add_arg(self, name, idx, type_ann):
        self.vars[name] = ('arg', idx, type_ann)

    def add_boxed(self, name, idx, type_ann):
        self.vars[name] = ('boxed', idx, type_ann)

    def add_self(self, name, type_ann):
        # 'self' trong 1 instance method LUON o arg index 0 (quy uoc CIL
        # cho instance method), va kieu cua no la !T& (managed pointer)
        # CHU KHONG PHAI !T nhu tham so thuong - da xac minh THAT bang
        # probe_record_method.il (Scale() sua field truc tiep qua ldarg.0
        # khong can ldarga lai).
        self.vars[name] = ('selfarg', 0, type_ann)

    def add_local(self, name, idx, type_ann):
        self.vars[name] = ('local', idx, type_ann)

    def add_const(self, name, value, type_ann):
        """Hang so cap module ('MAX = 10' o dau file .tkv, 2026-08-03) -
        KHONG co o nho: 'idx' giu CHINH gia tri Python, va _load_var_ref
        sinh 'ldc'/'ldstr' thay vi 'ldloc'. Nho vay moi noi khac (suy
        dtype, so sanh, truyen tham so...) dung nguyen duong cu."""
        self.vars[name] = ('const', value, type_ann)

    def add_global(self, name, type_ann):
        """Bien module-level GHI DUOC ('global x' trong than ham, 2026-08-11)
        - KHONG co local slot: doc/ghi qua '.field private static' cua
        chinh class chuong trinh (xem self.class_name, gan trong
        gen_il_function) qua ldsfld/stsfld (xem _load_var_ref/
        _stmt_assign_scalar). idx = None (khong dung, giong quy uoc cua
        'closure_field' voi tuple)."""
        self.vars[name] = ('global', None, type_ann)

    def __getitem__(self, name):
        if name not in self.vars:
            raise SyntaxError(f'il_codegen: bien {name!r} chua duoc khai bao/tham so')
        return self.vars[name]

    def __contains__(self, name):
        return name in self.vars


def _il_ident(name):
    """Boc ten dinh danh trong dau nhay don khi sinh IL. ILASM co 1 tap tu
    khoa RAT rong (init, value, class, method, string, object, to, at,
    handler...); 1 tham so/bien trung ten se lam ilasm bao "syntax error at
    token '<ten>'" - loi kho hieu, chi lo ra o buoc assemble chu khong phai
    luc bien dich DSL. Phat hien THAT 2026-08-03 khi viet
    reduce_i32(lst, f, init) theo dung dinh nghia functools.reduce cua
    Python: chi vi ten tham so 'init' ma ca file khong assemble duoc.

    Boc trong dau nhay don la cu phap ILASM chinh thuc cho dinh danh bat ky
    - ap dung cho MOI ten thay vi liet ke tu khoa (danh sach tu khoa cua
    ilasm dai va khong duoc tai lieu hoa day du; boc het thi khong the
    sot). Ten trong IL chi la trang tri: ldarg/ldloc tham chieu theo CHI SO.

    LIEN QUAN: il_core.py's _IL_RESERVED_WORDS + rename_reserved_identifiers
    lam CUNG viec nay theo kieu DANH SACH DEN (doi 'out' -> 'out_' truoc khi
    parse) va docstring o do da tu ghi "chua chac day du 100%" - 'init' thieu
    trong danh sach do la bang chung. Giu ca hai: danh sach den van can vi no
    doi ten SOM (anh huong ca thong bao loi), con boc nhay don o day chan not
    phan con lai."""
    return "'" + name + "'"


def _load_var_ref(name, scope: _Scope, out: list):
    """Nap THAM CHIEU mang/gia tri scalar cua bien len stack (khong index)."""
    kind, idx, ta = scope[name]
    if kind == 'const':
        if ta.dtype == 'str':
            out.append(f'    ldstr {idx}')
        else:
            _compile_expr(('num', str(idx)), scope, out, ta.dtype, None)
        return
    if kind == 'local':
        out.append(f'    ldloc.s {idx}')
    elif kind == 'global':
        # Bien module-level GHI DUOC ('global x', 2026-08-11) - doc qua
        # '.field private static' cua class chuong trinh (xem _Scope.
        # add_global/gen_il_function's scope.class_name).
        out.append(f'    ldsfld {IL_SCALAR[ta.dtype]} {scope.class_name}::{_il_ident(name)}')
    elif kind == 'boxed':
        # Local cua ham NGOAI bi bat - idx tro toi slot giu THAM CHIEU cell,
        # phai ldfld 'v' de lay GIA TRI scalar that (xem _Scope docstring).
        cell_class = _cell_class_name(ta.dtype)
        out.append(f'    ldloc.s {idx}')
        out.append(f'    ldfld {IL_SCALAR[ta.dtype]} {cell_class}::v')
    elif kind == 'closure_field':
        # Doc 1 bien bi bat TU BEN TRONG than method cua closure - di qua
        # field cua 'self' (ldarg.0) roi field 'v' cua cell.
        closure_class, field_name = idx
        cell_class = _cell_class_name(ta.dtype)
        out.append('    ldarg.0')
        out.append(f'    ldfld class {cell_class} {closure_class}::{field_name}')
        out.append(f'    ldfld {IL_SCALAR[ta.dtype]} {cell_class}::v')
    elif kind == 'closure_field_direct':
        # B3 (2026-07-29): bien bi bat kieu THAM CHIEU (list/dict/record/
        # func...) - field GIU THANG gia tri (khong qua cell) - chi 1 ldfld
        # duy nhat, khong can boc/mo cell nhu 'closure_field' o tren.
        closure_class, field_name, il_t = idx
        out.append('    ldarg.0')
        out.append(f'    ldfld {il_t} {closure_class}::{field_name}')
    else:  # 'arg' hoac 'selfarg' - ca 2 deu dung ldarg.s (voi selfarg, gia
           # tri 'nap len' CHINH LA dia chi - xem _load_var_addr)
        out.append(f'    ldarg.s {idx}')


def _load_boxed_cell_ref(name, scope: _Scope, out: list):
    """Nap THANG tham chieu cell (KHONG unbox qua 'v') cua 1 bien scalar bi
    bat - dung khi tao 1 THE HIEN closure moi (truyen cell lam tham so
    .ctor, xem il_features/closures.py's codegen_nested_def) - khac
    _load_var_ref('boxed'/'closure_field') o cho KHONG ldfld 'v' sau cung.

    2 nguon hop le:
    - 'boxed': local scalar cua CHINH ham dang bien dich (co che goc).
    - 'closure_field' (Phase C.2, 2026-07-29 - nested-nested closure): bien
      scalar bi bat tu 1 tang NGOAI HON NUA, DA duoc ham HIEN TAI nhan lai
      duoi dang field cell cua CHINH closure cua no (vd 'inner' nam trong
      'mid' nam trong 'make_deep': 'a' la field cell cua 'mid's closure -
      khi 'inner' bat lai 'a', chi can chuyen tiep NGUYEN VEN cell do, KHONG
      unwrap 'v') - tai dung 100% co che chain-tham-chieu san co, khong can
      logic moi cho da tang."""
    kind, idx, ta = scope[name]
    if kind == 'boxed':
        out.append(f'    ldloc.s {idx}')
    elif kind == 'closure_field':
        closure_class, field_name = idx
        cell_class = _cell_class_name(ta.dtype)
        out.append('    ldarg.0')
        out.append(f'    ldfld class {cell_class} {closure_class}::{field_name}')
    else:
        raise SyntaxError(
            f"il_codegen: '{name}' khong phai 1 bien scalar bi bat hop le "
            f"(kind={kind!r} - can 'boxed' hoac 'closure_field')")


def _load_var_addr(name, scope: _Scope, out: list):
    """Nap DIA CHI (khong phai gia tri) cua 1 bien - can khi ghi field cua
    1 record (value type) hoac goi instance method tren no: 'stfld'/'call
    instance' tren value type doi hoi dia chi tren stack (khong phai ban
    sao gia tri), giong pattern da xac minh THAT o Dictionary.Enumerator
    (ldloca.s) trong 'for k, v in d.items():' va o probe_record_method.il."""
    kind, idx, _ = scope[name]
    if kind == 'local':
        out.append(f'    ldloca.s {idx}')
    elif kind == 'global':
        raise SyntaxError(
            f"il_codegen: bien global '{name}' chua ho tro goi instance method/str() "
            f"can dia chi (vd '.upper()'/str(x)) - pham vi 'global' hien CHI ho tro "
            f"doc/ghi don gian, khong ho tro nhu 1 local")
    elif kind == 'selfarg':
        # 'self' trong 1 instance method DA LA dia chi tu dau (kieu !T&,
        # khong phai !T) - dung ldarg.s THANG (KHONG duoc ldarga.s lai,
        # se tao "dia chi cua dia chi" SAI) - da xac minh THAT bang
        # probe_record_method.il (Scale() dung ldarg.0 truc tiep).
        out.append(f'    ldarg.s {idx}')
    else:  # 'arg' thuong (tham so record TRUYEN THEO GIA TRI, khong phai self)
        out.append(f'    ldarga.s {idx}')


def _store_var(name, scope: _Scope, out: list):
    # Gan lai THAM SO (vd 'n = n - 1' trong while-loop) la cu phap Python
    # THAT, hop le - CIL dung 'starg.s' (khac 'stloc.s' cho local). Bug
    # that phat hien qua test while THAT (sample_while.py's
    # count_down_sum tu giam tham so n).
    kind, idx, _ = scope[name]
    if kind == 'arg':
        out.append(f'    starg.s {idx}')
        return
    if kind == 'global':
        raise SyntaxError(
            f"il_codegen: bien global '{name}' chi ho tro gan don gian 'x = expr' "
            f"(qua _stmt_assign_scalar) - duong ghi nay (vd compound-assign/bien vong "
            f"lap) chua duoc ho tro cho 'global'")
    out.append(f'    stloc.s {idx}')


_COMPARE_OPCODE = {'>': 'cgt', '<': 'clt', '==': 'ceq'}
_COMPARE_NEGATED = {'!=': 'ceq', '>=': 'clt', '<=': 'cgt'}
_INT_DTYPES = {'i32', 'i64'}
_FLOAT_DTYPES = {'f32', 'f64'}


def _widen_if_needed(actual_dtype: str, requested_dtype: str, out: list):
    """Ep kieu NGAM DINH int32/int64 -> float32/float64 khi ngu canh yeu
    cau float nhung gia tri THAT (bien vong lap, phan tu mang) la int -
    CHI mot chieu (widen, khong mat du lieu); KHONG lam chieu nguoc lai
    (float->int la thu hep, nguy hiem, chua ho tro - can cast tuong minh
    neu sau nay can). Sua dung bug that: bien vong lap (luon int32) dung
    lam gia tri tra ve trong ngu canh f32 (vd ternary chon "chi so lop")
    truoc day gay loi CIL (2 nhanh ternary khac kieu tren stack)."""
    if actual_dtype in _INT_DTYPES and requested_dtype in _FLOAT_DTYPES:
        out.append('    conv.r4' if requested_dtype == 'f32' else '    conv.r8')
        return
    # Kieu 'int' (vo han chu so, 2026-08-05) - i32/i64 nang len 'int'
    # LUON an toan (khong mat du lieu), va BAT BUOC phai lam: 'while i <= n'
    # voi i:'int', n:'i32' se de 1 int32 tho o cho doi 1 TkvInt -> stack
    # lech kieu, ilasm van assemble duoc va chuong trinh NREF luc chay
    # (da gap that khi viet tinh nang nay).
    if actual_dtype in _INT_DTYPES and requested_dtype == 'int':
        if actual_dtype == 'i32':
            out.append('    conv.i8')
        out.append('    call valuetype TkvInt TkvInt::FromI64(int64)')
        return
    if actual_dtype == 'int' and requested_dtype in (_INT_DTYPES | _FLOAT_DTYPES):
        # Chieu NGUOC lai la THU HEP. Truoc 2026-08-05 (lat 4) cho nay BAO
        # LOI bien dich, va do la lua chon dung KHI 'int' con la ngoai le -
        # nhung tu khi hang so nguyen mac dinh la 'int' thi no chan ca
        # nhung cho ma do rong co dinh la BAT BUOC ve CAU TRUC, khong phai
        # lua chon cua nguoi viet: chi so list, bien vong lap 'for range',
        # bien dem cua .NET API. Do that: 43/129 test truot vi dung mot
        # loi nay.
        #
        # Nay THU HEP CO KIEM TRA: 'ToI32'/'ToI64' NEM khi khong vua (khong
        # cat bit am tham), 'ToF64' nem khi qua lon (Python cung nem
        # OverflowError o cho nay, khong tra Inf). Nguyen tac cua du an
        # duoc giu nguyen - khong lech am tham - chi doi cho phat hien tu
        # luc bien dich sang luc chay, doi lay viec ma .tkv that su chay.
        if requested_dtype == 'i32':
            out.append('    call int32 TkvInt::ToI32(valuetype TkvInt)')
        elif requested_dtype == 'i64':
            out.append('    call int64 TkvInt::ToI64(valuetype TkvInt)')
        else:
            out.append('    call float64 TkvInt::ToF64(valuetype TkvInt)')
            if requested_dtype == 'f32':
                out.append('    conv.r4')
        return


def _compile_expr(node, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    """Sinh CIL day 1 gia tri (dtype) len stack cho AST node. `ctx` (mac
    dinh None cho cac noi chua can - vd _eval_const_dim) chua label_counter/
    prefix/tern_temp_indices/tern_pos dung cho 'compare'/'ternary'.

    Phase 0 dispatch-table: than ham chi con la tra cuu EXPR_CODEGEN[tag] -
    logic that nam trong cac ham _expr_XXX phia duoi (tung la 1 nhanh
    if/elif), dang ky vao dict qua register_expr_codegen() luc module nap.
    Hanh vi giu NGUYEN VEN so voi chuoi if/elif cu (moi nhanh cu deu
    `return`, nen dict dispatch la tuong duong code-motion thuan tuy)."""
    fn = EXPR_CODEGEN.get(node[0])
    if fn is None:
        raise SyntaxError(f'il_codegen: AST node khong ro: {node!r}')
    return fn(node, scope, out, dtype, ctx)


def _expr_null(node, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    """'None' - tham chieu rong (2026-08-03, dot 1). Bo qua `dtype`: mot
    tham chieu rong hop le voi MOI kieu tham chieu."""
    out.append('    ldnull')


def _expr_num(node, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    text = node[1]
    if dtype == 'int':
        # Kieu 'int' khong co ma lenh 'ldc' rieng (la 1 struct) - xem
        # il_features/int_type.py.
        return _int_type.compile_literal(text, out, ctx)
    out.append(f'    {IL_LDC_OP[dtype]} {text}')


# _expr_str_lit da chuyen sang il_features/string_feature.py's
# compile_str_lit, dang ky TRUC TIEP vao EXPR_CODEGEN['str_lit'] tu do
# (khong qua core), Phase 1 buoc 5, 2026-07-28.


def _build_closure_delegate(name, info, scope: _Scope, out: list):
    """Nap 1 THE HIEN closure DA TAO (hidden_local, xem il_features/
    closures.py's codegen_nested_def) + tao 1 Func`N delegate tro toi than
    method cua no (ldftn instance + newobj Func::.ctor(object, native int) -
    dung LAI y het co che Buoc 2). Dung CHUNG boi 2 noi: (a) _expr_call's
    nhanh nested_closures (goi noi bo 'inc()', callvirt Invoke NGAY sau khi
    ham nay tra ve); (b) _expr_var's nhanh nested_closures (Buoc 4 - tra
    closure ra NGOAI lam gia tri qua 'return inc', KHONG Invoke - de nguyen
    delegate tren dinh stack, xem project-tokenvector-wave2-status memory).
    Tra ve (callee_params, callee_ret) de ben goi tu quyet dinh buoc tiep
    theo (Invoke hay khong)."""
    nested_sig = info['nested_sig']
    _load_var_ref(info['hidden_local'], scope, out)
    callee_params = [p.type_ann.dtype for p in nested_sig.params]
    callee_ret = nested_sig.return_type.dtype if nested_sig.return_type else None
    params_il = ', '.join(IL_SCALAR[d] for d in callee_params)
    ret_il = IL_SCALAR[callee_ret]
    out.append(f'    ldftn instance {ret_il} {info["closure_class"]}::{name}({params_il})')
    generic_args = ', '.join([IL_SCALAR[d] for d in callee_params] + [IL_SCALAR[callee_ret]])
    func_il = f'class [System.Core]System.Func`{len(callee_params) + 1}<{generic_args}>'
    out.append(f'    newobj instance void {func_il}::.ctor(object, native int)')
    return callee_params, callee_ret


def _expr_var(node, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    name = node[1]
    nested_closures = (ctx or {}).get('nested_closures') or {}
    if name not in scope and name in nested_closures:
        # 'return inc' - THAM CHIEU ten ham long (KHONG phai loi goi 'inc()')
        # - 'inc' KHONG nam trong scope (chi hidden_local '__closure_inc' co)
        # nen phai chan TRUOC khi thu scope[name] ben duoi (se KeyError).
        _build_closure_delegate(name, nested_closures[name], scope, out)
        return
    _load_var_ref(name, scope, out)
    _, _, type_ann = scope[name]
    _widen_if_needed(type_ann.dtype, dtype, out)


def _expr_shape(node, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    name, dim = node[1], node[2]
    _, _, type_ann = scope[name]
    if type_ann.shape is None or dim >= len(type_ann.shape):
        raise SyntaxError(f'il_codegen: {name}.shape[{dim}] khong hop le (shape={type_ann.shape})')
    out.append(f'    ldc.i4 {type_ann.shape[dim]}')  # HANG SO biet luc codegen, khong runtime


def _expr_index(node, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    name, indices = node[1], node[2]
    _, _, type_ann = scope[name]
    if type_ann.shape in ('list', 'bytearray', 'bytes'):
        # muc 6.8 (3/4 va 4/4, 2026-08-13): doc bytearray[i]/bytes[i] TAI
        # DUNG NGUYEN VEN nhanh list (xem Dieu tra Step 1, bytearray_type.py
        # dau file) -
        # compile_index_list dung ctx['il_type_str'] (DE QUY, da day nhanh
        # 'bytearray' o tren) + 'get_Item(int32) -> !0' generic, KHONG
        # hardcode i32/dtype cu the - da XAC NHAN qua build+chay test that
        # gia tri doc ra la i32 hop le tren stack (ECMA-335: uint8 tren
        # stack TU chuan hoa thanh int32 khi callvirt tra ve), khong chi
        # tin ly thuyet.
        return _list_compile_index_list(name, indices, scope, out, dtype, ctx)
    if type_ann.shape == 'dict':
        return _dict_compile_index_dict(name, indices, scope, out, dtype, ctx)
    if type_ann.shape == 'defaultdict':
        from il_features.defaultdict_type import compile_index_defaultdict
        return compile_index_defaultdict(name, indices, scope, out, dtype, ctx)
    if type_ann.shape == 'counter':
        from il_features.counter_type import compile_index_counter
        return compile_index_counter(name, indices, scope, out, dtype, ctx)
    if type_ann.dtype == 'str' and type_ann.shape is None:
        return _string_compile_index_str(name, indices, scope, out, ctx)
    if type_ann.shape in ('set', 'frozenset'):
        # HashSet<T> KHONG co indexer (dung nhu set/frozenset cua Python).
        # Truong hop hay gap nhat den day la 'for x in <set>:' - macro
        # for-in khai trien thanh 'x = s[i]' vi o tang VAN BAN no chua biet
        # 's' la set/frozenset. Truoc 2026-08-03 loi bao ra la "chi ho tro
        # mang rank 1 hoac 2" (do len('set') == 3 bi hieu nham la rank 3) -
        # vo nghia voi nguoi doc. Nay bao dung viec + chi cach lam (ca 2
        # shape deu co .to_list(), xem set_to_list.py).
        kind = type_ann.shape
        raise SyntaxError(
            f"il_codegen: '{name}[...]' - '{name}' la {kind}, ma {kind} KHONG lay duoc theo "
            f"chi so (giong Python). Neu ban dang viet 'for x in {name}:' thi chuyen "
            f"sang list truoc: 'xs = {name}.to_list()' roi 'for x in xs:'.")
    if type_ann.shape == 'record':
        # __getitem__ cho record (6.5, dunder overload - muc 4, 2026-08-13):
        # r[i] tren 1 BIEN record co __getitem__(self, i) -> T goi callvirt
        # thay vi raise loi generic. Xem docs/superpowers/plans/
        # 2026-08-13-dunder-getitem.md.
        if len(indices) != 1:
            raise SyntaxError(
                f"il_codegen: '{name}[...]' - record chi ho tro 1 chi so nguyen, "
                f"khong ho tro '{name}[i, j]' (da nhan {len(indices)} chi so)")
        record_methods = (ctx or {}).get('record_methods') or {}
        dunder = record_methods.get(type_ann.dtype, {}).get('__getitem__')
        if dunder is None:
            raise SyntaxError(
                f"il_codegen: record '{type_ann.dtype}' khong co __getitem__ - "
                f"'{name}[i]' can dinh nghia "
                f"'def __getitem__(self, i) -> \"T\": ...' (T la kieu tra ve tuy chon)")
        if len(dunder.params) != 1 or dunder.params[0].type_ann.dtype != 'i32' or \
                dunder.params[0].type_ann.shape is not None or dunder.return_type is None:
            raise SyntaxError(
                f"il_codegen: record '{type_ann.dtype}' co __getitem__ nhung chu ky sai - "
                f"can dung 1 tham so \"i32\" va tra ve 1 kieu bat ky "
                f"('def __getitem__(self, i) -> \"T\":')")
        records = (ctx or {}).get('records') or {}
        _load_var_ref(name, scope, out)
        idx_node = indices[0]
        if _neg_literal_int(idx_node) is not None:
            raise SyntaxError(
                f"il_codegen: '{name}[-i]' - __getitem__ tren record chua ho tro chi so "
                f"am (tu xu ly chi so am ben trong than __getitem__ neu can).")
        _compile_expr(idx_node, scope, out, 'i32', ctx)
        from il_features.record_feature import _method_owner_class
        owner = _method_owner_class(ctx, type_ann.dtype, '__getitem__')
        ret_dtype, ret_shape = dunder.return_type.dtype, dunder.return_type.shape
        ret_il = il_type_str(dunder.return_type, records)
        out.append(f'    callvirt instance {ret_il} {owner}::__getitem__(int32)')
        if ret_shape is None:
            _widen_if_needed(ret_dtype, dtype, out)
        return
    if type_ann.shape is None:
        # Loi ro rang thay vi crash TypeError mo ho ('NoneType has no len()')
        # - thuong gap khi 'name' la ket qua cua 1 phep gan 'x = outer[i]'
        # nhung KHONG suy dung duoc shape long nhau (xem gioi han thu tu
        # khai bao trong declare_scalar's nhanh 'index': container BI
        # THAM CHIEU (vd list/dict append vao outer) phai duoc khai bao
        # TRUOC dong khai bao outer trong VAN BAN nguon, Wave 2 2026-07-29).
        raise SyntaxError(
            f"il_codegen: '{name}[...]' - '{name}' khong phai list/dict/string/mang, "
            f"hoac kieu long nhau khong suy dung duoc do thu tu khai bao (container "
            f"duoc THAM CHIEU phai khai bao TRUOC container CHUA no trong van ban nguon)")
    if type_ann.shape == 'tuple':
        # Phase 11b (2026-08-28): 'p[i]' tren 1 BIEN dtype tuple (vd bien
        # vong lap don 'for p in z:' voi z: list[(T1,T2)] tu zip()) - PHAI
        # chan TRUOC 'rank = len(type_ann.shape)' ngay duoi day, vi
        # 'shape' o day la CHUOI 'tuple' (khong phai list so dim nhu mang
        # that) - 'len("tuple")' == 5 se lot xuong nhanh else va bao loi
        # kho hieu 'chi ho tro mang rank 1 hoac 2'. Tuple co kich thuoc
        # CO DINH tai compile-time (khac mang) nen CHI ho tro chi so HANG
        # SO NGUYEN DUONG van ban (khong ho tro bieu thuc chi so dong,
        # giong gioi han co chu dich cua _neg_literal_int o cac nhanh
        # tren) - doc field ItemN qua cung pattern da xac minh THAT trong
        # tuple_type.py's codegen_tuple_assign (ldloc gia tri roi ldfld
        # truc tiep, KHONG can dia chi).
        if len(indices) != 1:
            raise SyntaxError(f"il_codegen: '{name}[...]' tren tuple chi ho tro 1 chi so")
        idx_node = indices[0]
        if not (isinstance(idx_node, tuple) and idx_node[0] == 'num' and '.' not in idx_node[1]):
            raise SyntaxError(
                f"il_codegen: '{name}[i]' tren tuple chi ho tro chi so HANG SO nguyen "
                f"duong tai compile-time (vd '{name}[0]'), khong ho tro chi so dong/am")
        i = int(idx_node[1])
        dtypes = type_ann.tuple_dtypes
        if not dtypes or not (0 <= i < len(dtypes)):
            raise SyntaxError(
                f"il_codegen: '{name}[{i}]' vuot qua so phan tu tuple "
                f"({len(dtypes) if dtypes else 0})")
        from il_features.tuple_type import il_tupleN_type
        tuple_il_type = il_tupleN_type(dtypes)
        _load_var_ref(name, scope, out)
        out.append(f'    ldfld !{i} {tuple_il_type}::Item{i + 1}')
        _widen_if_needed(dtypes[i], dtype, out)
        return
    rank = len(type_ann.shape)
    _load_var_ref(name, scope, out)
    for dim_i, idx_node in enumerate(indices):
        # Chi so am HANG SO tai compile-time (vd 'arr[-1]') - kich thuoc
        # mang CO DINH da biet San (type_ann.shape[dim_i], hang so Python
        # THAT, khong phai CIL) nen gap TRUC TIEP thanh 1 hang so DUONG
        # ngay luc bien dich (don gian hon list/string - khong can goi
        # get_Count() luc chay), Wave 3 2026-07-29.
        n = _neg_literal_int(idx_node)
        if n is not None:
            out.append(f'    ldc.i4 {type_ann.shape[dim_i] - n}')
        else:
            _compile_expr(idx_node, scope, out, 'i32', ctx)
    if rank == 1:
        out.append(f'    {IL_LDELEM[type_ann.dtype]}')
    elif rank == 2:
        cs_arr_type = il_array_rank_type(type_ann.dtype, 2)
        elem_type = IL_SCALAR[type_ann.dtype]
        out.append(f'    callvirt instance {elem_type} {cs_arr_type}::Get(int32, int32)')
    else:
        raise SyntaxError('il_codegen: chi ho tro mang rank 1 hoac 2')
    _widen_if_needed(type_ann.dtype, dtype, out)
    return


# _expr_attr/_expr_method_call da chuyen sang il_features/record_feature.py
# (compile_attr/compile_method_call), Phase 1 buoc 8, 2026-07-28.
# _expr_binop/_expr_boolop/_expr_neg/_expr_not da chuyen sang
# il_features/operators.py (compile_binop/compile_boolop/compile_neg/
# compile_not), Phase 1 buoc 6, 2026-07-28.


def _expr_in(node, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    # 'key in d' (dict) hoac 'x in s' (set) - CHI ho tro tren 1 bien
    # dict/set don. Dictionary<K,V>.ContainsKey(K)/HashSet<T>.Contains(T)
    # deu tra ve bool (int32 0/1 CIL, tuong thich thang voi
    # brfalse/brtrue nhu 1 dieu kien binh thuong, khong can widen).
    key_node, coll_node = node[1], node[2]
    if coll_node[0] != 'var':
        raise SyntaxError("il_codegen: 'in' hien CHI ho tro kiem tra tren 1 bien "
                          "dict/set/list/chuoi don (vd key in d)")
    _, _, coll_ta = scope[coll_node[1]]
    if coll_ta.shape in ('set', 'frozenset'):
        return _set_compile_in_set(key_node, coll_node[1], scope, out, ctx)
    if coll_ta.shape is None and coll_ta.dtype == 'str':
        # '"x" in s' - chuoi CON (2026-08-03). Python that: 'in' tren chuoi
        # la kiem tra chuoi con, khong phai 1 ky tu.
        _load_var_ref(coll_node[1], scope, out)
        _compile_expr(key_node, scope, out, 'str', ctx)
        out.append('    callvirt instance bool [mscorlib]System.String::Contains(string)')
        return
    if coll_ta.shape == 'list':
        # 'x in lst' (2026-08-03) - List<T>::Contains(!0).
        _reject_if_nested_container_elem(coll_ta, "'in'")
        col_type = il_list_type(coll_ta.dtype, (ctx or {}).get('records'), _EXTERN_CLASS_DEFS)
        _load_var_ref(coll_node[1], scope, out)
        _compile_expr(key_node, scope, out, coll_ta.dtype, ctx)
        out.append(f'    callvirt instance bool {col_type}::Contains(!0)')
        return
    if coll_ta.shape != 'dict':
        raise SyntaxError(
            f"il_codegen: 'in' hien CHI ho tro dict/set/list/chuoi ('{coll_node[1]}' co "
            f"shape={coll_ta.shape})")
    return _dict_compile_in_dict(key_node, coll_node[1], scope, out, ctx)


def _gen_lambda_class_il(class_name_l, nested_sig, body_stmts, ctx, captures=None):
    """Sinh 1 '.class' MOI cho 1 lambda (A2, 2026-07-29; mo rong voi
    'captures' o Phase 2.4, 2026-08-11 - xem docstring _compile_lambda_funcref
    ben duoi de biet TOAN BO ly do thiet ke). 'captures' None/rong -> 0
    truong, .ctor khong tham so (duong CU, khong doi). 'captures' co gia
    tri -> list[(ten_bien, TypeAnn, kieu_IL_field)] - MOI bien bi bat la 1
    field CONG KHAI giu GIA TRI TRUC TIEP (KHONG qua cell/boxed nhu
    nested_def's scalar - xem probe_lambda_closure.il da xac minh THAT
    truoc khi viet ham nay: an toan CHI VI lambda dang cho luon duoc GOI
    NGAY LAP TUC tai vi tri tham so, khong bao gio luu lai qua 1 lan goi
    khac - khac han nested_def co the goi NHIEU LAN sau khi bien ngoai da
    doi gia tri, buoc phai dung cell de thay doi 'nhin thay' duoc)."""
    captures = captures or []
    ctor_params_il = ', '.join(f'{fld_il} {name}' for name, _ta, fld_il in captures)
    lines = [
        f'.class public auto ansi {class_name_l} extends [mscorlib]System.Object',
        '{',
    ]
    for name, _ta, fld_il in captures:
        lines.append(f'  .field public {fld_il} {name}')
    lines.append('  .method public hidebysig specialname rtspecialname instance void '
                 f'.ctor({ctor_params_il}) cil managed')
    lines.append('  {')
    lines.append('    .maxstack 8')
    lines.append('    ldarg.0')
    lines.append('    call instance void [mscorlib]System.Object::.ctor()')
    for i, (name, _ta, fld_il) in enumerate(captures):
        lines.append('    ldarg.0')
        lines.append(f'    ldarg.s {i + 1}')
        lines.append(f'    stfld {fld_il} {class_name_l}::{name}')
    lines.append('    ret')
    lines.append('  }')
    closure_captures = [(name, ta, class_name_l, fld_il) for name, ta, fld_il in captures]
    method_lines = gen_il_function(
        nested_sig, None, with_guards=False, func_table=ctx['func_table'],
        class_name=ctx['class_name'], records=ctx['records'], self_type_ann=None,
        record_methods=ctx['record_methods'], closure_captures=closure_captures,
        is_closure_method=True, extra_classes=ctx['extra_classes'],
        emitted_types=ctx['emitted_types'], pre_parsed_stmts=body_stmts)
    lines.extend(method_lines)
    lines.append('}')
    return lines


def _compile_lambda_funcref(arg_node, target_ta, scope: _Scope, out: list, ctx: dict):
    """'lambda x, y: expr' truyen TRUC TIEP lam tham so kieu 'func' (A2,
    2026-07-29 - muc tieu Claude tu tin dung viet code that). Kieu THAM SO/
    TRA VE cua lambda suy HOAN TOAN tu `target_ta` (lambda khong co chu
    thich kieu rieng trong cu phap - NGOAI LE co y thuc CHI danh cho vi tri
    nay, vi kieu da biet CHAC CHAN tu tham so 'func' dang cho o call-site,
    KHONG phai doan mo).

    Phase 2.4 (2026-08-11) - ho tro BAT BIEN TU DO (khac ban dau chi 0
    free variable): quyet dinh sau khi test doc lap qua probe_lambda_closure.il
    (Lua chon 3 nguoi dung chon, xem docs/PYTHON_GAP_IMPLEMENTATION_PLAN.md).
    Phat hien bien tu do bang _collect_var_names (tai dung TU closures.py,
    KHONG sua closures.py/nested_def - co y thuc GIU NGUYEN co che
    nested_def dang chay dung 16/16 test, tranh rui ro). Voi MOI bien tu do
    tim thay VA da khai bao trong 'scope' cua ham dang bien dich: bat qua
    GIA TRI TRUC TIEP (KHONG cell/boxed, khac nested_def's scalar) - AN
    TOAN vi lambda CHI dung duoc o vi tri tham so goi ham NGAY LAP TUC (Wave
    3's gioi han cu van con nguyen: khong gan duoc vao bien/tra ve ngoai
    ham), nen khong co 'lan goi sau' de gia tri cu the doi truoc do can
    nhin thay - xem _gen_lambda_class_il's docstring. Neu than lambda
    tham chieu 1 ten KHONG PHAI tham so cua no VA KHONG nam trong scope
    hien tai (vd goi nham 1 ten khong ton tai), loi bien-khong-xac-dinh se
    tu nhien tu tang duoi (scope KeyError) khi gen_il_function bien dich
    than method - van CHAP NHAN duoc (bao loi ro rang, khong am tham
    sai), giu nguyen tinh than gioi han da ghi tu ban dau."""
    _, param_names, body_node = arg_node
    if len(param_names) != len(target_ta.func_params):
        raise SyntaxError(
            f"il_codegen: lambda co {len(param_names)} tham so nhung vi tri nay can "
            f"{len(target_ta.func_params)} tham so kieu 'func' (({', '.join(target_ta.func_params)}) "
            f"-> {target_ta.dtype})")
    records = (ctx or {}).get('records')
    param_name_set = set(param_names)
    candidate_names = set()
    _lambda_collect_var_names(body_node, candidate_names)
    free_names = sorted(n for n in (candidate_names - param_name_set) if n in scope)
    captures = []
    for name in free_names:
        _, _, cap_ta = scope[name]
        captures.append((name, cap_ta, il_type_str(cap_ta, records)))

    # BUG THAT phat hien 2026-08-11 (Phase 2.4, khi test capture): ten class
    # truoc day dung 1 bo dem RIENG cho MOI ham (ctx['_lambda_counter'] -
    # ctx la dict TAO MOI moi lan gen_il_function chay cho 1 ham TOP-LEVEL
    # khac nhau, xem gen_il_program), trong khi 'emitted_types'/'extra_classes'
    # la CHUNG cho CA chuong trinh - lambda DAU TIEN trong BAT KY ham nao
    # cung ten '__Lambda_1', nen lambda thu 2 (o 1 ham KHAC) trung ten se bi
    # "emitted_types check" coi la DA sinh roi va DUNG LAI class cua lambda
    # DAU - than lambda SAI ("goi nham" lambda cua ham khac) MA KHONG BAO
    # LOI GI (sai am tham, chi lo ra khi capture khac chu ky ctor -> crash
    # ro rang thay vi am tham). Sua bang dung id(arg_node) lam khoa (moi
    # node AST lambda la 1 object Python rieng, id() duy nhat trong doi
    # chuong trinh dang bien dich) - cung quy uoc voi '__strtmp{id(arg)}'/
    # '__dictiter{id(stmt)}' da dung o noi khac trong file nay.
    class_name_l = f"__Lambda_{id(arg_node)}"
    params = [Param(n, TypeAnn(d, None)) for n, d in zip(param_names, target_ta.func_params)]
    nested_sig = Signature('invoke', params, TypeAnn(target_ta.dtype, None), 'block')
    body_stmts = [{'kind': 'return', 'expr_node': body_node, 'expr_text': '<lambda>'}]
    emitted = ctx['emitted_types']
    if class_name_l not in emitted:
        emitted.add(class_name_l)
        ctx['extra_classes'].append(
            _gen_lambda_class_il(class_name_l, nested_sig, body_stmts, ctx, captures))
    params_il = ', '.join(IL_SCALAR[d] for d in target_ta.func_params)
    ret_il = IL_SCALAR[target_ta.dtype]
    func_il = il_type_str(target_ta, records)
    for name, _cap_ta, _fld_il in captures:
        _load_var_ref(name, scope, out)
    ctor_params_il = ', '.join(fld_il for _n, _ta, fld_il in captures)
    out.append(f'    newobj instance void {class_name_l}::.ctor({ctor_params_il})')
    out.append(f'    ldftn instance {ret_il} {class_name_l}::invoke({params_il})')
    out.append(f'    newobj instance void {func_il}::.ctor(object, native int)')


def _compile_funcref_arg(arg_node, target_ta, scope: _Scope, out: list, ctx: dict = None):
    """Bien 1 tham so goi ham kieu 'func' (function reference hep, Wave 3
    2026-07-29) thanh IL nap 1 delegate len stack. Nhan 3 dang bieu thuc:
    (a) TEN 1 ham top-level truc tiep (vd apply(double_it, x)) - dung
    ldftn+newobj tao delegate tai cho; (b) TEN 1 bien/tham so DA la kieu
    'func' (chuyen tiep, vd goi lai 1 ham nhan tham so 'func' voi chinh
    tham so 'func' cua minh, HOAC 1 bien vua nhan closure tra ve tu return-
    value cua ham khac - xem b1 trong project-tokenvector-wave2-status
    memory) - chi nap lai gia tri co san; (c) TEN 1 ham long (nested
    closure) CUA CHINH ham dang bien dich, truyen THANG khong qua bien
    trung gian (vd 'apply(inc, 5)' ngay trong than ham da 'def inc():') -
    dung _build_closure_delegate (giong het _expr_var/_expr_call's nhanh
    nested_closures); (d) 'lambda x, ...: expr' TRUC TIEP (A2, 2026-07-29,
    CHI ho tro khong bat bien ngoai) - xem _compile_lambda_funcref. KHONG
    ho tro bieu thuc khac (ket qua 1 loi goi khac...) - ngoai pham vi co y
    thuc, xem TypeAnn.func_params."""
    if arg_node[0] == 'lambda':
        return _compile_lambda_funcref(arg_node, target_ta, scope, out, ctx or {})
    if arg_node[0] != 'var':
        raise SyntaxError(
            "il_codegen: tham so kieu 'func' hien CHI nhan TEN 1 ham top-level, 1 bien/tham so "
            "kieu 'func' khac, 1 ham long CUA CHINH ham dang bien dich TRUC TIEP, hoac 1 lambda "
            "TRUC TIEP (vd apply(double_it, x) / apply(lambda x: x*2, y)), khong ho tro bieu "
            "thuc khac (ket qua loi goi khac)")
    name = arg_node[1]
    nested_closures = (ctx or {}).get('nested_closures') or {}
    if name not in scope and name in nested_closures:
        info = nested_closures[name]
        nested_sig = info['nested_sig']
        callee_params = [p.type_ann.dtype for p in nested_sig.params]
        callee_ret = nested_sig.return_type.dtype if nested_sig.return_type else None
        if callee_params != target_ta.func_params or callee_ret != target_ta.dtype:
            raise SyntaxError(
                f"il_codegen: chu ky ham long '{name}' (({', '.join(callee_params)}) -> "
                f"{callee_ret}) khong khop kieu 'func' mong doi (({', '.join(target_ta.func_params)}) "
                f"-> {target_ta.dtype})")
        _build_closure_delegate(name, info, scope, out)
        return
    if name in scope:
        src_ta = scope[name][2]
        if src_ta.shape != 'func':
            raise SyntaxError(
                f"il_codegen: '{name}' khong phai bien kieu 'func' (shape={src_ta.shape!r})")
        if src_ta.func_params != target_ta.func_params or src_ta.dtype != target_ta.dtype:
            raise SyntaxError(
                f"il_codegen: chu ky 'func' cua '{name}' khong khop kieu tham so mong doi")
        _load_var_ref(name, scope, out)
        return
    func_table = (ctx or {}).get('func_table') or {}
    if name not in func_table:
        raise SyntaxError(
            f"il_codegen: '{name}' khong phai 1 ham da khai bao trong chuong trinh "
            f"(tham so kieu 'func')")
    callee = func_table[name]
    callee_params = [p.type_ann.dtype for p in callee.params]
    callee_ret = callee.return_type.dtype if callee.return_type else None
    if callee_params != target_ta.func_params or callee_ret != target_ta.dtype:
        raise SyntaxError(
            f"il_codegen: chu ky ham '{name}' (({', '.join(callee_params)}) -> {callee_ret}) "
            f"khong khop kieu 'func' mong doi (({', '.join(target_ta.func_params)}) -> "
            f"{target_ta.dtype})")
    class_name = (ctx or {}).get('class_name') or 'Program'
    # muc P follow-up (2026-08-19): callee_params/callee_ret co the la handle
    # type (vd map(to_str, xs: list[Sb]) voi to_str(s: "Sb") -> "str") -
    # dung _il_scalar_or_handle thay vi IL_SCALAR truc tiep, xem dau file.
    params_il = ', '.join(_il_scalar_or_handle(d) for d in callee_params)
    ret_il = _il_scalar_or_handle(callee_ret)
    func_il = il_type_str(target_ta, (ctx or {}).get('records'))
    out.append('    ldnull')
    out.append(f'    ldftn {ret_il} {class_name}::{_il_ident(name)}({params_il})')
    out.append(f'    newobj instance void {func_il}::.ctor(object, native int)')


def _compile_funcref_call(name, args, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    """Goi 1 bien/tham so kieu 'func' nhu 1 loi goi ham (vd 'f(x)' voi f la
    tham so 'func(i32)->i32') - nap gia tri delegate roi callvirt Invoke().
    PHAI dung ky hieu generic mo (!0/!1/...) trong chu ky Invoke, khong
    thay truc tiep dtype - xem ghi chu trong il_type_str (spike_funcref.il
    da xac nhan thay truc tiep gay MissingMethodException luc chay)."""
    fta = scope[name][2]
    if len(args) != len(fta.func_params):
        raise SyntaxError(
            f"il_codegen: goi '{name}' (kieu 'func') voi {len(args)} tham so nhung can "
            f"{len(fta.func_params)}")
    _load_var_ref(name, scope, out)
    for arg_node, pdtype in zip(args, fta.func_params):
        _compile_expr(arg_node, scope, out, pdtype, ctx)
    n = len(fta.func_params)
    generic_args = ', '.join([IL_SCALAR[p] for p in fta.func_params] + [IL_SCALAR[fta.dtype]])
    invoke_params = ', '.join(f'!{i}' for i in range(n))
    func_il = f'class [System.Core]System.Func`{n + 1}<{generic_args}>'
    out.append(f'    callvirt instance !{n} {func_il}::Invoke({invoke_params})')
    _widen_if_needed(fta.dtype, dtype, out)


def _index_expr_base_ta(node, scope, func_table, records=None):
    """TypeAnn cua GIA TRI ma node[1] (co so, vd 'm[0]' trong 'm[0][0]')
    tra ve - dung CHUNG boi _index_expr_result_ta (lay elem_ta cua gia
    tri nay lam ket qua CUOI CUNG cua ca bieu thuc) VA _expr_index_expr
    (dung CHINH gia tri nay - khong phai elem_ta cua no - de biet cach
    emit get_Item).

    Tach ra tu final-review I1 (2026-08-19): nhanh node[1][0]=='index'
    truoc day nam TRONG _index_expr_result_ta va tra THANG
    base_var_ta.elem_ta, tuc tra ve kieu cua CO SO ('m[0]') duoi danh
    nghia "kieu cua KET QUA" ('m[0][0]') - dung cho _expr_index_expr
    nhung SAI cho len()/_infer_dtype (repro that: 'len(m[0][0])' voi m la
    list[list[i32]] build OK nhung nem ArgumentOutOfRangeException luc
    chay vi coi scalar int32 nhu 1 list)."""
    if node[1][0] == 'index':
        try:
            _, _, base_var_ta = scope[node[1][1]]
        except KeyError:
            return None
        return base_var_ta.elem_ta
    return _shaped_return_ta_of_call(node[1], func_table, scope, records)


def _index_expr_result_ta(node, scope, ctx_or_func_table, records=None):
    """TypeAnn cua KET QUA '<bieu thuc>[i]' - dung CHUNG boi _infer_dtype
    va len(<bieu thuc>). LUON la kieu cua 1 PHAN TU cua co so (xem
    _index_expr_base_ta cho kieu cua CHINH co so)."""
    func_table = ctx_or_func_table if isinstance(ctx_or_func_table, dict) else {}
    base_ta = _index_expr_base_ta(node, scope, func_table, records)
    if base_ta is None:
        # Co so la 1 CHUOI (vd 'xs[1][2]' voi xs: list[str]) - lay 1 ky tu
        # cho ra 1 chuoi, GIONG HET nhanh chuoi ma _expr_index_expr da
        # emit o tang codegen. Khong co nhanh nay thi _infer_dtype tra
        # None -> local ben trai bi khai bao theo body_dtype (vd 'i32')
        # trong khi codegen day 1 string len stack -> InvalidProgramException
        # luc chay (repro that, final-review I2, 2026-08-19).
        try:
            base_dtype = _infer_dtype(node[1], scope, func_table, records)
        except Exception:
            base_dtype = None
        if base_dtype == 'str':
            return TypeAnn('str', None)
        return None
    if base_ta.elem_ta is not None:
        return base_ta.elem_ta
    if base_ta.shape in ('list', 'dict'):
        return TypeAnn(base_ta.dtype, None)
    return None


def _compile_len_of_expr(arg, scope, out, dtype, ctx):
    """len() tren 1 BIEU THUC (khong phai bien don). Tach rieng khoi
    _expr_call de nhanh 'len(bien)' cu giu nguyen hinh dang (no doc
    scope[...] truc tiep, khong can suy luan gi)."""
    func_table = (ctx or {}).get('func_table') or {}
    records = (ctx or {}).get('records') or {}
    record_methods = (ctx or {}).get('record_methods') or {}
    ta = _shaped_return_ta_of_call(arg, func_table, scope, records)
    if ta is None and arg[0] == 'index_expr':
        ta = _index_expr_result_ta(arg, scope, func_table, records)
    if ta is None:
        try:
            d = _infer_dtype(arg, scope, func_table, records, record_methods)
        except Exception:
            d = None
        if d == 'str':
            ta = TypeAnn('str', None)
    if ta is None:
        raise SyntaxError(
            "il_codegen: len(<bieu thuc>) - khong suy duoc hinh dang cua bieu thuc. "
            "Ho tro: bien don, loi goi ham/method tra ve list/dict/set/str "
            "(vd len(s.split(\",\")), len(d.keys())) - truong hop khac thi gan ra "
            "1 bien truoc roi len() bien do.")
    if ta.shape is None and ta.dtype == 'str':
        _compile_expr(arg, scope, out, 'str', ctx)
        out.append('    callvirt instance int32 [mscorlib]System.String::get_Length()')
        _widen_if_needed('i32', dtype, out)
        return
    if ta.shape in ('list', 'bytearray', 'bytes'):
        # muc 6.8 (3/4 va 4/4, 2026-08-13): len(bytearray)/len(bytes) TAI
        # DUNG nhanh list - il_type_str da day nhanh 'bytearray'/'bytes' o
        # tren, get_Count() khong phu thuoc dtype phan tu.
        col_type = il_type_str(ta, records)
    elif ta.shape in ('set', 'frozenset'):
        col_type = il_set_type(ta.dtype, records, _EXTERN_CLASS_DEFS)
    elif ta.shape == 'dict':
        col_type = il_type_str(ta, records)
    else:
        raise SyntaxError(
            f"il_codegen: len(<bieu thuc>) chi ap dung cho list/dict/set/frozenset/bytearray/bytes/str - bieu thuc "
            f"nay co dtype={ta.dtype!r} shape={ta.shape!r}")
    _compile_expr(arg, scope, out, ta.dtype, ctx)
    out.append(f'    callvirt instance int32 {col_type}::get_Count()')
    _widen_if_needed('i32', dtype, out)



def _expr_index_expr(node, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    """'<bieu thuc>[i]' - vd 's.split(",")[0]', 'd.items()[0]' (2026-08-03).
    KHAC tag 'index' (node[1] la TEN BIEN): o day co so la 1 gia tri duoc
    TINH ra roi day len stack, khong co memory slot de _load_var_ref.

    Hinh dang cua co so lay tu _shaped_return_ta_of_call - CUNG nguon voi
    len(<bieu thuc>) va voi phep gan 'parts = s.split(",")', khong them
    duong suy luan moi. Chi so AM chua ho tro o day (can get_Count() luc
    chay tren 1 gia tri tam - se phai nhan doi gia tri co so tren stack;
    de danh khi co nhu cau that)."""
    base_node, idx_node = node[1], node[2]
    func_table = (ctx or {}).get('func_table') or {}
    records = (ctx or {}).get('records') or {}
    record_methods = (ctx or {}).get('record_methods') or {}
    # Kieu cua CHINH co so (khong phai cua ket qua) - day la thu can de
    # biet emit get_Item cua List<T> hay Dictionary<K,V>. Xu ly ca 2
    # truong hop co so (node 'index' long nhau vs loi goi tra container)
    # trong 1 ham dung chung, xem _index_expr_base_ta (final-review I1).
    ta = _index_expr_base_ta(node, scope, func_table, records)
    if ta is None:
        # 'self.src[i]' / '<bieu thuc chuoi>[i]' (2026-08-03): co so la 1
        # CHUOI - lay 1 ky tu, giong nhanh 'bien_chuoi[i]' da co.
        try:
            base_dtype = _infer_dtype(base_node, scope, func_table, records, record_methods)
        except Exception:
            base_dtype = None
        if base_dtype == 'str':
            _compile_expr(base_node, scope, out, 'str', ctx)
            _compile_expr(idx_node, scope, out, 'i32', ctx)
            out.append('    callvirt instance char [mscorlib]System.String::get_Chars(int32)')
            out.append('    ldc.i4.1')
            out.append('    newobj instance void [mscorlib]System.String::.ctor(char, int32)')
            return
    if ta is None:
        raise SyntaxError(
            "il_codegen: '<bieu thuc>[i]' - khong suy duoc hinh dang cua bieu thuc "
            "ben trai. Ho tro loi goi ham/method tra ve list/dict/chuoi "
            "(vd s.split(\",\")[0], self.src[i]) - truong hop khac thi gan ra 1 bien truoc.")
    if _neg_literal_int(idx_node) is not None:
        raise SyntaxError(
            "il_codegen: '<bieu thuc>[-i]' (chi so am tren ket qua 1 loi goi) chua "
            "ho tro - gan ra 1 bien truoc roi lay chi so am tren bien do.")
    col_type = il_type_str(ta, records)
    if ta.shape == 'list':
        _compile_expr(base_node, scope, out, ta.dtype, ctx)
        _compile_expr(idx_node, scope, out, 'i32', ctx)
        out.append(f'    callvirt instance !0 {col_type}::get_Item(int32)')
    elif ta.shape == 'dict':
        _compile_expr(base_node, scope, out, ta.dtype, ctx)
        _compile_expr(idx_node, scope, out, ta.key_dtype, ctx)
        out.append(f'    callvirt instance !1 {col_type}::get_Item(!0)')
    else:
        raise SyntaxError(
            f"il_codegen: '<bieu thuc>[i]' chi ap dung cho list/dict - bieu thuc nay "
            f"co shape={ta.shape!r}")
    if ta.elem_ta is None:
        _widen_if_needed(ta.dtype, dtype, out)



def _compile_round_builtin(args, scope, out, dtype, ctx):
    """'round(x)'/'round(x, n)' (2026-08-05, thay the nhanh _MATH_FUNCS
    chung - 'round' truoc day bi ep dung khuon 1-doi-so/tra-cung-dtype
    cua Sqrt/Sin/... nen 'round(x, n)' bao loi "chi nhan dung 1 tham so",
    va 'round(x)' tra ve f64 ("2.0") trong khi Python round(x) KHONG co
    ndigits tra ve INT ("2").

    .NET Math.Round(double)/Math.Round(double,int32) MAC DINH lam tron
    VE SO CHAN (banker's rounding) - DA DO THAT khop Python o moi ca
    midpoint (0.5->0, 1.5->2, 2.5->2, -0.5->0, 3.5->4, 4.5->4 - xem
    test/parity/ledger.toml), KHONG can MidpointRounding.ToEven tuong
    minh nhu gia dinh ban dau (chua kiem chung) - do THAT truoc, dung
    sau."""
    if len(args) == 1:
        ctx['compile_expr'](args[0], scope, out, 'f64', ctx)
        out.append('    call float64 [mscorlib]System.Math::Round(float64)')
        if dtype == 'int':
            import il_features.int_type as _int_type
            _int_type.ensure_class(ctx)
            out.append(f'    call valuetype {_int_type.TKVINT_CLASS} '
                       f'{_int_type.TKVINT_CLASS}::FromF64(float64)')
        elif dtype == 'i64':
            out.append('    conv.i8')
        elif dtype == 'f32':
            out.append('    conv.r4')
        elif dtype != 'f64':
            # i32 hoac chua suy duoc kieu (None) - i32 la boi canh pho
            # bien nhat khi khong co annotation ro rang.
            out.append('    conv.i4')
        return
    if len(args) == 2:
        ctx['compile_expr'](args[0], scope, out, 'f64', ctx)
        ctx['compile_expr'](args[1], scope, out, 'i32', ctx)
        out.append('    call float64 [mscorlib]System.Math::Round(float64, int32)')
        if dtype == 'f32':
            out.append('    conv.r4')
        return
    raise SyntaxError("il_codegen: round() nhan 1 hoac 2 tham so")


def _il_array_elem_type(elem, extern_class_defs=None):
    """Phase 9h (2026-08-27): IL text cua 1 PHAN TU mang 'array[T]' - T la
    1 trong 5 scalar Phase 9g (_EXTERN_DTYPE_TO_IL) HOAC 1 handle-type da
    khai (extern_class_defs, cung cong thuc 'class [assembly]ClassName'
    ma il_container_type_of_spec da dung cho list[HandleType], xem
    list_type.py dong 81-83). Goi sau khi da qua validate
    (_validate_extern_class_container_dtype) nen elem CHAC CHAN khop 1
    trong 2 tap (hoac Phase 9i: 1 chuoi 'array[T]' con - xem duoi) -
    KeyError o day la loi logic that (validate lech), khong phai input
    nguoi dung sai.

    extern_class_defs: nhan qua tham so (Minor 2, review Phase 9h) thay vi
    doc thang module-global _EXTERN_CLASS_DEFS, dong bo voi _il_ctor_param_type
    (ham goi ham nay) da co san tham so nay trong scope. Mac dinh None ->
    fallback ve module-global _EXTERN_CLASS_DEFS de giu tuong thich nguoc cho
    2 diem goi con lai (_compile_extern_object_arg/_marshal_extern_return_array)
    khong truyen tham so nay.

    Phase 9i (2026-08-28): 'elem' CHINH NO co the la 1 chuoi 'array[T]'
    (vd goi tu _il_ctor_param_type('array[array[i32]]', ...) -> elem o do
    la 'array[i32]') - de quy 1 lan, tra ve IL text cua T[] (1 cap). Chi
    can DUY NHAT dieu kien nay o day (khong can ham rieng) vi
    _il_ctor_param_type's nhanh 'array[' da tu dong cong them 1 dau '[]'
    NUA o ben ngoai (xem il_codegen.py dong ~2016: 'return
    _il_array_elem_type(elem, extern_class_defs) + '[]''), nen ket qua
    cuoi cung cho 'array[array[i32]]' la 'int32[]' + '[]' = 'int32[][]'
    (jagged array 2 chieu DUNG cu phap ilasm) MA KHONG CAN sua
    _il_ctor_param_type gi them - _EXTERN_NESTED_ARRAY_DTYPE_RE (Task 1
    Step 1/4) da chan CHAT o tang validate nen elem o day KHONG BAO GIO
    sau hon 1 lop 'array[' (khong de quy vo han)."""
    if isinstance(elem, str) and elem.startswith('array['):
        inner_elem = elem[len('array['):-1]
        return _il_array_elem_type(inner_elem, extern_class_defs) + '[]'
    import tkv_compile
    if elem in tkv_compile._EXTERN_DTYPE_TO_IL:
        return tkv_compile._EXTERN_DTYPE_TO_IL[elem]
    defs = extern_class_defs if extern_class_defs is not None else _EXTERN_CLASS_DEFS
    d = defs[elem]
    return f"class [{d['assembly']}]{d['class']}"


def _il_ctor_param_type(dtype_name, extern_class_defs):
    """Kieu CIL cua 1 tham so constructor/method handle-type - hoac 1
    handle-type KHAC, list[T]/dict[K,V] (ke ca long nhau 1 lop), hoac 1
    scalar thuong. THIN WRAPPER quanh il_container_type_of_spec (muc F,
    docs/BUGS_TODO.md - hop nhat 2 implementation trung lap voi
    _il_list_of trong list_type.py). GIU NGUYEN chu ky/hanh vi cu
    (records=None luon - CHUA ho tro list[RecordType] lam tham so
    constructor extern-class, xem task-1-report.md (.superpowers/sdd/,
    gitignored) va xem docs/BUGS_TODO.md muc F (trong repo, on dinh hon)
    ve ly do CHUA mo rong o day).

    Phase 9c (2026-08-26): dtype dang 'enum:<assembly>:<FullName>' KHONG
    di qua il_container_type_of_spec (bang IL_SCALAR loi khong biet dinh
    dang nay, va KHONG NEN biet - day la khai niem RIENG cua extern-class/
    -method, khong phai 1 dtype TokenVector that) - short-circuit truoc,
    uy quyen sang tkv_compile._extern_il_type_text (import cuc bo de
    tranh vong lap import module - tkv_compile.py da import il_codegen o
    dau file, xem pattern tuong tu tai dong 1897 cua tkv_compile.py)."""
    if isinstance(dtype_name, str) and dtype_name.startswith('enum:'):
        import tkv_compile
        return tkv_compile._extern_il_type_text(dtype_name)
    if dtype_name == 'type':
        # Phase 9d Part B (2026-08-27): dtype co dinh 'type' (System.Type)
        # KHONG nam trong IL_SCALAR (khac 'object', da co san o do cho
        # dtype noi bo 'thread' - xem il_core.py:9) - short-circuit rieng,
        # mirror y het nhanh 'enum:...' ngay tren, TRANH sua IL_SCALAR
        # (Global Constraint cua plan nay).
        return 'class [mscorlib]System.Type'
    if isinstance(dtype_name, str) and dtype_name.startswith('array['):
        # Phase 9g (2026-08-27): 'array[T]' CHI ton tai o bien extern (chu
        # ky IL goi method .NET that su nhan/tra CLR array T[]) - KHONG di
        # qua _il_container_type_of_spec (ham do chi biet 'list[T]' TokenVector
        # that, se hieu nham 'array[' la 1 spec la roi loi). Uy quyen sang
        # _il_array_elem_type (ham helper moi Task 1) de tra IL text cua
        # phan tu T, mirror pattern nhanh 'enum:...' ngay tren.
        elem = dtype_name[len('array['):-1]
        return _il_array_elem_type(elem, extern_class_defs) + '[]'
    return _il_container_type_of_spec(dtype_name, records=None,
                                       extern_class_defs=extern_class_defs)


# Critical 1 + Important 1 (final review Phase 9d Part B, 2026-08-27): dtype
# THAT (_infer_dtype) cua 1 doi so thuoc tap nay la 1 VALUE TYPE vo huong
# (khong phai reference type) - nap THANG len vi tri tham so khai 'object'
# ma KHONG box la BUG THAT (memory corruption/gia tri rac, xem Critical 1).
# 'bool' duoc giu trong tap nay de dong bo voi _EXTERN_DTYPE_TO_IL (dtype
# 'bool' IL that su KHONG BAO GIO xuat hien lam ket qua _infer_dtype vi
# TokenVector luon coi gia tri bool la i32 phia minh - xem
# _tokenvector_facing_dtype - nen nhanh nay se khong bao gio khop 'bool'
# trong thuc te, chi giu de code tu-tai-lieu-hoa dung tap _EXTERN_DTYPE_TO_IL).
_EXTERN_ARG_VALUE_DTYPES = {'i32', 'i64', 'f32', 'f64', 'bool'}


def _compile_extern_object_arg(arg_node, scope, out, want_dtype, ctx):
    """Bien dich 1 doi so truyen vao 1 tham so extern (method/ctor/property-
    setter/ham __tkv_extern_class__) khai dtype 'object' hoac 'type' - DUNG
    CHUNG cho MOI diem goi (thay the pattern lap lai truoc day
    'ctx["compile_expr"](arg_node, scope, out, tkv_compile._tokenvector_
    facing_dtype(want_dtype), ctx)' - xem Critical 1/Important 1, final
    review Phase 9d Part B):

    (a) want_dtype == 'type': dtype THAT cua doi so (qua _infer_dtype) PHAI
        CHINH LA 'type' (chi typeof(ClassName) hoac 1 bien da duoc gan/suy
        dtype 'type' truoc do moi hop le) - neu khong, TranspileError NGAY
        luc bien dich (Important 1) thay vi de mot handle-type instance/
        gia tri bat ky bi doc nham nhu 1 System.Type luc chay
        (AccessViolationException).
    (b) want_dtype == 'object': neu dtype THAT cua doi so la 1 value-type vo
        huong (_EXTERN_ARG_VALUE_DTYPES) - CIL KHONG tu dong box khi nap 1
        gia tri kieu tri vao vi tri tham so khai 'object' (khac reference
        type, nap THANG duoc, AN TOAN) - emit 'box <IL type>' NGAY SAU khi
        doi so da nam tren dinh stack (Critical 1), neu khong callee doc
        gia tri nhu the no la 1 tham chieu (AccessViolationException hoac
        doc rac tuy dtype cu the).
    Voi cac want_dtype khac ('object'/'type' khong khop 2 nhanh tren, hoac
    scalar/enum/extern_class thuong), hanh vi giu NGUYEN 100% (chi goi
    compile_expr, khong box/validate gi them) - AN TOAN, khong thay doi
    hanh vi da xac minh cua cac dtype khac."""
    import tkv_compile
    func_table = (ctx or {}).get('func_table')
    records = (ctx or {}).get('records')
    record_methods = (ctx or {}).get('record_methods')
    nested_closures = (ctx or {}).get('nested_closures')
    actual = _infer_dtype(arg_node, scope, func_table, records, record_methods, nested_closures)
    if want_dtype == 'type' and actual != 'type':
        raise tkv_compile.TranspileError(
            "il_codegen: tham so khai dtype 'type' (System.Type) nhung doi so "
            "truyen vao KHONG phai 1 gia tri 'type' that (chi 'typeof(ClassName)' "
            "hoac 1 bien da duoc suy dtype 'type' moi hop le) - vd 1 handle-type "
            "instance (bien __tkv_extern_class__ thuong) truyen vao day se gay "
            "loi luc chay (AccessViolationException)")
    _compile_expr(arg_node, scope, out, tkv_compile._tokenvector_facing_dtype(want_dtype), ctx)
    if want_dtype == 'object' and actual in _EXTERN_ARG_VALUE_DTYPES:
        il_type = tkv_compile._EXTERN_DTYPE_TO_IL[actual]
        out.append(f'    box {il_type}')
    elif isinstance(want_dtype, str) and want_dtype.startswith('array['):
        # Phase 9g (2026-08-27): _compile_expr o tren da day 1 List<T>
        # TokenVector len stack (dtype PHIA TOKENVECTOR cua 'array[T]' la
        # 'list[T]', xem _tokenvector_facing_dtype) - method .NET that su
        # nhan CLR array T[] (chu ky IL da khai T[] qua _il_ctor_param_type),
        # nen phai goi List<T>.ToArray() NGAY SAU khi doi tuong nam tren
        # dinh stack de chuyen doi truoc khi nap vao vi tri tham so.
        #
        # Important 1 (review Phase 9g, 2026-08-27): 'actual' (dtype SUY RA
        # THAT cua bieu thuc doi so, tinh o tren qua _infer_dtype) PHAI
        # khop dung 'list[T]' CUNG mot T voi want_dtype - neu khong (vd 1
        # bien 'lst = [1,2,3,4]' KHONG annotation suy ra 'list[int]'
        # (TkvInt, bignum) thay vi 'list[i32]' truyen vao tham so khai
        # 'array[i32]'), ilasm VAN chap nhan callvirt sinh ra (chi la 1
        # method-ref, khong xac minh generic argument that su cua object
        # tren stack) nhung .NET runtime nem ArrayTypeMismatchException
        # ngay trong List<T>.ToArray() luc CHAY (object THAT la
        # List<TkvInt>, khong phai List<int32>) - loi am tham, kho debug.
        # Chan NGAY luc bien dich bang TranspileError ro rang, mirror phong
        # cach nhanh 'want_dtype == 'type' and actual != 'type'' o tren.
        elem = want_dtype[len('array['):-1]
        want_list_dtype = tkv_compile._tokenvector_facing_dtype(want_dtype)
        # actual is None: bieu thuc "boi hinh" (vd list-literal INLINE
        # truc tiep tai vi tri doi so, KHONG qua 1 bien trung gian) -
        # _infer_dtype KHONG co nhanh rieng cho tag 'list_literal' (giong
        # het so nguyen/thuc "boi hinh" o docstring _infer_dtype), tra ve
        # None CO CHU DICH vi _compile_expr o TREN (dong truoc do trong ham
        # nay) DA duoc truyen dung want_dtype lam ngu canh - codegen_expr_
        # list_literal (list_type.py) UU TIEN dtype ngu canh nay de quyet
        # dtype phan tu, nen ket qua THAT SU tren stack CHAC CHAN dung
        # list[T] mong doi, AN TOAN bo qua check (None != la "khong xac
        # dinh duoc tinh", khong phai "sai kieu").
        if actual is not None and actual != want_list_dtype:
            # Fix (review Phase 9i Task 2): thong bao loi cu hardcode
            # 'list[T]' bat ke muc long thuc te cua want_dtype - voi
            # 'array[array[T]]' (2 cap), dtype TokenVector-facing that su
            # la 'list[list[T]]' (xem _tokenvector_facing_dtype), noi
            # "marshal tu list[T]" gay hieu lam sai muc long. Dung
            # want_list_dtype (da tinh dung qua _tokenvector_facing_dtype
            # phia tren, dung cho CA 1 cap lan 2 cap) thay vi chuoi
            # 'list[T]' co dinh.
            raise tkv_compile.TranspileError(
                f"il_codegen: tham so khai dtype {want_dtype!r} (mang .NET, marshal tu "
                f"{want_list_dtype!r} TokenVector) nhung doi so truyen vao co dtype THAT la "
                f"{actual!r}, khong khop {want_list_dtype!r} - vd 1 list-literal khong "
                f"annotation kieu mac dinh suy 'list[int]' (TkvInt, bignum) chu khong "
                f"phai {want_list_dtype!r}, truyen vao day se gay ArrayTypeMismatchException "
                f"luc chay (khong phai loi bien dich ro rang)")
        if isinstance(elem, str) and elem.startswith('array['):
            # Phase 9i (2026-08-28): 'array[array[T]]' - KHONG co method
            # BCL 1-dong nao lam List<List<T>> -> T[][] (khac 1 cap) -
            # phat 1 vong lap IL that qua module nested_array_extern.
            inner_elem = elem[len('array['):-1]
            extern_class_defs = (ctx or {}).get('extern_class_defs') or _EXTERN_CLASS_DEFS
            _nested_array_extern.emit_arg_marshal_loop(inner_elem, extern_class_defs, ctx, out)
        else:
            il_elem = _il_array_elem_type(elem)
            list_il = f"class [mscorlib]System.Collections.Generic.List`1<{il_elem}>"
            # Ghi chu IL: kieu tra ve cua 1 method tren generic type CU THE hoa
            # phai viet theo dang generic-parameter mo (!0), khong phai kieu da
            # thay the (il_elem) - dung quy uoc ilasm cho method tren 1 dong
            # generic instantiation (khac han kieu tham so cua .ctor, noi !0 la
            # ban than kieu generic parameter cua List`1 khai bao).
            out.append(f'    callvirt instance !0[] {list_il}::ToArray()')


def _marshal_extern_return_array(dtype_name, out, ctx=None):
    """Phase 9g (2026-08-27): neu dtype_name la 'array[T]', gia tri THAT
    SU tren stack NGAY SAU callvirt/call la 1 CLR array T[] (chu ky IL da
    khai T[] qua _il_ctor_param_type) - nhung phia TokenVector coi day la
    1 list[T] (List<T>, xem _tokenvector_facing_dtype). Boc array thanh
    List<T> NGAY SAU khi gia tri nam tren dinh stack, TRUOC widen_if_needed
    (no-op an toan voi dtype khong phai so) - dung idiom newobj
    List`1::.ctor(IEnumerable`1<!0>) DA CO SAN trong codebase (xem
    compiler/il_features/list_copy.py - CLR array cai dat IEnumerable<T>,
    verifiable, khong can castclass). No-op (khong append gi) neu
    dtype_name KHONG phai 'array[T]' - AN TOAN goi VO DIEU KIEN tai moi
    diem tra ve non-void, khong can if rieng o noi goi.

    Phase 9i (2026-08-28): them tham so 'ctx=None' (optional, tuong thich
    nguoc - loi goi cu KHONG truyen ctx van hoat dong y het truoc day CHI
    voi dtype 1 cap; dtype 2 cap 'array[array[T]]' BAT BUOC can ctx (dung
    ctx['label_counter']/ctx['prefix'] de sinh nhan vong lap qua
    nested_array_extern.emit_return_marshal_loop) - neu goi voi dtype 2
    cap ma ctx=None se AssertionError ro rang thay vi loi ky la o cho
    khac, xem nhanh 'assert ctx is not None' duoi."""
    if not (isinstance(dtype_name, str) and dtype_name.startswith('array[')):
        return
    elem = dtype_name[len('array['):-1]
    if isinstance(elem, str) and elem.startswith('array['):
        assert ctx is not None, (
            "_marshal_extern_return_array: dtype 'array[array[T]]' can ctx "
            "(label_counter/prefix) de phat vong lap marshal - diem goi thieu ctx")
        inner_elem = elem[len('array['):-1]
        _nested_array_extern.emit_return_marshal_loop(inner_elem, _EXTERN_CLASS_DEFS, ctx, out)
        return
    il_elem = _il_array_elem_type(elem)
    list_il = f"class [mscorlib]System.Collections.Generic.List`1<{il_elem}>"
    out.append(
        f'    newobj instance void {list_il}::.ctor(class '
        f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')


def _expr_call(node, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    name, args = node[1], node[2]
    records = (ctx or {}).get('records') or {}
    # Task 3 (extern-class, 2026-08-18): nhanh constructor cho handle-type
    # .NET NGOAI (vd 'Sb()' -> newobj System.Text.StringBuilder) - PHAI
    # kiem TRUOC nhanh 'if name in records' de handle-type uu tien (Task 2
    # da dam bao khong trung ten giua extern_class va record/builtin qua
    # validate o tkv_compile.py's compile_tkv_cli, xem duoi). Doc bien
    # module-level _EXTERN_CLASS_DEFS (KHONG phai ctx['extern_class_defs'] -
    # il_type_str/85 diem goi dung cung co che, xem docstring bien nay o
    # dau file) thay vi ctx, vi ctx khong mang key nay (chi 'records').
    if name in _EXTERN_CLASS_DEFS:
        decl = _EXTERN_CLASS_DEFS[name]
        ctor_dtypes = decl['ctor']
        if len(args) != len(ctor_dtypes):
            raise SyntaxError(
                f"il_codegen: constructor '{name}' (extern_class) ky vong "
                f"{len(ctor_dtypes)} tham so, nhan duoc {len(args)}")
        # Phase 9b fix-of-fix (bool, 2026-08-25): import lazy tkv_compile de
        # dung _tokenvector_facing_dtype - CHU KY IL cua constructor (il_params,
        # dung want_dtype THO qua _il_ctor_param_type) PHAI giu 'bool' de .NET
        # resolve dung overload, nhung dtype truyen vao _compile_expr (bien phia
        # TokenVector dang tinh bieu thuc doi so) PHAI la i32 - giong het bug
        # da sua o huong return (_tokenvector_facing_dtype), gio sua tiep huong
        # tham so/constructor (xem Critical 1, final review Phase 9b).
        il_params = []
        for arg_node, want_dtype in zip(args, ctor_dtypes):
            il_params.append(_il_ctor_param_type(want_dtype, _EXTERN_CLASS_DEFS))
            # Critical 1 + Important 1 (final review Phase 9d Part B): box
            # gia tri value-type khi tham so ctor khai 'object' + tu choi
            # dtype thuc te khac 'type' khi tham so khai 'type' - xem
            # docstring _compile_extern_object_arg.
            _compile_extern_object_arg(arg_node, scope, out, want_dtype, ctx)
        class_ref = f"[{decl['assembly']}]{decl['class']}"
        out.append(f"    newobj instance void {class_ref}::.ctor({', '.join(il_params)})")
        return
    if name in records:
        # 'Point(1.0, 2.0)' - khoi tao 1 record (struct) - dung 1
        # .ctor tu sinh nhan THAM SO THEO THU TU field (xem
        # gen_record_types), giong pattern ValueTuple`2 da xac minh
        # THAT o tuple/nhieu gia tri tra ve (newobj + doc field qua ldfld).
        # Field CONTAINER khong nam trong tham so .ctor (2026-08-03) -
        # chung duoc khoi tao RONG ben trong .ctor, dung nhu '__init__'
        # that viet 'self.items = []'.
        fields = [fd for fd in records[name] if not _is_container_field(fd[1])]
        if len(args) != len(fields):
            raise SyntaxError(
                f"il_codegen: record '{name}' can {len(fields)} tham so "
                f"({', '.join(f for f, _ in fields)}), gap {len(args)}")
        for arg_node, (_, fdtype) in zip(args, fields):
            # Field kieu record: dtype de bien dich doi so la TEN record
            # (TypeAnn), khong phai chuoi dtype vo huong (2026-08-03, dot 1).
            _compile_expr(arg_node, scope, out,
                          fdtype if isinstance(fdtype, str) else fdtype.dtype, ctx)
        ctor_params = ', '.join(_field_il_type(fd, records) for _, fd in fields)
        out.append(f'    newobj instance void {name}::.ctor({ctor_params})')
        return
    if name == 'len':
        # len(lst)/len(d)/len(s) - list/dict/string (mang co san dung
        # .shape[N], da biet hang so luc codegen, khong can len() runtime).
        # __len__ cho record (6.5, dunder overload - muc 3, 2026-08-13):
        # len(r) tren 1 BIEN record co __len__(self) -> "i32" goi callvirt
        # thay vi raise loi.
        if len(args) != 1:
            raise SyntaxError("il_codegen: len() chi nhan dung 1 tham so")
        arg = args[0]
        if arg[0] != 'var':
            # len(<bieu thuc>) - vd len(s.split(","))/len(d.keys())/
            # len(os_list_files(p))/len(a + b) (2026-08-03, sau khi Giai
            # doan 0.2 cho phep builtin/method chay o moi vi tri bieu thuc:
            # gioi han "chi 1 BIEN don" o day tro thanh nut that CUOI CUNG
            # cho cac cach viet thuong ngay nhat cua Python).
            #
            # Hinh dang ket qua lay tu CHINH ha tang da co:
            # _shaped_return_ta_of_call (call/method_call tra container),
            # roi den _infer_dtype cho chuoi. Khong co duong suy luan MOI.
            return _compile_len_of_expr(arg, scope, out, dtype, ctx)
        _, _, arg_ta = scope[arg[1]]
        if arg_ta.dtype == 'str' and arg_ta.shape is None:
            return _string_compile_len_str(arg[1], scope, out, dtype, ctx)
        if arg_ta.shape == 'record':
            record_methods = (ctx or {}).get('record_methods') or {}
            dunder = record_methods.get(arg_ta.dtype, {}).get('__len__')
            if dunder is None:
                raise SyntaxError(
                    f"il_codegen: record '{arg_ta.dtype}' khong co __len__ - len(r) tren "
                    f"record can dinh nghia 'def __len__(self) -> \"i32\": ...'")
            if dunder.params or dunder.return_type is None or \
                    dunder.return_type.dtype != 'i32' or dunder.return_type.shape is not None:
                raise SyntaxError(
                    f"il_codegen: record '{arg_ta.dtype}' co __len__ nhung chu ky sai - "
                    f"can dung 0 tham so va tra ve \"i32\" ('def __len__(self) -> \"i32\":')")
            _load_var_ref(arg[1], scope, out)
            from il_features.record_feature import _method_owner_class
            owner = _method_owner_class(ctx, arg_ta.dtype, '__len__')
            out.append(f'    callvirt instance int32 {owner}::__len__()')
            _widen_if_needed('i32', dtype, out)
            return
        if arg_ta.shape not in ('list', 'dict', 'set', 'frozenset', 'bytearray', 'bytes'):
            raise SyntaxError(
                f"il_codegen: len() hien CHI ho tro list/dict/set/frozenset/bytearray/bytes/string, hoac 1 record co "
                f"__len__ ('{arg[1]}' co dtype={arg_ta.dtype!r} shape={arg_ta.shape!r}) - "
                f"mang co san dung .shape[0] thay the")
        _load_var_ref(arg[1], scope, out)
        if arg_ta.shape == 'list':
            col_type = il_list_type(arg_ta.dtype, (ctx or {}).get('records'), _EXTERN_CLASS_DEFS)
        elif arg_ta.shape in ('bytearray', 'bytes'):
            # muc 6.8 (3/4 va 4/4, 2026-08-13): len(ba)/len(data) tren bien
            # don - nhanh rieng cua 'len(<bien>)' (khac _compile_len_of_expr
            # o tren, dung cho bieu thuc), get_Count() khong phu thuoc dtype
            # phan tu.
            col_type = _il_bytearray_type()
        elif arg_ta.shape in ('set', 'frozenset'):
            col_type = il_set_type(arg_ta.dtype, (ctx or {}).get('records'), _EXTERN_CLASS_DEFS)
        else:
            col_type = il_type_str(arg_ta, (ctx or {}).get('records'))
        out.append(f'    callvirt instance int32 {col_type}::get_Count()')
        _widen_if_needed('i32', dtype, out)
        return
    if name == 'round':
        return _compile_round_builtin(args, scope, out, dtype, ctx)
    if name == 'abs':
        if len(args) != 1:
            raise SyntaxError("il_codegen: ham 'abs' chi nhan dung 1 tham so")
        if dtype == 'int':
            # Kieu 'int' (vo han chu so): System.Math::Abs KHONG co
            # overload nao nhan struct TkvInt - xem int_type.compile_abs.
            return _int_type.compile_abs(args[0], scope, out, ctx)
        _compile_expr(args[0], scope, out, dtype, ctx)
        # Math.Abs CO overload float32 rieng - khong can chuyen doi.
        out.append(f'    call {IL_SCALAR[dtype]} [mscorlib]System.Math::Abs({IL_SCALAR[dtype]})')
        return
    if name == 'typeof':
        # Phase 9d Part B (2026-08-27): typeof(ClassName) - ClassName la 1
        # TEN __tkv_extern_class__ da khai (biet tai COMPILE-TIME, KHONG
        # phai 1 bien runtime) - PHAI kiem tra truoc MOI nhanh dung
        # scope[...] (vd nhanh 'name in scope' ngay duoi day) vi args[0] la
        # ('var', ClassName) nhung ClassName KHONG nam trong scope (khong
        # phai 1 bien). Sinh CIL chuan giong C#'s typeof() bien dich ra
        # (ldtoken + GetTypeFromHandle - pattern da biet on dinh, KHONG tu
        # sang tao).
        if len(args) != 1 or args[0][0] != 'var':
            raise SyntaxError(
                "il_codegen: typeof(...) chi nhan dung 1 doi so la TEN 1 "
                "__tkv_extern_class__ da khai (vd 'typeof(Widget)')")
        class_name = args[0][1]
        if class_name not in _EXTERN_CLASS_DEFS:
            raise SyntaxError(
                f"il_codegen: typeof({class_name!r}) - {class_name!r} khong phai "
                f"1 __tkv_extern_class__ da khai bao")
        decl = _EXTERN_CLASS_DEFS[class_name]
        class_ref = f"[{decl['assembly']}]{decl['class']}"
        out.append(f"    ldtoken {class_ref}")
        out.append(
            "    call class [mscorlib]System.Type "
            "[mscorlib]System.Type::GetTypeFromHandle("
            "valuetype [mscorlib]System.RuntimeTypeHandle)")
        _widen_if_needed('type', dtype, out)
        return
    # Goi ham do NGUOI DUNG dinh nghia trong CUNG chuong trinh nhieu
    # ham (xem gen_il_program) - can func_table (ten -> Signature) va
    # class_name trong ctx de biet kieu tham so/tra ve va sinh dung
    # 'call <ret> <Class>::<name>(<params>)'.
    if name in scope and scope[name][2].shape == 'func':
        # Goi qua 1 tham so/bien kieu 'func' (function reference hep, Wave
        # 3 2026-07-29) - vd 'return f(x)' ben trong 1 ham nhan f: "func(...)
        # -> ...". KHAC voi goi ham thuong: nap GIA TRI delegate cua bien
        # roi callvirt Invoke(), khong tra bang func_table (bien nay khong
        # phai ten ham top-level).
        return _compile_funcref_call(name, args, scope, out, dtype, ctx)
    nested_closures = (ctx or {}).get('nested_closures') or {}
    if name in nested_closures:
        # Closure that (Buoc 4, 2026-07-29): goi 1 ham long CUA CHINH ham
        # dang bien dich (vd 'a = inc()') - 'inc' KHONG nam trong func_table
        # (chi co ham top-level). Nap THE HIEN closure (da tao san tai diem
        # 'def inc():', xem il_features/closures.py's codegen_nested_def)
        # roi dung LAI y het co che Func`N/Invoke da xac minh THAT o function
        # reference hep (Buoc 2) - GIONG Buoc 2 nhung KHONG ldnull ma nap
        # THE HIEN closure that (xem checkpoint trong memory).
        info = nested_closures[name]
        nested_sig = info['nested_sig']
        if len(args) != len(nested_sig.params):
            raise SyntaxError(
                f"il_codegen: goi '{name}()' voi {len(args)} tham so nhung ham long "
                f"'{name}' can {len(nested_sig.params)}")
        callee_params, callee_ret = _build_closure_delegate(name, info, scope, out)
        n = len(callee_params)
        generic_args = ', '.join([IL_SCALAR[d] for d in callee_params] + [IL_SCALAR[callee_ret]])
        func_il = f'class [System.Core]System.Func`{n + 1}<{generic_args}>'
        for arg_node, pdtype in zip(args, callee_params):
            _compile_expr(arg_node, scope, out, pdtype, ctx)
        invoke_params = ', '.join(f'!{i}' for i in range(n))
        out.append(f'    callvirt instance !{n} {func_il}::Invoke({invoke_params})')
        _widen_if_needed(callee_ret, dtype, out)
        return
    if name in EXPR_BUILTIN_CODEGEN:
        # Giai doan 0.2 (2026-08-03): builtin thu vien dang ky qua
        # register_expr_builtin (xem il_dispatch.py) - goi duoc NGAY TRONG
        # bieu thuc ('t = f() + 1', 'return f()'), khong chi o RHS 1 phep
        # gan don le nhu truoc. Ham dang ky day gia tri CHUA widen len
        # stack, widen o day giong het cach lam voi cac builtin da co san
        # phia tren (vd 'len').
        EXPR_BUILTIN_CODEGEN[name](args, scope, out, dtype, ctx)
        actual = EXPR_BUILTIN_DTYPE.get(name)
        if name in EXPR_BUILTIN_DTYPE_FN:
            actual = EXPR_BUILTIN_DTYPE_FN[name](args, scope, (ctx or {}).get('func_table'))
        if dtype == 'int' and name in EXPR_BUILTIN_NATIVE_INT:
            # Builtin da tu sinh mot TkvInt (xem EXPR_BUILTIN_NATIVE_INT)
            # - widen theo 'actual' mac dinh o day se de 'conv.i8 +
            # FromI64' len mot struct, tuc IL sai kieu.
            actual = None
        if actual:
            _widen_if_needed(actual, dtype, out)
        return
    func_table = (ctx or {}).get('func_table') or {}
    if name not in func_table:
        raise SyntaxError(
            f"il_codegen: ham '{name}' khong ton tai (khong phai ham toan hoc, "
            f"cung khong phai builtin thu vien nao (str/pow/re_*/path_*/...), "
            f"cung khong co trong chuong trinh dang bien dich)")
    callee = func_table[name]
    # Task 4/5 (2026-08-17, duck-typing-inference): tham so 'inferred'
    # (dtype gan boi Task 2, rang buoc thu thap boi Task 3's
    # collect_inferred_constraints -> callee.inferred_constraints) can duoc
    # RESOLVE thanh 1 Signature MONOMORPHIZE (params da thay 'inferred'
    # bang kieu cu the, ten da mangle) TRUOC KHI chay tiep logic ben duoi -
    # logic tach params/compile doi so/emit 'call' O DUOI deu doc `callee`,
    # nen CHI can gan lai bien nay LA DU (khong sua gi them ben duoi, dung
    # theo diem chen da xac nhan boi Task 1 report muc 3).
    if any(p.type_ann is not None and p.type_ann.dtype == 'inferred' for p in callee.params):
        from il_features.duck_typing import resolve_call_site, mangle_name
        concrete_arg_types = {}
        for arg_node, p in zip(args, callee.params):
            if p.type_ann is not None and p.type_ann.dtype == 'inferred':
                concrete_arg_types[p.name] = _infer_dtype(
                    arg_node, scope, func_table, records,
                    (ctx or {}).get('record_methods'))
        inferred_param_names = tuple(
            p.name for p in callee.params
            if p.type_ann is not None and p.type_ann.dtype == 'inferred')
        cache_key = (name, tuple(concrete_arg_types.get(pn) for pn in inferred_param_names))
        monomorphize_cache = (ctx or {}).get('monomorphize_cache')
        pending_monomorphize = (ctx or {}).get('pending_monomorphize')
        if monomorphize_cache is not None and cache_key in monomorphize_cache:
            callee = monomorphize_cache[cache_key]
        else:
            # Guard phong thu (Task 1 report canh bao) chong de quy vo han:
            # ghi vao cache TRUOC KHI resolve xong - du thiet ke da CHAN
            # truyen tham so inferred vao 1 loi goi khac (Task 3), 1 ham
            # inferred KHONG THE tu goi CHINH NO (than ham chua duoc compile
            # xong nen chua co ten mangled de tra cuu lai) nen truong hop
            # nay hien khong xay ra that su - nhung neu co bug logic o dau
            # do khien no xay ra, `resolve_call_site` ben duoi se raise loi
            # RO RANG (mangle ten deterministic, KeyError/TranspileError)
            # thay vi loop vo han lam treo tien trinh bien dich.
            resolved = resolve_call_site(
                sig=callee, concrete_arg_types=concrete_arg_types,
                records=records, record_methods=(ctx or {}).get('record_methods') or {},
                record_bases=(ctx or {}).get('record_bases') or {},
                call_site_info={'caller_name': (ctx or {}).get('prefix') or '?'})
            if monomorphize_cache is not None:
                monomorphize_cache[cache_key] = resolved
            if pending_monomorphize is not None:
                # sig_body_pairs's phan tu goc cua ham 'inferred' luu
                # body_lines/start_line TRONG chinh Signature goc (callee) -
                # ctx['monomorphize_body_of'] (them ben duoi, tu
                # gen_il_program/tkv_compile.py) tra ve (body_lines,
                # start_line) GOC cua ham 'inferred' theo TEN GOC (khong
                # mangled) - body TEXT giu nguyen (chi Signature khac).
                body_lookup = (ctx or {}).get('monomorphize_body_of') or {}
                orig_body = body_lookup.get(name)
                if orig_body is None:
                    # ctx['monomorphize_body_of'] duoc gen_il_program/
                    # tkv_compile.py dang ky day du CHO DUONG CHINH
                    # (gen_il_function) - thieu entry o day PHO BIEN NHAT
                    # la do goi qua 1 duong KHAC (vd 'async def'/
                    # gen_il_generator_function) chua duoc noi vao co che
                    # monomorphize nay (gioi han da biet - xem docs/
                    # BUGS_TODO.md muc K, khong phai loi noi bo cua pipeline
                    # trong da so truong hop thuc te da gap), bao RO thay vi
                    # am tham bo qua (se sinh 1 lenh 'call' toi 1 method
                    # KHONG BAO GIO duoc compile -> ilasm bao loi tham chieu
                    # method khong ton tai).
                    raise SyntaxError(
                        f"il_codegen: goi ham co tham so kieu suy tu dong ('inferred') "
                        f"'{name}' tu 1 duong goi (vd 'async def'/ham generator) chua duoc "
                        f"ho tro day du co che suy kieu nay - gioi han da biet (khong tim thay "
                        f"body goc trong ctx['monomorphize_body_of'], neu day KHONG phai duong "
                        f"goi async/generator thi day co the la loi noi bo pipeline - bao cao "
                        f"kem repro).")
                else:
                    orig_body_lines, orig_start_line = orig_body
                    already_pending = any(s.name == resolved.name for s, _bl, _sl in pending_monomorphize)
                    if not already_pending:
                        pending_monomorphize.append((resolved, orig_body_lines, orig_start_line))
            callee = resolved
    # *args/**kwargs (Phase 5.1, 2026-08-11): 2 tham so CUOI CUNG co the la
    # vararg/kwarg (xem typed_dsl_parser.py's parse_param) - tach rieng khoi
    # danh sach tham so thuong de tinh so luong bat buoc/gioi han dung.
    normal_params = [p for p in callee.params if not (p.is_vararg or p.is_kwarg)]
    vararg_param = next((p for p in callee.params if p.is_vararg), None)
    kwarg_param = next((p for p in callee.params if p.is_kwarg), None)
    n_required = sum(1 for p in normal_params if p.default_node is None)
    n_fixed_max = len(normal_params)
    if vararg_param is None:
        if not (n_required <= len(args) <= n_fixed_max):
            raise SyntaxError(
                f"il_codegen: goi '{name}' voi {len(args)} tham so nhung ham '{name}' "
                f"can {n_required}"
                + (f'-{n_fixed_max}' if n_required != n_fixed_max else '')
                + " tham so")
    elif len(args) < n_required:
        raise SyntaxError(
            f"il_codegen: goi '{name}' voi {len(args)} tham so nhung ham '{name}' can it nhat "
            f"{n_required} tham so")
    if callee.return_type is None:
        raise SyntaxError(
            f"il_codegen: '{name}' khong co return type (ham void) - chua ho tro goi "
            f"ham void o giua bieu thuc")
    n_fixed_supplied = min(len(args), n_fixed_max)
    for arg_node, p in zip(args, normal_params):
        if p.type_ann.shape == 'func':
            _compile_funcref_arg(arg_node, p.type_ann, scope, out, ctx)
        else:
            _compile_expr(arg_node, scope, out,
                          _value_dtype_spec_for_ta(p.type_ann, arg_node), ctx)
    # Tham so con thieu (Wave 2, 2026-07-29): dung default_node cua chinh
    # Param do, khong can scope (chi la literal, xem Param.default_node).
    for p in normal_params[n_fixed_supplied:]:
        _compile_expr(p.default_node, scope, out,
                      _value_dtype_spec_for_ta(p.type_ann, p.default_node), ctx)
    if vararg_param is not None:
        # Cac doi so du (sau het tham so thuong) duoc DONG GOI thanh
        # List<T> ngay tren stack (dup + Add lien tiep) - tai su dung y het
        # pattern list literal (xem il_features/list_type.py's
        # codegen_assign_list_literal, chi khac la khong qua bien cuc bo).
        extra_args = args[n_fixed_max:]
        list_il = il_type_str(vararg_param.type_ann, records)
        out.append(f'    newobj instance void {list_il}::.ctor()')
        for a in extra_args:
            out.append('    dup')
            _compile_expr(a, scope, out, vararg_param.type_ann.dtype, ctx)
            out.append(f'    callvirt instance void {list_il}::Add(!0)')
    if kwarg_param is not None:
        # Chua ho tro cu phap goi ham kieu 'f(x=1)' (bo phan tich bieu thuc
        # goi hien CHI nhan doi so vi tri) - kwargs LUON duoc truyen 1 dict
        # RONG, giong Python that khi khong dua keyword argument nao.
        dict_il = il_type_str(kwarg_param.type_ann, records)
        out.append(f'    newobj instance void {dict_il}::.ctor()')
    if getattr(callee, 'is_async', False):
        # 'async def' (Phase 4, 2026-08-11) - kieu tra ve THAT cua .method
        # la Task<T> (xem gen_il_function) - lenh 'call' phai khai bao dung
        # kieu do, ke ca khi ket qua khong duoc 'await' ngay (hop le cu
        # phap, du hiem gap).
        raw_ret = il_type_str(callee.return_type)
        ret_il = f'class [mscorlib]System.Threading.Tasks.Task`1<{raw_ret}>'
    else:
        ret_il = il_type_str(callee.return_type)
    params_il = ', '.join(il_type_str(p.type_ann) for p in callee.params)
    class_name = (ctx or {}).get('class_name') or 'Program'
    # RUI RO SO 1 (Task 1 report muc 3): PHAI dung `callee.name`, KHONG
    # PHAI `name` goc - sau khi resolve tham so 'inferred' o tren, `callee`
    # co the la 1 Signature MONOMORPHIZE voi '.name' da mangle (khac `name`
    # goc nguoi dung go). Dung `name` o day se emit loi goi CIL toi ham
    # GOC (chua bao gio duoc compile rieng vi van con dtype 'inferred' chua
    # resolve) thay vi ban monomorphize dung - bien dich "thanh cong" nhung
    # SAI KET QUA hoac ilasm bao loi tham chieu ham khong ton tai.
    out.append(f'    call {ret_il} {class_name}::{_il_ident(callee.name)}({params_il})')
    _widen_if_needed(callee.return_type.dtype, dtype, out)
    return


# _expr_compare da chuyen sang il_features/operators.py's compile_compare,
# Phase 1 buoc 6, 2026-07-28.


def _expr_ternary(node, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    if ctx is None:
        raise SyntaxError('il_codegen: ternary can ctx (label_counter/tern_temp_of_id)')
    cond, true_e, false_e = node[1], node[2], node[3]
    ctx['label_counter'][0] += 1
    n = ctx['label_counter'][0]
    false_lbl = f"{ctx['prefix']}_tern{n}_false"
    end_lbl = f"{ctx['prefix']}_tern{n}_end"
    # id(node): AST duoc parse DUY NHAT 1 LAN (xem _parse_block) va
    # dung lai o ca 2 pass, nen id() la khoa TIN CAY (khac ban truoc
    # dung "thu tu duyet" vi tung phai parse lai bieu thuc 2 lan).
    tmp_idx = ctx['tern_temp_of_id'][id(node)]
    # QUAN TRONG: 'dtype' o day la dtype cua CAC TOAN HANG duoc so
    # sanh (vd f32), KHONG PHAI dtype cua KET QUA so sanh (luon la
    # int32 0/1 do ceq/cgt/clt sinh ra, bat ke toan hang la kieu gi).
    # Truyen sai 'i32' xuong day tung gay bug that: lam toan hang so
    # (vd '0.0' trong 'x[i] > 0.0') bi bien dich nham thanh 'ldc.i4
    # 0.0' (cu phap sai, ilasm tu choi ngay).
    _compile_expr(cond, scope, out, dtype, ctx)
    out.append(f'    brfalse {false_lbl}')
    _compile_expr(true_e, scope, out, dtype, ctx)
    out.append(f'    stloc.s {tmp_idx}')
    out.append(f'    br {end_lbl}')
    out.append(f'  {false_lbl}:')
    _compile_expr(false_e, scope, out, dtype, ctx)
    out.append(f'    stloc.s {tmp_idx}')
    out.append(f'  {end_lbl}:')
    out.append(f'    ldloc.s {tmp_idx}')
    return


# Dang ky vao EXPR_CODEGEN luc module nap - thu tu KHONG quan trong o day
# (tag da doc lap theo thiet ke, dict tra cuu = if/elif toan return).
register_expr_codegen('num', _expr_num)
register_expr_codegen('null', _expr_null)
# 'str_lit' dang ky boi il_features/string_feature.py luc import (Phase
# 1 buoc 5, 2026-07-28).
register_expr_codegen('var', _expr_var)
register_expr_codegen('shape', _expr_shape)
register_expr_codegen('index', _expr_index)
register_expr_codegen('index_expr', _expr_index_expr)
# 'attr'/'method_call' dang ky boi il_features/record_feature.py luc
# import (Phase 1 buoc 8, 2026-07-28).
# 'binop'/'boolop'/'neg'/'not'/'compare' dang ky boi il_features/operators.py
# luc import (Phase 1 buoc 6, 2026-07-28).
register_expr_codegen('in', _expr_in)
register_expr_codegen('call', _expr_call)
register_expr_codegen('ternary', _expr_ternary)


def _compile_index_store(name, indices, value_node, scope: _Scope, out: list, dtype: str, ctx: dict = None):
    _, _, type_ann = scope[name]
    if type_ann.shape == 'list':
        if len(indices) != 1:
            raise SyntaxError(f"il_codegen: list '{name}' chi ho tro 1 chi so (vd {name}[i] = x)")
        _load_var_ref(name, scope, out)
        _compile_expr(indices[0], scope, out, 'i32', ctx)
        _compile_expr(value_node, scope, out, type_ann.dtype, ctx)
        # Wave 2 (2026-07-29): il_type_str (DE QUY) thay il_list_type THANG
        # - dung dung ca khi 'name' la List<List<T>>/List<Dict<K,V>> (xem
        # il_codegen.py's il_type_str); voi list thuong ra CUNG 1 chuoi.
        list_type = il_type_str(type_ann, (ctx or {}).get('records'))
        out.append(f'    callvirt instance void {list_type}::set_Item(int32, !0)')
        return
    if type_ann.shape in ('dict', 'defaultdict', 'counter'):
        # 'defaultdict'/'counter' (Phase 3.2): GHI qua chi so hoat dong Y
        # HET dict thuong (khong can auto-vivify/khong-vivify khi GHI, chi
        # khac o DOC - xem _expr_index/il_features/defaultdict_type.py,
        # counter_type.py).
        if len(indices) != 1:
            raise SyntaxError(f"il_codegen: dict '{name}' chi ho tro 1 khoa (vd {name}[k] = v)")
        _load_var_ref(name, scope, out)
        _compile_expr(indices[0], scope, out, type_ann.key_dtype, ctx)
        # Muc S (docs/BUGS_TODO.md, 2026-08-20): voi dict LONG NHAU
        # (type_ann.dtype == '__nested__', gia tri that o type_ann.elem_ta -
        # xem dict_type.py's declare_dict), 'type_ann.dtype' phang KHONG mo
        # ta duoc gia tri ('list[i32]' bi rut gon con 'i32') - dung
        # value_dtype_spec_for_ta (nguon su that CHUNG voi tham so/gia tri
        # tra ve long nhau, xem list_type.py) de sinh chuoi mang SHAPE dung
        # khi gia tri la 1 list-literal, tranh List<T> sai kieu -> OverflowException
        # luc doc lai.
        val_ctx_dtype = (_value_dtype_spec_for_ta(type_ann.elem_ta, value_node)
                          if type_ann.dtype == '__nested__' and type_ann.elem_ta is not None
                          else type_ann.dtype)
        _compile_expr(value_node, scope, out, val_ctx_dtype, ctx)
        dict_type = il_type_str(type_ann, (ctx or {}).get('records'))
        out.append(f'    callvirt instance void {dict_type}::set_Item(!0, !1)')
        return
    if type_ann.dtype == 'str' and type_ann.shape is None:
        # Python that: string la BAT BIEN (immutable) - 's[i] = x' nem
        # TypeError luc runtime CPython that. Bao loi RO RANG luc bien
        # dich thay vi de .NET String (khong co set_Chars cong khai) gay
        # loi kho hieu hon hoac (te hon) im lang sai neu co ai co gang
        # them ho tro nua sau nay ma khong kiem tra dieu nay truoc.
        raise SyntaxError(
            f"il_codegen: '{name}[i] = ...' khong hop le - string la BAT BIEN "
            f"trong Python that (gan qua chi so nem TypeError luc CPython chay "
            f"that), TokenVector cung khong ho tro.")
    rank = len(type_ann.shape)
    _load_var_ref(name, scope, out)
    for idx_node in indices:
        _compile_expr(idx_node, scope, out, 'i32', ctx)
    # Dung dtype THAT cua mang (type_ann.dtype), KHONG phai `dtype` ben
    # ngoai truyen vao - sua dung bug tiem an (chua lo vi truoc gio mang
    # va body_dtype luon TRUNG nhau; nay co the khac vd list-of-str).
    _compile_expr(value_node, scope, out, type_ann.dtype, ctx)
    if rank == 1:
        out.append(f'    {IL_STELEM[type_ann.dtype]}')
    elif rank == 2:
        cs_arr_type = il_array_rank_type(type_ann.dtype, 2)
        elem_type = IL_SCALAR[type_ann.dtype]
        out.append(f'    callvirt instance void {cs_arr_type}::Set(int32, int32, {elem_type})')
    else:
        raise SyntaxError('il_codegen: chi ho tro mang rank 1 hoac 2')


# ============================================================
# Statement-level: parse body_lines (theo indent Python) THANH 1 CAY
# (list Stmt long nhau), 1 LAN DUY NHAT - khac ban truoc (flat + indent-
# stack, chi ho tro for-loop, khong ho tro if/else) - cay nay dung CHUNG
# cho ca 2 pass (khai bao local + codegen), nen id(node) cua AST bieu
# thuc la khoa TIN CAY cho tern_temp_of_id (khong con phai parse lai 2
# lan nhu ban truoc).
# ============================================================

# _FOR_RANGE_RE/_WHILE_RE/_IF_RE/_ELSE_RE/_RETURN_RE/_BREAK_RE/
# _CONTINUE_RE/_TRY_RE/_EXCEPT_RE/_EXCEPT_TYPED_RE/_FINALLY_RE/_RAISE_RE/
# _FOR_IN_LIST_RE/_EXC_TYPE_MAP da chuyen sang il_features/control_flow.py
# (Phase 1 buoc 9, 2026-07-28).
_ZEROS_2D_RE = re.compile(r'^np\.zeros\(\(([^,]+),\s*([^)]+)\),\s*dtype=np\.\w+\)$')
_ZEROS_1D_RE = re.compile(r'^np\.zeros\(([^,()]+),\s*dtype=np\.\w+\)$')
_ASSIGN_RE = re.compile(r'^(\w+)\s*=\s*(.+)$')
# 'f: "func(i32)->i32" = lambda x: x*2' (Phase 3.3, 2026-08-11) - khai bao
# LOCAL co kieu TUONG MINH, chua tung co truoc gio (DSL nay CHI suy dtype
# local tu ve phai - xem declare_scalar). Can THIET rieng cho kieu 'func'
# vi lambda/ten ham KHONG co du lieu de suy dtype tu chinh no (khac
# '= 5' suy duoc 'int' tu literal). Cu phap chuoi trong ngoac kep giong
# HET tham so ham ("func(i32)->i32") de tai dung nguyen parse_type_ann_str,
# va de file .tkv van la Python hop le (annotation dang string).
_TYPED_LOCAL_DECL_RE = re.compile(r'^(\w+)\s*:\s*"([^"]*)"\s*=\s*(.+)$')
# _TUPLE_ASSIGN_RE da chuyen sang il_features/tuple_type.py (Phase 1
# buoc 3, 2026-07-28).
_INDEXED_ASSIGN_RE = re.compile(r'^(\w+)\[(.+)\]\s*=\s*(.+)$')
# _ATTR_ASSIGN_RE da chuyen sang il_features/record_feature.py (Phase 1
# buoc 8, 2026-07-28).
# _LIST_LIT_RE/_LIST_APPEND_RE da chuyen sang il_features/list_type.py;
# _SET_NEW_RE/_SET_ADD_RE da chuyen sang il_features/set_type.py (Phase
# 1 buoc 1, 2026-07-28).
# _DICT_NEW_RE/_FOR_IN_DICT_ITEMS_RE da chuyen sang il_features/dict_type.py
# (Phase 1 buoc 2, 2026-07-28).
_CALL_STMT_RE = re.compile(r'^(\w+)\((.*)\)\s*$')
_METHOD_CALL_STMT_RE = re.compile(r'^(\w+)\.(\w+)\(.*\)\s*$')

# _DENSE_RE/_NORMALIZE_RE/_ARGMAX_RE/_BINOP_MACRO_RE/_SCALE_RE/_MATVEC_RE/
# _APPLY_RE/_COMPOUND_INDEX_RE/_COMPOUND_VAR_RE da chuyen sang
# il_features/operators.py (Phase 1 buoc 6, 2026-07-28).
# _COMPOUND_ASSIGN_OPS/_COMPOUND_OP_PATTERN/_COMPOUND_ATTR_RE da chuyen
# sang il_features/record_feature.py (Phase 1 buoc 8, 2026-07-28).
# _LIST_COMP_OUTER_RE/_DICT_COMP_OUTER_RE/_parse_comprehension_inner da
# chuyen sang il_features/comprehension.py (Phase 1 buoc 4, 2026-07-28).


def _expand_macros(body_lines: list, records: dict = None, sig=None,
                    func_table: dict = None) -> list:
    """Lap _expand_macros_once DEN DIEM CO DINH (toi da 10 vong, chan an
    toan tranh vong lap vo han neu 1 macro loi tu sinh lai chinh no) -
    can THIET vi comprehension (2026-07-28) sinh ra van ban dang
    'for x in lst:' (macro '_FOR_IN_LIST_RE', mo rong o VONG SAU), khac
    'for i in range(N):' (ho tro NGUYEN SINH trong _parse_block, khong
    can macro) - 1 vong duy nhat truoc day KHONG du de mo rong ca 2 lop
    macro long nhau. Idempotent voi input da on dinh (vong sau khong
    doi gi thi dung ngay, khong ton chi phi thua).

    'records'/'sig' (6.7, iterator protocol tuy bien, 2026-08-13, tuy
    chon - mac dinh None de KHONG pha vo cac diem goi cu chua truyen) -
    dung de quet truoc tap bien "da biet la record" (xem
    set_known_record_vars) truoc khi macro 'for_in_list' chay, tranh no
    viet nham 'for x in <record>:' thanh range(len())/index."""
    # B1 (docs/BUGS_TODO.md): quet TRUOC toan than ham xem bien nao duoc
    # gan '{}' truc tiep (dict moi) - macro cho 'for k in d:' can biet d
    # co phai dict hay khong TRUOC KHI chay (ban than macro chi thay 1
    # dong, khong the tu suy ra). Quet don gian, KHONG theo doi gan-lai
    # sau do (vd 'd = some_list_fn()' ghi de 1 ten da tung la dict o dong
    # khac trong CUNG than ham la ca hiem, chua gap trong test that; neu
    # xay ra se sinh loi RO RANG o len()/index cua .keys(), khong am
    # tham - chap nhan duoc, giong tinh than cac macro khac trong file
    # nay).
    dict_var_re = re.compile(r'^(\w+)\s*=\s*\{\}\s*$')
    dict_vars = set()
    for raw in body_lines:
        m = dict_var_re.match(raw.strip())
        if m:
            dict_vars.add(m.group(1))
    _set_known_dict_vars(dict_vars)

    # 6.7: cung logic quet-truoc nhu dict_vars o tren - (a) tham so ham co
    # kieu record, (b) local gan TRUC TIEP tu 1 loi goi constructor record
    # ('r = Res(...)'). KHONG theo doi gan-lai sau do (cung gioi han nhu
    # dict_vars).
    record_vars = set()
    if sig is not None:
        for p in sig.params:
            if p.type_ann is not None and p.type_ann.shape == 'record':
                record_vars.add(p.name)
    if records or func_table:
        record_ctor_re = re.compile(r'^(\w+)\s*=\s*(\w+)\(.*\)\s*$')
        for raw in body_lines:
            m = record_ctor_re.match(raw.strip())
            if not m:
                continue
            var_name, callee = m.group(1), m.group(2)
            if records and callee in records:
                record_vars.add(var_name)
            elif func_table and callee in func_table:
                # Muc E (docs/BUGS_TODO.md, phat hien 2026-08-13): 'r =
                # get_record()' - gan tu 1 HAM KHAC tra ve record, khong
                # phai constructor truc tiep. Truoc ban va nay bi bo sot
                # hoan toan - neu record do co CA __iter__/__next__ LAN
                # __len__/__getitem__ thi macro for_in_list AM THAM viet
                # nham thanh duyet qua index thay vi qua iterator
                # protocol (khong bao loi gi ca).
                callee_sig = func_table[callee]
                ret_ta = getattr(callee_sig, 'return_type', None)
                if ret_ta is not None and ret_ta.shape == 'record':
                    record_vars.add(var_name)
    _set_known_record_vars(record_vars)

    prev = body_lines
    for _ in range(10):
        nxt = _expand_macros_once(prev)
        if nxt == prev:
            return nxt
        prev = nxt
    return prev


def _expand_macros_once(body_lines: list) -> list:
    """Macro TEXT-LEVEL (khong phai codegen moi, KHONG sinh opcode CIL
    moi nao) - mo rong 3 mau lap-lai-nhieu-nhat trong 1 mang neural nho
    thanh cac dong for/if/idx_assign da co san, truoc khi vao pipeline
    parse/codegen binh thuong (dung y kien creative-thinking-agent):

      dense(input, W, b, activation) - 1 lop fully-connected + activation
      normalize(x, x_min, x_max)     - chuan hoa min-max tung phan tu
      argmax(arr)                    - chi so gia tri lon nhat

    Muc tieu: dua DSL gan voi do gon cua numpy vector hoa (`h = np.tanh(
    x@W1+b1)`, `xn=(x-mn)/(mx-mn)`, `o.argmax()`) MA VAN CHI sinh CIL
    tuong minh (khong goi thu vien BLAS/vector-hoa that nao) - day la 3
    mau CU THE, khong phai co che vector-hoa TONG QUAT (vd `a + b` cho 2
    mang bat ky van CHUA duoc ho tro, chi 3 ham dat ten san nay).

    Phase 0 dispatch-table: than ham chi con la vong lap mong thu tung
    MACRO_EXPANDERS (CO THU TU - vd compound-assign phai thu TRUOC
    comprehension) tren dong RAW (chua strip); dong trong duoc bo qua
    truoc vong lap nay (khong macro nao can xu ly dong trong). Moi
    try_expand_XXX(line) tra ve van ban da mo rong (co the nhieu dong,
    noi boi '\\n') neu khop, None neu khong - dung bo dem RIENG (module-
    level, khong reset moi lan goi ham nay) cho tung loai macro thay vi 1
    bo dem CHUNG nhu ban if/elif cu: van dam bao TEN BIEN TAM duy nhat
    trong 1 than ham (moi macro co TIEN TO rieng, vd '__dense', '__norm'
    - khong bao gio trung nhau), chi khac SO THU TU cu the khong con bat
    dau tu 0 moi ham nua - khong anh huong hanh vi (ten bien tam KHONG
    xuat hien trong bat ky so sanh CPython/test nao, chi can DUY NHAT
    trong pham vi 1 than ham la du)."""
    out = []
    for raw in body_lines:
        if not raw.strip():
            out.append(raw)
            continue
        expanded = None
        for _name, fn in MACRO_EXPANDERS:
            expanded = fn(raw)
            if expanded is not None:
                break
        if expanded is not None:
            out.extend(expanded.split('\n'))
        else:
            out.append(raw)
    return out


# _me_compound_attr da chuyen sang il_features/record_feature.py
# (try_expand_compound_attr), Phase 1 buoc 8, 2026-07-28.
# _me_compound_index/_me_compound_var da chuyen sang il_features/operators.py
# (try_expand_compound_index/try_expand_compound_var), Phase 1 buoc 6,
# 2026-07-28.


# _me_list_comp/_me_dict_or_set_comp da chuyen sang il_features/comprehension.py
# (try_expand_list_comp/try_expand_dict_or_set_comp), Phase 1 buoc 4,
# 2026-07-28.


# _me_for_in_list da chuyen sang il_features/control_flow.py's
# try_expand_for_in_list (Phase 1 buoc 9, 2026-07-28).
# _me_dense/_me_normalize/_me_argmax/_me_binop_macro/_me_scale/_me_matvec/
# _me_apply da chuyen sang il_features/operators.py (Phase 1 buoc 6,
# 2026-07-28).


# Dang ky theo DUNG thu tu cascade cu (thu tu la RANG BUOC THAT: compound-
# assign phai truoc comprehension/for-in-list vi khong lien quan nhung
# giu nguyen vi tri de doc de doi chieu voi lich su; comprehension truoc
# for_in_list vi output cua no CO THE la 1 dong 'for x in lst:' can duoc
# macro for_in_list mo rong o VONG SAU - thu tu dang ky o day khong doi
# dieu do, no phu thuoc _expand_macros lap toi diem co dinh).
# 'compound_attr' dang ky boi il_features/record_feature.py luc import
# (Phase 1 buoc 8, 2026-07-28).
# 'compound_index'/'compound_var'/'dense'/'normalize'/'argmax'/
# 'binop_macro'/'scale'/'matvec'/'apply' dang ky boi il_features/operators.py;
# 'list_comp'/'dict_or_set_comp' dang ky boi il_features/comprehension.py
# luc import (Phase 1 buoc 4/6, 2026-07-28).
# 'for_in_list' dang ky boi il_features/control_flow.py luc import
# (Phase 1 buoc 9, 2026-07-28).


def _strip_lines(body_lines, start_line=None):
    """Bo dong trong, dong chu thich '#' va DOCSTRING (cau lenh chi gom 1
    chuoi tam nhay, 1 hoac nhieu dong). Docstring khong sinh ma nhung co
    mat trong MOI ham that, nen phai bo qua tai day thay vi bao loi.

    start_line (Debug PDB, 2026-08-12): so dong TUYET DOI (1-based) cua
    body_lines[0] trong file nguon goc (tu ast's .lineno) - neu co, ham
    nay TRA VE THEM 1 list line_nos CUNG DO DAI voi ket qua chinh, moi
    phan tu la so dong tuyet doi tuong ung. None neu khong truyen
    start_line (cac noi CHUA can, vd generator/async closure body o Task
    khac cua plan nay)."""
    out = []
    line_nos = [] if start_line is not None else None
    i = 0
    while i < len(body_lines):
        raw = body_lines[i]
        body = raw.strip()
        if not body or body.startswith('#'):
            i += 1
            continue
        delim = None
        for d in ('"""', "'''"):
            if body.startswith(d):
                delim = d
                break
        if delim is not None:
            # 1 dong ('"""abc"""') hoac nhieu dong -> bo qua den dong dong
            if not (len(body) >= 2 * len(delim) and body.endswith(delim)):
                i += 1
                while i < len(body_lines) and delim not in body_lines[i]:
                    i += 1
            i += 1
            continue
        indent = len(raw) - len(raw.lstrip(' '))
        line_no_here = (start_line + i) if start_line is not None else None
        # CHU THICH CUOI DONG (2026-08-03, dot 3): 'x = f(a)  # ghi chu' -
        # truoc day chi bo duoc dong chu thich NGUYEN DONG, con '#' o cuoi
        # 1 dong ma thi loi vao bieu thuc ("khong tokenize duoc"). Bo dau
        # '#' NGOAI chuoi hang.
        body = _strip_trailing_comment(body)
        # NOI TIEP DONG (2026-08-03): bieu thuc con mo ngoac '(' / '[' /
        # '{' thi gom cac dong sau vao lam MOT - code that xuong dong lien
        # tuc trong loi goi dai; truoc day parser theo dong lam dut bieu
        # thuc va bao "ky vong ')' gap None".
        while _bracket_depth(body) > 0 and i + 1 < len(body_lines):
            i += 1
            body = body + ' ' + body_lines[i].strip()
        out.append((indent, body))
        if line_nos is not None:
            line_nos.append(line_no_here)
        i += 1
    return (out, line_nos) if start_line is not None else (out, None)


def _strip_trailing_comment(text):
    """Cat phan '# ...' o cuoi 1 dong ma (bo qua dau '#' nam TRONG chuoi
    hang). Tra ve phan con lai da rstrip."""
    quote = None
    k = 0
    while k < len(text):
        ch = text[k]
        if quote is not None:
            if ch == '\\':
                k += 2
                continue
            if ch == quote:
                quote = None
        elif ch in ('"', "'"):
            quote = ch
        elif ch == '#':
            return text[:k].rstrip()
        k += 1
    return text


def _bracket_depth(text):
    """Do sau ngoac con MO cua 1 doan ma (bo qua ngoac nam trong chuoi va
    phan chu thich '#' cuoi dong)."""
    depth = 0
    quote = None
    k = 0
    while k < len(text):
        ch = text[k]
        if quote is not None:
            if ch == '\\':
                k += 2
                continue
            if ch == quote:
                quote = None
        elif ch in ('"', "'"):
            quote = ch
        elif ch == '#':
            break
        elif ch in '([{':
            depth += 1
        elif ch in ')]}':
            depth -= 1
        k += 1
    return depth


def _eval_const_dim(expr_str: str, known_shapes: dict) -> int:
    """Tinh 1 kich thuoc mang (dim cua np.zeros(...)) THANH SO NGUYEN biet
    luc codegen - vd 'a.shape[0]' -> tra known_shapes (tham so HOAC local
    mang da khai bao TRUOC DO trong THU TU parse - xem _parse_block),
    khong runtime. known_shapes duoc CAP NHAT DAN trong luc parse (moi
    lan gap 1 dong khai bao mang moi vd tu macro dense/add/matvec...) nen
    cac macro noi tiep (vd `s = add(a,b)` roi `p = mul(s,d)`) tra duoc
    shape cua bien LOCAL `s`, khong chi tham so ham."""
    node = parse_expr(expr_str)
    if node[0] == 'shape':
        name, dim = node[1], node[2]
        if name not in known_shapes:
            raise SyntaxError(f"il_codegen: chua biet shape cua '{name}' luc dong nay "
                               f"(chi ho tro tham so ham hoac mang da khai bao TRUOC DO)")
        if known_shapes[name] in ('list', 'dict'):
            raise SyntaxError(f"il_codegen: '{name}' la {known_shapes[name]}, khong co '.shape[N]' - dung len({name}) thay the")
        return known_shapes[name][dim]
    if node[0] == 'num':
        return int(float(node[1]))
    raise SyntaxError(f'il_codegen: khong tinh duoc kich thuoc mang tu {expr_str!r} (chi ho tro X.shape[N] hoac hang so)')


def _parse_block(lines, pos, indent_level, sig, known_shapes, line_nos=None):
    """Recursive-descent: doc lines[pos:] o dung indent_level, tra ve
    (list[Stmt], vi_tri_ke_tiep). Moi khoi con (for/if/else) doc indent
    cua dong DAU TIEN ben trong lam chuan (khong ep cung 4 space nhu ban
    truoc) - linh hoat hon nhung van don gian. known_shapes: dict CHIA SE
    (cung 1 object) qua moi lan goi de quy - cap nhat moi khi gap 1 mang
    moi khai bao, de cac dong SAU (ke ca trong block long sau) tra duoc
    shape cua no qua .shape[N].

    Phase 0 dispatch-table: than ham chi con la vong lap mong thu tung
    LINE_PARSERS (CO THU TU - vd list_append/set_add PHAI thu truoc
    method_call_stmt vi 'x.append(y)' cung khop pattern method-call tong
    quat) cho toi khi 1 cai tra ve khop, giu NGUYEN raise cuoi cung khi
    khong parser nao khop.

    line_nos (Debug PDB, 2026-08-12): tham so tuy chon, CUNG DO DAI, CUNG
    CHI SO voi 'lines' (xem _strip_lines) - neu co, gan stmt['src_line']
    = line_nos[pos] (pos TRUOC khi bi 'matched' cap nhat - dong BAT DAU
    cua statement). KHONG truyen tiep vao cac loi goi _parse_block DE QUY
    ben trong tung _lp_*/try_parse_* (than for/if long) - GIOI HAN DA
    BIET cua Task nay, de danh mo rong sau."""
    stmts = []
    while pos < len(lines) and lines[pos][0] == indent_level:
        line = lines[pos][1]
        start_pos = pos
        matched = None
        for _name, fn in LINE_PARSERS:
            matched = fn(line, lines, pos, indent_level, sig, known_shapes, _parse_block)
            if matched is not None:
                break
        if matched is None:
            raise SyntaxError(f'il_codegen: khong dich duoc dong: {line!r}')
        stmt, pos = matched
        if line_nos is not None and start_pos < len(line_nos):
            stmt['src_line'] = line_nos[start_pos]
        stmts.append(stmt)
    return stmts, pos


# _lp_if/_lp_for/_lp_while/_lp_try/_lp_break/_lp_continue da chuyen sang
# il_features/control_flow.py's try_parse_if/try_parse_for/
# try_parse_while/try_parse_try/try_parse_break/try_parse_continue
# (Phase 1 buoc 9, 2026-07-28).
# _lp_for_in_dict_items da chuyen sang il_features/dict_type.py's
# try_parse_for_in_dict_items (Phase 1 buoc 2, 2026-07-28).
# _lp_list_append da chuyen sang il_features/list_type.py's
# try_parse_list_append; _lp_set_add da chuyen sang il_features/set_type.py's
# try_parse_set_add (Phase 1 buoc 1, 2026-07-28).


def _lp_idx_assign(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    m_idx_assign = _INDEXED_ASSIGN_RE.match(line)
    if not m_idx_assign:
        return None
    name, idx_str, rhs = m_idx_assign.groups()
    # B3 (sua doc lap tren 2 nhanh, gop lai): idx_str.split(',') truoc day
    # cat NHAM dau phay o 2 dang - BEN TRONG loi goi ham (vd
    # 'd[cut_at(rest, "\"")] = v') VA BEN TRONG chuoi ky tu (vd
    # 'd2["bb,Fa"] = v'). _split_idx_commas (depth-aware voi '('/'[', bo
    # qua dau phay trong chuoi don gian) xu ly dung CA HAI dang - da kiem
    # thuc te truoc khi gop (xem test tam trong phien merge). Giu lai
    # _split_expr_list (chi xu ly dau phay trong chuoi, KHONG xu ly ngoac
    # ham) o import cho tuong thich nguoc voi noi khac dang dung no,
    # nhung KHONG dung lai o day.
    idx_nodes = [parse_expr(x) for x in _split_idx_commas(idx_str)]
    rhs_node = parse_expr(rhs)
    return {'kind': 'idx_assign', 'name': name, 'idx_nodes': idx_nodes, 'rhs_node': rhs_node}, pos + 1


# _lp_attr_assign da chuyen sang il_features/record_feature.py's
# try_parse_attr_assign (Phase 1 buoc 8, 2026-07-28).
# _lp_tuple_assign da chuyen sang il_features/tuple_type.py's
# try_parse_tuple_assign (Phase 1 buoc 3, 2026-07-28).


def _rhs_zeros2d(rhs, name, known_shapes):
    m2 = _ZEROS_2D_RE.match(rhs)
    if not m2:
        return None
    d0 = _eval_const_dim(m2.group(1).strip(), known_shapes)
    d1 = _eval_const_dim(m2.group(2).strip(), known_shapes)
    known_shapes[name] = [d0, d1]
    return {'kind': 'assign_zeros2d', 'name': name, 'dim0': d0, 'dim1': d1}


def _rhs_zeros1d(rhs, name, known_shapes):
    m1 = _ZEROS_1D_RE.match(rhs)
    if not m1:
        return None
    d0 = _eval_const_dim(m1.group(1).strip(), known_shapes)
    known_shapes[name] = [d0]
    return {'kind': 'assign_zeros1d', 'name': name, 'dim': d0}


# _rhs_list_new da chuyen sang il_features/list_type.py's try_rhs_list_new;
# _rhs_set_new da chuyen sang il_features/set_type.py's try_rhs_set_new
# (Phase 1 buoc 1); _rhs_dict_new da chuyen sang il_features/dict_type.py's
# try_rhs_dict_new (Phase 1 buoc 2, 2026-07-28).


def _result_container_shape(rhs_node, known_shapes):
    """Hinh dang THO ('list'/'set'/'dict') cua ket qua 1 loi goi builtin/
    method da dang ky - dung o tang PARSER (chua co TypeAnn), xem
    EXPR_*_RESULT_SHAPE trong il_dispatch.py. Tra None neu khong phai
    loi goi tra container.

    Khoa cua method la (shape_key, ten_method); luc parse, shape_key lay
    tu known_shapes - bien KHONG co trong known_shapes duoc coi la 'str'
    (known_shapes CHI ghi container), dung y het cach cac regex cu suy
    doan (vd try_rhs_str_split cu loai tru khi known_shapes.get(src) khac
    None)."""
    if rhs_node[0] == 'call':
        return EXPR_BUILTIN_RESULT_SHAPE.get(rhs_node[1])
    if rhs_node[0] == 'method_call':
        obj_shape = known_shapes.get(rhs_node[1])
        if not isinstance(obj_shape, str):
            obj_shape = 'str'
        return EXPR_METHOD_RESULT_SHAPE.get((obj_shape, rhs_node[2]))
    return None


def _lp_typed_local_decl(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    m = _TYPED_LOCAL_DECL_RE.match(line)
    if not m:
        return None
    name, type_str, rhs = m.groups()
    type_ann = parse_type_ann_str(type_str)
    is_list_of_tuple = type_ann.shape == 'list' and type_ann.elem_ta is not None and \
        type_ann.elem_ta.shape == 'tuple'
    if type_ann.shape not in ('func', 'defaultdict', 'counter') and not is_list_of_tuple:
        # Pham vi Phase 3.3/3.2: CHI khai bao local kieu 'func'/'defaultdict'/
        # 'counter'/'list[(K,V)]' co cu phap tuong minh (list[(K,V)] can
        # thiet rieng cho 'most_common(c,n)' - xem il_features/
        # counter_type.py - vi khong suy dinh duoc dang list-cua-tuple qua
        # duong declare_scalar thuong, chi ho tro dtype PHU THUOC tham so
        # bang 1 chuoi dtype don, khong bieu dien duoc shape long nhau) -
        # cac kieu khac suy dtype tu ve phai nhu cu (declare_scalar), khong
        # can/khong ho tro cu phap nay.
        raise SyntaxError(
            f"il_codegen: khai bao local co kieu tuong minh ('{name}: \"{type_str}\" = ...') "
            f"hien CHI ho tro kieu 'func(...)->...'/'defaultdict[K,V]'/'Counter[K]'/"
            f"'list[(K,V)]' - cac kieu khac suy dtype tu ve phai, khong dung cu phap nay")
    rhs_node = parse_expr(rhs)
    return {'kind': 'assign_typed_decl', 'name': name, 'type_ann': type_ann,
            'rhs_node': rhs_node}, pos + 1


def _lp_assign(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    m_assign = _ASSIGN_RE.match(line)
    if not m_assign:
        return None
    name, rhs = m_assign.groups()
    for _name, fn in ASSIGN_RHS_PARSERS:
        stmt = fn(rhs, name, known_shapes)
        if stmt is not None:
            return stmt, pos + 1
    # 13f: assign_scalar - fallback CUNG, luon khop, khong dang ky rieng.
    rhs_node = parse_expr(rhs)
    result_shape = _result_container_shape(rhs_node, known_shapes)
    if result_shape:
        # Nhom 6 (2026-08-03) - VA 1 BUG THAT: cac duong ASSIGN_RHS cu (da
        # bo o nhom 3-6) con ghi 'known_shapes[bien_dich]' cho cac parser
        # KHAC tra cuu (sum/min/max/sorted, list.count, slicing, set.remove...).
        # Khong ghi lai o day thi 'ys = xs.copy()' roi 'sum(ys)' se bao
        # "ham 'sum' khong ton tai" - xem EXPR_METHOD_RESULT_SHAPE.
        known_shapes[name] = result_shape
    return {'kind': 'assign_scalar', 'name': name, 'rhs_node': rhs_node}, pos + 1


# _lp_return/_lp_raise da chuyen sang il_features/control_flow.py's
# try_parse_return/try_parse_raise (Phase 1 buoc 9, 2026-07-28).
# _lp_return CUNG la noi tao ra ca 'return_tuple' (tuple_type.py so huu
# codegen/first-pass cua no, xem ghi chu lich su trong tuple_type.py).


def _lp_method_call_stmt(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    m_method_call_stmt = _METHOD_CALL_STMT_RE.match(line)
    if not m_method_call_stmt:
        return None
    # 'p.scale(2.0)' nhu 1 LENH DOC LAP - khoang trong ngon ngu #1
    # (method that tren record), dung cho method MUTATING (khong
    # tra ve, hoac tra ve nhung ket qua khong dung toi).
    call_node = parse_expr(line)
    if call_node[0] != 'method_call':
        raise SyntaxError(f'il_codegen: khong dich duoc dong: {line!r}')
    return {'kind': 'method_call_stmt', 'call_node': call_node}, pos + 1


def _lp_call_stmt(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    m_call_stmt = _CALL_STMT_RE.match(line)
    if not m_call_stmt:
        return None
    # Goi ham nhu 1 LENH DOC LAP (khong gan bien) - vd
    # 'write_file(path, content)'. Tai dung THANG bo dich bieu
    # thuc (parse_expr) thay vi tu tach tham so bang tay - dam
    # bao khop 100% cu phap 'call' da co (ke ca ngoac/dau phay
    # long nhau trong tham so).
    call_node = parse_expr(line)
    if call_node[0] != 'call':
        raise SyntaxError(f'il_codegen: khong dich duoc dong: {line!r}')
    return {'kind': 'call_stmt', 'call_node': call_node}, pos + 1


# Dang ky ASSIGN_RHS_PARSERS TRUOC (LINE_PARSERS's 'assign' entry dung
# toi ngay khi dang ky) - thu tu giu dung nhu cascade cu (13a-13e), 13f
# (assign_scalar) la fallback cung trong _lp_assign, khong dang ky.
register_assign_rhs_parser('zeros2d', _rhs_zeros2d)
register_assign_rhs_parser('zeros1d', _rhs_zeros1d)
# 'list_new'/'set_new'/'dict_new' dang ky boi il_features/list_type.py,
# set_type.py, dict_type.py luc IMPORT (o dau file nay) - TRUOC ca dong
# code nay chay, nen thu tu tuong doi voi cac entry duoi day KHONG doi.

# Dang ky LINE_PARSERS theo DUNG thu tu cascade cu (thu tu la RANG BUOC
# THAT: list_append/set_add PHAI truoc method_call_stmt vi 'x.append(y)'
# cung khop pattern method-call tong quat; except-co-kieu PHAI truoc
# except-tran (xu ly rieng trong _lp_try, khong phai o day)). 'list_append'/
# 'set_add'/'for_in_dict_items' dang ky boi il_features/list_type.py/
# set_type.py/dict_type.py luc IMPORT (truoc dong code nay chay) - van
# DUNG TRUOC 'method_call_stmt' o duoi. 'if'/'for'/'while'/'try'/'break'/
# 'continue'/'return'/'raise' dang ky boi il_features/control_flow.py
# luc import (Phase 1 buoc 9, 2026-07-28).
register_line_parser('idx_assign', _lp_idx_assign)
# 'attr_assign' dang ky boi il_features/record_feature.py luc import
# (Phase 1 buoc 8, 2026-07-28).
# 'tuple_assign' dang ky boi il_features/tuple_type.py luc import (Phase
# 1 buoc 3, 2026-07-28).
# 'assign_typed_decl' PHAI truoc 'assign' (Phase 3.3, 2026-08-11): ca 2
# deu co dau '=', nhung _ASSIGN_RE khong khop dong co ':' truoc '=' nen
# thu tu that ra khong xung dot - dat truoc chi de RO RANG uu tien.
register_line_parser('assign_typed_decl', _lp_typed_local_decl)
register_line_parser('assign', _lp_assign)
register_line_parser('method_call_stmt', _lp_method_call_stmt)
register_line_parser('call_stmt', _lp_call_stmt)


# declare_scalar_int da chuyen sang il_features/control_flow.py (chi
# 'for' - fpw_for - dung, Phase 1 buoc 9, 2026-07-28).


class _DtypeOnlyScope:
    """Micro-scope CHI de tra dtype (khong index) - dung cho _infer_dtype
    trong first-pass, TRUOC KHI _Scope THAT duoc xay (can khai bao local
    xong moi biet idx). Tuong thich cach _infer_dtype truy cap
    scope[name][2].dtype giong _Scope that."""

    def __init__(self):
        self._d = {}

    def __getitem__(self, name):
        return ('local', None, self._d[name])

    def set(self, name, type_ann):
        self._d[name] = type_ann


# _find_first_append_dtype da chuyen sang il_features/list_type.py's
# find_first_append_dtype() - Phase 1 buoc 1 (2026-07-28) - dung chung
# boi ca list/set (set truyen kind='set_add').


# _find_first_dict_assign_dtypes da chuyen sang il_features/dict_type.py's
# find_first_dict_assign_dtypes (Phase 1 buoc 2, 2026-07-28).


# _contains_break_continue/_contains_return da chuyen sang
# il_features/control_flow.py (Phase 1 buoc 9, 2026-07-28).


def tkvint_class_il():
    """Cac dong '.class TkvInt' o muc TOP-LEVEL, cho nhung noi TU RAP file
    .il (tokenvector_compile.compile_model, alphaai_codegen) thay vi di
    qua gen_il_program. Tu 2026-08-05 hang so nguyen mac dinh la 'int' nen
    hau nhu ham nao cung tham chieu TkvInt::*; thieu dinh nghia thi ilasm
    bao 'Reference to undefined class TkvInt' - loi THAT o ca hai cho tren."""
    blocks = []
    _int_type.ensure_class({'emitted_types': set(), 'extra_classes': blocks})
    return [line for block in blocks for line in block]


def _container_arg_hints(stmts, func_table, sig=None):
    """Ten bien -> TypeAnn CONTAINER ma no BAT BUOC phai co, suy tu cho no
    duoc dung lam THAM SO (2026-08-05, lat 4).

    Ly do ton tai: tu khi hang so nguyen mac dinh la 'int', 'xs = [1, 2,
    3]' sinh List<TkvInt>. Neu ngay sau do 'xs' duoc truyen vao mot ham
    khai bao 'lst: "list[i32]"' thi hai kieu KHONG khop, va - day moi la
    phan te - khong co duong ep kieu nao cho container: chuyen doi doi
    hoi chep ca list. Truoc ban va nay, IL sinh ra van assemble duoc va
    chuong trinh nem BadImageFormatException / OverflowException voi mot
    chi so rac luc CHAY (loi THAT: il_reserved_name_test, list_return_test).

    Nen chu thich cua ham nhan DUOC UU TIEN hon phong doan tu hang so:
    chu thich la y muon TUONG MINH cua nguoi viet, hang so thi khong.
    Chi ap dung cho tham so CONTAINER - vo huong da co thu hep co kiem
    tra qua _widen_if_needed, khong can (va khong nen) doan truoc."""
    hints = {}

    # 'return result' trong mot ham khai bao '-> "list[i32]"': chinh chu
    # thich TRA VE la y muon tuong minh, manh hon phong doan tu hang so
    # ('result.append(1)' nay suy ra 'int'). Thieu nhanh nay, make_list()
    # dung List<TkvInt> o cho khai bao List<int32> - CLR doc struct nhu
    # mot con so va ToI32 nem "chi so int qua lon" (list_return_test).
    ret_ta = getattr(sig, 'return_type', None) if sig is not None else None
    if ret_ta is not None and ret_ta.shape in ('list', 'dict', 'set'):
        def visit_ret(stmt_list):
            for st in stmt_list:
                node = st.get('expr_node')
                if (st.get('kind') == 'return' and isinstance(node, tuple)
                        and len(node) >= 2 and node[0] == 'var'):
                    hints.setdefault(node[1], ret_ta)
                for key in ('body', 'else_body', 'finally_body'):
                    sub = st.get(key)
                    if sub:
                        visit_ret(sub)
                for _exc, hbody in st.get('handlers') or []:
                    visit_ret(hbody)
        visit_ret(stmts)

    if not func_table:
        return hints

    def visit(node):
        if isinstance(node, tuple):
            if len(node) >= 3 and node[0] == 'call':
                callee = func_table.get(node[1])
                args = node[2]
                if callee is not None and isinstance(args, (list, tuple)):
                    for arg, param in zip(args, callee.params):
                        pta = param.type_ann
                        if pta is None or pta.shape not in ('list', 'dict', 'set'):
                            continue
                        if isinstance(arg, tuple) and len(arg) >= 2 and arg[0] == 'var':
                            hints.setdefault(arg[1], pta)
                        elif (isinstance(arg, tuple) and len(arg) >= 3
                              and arg[0] == 'method_call' and isinstance(arg[1], str)):
                            # Goi TRUC TIEP, khong qua bien trung gian:
                            # 'f(d.keys())', 'f(xs.copy())'.
                            if arg[2] in ('keys', 'values'):
                                hints.setdefault(('__recv__', arg[2], arg[1]), pta.dtype)
                            elif arg[2] == 'copy':
                                hints.setdefault(arg[1], pta)
            for sub in node[1:]:
                visit(sub)
        elif isinstance(node, list):
            for item in node:
                visit(item)
        elif isinstance(node, dict):
            for value in node.values():
                visit(value)

    visit(stmts)

    # MOT mat xich nua: 'ks = d.keys()' roi 'f(ks)' voi f nhan
    # list[i32] - luc do KHOA cua 'd' phai la i32. Khong lan buoc nay thi
    # 'd[10] = "a"' suy khoa ra 'int' va Dictionary<TkvInt,string>.keys()
    # cho List<TkvInt> o cho can List<int32> (expr_recv_dependent_test).
    # Chi lan qua keys()/values(): hai method nay mang THANG kieu cua
    # nguoi nhan, khong bien doi gi.
    def visit_recv(stmt_list):
        for st in stmt_list:
            rhs = st.get('rhs_node')
            name = st.get('name')
            if (name in hints and isinstance(rhs, tuple) and len(rhs) >= 3
                    and rhs[0] == 'method_call' and rhs[2] in ('keys', 'values')
                    and isinstance(rhs[1], str)):
                hints.setdefault(('__recv__', rhs[2], rhs[1]), hints[name].dtype)
            for key in ('body', 'else_body', 'finally_body'):
                sub = st.get(key)
                if sub:
                    visit_recv(sub)
            for _exc, hbody in st.get('handlers') or []:
                visit_recv(hbody)
    visit_recv(stmts)
    return hints


def _first_pass_collect_locals(stmts, sig: Signature, body_dtype: str, func_table: dict = None,
                                records: dict = None, record_methods: dict = None,
                                extra_declared: dict = None, source_path: str = None):
    """Duyet cay Stmt (KHONG parse lai bieu thuc - da parse 1 lan trong
    _parse_block), khai bao local (.locals init) + temp cho ternary long
    nhau. Tra ve (locals_decl, tern_temp_of_id, needs_epilogue, boxed_names,
    nested_closures) - tern_temp_of_id khoa boi id(node AST ternary) vi
    CUNG 1 object se duoc dung lai o second-pass codegen (khong con can
    khop THU TU duyet nhu ban truoc).

    extra_declared (Buoc 4 - closure that, 2026-07-29): dict ten->TypeAnn
    CAC bien DA co san TRUOC KHI duyet (vd bien bi bat, tham chieu qua
    field cua closure - xem gen_il_function's closure_captures) - duoc
    XEM NHU DA khai bao (declared_names/infer_scope) nhung KHONG them vao
    locals_decl (khong can .locals rieng, chung khong phai local THAT su
    cua ham dang bien dich). boxed_names: tap ten cac local cua CHINH ham
    nay BI 1 ham long (kind='nested_def') BAT - xem il_features/closures.py's
    fpw_nested_def; nested_closures: dict ten ham long -> metadata (dung
    cho _expr_call/_infer_dtype nhan dien loi goi 'inc()' khong qua
    func_table thong thuong).

    Phase 0 dispatch-table: walk()/_pre_register_infer_scope() gio chi
    con la vong lap mong tra cuu FIRST_PASS_WALK/FIRST_PASS_PRESCAN theo
    kind - logic that nam trong cac ham _fpw_XXX/_fpp_XXX module-level
    phia duoi, dang ky luc module nap. KHAC voi _codegen_stmts/_compile_expr
    (handler nhan tham so RIENG LE) - o day cac ham _fpw_XXX/_fpp_XXX
    nhan 1 dict 'ctx' gom TOAN BO state dung chung (locals_decl/
    declared_names/infer_scope/declare_*/collect_ternary_temps/walk_fn/
    needs_epilogue) vi so luong tham so can thiet qua nhieu (>10) de liet
    ke rieng tung cai gon gang - CAC closure declare_scalar/declare_array/
    declare_list/declare_set/declare_dict/declare_named/collect_ternary_temps
    VAN dinh nghia O DAY (dong goi state locals_decl/declared_names/
    infer_scope dung chung) dung theo cam ket cua ke hoach da duyet - khong
    tach ra file rieng duoc neu khong tai cau truc lon hon (ngoai pham vi
    refactor nay). GIU NGUYEN loi walk() KHONG raise khi kind la (vd
    'break'/'continue' - khong co gi de quet ternary/khai bao) - giong
    _codegen_stmts, day la hanh vi CU, khong phai lo hong moi."""
    locals_decl = []
    tern_temp_of_id = {}
    needs_epilogue = [False]
    boxed_names = set()
    nested_closures = {}
    declared_names = set(p.name for p in sig.params)
    infer_scope = _DtypeOnlyScope()
    for p in sig.params:
        infer_scope.set(p.name, p.type_ann)
    for ex_name, ex_ta in (extra_declared or {}).items():
        declared_names.add(ex_name)
        infer_scope.set(ex_name, ex_ta)

    def declare_scalar(name, rhs_node):
        if name not in declared_names:
            if not walk_ctx.get('final_pass'):
                # Ve phai co the tham chieu 1 bien dang bi HOAN khai bao
                # (2026-08-03, dot 3) - vd 'ks = seen.keys()' khi 'seen'
                # con cho suy kieu. Hoan luon cau lenh nay, thu lai sau.
                try:
                    _probe_names_declared(rhs_node, infer_scope, func_table)
                except KeyError:
                    defer(lambda: declare_scalar(name, rhs_node))
                    return
            declared_names.add(name)
            if _record_is_record_ctor_rhs(rhs_node, records):
                # 'p = Point(1.0, 2.0)' - khai bao bien kieu record (KHONG
                # phai vo huong f32/i32/... thong thuong), xem 'call' trong
                # _compile_expr.
                ta = TypeAnn(rhs_node[1], 'record')
            elif rhs_node[0] == 'call' and rhs_node[1] in _EXTERN_CLASS_DEFS:
                # Task 4 (extern-class, 2026-08-18): 's = Sb("abc")' (constructor
                # goi KHONG annotation) - THIEU nhanh nay truoc Task 4 (Task 2/3
                # chi lam extern-class type annotation qua chu ky ham THAM SO/
                # RETURN da co annotation dang chuoi, chua co duong cho LOCAL
                # KHONG annotation suy tu chinh RHS) khien 's' mac dinh roi ve
                # nhanh _infer_dtype/body_dtype ben duoi (vd 'i32' neu ham dang
                # bien dich la i32) - method_call tren 's' sau do tra cuu SAI
                # shape (None thay vi 'extern_class') va bao loi "chi dung duoc
                # tren bien kieu record/string/...". Doi xung HOAN TOAN voi
                # nhanh record ngay tren.
                ta = TypeAnn(rhs_node[1], 'extern_class')
            elif rhs_node[0] == 'index' and _index_src_is_nested_container(rhs_node[1], infer_scope):
                # Wave 2 (2026-07-29), container long nhau: 'row = outer[i]'
                # khi 'outer' la List<List<T>>/List<Dict<K,V>> - phan tu
                # DOC RA cung la 1 container (khong phai vo huong), tai
                # dung THANG elem_ta cua 'outer' lam TypeAnn cua 'row' (2
                # bien tro CHUNG 1 "hinh dang" kieu, dung cach il_type_str
                # tinh IL type se khop nhau tu dong).
                _, _, outer_ta = infer_scope[rhs_node[1]]
                ta = outer_ta.elem_ta
            elif _shaped_return_ta_of_call(rhs_node, func_table, infer_scope, records) is not None:
                ta = _shaped_return_ta_of_call(rhs_node, func_table, infer_scope, records)
            else:
                # Suy dtype THAT tu ve phai (vd = "chuoi" -> 'str') thay vi
                # luon ep body_dtype - can THIET de 1 ham co the vua co bien
                # so vua co bien string (xem _infer_dtype).
                # Muc R (docs/BUGS_TODO.md, 2026-08-19): _infer_dtype's
                # nhanh 'var'/'binop'/'compare'/... doc scope[ten] TRUC TIEP -
                # neu 've phai' tham chieu TEN 1 HAM TOP-LEVEL o VI TRI GIA
                # TRI (vd 'y = foo + 1', khong phai loi goi/callback) thi
                # 'foo' khong nam trong infer_scope (chi func_table), gay
                # KeyError THO khong bat duoc - nguoi dung thay traceback
                # Python thay vi loi cu phap ro rang. Bat rieng truong hop
                # NAY (kiem missing-key co trong func_table khong) roi bao
                # SyntaxError ro rang; KHONG bat cac KeyError khac (vd bien
                # thuc su chua khai bao/typo) - de nguyen hanh vi cu cho
                # truong hop do (khong che giau bug that bang thong diep
                # sai).
                try:
                    inferred = (_infer_dtype(rhs_node, infer_scope, func_table, records, record_methods,
                                              nested_closures)
                                or _infer_literal_dtype(rhs_node) or body_dtype)
                except KeyError as e:
                    missing = e.args[0] if e.args else None
                    if func_table and missing in func_table:
                        raise SyntaxError(
                            f"il_codegen: '{missing}' la 1 ham top-level, khong the dung TRUC "
                            f"TIEP lam bieu thuc gia tri (vd '{missing} + 1') - chi ho tro goi "
                            f"ham ('{missing}(...)') hoac truyen ten ham lam callback cho "
                            f"map/filter/reduce")
                    raise
                if inferred == 'i32' and body_dtype == 'int':
                    # 'total = 1' trong 1 ham khai bao '-> int': hang so
                    # nguyen KHONG co do rong co dinh (xem _infer_literal_dtype)
                    # nen 'i32' chi la phong doan mac dinh. Trong ngu canh
                    # 'int' (vo han chu so) phong doan dung phai la 'int' -
                    # neu khong thi 'total = total * i' tran im lang y het
                    # truoc khi co kieu 'int', tuc tinh nang moi vo dung.
                    inferred = 'int'
                # 'p = points[i]' / 'for p in points:' (macro mo rong thanh
                # 'p = points[__idx]') - khoang trong ngon ngu #2, List
                # chua record: dtype suy duoc CO THE la ten 1 record (khi
                # doc phan tu tu 1 list-cua-record) - phai gan shape=
                # 'record' (KHONG phai None) de 'p.field'/'p.method()' sau
                # do dung duoc, khac truong hop vo huong thong thuong.
                # Task 3 review fix (extern-class-list, 2026-08-18): CUNG
                # khoang trong nhu tren nhung voi list-cua-extern-class ('for
                # item in items:' voi items la list[Sb] duoc mo rong text-level
                # thanh 'item = items[idx]', roi roi vao nhanh else nay vi
                # 'index' tag KHONG di qua _index_src_is_nested_container o
                # tren - nhanh do CHI bat container long nhau qua elem_ta,
                # con list[extern_class] luu dtype PHAN TU truc tiep o
                # TypeAnn.dtype (giong list[i32]), khong dung elem_ta). Neu
                # khong bat o day, 'item' bi khai bao shape=None dtype='Sb' ->
                # _local_il_type/il_type_str's nhanh shape=None lam
                # IL_SCALAR['Sb'] -> KeyError, VA 'item.ToString()' sau do tra
                # cuu SAI shape (khong dung duoc method extern-class).
                if inferred in _EXTERN_CLASS_DEFS:
                    shape = 'extern_class'
                elif records and inferred in records:
                    shape = 'record'
                else:
                    shape = None
                ta = TypeAnn(inferred, shape)
            locals_decl.append((name, ta))
            infer_scope.set(name, ta)

    def declare_array(name, type_ann):
        if name not in declared_names:
            declared_names.add(name)
            locals_decl.append((name, type_ann))
            infer_scope.set(name, type_ann)

    def declare_named(name, ta):
        """Khai bao 1 local voi TypeAnn DA BIET SAN (khong can suy dtype
        tu bieu thuc) - dung cho key_var/val_var cua 'for k, v in d.items():'
        (dtype lay THANG tu dict_ta.key_dtype/dtype) va cac local AN (hidden)
        enumerator/KeyValuePair (ten DUY NHAT qua id(stmt), khong trung ten
        nguoi dung nen khong can kiem tra declared_names)."""
        if name not in declared_names:
            declared_names.add(name)
            locals_decl.append((name, ta))
            infer_scope.set(name, ta)

    def collect_ternary_temps(expr_node):
        """Ten giu NGUYEN (30+ noi goi trong il_features/*.py) nhung tu
        Giai doan 0.2 nhom 3 (2026-08-03) lam THEM 1 viec: cap phat hidden
        local cho cac method can vong lap ('s.count(x)'/'s.title()'/
        's.zfill(n)') - xem EXPR_METHOD_TEMPS trong il_dispatch.py. Moc o
        DAY vi day la diem DUY NHAT da duoc goi tu MOI vi tri co bieu thuc
        (return/gan/dieu kien if-while/bien vong lap/doi so ham) - them
        moc moi rieng se bo sot vi tri."""
        _declare_slice_temps(expr_node, {'declare_named': declare_named,
                                         'TypeAnn': TypeAnn})
        for tern_node in _walk_ternaries_preorder(expr_node):
            tern_temp_of_id[id(tern_node)] = len(locals_decl)
            # BUG THAT sua 2026-08-12 (phat hien qua 'str(min(a,b))' voi
            # a/b kieu 'int' mac dinh): truoc day LUON dung body_dtype
            # (dtype cua NGU CANH BAO QUANH, vd 'str' khi ca bieu thuc
            # nam trong str(...)) cho local __ternN - SAI khi ternary nam
            # LONG trong 1 bieu thuc khac dtype: local bi khai bao kieu
            # 'string' nhung code luu 1 gia tri TkvInt (valuetype nhieu
            # field) vao do - IL khong verify, chay ra ket qua rac (vd
            # '0') thay vi loi ro rang. Sua (port tu .tkv tree, da co san
            # thiet ke dung o day): suy dtype THAT cua ternary qua
            # _infer_dtype tren CHINH node ternary (tag 'ternary' tu de
            # quy sang true/false operand), chi fallback ve body_dtype
            # khi khong suy duoc. Tang 2 (2026-08-12, phat hien qua
            # 'min(4, 2, 8, 1)' toan hang so - _infer_dtype tra None cho
            # tag 'num' theo dung thiet ke, xem docstring _infer_dtype):
            # _infer_literal_dtype quet ca cay tim hang so DAU TIEN, nhin
            # cu phap (co dau '.' hay khong) de doan 'int' hay float -
            # cung tang fallback da dung o declare_scalar phia tren.
            t_dtype = (_infer_dtype(tern_node, infer_scope, func_table, records, record_methods)
                       or _infer_literal_dtype(tern_node)
                       or body_dtype)
            locals_decl.append((f'__tern{len(tern_temp_of_id)}', TypeAnn(t_dtype, None)))
        for div_node in _walk_intdiv_nodes(expr_node):
            # '//' va '%' tren SO NGUYEN can 4 o nho de sinh dung ngu
            # nghia floor cua Python (2026-08-03) - xem compile_binop.
            # Dtype suy tu chinh toan hang; khong suy duoc (tham chieu
            # xuoi) thi bo qua, pass 2 se bao loi RO RANG.
            d = (_infer_dtype(div_node[2], infer_scope, func_table, records, record_methods) or
                 _infer_dtype(div_node[3], infer_scope, func_table, records, record_methods))
            if d not in _INT_DTYPES:
                continue
            for suffix in ('a', 'b', 'q', 'r'):
                declare_named(f'__idiv{id(div_node)}_{suffix}', TypeAnn(d, None))
        for call_node in _walk_call_nodes(expr_node):
            if call_node[0] == 'call':
                # Nhom 7 (2026-08-03): builtin dang ham ('json_dumps(lst)')
                # cung can hidden local - truoc do chi 'method_call' co moc.
                temps_fn = EXPR_BUILTIN_TEMPS.get(call_node[1])
                if temps_fn:
                    temps_fn(call_node, walk_ctx)
                continue
            try:
                _, _, obj_ta = infer_scope[call_node[1]]
            except KeyError:
                # Bien chua khai bao tai diem nay (tham chieu xuoi) -
                # best-effort bo qua, GIONG quy uoc da co cua
                # find_first_append_dtype; loi that (neu co) se lo ra RO
                # RANG o pass 2 khi tra cuu scope.
                continue
            temps_fn = EXPR_METHOD_TEMPS.get((_shape_key(obj_ta), call_node[2]))
            if temps_fn:
                temps_fn(call_node, walk_ctx)

    def walk(stmt_list):
        for stmt in stmt_list:
            fn = FIRST_PASS_WALK.get(stmt['kind'])
            if fn:
                fn(stmt, walk_ctx)

    # HOAN khai bao (2026-08-03, dot 3): 1 container co the CHUA suy duoc
    # kieu tai luc gap no vi manh moi nam o BIEN KHAI BAO SAU (vd
    # 'labels = []' roi 'for sh in shapes: labels.append(sh.label())' -
    # 'sh' chua co trong infer_scope). Truoc day cho nay am tham lay
    # body_dtype (kieu TRA VE cua ham) lam kieu phan tu - nguon cua 5 bug
    # sai am tham. Nay: hoan lai, thu lai SAU KHI di het than ham, luc do
    # moi bien khac da co kieu. Chi bao loi khi da het cach.
    deferred = []

    def defer(fn):
        deferred.append(fn)

    walk_ctx = {
        'locals_decl': locals_decl, 'declared_names': declared_names, 'infer_scope': infer_scope,
        'func_table': func_table, 'records': records, 'body_dtype': body_dtype, 'sig': sig,
        'source_path': source_path,
        # record_methods (2026-08-03): can cho find_first_append_dtype suy
        # duoc 'lst.append(obj.method())' - thieu no thi list chua record
        # bi khai bao nham theo body_dtype.
        'record_methods': record_methods,
        'declare_scalar': declare_scalar, 'declare_array': declare_array,
        'declare_named': declare_named,
        'collect_ternary_temps': collect_ternary_temps, 'walk_fn': walk,
        'defer': defer, 'final_pass': False,
        'needs_epilogue': needs_epilogue,
        # Tiem them cho list_type.declare_list/set_type.declare_set (Phase
        # 1 buoc 1, 2026-07-28) - cac ham nay o file rieng, khong the
        # import truc tiep _infer_dtype/_contains_float_literal/_INT_DTYPES
        # (circular import), nen nhan qua ctx nhu moi core-callable khac.
        'stmts': stmts, 'infer_dtype': _infer_dtype, 'infer_literal_dtype': _infer_literal_dtype,
        'container_arg_hints': _container_arg_hints(stmts, func_table, sig),
        'contains_float_literal': _contains_float_literal, 'int_dtypes': _INT_DTYPES,
        'TypeAnn': TypeAnn,
        # Closure that (Buoc 4, 2026-07-29) - xem il_features/closures.py's
        # fpw_nested_def/codegen_nested_def.
        'boxed_names': boxed_names, 'nested_closures': nested_closures,
        'cell_class_name': _cell_class_name,
        # extern_class_defs (Task 3 review fix thu 4, extern-class-list,
        # 2026-08-18): tiem module-level _EXTERN_CLASS_DEFS qua ctx cho
        # cac FIRST_PASS_WALK o il_features/*.py (vd fpw_for_in_call_list
        # trong list_type.py) suy shape='extern_class' cho bien vong lap
        # 'for x in f(...):' khi f() tra ve list[HandleType] - khong the
        # import truc tiep _EXTERN_CLASS_DEFS (circular import, xem
        # docstring dau list_type.py).
        'extern_class_defs': _EXTERN_CLASS_DEFS,
    }

    def _pre_register_infer_scope(stmt_list):
        """Dang ky TRUOC ca bien vong lap 'for' LAN bien vo huong thuong
        (assign_scalar) vao infer_scope (CHI de tra dtype, KHONG dung
        locals_decl/declared_names - viec do van do walk() lam DUNG THU
        TU sau) - can THIET vi declare_list/declare_dict (goi tu walk()
        khi gap 'lst = []'/'d = {}') quet CA CAY tim '.append(...)'/
        'd[k]=...' DAU TIEN, co the roi TOI 1 bien duoc gan o NAM SAU
        trong cay (vd trong than 1 'for') truoc khi walk() tuan tu kip
        dang ky bien do - 2 bug that tim thay 2026-07-28 tu AI-port:
        (1) 'lst.append(i)' voi 'i' la bien vong lap for, (2) 'd[c]=1'
        voi 'c' la 1 bien thuong gan trong cung than for ('c = s[i]').
        Suy dtype o day dung CHINH XAC logic cua declare_scalar (best-
        effort, fallback body_dtype) - khi walk() thuc su chay toi cung
        statement do, no tinh lai y HET (idempotent, khong dang ky trung
        vao locals_decl vi declared_names van rieng)."""
        for st in stmt_list:
            fn = FIRST_PASS_PRESCAN.get(st['kind'])
            if fn:
                fn(st, prescan_ctx)

    prescan_ctx = {
        'infer_scope': infer_scope, 'func_table': func_table, 'records': records,
        'record_methods': record_methods, 'body_dtype': body_dtype, 'prescan_fn': _pre_register_infer_scope,
    }

    _pre_register_infer_scope(stmts)
    # LUOT 0 (2026-08-03, dot 3): di 1 luot "do thu", CHI de bom kieu cua
    # cac bien vao infer_scope roi VUT BO moi khai bao. Nho vay luot that
    # ben duoi khong con phu thuoc THU TU xuat hien: 'seen[w] = ...' suy
    # duoc kieu khoa du 'w' la bien vong lap khai bao sau; 'labels.append(
    # sh.label())' suy duoc kieu phan tu du 'sh' khai bao sau. Truoc day
    # cho nay am tham lay body_dtype (kieu TRA VE cua ham) lam kieu -
    # nguon cua 5 bug sai am tham trong 1 phien. Moi loi o luot 0 deu bo
    # qua: no chi la phong doan, luot THAT ben duoi moi la noi bao loi.
    _probe_declared = set(declared_names)
    _probe_locals = list(locals_decl)
    try:
        walk(stmts)
    except Exception:
        pass
    deferred = []
    declared_names.clear()
    declared_names.update(_probe_declared)
    locals_decl[:] = _probe_locals
    tern_temp_of_id.clear()
    needs_epilogue[0] = False
    boxed_names.clear()
    nested_closures.clear()

    walk(stmts)
    while deferred:
        pending, deferred = deferred, []
        before = len(pending)
        for fn in pending:
            fn()
        if len(deferred) >= before:
            # Khong tien trien them - vong sau se chay o che do 'cuoi cung'
            # (cac declare_* se nem loi RO RANG thay vi hoan tiep).
            walk_ctx['final_pass'] = True
            for fn in deferred:
                fn()
            deferred = []
    if needs_epilogue[0]:
        # __ret_tmp: bien tam giu gia tri tra ve khi 'return' xay ra BEN
        # TRONG try/except (xem _contains_return o tren) - CHI khai bao khi
        # THAT SU can, tranh local thua cho ham khong dung try/except.
        ret_ta = sig.return_type if sig.return_type is not None else TypeAnn(body_dtype, None)
        locals_decl.append(('__ret_tmp', ret_ta))
        infer_scope.set('__ret_tmp', ret_ta)
    # Local NHAP cho kieu 'int' (moc 6 buoc 2, 2026-08-05): duong nhanh
    # cua +/-/* PHAI noi tuyen (ket luan dat nhat cua spike 1) nen no can
    # cho do toan hang - 4 local dung CHUNG cho ca ham, chi cap phat khi
    # ham THAT SU dung 'int'. Xem il_features/int_type.py.
    #
    # 2026-08-05 (lat 4 - 'int' thanh mac dinh toan cuc): cap phat VO DIEU
    # KIEN. Dieu kien "ham nay co dung 'int' khong" tinh tu tham so/kieu
    # tra ve/local KHONG the dung duoc nua vi no bo sot moi truong hop
    # gian tiep: ham long BAT mot cell 'int' (loi THAT: "bien
    # '__tkvint_b' chua duoc khai bao"), phan tu list[int], gia tri dict.
    # Bon local thua trong mot ham khong dung 'int' re hon nhieu so voi
    # mot dieu kien khong bao gio du.
    if True:
        for _sname, _sdtype in _int_type.scratch_locals():
            if _sname not in declared_names:
                declared_names.add(_sname)
                _sta = TypeAnn(_sdtype, None)
                locals_decl.append((_sname, _sta))
                infer_scope.set(_sname, _sta)
        # Local nhap cua kieu 'complex' (muc 6.8, 2/4, 2026-08-13) -
        # str(<bieu thuc complex>) can 1 dia chi (ToString() la instance
        # method tren value type) - cap phat VO DIEU KIEN giong het 'int'
        # o tren (cung ly do: suy "ham nay co dung 'complex' khong" tu
        # tham so/local se bo sot cac duong gian tiep).
        for _sname, _sdtype in _complex_type.scratch_locals():
            if _sname not in declared_names:
                declared_names.add(_sname)
                _sta = TypeAnn(_sdtype, None)
                locals_decl.append((_sname, _sta))
                infer_scope.set(_sname, _sta)
        # Local scratch cho marshal 'array[array[T]]' (Phase 9i,
        # 2026-08-28) - cap phat VO DIEU KIEN giong het 'int'/'complex' o
        # tren (cung ly do: dieu kien "ham co dung array[array[T]] khong"
        # de bo sot).
        for _sname, _sdtype in _nested_array_extern.scratch_locals():
            if _sname not in declared_names:
                declared_names.add(_sname)
                _sta = TypeAnn(_sdtype, None)
                locals_decl.append((_sname, _sta))
                infer_scope.set(_sname, _sta)
    return locals_decl, tern_temp_of_id, needs_epilogue[0], boxed_names, nested_closures


# _fpw_for/_fpw_while/_fpw_if/_fpw_try/_fpw_return/_fpw_raise da chuyen
# sang il_features/control_flow.py (Phase 1 buoc 9, 2026-07-28).


def _fpw_idx_assign(stmt, ctx):
    for idx_node in stmt['idx_nodes']:
        ctx['collect_ternary_temps'](idx_node)
    ctx['collect_ternary_temps'](stmt['rhs_node'])


# _fpw_attr_assign da chuyen sang il_features/record_feature.py's
# fpw_attr_assign (Phase 1 buoc 8, 2026-07-28).


def _declare_slice_temps(node, ctx):
    """Khai bao local an '__slice<id>_start' cho MOI node 'slice' nam bat
    ky dau trong cay bieu thuc (khong chi khi slice la node goc cua RHS).
    Can tu 2026-08-03 khi '<bieu thuc>.method(...)' cho phep viet
    's[i:j].strip()' - slice luc do nam LONG ben trong, nhanh cu bo sot
    va gay 'bien __sliceN_start chua duoc khai bao' luc codegen."""
    if not isinstance(node, tuple):
        return
    if node and node[0] == 'slice':
        # local AN i32 giu gia tri 'start' (tinh 1 LAN, dung lai 2 lan: lam
        # tham so Substring() VA lam so hang tru khi tinh 'count' =
        # stop-start) - xem il_features/slicing.py's compile_slice.
        # Truong hop list (assign_list_slice) tu khai bao rieng trong
        # slicing.py; khai bao thua o day chi ton 1 local i32 khong dung.
        ctx['declare_named'](f'__slice{id(node)}_start', ctx['TypeAnn']('i32', None))
    for sub in node:
        if isinstance(sub, tuple):
            _declare_slice_temps(sub, ctx)
        elif isinstance(sub, list):
            for item in sub:
                _declare_slice_temps(item, ctx)


def _probe_names_declared(node, infer_scope, func_table=None):
    """Nem KeyError neu cay bieu thuc tham chieu 1 TEN chua co trong
    infer_scope - dung de biet co nen HOAN khai bao lai hay khong
    (2026-08-03, dot 3). Chi xet cac tag mang ten bien o node[1].

    muc Q follow-up (2026-08-19): TEN 1 HAM TOP-LEVEL (trong func_table,
    vd truyen thang lam callback 'filter(is_hello, xs)') KHONG BAO GIO
    duoc set vao infer_scope - bo qua khong probe cac ten nay (khong coi
    la 'chua khai bao'), neu khong statement se bi HOAN MAI MAI (khong
    bao gio het dieu kien defer) va gay bug thu tu (xem BUGS_TODO muc Q)."""
    if not isinstance(node, tuple):
        return
    if node and node[0] in ('var', 'attr', 'method_call', 'index', 'slice', 'shape', 'in'):
        if isinstance(node[1], str):
            if not (func_table and node[1] in func_table):
                infer_scope[node[1]]
    for sub in node[1:]:
        if isinstance(sub, tuple):
            _probe_names_declared(sub, infer_scope, func_table)
        elif isinstance(sub, list):
            for item in sub:
                _probe_names_declared(item, infer_scope, func_table)


def _fpw_assign_scalar(stmt, ctx):
    ctx['declare_scalar'](stmt['name'], stmt['rhs_node'])
    ctx['collect_ternary_temps'](stmt['rhs_node'])


def _fpw_assign_typed_decl(stmt, ctx):
    # Phase 3.3 (2026-08-11) - kieu DA BIET SAN tu chinh cu phap khai bao
    # ('name: "func(...)->..." = ...'), khong can suy tu ve phai nhu
    # declare_scalar - dung declare_named CO SAN (da dung cho key_var/
    # val_var cua dict.items()/local an).
    ctx['declare_named'](stmt['name'], stmt['type_ann'])
    if stmt['type_ann'].shape == 'defaultdict':
        # Phase 3.2 (2026-08-11): can 1 local AN de giu delegate factory
        # (System.Func`1<V>) tach khoi chinh Dictionary<K,V> - xem
        # il_features/defaultdict_type.py's compile_assign_defaultdict_new.
        ctx['declare_named'](f'__defaultdict_factory_{stmt["name"]}',
                              TypeAnn(stmt['type_ann'].dtype, 'func', func_params=[]))
    if stmt['type_ann'].shape == 'counter':
        # Phase 3.2 (2026-08-11): local AN giu chi so vong lap khi khoi
        # tao 'Counter(xs)' (dem tan suat cac phan tu xs) - xem
        # il_features/counter_type.py's compile_assign_counter_new. Khai
        # bao vo dieu kien (ke ca 'Counter()' rong khong dung toi) - don
        # gian hon kiem tra dieu kien o day, ton 1 slot local khong dang ke.
        ctx['declare_named'](f'__counter_idx_{stmt["name"]}', TypeAnn('i32', None))
    ctx['collect_ternary_temps'](stmt['rhs_node'])


def _fpw_assign_zeros1d(stmt, ctx):
    ctx['declare_array'](stmt['name'], TypeAnn(ctx['body_dtype'], [stmt['dim']]))


def _fpw_assign_zeros2d(stmt, ctx):
    ctx['declare_array'](stmt['name'], TypeAnn(ctx['body_dtype'], [stmt['dim0'], stmt['dim1']]))


# _fpw_assign_list_new/_fpw_list_append da chuyen sang il_features/list_type.py
# (fpw_assign_list_new/fpw_list_append); _fpw_assign_set_new/_fpw_set_add
# da chuyen sang il_features/set_type.py (Phase 1 buoc 1, 2026-07-28).


def _fpw_call_stmt(stmt, ctx):
    call_node = stmt['call_node']
    for arg_node in call_node[2]:
        ctx['collect_ternary_temps'](arg_node)
    # 2026-08-12 (Task 3 random shuffle/sample): 1 so ten ham dispatch qua
    # 'call_stmt' (vd shuffle(lst) qua RANDOM_STMT_CODEGEN - xem
    # stdlib_random.py) can hidden local rieng cho than ham (khong chi
    # cac ARG nhu vong for tren) - dung LAI EXPR_BUILTIN_TEMPS lam kho
    # chung qua register_call_stmt_temps (il_dispatch.py), tra cuu THEO
    # TEN ham (call_node[1]) giong het cach collect_ternary_temps tra cuu
    # EXPR_BUILTIN_TEMPS cho 1 'call' node nam trong bieu thuc.
    temps_fn = EXPR_BUILTIN_TEMPS.get(call_node[1])
    if temps_fn:
        temps_fn(call_node, ctx)


def _fpw_method_call_stmt(stmt, ctx):
    for arg_node in stmt['call_node'][3]:
        ctx['collect_ternary_temps'](arg_node)


