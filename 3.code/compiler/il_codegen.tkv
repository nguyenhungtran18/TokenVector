def gen_interface_types(interface_defs: dict) -> list:
    """Phase C.4 (2026-07-29, xem project-tokenvector-wave2-status memory -
    huong F da chot, 'mixin = CIL interface'): sinh 1 '.class interface
    public abstract auto ansi <Ten>' RIENG cho MOI '@interface' - MOI
    method la 1 khai bao 'abstract' THUAN (KHONG than, khong .maxstack) -
    class THAT (record) implement no chi can viet 1 method PUBLIC cung
    ten+chu ky (CLR tu anh xa qua ten/chu ky trung khop cho interface
    method KHONG dung '.override' tuong minh - giong C# implicit interface
    implementation), KHONG can code gi them o gen_record_types ngoai
    'implements' o header."""
    out = []
    for iname, methods in (interface_defs or {}).items():
        out.append(f'.class interface public abstract auto ansi {iname}')
        out.append('{')
        for mname, sig_line in methods.items():
            m_sig = parse_typed_signature(sig_line)
            ret_type = il_type_str(m_sig.return_type) if m_sig.return_type else 'void'
            params_il = ', '.join(f'{il_type_str(p.type_ann)} {_il_ident(p.name)}' for p in m_sig.params)
            out.append(f'  .method public hidebysig newslot abstract virtual instance '
                       f'{ret_type} {mname}({params_il}) cil managed')
            out.append('  {')
            out.append('  }')
        out.append('}')
    return out


EXCEPTION_BASE_NAME = 'Exception'
IL_EXCEPTION_TYPE = '[mscorlib]System.Exception'


def _is_container_field(field_dtype):
    """Field cua record la 1 CONTAINER (list/dict)? Chi container moi
    duoc khoi tao RONG tu dong trong .ctor va bi loai khoi tham so .ctor.

    Field vo huong van luu bang 1 CHUOI dtype nhu truoc; field container
    VA field kieu record deu luu bang TypeAnn - nen phai xet shape, khong
    chi xet 'khong phai chuoi' (2026-08-03, dot 1: them field kieu record
    thi cach kiem tra cu bien no thanh 'container' va lam .ctor mat tham
    so)."""
    return not isinstance(field_dtype, str) and field_dtype.shape in ('list', 'dict')


def _field_il_type(field_dtype, records=None):
    """Kieu IL cua 1 field record - vo huong (chuoi dtype) hoac container
    (TypeAnn)."""
    if isinstance(field_dtype, str):
        return IL_SCALAR[field_dtype]
    return il_type_str(field_dtype, records)


def gen_record_types(records: dict, record_method_bodies: dict = None, record_methods: dict = None,
                      class_name: str = 'Program', func_table: dict = None,
                      record_bases: dict = None, record_overrides: dict = None,
                      record_interfaces: dict = None, interface_defs: dict = None,
                      module_consts: dict = None, record_methods_own: dict = None) -> list:
    """Sinh 1 '.class public auto ansi <Ten> extends <Base>' RIENG (kieu
    top-level, SONG SONG voi class chuong trinh chinh, khong long ben
    trong) cho MOI 'class dang record' - 1 REFERENCE TYPE (khong con la
    struct/valuetype tu B1, 2026-07-29 - can thiet de ho tro ke thua/da
    hinh THAT, xem spike probe_inheritance.il) voi field public + 1 .ctor
    nhan du THAM SO THEO THU TU field (base truoc, own sau - xem
    record_bases), giong het cach ValueTuple`2 duoc dung o tuple/nhieu gia
    tri tra ve (newobj + doc field qua ldfld) - CHI khac la day la kieu TU
    DINH NGHIA (khong co san trong mscorlib) nen phai TU sinh ca .ctor cua no.

    'records[name]' VAN la fields DA FLATTEN (field cua base TRUOC, field
    rieng cua 'name' SAU - xem tkv_compile.py's _extract_record_def) - giu
    NGUYEN dinh dang cu (list[(field_name,dtype)]) de MOI noi khac dung
    'records' (il_type_str, record_feature.py...) KHONG can doi gi.

    record_bases: dict ten-record -> ten-class-cha (hoac None neu khong ke
    thua) - dung de: (a) sinh dung 'extends <Base>' o header; (b) .ctor goi
    'call instance void <Base>::.ctor(<cac tham so RIENG cua Base>)' truoc
    khi gan field RIENG cua 'name' (constructor chaining, xem spike); (c)
    tach 'own_fields' = fields[len(base_fields):] (chi field MOI, khong lap
    lai field cua Base - Base tu lo field cua no qua .ctor cua chinh no).

    record_overrides: dict ten-record -> set ten-method DA xuat hien o 1
    class TO TIEN (base/base-cua-base...) - method TRONG set nay duoc sinh
    'virtual' (KHONG 'newslot', override 1 slot da co); method KHONG trong
    set nay (lan dau xuat hien trong ca pha hinh) duoc sinh 'newslot
    virtual' (mo slot moi). ap dung DONG LOAT cho MOI method record (kha
    ca record KHONG ke thua) - callvirt o record_feature.py's
    compile_method_call cung goi DONG LOAT thay 'call' (an toan theo
    ECMA-335 tren ca method khong-virtual, xem checkpoint memory).

    record_method_bodies: dict ten-record -> [(Signature, body_lines), ...]
    (khoang trong ngon ngu #1 - method that tren record, xem gen_il_method) -
    method KHONG bat buoc, record van hop le neu chi co field (nhu truoc)."""
    record_method_bodies = record_method_bodies or {}
    record_bases = record_bases or {}
    record_overrides = record_overrides or {}
    record_interfaces = record_interfaces or {}
    out = gen_interface_types(interface_defs)
    for name, fields in records.items():
        base_name = record_bases.get(name)
        if isinstance(base_name, list):
            base_name = base_name[0] if base_name else None
        # 'class MyError(Exception):' (Giai doan 3, 2026-08-03) - base la
        # System.Exception cua BCL chu KHONG phai 1 record khac: khong co
        # field ke thua, va .ctor cua base la cua .NET (khong phai .ctor do
        # chinh ta sinh ra). Van la 1 base HOP LE cua Python that nen file
        # .tkv chay duoc duoi CPython, dung tinh than cua du an.
        is_exc_base = base_name == EXCEPTION_BASE_NAME
        base_fields = [] if is_exc_base else (records[base_name] if base_name else [])
        own_fields = fields[len(base_fields):] if base_name else fields
        # Field CONTAINER (list/dict, 2026-08-03) KHONG nhan qua tham so
        # .ctor - khong co cu phap Python nao truyen 1 list rong vao cho
        # tu nhien, va __init__ that (bi bo qua luc bien dich) luon viet
        # 'self.items = []'. Chung duoc khoi tao RONG ngay trong .ctor.
        ctor_fields = [(fn, fd) for fn, fd in fields if not _is_container_field(fd)]
        fields_il = ', '.join(f'{_field_il_type(fd, records)} {_il_ident(fn)}'
                              for fn, fd in ctor_fields)
        if is_exc_base:
            extends = IL_EXCEPTION_TYPE
        else:
            extends = base_name if base_name else '[mscorlib]System.Object'
        ifaces = record_interfaces.get(name) or []
        implements_clause = f' implements {", ".join(ifaces)}' if ifaces else ''
        out.append(f'.class public auto ansi {name} extends {extends}{implements_clause}')
        out.append('{')
        for fn, fd in own_fields:
            out.append(f'  .field public {_field_il_type(fd, records)} {_il_ident(fn)}')
        out.append(f'  .method public hidebysig specialname rtspecialname instance void '
                    f".ctor({fields_il}) cil managed")
        out.append('  {')
        out.append('    .maxstack 8')
        out.append('    ldarg.0')
        if is_exc_base:
            # Neu field DAU TIEN la 'str' thi truyen no cho
            # System.Exception::.ctor(string) => thuoc tinh .Message THAT cua
            # .NET co gia tri (khong chi la 1 field rieng cua record). Quy
            # uoc nay duoc ghi ro trong tai lieu, khong phai suy doan ngam:
            # field dau tien kieu str = thong diep loi.
            if ctor_fields and ctor_fields[0][1] == 'str':
                out.append('    ldarg.1')
                out.append(f'    call instance void {IL_EXCEPTION_TYPE}::.ctor(string)')
            else:
                out.append(f'    call instance void {IL_EXCEPTION_TYPE}::.ctor()')
        elif base_name:
            base_ctor_fields = [(fn, fd) for fn, fd in base_fields if not _is_container_field(fd)]
            base_fields_il = ', '.join(f'{_field_il_type(fd, records)} {_il_ident(fn)}'
                                        for fn, fd in base_ctor_fields)
            for i in range(len(base_ctor_fields)):
                out.append(f'    ldarg.s {i + 1}')
            out.append(f'    call instance void {base_name}::.ctor({base_fields_il})')
        else:
            out.append('    call instance void [mscorlib]System.Object::.ctor()')
        # Tham so .ctor chi gom field VO HUONG, danh so theo THU TU cua
        # ctor_fields (khong phai theo thu tu khai bao field) - field
        # container bi bo qua o day va khoi tao rong ben duoi.
        own_ctor_names = {fn for fn, fd in own_fields if not _is_container_field(fd)}
        for i, (fn, fd) in enumerate(ctor_fields):
            if fn not in own_ctor_names:
                continue
            out.append('    ldarg.0')
            out.append(f'    ldarg.s {i + 1}')
            out.append(f'    stfld {_field_il_type(fd, records)} {name}::{_il_ident(fn)}')
        for fn, fd in own_fields:
            if not _is_container_field(fd):
                continue
            # 'self.items = []' cua __init__ that duoc thuc hien O DAY.
            out.append('    ldarg.0')
            out.append(f'    newobj instance void {_field_il_type(fd, records)}::.ctor()')
            out.append(f'    stfld {_field_il_type(fd, records)} {name}::{_il_ident(fn)}')
        out.append('    ret')
        out.append('  }')
        overridden = record_overrides.get(name, set())
        for m_sig, m_body_lines in record_method_bodies.get(name, []):
            out.extend(gen_il_method(name, m_sig, m_body_lines, records=records,
                                      record_methods=record_methods, class_name=class_name,
                                      func_table=func_table, record_bases=record_bases,
                                      module_consts=module_consts, record_methods_own=record_methods_own,
                                      virtual_kw=('virtual' if m_sig.name in overridden else 'newslot virtual')))
        out.append('}')
    return out


def gen_il_function(sig: Signature, body_lines: list, with_guards: bool = True,
                     func_table: dict = None, class_name: str = None, records: dict = None,
                     self_type_ann: TypeAnn = None, record_methods: dict = None,
                     closure_captures: list = None, is_closure_method: bool = False,
                     extra_classes: list = None, emitted_types: set = None,
                     pre_parsed_stmts: list = None, virtual_kw: str = None,
                     record_bases: dict = None, module_consts: dict = None,
                     record_methods_own: dict = None) -> list:
    """Sinh 1 CIL `.method` HOAN CHINH (bao goi .method/.locals/instructions/
    .maxstack/}) tu Signature + than ham (body_lines - CUNG dinh dang dung
    cho csharp_codegen.py). Tra ve list dong.

    Kien truc (2026-07-28, viet lai): body_lines duoc parse THANH 1 CAY
    Stmt long nhau (ho tro for/if/else/assign/idx_assign/return) 1 LAN
    DUY NHAT qua _parse_block, dung LAI cho ca first-pass (khai bao
    local) va second-pass (codegen) - khac ban truoc (flat list + indent-
    stack chi ho tro dong for).

    Tham so moi (Buoc 4 - closure that, 2026-07-29, xem project-tokenvector-
    wave2-status memory):
      - pre_parsed_stmts: neu co, BO QUA hoan toan buoc parse tu body_lines
        (body_lines co the la None) - dung khi than 1 ham long DA duoc parse
        1 LAN roi trong _parse_block cua ham NGOAI (xem il_features/
        closures.py's try_parse_nested_def) - tranh parse lai 2 lan.
      - closure_captures: list[(ten_bien, TypeAnn, ten_class_closure)] - CHI
        dung khi is_closure_method=True, dang ky moi bien bi bat vao scope
        voi kind='closure_field' (doc/ghi qua field cua 'self', xem
        _Scope docstring) THAY VI la tham so/local thuong.
      - is_closure_method: True khi dang sinh THAN METHOD cua 1 closure
        class (goi DE QUY tu il_features/closures.py's codegen_nested_def) -
        anh huong header ('instance' giong self_type_ann nhung KHONG bind
        'self' vao scope, vi 'self' o day la 1 the hien closure, khong phai
        1 record) va param_idx_base (arg0 = 'self').
      - extra_classes/emitted_types: keo dai tu gen_il_program (xem do) -
        cho CAC '.class' MOI (cell/closure) sinh ra boi 1 'nested_def' ben
        trong ham nay duoc GOM vao 1 danh sach CHUNG cho CA chuong trinh
        (extra_classes.append), dedupe qua emitted_types (set ten class DA
        sinh - tranh sinh trung neu 1 dtype/nested-def xuat hien nhieu lan)."""
    if sig.return_type:
        body_dtype = sig.return_type.dtype
    elif sig.params:
        body_dtype = sig.params[0].type_ann.dtype
    else:
        # Method void, khong tham so ngoai self (vd 'def reset(self):') -
        # khong con manh moi nao khac de doan body_dtype (chi dung lam
        # fallback dtype hang so chua go danh, xem _infer_literal_dtype) -
        # 'i32' la mac dinh an toan (khong anh huong self.field, deu co
        # dtype rieng tu 'records').
        body_dtype = 'i32'

    scope = _Scope()
    param_idx_base = 0
    if self_type_ann is not None:
        scope.add_self('self', self_type_ann)
        param_idx_base = 1
    elif is_closure_method:
        # arg0 = the hien closure ('self' ngam dinh) - KHONG co bien DSL nao
        # ten 'self' tham chieu toi no (nested-def cua Python khong co tham
        # so self), nen KHONG goi scope.add_self - chi can dich chuyen chi
        # so tham so THAT (idx+1) giong het self_type_ann.
        param_idx_base = 1
    for cname, cval in (module_consts or {}).items():
        if isinstance(cval, str):
            c_ta = TypeAnn('str', None)
            c_repr = '"' + cval.replace(chr(92), chr(92)*2).replace('"', chr(92) + '"') + '"'
        elif isinstance(cval, float):
            c_ta, c_repr = TypeAnn('f64', None), repr(cval)
        else:
            c_ta, c_repr = TypeAnn('i32', None), str(cval)
        scope.add_const(cname, c_repr, c_ta)
    for idx, p in enumerate(sig.params):
        scope.add_arg(p.name, idx + param_idx_base, p.type_ann)

    extra_declared = {}
    if self_type_ann is not None:
        # 'self' phai co trong infer_scope cua FIRST-PASS (khong chi trong
        # _Scope that o pass 2): moi suy kieu cho 'self.field' o first-pass
        # (vd cap phat local an cho 'str(self.pos - 1)') deu tra cuu qua
        # day - thieu no thi KeyError 'self' (2026-08-03).
        extra_declared['self'] = self_type_ann
    if closure_captures:
        for cname, cta, cclass, c_extra in closure_captures:
            if c_extra is None:
                scope.vars[cname] = ('closure_field', (cclass, cname), cta)
            else:
                # B3 (2026-07-29): bat TRUC TIEP 1 gia tri kieu THAM CHIEU
                # (khong qua cell) - c_extra = il_type_str da tinh SAN (luc
                # sinh closure class, co 'records' de resolve dung nested
                # container/record) - xem _load_var_ref's 'closure_field_direct'.
                scope.vars[cname] = ('closure_field_direct', (cclass, cname, c_extra), cta)
            extra_declared[cname] = cta

    if pre_parsed_stmts is not None:
        stmts = pre_parsed_stmts
    else:
        body_lines = _expand_macros(body_lines)
        body_lines = [_rename_reserved_identifiers(l) for l in body_lines]
        lines = _strip_lines(body_lines)
        base_indent = lines[0][0] if lines else 0
        known_shapes = {p.name: p.type_ann.shape for p in sig.params if p.type_ann.shape is not None}
        stmts, end_pos = _parse_block(lines, 0, base_indent, sig, known_shapes)
        if end_pos != len(lines):
            bad_indent, bad_line = lines[end_pos]
            raise SyntaxError(f'il_codegen: indent khong hop le tai dong {bad_line!r} '
                               f'(indent={bad_indent}, ky vong {base_indent} - co the thieu '
                               f"'if'/'for' truoc do, hoac 'else' khong khop 'if')")

    locals_decl, tern_temp_of_id, needs_epilogue, boxed_names, nested_closures = \
        _first_pass_collect_locals(stmts, sig, body_dtype, func_table, records, record_methods,
                                    extra_declared=extra_declared)
    for i, (name, ta) in enumerate(locals_decl):
        if name in boxed_names:
            scope.add_boxed(name, i, ta)
        else:
            scope.add_local(name, i, ta)

    params_il = ', '.join(f'{il_type_str(p.type_ann)} {_il_ident(p.name)}' for p in sig.params)
    is_async_fn = getattr(sig, 'is_async', False)
    if is_async_fn:
        raw_ret = il_type_str(sig.return_type) if sig.return_type else 'void'
        ret_type = f'class [mscorlib]System.Threading.Tasks.Task`1<{raw_ret}>'
    else:
        ret_type = il_type_str(sig.return_type) if sig.return_type else 'void'

    def _local_il_type(name, ta):
        if name in boxed_names:
            return f'class {_cell_class_name(ta.dtype)}'
        return il_type_str(ta, records)
    locals_sig = ', '.join(f'{_local_il_type(name, ta)} {_il_ident(name)}' for name, ta in locals_decl)

    body = []
    label_counter = [0]
    epilogue_lbl = f'{sig.name}_epilogue'
    ctx = {'label_counter': label_counter, 'prefix': sig.name, 'tern_temp_of_id': tern_temp_of_id,
           'func_table': func_table or {}, 'class_name': class_name or 'Program', 'loop_stack': [],
           'try_depth': 0, 'epilogue_lbl': epilogue_lbl, 'ret_tmp_name': '__ret_tmp',
           'records': records or {}, 'record_methods': record_methods or {},
           'record_methods_own': record_methods_own or {},
           'record_bases': record_bases or {},
           'current_record': self_type_ann.dtype if self_type_ann else None,
           'is_async': is_async_fn,
           # Cac ham loi (core) duoc "tiem" (dependency injection) vao ctx
           # de il_features/*.py DUNG DUOC ma khong phai import il_codegen.py
           # (tranh circular import - quy uoc bat dau tu Phase 1 buoc 1).
           'compile_expr': _compile_expr, 'load_var_ref': _load_var_ref, 'il_ident': _il_ident,
           'load_var_addr': _load_var_addr, 'store_var': _store_var,
           'compile_funcref_arg': _compile_funcref_arg,
           'widen_if_needed': _widen_if_needed, 'neg_literal_int': _neg_literal_int,
           # Them cho il_features/string_feature.py (Phase 1 buoc 5).
           'int_dtypes': _INT_DTYPES, 'float_dtypes': _FLOAT_DTYPES,
           'compare_opcode': _COMPARE_OPCODE, 'compare_negated': _COMPARE_NEGATED,
           # Them cho il_features/operators.py (Phase 1 buoc 6).
           'infer_dtype': _infer_dtype, 'resolve_compare_operand_dtype': _resolve_compare_operand_dtype,
           'compile_binop_concat': _string_compile_binop_concat,
           'compile_compare_str': _string_compile_compare_str,
           # Them cho il_features/record_feature.py (Phase 1 buoc 8) -
           # il_type_str la ham public API dinh nghia trong file nay,
           # khong the import truc tiep tu record_feature.py.
           'il_type_str': il_type_str,
           # Them cho il_features/closures.py (Buoc 4, 2026-07-29).
           'nested_closures': nested_closures, 'cell_class_name': _cell_class_name,
           'load_boxed_cell_ref': _load_boxed_cell_ref, 'il_scalar': IL_SCALAR,
           'gen_il_function': gen_il_function,
           'extra_classes': extra_classes if extra_classes is not None else [],
           'emitted_types': emitted_types if emitted_types is not None else set()}
    if with_guards:
        body.extend(gen_il_guard_lines(sig, sig.name, label_counter))

    _codegen_stmts(stmts, scope, body, body_dtype, ctx, sig)
    if needs_epilogue:
        # CHI xuat hien khi that su co 'return' ben trong try/except (xem
        # _contains_return) - tranh code khong-the-toi (unreachable) ngay
        # sau 1 'ret' binh thuong o cuoi ham, day chinh la loai bug da tim
        # thay truoc do (InvalidProgramException do 'br' thua sau 'ret').
        body.append(f'  {epilogue_lbl}:')
        _load_var_ref('__ret_tmp', scope, body)
        body.append('    ret')
    elif sig.return_type is None:
        # BUG THAT tim thay qua khoang trong ngon ngu #1 (method 'scale'
        # mutate field, khong 'return' - CIL void KHONG duoc "roi tu do"
        # het than ham ma khong co 'ret', khac cach Python that ngam dinh
        # return None): DSL hien CHUA ho tro 'return' TRAN (khong gia
        # tri) nen 1 ham/method void SE KHONG BAO GIO tu sinh 'ret' tu
        # chinh no - truoc gio CHUA lo vi MOI ham top-level da test deu
        # co return type. InvalidProgramException that (khong phai doan
        # mo) - xac nhan qua sample_record_method.tkv's scale().
        body.append('    ret')

    lines_out = []
    if self_type_ann is not None or is_closure_method:
        virt = f'{virtual_kw} ' if virtual_kw else ''
        lines_out.append(f'  .method public hidebysig {virt}instance {ret_type} {_il_ident(sig.name)}({params_il}) cil managed')
    else:
        lines_out.append(f'  .method public static {ret_type} {_il_ident(sig.name)}({params_il}) cil managed')
    lines_out.append('  {')
    lines_out.append(f'    .maxstack {_max_stack_for(body)}')
    if locals_sig:
        lines_out.append(f'    .locals init ({locals_sig})')
    lines_out.extend(body)
    lines_out.append('  }')
    return lines_out


def _max_stack_for(body):
    """Gia tri `.maxstack` du cho than ham nay.

    Truoc day HANG SO 8 cho moi ham. Goi mot ham 9 THAM SO can 9 o tren
    stack, nen IL sinh ra khong hop le: ilasm van dich, CLR nem
    InvalidProgramException LUC CHAY, khong noi gi ve maxstack. Da do:
    8 tham so chay tot, 9 tham so hong.

    Uoc luong don gian, thien ve du: so tham so lon nhat trong moi lenh
    `call`/`newobj` cua than ham, cong bien 8. `.maxstack` chi la muc
    dat truoc nen dat du khong ton gi; dat THIEU thi hong."""
    widest = 0
    for line in body:
        st = line.strip()
        if not (st.startswith('call ') or st.startswith('callvirt ')
                or st.startswith('newobj ')):
            continue
        at = st.find('(')
        if at < 0:
            continue
        inside = st[at + 1:st.rfind(')')]
        n = 0 if not inside.strip() else inside.count(',') + 1
        if st.startswith('call instance') or st.startswith('callvirt'):
            n = n + 1
        if n > widest:
            widest = n
    return max(8, widest + 8)


def gen_il_generator_function(sig: Signature, body_lines: list, func_table: dict = None,
                               class_name: str = None, records: dict = None,
                               record_methods: dict = None, record_bases: dict = None,
                               extra_classes: list = None, emitted_types: set = None) -> list:
    """Sinh 1 GENERATOR LAZY THAT (Wave 3, 2026-07-29 - thay the hoan toan
    B2(c)'s eager-list desugar, xem project-tokenvector-wave2-status
    memory) - than ham 'def gen(...): ... yield x ...' tro thanh 1 '.class'
    MOI cai IEnumerator<T> (giong het mo hinh THAT cua C# compiler, da xac
    minh bang cach TU VIET 1 IL-dumper qua System.Reflection roi compile+
    doc 1 ham 'yield return' that qua csc.exe - xem memory chi tiet ket
    qua). Ham goc ('gen(...)') tro thanh 1 WRAPPER tam thoi chi lam 1 viec:
    'newobj' the hien class moi + tra ve (KHONG chay than ham).

    Kien truc (RE HON ban C# that - KHONG can IEnumerable/GetEnumerator/
    reset-copy/thread-id, vi TokenVector CHI dung generator qua 1 duong
    DUY NHAT: 'for x in gen(...):' - xem generator_lazy.py's
    codegen_for_in_generator):
    - MOI bien first-pass khai bao (tham so + local, ke ca hidden temp/
      ternary temp - TOAN BO 'locals_decl' tra ve tu _first_pass_collect_
      locals, KHONG phan biet rieng bien nao THAT SU song qua yield hay
      khong - qua-hoisting CO Y THUC, don gian+dung 100% thay vi lam
      liveness analysis chinh xac nhu Roslyn) deu tro thanh 1 FIELD cua
      class, THAY VI '.locals init' cua ham thong thuong.
    - Ky thuat "field la nguon THAT, local la cache tam trong 1 lan goi
      MoveNext()": dong bo field->local 1 LAN DUY NHAT o DAU MoveNext
      (truoc switch), dong bo local->field 1 LAN DUY NHAT truoc MOI diem
      'ret' (yield). Nho vay TOAN BO codegen if/for/while/expr hien co
      (STMT_CODEGEN/EXPR_CODEGEN) tai dung 100% KHONG DOI MOT DONG - chi
      'yield_stmt' (generator_lazy.py) la STMT_CODEGEN THAT SU MOI, con
      lai chi la 2 khoi dong bo bao quanh.
    - 'state' (int32) + 'current' (T) la 2 field dieu khien - switch tren
      'state' o dau MoveNext() nhay toi dung diem resume (nhan sinh boi
      tung 'yield_stmt', danh so THEO THU TU codegen gap - xem ctx['gen_ctx']
      trong generator_lazy.py's codegen_yield_stmt).
    - GIOI HAN DA BIET (co y thuc, chua ho tro): 'return' TRAN (khong gia
      tri) BEN TRONG generator de dung som - DSL nay hien KHONG co cu
      phap 'return' khong gia tri o BAT KY dau (ke ca ham thuong), nen
      chua phat sinh o day; generator CHI ket thuc khi than ham chay het
      TU NHIEN (khop CA 2 test hien co, khong phai gia dinh chua kiem
      chung). Closure long trong generator (boxed_names/nested_closures)
      CHUA duoc kiem tra rieng - se loi ro rang (KeyError/sai field) neu
      dung toi, chua co test cho to hop nay."""
    body_dtype = sig.generator_elem_dtype
    body_lines = _expand_macros(body_lines)
    body_lines = [_rename_reserved_identifiers(l) for l in body_lines]
    lines = _strip_lines(body_lines)
    base_indent = lines[0][0] if lines else 0
    known_shapes = {p.name: p.type_ann.shape for p in sig.params if p.type_ann.shape is not None}
    stmts, end_pos = _parse_block(lines, 0, base_indent, sig, known_shapes)
    if end_pos != len(lines):
        bad_indent, bad_line = lines[end_pos]
        raise SyntaxError(f'il_codegen: indent khong hop le tai dong {bad_line!r} '
                           f'(indent={bad_indent}, ky vong {base_indent})')

    locals_decl, tern_temp_of_id, needs_epilogue, boxed_names, nested_closures = \
        _first_pass_collect_locals(stmts, sig, body_dtype, func_table, records, record_methods)
    if boxed_names or nested_closures:
        raise SyntaxError(
            f"il_codegen: generator '{sig.name}' chua ho tro closure long ben trong "
            f"(khong phai ham long/bien bi bat) - gioi han biet truoc, chua co test")

    gen_class = sig.generator_class_name
    elem_iltype = IL_SCALAR.get(body_dtype, body_dtype)

    # TAT CA tham so + TAT CA local (locals_decl, ke ca hidden/ternary temp)
    # deu tro thanh field CUA CLASS - danh sach THONG NHAT, THU TU on dinh
    # (tham so truoc, roi den locals_decl DUNG THU TU first-pass sinh ra).
    field_vars = [(p.name, p.type_ann) for p in sig.params] + list(locals_decl)

    def _fld_iltype(ta):
        return il_type_str(ta, records)

    scope = _Scope()
    for i, (name, ta) in enumerate(field_vars):
        scope.add_local(name, i, ta)
    state_copy_idx = len(field_vars)  # 1 local scratch RIENG, KHONG phai field, chi dung trong 1 lan MoveNext()

    label_counter = [0]
    gen_ctx = {'class_name': gen_class, 'current_iltype': elem_iltype,
               'field_vars': field_vars, 'state_labels': [], 'next_state': [0]}
    ctx = {'label_counter': label_counter, 'prefix': sig.name, 'tern_temp_of_id': tern_temp_of_id,
           'func_table': func_table or {}, 'class_name': class_name or 'Program', 'loop_stack': [],
           'try_depth': 0, 'epilogue_lbl': f'{sig.name}_epilogue', 'ret_tmp_name': '__ret_tmp',
           'records': records or {}, 'record_methods': record_methods or {},
           'record_bases': record_bases or {},
           'compile_expr': _compile_expr, 'load_var_ref': _load_var_ref, 'il_ident': _il_ident,
           'load_var_addr': _load_var_addr, 'store_var': _store_var,
           'compile_funcref_arg': _compile_funcref_arg,
           'widen_if_needed': _widen_if_needed, 'neg_literal_int': _neg_literal_int,
           'int_dtypes': _INT_DTYPES, 'float_dtypes': _FLOAT_DTYPES,
           'compare_opcode': _COMPARE_OPCODE, 'compare_negated': _COMPARE_NEGATED,
           'infer_dtype': _infer_dtype, 'resolve_compare_operand_dtype': _resolve_compare_operand_dtype,
           'compile_binop_concat': _string_compile_binop_concat,
           'compile_compare_str': _string_compile_compare_str,
           'il_type_str': il_type_str,
           'nested_closures': nested_closures, 'cell_class_name': _cell_class_name,
           'load_boxed_cell_ref': _load_boxed_cell_ref, 'il_scalar': IL_SCALAR,
           'gen_il_function': gen_il_function,
           'extra_classes': extra_classes if extra_classes is not None else [],
           'emitted_types': emitted_types if emitted_types is not None else set(),
           'gen_ctx': gen_ctx}

    body_code = []
    _codegen_stmts(stmts, scope, body_code, body_dtype, ctx, sig)

    body_start_lbl = f'{sig.name}_GENSTART'
    finish_lbl = f'{sig.name}_GENFINISH'

    move_next = []
    move_next.append('    ldarg.0')
    move_next.append(f'    ldfld int32 {gen_class}::__state')
    move_next.append(f'    stloc.s {state_copy_idx}')
    for name, ta in field_vars:
        idx = scope[name][1]
        il_t = _fld_iltype(ta)
        move_next.append('    ldarg.0')
        move_next.append(f'    ldfld {il_t} {gen_class}::{name}')
        move_next.append(f'    stloc.s {idx}')
    move_next.append(f'    ldloc.s {state_copy_idx}')
    switch_targets = ', '.join([body_start_lbl] + gen_ctx['state_labels'])
    move_next.append(f'    switch ({switch_targets})')
    move_next.append(f'    br {finish_lbl}')
    move_next.append(f'  {body_start_lbl}:')
    move_next.extend(body_code)
    move_next.append(f'  {finish_lbl}:')
    move_next.append('    ldarg.0')
    move_next.append('    ldc.i4.m1')
    move_next.append(f'    stfld int32 {gen_class}::__state')
    move_next.append('    ldc.i4.0')
    move_next.append('    ret')

    locals_sig_parts = [f'{_fld_iltype(ta)} {name}' for name, ta in field_vars]
    locals_sig_parts.append('int32 __state_copy')
    locals_sig = ', '.join(locals_sig_parts)

    fields_lines = [f'    .field private int32 __state', f'    .field private {elem_iltype} __current']
    for name, ta in field_vars:
        fields_lines.append(f'    .field private {_fld_iltype(ta)} {name}')

    ctor_params_il = ', '.join(f'{il_type_str(p.type_ann)} {_il_ident(p.name)}' for p in sig.params)
    ctor_body = ['    ldarg.0', '    call instance void [mscorlib]System.Object::.ctor()']
    for i, p in enumerate(sig.params):
        ctor_body.append('    ldarg.0')
        ctor_body.append(f'    ldarg.s {i + 1}')
        ctor_body.append(f'    stfld {il_type_str(p.type_ann)} {gen_class}::{p.name}')
    ctor_body.append('    ldarg.0')
    ctor_body.append('    ldc.i4.0')
    ctor_body.append(f'    stfld int32 {gen_class}::__state')
    ctor_body.append('    ret')

    class_lines = []
    class_lines.append(
        f'.class private auto ansi {gen_class} extends [mscorlib]System.Object '
        f'implements class [mscorlib]System.Collections.Generic.IEnumerator`1<{elem_iltype}>, '
        f'[mscorlib]System.IDisposable')
    class_lines.append('{')
    class_lines.extend(fields_lines)
    class_lines.append(f'  .method public hidebysig specialname rtspecialname instance void .ctor({ctor_params_il}) cil managed')
    class_lines.append('  {')
    class_lines.append('    .maxstack 8')
    class_lines.extend(ctor_body)
    class_lines.append('  }')
    class_lines.append('  .method public hidebysig newslot virtual final instance bool MoveNext() cil managed')
    class_lines.append('  {')
    # Than generator chua ma nguoi dung tuy y, ke ca loi goi >= 9 doi so -
    # cung bay `.maxstack` nhu ham thuong (xem _max_stack_for).
    class_lines.append(f'    .maxstack {_max_stack_for(move_next)}')
    if locals_sig:
        class_lines.append(f'    .locals init ({locals_sig})')
    class_lines.extend(move_next)
    class_lines.append('  }')
    class_lines.append(
        f"  .method public hidebysig newslot virtual final instance {elem_iltype} "
        f"'System.Collections.Generic.IEnumerator<{elem_iltype}>.get_Current'() cil managed")
    class_lines.append('  {')
    class_lines.append(
        f'    .override class [mscorlib]System.Collections.Generic.IEnumerator`1<{elem_iltype}>::get_Current')
    class_lines.append('    .maxstack 8')
    class_lines.append('    ldarg.0')
    class_lines.append(f'    ldfld {elem_iltype} {gen_class}::__current')
    class_lines.append('    ret')
    class_lines.append('  }')
    class_lines.append(
        "  .method public hidebysig newslot virtual final instance object "
        "'System.Collections.IEnumerator.get_Current'() cil managed")
    class_lines.append('  {')
    class_lines.append('    .override [mscorlib]System.Collections.IEnumerator::get_Current')
    class_lines.append('    .maxstack 8')
    class_lines.append('    ldarg.0')
    class_lines.append(f'    ldfld {elem_iltype} {gen_class}::__current')
    if elem_iltype in IL_SCALAR.values() and elem_iltype != 'string':
        class_lines.append(f'    box {elem_iltype}')
    class_lines.append('    ret')
    class_lines.append('  }')
    class_lines.append(
        "  .method public hidebysig newslot virtual final instance void "
        "'System.Collections.IEnumerator.Reset'() cil managed")
    class_lines.append('  {')
    class_lines.append('    .override [mscorlib]System.Collections.IEnumerator::Reset')
    class_lines.append('    .maxstack 8')
    class_lines.append('    newobj instance void [mscorlib]System.NotSupportedException::.ctor()')
    class_lines.append('    throw')
    class_lines.append('  }')
    class_lines.append(
        "  .method public hidebysig newslot virtual final instance void "
        "'System.IDisposable.Dispose'() cil managed")
    class_lines.append('  {')
    class_lines.append('    .override [mscorlib]System.IDisposable::Dispose')
    class_lines.append('    .maxstack 8')
    class_lines.append('    ret')
    class_lines.append('  }')
    class_lines.append('}')

    if extra_classes is not None and gen_class not in (emitted_types or set()):
        extra_classes.append(class_lines)
        if emitted_types is not None:
            emitted_types.add(gen_class)

    wrapper_params_il = ', '.join(f'{il_type_str(p.type_ann)} {_il_ident(p.name)}' for p in sig.params)
    wrapper_ctor_args = ', '.join(il_type_str(p.type_ann) for p in sig.params)
    wrapper = []
    wrapper.append(f'  .method public static class {gen_class} {sig.name}({wrapper_params_il}) cil managed')
    wrapper.append('  {')
    # Wrapper day 1 `ldarg.s` cho MOI tham so roi moi `newobj`, nen stack
    # can dung bang so tham so - generator >= 9 tham so tran hang so 8 cu.
    wrapper.append(f'    .maxstack {max(8, len(sig.params) + 8)}')
    for i in range(len(sig.params)):
        wrapper.append(f'    ldarg.s {i}')
    wrapper.append(f'    newobj instance void {gen_class}::.ctor({wrapper_ctor_args})')
    wrapper.append('    ret')
    wrapper.append('  }')
    return wrapper


def gen_il_program(sig_body_pairs: list, class_name: str = 'Program', with_guards: bool = True,
                    records: dict = None, record_methods: dict = None,
                    extra_classes: list = None, record_bases: dict = None,
                    module_consts: dict = None) -> list:
    """Bien dich NHIEU ham/1 chuong trinh (danh sach (Signature, body_lines))
    thanh 1 CIL class hoan chinh - moi ham co the goi ham KHAC trong CUNG
    danh sach (func_table xay TRUOC, cho phep goi xuoi lan goi nguoc thu
    tu khai bao). Day la nen tang de tu 1 ham don le (gen_il_function)
    tien len "chuong trinh" nhieu ham nhu mot ngon ngu thuc su.

    records: dict ten-record -> [(field_name, dtype), ...] (huong tiep theo
    sau tuple - "class dang record") - CHI anh huong methods (gen_il_function
    can bang nay de biet 'p.x'/'Point(...)' hop le); CHINH cac '.class value'
    cua record phai duoc sinh RIENG boi gen_record_types() va ghep vao IL
    text O NGOAI class chuong trinh chinh (xem tkv_compile.py).
    record_methods: dict ten-record -> {ten-method: Signature} (khoang
    trong ngon ngu #1 - method that tren record) - de CAC HAM TOP-LEVEL
    (khong chi ban than method) cung goi duoc 'p.method(...)' tren 1 bien
    record cua chung.
    extra_classes (Buoc 4 - closure that, 2026-07-29): list OUT-parameter
    (mutable, CALLER truyen vao 1 list rong roi doc lai SAU khi ham nay
    tra ve) - MOI ham co 1 hoac nhieu 'def long' (nested_def) se APPEND vao
    day 1 hoac nhieu KHOI '.class' MOI (cell/closure, xem il_features/
    closures.py) - CALLER (tkv_compile.py) phai tu ghep cac khoi nay vao
    IL text O NGOAI class chuong trinh chinh, GIONG HET cach lam voi
    gen_record_types(). 1 `emitted_types` set DUOC TAO O DAY (khong phai
    tham so cong khai - chi ton tai NOI BO trong 1 lan goi gen_il_program)
    va CHIA SE (cung 1 object) qua MOI lan goi gen_il_function ben duoi, de
    dedupe cell class theo dtype tren toan CHUONG TRINH (nhieu ham co the
    dung chung 1 dtype bi bat, khong can sinh lai cell class do nhieu lan)."""
    func_table = {sig.name: sig for sig, _ in sig_body_pairs}
    dup = [name for name in func_table if
           sum(1 for s, _ in sig_body_pairs if s.name == name) > 1]
    if dup:
        raise SyntaxError(f'il_codegen: trung ten ham trong 1 chuong trinh: {sorted(set(dup))}')
    # Ham nguoi dung TRUNG TEN 1 builtin da dang ky se bi builtin CHE AM
    # THAM: _expr_call tra cuu EXPR_BUILTIN_CODEGEN TRUOC func_table, nen
    # loi goi se chay vao builtin con than ham nguoi dung viet khong bao
    # gio duoc goi - "bien dich thanh cong nhung SAI KET QUA", dung lop
    # loi te nhat. Bao loi RO RANG thay vi de am tham (them 2026-08-03,
    # Giai doan 2 - phat hien khi them eval_arith, luc do eval.tkv dang co
    # 1 ham ten 'eval_expr').
    shadowed = sorted(set(func_table) & set(EXPR_BUILTIN_CODEGEN))
    if shadowed:
        raise SyntaxError(
            f"il_codegen: ham {shadowed} trung ten voi builtin co san - builtin se che "
            f"ham cua ban (khong bao gio duoc goi). Doi ten ham.")
    # Generator lazy THAT (Wave 3, 2026-07-29): danh dau + BIEN DOI
    # return_type CUA SIG NGAY TAI DAY (truoc khi ham nao khac trong
    # func_table doc no) - moi ham co 'yield' trong than duoc dieu huong
    # sang gen_il_generator_function() thay vi gen_il_function() thong
    # thuong (xem is_generator_body/gen_il_generator_function). sig.
    # return_type goc (vd TypeAnn('i32','list') tu cu phap "list[i32]")
    # duoc GIU LAI rieng qua generator_elem_dtype (dtype phan tu that) roi
    # THAY THE bang TypeAnn(ten_class, 'generator') - moi noi khac tra cuu
    # func_table[name].return_type deu thay dung kieu class state-machine,
    # khong can sua rieng tung noi goi.
    for sig, body_lines in sig_body_pairs:
        if _is_generator_body(body_lines):
            if sig.return_type is None or sig.return_type.shape != 'list':
                raise SyntaxError(
                    f"il_codegen: generator '{sig.name}' (co 'yield') phai khai bao "
                    f"return type dang '\"list[dtype]\"' (dtype phan tu yield ra) - "
                    f"tai dung cu phap annotation co san, KHONG suy dtype tu bieu thuc yield")
            sig.is_generator = True
            sig.generator_elem_dtype = sig.return_type.dtype
            sig.generator_class_name = f'{class_name or "Program"}__{sig.name}__GenIter'
            sig.return_type = TypeAnn(sig.generator_class_name, 'generator')
        else:
            sig.is_generator = False
    emitted_types = set()
    if extra_classes is not None:
        # TkvInt duoc sinh VO DIEU KIEN tu 2026-08-05 (lat 4), khong con
        # theo yeu cau. Ly do: tu khi hang so nguyen mac dinh la 'int',
        # gan nhu moi chuong trinh deu dung den no, VA - quan trong hon -
        # _widen_if_needed nay sinh loi goi TkvInt::ToI32/ToI64/ToF64 o
        # nhung cho KHONG co ctx de goi ensure_class. Do that: 'Reference
        # to undefined class TkvInt' luc ilasm, tren mot chuong trinh chi
        # co mot vong 'while'. Mot .class thua trong .exe re hon nhieu so
        # voi mot lop bug "quen ensure_class" rai rac khap codegen.
        _int_type.ensure_class({'emitted_types': emitted_types,
                                'extra_classes': extra_classes})
    all_lines = []
    for sig, body_lines in sig_body_pairs:
        if getattr(sig, 'is_generator', False):
            all_lines.extend(gen_il_generator_function(
                sig, body_lines, func_table=func_table, class_name=class_name,
                records=records, record_methods=record_methods, record_bases=record_bases,
                extra_classes=extra_classes, emitted_types=emitted_types))
        else:
            all_lines.extend(gen_il_function(sig, body_lines, with_guards=with_guards,
                                              func_table=func_table, class_name=class_name,
                                              records=records, record_methods=record_methods,
                                              extra_classes=extra_classes, emitted_types=emitted_types,
                                              record_bases=record_bases,
                                              module_consts=module_consts))
    import il_features.ffi_feature as _ffi
    import il_features.dynamic_exec as _dyn
    import il_features.stdlib_bcl as _bcl
    import il_features.pycapi_shim as _shim
    # 4 khoi IL tho hardcode ten class 'TKVApp' (sua 2026-08-10, xem
    # docs/BUGS_TODO.md) - dung DUNG duoc voi compile_tkv_cli (luon dung
    # class_name mac dinh 'TKVApp'), nhung vo hieu khi goi transpile_
    # program(..., class_name=<ten khac>) truc tiep (vd test/verify dung
    # de lay IL doi chieu CPython) - ILASM bao 'Reference to undefined
    # class TKVApp'. Thay bang class_name THAT o day, 1 cho DUY NHAT, thay
    # vi sua tung khoi text tho rieng le trong 4 file khac nhau.
    _eff_class = class_name or 'TKVApp'
    all_lines.append(_ffi.FFI_CIL_HELPERS.replace('TKVApp', _eff_class))
    all_lines.append(_dyn.DYNAMIC_EXEC_CIL_HELPERS.replace('TKVApp', _eff_class))
    all_lines.append(_bcl.STDLIB_BCL_CIL_HELPERS.replace('TKVApp', _eff_class))
    all_lines.append(_shim.PYCAPI_SHIM_CIL_HELPERS.replace('TKVApp', _eff_class))
    return all_lines


def _hoist_container_fields(record_name, body_lines, records):
    """'self.items.append(x)' / 'len(self.items)' / 'for x in self.items:'
    (2026-08-03).

    MOI duong xu ly list/dict co san deu nhan 1 TEN BIEN roi tra cuu scope,
    nen 'self.items' (1 bieu thuc attr) khong dung duoc truc tiep. Thay vi
    nhan doi tung duong do, o day dat 1 BI DANH cuc bo ngay dau than
    method:

        __self_items = self.items      # them tu dong
        ... moi 'self.items' con lai doi thanh '__self_items'

    List/Dictionary la KIEU THAM CHIEU nen bi danh tro toi CUNG doi tuong -
    '__self_items.append(x)' mutate dung field that, ngu nghia khong doi.

    KHONG hoist 1 field neu than method co GAN LAI ca field do
    ('self.items = ...'): luc do bi danh se cu, de nguyen cho duong
    attr_assign xu ly (nguoi dung tu dat bi danh sau khi gan neu can)."""
    fields = dict(records.get(record_name, [])) if records else {}
    container_names = [fn for fn, fd in fields.items() if _is_container_field(fd)]
    if not container_names:
        return body_lines
    text = '\n'.join(body_lines)
    hoisted = []
    for fname in container_names:
        use_re = re.compile(r'\bself\.' + re.escape(fname) + r'\b')
        if not use_re.search(text):
            continue
        rebind_re = re.compile(r'^\s*self\.' + re.escape(fname) + r'\s*=(?!=)', re.M)
        if rebind_re.search(text):
            continue
        text = use_re.sub(f'__self_{fname}', text)
        hoisted.append(fname)
    if not hoisted:
        return body_lines
    lines = text.split('\n')
    first = next((l for l in lines if l.strip()), '')
    indent = ' ' * (len(first) - len(first.lstrip(' ')))
    prologue = [f'{indent}__self_{fname} = self.{fname}' for fname in hoisted]
    return prologue + lines


def gen_il_method(record_name: str, sig: Signature, body_lines: list, records: dict = None,
                   record_methods: dict = None, class_name: str = 'Program',
                   func_table: dict = None, virtual_kw: str = None,
                   record_bases: dict = None, module_consts: dict = None,
                   record_methods_own: dict = None) -> list:
    """Sinh 1 INSTANCE method (khoang trong ngon ngu #1 - "method that tren
    record") - tai dung TOAN BO gen_il_function (parse/first-pass/codegen
    da duoc test ky qua 18+ bo test) qua tham so `self_type_ann`, CHI khac
    o cho: 'self' duoc bind san vao scope o arg index 0 (kieu !T&, xem
    _Scope.add_self), va header IL dung 'instance' thay vi 'static'.
    with_guards=False (guard-check shape hien chi thiet ke cho tham so
    mang cua ham top-level, chua ap dung cho method)."""
    # '@staticmethod' (Wave 1 Nhom B, 2026-07-29): self_type_ann=None lam
    # gen_il_function sinh 'static' thay vi 'instance' (dung HET co che co
    # san danh cho ham top-level, xem nhanh 'else' trong header .method o
    # duoi), KHONG bind 'self' vao scope.
    is_static = getattr(sig, 'is_static', False)
    self_ta = None if is_static else TypeAnn(record_name, 'record')
    if not is_static:
        body_lines = _hoist_container_fields(record_name, body_lines, records)
    return gen_il_function(sig, body_lines, with_guards=False, func_table=func_table,
                            class_name=class_name, records=records, self_type_ann=self_ta,
                            record_methods=record_methods, record_methods_own=record_methods_own,
                            virtual_kw=None if is_static else virtual_kw,
                            record_bases=record_bases,
                            module_consts=module_consts)


if __name__ == '__main__':
    from typed_dsl_parser import parse_typed_signature

    sig = parse_typed_signature('dot_il_auto(a: f32[128], b: f32[128]) -> f32:')
    body = [
        's = 0.0',
        'for i in range(a.shape[0]):',
        '    s = s + a[i] * b[i]',
        'return s',
    ]
    for l in gen_il_function(sig, body):
        print(l)
