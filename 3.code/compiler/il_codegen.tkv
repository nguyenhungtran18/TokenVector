# _stmt_call_stmt da chuyen sang il_features/file_io.py's codegen_call_stmt
# (Phase 1 buoc 7, 2026-07-28) - kind 'call_stmt' CHI gom write_file/
# append_file, khong con nhu cau nao khac.


def _stmt_method_call_stmt(stmt, scope: _Scope, body: list, body_dtype: str, ctx: dict, sig: Signature, codegen_stmts_fn):
    # 'p.scale(2.0)' nhu 1 lenh doc lap - khac 'call_stmt' (ham
    # top-level): method DUOC PHEP dung theo cach nay du co return
    # type hay khong, vi muc dich chinh THUONG la MUTATE field
    # (xem probe_record_method.il's Scale) - neu co return type,
    # 'pop' ket qua khoi stack (khong am tham SAI, chi don gian
    # KHONG dung toi, giong Python goi 1 method va bo qua ket qua).
    obj_name, method_name, m_args = stmt['call_node'][1], stmt['call_node'][2], stmt['call_node'][3]
    if obj_name not in scope and obj_name in _EXTERN_CLASS_DEFS:
        # Fix I2 (final review Phase 9d Part A, 2026-08-26): 'ClassName.
        # Method()' nhu 1 LENH DOC LAP (khong gan bien) - truoc fix nay,
        # nhanh duy nhat xu ly obj_name KHONG nam trong scope (static
        # method) nam o il_features/record_feature.py's compile_method_call
        # (duong BIEU THUC), _stmt_method_call_stmt (duong LENH doc lap) van
        # lam thang 'scope[obj_name]' -> KeyError/SyntaxError SAI ("bien
        # chua duoc khai bao") du day la 1 loi goi HOP LE (vd goi 1 static
        # method 'returns':'void' nhu 1 lenh doc lap, cach dung PHO BIEN
        # NHAT cho void method - phat hien khi viet test compile+run cho
        # I2's void-return case). Mirror logic voi nhanh
        # 'obj_name not in scope' trong record_feature.py's
        # compile_method_call: tra cuu _EXTERN_CLASS_DEFS, goi
        # tkv_compile._compile_extern_static_class_method_call. Method
        # 'void' tu no da KHONG day gia tri len stack (xem ham do); method
        # CO gia tri tra ve nhung bi goi doc lap (bo qua ket qua) thi 'pop'
        # sau, giong cach nhanh method thuong (obj_ta.shape != 'record')
        # o duoi xu ly.
        import tkv_compile as _tkv_compile
        decl = _EXTERN_CLASS_DEFS[obj_name]
        m = next((mm for mm in decl.get('static_methods', [])
                  if mm['name'] == method_name), None)
        if m is not None and m['returns'] == 'void':
            _tkv_compile._compile_extern_static_class_method_call(
                stmt['call_node'], scope, body, None, ctx, obj_name, method_name, m_args)
            return
        res_dtype = _infer_dtype(stmt['call_node'], scope, ctx.get('func_table'),
                                  ctx.get('records'), ctx.get('record_methods'))
        _compile_expr(stmt['call_node'], scope, body, res_dtype, ctx)
        body.append('    pop')
        return
    _, _, obj_ta = scope[obj_name]
    if obj_ta.shape == 'file':
        # 'f.write(x)' doc lap (khong gan bien) - truong hop dung PHO BIEN
        # NHAT cua file-handle (Write tra ve void san, khong can 'pop').
        return _compile_file_method_call(stmt['call_node'], scope, body, body_dtype, ctx)
    if obj_ta.shape != 'record':
        # 2026-08-03: method cua CONTAINER/chuoi goi nhu 1 lenh doc lap
        # ('ops.pop()' de bo phan tu, 's.strip()' vo nghia nhung hop le) -
        # bien dich nhu 1 bieu thuc roi 'pop' ket qua, giong Python bo qua
        # gia tri tra ve. Truoc day bao loi.
        #
        # Phase 9a (2026-08-24): extern-class method 'returns':'void'
        # (dang ky qua _make_extern_class_method_void_codegen, KHONG co
        # entry trong EXPR_METHOD_DTYPE/EXPR_METHOD_SHAPE - xem
        # register_expr_method's nhanh 'if _m['returns'] == 'void'' trong
        # tkv_compile.py) khong co GI tren stack sau callvirt - goi 'pop'
        # se lech ngan xep IL (peverify/ilasm co the van assemble nhung
        # crash luc chay hoac sai stack o basic block sau). Nhan dien qua
        # _shape_key(obj_ta)=='extern_class' + method KHONG co entry trong
        # CA HAI EXPR_METHOD_DTYPE va EXPR_METHOD_SHAPE - do la dau hieu
        # DUY NHAT phan biet "void that" voi "co gia tri nhung dtype suy
        # duoc = None qua nhanh khac" (khong xay ra voi extern_class vi
        # MOI method co gia tri deu dang ky return_ta_fn, xem Step 5).
        _mkey = (_shape_key(obj_ta), method_name)
        if (obj_ta.shape == 'extern_class'
                and _mkey not in EXPR_METHOD_DTYPE
                and _mkey not in EXPR_METHOD_SHAPE):
            EXPR_METHOD_CODEGEN[_mkey](stmt['call_node'], scope, body, None, ctx)
            return
        res_dtype = (EXPR_METHOD_DTYPE.get(_mkey)
                     or _infer_dtype(stmt['call_node'], scope, ctx.get('func_table'),
                                     ctx.get('records'), ctx.get('record_methods'))
                     or obj_ta.dtype)
        _compile_expr(stmt['call_node'], scope, body, res_dtype, ctx)
        body.append('    pop')
        return
    record_methods = ctx.get('record_methods') or {}
    methods = record_methods.get(obj_ta.dtype, {})
    if method_name not in methods:
        raise SyntaxError(f"il_codegen: record '{obj_ta.dtype}' khong co method '{method_name}'")
    m_sig = methods[method_name]
    n_required = sum(1 for p in m_sig.params if p.default_node is None)
    if not (n_required <= len(m_args) <= len(m_sig.params)):
        raise SyntaxError(
            f"il_codegen: goi '{obj_name}.{method_name}(...)' voi {len(m_args)} tham so "
            f"nhung method can {n_required}"
            + (f'-{len(m_sig.params)}' if n_required != len(m_sig.params) else '')
            + " tham so")
    is_static = getattr(m_sig, 'is_static', False)
    if not is_static:
        # B1 (2026-07-29): record gio la REFERENCE TYPE - dung load_var_ref
        # (khong con load_var_addr) + callvirt (khong con call), giong het
        # sua doi trong il_features/record_feature.py's compile_method_call.
        _load_var_ref(obj_name, scope, body)
    for arg_node, p in zip(m_args, m_sig.params):
        _compile_expr(arg_node, scope, body,
                      _value_dtype_spec_for_ta(p.type_ann, arg_node), ctx)
    for p in m_sig.params[len(m_args):]:
        _compile_expr(p.default_node, scope, body,
                      _value_dtype_spec_for_ta(p.type_ann, p.default_node), ctx)
    ret_il = il_type_str(m_sig.return_type) if m_sig.return_type else 'void'
    params_il = ', '.join(il_type_str(p.type_ann) for p in m_sig.params)
    call_op = 'call' if is_static else 'callvirt'
    call_kind = '' if is_static else 'instance '
    body.append(f'    {call_op} {call_kind}{ret_il} {obj_ta.dtype}::{_il_ident(method_name)}({params_il})')
    if m_sig.return_type is not None:
        body.append('    pop')


def _stmt_idx_assign(stmt, scope: _Scope, body: list, body_dtype: str, ctx: dict, sig: Signature, codegen_stmts_fn):
    _compile_index_store(stmt['name'], stmt['idx_nodes'], stmt['rhs_node'], scope, body, body_dtype, ctx)


# _stmt_attr_assign da chuyen sang il_features/record_feature.py's
# codegen_attr_assign (Phase 1 buoc 8, 2026-07-28).


def _stmt_assign_scalar(stmt, scope: _Scope, body: list, body_dtype: str, ctx: dict, sig: Signature, codegen_stmts_fn):
    # Dung dtype THAT cua bien (da suy trong _first_pass_collect_locals),
    # KHONG phai body_dtype dong loat - can THIET tu khi co 'str'
    # (1 ham numeric van co the co local string, vd de xay message).
    name = stmt['name']
    kind, idx, var_ta = scope[name]
    if kind == 'global':
        # Bien module-level GHI DUOC ('global x', 2026-08-11) - ghi qua
        # '.field private static' cua class chuong trinh (stsfld), khong
        # co local slot (xem _Scope.add_global/_load_var_ref).
        _compile_expr(stmt['rhs_node'], scope, body, var_ta.dtype, ctx)
        body.append(f'    stsfld {IL_SCALAR[var_ta.dtype]} {scope.class_name}::{_il_ident(name)}')
        return
    if kind == 'boxed':
        # Closure that (Buoc 4): CIL 'stfld' can THU TU [objref, value] tren
        # stack - value KHONG the tinh TRUOC nhu duong thuong (_store_var)
        # vi phai chen 'ldloc cell' o GIUA. Lan GAN DAU TIEN cho bien nay
        # (chua co cell) phai newobj tao cell moi (chua tung 'ldloc' duoc -
        # slot con la null); moi lan SAU chi mutate field 'v' cua cell CO
        # SAN - dung 1 set rieng theo TEN ham (ctx moi 1 lan/ham) de phan
        # biet 2 truong hop, KHONG dua vao thu tu stmt (khong the biet truoc
        # tai codegen-setup time bien nao la lan dau).
        cell_class = _cell_class_name(var_ta.dtype)
        initialized = ctx.setdefault('_boxed_initialized', set())
        if name not in initialized:
            initialized.add(name)
            _compile_expr(stmt['rhs_node'], scope, body, var_ta.dtype, ctx)
            body.append(f'    newobj instance void {cell_class}::.ctor({IL_SCALAR[var_ta.dtype]})')
            body.append(f'    stloc.s {idx}')
        else:
            body.append(f'    ldloc.s {idx}')
            _compile_expr(stmt['rhs_node'], scope, body, var_ta.dtype, ctx)
            body.append(f'    stfld {IL_SCALAR[var_ta.dtype]} {cell_class}::v')
        return
    if kind == 'closure_field':
        # Ghi 1 bien bi bat TU BEN TRONG than method cua closure - cell DA
        # TON TAI tu truoc (tao boi ham ngoai), KHONG BAO GIO newobj o day.
        closure_class, field_name = idx
        cell_class = _cell_class_name(var_ta.dtype)
        body.append('    ldarg.0')
        body.append(f'    ldfld class {cell_class} {closure_class}::{field_name}')
        _compile_expr(stmt['rhs_node'], scope, body, var_ta.dtype, ctx)
        body.append(f'    stfld {IL_SCALAR[var_ta.dtype]} {cell_class}::v')
        return
    if var_ta.shape == 'defaultdict' and stmt['rhs_node'][0] == 'call' and \
            stmt['rhs_node'][1] == 'defaultdict':
        # Phase 3.2 (2026-08-11): 'd: "defaultdict[K,V]" = defaultdict(factory)'
        # - xem il_features/defaultdict_type.py's compile_assign_defaultdict_new.
        from il_features.defaultdict_type import compile_assign_defaultdict_new
        compile_assign_defaultdict_new(name, var_ta, stmt['rhs_node'], scope, body, ctx)
        return
    if var_ta.shape == 'counter' and stmt['rhs_node'][0] == 'call' and \
            stmt['rhs_node'][1] == 'Counter':
        # Phase 3.2 (2026-08-11): 'c: "Counter[K]" = Counter()'/'Counter(xs)'
        # - xem il_features/counter_type.py's compile_assign_counter_new.
        from il_features.counter_type import compile_assign_counter_new
        compile_assign_counter_new(name, var_ta, stmt['rhs_node'], scope, body, ctx)
        return
    if var_ta.shape == 'func' and stmt['rhs_node'][0] in ('lambda', 'var'):
        # Phase 3.3 (2026-08-11) - CHI re nhanh khi ve phai la 'lambda'/
        # 1 TEN (bien 'func' khac hoac ham top-level) - day la duong tao
        # boi khai bao tuong minh moi ('assign_typed_decl', xem
        # _lp_typed_local_decl/_fpw_assign_typed_decl) HOAC 1 phep gan lai
        # THUONG ('f = g'/'f = ten_ham') sau do. _compile_expr KHONG
        # dispatch duoc node 'lambda' (khong dang ky trong EXPR_CODEGEN)
        # nen phai dung _compile_funcref_arg (giong het duong 'func' o
        # tham so goi ham). KHONG bat nhanh nay khi ve phai la 'call'
        # (BUG THAT phat hien khi test qua cay .tkv self-host: closure that
        # - Buoc 4, 2026-07-29 - da co san 1 duong KHAC gan local shape==
        # 'func' tu 1 loi goi ham tra ve closure, vd 'f = make_counter()' -
        # _compile_expr's nhanh 'call' TU LAU da xu ly dung truong hop nay
        # qua func_table/il_type_str, khong duoc dam len).
        _compile_funcref_arg(stmt['rhs_node'], var_ta, scope, body, ctx)
        _store_var(name, scope, body)
        return
    _compile_expr(stmt['rhs_node'], scope, body, var_ta.dtype, ctx)
    _store_var(name, scope, body)


def _stmt_assign_zeros1d(stmt, scope: _Scope, body: list, body_dtype: str, ctx: dict, sig: Signature, codegen_stmts_fn):
    body.append(f'    ldc.i4 {stmt["dim"]}')
    body.append(f'    newarr {IL_NEWARR_ELEM[body_dtype]}')
    _store_var(stmt['name'], scope, body)


def _stmt_assign_zeros2d(stmt, scope: _Scope, body: list, body_dtype: str, ctx: dict, sig: Signature, codegen_stmts_fn):
    cs_arr_type = il_array_rank_type(body_dtype, 2)
    body.append(f'    ldc.i4 {stmt["dim0"]}')
    body.append(f'    ldc.i4 {stmt["dim1"]}')
    body.append(f'    newobj instance void {cs_arr_type}::.ctor(int32, int32)')
    _store_var(stmt['name'], scope, body)


