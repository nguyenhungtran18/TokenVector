# 'set_add'/'for_in_dict_items' dang ky boi il_features/list_type.py/
# set_type.py/dict_type.py luc IMPORT (truoc dong code nay chay) - van
# DUNG TRUOC 'method_call_stmt' o duoi. 'if'/'for'/'while'/'try'/'break'/
# 'continue'/'return'/'raise' dang ky boi il_features/control_flow.py
# luc import (Phase 1 buoc 9, 2026-07-28).
register_line_parser('idx_assign', _lp_idx_assign)
# 'attr_assign' dang ky boi il_features/record_feature.py luc import
# (Phase 1 buoc 8, 2026-07-28).
# 'tuple_assign' dang ky boi il_features/tuple_type.py luc import (Phase
# 1 buoc 3, 2026-07-28).
