# 'for'/'while'/'break'/'continue'/'if'/'try'/'return'/'raise' dang ky
# boi il_features/control_flow.py luc import (Phase 1 buoc 9, 2026-07-28).
# 'call_stmt' dang ky boi il_features/file_io.py luc import (Phase 1
# buoc 7, 2026-07-28).
register_stmt_codegen('method_call_stmt', _stmt_method_call_stmt)
register_stmt_codegen('idx_assign', _stmt_idx_assign)
# 'attr_assign' dang ky boi il_features/record_feature.py luc import
