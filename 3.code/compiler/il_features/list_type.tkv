# -*- coding: utf-8 -*-
"""Kieu IL cua List<T> dong - tach rieng file theo tinh nang (2026-07-28)
de sua bug/test list KHONG can dong den phan dict/set/tuple. Xem
il_core.py cho kernel dung chung.

Tu Phase 1 buoc 1 (2026-07-28), file nay CUNG so huu logic parse+codegen
+first-pass rieng cua list (khong chi ham kieu-IL thuan nhu truoc). Cac
ham can goi lai vao core (_compile_expr/_load_var_ref/_widen_if_needed...)
nhan chung qua tham so `ctx` (dictionary duoc 'tiem' san cac ham nay -
xem gen_il_function trong il_codegen.py) THAY VI import truc tiep tu
il_codegen.py - BAT BUOC de tranh circular import (il_codegen.py import
CA file nay, file nay khong bao gio duoc import nguoc lai)."""
import re

from il_core import IL_SCALAR, parse_expr, emit_index_value
from il_dispatch import (
    register_assign_rhs_parser, register_line_parser,
    register_stmt_codegen, register_first_pass_walk, register_expr_codegen,
    register_expr_builtin,
)


def il_list_elem_ilstr(dtype: str, records: dict = None, extern_class_defs: dict = None) -> str:
    """Kieu IL cua 1 PHAN TU List<T>/Dictionary value/HashSet<T> - dtype
    vo huong THAT (tra ve IL_SCALAR[dtype]) HOAC ten 1 'class dang record'
    da khai bao (tra ve 'class TenRecord' - khoang trong ngon ngu #2,
    "List chua record"; DA doi tu 'valuetype' sang 'class' cung B1,
    2026-07-29 - record gio la reference type, xem project-tokenvector-
    wave2-status memory) HOAC ten 1 extern-class da khai bao (tra ve
    'class [assembly]ClassName' - Task 2, extern-class-list, 2026-08-18).
    Dung CHUNG boi ca list_type.py/dict_type.py/set_type.py (khong dat
    rieng moi noi, tranh trung lap logic).
    `extern_class_defs` mac dinh None de KHONG pha cac call site cu
    (record-only, chua biet extern-class).

    2026-09-29 (literal long nhau): nhan them CHUOI MANG SHAPE
    ('list[i32]'/'dict[str,i32]'/'set[i32]') - chuyen ngay cho
    il_container_type_of_spec. Truoc day chi 'la' (noi nhieu noi goi truc
    tiep voi 1 dtype da bi boc sai cho 1 spec) nen chan sai am tham o giua
    duong, trong khi ham nay da bi thiet ke de la NOI CUOI CUNG cua 1 spec
    dang shape. KHONG phai noi long: khoi tao container long nhau van an
    toan; cac guard so-sanh-theo-noi-dung (reject_if_nested_container_elem)
    la tang khac va van nguyen ven."""
    elem = IL_SCALAR.get(dtype)
    if elem is not None:
        return elem
    if records and dtype in records:
        return f'class {dtype}'
    if extern_class_defs and dtype in extern_class_defs:
        d = extern_class_defs[dtype]
        return f"class [{d['assembly']}]{d['class']}"
    if is_container_spec(dtype):
        return il_container_type_of_spec(dtype, records, extern_class_defs)
    raise SyntaxError(
        f"il_codegen: List phan tu kieu {dtype!r} khong hop le - phai la dtype vo huong "
        f"(f32/f64/i32/i64/str) hoac ten 1 class dang record/extern-class da khai bao")


def il_list_type(dtype: str, records: dict = None, extern_class_defs: dict = None) -> str:
    """Kieu IL cua 1 List<T> DONG (closed generic) - dung CHUNG cho khai
    bao local, .ctor, va cac method Add/get_Item/get_Count (khi goi tren
    generic type DA DONG, IL ghi THANG kieu cu the, KHONG dung placeholder
    !0 - placeholder chi dung khi goi tren DINH NGHIA generic mo).
    `extern_class_defs` mac dinh None (Task 2, extern-class-list)."""
    return (f'class [mscorlib]System.Collections.Generic.List`1'
            f'<{il_list_elem_ilstr(dtype, records, extern_class_defs)}>')


def _split_container_spec(spec):
    """(kind, inner) neu `spec` la CHUOI MANG SHAPE, None nguoc lai. `kind`
    la 'list'/'dict'/'set' va `inner` la phan trong ngoac (chua boc them).

    NGUON SU THAT DUY NHAT cho viec 'co phai 1 spec container hay khong' -
    khong viet lai phep tach bang `startswith` o nhieu noi (da du 5 noi
    tach cach nhau nen 1 spec vi du o duong nao do se duoc xu ly va o duong
    khac bi bo qua - dang loi '1 noi lam nhieu viec' ma muc F cua
    docs/BUGS_TODO.md da ghi)."""
    if not isinstance(spec, str) or not spec.endswith(']'):
        return None
    for kind in ('list', 'dict', 'set'):
        if spec.startswith(kind + '['):
            return kind, spec[len(kind) + 1:-1].strip()
    return None


def is_container_spec(spec):
    """True neu `spec` la chuoi MANG SHAPE ('list[i32]'/'dict[str,i32]'/
    'set[i32]') - xem _split_container_spec."""
    return _split_container_spec(spec) is not None


def ta_from_spec(spec, TypeAnn):
    """TypeAnn DAY DU cho 1 chuoi spec - nguoc cua `ta_to_spec` ben duoi.

    Giu quy uoc 'dtype = dtype LEAF cuoi cung, elem_ta = TypeAnn cua 1 tang
    trong' ma declare_list_literal da dung cho list long nhau (2026-08-19) -
    nho vay moi thay doi o day khong lam lech TypeAnn cua nhung bien da
    khai bao truoc. `dict[K,V]` lay `key_dtype` tu V, va `elem_ta` la
    TypeAnn cua GIA TRI (khong phai cua cap khoa-gia tri).

    KHONG dat sentinel '__nested__' vao `dtype` (nhu declare_list/
    declare_dict) ma dung chinh dtype LEAF, vi `ta_to_spec` de quy vao
    `elem_ta` chu khong tin `dtype` - 1 quy uoc cho moi noi de quy
    moi tang, va `_widen_if_needed` se bo qua 1 chuoi khong phai dtype
    vo huong (con neu dat 'i32' cho 1 bien container thi no chen
    `conv.r4` ngay tren 1 con tro Dictionary tren stack).

    `elem_ta` CHI duoc gan khi phan tu/gia tri THAT SU la 1 CONTAINER -
    tinh tu CHINH spec ben trong, KHONG phai tu `elem_ta` cua no. Day khong
    phia chi la quy uoc ma la DIEN KIEN: `ta.elem_ta is not None` la cach
    codebase nhan biet 'phan tu la container' (reject_if_nested_container_
    elem, _index_src_is_nested_container, nhanh elem_ta cua il_type_str),
    nen gan cho ca phan tu VO HUONG se lam 1 `{"k": {1, 2}}` (set phan tu
    i32) bi coi nhu set chua container va `1 in ks` - thao tac hoan toan hop
    le - bi tu choi. Da gap that ngay khi viet ham nay. Con dung `elem_ta`
    cua spec trong lam dieu kien thi `{"rows": [{"n": 1}]}` mat ngay tang
    giuaa (spec trong la 1 dict nen spec con la 1 dict, ma dict do co gia
    tri i32 nen `elem_ta` cua no None) - nen phai xet CHINH co bao ngoac
    cua spec ben trong."""
    split = _split_container_spec(spec)
    if split is None:
        return TypeAnn(spec, None)
    kind, inner = split
    if kind == 'dict':
        key_spec, val_spec = inner.split(',', 1)
        val_spec = val_spec.strip()
        val_ta = ta_from_spec(val_spec, TypeAnn)
        ta = TypeAnn(val_ta.dtype, 'dict', key_dtype=key_spec.strip())
        if is_container_spec(val_spec):
            ta.elem_ta = val_ta
        return ta
    inner_ta = ta_from_spec(inner, TypeAnn)
    ta = TypeAnn(inner_ta.dtype, kind)
    if is_container_spec(inner):
        ta.elem_ta = inner_ta
    return ta


def ta_to_spec(ta):
    """Chuoi spec cua 1 TypeAnn - nguoc cua `ta_from_spec`, va la nguon cho
    `dtype` NGU CANH khi bien dich 1 literal long nhau o VI TRI BIEU THUC
    (xem _append_value_dtype_spec/value_dtype_spec_for_ta).

    DE QUY vao `elem_ta` chu khong tin `ta.dtype`: 2 noi khai bao container
    long nhau hien tai dat `dtype` KHAC NHAU (declare_list/declare_dict dat
    sentinel '__nested__', declare_list_literal dat dtype leaf) - de quy
    vao elem_ta cho ca 2 ra cung ket qua, nen khong phai dong y nhau ve
    sentinel (chinh la nguon cua 'nhieu noi lam 1 viec' o muc F).
    Tra None cho ta None (gia tri ngu canh khong co).

    Day la HAM DUY NHAT chuyen 'TypeAnn -> spec' trong codebase: ham
    `ta_list_spec` (chi 2 tang, chi 'list[') da bi XOA 2026-09-29 khi
    `_append_value_dtype_spec`/`value_dtype_spec_for_ta` doi sang ham nay -
    giu ca 3 se la 3 noi lam 1 viec, va 2 cai cu rat de TRONG NHAU (2 tang
    thi dung, 3 tang thi sai) chinh la muc F cua docs/BUGS_TODO.md."""
    if ta is None:
        return None
    inner = ta_to_spec(ta.elem_ta) if getattr(ta, 'elem_ta', None) is not None else ta.dtype
    if ta.shape == 'dict':
        return f'dict[{ta.key_dtype}, {inner}]'
    if ta.shape in ('list', 'set', 'frozenset'):
        return f'{ta.shape}[{inner}]'
    return ta.dtype


def ta_elem_spec(ta):
    """Spec cua MOT PHAN TU/GIA TRI cua container `ta` (phan tu cua list/set,
    gia tri cua dict) - KHAC `ta_to_spec` (tra ve ca container) va
    `ta.dtype` (mat tang long nhau). Day la cai ma 1 caller truyen xuong
    `compile_expr` cho CAI GIA TRI dang them vao 1 container, nen
    'dict[str,i32]' phai boc ra thanh 'i32' truoc khi con lai no la
    context dtype cho 1 literal long nhau ben trong."""
    if getattr(ta, 'elem_ta', None) is not None:
        return ta_to_spec(ta.elem_ta)
    return ta.dtype


def il_container_type_of_spec(spec, records=None, extern_class_defs=None):
    """Chuoi CIL cua 1 GIA TRI duoc mo ta boi `spec` - NGUON DUY NHAT cho
    quy uoc "dtype co the la 1 chuoi mang shape" dung xuyen suot codebase
    ('i32', 'Point', 'Sb', 'list[i32]', 'list[list[i32]]',
    'dict[str,i32]', 'dict[str,list[i32]]'...). Hop nhat 2 implementation
    TRUNG LAP truoc day - `_il_list_of` (duong list thuan .tkv, file nay)
    va `_il_ctor_param_type` (duong extern-class ctor/method,
    il_codegen.py) - moi ben tu de quy rieng, gay IL sai am tham khi 1
    ben duoc mo rong (them lop long/handle-type/dict long) con ben kia
    thi khong (xem docs/BUGS_TODO.md muc F, phat hien lai lai qua muc O/P
    voi 1 lop bug KHAC nhung CUNG goc "2 noi lam 1 viec").

    De quy 1 lop cho moi lop 'list['/'dict['/'set[' - dung LAI il_list_elem_ilstr
    cho phan tu la (i) scalar (IL_SCALAR), (ii) record da khai bao (can
    `records`), (iii) extern-class da khai bao qua __tkv_extern_class__
    (can `extern_class_defs`) - KHONG dinh nghia lai logic do o day.

    2026-09-29: them nhanh 'set[' (HashSet`1, [System.Core] - KHONG phai
    [mscorlib] nhu List`1/Dictionary`2, xem il_set_type). Va tach dau '...['
    bang _split_container_spec (1 noi tach, thay vi 3 doan `startswith`
    lap lai) - sua gap 'set' bi bo soat o khoi doc spec dang shape.

    Luu y (final-review round 3, docs/BUGS_TODO.md muc F): ham nay KHONG
    tu validate `spec` - no CHAP NHAN nhieu input hon 2 caller goc tung
    chap nhan rieng le (vd: dict[...] lam element spec cua list[...], hay
    key khong-scalar cua dict[...]). Cac caller dua vao 1 lop validate O
    TREN (tkv_compile.py) da chan cac input do truoc khi toi codegen -
    hien tai vo hai vi khong con duong nao goi toi day voi input nhu vay,
    nhung ham nay tu no khong con la hang rao chan."""
    if extern_class_defs and spec in extern_class_defs:
        d = extern_class_defs[spec]
        return f"class [{d['assembly']}]{d['class']}"
    split = _split_container_spec(spec)
    if split is not None:
        kind, inner = split
        if kind == 'dict':
            # KHONG goi chung `inner_il` o tren: `inner` cua dict la
            # "K,V" chu khong phai 1 spec - phai tach cap truoc (doan
            # 2026-09-29 bat loi 'List phan tu kieu "str, int" khong hop le').
            key_spec, val_spec = inner.split(',', 1)
            key_il = il_container_type_of_spec(key_spec.strip(), records, extern_class_defs)
            val_il = il_container_type_of_spec(val_spec.strip(), records, extern_class_defs)
            return f'class [mscorlib]System.Collections.Generic.Dictionary`2<{key_il}, {val_il}>'
        inner_il = il_container_type_of_spec(inner, records, extern_class_defs)
        if kind == 'list':
            return f'class [mscorlib]System.Collections.Generic.List`1<{inner_il}>'
        return f'class [System.Core]System.Collections.Generic.HashSet`1<{inner_il}>'
    return il_list_elem_ilstr(spec, records, extern_class_defs)


def reject_if_nested_container_elem(ta, fname):
    """Tu choi ro rang neu list nguon co phan tu la container long nhau
    (list[list[T]]/list[dict[K,V]], nhan biet qua ta.elem_ta khac None -
    xem TypeAnn.elem_ta trong typed_dsl_parser.py) - dung cho remove()/
    index()/count()/'in' (review vong 4, task-1-review-round4-report.md).
    GIOI HAN KIEN TRUC THAT, khong phai bug co the va don gian sua: cac
    ham nay dung List<T>.Remove/IndexOf/Contains, tat ca deu so sanh qua
    EqualityComparer<T>.Default - voi T la 1 container (List<T> khac),
    default comparer la SO SANH THAM CHIEU, khong phai noi dung. 1 gia
    tri list-literal MOI (newobj) tai diem goi se KHONG BAO GIO khop
    tham chieu voi phan tu da co trong list dich, du noi dung giong het -
    khong the vay bang shape-string dtype convention nhu 3 vong review
    truoc, PHAI chan o day (giong reject_if_handle_type_elem cho
    Nhom C/D/E o list-handle-type-aggregate-guard, muc P)."""
    if ta.elem_ta is not None:
        raise SyntaxError(
            f"il_codegen: {fname}() khong ho tro list chua container long nhau "
            f"(list[list[...]]/list[dict[...]]) - List<T> so sanh phan tu container "
            f"THEO THAM CHIEU (khong theo noi dung), ket qua se sai am tham")


def reject_if_handle_type_elem(ta, extern_class_defs, fname):
    """Tu choi ro rang neu list/set nguon co phan tu la handle type (extern-
    class da khai qua __tkv_extern_class__) - dung cho cac ham CAN so sanh/
    so hoc/serialize tren phan tu (sum/min/max/any/all/sorted/json_dumps),
    KHAC map/filter/reduce/choice/shuffle/sample (pass-through, khong dong
    den noi dung phan tu, nen KHONG goi ham nay - xem il_list_type's tham so
    extern_class_defs cho nhanh do thay vao do)."""
    if extern_class_defs and ta.dtype in extern_class_defs:
        raise SyntaxError(
            f"il_codegen: {fname}() khong ho tro list/set chua handle type "
            f"('{ta.dtype}' da khai qua __tkv_extern_class__) - .NET class "
            f"tuy y khong tu co IComparable/phep toan/serialize duoc")


_LIST_LIT_RE = re.compile(r'^\[.*\]$', re.S)
_LIST_APPEND_RE = re.compile(r'^(\w+)\.append\((.+)\)\s*$')


def compile_index_list(name, indices, scope, out, dtype, ctx):
    """CIL cho 'lst[i]' (doc 1 phan tu List<T>) - tag 'index' cua
    _compile_expr khi shape=='list', xem il_codegen.py's _expr_index.
    Dung ctx['il_type_str'] (DE QUY) thay vi il_list_type(dtype,...) THANG
    - can THIET tu Wave 2 (2026-07-29, container long nhau): khi 'lst' la
    List<List<T>>/List<Dict<K,V>> (type_ann.elem_ta khac None), chi
    il_type_str moi tinh dung kieu IL day du cua CHINH list nay (xem
    il_codegen.py's il_type_str) - voi list thuong (elem_ta=None), 2 ham
    cho ra CHUOI GIONG HET NHAU (khong doi hanh vi cu)."""
    if len(indices) != 1:
        raise SyntaxError(f"il_codegen: list '{name}' chi ho tro 1 chi so")
    _, _, type_ann = scope[name]
    list_type = ctx['il_type_str'](type_ann, (ctx or {}).get('records'))
    ctx['load_var_ref'](name, scope, out)
    emit_index_value(name, indices[0], scope, out, ctx,
                      f'callvirt instance int32 {list_type}::get_Count()')
    # QUAN TRONG: tra ve '!0' (placeholder generic param), KHONG phai
    # kieu da thay the (vd float32) - bug that phat hien qua test
    # (MissingMethodException luc chay): metadata cua get_Item duoc dinh
    # nghia TREN generic type DINH NGHIA MO voi kieu tra ve la !0;
    # methodref phai ghi DUNG nhu vay, phan <float32> chi cung cap ngu
    # canh thay the cho KIEU KHAI BAO, khong doi chu ky cua chinh method.
    out.append(f'    callvirt instance !0 {list_type}::get_Item(int32)')
    ctx['widen_if_needed'](type_ann.dtype, dtype, out)


def try_rhs_list_literal(rhs, name, known_shapes):
    """ASSIGN_RHS_PARSERS entry: 'lst = []' HOAC 'xs = [3, 1, 2]' - Giai
    doan 0.1 (2026-08-03, dong Python-parity-gap v2): dung PARSER THAT
    (parse_expr, tag 'list_literal' vua them vao il_core.py's parse_factor)
    thay vi tu tach dau phay bang tay - tu dong dung ke ca phan tu chua
    bieu thuc long nhau/dau phay trong ham (vd '[f(1, 2), 3]').

    RONG ('[]'): dtype phan tu CHUA biet o day, suy sau tu LAN GOI
    '.append(...)' DAU TIEN tren bien nay (xem declare_list) - giu NGUYEN
    hanh vi cu (stmt kind 'assign_list_new'), khong doi gi.

    CO PHAN TU ('[3, 1, 2]'): dtype suy THANG tu chinh cac phan tu (xem
    declare_list_literal), khong can quet '.append()' sau do."""
    rhs_s = rhs.strip()
    if not _LIST_LIT_RE.match(rhs_s):
        return None
    node = parse_expr(rhs_s)
    if node[0] != 'list_literal':
        return None
    known_shapes[name] = 'list'
    if not node[1]:
        return {'kind': 'assign_list_new', 'name': name}
    return {'kind': 'assign_list_literal', 'name': name, 'elements': node[1]}


def try_parse_list_append(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    """LINE_PARSERS entry: 'lst.append(x)' - PHAI dang ky TRUOC
    method_call_stmt (pattern method-call tong quat cung khop dong nay).

    Loai tru known_shapes=='bytearray' (muc 6.8, 3/4, 2026-08-13, giong het
    cach try_parse_list_remove da loai tru set/frozenset o duoi): 'ba.append(x)'
    tren bytearray CAN codegen RIENG (chen 'conv.u1' truoc Add(!0) - xem
    bytearray_type.py) - neu KHONG loai tru o day, nhanh list nay se cuop
    mat truoc (list_type.py duoc import/dang ky TRUOC bytearray_type.py
    trong il_codegen.py, LINE_PARSERS thu THEO THU TU dang ky) va bo lo
    buoc narrow bat buoc do.

    Loai tru THEM known_shapes=='bytes' (muc 6.8, 4/4, 2026-08-13): 'data.append(x)'
    tren bien 'bytes' (bat bien) PHAI bi try_parse_bytes_append_blocked
    (bytes_type.py) bat va nem SyntaxError bat bien - neu KHONG loai tru o
    day, nhanh list nay se cuop mat truoc va sinh IL append hop le (SAI,
    'bytes' khong duoc mutate)."""
    m = _LIST_APPEND_RE.match(line)
    if not m:
        return None
    _nm = m.group(1)
    _sh = known_shapes.get(_nm)
    if _sh is not None and _sh != 'list':
        # R4/D6 (2026-09-22): 'rec.append(x)' tren record/str/dict/... phai
        # roi xuong method_call_stmt, KHONG duoc cuop boi nhanh list nay.
        # known_shapes chi ghi container/file + params co shape; None =
        # chua ro (tuong thich nguoc: van coi nhu list).
        return None
    if _sh in ('bytearray', 'bytes'):
        return None
    name, arg_expr = m.groups()
    return {'kind': 'list_append', 'name': name, 'value_node': parse_expr(arg_expr)}, pos + 1


def codegen_assign_list_new(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 'lst = []'. Dung ctx['il_type_str'] (DE QUY, xem
    il_codegen.py) thay il_list_type THANG - can THIET tu Wave 2
    (2026-07-29) de ho tro dung List<List<T>>/List<Dict<K,V>> khi ta.elem_ta
    khac None; voi list thuong ra CUNG 1 chuoi nhu truoc."""
    _, _, ta = scope[stmt['name']]
    body.append(f'    newobj instance void {ctx["il_type_str"](ta, ctx.get("records"))}::.ctor()')
    ctx['store_var'](stmt['name'], scope, body)


def _record_stmt_fallback(name, method_name, arg_nodes, scope, body, ctx):
    """R4/D6 safety net: 'rec.insert/remove/append(...)' dang lenh doc lap
    nhung receiver THAT SU la record (local, known_shapes=None luc parse
    nen parser van hieu nham la list). Phat lai dung logic record-statement
    cua il_codegen._stmt_method_call_stmt (load receiver + compile args
    theo m_sig + callvirt + pop neu co return). Tra True neu da xu ly."""
    record_methods = (ctx or {}).get('record_methods') or {}
    _, _, ta = scope[name]
    if ta.shape != 'record':
        return False
    methods = record_methods.get(ta.dtype, {})
    m_sig = methods.get(method_name)
    if m_sig is None:
        raise SyntaxError(
            f"il_codegen: record '{ta.dtype}' khong co method '{method_name}' "
            f"('{name}.{method_name}(...)' khong phai list.{method_name})")
    from il_features import kwarg_resolve as _kw
    args = _kw.resolve_call_args(m_sig.params, list(arg_nodes), f'{name}.{method_name}')
    n_required = sum(1 for p in m_sig.params if p.default_node is None)
    if not (n_required <= len(args) <= len(m_sig.params)):
        raise SyntaxError(
            f"il_codegen: goi '{name}.{method_name}(...)' voi {len(args)} tham so "
            f"nhung method can {n_required}"
            + (f'-{len(m_sig.params)}' if n_required != len(m_sig.params) else '')
            + " tham so")
    is_static = getattr(m_sig, 'is_static', False)
    if not is_static:
        ctx['load_var_ref'](name, scope, body)
    for arg_node, p in zip(args, m_sig.params):
        ctx['compile_expr'](arg_node, scope, body,
                            value_dtype_spec_for_ta(p.type_ann, arg_node), ctx)
    for p in m_sig.params[len(args):]:
        ctx['compile_expr'](p.default_node, scope, body,
                            value_dtype_spec_for_ta(p.type_ann, p.default_node), ctx)
    il_type_str = ctx['il_type_str']
    ret_il = il_type_str(m_sig.return_type) if m_sig.return_type else 'void'
    params_il = ', '.join(il_type_str(p.type_ann) for p in m_sig.params)
    call_op = 'call' if is_static else 'callvirt'
    call_kind = '' if is_static else 'instance '
    body.append(f'    {call_op} {call_kind}{ret_il} {ta.dtype}::{ctx["il_ident"](method_name)}({params_il})')
    if m_sig.return_type is not None:
        body.append('    pop')
    return True


def codegen_list_append(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 'lst.append(x)' (x co the la 1 bien container
    khac khi lst la List long nhau, Wave 2 2026-07-29)."""
    _, _, ta = scope[stmt['name']]
    if ta.shape == 'record':
        if _record_stmt_fallback(stmt['name'], 'append', [stmt['value_node']],
                                 scope, body, ctx):
            return
    if ta.shape is not None and ta.shape != 'list':
        raise SyntaxError(
            f"il_codegen: '{stmt['name']}.append(...)' - '{stmt['name']}' co "
            f"shape={ta.shape!r} dtype={ta.dtype!r}, khong phai list "
            f"(neu day la method 'append' cua record, doi ten method tranh "
            f"trung voi list.append)")
    ctx['load_var_ref'](stmt['name'], scope, body)
    ctx['compile_expr'](stmt['value_node'], scope, body,
                        _append_value_dtype_spec(ta, stmt['value_node']), ctx)
    body.append(f'    callvirt instance void {ctx["il_type_str"](ta, ctx.get("records"))}::Add(!0)')


def _append_value_dtype_spec(ta, value_node):
    """dtype NGU CANH truyen xuong cho GIA TRI duoc Add vao List<T> cua
    `ta`. Voi list THUONG day la ta.dtype (giu nguyen hanh vi cu). Voi
    list LONG NHAU (vd 'm = [[1,2],[3,4]]' ->
    ta = TypeAnn('i32','list',elem_ta=TypeAnn('i32','list'))) va gia tri
    dang Add LA 1 list-literal, ta.dtype ('i32') MO TA SAI gia tri do
    (no la 1 List<int32>, khong phai 1 int32) - tra ve chuoi MANG SHAPE
    'list[i32]' theo dung quy uoc "dtype co the la chuoi mang shape" da
    dung o il_codegen.py's _il_ctor_param_type (Task 2/Phase 7).

    CHI ap dung cho value_node la 1 LITERAL container (thu hep pham vi anh
    huong): khi gia tri la 1 BIEN container da khai bao, duong cu
    (ta.dtype) van dung - _expr_var khong hieu chuoi mang shape.

    Round 3 (2026-08-19): than ham nay TRUOC day tu tinh
    f'list[{ta.elem_ta.dtype}]' - chi dung 2 TANG, LECH voi ta_list_spec
    (de quy moi tang). Nay UY QUYEN cho ta_to_spec de chi con 1 NGUON
    SU THAT duy nhat cho "TypeAnn -> chuoi shape-string" (chong tai dien
    lop loi nay lan thu 4).

    2026-09-29 (literal long nhau): nhan them 'dict_literal'/'set_literal'
    va bo dieu kien `ta.elem_ta.shape == 'list'` (truoc day khoi con 'list' o
    ten bien, nhung long nhau dang moi - `[{...}]`/`{"k": [...]}` - cung di
    qua chinh duong nay). Spec do lay bang `ta_elem_spec(ta)` de quy moi
    tang, va KHONG con phu thuoc 'cha la list' gi ca."""
    if (value_node and value_node[0] in ('list_literal', 'dict_literal', 'set_literal')
            and ta.elem_ta is not None):
        return ta_elem_spec(ta)
    return ta.dtype


def value_dtype_spec_for_ta(ta, value_node):
    """dtype NGU CANH truyen xuong cho 1 GIA TRI (doi so ham/gia tri
    return/tham so method) co kieu khai bao `ta`.

    Critical round 2 (2026-08-19): cac diem goi _compile_expr cho doi so/
    return truoc day dung `ta.dtype` PHANG - voi 'list[list[i32]]' thi
    ta.dtype chi la 'i32', MAT lop long nhau, khien
    codegen_expr_list_literal sinh 'newobj List<int32>' thay vi
    'List<List<int32>>' (AccessViolationException/NullReferenceException
    luc chay). Tra ve chuoi mang shape trong DUNG truong hop do.

    Pham vi HEP co y (chi literal container long nhau): voi cac gia tri khac
    (bien, loi goi ham...) duong cu `ta.dtype` van dung - _expr_var va
    dong doi KHONG hieu chuoi mang shape.

    2026-09-29: bo dieu kien 'cha la list' (xem _append_value_dtype_spec) va
    chuyen sang `ta_to_spec` - 1 nguon su that duy nhat cho ca 2 noi. Nhanh
    container day du (thay vi `ta.dtype`) rat quan trong cho DICT: `dtype`
    cua 1 TypeAnn shape='dict' chi la dtype cua GIA TRI, KHONG co khoa - neu
    truyen no xuong cho 1 dict-literal thi khoa se bi suy sai (thuong la
    'i32' thay vi 'str') va `d[k]` luc chay se doc nho RAM (da gap that qua
    `def g(d: "dict[str,i32]"): ...; g({"a": 5})` -> AccessViolationException
    trong Dictionary::FindEntry)."""
    if ta is None:
        return None
    if (value_node and isinstance(value_node, tuple)
            and getattr(ta, 'shape', None) in ('list', 'dict', 'set', 'frozenset')
            and (getattr(ta, 'elem_ta', None) is not None
                 or value_node[0] in ('list_literal', 'dict_literal', 'set_literal'))):
        return ta_to_spec(ta)
    return ta.dtype


def _il_list_of(elem_spec, records=None, extern_class_defs=None):
    """Chuoi IL cua 1 List<elem_spec>. THIN WRAPPER quanh
    il_container_type_of_spec (muc F, docs/BUGS_TODO.md - hop nhat 2
    implementation trung lap). `extern_class_defs` THEM MOI (Task 1's
    investigation, task-1-report.md gia thuyet 1): TRUOC day ham nay
    KHONG nhan tham so nay, khien list-literal LONG NHAU chua phan tu
    extern-class (vd 'grid = [[a, b]]' voi a,b la handle-type) build FAIL
    - 'SyntaxError: List phan tu kieu Sb khong hop le' - du list[T] PHANG
    cung loai T da build duoc tu lau qua duong ctor/method (bat nhat).
    Ham nay boc them 1 lop 'List<...>' NGOAI CUNG so voi
    il_container_type_of_spec(elem_spec, ...) truc tiep - vi elem_spec o
    day la kieu PHAN TU (khong bao gom 'list[' ngoai cung nhu spec day
    du)."""
    inner = il_container_type_of_spec(elem_spec, records, extern_class_defs)
    return f'class [mscorlib]System.Collections.Generic.List`1<{inner}>'


def _literal_dtype_fallback(el):
    """dtype doan tu CU PHAP hang so truc tiep - luoi cuoi cung khi ctx
    KHONG co ctx['infer_literal_dtype'] (khoa nay CHI co trong walk_ctx
    cua first-pass, khong co trong ctx giai doan codegen)."""
    if isinstance(el, tuple) and el[0] == 'num':
        return 'f32' if '.' in el[1] or 'e' in el[1].lower() else 'i32'
    if isinstance(el, tuple) and el[0] == 'str_lit':
        return 'str'
    return None


def list_literal_elem_spec_of(el, infer_scope, ctx):
    """dtype (spec) cua MOT phan tu list-literal - NGUON SU THAT DUY NHAT,
    dung CHUNG boi declare_list_literal (first-pass) VA
    codegen_expr_list_literal (codegen). Truoc 2026-08-19 (final review C1)
    day la 2 duong suy kieu KHAC nhau trong CUNG 1 tinh nang, gay IL sai
    am tham. Tra ve chuoi vo huong, hoac chuoi MANG SHAPE
    ('list[T]'/'dict[K,V]'/'set[T]') khi phan tu lai la 1 container-literal
    long nhau. Cac khoa ctx chi co o first-pass
    (infer_literal_dtype/contains_float_literal/int_dtypes) duoc doc bang
    .get() + fallback de ham chay duoc o CA HAI giai doan.

    2026-09-29: them nhanh 'dict_literal'/'set_literal'. Truoc day 2 node do
    khong co nhanh nao -> tra None -> phan tu bi suy nhu 'khong ro', roi
    container long nhau bi khai bao sai kieu (hoac bien dich that bai o vi
    tri bieu thuc, vi chung CHUA duoc dang ky trong EXPR_CODEGEN - xem
    codegen_expr_dict_literal/codegen_expr_set_literal). Dict/set literal
    long nhau lay spec tu 2 ham chung duoi day (dict_literal_spec_of/
    list_literal_elem_spec) - KHONG sua 2 duong suy kieu trung lap."""
    if el[0] == 'list_literal':
        inner = list_literal_elem_spec(el[1], infer_scope, ctx)
        return f'list[{inner}]' if inner is not None else None
    if el[0] == 'dict_literal':
        key_spec, val_spec = dict_literal_spec_of(el[1], infer_scope, ctx)
        if key_spec is None or val_spec is None:
            return None
        return f'dict[{key_spec}, {val_spec}]'
    if el[0] == 'set_literal':
        inner = list_literal_elem_spec(el[1], infer_scope, ctx)
        return f'set[{inner}]' if inner is not None else None
    func_table = (ctx or {}).get('func_table') or {}
    records = (ctx or {}).get('records') or {}
    record_methods = (ctx or {}).get('record_methods') or {}
    try:
        d = ctx['infer_dtype'](el, infer_scope, func_table, records, record_methods)
    except (KeyError, SyntaxError):
        d = None
    int_dtypes = (ctx or {}).get('int_dtypes')
    contains_float_literal = (ctx or {}).get('contains_float_literal')
    if int_dtypes and contains_float_literal and d in int_dtypes and contains_float_literal(el):
        d = 'f32'
    if d is None:
        infer_literal_dtype = (ctx or {}).get('infer_literal_dtype')
        if infer_literal_dtype is not None:
            d = infer_literal_dtype(el)
    if d is None:
        d = _literal_dtype_fallback(el)
    return d


def list_literal_elem_spec(elements, infer_scope, ctx):
    """dtype (spec) PHAN TU cua CA list-literal - fold quy tac widen ve
    float (Python that: [1, 2.0] la list[float]) tren
    list_literal_elem_spec_of. Xem docstring ham do ve ly do dung chung."""
    elem_dtype = None
    for el in elements:
        d = list_literal_elem_spec_of(el, infer_scope, ctx)
        if elem_dtype is None or (elem_dtype not in ('f32', 'f64') and d in ('f32', 'f64')):
            elem_dtype = d
    return elem_dtype


def dict_literal_spec_of(pairs, infer_scope, ctx):
    """(key_spec, val_spec) cho 1 dict literal - suy THANG tu cac cap trong
    literal, khong can quet 'd[k] = v' sau do. Widen ve float neu bat ky
    phan nao la float (Python that: {'a': 1, 'b': 2.0} la dict[str,float]).

    Dat O DAU (list_type.tkv) chu khong phai trong dict_type.tkv vi
    list_literal_elem_spec_of - ham suy spec cua MOT phan tu, duoc goi boi
    ca 3 loai literal - can no o noi ma 3 duong do cung dung 1 ham. Do la
    ly do doc lap voi muc F cua docs/BUGS_TODO.md: file nay CHUA import
    dict_type (nguoc lai thi cycle), nen ham phai nam o 1 file ma ca 3
    deu import duoc."""
    key_dtype = val_dtype = None
    for k_node, v_node in pairs:
        for node, is_key in ((k_node, True), (v_node, False)):
            d = list_literal_elem_spec_of(node, infer_scope, ctx)
            if d is None:
                continue
            cur = key_dtype if is_key else val_dtype
            if cur is None or (cur not in ('f32', 'f64') and d in ('f32', 'f64')):
                if is_key:
                    key_dtype = d
                else:
                    val_dtype = d
    return key_dtype, val_dtype


def codegen_expr_list_literal(node, scope, out, dtype, ctx=None):
    """EXPR_CODEGEN entry: '[3, 1, 2]' o VI TRI BIEU THUC (Phase 7 follow-up,
    2026-08-19, Gap 2) - KHAC codegen_assign_list_literal (statement-level,
    RHS truc tiep cua 1 phep gan): tag 'list_literal' truoc day CHI dang
    ky duoc xu ly o tang STATEMENT, chua co entry trong EXPR_CODEGEN nen
    khi no xuat hien LONG trong 1 bieu thuc khac (vi du: la 1 PHAN TU cua
    1 list-literal NGOAI, nhu 'grid = [[1, 2], [3, 4]]' - codegen_list_append
    goi ctx['compile_expr'] tren TUNG phan tu, va phan tu do LAI la 1
    'list_literal' khac) se nem SyntaxError "AST node khong ro".

    dtype NGU CANH (tham so `dtype`, do CALLER truyen xuong) la NGUON UU
    TIEN cho dtype phan tu - dung quy uoc chung cua MOI entry EXPR_CODEGEN
    (xem _compile_expr/_expr_call: doi so duoc compile voi
    p.type_ann.dtype, tuc voi 'def total(xs: "list[f64]")' thi dtype='f64'
    CHINH LA dtype phan tu ky vong). Sua final-review C1 (2026-08-19):
    truoc day ham BO QUA `dtype` va tu suy bang 1 duong suy kieu THU HAI
    -> 'total([1.5, 2.5])' dung List<float32> cho tham so List<float64>
    (in ra 8.0000019 thay vi 4.0), 'list[int]' (TkvInt) nem
    AccessViolationException, 'm = [[1,2],[3,4]]' nem
    ArrayTypeMismatchException.

    `dtype` co the la chuoi MANG SHAPE 'list[T]' (khi literal nay la 1
    PHAN TU cua 1 container-literal NGOAI, xem _append_value_dtype_spec) -
    khi do phan boc 'list[' cho ra dtype phan tu THAT cua literal nay, dung
    quy uoc cua il_codegen.py's _il_ctor_param_type.

    Khi dtype la None (khong co ngu canh), suy bang CHINH ham dung chung
    voi declare_list_literal (list_literal_elem_spec) - MOT nguon su that
    duy nhat, khong con 2 duong suy kieu lech nhau.

    2026-09-29: `dtype` la spec cua 1 container KHAC loai (say nguoi viet
    `f({1, 2})` cho tham so `list[i32]`) thi bao loi ro rang thay vi bo qua
    `dtype` - bo qua se sinh List<Dictionary<..>> cho 1 noi can list, loi chi
    lo ra o tier toolchain (hoac, te hon, chay sai am tham)."""
    elements = node[1]
    # 2026-09-29: tach dau ngoac bang _split_container_spec (chung 1 ham voi
    # il_container_type_of_spec) thay vi kiem 'list[' rieng - literal long
    # nhau moi co the cap ngu canh 'set[T]'/'dict[K,V]' o day.
    split = _split_container_spec(dtype)
    if split is not None:
        if split[0] != 'list':
            raise SyntaxError(
                f"il_codegen: list-literal '[...]' o vi tri can kieu {dtype!r} - "
                f"ngu canh kieu {split[0]}[...], khong phai list")
        elem_spec = split[1]
    elif dtype is not None:
        elem_spec = dtype
    else:
        elem_spec = list_literal_elem_spec(elements, scope, ctx)
    if elem_spec is None:
        raise SyntaxError(
            "il_codegen: khong suy duoc dtype PHAN TU cho list-literal o vi tri "
            "bieu thuc (khong co ngu canh kieu tu noi dung, va noi dung vuot "
            "pham vi suy kieu) - gan ra 1 bien co khai bao kieu truoc.")
    # Sanity check (Minor 1, re-review round 2 2026-08-19): `dtype` NGU
    # CANH duoc TIN TUONG hoan toan o tren - neu no lech voi noi dung
    # literal that (vd '[1.5, 2.5]' o vi tri can 'list[i32]') thi IL sinh
    # ra sai va loi chi lo ra o tang toolchain tho ('ilasm.exe that bai').
    # Chan SOM truong hop de gap+de nhan biet nhat: phan tu la hang so
    # THUC nhung ngu canh doi kieu NGUYEN.
    if elem_spec in ('i32', 'i64', 'int'):
        for el in elements:
            if _literal_dtype_fallback(el) in ('f32', 'f64'):
                raise SyntaxError(
                    f"il_codegen: list-literal chua hang so thuc ({el[1]!r}) nhung ngu "
                    f"canh doi kieu phan tu nguyen '{elem_spec}' - sua khai bao kieu "
                    f"(vd 'list[f64]') hoac dung hang so nguyen.")
    list_type = _il_list_of(elem_spec, (ctx or {}).get('records'),
                             (ctx or {}).get('extern_class_defs'))
    out.append(f'    newobj instance void {list_type}::.ctor()')
    for el in elements:
        out.append('    dup')
        ctx['compile_expr'](el, scope, out, elem_spec, ctx)
        out.append(f'    callvirt instance void {list_type}::Add(!0)')


def find_first_append_dtype(stmts, name, infer_scope, ctx, kind='list_append'):
    """Tim LAN GOI '.append(...)' (hoac '.add(...)' cho set, `kind=
    'set_add'`) DAU TIEN tren list/set `name` (duyet CA cay, ke ca long
    trong for/if/while) va suy dtype phan tu tu gia tri do - can THIET
    vi 'lst = []'/'s = set()' KHONG mang thong tin dtype (giu dung cu
    phap Python that, khong bia syntax rieng). Best-effort: neu gia tri
    tham chieu bien CHUA duoc khai bao (tham chieu xuoi hiem gap), tra
    ve None (caller se fallback ve body_dtype). Dung ctx['infer_dtype']/
    ctx['contains_float_literal']/ctx['int_dtypes'] (tiem tu core - xem
    _fpp_ctx trong il_codegen.py) vi suy dtype la logic core, KHONG the
    import truc tiep (circular import)."""
    func_table, records = ctx.get('func_table'), ctx.get('records')
    for stmt in stmts:
        if stmt['kind'] == kind and stmt['name'] == name:
            try:
                # record_methods (2026-08-03): thieu no thi
                # 'toks.append(lx.next_tok())' KHONG suy duoc kieu tra ve
                # cua method record -> roi ve body_dtype (vd 'str') ->
                # list bi khai bao List<string> trong khi THAT SU chua
                # record. Cung LOAI bug voi 2 ghi chu ben duoi.
                d = ctx['infer_dtype'](stmt['value_node'], infer_scope, func_table, records,
                                       ctx.get('record_methods'))
            except KeyError:
                return None
            # Bug that tim thay 2026-07-28 (giong het loai da vay cho
            # 'compare'/dict): '.append(i * 1.0)' voi 'i' la bien i32 va
            # '1.0' la hang so float LONG trong 1 binop - infer_dtype
            # short-circuit tren 'i' truoc, bo lo hang so float, khien
            # list bi khai bao List<i32> thay vi List<f32> -> codegen
            # sau do ep '1.0' thanh 'ldc.i4 1.0' (loi cu phap ILASM that).
            if d in ctx['int_dtypes'] and ctx['contains_float_literal'](stmt['value_node']):
                d = 'f32'
            # Bug that KHAC tim thay 2026-07-29 (giong het loai da vay cho
            # dict-value, xem _infer_literal_dtype trong il_codegen.py):
            # '.append(1)' voi '1' la hang so KHONG dtype co dinh (infer_dtype
            # tra None co y) trong 1 HAM TRA VE 'str' (vd dumps_int_list()
            # -> "str") truoc day roi thang ve ctx['body_dtype']='str' ->
            # IL_LDC_OP['str'] KeyError luc codegen (khong co ma lenh 'ldc'
            # cho string). Thu doan CHINH cu phap hang so (co dau '.' hay
            # khong) TRUOC KHI roi vao body_dtype.
            return d or ctx['infer_literal_dtype'](stmt['value_node'])
        for sub_key in ('body', 'else_body'):
            sub = stmt.get(sub_key)
            if sub:
                found = find_first_append_dtype(sub, name, infer_scope, ctx, kind)
                if found:
                    return found
    return None


def find_first_append_elem_ta(stmts, name, infer_scope, kind='list_append'):
    """Container long nhau (Wave 2, 2026-07-29): giong find_first_append_dtype
    nhung tra ve TypeAnn DAY DU cua gia tri append/add DAU TIEN, CHI khi
    gia tri do la 1 BIEN tham chieu THANG 1 container KHAC (list/dict) -
    dung de declare_list biet phan tu cua 'lst' co phai CHINH NO la 1
    List/Dict khac hay khong (khong the bieu dien bang 1 dtype string
    don nhu truong hop vo huong/record). Tra None khi khong tim thay HOAC
    gia tri DAU TIEN khong phai container (khi do find_first_append_dtype
    (goi RIENG, khong o day) xu ly truong hop vo huong/record nhu cu).

    GIOI HAN THU TU DA BIET (xac nhan qua test that): bien duoc THAM
    CHIEU (vd 'inner' trong 'outer.append(inner)') PHAI duoc khai bao
    ('inner = []'/'inner = {}') o dong VAN BAN dung TRUOC dong khai bao
    'outer' - vi infer_scope duoc dien DAN theo thu tu WALK (khong phai
    lookahead toan cuc du ham nay tu no CO quet ca cay `stmts`), giong
    het gioi han da ghi nhan cho dtype khoa cua dict (xem STATUS.md).
    Sai thu tu se khien 'outer' bi suy NHAM thanh list vo huong (KHONG
    bao loi im lang - loi ro rang se lo ra sau o _expr_index khi doc lai
    phan tu, xem il_codegen.py)."""
    for stmt in stmts:
        if stmt['kind'] == kind and stmt['name'] == name:
            vn = stmt['value_node']
            if vn[0] == 'var':
                try:
                    _, _, var_ta = infer_scope[vn[1]]
                except KeyError:
                    return None
                if var_ta.shape in ('list', 'dict'):
                    return var_ta
            return None
        for sub_key in ('body', 'else_body'):
            sub = stmt.get(sub_key)
            if sub:
                found = find_first_append_elem_ta(sub, name, infer_scope, kind)
                if found is not None:
                    return found
    return None


def _params_of_call(call_node, ctx):
    """Danh sach Param cua ham/method ma 'call_node' goi toi (None neu
    khong tra cuu duoc)."""
    func_table = ctx.get('func_table') or {}
    if call_node[0] == 'call':
        sig = func_table.get(call_node[1])
        return sig.params if sig is not None else None
    if call_node[0] == 'method_call':
        record_methods = ctx.get('record_methods') or {}
        try:
            obj_ta = ctx['infer_scope'][call_node[1]][2]
        except KeyError:
            return None
        methods = record_methods.get(obj_ta.dtype) or {}
        sig = methods.get(call_node[2])
        return sig.params if sig is not None else None
    return None


def _scan_nodes_for_arg_use(node, name, ctx):
    """Tim 'name' xuat hien lam DOI SO cua 1 loi goi trong cay bieu thuc
    'node'; tra ve dtype phan tu khai bao cua tham so tuong ung."""
    if not isinstance(node, tuple):
        return None
    if node and node[0] in ('call', 'method_call'):
        args = node[2] if node[0] == 'call' else node[3]
        params = _params_of_call(node, ctx)
        if params is not None:
            for i in range(min(len(args), len(params))):
                a = args[i]
                if isinstance(a, tuple) and a[0] == 'var' and a[1] == name:
                    ta = params[i].type_ann
                    if ta is not None and ta.shape == 'list':
                        return ta.dtype
    for sub in node:
        if isinstance(sub, tuple):
            found = _scan_nodes_for_arg_use(sub, name, ctx)
            if found:
                return found
        elif isinstance(sub, list):
            for item in sub:
                found = _scan_nodes_for_arg_use(item, name, ctx)
                if found:
                    return found
    return None


def _elem_dtype_from_arg_use(stmts, name, ctx):
    """Duyet CA cay cau lenh, tim lan dau 'name' duoc TRUYEN lam doi so
    cho 1 ham/method co khai bao tham so 'list[T]' -> tra ve T."""
    for stmt in stmts:
        for key in ('rhs_node', 'expr_node', 'value_node', 'call_node', 'cond_node'):
            node = stmt.get(key)
            if node is not None:
                found = _scan_nodes_for_arg_use(node, name, ctx)
                if found:
                    return found
        for sub_key in ('body', 'else_body', 'finally_body'):
            sub = stmt.get(sub_key)
            if sub:
                found = _elem_dtype_from_arg_use(sub, name, ctx)
                if found:
                    return found
        for _exc, handler_body in stmt.get('handlers') or []:
            found = _elem_dtype_from_arg_use(handler_body, name, ctx)
            if found:
                return found
    return None


def _has_append_stmt(stmts, name, kind):
    """Co bat ky '<name>.append(...)' / '<name>.add(...)' nao trong cay
    cau lenh khong - phan biet 'container rong suot doi' (kieu phan tu
    khong quan sat duoc VA khong anh huong gi) voi 'co manh moi nhung
    chua suy duoc' (phai hoan lai hoac bao loi)."""
    for stmt in stmts:
        if stmt['kind'] == kind and stmt.get('name') == name:
            return True
        for sub_key in ('body', 'else_body', 'finally_body'):
            sub = stmt.get(sub_key)
            if sub and _has_append_stmt(sub, name, kind):
                return True
        for _exc, handler_body in stmt.get('handlers') or []:
            if _has_append_stmt(handler_body, name, kind):
                return True
    return False


def declare_list(name, ctx):
    """FIRST_PASS_WALK helper: khai bao local List<T> - dtype phan tu suy
    tu find_first_append_dtype. `ctx` o day la walk_ctx (xem il_codegen.py
    _first_pass_collect_locals) - CHUA them 'infer_dtype'/'contains_float_literal'/
    'int_dtypes'/'stmts' (tiem lien tu core, xem noi goi ham nay).

    Wave 2 (2026-07-29): thu tim container long nhau TRUOC (xem
    find_first_append_elem_ta) - neu lan '.append(...)' DAU TIEN tren
    'name' la 1 bien list/dict khac, 'name' tro thanh List<List<T>>/
    List<Dict<K,V>> (elem_ta = TypeAnn DAY DU cua bien do); nguoc lai
    (append gia tri vo huong/record nhu cu) roi ve nhanh CU khong doi."""
    declared_names = ctx['declared_names']
    if name in declared_names:
        return
    hint = (ctx.get('container_arg_hints') or {}).get(name)
    if hint is not None and hint.shape == 'list' and hint.elem_ta is None:
        # Chu thich TUONG MINH (tham so cua ham duoc goi, hoac kieu tra ve
        # cua chinh ham nay) thang phong doan tu lan '.append()' dau tien -
        # xem _container_arg_hints trong il_codegen.py. Chi ap dung cho
        # list phan tu VO HUONG (elem_ta None): container long nhau van do
        # find_first_append_elem_ta lo, no chinh xac hon.
        declared_names.add(name)
        ctx['locals_decl'].append((name, hint))
        ctx['infer_scope'].set(name, hint)
        return
    nested_ta = find_first_append_elem_ta(ctx['stmts'], name, ctx['infer_scope'])
    if nested_ta is not None:
        ta = ctx['TypeAnn']('__nested__', 'list', elem_ta=nested_ta)
    else:
        elem_dtype = (find_first_append_dtype(ctx['stmts'], name, ctx['infer_scope'], ctx)
                      # 2026-08-03: list KHONG duoc append trong CHINH ham
                      # nay ma chi TRUYEN cho ham/method khac ('vals = []'
                      # roi 'store.assign(names, vals, ...)') - suy kieu
                      # phan tu tu KHAI BAO THAM SO cua noi nhan. Truoc
                      # day roi thang ve body_dtype -> List<string> cho 1
                      # list THAT SU chua so, sai am tham.
                      or _elem_dtype_from_arg_use(ctx['stmts'], name, ctx))
        if elem_dtype is None and not _has_append_stmt(ctx['stmts'], name, 'list_append'):
            # KHONG co '.append(...)' nao trong ca ham -> list RONG suot
            # doi (vd 'lst = []' roi 'json_dumps(lst)'): kieu phan tu
            # khong the quan sat duoc VA cung khong anh huong ket qua.
            # Chon 1 kieu trung tinh thay vi doan theo kieu tra ve cua ham.
            elem_dtype = 'i32'
        if elem_dtype is None and not ctx.get('final_pass'):
            # Manh moi co the nam o 1 bien khai bao SAU (vd bien vong lap)
            # - hoan lai, thu lai sau khi di het than ham.
            ctx['defer'](lambda: declare_list(name, ctx))
            return
        if elem_dtype is None:
            raise SyntaxError(
                f"il_codegen: khong suy duoc kieu PHAN TU cua list {name!r} - hay cho 1 "
                f"manh moi ('{name}.append(<gia tri co kieu ro rang>)' truoc, hoac truyen "
                f"'{name}' cho 1 ham co khai bao tham so 'list[...]'). TRUOC 2026-08-03 cho "
                f"nay am tham lay kieu TRA VE cua ham dang bien dich - nguon cua 5 bug sai "
                f"am tham trong 1 phien.")
        ta = ctx['TypeAnn'](elem_dtype, 'list')
    declared_names.add(name)
    ctx['locals_decl'].append((name, ta))
    ctx['infer_scope'].set(name, ta)


def fpw_assign_list_new(stmt, ctx):
    declare_list(stmt['name'], ctx)


def declare_list_literal(name, elements, ctx):
    """FIRST_PASS_WALK helper: khai bao local List<T> cho 'xs = [3, 1, 2]'
    (Giai doan 0.1, 2026-08-03) - dtype phan tu suy THANG tu chinh cac
    phan tu literal (KHONG can quet '.append()' sau do nhu declare_list).
    Widen ve float NEU BAT KY phan tu nao la float (Python that: [1, 2.0]
    la list[float]) - giong het logic widen da co cho '.append()' dau
    tien trong find_first_append_dtype."""
    declared_names = ctx['declared_names']
    if name in declared_names:
        return
    declared_names.add(name)
    infer_scope = ctx['infer_scope']
    hint = (ctx.get('container_arg_hints') or {}).get(name)
    if hint is not None and hint.shape == 'list':
        # Chu thich cua ham nhan thang phong doan tu hang so - xem
        # _container_arg_hints trong il_codegen.py.
        ctx['locals_decl'].append((name, hint))
        infer_scope.set(name, hint)
        return
    elem_dtype = None
    elem_ta = None
    TypeAnn = ctx['TypeAnn']
    for el in elements:
        # NGUON SU THAT DUY NHAT ve suy kieu phan tu, dung CHUNG voi
        # codegen_expr_list_literal (final-review C1, 2026-08-19) - phan
        # tu la 1 container-literal LONG NHAU (vd 'grid = [[1,2],[3,4]]' hoac
        # 'rows = [{"n": 1}]') tra ve chuoi MANG SHAPE, chuyen thanh TypeAnn
        # day du lam elem_ta cua phan tu nay.
        d = list_literal_elem_spec_of(el, infer_scope, ctx)
        # 2026-09-29: chay qua is_container_spec (thay vi kiem 'list[' rieng)
        # va dung chung 1 ham chuyen spec -> TypeAnn cho ca list/dict/set.
        # Truoc day chi 'list[' duoc tach o day, nen `rows = [{"n": 1}]` suy
        # ra elem_dtype=None -> khai List<Tao rong> va bien dich that bai o
        # buoc Add.
        d_ta = ta_from_spec(d, TypeAnn) if is_container_spec(d) else None
        if elem_dtype is None or (elem_dtype not in ('f32', 'f64') and d in ('f32', 'f64')):
            elem_dtype = d
            elem_ta = d_ta
    if elem_ta is not None:
        ta = TypeAnn(elem_ta.dtype, 'list', elem_ta=elem_ta)
    else:
        ta = TypeAnn(elem_dtype, 'list')
    ctx['locals_decl'].append((name, ta))
    ctx['infer_scope'].set(name, ta)


def fpw_assign_list_literal(stmt, ctx):
    declare_list_literal(stmt['name'], stmt['elements'], ctx)
    for el in stmt['elements']:
        ctx['collect_ternary_temps'](el)


def codegen_assign_list_literal(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 'xs = [3, 1, 2]' (Giai doan 0.1, 2026-08-03) -
    tai dung 100% codegen_assign_list_new (newobj + store) roi codegen_list_append
    tung phan tu (tuong duong 'xs = []' + N lan '.append()'), khong viet
    lai logic newobj/Add rieng - dung nguyen tac DRY."""
    # BUG-3 guard (2026-09-20): gan lai list literal len local list DA
    # khai phan tu int-family ma chua phan tu FLOAT -> bao loi ro rang
    # (huong nguoc widen f64 <- int la an toan, van giu). Lan gan DAU
    # TIEN khong bao gio fire vi dtype khai suy chinh tu cac phan tu do.
    _retype_check = ctx.get('check_list_retype')
    if _retype_check is not None:
        try:
            _retype_check(stmt['name'], scope[stmt['name']][2], stmt['elements'], scope, ctx)
        except KeyError:
            pass
    codegen_assign_list_new(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn)
    for el in stmt['elements']:
        codegen_list_append({'kind': 'list_append', 'name': stmt['name'], 'value_node': el},
                             scope, body, body_dtype, ctx, sig, codegen_stmts_fn)


def fpw_list_append(stmt, ctx):
    ctx['collect_ternary_temps'](stmt['value_node'])


_LIST_REMOVE_RE = re.compile(r'^(\w+)\.remove\((.+)\)\s*$')
_LIST_INSERT_RE = re.compile(r'^(\w+)\.insert\(\s*(.+?)\s*,\s*(.+)\s*\)\s*$')


def try_parse_list_remove(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    """LINE_PARSERS entry: 'lst.remove(x)' - PHAI dang ky TRUOC
    method_call_stmt (pattern method-call tong quat cung khop dong nay),
    giong list_append. 2026-07-29 (Huong A stdlib mo rong, khi them
    set.remove() o set_methods_batch2.py): them dieu kien loai tru
    known_shapes=='set' - regex 'x.remove(...)' giong het set.remove(),
    NEU KHONG loai tru se cuop mat luon moi loi goi set.remove() (LINE_PARSERS
    la list thu THEO THU TU dang ky, file nay import TRUOC nen luon thang
    neu khong co dieu kien nay)."""
    m = _LIST_REMOVE_RE.match(line)
    if not m:
        return None
    _nm = m.group(1)
    _sh = known_shapes.get(_nm)
    if _sh is not None and _sh != 'list':
        # R4/D6: nhu try_parse_list_append - record/str/dict/set... co method
        # 'remove' rieng, khong duoc cuop boi List.Remove.
        return None
    if _sh in ('set', 'frozenset', 'bytearray'):
        return None
    name, arg_expr = m.groups()
    return {'kind': 'list_remove', 'name': name, 'value_node': parse_expr(arg_expr)}, pos + 1


def codegen_list_remove(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 'lst.remove(x)' - xoa phan tu DAU TIEN khop
    gia tri x. GIOI HAN DA BIET: Python list.remove() nem ValueError neu
    khong tim thay x; .NET List<T>.Remove(T) chi tra ve bool (khong nem
    loi) - o day CHAP NHAN hanh vi .NET (bo qua gia tri bool tra ve qua
    'pop'), KHONG gia lap ValueError."""
    _, _, ta = scope[stmt['name']]
    if ta.shape == 'record':
        if _record_stmt_fallback(stmt['name'], 'remove', [stmt['value_node']],
                                 scope, body, ctx):
            return
    if ta.shape is not None and ta.shape != 'list':
        raise SyntaxError(
            f"il_codegen: '{stmt['name']}.remove(...)' - '{stmt['name']}' co "
            f"shape={ta.shape!r} dtype={ta.dtype!r}, khong phai list")
    reject_if_nested_container_elem(ta, 'list.remove')
    ctx['load_var_ref'](stmt['name'], scope, body)
    ctx['compile_expr'](stmt['value_node'], scope, body, ta.dtype, ctx)
    body.append(f'    callvirt instance bool {ctx["il_type_str"](ta, ctx.get("records"))}::Remove(!0)')
    body.append('    pop')


def fpw_list_remove(stmt, ctx):
    ctx['collect_ternary_temps'](stmt['value_node'])


def try_parse_list_insert(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    """LINE_PARSERS entry: 'lst.insert(i, x)' - PHAI dang ky TRUOC
    method_call_stmt, giong list_append/list_remove."""
    m = _LIST_INSERT_RE.match(line)
    if not m:
        return None
    _nm = m.group(1)
    _sh = known_shapes.get(_nm)
    if _sh is not None and _sh != 'list':
        # R4/D6 (2026-09-22, bug P0): 'edit.insert(lines, ch)' tren record
        # bi cuop thanh List<T>.Insert(int32, !0) -> MissingMethodException
        # luc chay. Record co shape 'record' trong known_shapes (param) thi
        # tra ve None de roi xuong method_call_stmt.
        return None
    if _sh == 'bytearray':
        return None
    name, idx_expr, val_expr = m.groups()
    return {'kind': 'list_insert', 'name': name, 'index_node': parse_expr(idx_expr),
            'value_node': parse_expr(val_expr)}, pos + 1


def codegen_list_insert(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 'lst.insert(i, x)' - List<T>.Insert(int32, !0)."""
    _, _, ta = scope[stmt['name']]
    if ta.shape == 'record':
        # R4/D6 safety net cho record local (parser khong biet kieu local).
        if _record_stmt_fallback(stmt['name'], 'insert',
                                 [stmt['index_node'], stmt['value_node']],
                                 scope, body, ctx):
            return
    if ta.shape is not None and ta.shape != 'list':
        raise SyntaxError(
            f"il_codegen: '{stmt['name']}.insert(...)' - '{stmt['name']}' co "
            f"shape={ta.shape!r} dtype={ta.dtype!r}, khong phai list")
    ctx['load_var_ref'](stmt['name'], scope, body)
    ctx['compile_expr'](stmt['index_node'], scope, body, 'i32', ctx)
    ctx['compile_expr'](stmt['value_node'], scope, body, ta.dtype, ctx)
    body.append(f'    callvirt instance void {ctx["il_type_str"](ta, ctx.get("records"))}::Insert(int32, !0)')


def fpw_list_insert(stmt, ctx):
    ctx['collect_ternary_temps'](stmt['index_node'])
    ctx['collect_ternary_temps'](stmt['value_node'])


# Dang ky vao il_dispatch NGAY LUC MODULE NAP (il_dispatch.py khong phu
# thuoc il_codegen.py nen import truc tiep an toan, khong circular).
register_assign_rhs_parser('list_literal', try_rhs_list_literal)
register_line_parser('list_append', try_parse_list_append)
register_line_parser('list_remove', try_parse_list_remove)
register_line_parser('list_insert', try_parse_list_insert)
register_stmt_codegen('assign_list_new', codegen_assign_list_new)
register_stmt_codegen('assign_list_literal', codegen_assign_list_literal)
register_stmt_codegen('list_append', codegen_list_append)
register_stmt_codegen('list_remove', codegen_list_remove)
register_stmt_codegen('list_insert', codegen_list_insert)
register_first_pass_walk('assign_list_new', fpw_assign_list_new)
register_first_pass_walk('assign_list_literal', fpw_assign_list_literal)
register_first_pass_walk('list_append', fpw_list_append)
register_first_pass_walk('list_remove', fpw_list_remove)
register_first_pass_walk('list_insert', fpw_list_insert)
# Gap 2 (Phase 7 follow-up, 2026-08-19): 'list_literal' o VI TRI BIEU THUC
# (long trong 1 list-literal khac) - xem codegen_expr_list_literal.
register_expr_codegen('list_literal', codegen_expr_list_literal)


def push_reserve_builtin(args, scope, out, dtype, ctx):
    """R12 (2026-09-22): reserve(lst, n) - dat truoc List<T>.Capacity = n
    (preallocate, tranh doubling waste ~7MB cho pixel buffer lon - xem
    BENCH.md Phu luc M1/F1). Tra ve capacity moi (i32) de vua dung duoc
    dang lenh doc lap ('reserve(buf, n)' - gia tri bi pop, giong cac
    method container goi doc lap) vua dung duoc trong bieu thuc.

    'lst' PHAI la bien list (shape='list'); 'n' la i32 (co kiem tra neu
    la 'int' qua ToI32 - nem ON AO khi vuot int32). Capacity NHO HON
    Count hien tai: .NET giu nguyen (khong cat) - khong bao loi.
    """
    if len(args) != 2:
        raise SyntaxError("il_codegen: reserve(lst, n) can dung 2 tham so")
    lst_node, n_node = args
    if lst_node[0] != 'var':
        raise SyntaxError(
            "il_codegen: reserve(lst, n) - 'lst' phai la 1 bien list don")
    try:
        _, _, ta = scope[lst_node[1]]
    except (KeyError, SyntaxError):
        raise SyntaxError(
            f"il_codegen: reserve(lst, n) - '{lst_node[1]}' khong phai bien da khai bao")
    if ta.shape != 'list':
        raise SyntaxError(
            f"il_codegen: reserve(lst, n) - '{lst_node[1]}' co shape={ta.shape!r} "
            f"dtype={ta.dtype!r}, khong phai list")
    list_il = ctx['il_type_str'](ta, ctx.get('records'))
    ctx['load_var_ref'](lst_node[1], scope, out)
    ctx['load_var_ref'](lst_node[1], scope, out)
    # 'n' thuong la 'int' (literal/hang so mac dinh) hoac i32: bien dich
    # thang voi dtype i32 (duong _expr_var/_narrow tu ha int -> i32 qua
    # ToI32 co kiem tra). Rieng i64 phai ha thu cong (widen chung khong
    # co nhanh i64->i32).
    n_dtype = ctx['infer_dtype'](n_node, scope, ctx.get('func_table'))
    if n_dtype == 'i64':
        ctx['compile_expr'](n_node, scope, out, 'i64', ctx)
        out.append('    conv.ovf.i4')
    else:
        ctx['compile_expr'](n_node, scope, out, 'i32', ctx)
    out.append(f'    callvirt instance void {list_il}::set_Capacity(int32)')
    out.append(f'    callvirt instance int32 {list_il}::get_Capacity()')


register_expr_builtin('reserve', push_reserve_builtin, 'i32')


def fpw_for_in_call_list(stmt, ctx):
    """FIRST_PASS_WALK cho 'for x in f(...):' khi f tra ve 1 LIST thuong
    (2026-08-03, dot 2) - khai bao 1 local AN giu ket qua loi goi, 1 local
    dem, va bien vong lap."""
    sig = ctx['func_table'][stmt['callee_name']]
    TypeAnn = ctx['TypeAnn']
    ret_ta = sig.return_type
    ctx['declare_named'](f'__forsrc{id(stmt)}', ret_ta)
    ctx['declare_named'](f'__foridx{id(stmt)}', TypeAnn('i32', None))
    # Task 3 review fix thu 4 (extern-class-list, 2026-08-18): doi xung voi
    # declare_scalar/_fpp_assign_scalar (il_codegen.py) - 'for x in f(...):'
    # khi f() tra ve list[HandleType] phai suy shape='extern_class' cho 'x',
    # khong chi biet nhanh 'record'. Thieu nhanh nay -> shape=None ->
    # il_type_str's nhanh shape=None tra IL_SCALAR[dtype] -> KeyError, va
    # 'x.method()'/'x.field' sau do tra cuu SAI (khong dung extern-class).
    extern_class_defs = ctx.get('extern_class_defs')
    if extern_class_defs and ret_ta.dtype in extern_class_defs:
        elem_shape = 'extern_class'
    elif ctx.get('records') and ret_ta.dtype in ctx['records']:
        elem_shape = 'record'
    else:
        elem_shape = None
    ctx['declare_named'](stmt['var'], TypeAnn(ret_ta.dtype, elem_shape))
    for arg_node in stmt['arg_nodes']:
        ctx['collect_ternary_temps'](arg_node)
    ctx['walk_fn'](stmt['body'])


def codegen_for_in_call_list(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN cho 'for x in f(...):' (f tra ve list) - goi ham 1 LAN,
    do ket qua vao 1 local an, roi lap theo chi so nhu 'for x in bien:'."""
    callee = ctx['func_table'][stmt['callee_name']]
    compile_expr = ctx['compile_expr']
    il_type_str = ctx['il_type_str']
    records = ctx.get('records')
    _, src_idx, src_ta = scope[f'__forsrc{id(stmt)}']
    _, idx_idx, _ = scope[f'__foridx{id(stmt)}']
    list_type = il_type_str(src_ta, records)

    for arg_node, p in zip(stmt['arg_nodes'], callee.params):
        # Round 3 (2026-08-19): shape-string convention cho list-literal
        # long nhau lam doi so ('for x in rows([[1,2],[3,4]]):').
        compile_expr(arg_node, scope, body,
                     value_dtype_spec_for_ta(p.type_ann, arg_node), ctx)
    params_il = ', '.join(il_type_str(p.type_ann, records) for p in callee.params)
    class_name = ctx.get('class_name') or 'Program'
    ret_il = il_type_str(callee.return_type, records)
    body.append(f"    call {ret_il} {class_name}::{ctx['il_ident'](stmt['callee_name'])}({params_il})")
    body.append(f'    stloc.s {src_idx}')

    ctx['label_counter'][0] += 1
    n = ctx['label_counter'][0]
    start_lbl = f"{ctx['prefix']}_FCL{n}_start"
    cont_lbl = f"{ctx['prefix']}_FCL{n}_cont"
    end_lbl = f"{ctx['prefix']}_FCL{n}_end"
    body.append('    ldc.i4.0')
    body.append(f'    stloc.s {idx_idx}')
    body.append(f'  {start_lbl}:')
    body.append(f'    ldloc.s {idx_idx}')
    body.append(f'    ldloc.s {src_idx}')
    body.append(f'    callvirt instance int32 {list_type}::get_Count()')
    body.append(f'    bge {end_lbl}')
    body.append(f'    ldloc.s {src_idx}')
    body.append(f'    ldloc.s {idx_idx}')
    body.append(f'    callvirt instance !0 {list_type}::get_Item(int32)')
    ctx['store_var'](stmt['var'], scope, body)
    ctx['loop_stack'].append((cont_lbl, end_lbl))
    codegen_stmts_fn(stmt['body'], scope, body, body_dtype, ctx, sig)
    ctx['loop_stack'].pop()
    body.append(f'  {cont_lbl}:')
    body.append(f'    ldloc.s {idx_idx}')
    body.append('    ldc.i4.1')
    body.append('    add')
    body.append(f'    stloc.s {idx_idx}')
    body.append(f'    br {start_lbl}')
    body.append(f'  {end_lbl}:')


register_stmt_codegen('for_in_call_list', codegen_for_in_call_list)
register_first_pass_walk('for_in_call_list', fpw_for_in_call_list)
