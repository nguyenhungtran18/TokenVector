# -*- coding: utf-8 -*-
"""Kieu IL cua HashSet<T> dong - tach rieng file theo tinh nang
(2026-07-28).

Tu Phase 1 buoc 1 (2026-07-28), file nay CUNG so huu logic parse+codegen
+first-pass rieng cua set (khong chi ham kieu-IL thuan nhu truoc). Cac
ham can goi lai vao core nhan chung qua tham so `ctx` (dictionary duoc
'tiem' san cac ham do - xem gen_il_function trong il_codegen.py) THAY VI
import truc tiep tu il_codegen.py (tranh circular import). Dung chung
`find_first_append_dtype` voi list_type.py (import tu do, khong dinh
nghia lai)."""
import re

from il_core import parse_expr
from il_features.list_type import _has_append_stmt
from il_dispatch import (
    register_assign_rhs_parser, register_line_parser,
    register_stmt_codegen, register_first_pass_walk, register_expr_codegen,
)
from il_features.list_type import (
    il_list_elem_ilstr, find_first_append_dtype, il_container_type_of_spec,
    ta_elem_spec, _split_container_spec,
)


def il_set_type(dtype: str, records: dict = None, extern_class_defs: dict = None) -> str:
    """Kieu IL cua 1 HashSet<T> DONG - xac minh THAT qua probe_hashset.il
    (2026-07-28): HashSet`1 nam trong assembly [System.Core], KHONG PHAI
    [mscorlib] nhu List`1/Dictionary`2 - bug that gap luc probe dau tien
    (TypeLoadException khi de nham [mscorlib]). '.assembly extern
    System.Core' phai duoc khai bao o dau file .il (xem tkv_compile.py).

    `extern_class_defs` (muc P, 2026-08-19): set/frozenset KHONG ho tro
    phan tu la handle type - HashSet<T> dua vao GetHashCode/Equals mac dinh
    (reference equality), rui ro tuong tu handle type lam khoa dict (da bi
    chan cung ly do o Phase 6). Tu choi RO RANG thay vi de roi vao nhanh
    loi chung cua il_list_elem_ilstr."""
    if extern_class_defs and dtype in extern_class_defs:
        raise SyntaxError(
            f"il_codegen: set/frozenset khong ho tro phan tu la handle type "
            f"('{dtype}' da khai qua __tkv_extern_class__) - HashSet<T> dua "
            f"vao GetHashCode/Equals mac dinh (reference equality), rui ro "
            f"tuong tu handle type lam khoa dict (da bi chan cung ly do)")
    return f'class [System.Core]System.Collections.Generic.HashSet`1<{il_list_elem_ilstr(dtype, records)}>'


_SET_NEW_RE = re.compile(r'^set\(\)\s*$')
_SET_ADD_RE = re.compile(r'^(\w+)\.add\((.+)\)\s*$')
_FROZENSET_NEW_RE = re.compile(r'^frozenset\((\w+)\)\s*$')


def compile_in_set(key_node, coll_name, scope, out, ctx):
    """CIL cho 'x in s' (s la set) - tag 'in' cua _compile_expr khi
    coll_ta.shape=='set', xem il_codegen.py's _expr_in.

    2026-09-29: chan them khi phan tu la CONTAINER. `HashSet<T>.Contains`
    so sanh qua EqualityComparer<T>.Default, ma voi T = List`1/... mac dinh
    la SO SANH THAM CHIEU - 1 list-literal moi (newobj tai diem goi) se khong
    bao gio khop du noi dung giong het, ket qua SAI AM THAM. Cung ly do, cung
    kieu chan voi reject_if_nested_container_elem (list) o ben kia."""
    _, _, coll_ta = scope[coll_name]
    if coll_ta.elem_ta is not None:
        raise SyntaxError(
            f"il_codegen: '{coll_name} in ...' - '{coll_name}' la "
            f"{coll_ta.shape} co phan tu la container long nhau, HashSet<T> so sanh "
            f"phan tu container THEO THAM CHIEU (khong theo noi dung), ket qua se sai "
            f"am tham. Chi dem so phan tu (len) hoac duyet bang 'for v in <ten bien>:'")
    ctx['load_var_ref'](coll_name, scope, out)
    ctx['compile_expr'](key_node, scope, out, coll_ta.dtype, ctx)
    set_type = il_set_type(coll_ta.dtype, (ctx or {}).get('records'), (ctx or {}).get('extern_class_defs'))
    out.append(f'    callvirt instance bool {set_type}::Contains(!0)')


def try_rhs_set_new(rhs, name, known_shapes):
    """ASSIGN_RHS_PARSERS entry: 's = set()' - dtype phan tu CHUA biet o
    day, suy sau tu LAN GOI '.add(...)' DAU TIEN, giong het list.append."""
    if not _SET_NEW_RE.match(rhs.strip()):
        return None
    known_shapes[name] = 'set'
    return {'kind': 'assign_set_new', 'name': name}


def try_rhs_frozenset_new(rhs, name, known_shapes):
    """ASSIGN_RHS_PARSERS entry: 'fs = frozenset(lst)' - CHI nhan 1 BIEN
    list DON lam nguon (khong rong, khong bieu thuc phuc tap - gioi han
    cung theo plan 6.8). 'lst' PHAI da duoc khai bao/biet shape='list'
    TRUOC dong nay trong van ban nguon (known_shapes duoc cap nhat DAN
    theo thu tu parse - xem _lp_assign trong il_codegen.py) - neu chua,
    bao loi ro NGAY tai day thay vi de loi kho hieu ve sau."""
    m = _FROZENSET_NEW_RE.match(rhs.strip())
    if not m:
        return None
    src = m.group(1)
    if known_shapes.get(src) != 'list':
        raise SyntaxError(
            f"il_codegen: frozenset({src}) - '{src}' phai la 1 BIEN list DA KHAI BAO "
            f"TRUOC dong nay (dang co known_shapes={known_shapes.get(src)!r}) - frozenset() "
            f"hien CHI ho tro frozenset(<bien_list_don>)")
    known_shapes[name] = 'frozenset'
    return {'kind': 'assign_frozenset_new', 'name': name, 'src': src}


def try_rhs_set_literal(rhs, name, known_shapes):
    """ASSIGN_RHS_PARSERS entry: 's = {1, 2, 3}' (2026-09-28).

    Dung PARSER THAT (tag 'set_literal' trong il_core.py) chu khong tu tach
    dau phay - giong het try_rhs_list_literal, nen phan tu long nhau va
    dau phay duoi cuoi deu tu xử lý.

    Node 'set_literal' chi sinh ra khi KHONG co ':' (la set); co ':' thi
    il_core.py bao loi dict literal ngay tai do. 'set' rong la 'set()',
    nen khong co dang rong o day.
    """
    rhs_s = rhs.strip()
    if not (rhs_s.startswith('{') and rhs_s.endswith('}')):
        return None
    node = parse_expr(rhs_s)
    if node[0] != 'set_literal':
        return None
    known_shapes[name] = 'set'
    return {'kind': 'assign_set_literal', 'name': name, 'elements': node[1]}


def declare_set_literal(name, elements, ctx):
    """FIRST_PASS_WALK helper: khai bao local HashSet<T> cho 's = {1, 2, 3}'.
    dtype phan tu suy THANG tu chinh cac phan tu (khong can quet '.add()' sau
    do, giong declare_list_literal). Widen ve float neu bat ky phan tu nao
    la float - cung logic voi list."""
    declared_names = ctx['declared_names']
    if name in declared_names:
        return
    declared_names.add(name)
    # PHAI xet container_arg_hints TRUOC khi suy tu phan tu - y het
    # declare_set (va declare_list_literal). Thieu buoc nay thi
    # 'def f(s: "set[i32]")' roi 'x = {1, 2}; f(x)' khai HashSet<TkvInt> (i64)
    # trong khi tham so la set[i32] -> khong khop, va call site sinh
    # 'TkvInt::ToI32' tren CHINH con set (khong phai phan tu) -> CLR nem
    # OverflowException luc CHAY, khong bao loi bien dich. Do do ca
    # 's = set(); s.add(1)' va 's = {1}' phai ra CUNG kieu.
    hint = (ctx.get('container_arg_hints') or {}).get(name)
    if hint is not None and hint.shape == 'set':
        ctx['locals_decl'].append((name, hint))
        infer_scope_set(ctx, name, hint)
        return
    from il_features.list_type import (list_literal_elem_spec_of, is_container_spec,
                                       ta_from_spec)
    infer_scope = ctx['infer_scope']
    TypeAnn = ctx['TypeAnn']
    elem_dtype = None
    elem_ta = None
    for el in elements:
        d = list_literal_elem_spec_of(el, infer_scope, ctx)
        # 2026-09-29 (literal long nhau): phan tu la container
        # (`ss = {[1,2],[3,4]}`) thi can `elem_ta` day du - il_type_str chi
        # de quy qua elem_ta. Giu nguyen nhanh scalar (elem_ta=None) vi moi
        # set co phan tu container moi co the xuat hien tu day.
        d_ta = ta_from_spec(d, TypeAnn) if is_container_spec(d) else None
        if elem_dtype is None or (elem_dtype not in ('f32', 'f64') and d in ('f32', 'f64')):
            elem_dtype = d
            elem_ta = d_ta
    if elem_ta is not None:
        ta = TypeAnn(elem_ta.dtype, 'set', elem_ta=elem_ta)
    else:
        ta = TypeAnn(elem_dtype, 'set')
    ctx['locals_decl'].append((name, ta))
    infer_scope.set(name, ta)


def infer_scope_set(ctx, name, ta):
    ctx['infer_scope'].set(name, ta)


def fpw_assign_set_literal(stmt, ctx):
    declare_set_literal(stmt['name'], stmt['elements'], ctx)
    for el in stmt['elements']:
        ctx['collect_ternary_temps'](el)


def _emit_set_literal(elements, set_il_type, body, ctx, scope, elem_dtype):
    """newobj HashSet<T> roi .Add() tung phan tu. Ket qua CUOI CUNG giu tren
    stack - caller quyet dinh 'store' (gan bien) hay 'bo' (gia tri bieu thuc).

    Dung 'dup' de giu lai 1 ban cua set cho moi lan Add thay vi nap lai bien:
    set vua 'newobj' con nam tren stack, nen chi can 1 'dup' cho moi phan tu
    va ket thuc van con 1 ban de lam ket qua.
    """
    body.append(f'    newobj instance void {set_il_type}::.ctor()')
    for el in elements:
        body.append('    dup')
        ctx['compile_expr'](el, scope, body, elem_dtype, ctx)
        body.append(f'    callvirt instance bool {set_il_type}::Add(!0)')
        body.append('    pop')


def _set_literal_elem_dtype(elements, scope, ctx):
    from il_features.list_type import list_literal_elem_spec_of
    elem_dtype = None
    for el in elements:
        d = list_literal_elem_spec_of(el, scope, ctx)
        if elem_dtype is None or (elem_dtype not in ('f32', 'f64') and d in ('f32', 'f64')):
            elem_dtype = d
    return elem_dtype


def codegen_assign_set_literal(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 's = {1, 2, 3}'.

    KHONG co dang inline ('len({1,2,3})' / 'x in {1,2,3}') - ca hai deu bi
    chan boi han che CO SAN, khong phai do set literal:
      - 'len(<bieu thuc>)' bao "khong suy duoc hinh dang cua bieu thuc"
      - 'x in <bieu thuc>' bao "chi ho tro ... 1 bien dict/set/list/chuoi don"
    Da thu viet EXPR_CODEGEN cho dang inline roi BO - khong test duoc, va
    code khong toi duong la noi rut de rot. Neu sau nay 'len'/'in' chap nhan
    bieu thuc, day la cho can mo lai. Xem REPOSITORY-NOTES.

    2026-09-29: them xem codegen_expr_set_literal cho PHAI TU long trong
    container khac - dang statement o day giu ket qua roi 'store_var'.
    Kieu IL lay bang `ctx['il_type_str']` (nhanh shape='set' cua no de quy
    qua `elem_ta` roi giao nguyen ve `il_set_type` khi phan tu vo huong, va
    do giu guard handle-type) - giong het 2 dong khai `lst = [...]`/
    `d = {...}`, nen 3 loai container chi 1 noi quyet dinh kieu."""
    name = stmt['name']
    _, _, ta = scope[name]
    set_il = ctx['il_type_str'](ta, ctx.get('records'))
    _emit_set_literal(stmt['elements'], set_il, body, ctx, scope, ta_elem_spec(ta))
    ctx['store_var'](name, scope, body)


def codegen_expr_set_literal(node, scope, out, dtype, ctx=None):
    """EXPR_CODEGEN entry: '{1, 2, 3}' o VI TRI BIEU THUC (2026-09-29,
    literal long nhau) - giong het codegen_expr_list_literal (list_type.tkv)
    nhung cho set.

    THIEU nhanh nay la 1 trong 2 nguyen nhan doc lap cua
    Testkit/nested_literal_test: node 'set_literal' chi co 1 duong xu ly -
    `s = {...}` (try_rhs_set_literal + codegen_assign_set_literal, ca 2 o
    tang STATEMENT). Khong duoc dang ky trong EXPR_CODEGEN nen khi no xuat
    hien LONG trong 1 bieu thuc khac (la phan tu cua list khac, vi du
    `ls = [{1, 2}]`) `_compile_expr` nem "AST node khong ro".

    `_emit_set_literal` (dung chung voi dang statement) giu ket qua CUOI
    CUNG tren stack - ham nay khong them gi vao cuoi nen ket qua cua 1 set
    literal long nhau la dung gia tri bieu thuc (giong newobj cua
    codegen_expr_list_literal).

    `dtype` la NGU CANH: chuoi spec 'set[T]' (khi phan tu cua container
    khac) hoac dtype cua phan tu."""
    elements = node[1]
    split = _split_container_spec(dtype)
    if split is not None:
        if split[0] != 'set':
            raise SyntaxError(
                f"il_codegen: set-literal '{{...}}' o vi tri can kieu {dtype!r} - "
                f"ngu canh kieu {split[0]}[...], khong phai set")
        elem_spec = split[1]
    elif dtype is not None:
        elem_spec = dtype
    else:
        elem_spec = _set_literal_elem_dtype(elements, scope, ctx)
    if elem_spec is None:
        raise SyntaxError(
            "il_codegen: khong suy duoc dtype PHAN TU cho set-literal o vi tri "
            "bieu thuc (khong co ngu canh kieu tu noi dung, va noi dung vuot pham vi "
            "suy kieu) - gan ra 1 bien co khai bao kieu truoc.")
    records = (ctx or {}).get('records')
    set_il = il_container_type_of_spec(f'set[{elem_spec}]', records,
                                       (ctx or {}).get('extern_class_defs'))
    _emit_set_literal(elements, set_il, out, ctx, scope, elem_spec)


def try_parse_set_add(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    """LINE_PARSERS entry: 's.add(x)' - PHAI dang ky TRUOC method_call_stmt
    (pattern method-call tong quat cung khop dong nay)."""
    m = _SET_ADD_RE.match(line)
    if not m:
        return None
    name, arg_expr = m.groups()
    return {'kind': 'set_add', 'name': name, 'value_node': parse_expr(arg_expr)}, pos + 1


def codegen_assign_set_new(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 's = set()'."""
    _, _, ta = scope[stmt['name']]
    body.append(f'    newobj instance void {il_set_type(ta.dtype, ctx.get("records"), ctx.get("extern_class_defs"))}::.ctor()')
    ctx['store_var'](stmt['name'], scope, body)


def codegen_assign_frozenset_new(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 'fs = frozenset(lst)' - HashSet<T>(IEnumerable<T>)
    dien san tu 'lst' (xac nhan THAT qua PowerShell reflection, Step 1 cua
    plan 6.8/frozenset) - phan tu trung lap trong 'lst' tu dong bi loai
    (ban chat HashSet). BAT BIEN sau khi tao: khong co duong codegen nao
    khac ghi lai vao 'fs' (.add()/.remove()/.discard() bi chan o guard
    rieng, xem codegen_set_add/_codegen_set_remove_like)."""
    _, _, ta = scope[stmt['name']]
    ctx['load_var_ref'](stmt['src'], scope, body)
    body.append(
        f'    newobj instance void {il_set_type(ta.dtype, ctx.get("records"), ctx.get("extern_class_defs"))}::.ctor(class '
        f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    ctx['store_var'](stmt['name'], scope, body)


def codegen_set_add(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 's.add(x)' - HashSet<T>.Add(T) tra ve bool
    (khac List<T>.Add(T) la void, xac minh THAT qua probe_hashset.il) -
    can 'pop' bo ket qua khi dung nhu 1 lenh doc lap (khong gan bien)."""
    _, _, ta = scope[stmt['name']]
    if ta.shape == 'frozenset':
        raise SyntaxError(
            f"il_codegen: '{stmt['name']}' la frozenset (bat bien) - khong the .add()")
    ctx['load_var_ref'](stmt['name'], scope, body)
    ctx['compile_expr'](stmt['value_node'], scope, body, ta.dtype, ctx)
    body.append(f'    callvirt instance bool {il_set_type(ta.dtype, ctx.get("records"), ctx.get("extern_class_defs"))}::Add(!0)')
    body.append('    pop')


def declare_set(name, ctx):
    """FIRST_PASS_WALK helper: khai bao local HashSet<T> - dtype phan tu
    suy tu find_first_append_dtype(kind='set_add'). `ctx` o day la walk_ctx
    (xem il_codegen.py _first_pass_collect_locals), can them 'stmts'/
    'infer_dtype'/'contains_float_literal'/'int_dtypes'/'TypeAnn' (tiem
    tu core)."""
    declared_names = ctx['declared_names']
    if name in declared_names:
        return
    hint = (ctx.get('container_arg_hints') or {}).get(name)
    if hint is not None and hint.shape == 'set' and hint.elem_ta is None:
        # Chu thich TUONG MINH thang phong doan tu gia tri dau tien - xem
        # _container_arg_hints trong il_codegen.py.
        declared_names.add(name)
        ctx['locals_decl'].append((name, hint))
        ctx['infer_scope'].set(name, hint)
        return
    elem_dtype = find_first_append_dtype(
        ctx['stmts'], name, ctx['infer_scope'], ctx, kind='set_add')
    if elem_dtype is None and not _has_append_stmt(ctx['stmts'], name, 'set_add'):
        elem_dtype = 'i32'          # set RONG suot doi - xem declare_list
    if elem_dtype is None and not ctx.get('final_pass'):
        ctx['defer'](lambda: declare_set(name, ctx))
        return
    if elem_dtype is None:
        raise SyntaxError(
            f"il_codegen: khong suy duoc kieu PHAN TU cua set {name!r} - hay goi "
            f"'{name}.add(<gia tri co kieu ro rang>)' truoc. TRUOC 2026-08-03 cho nay am "
            f"tham lay kieu TRA VE cua ham dang bien dich (nguon cua 5 bug sai am tham).")
    ta = ctx['TypeAnn'](elem_dtype, 'set')
    declared_names.add(name)
    ctx['locals_decl'].append((name, ta))
    ctx['infer_scope'].set(name, ta)


def _set_name_under_range_len(bound_node, infer_scope):
    """Ten bien SET dang duyet o dang 'for i in range(len(<ten>)):' - tra ve
    None neu co hinh dang khac, hoac `<ten>` khong phai set/frozenset trong
    `infer_scope`.

    Day CHINH LA dang text ma macro `for_in_list` (control_flow.tkv) sinh ra
    cho 'for v in <ten>:' - nhan dang nao ma chinh macro do da lo ra nhanh
    `to_list()` rieng, nen o day khong khop (nguon do la 1 list, khong phai
    set) va ta khong can lam gi.

    `bound_node` KHONG con 'range' bao ngoai: line-parser cua vong lap
    (try_parse_for) rut luon lop 'range(...)' 1 tham so - `for i in range(n):`
    va `for i in n:` cung ra 1 node bound. Vi du `len(ks)` cua rang buoc
    `range(len(ks))` do macro sinh ra den day la node 'call'/'len' truc
    tiep."""
    node = bound_node
    if (isinstance(node, tuple) and node[0] == 'call'
            and node[1] == 'range' and len(node[2]) == 1):
        node = node[2][0]
    if not (isinstance(node, tuple) and node[0] == 'call'
            and node[1] == 'len' and len(node[2]) == 1):
        return None
    arg = node[2][0]
    if not (isinstance(arg, tuple) and arg[0] == 'var'):
        return None
    try:
        _, _, ta = infer_scope[arg[1]]
    except (KeyError, TypeError):
        return None
    if getattr(ta, 'shape', None) not in ('set', 'frozenset'):
        return None
    return arg[1]


def _body_indexes(stmt_list, name):
    """Cac cau lenh trong `stmt_list` co dang '<bien> = <name>[<chi so>]' -
    chinh la dang macro sinh ra de gan phan tu vao bien vong lap. Chi quet
    CAP CUNG (khong de quy vao vong lap con): ben trong vong lap con, bien
    vong lap la bien rieng, nen `<name>` o do la 1 bien khac.

    Node 'index' luu TEN BIEN o `node[1]` dang CHUOI (khong phai node
    ('var', ten) nhu cac bieu thuc khac) - xem _expr_index cua
    il_codegen.tkv."""
    return [s for s in stmt_list
            if s.get('kind') == 'assign_scalar'
            and isinstance(s.get('rhs_node'), tuple)
            and s['rhs_node'][0] == 'index'
            and s['rhs_node'][1] == name]


def plan_set_iter_index_loop(stmt, ctx):
    """FIRST_PASS helper cho vong lap duyet set ma macro TEXT-LEVEL khong
    nhin ra (2026-09-29).

    VAN DE: 'for v in s:' duoc mo rong THANH VAN BAN thanh
    'for i in range(len(s)): v = s[i]'. Nhanh set cua macro chi bat khi ten
    `s` bi QUET TRUOC o tang VAN BAN (`s = set()`/`s = {...}`/tham so/ham tra
    ve set - xem _expand_macros cua il_codegen.tkv). Mot bien set sinh RA
    giua chung, vi du do doc ra tu dict literal co gia tri la set
    (`ks = ds["k"]`), khong bao gio xuat hien trong van ban goc nen macro
    viet nham thanh duyet qua index - `HashSet<T>` khong co indexer nen bao
    loi "'s[...]' - 's' la set".

    SUA O DAY (tang first-pass, noi CO kieu): nhan ra mau
    'for i in range(len(s)):' voi `s` la set trong `infer_scope`, roi dua
    phan 'v = s[i]' sang 1 local AN la ban `to_list()` cua `s` (khai 1 LAN
    truoc vong lap, khong phai moi vong lap - neu chi doi `s[i]` thanh
    `s.to_list()[i]` thi to_list() chay O(n) LAN, n^2 cho ca vong lap).
    `len(s)` giu nguyen tren chinh HashSet (get_Count) nen chi can sua
    phan doc phan tu.

    KHONG sua gi khi `s` la list/dict (macro da viet dung) - ham nay tra
    ve ngay, nen 88 test hien huu khong doi 1 dong IL nao."""
    infer_scope = ctx.get('infer_scope')
    if infer_scope is None or not stmt.get('body'):
        return
    tmp = stmt.get('_set_iter_tmp')
    if tmp is None:
        src = _set_name_under_range_len(stmt.get('bound_node'), infer_scope)
        if src is None:
            return
        targets = _body_indexes(stmt['body'], src)
        if not targets:
            return
        _, _, src_ta = infer_scope[src]
        # Giu nguyen `elem_ta` khi phan tu la container (set chua list: ban
        # List<T> phai la List<List<T>>, xem nhanh elem_ta cua il_type_str
        # trong il_codegen.tkv) - neu bo qua thi `ss = {[1,2],[3,4]}` se bien
        # thanh List<int32> va moi phan tu doc ra la 1 int doc nham tren mot
        # bien List<int32>.
        list_ta = ctx['TypeAnn'](src_ta.dtype, 'list', elem_ta=src_ta.elem_ta)
        tmp = f'__forset{id(stmt)}'
        for s in targets:
            s['rhs_node'] = ('index', tmp, s['rhs_node'][2])
        stmt['_set_iter_src'] = src
        stmt['_set_iter_tmp'] = tmp
        stmt['_set_iter_list_ta'] = list_ta
    # PHAI khai bao o MOI pass, khong chi lan dau: first-pass chay lai nhieu
    # lan (hoan cau lenh de bien chua san co duoc) va moi lan co 1
    # `locals_decl` rieng - khai o lan dau di roi, cac lan sau bo qua (vi
    # `stmt` da ghi '_set_iter_tmp' nen nhanh quyet dinh o tren return
    # ngay) thi local AN khong bao gio co trong `.locals` cua ham THAT.
    ctx['declare_named'](tmp, stmt['_set_iter_list_ta'])


def emit_set_iter_source(stmt, scope, body, ctx):
    """Phan codegen cua `plan_set_iter_index_loop`: ghi
    `<tmp> = <src>.to_list()` TRUOC vong lap. No-op khi first-pass khong sua
    gi (xem do - ham do la nguon SU THAT DUY NHAT cho 2 khoa
    '_set_iter_tmp'/'_set_iter_list_ta')."""
    tmp = stmt.get('_set_iter_tmp')
    if tmp is None:
        return
    ctx['load_var_ref'](stmt['_set_iter_src'], scope, body)
    list_il = ctx['il_type_str'](stmt['_set_iter_list_ta'], ctx.get('records'))
    body.append(f'    newobj instance void {list_il}::.ctor(class '
                f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    ctx['store_var'](tmp, scope, body)


def declare_frozenset(name, src, ctx):
    """FIRST_PASS_WALK helper: khai bao local HashSet<T> cho 'fs =
    frozenset(lst)' - dtype phan tu LAY THANG tu dtype cua 'lst' (khac
    declare_set: khong can suy tu .add() vi da co du lieu san). 'lst'
    PHAI da duoc first-pass xu ly XONG truoc do (rang buoc thu tu khai
    bao van ban cua plan 6.8/frozenset) - neu chua co trong infer_scope,
    day la loi that (khong defer, khac declare_set: gia tri phan tu cua
    'lst' KHONG the doi sau khi da khai bao)."""
    declared_names = ctx['declared_names']
    if name in declared_names:
        return
    try:
        src_ta = ctx['infer_scope'][src][2]
    except KeyError:
        raise SyntaxError(
            f"il_codegen: frozenset({src}) - '{src}' chua duoc khai bao TRUOC dong nay "
            f"(frozenset can list nguon khai bao truoc trong van ban)")
    if src_ta.shape != 'list':
        raise SyntaxError(
            f"il_codegen: frozenset({src}) can '{src}' la list (dang co shape={src_ta.shape!r})")
    ta = ctx['TypeAnn'](src_ta.dtype, 'frozenset')
    declared_names.add(name)
    ctx['locals_decl'].append((name, ta))
    ctx['infer_scope'].set(name, ta)


def fpw_assign_set_new(stmt, ctx):
    declare_set(stmt['name'], ctx)


def fpw_assign_frozenset_new(stmt, ctx):
    declare_frozenset(stmt['name'], stmt['src'], ctx)


def fpw_set_add(stmt, ctx):
    ctx['collect_ternary_temps'](stmt['value_node'])


# Dang ky vao il_dispatch NGAY LUC MODULE NAP (il_dispatch.py khong phu
# thuoc il_codegen.py nen import truc tiep an toan, khong circular).
register_assign_rhs_parser('set_new', try_rhs_set_new)
register_assign_rhs_parser('frozenset_new', try_rhs_frozenset_new)
register_assign_rhs_parser('set_literal', try_rhs_set_literal)
register_line_parser('set_add', try_parse_set_add)
register_stmt_codegen('assign_set_new', codegen_assign_set_new)
register_stmt_codegen('assign_frozenset_new', codegen_assign_frozenset_new)
register_stmt_codegen('assign_set_literal', codegen_assign_set_literal)
register_stmt_codegen('set_add', codegen_set_add)
register_first_pass_walk('assign_set_new', fpw_assign_set_new)
register_first_pass_walk('assign_frozenset_new', fpw_assign_frozenset_new)
register_first_pass_walk('assign_set_literal', fpw_assign_set_literal)
register_first_pass_walk('set_add', fpw_set_add)
# 2026-09-29: set literal o VI TRI BIEU THUC (phan tu cua list khac) - xem
# codegen_expr_set_literal. Truoc day chi 's = {...}' chay.
register_expr_codegen('set_literal', codegen_expr_set_literal)
