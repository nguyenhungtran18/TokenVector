# -*- coding: utf-8 -*-
"""Narrowing: giu bien dem/chi so o dang NATIVE int thay vi TkvInt (R7).

VAY DOI
-------
Hang so nguyen mac dinh la kieu `int` (TkvInt - so nguyen VO HAN, 16 byte,
`lo:int64` + `big:object` BigInteger). Do do moi bieu thuc chi so trong
vong lap deu truc qua:

    ldloc <so>                       ; TkvInt (16 byte)
    ldfld object TkvInt::big         ; kiem tra BigInteger
    brtrue  _slow
    ldfld int64  TkvInt::lo
    ldc.i8  -2147483648 ; blt _slow  ; range check
    ldc.i8   2147483647 ; bgt _slow
    mul                              ; nhan trong int64
    ... lap lai cho phep cong, kiem tra tran ...
    call int32 TkvInt::ToI32         ; thu hep ve int32

Do la ~50 lenh IL cho MOT phep `i * n + kk`. Do lai cong toan hoc THAT
chi 3 lenh (`mul`, `add`, `stloc`). Do do matmul 32x32 mat ~670 ns/MAC,
cham hon CPython 2.4 lan va cham hon C# cung may 450 lan - xem
docs/SPECTATOR-PERF.md.

KHONG phai gioi han phan cung ma chi la thue codegen: cung mot CLR, cung
mot may, cung mot thuat toan, C# lam xong matmul 32x32 trong 48.8 us.

CACH SUA
--------
Mot bien duoc khai bao `i64` (native int) THAY VI `int` (TkvInt) khi CHI
su phai chay duoc ngan int64. Khi do moi `+ - *` va so sanh sinh lenh
machine thuan (`add`/`mul`/`clt`), va chi so chi can `conv.ovf.i4`.

Tinh nhat: phai CHUNG minh duoc, khong doan. Phan tich fixpoint tren
cay lenh cua 1 ham:

  - khoi tao: moi ten bien cuc bo deu duoc xem la "narrow" (UA doi)
  - loai bo: bat ky bien nao co MOT lan gan gia tri khong chung minh
    duoc int64 -> bien do KHONG narrow; lap lai toi khi on dinh
  - ngoai ra them: bien doc vao giua vong lap, bien bi closure bat,
    bien la truong record

Bao toan nghĩa: ham vẫn nhan ve `int` (TkvInt) nên nguoi goi khong doi
gi. Chi bien CUC BO trong ham do doi kieu luu tru. Do do moi chuong
trinh co tinh tien khong ton tai deu giu nguyen hanh vi.

Ranh gioi (co chu dich, khong phai so):
  - CHI phep `+ - *` va so sanh. `/ % // **` bo khoi danh sach: chung
    co ngoa rieng (chia 0, lam tron, BigInteger) va `int_type.py` xu ly
    dau dung - dua vao se pham nghĩa.
  - CHI phep hang so co |v| <= 2^40. Headroom 2^23 de `i * n` cua kich
    thuoc thuc te khong tran int64. Hang so lon hon giu lai TkvInt
    (dung cho tinh toan so lon).
  - Bien doc tu `int(s)` / `int64(s)` / ham lai deu KHONG narrow: gia tri
    co the bat ky gi. Do do khoi dong ma doc so lon van dung nhu cu.
"""
import ast

# Gia tri toi da: bien ma chung minh chac chan nam trong int64.
INT64_HEADROOM = 1 << 40

# Toan tu duoc phep - xem "Ranh gioi" o docstring.
_SAFE_OPS = ('+', '-', '*')

# Ham co the tra ve gia tri int64 chắc chắn (khong phai so nguyen vo han).
_SAFE_CALLS = frozenset(('len', 'int64', 'ord', 'count', 'index', 'size'))


# ====================================================================
# Cay lenh cua TokenVector KHONG phai ast.Assign - _parse_block tra ve
# dict: {'kind': 'assign_scalar', 'name': ..., 'rhs_node': <DSL tuple>}
# (xem il_codegen.py::_parse_block, dong 'assign_scalar'), 'for' co
# 'var'/'start_node'/'bound_node'/'body', 'while' co 'cond_node'/'body',
# 'if' co 'cond_node'/'body'/'else_body'. Bieu thuc la TUPLE
# ('num'|'str_lit'|'var'|'binop'|'compare'|'call'|'index'|..., ...).
# ====================================================================


def _is_int_literal(node):
    """('num', '123') | ('num', '0x1F') - va |v| <= 2^40."""
    if not (isinstance(node, tuple) and node and node[0] == 'num'):
        return False
    text = str(node[1])
    if '.' in text or 'e' in text.lower():
        return False
    try:
        v = int(text, 0)
    except (TypeError, ValueError):
        return False
    return abs(v) <= INT64_HEADROOM


def _var_name(node):
    return node[1] if (isinstance(node, tuple) and node and node[0] == 'var') else None


def _is_boolish(node, narrow, params_i64):
    if not (isinstance(node, tuple) and node):
        return False
    tag = node[0]
    if tag in ('compare', 'boolop', 'not'):
        return all(_expr_int64(x, narrow, params_i64) for x in _operands(node))
    return _expr_int64(node, narrow, params_i64)


def _operands(node):
    """Cac toan hang cua mot bieu thuc DSL (bo qua tag va toan tu)."""
    return [e for e in node[1:] if isinstance(e, tuple)]


def _expr_int64(node, narrow, params_i64):
    """True neu `node` CHUNG MINH duoc la mot gia tri int64."""
    if not (isinstance(node, tuple) and node):
        return False
    tag = node[0]
    if tag == 'num':
        return _is_int_literal(node)
    if tag == 'var':
        return node[1] in narrow or node[1] in params_i64
    if tag == 'neg':
        return _expr_int64(node[1], narrow, params_i64)
    if tag == 'binop':
        # node = ('binop', op, left, right)
        if len(node) < 4 or node[1] not in _SAFE_OPS:
            return False
        return (_expr_int64(node[2], narrow, params_i64)
                and _expr_int64(node[3], narrow, params_i64))
    if tag in ('compare', 'boolop', 'not'):
        return _is_boolish(node, narrow, params_i64)
    if tag == 'call':
        # node = ('call', name, [args])
        if len(node) < 3 or node[1] not in _SAFE_CALLS:
            return False
        return all(_expr_int64(a, narrow, params_i64) for a in (node[2] or ()))
    return False


def _collect_assigns(stmts, out):
    """Duyet cay lenh DSL, gom (ten, rhs) moi phep gan cuc bo."""
    if not stmts:
        return
    for stmt in stmts:
        if not isinstance(stmt, dict):
            continue
        kind = stmt.get('kind')
        if kind == 'assign_scalar':
            out.append((stmt.get('name'), stmt.get('rhs_node')))
        elif kind == 'if':
            _collect_assigns(stmt.get('body'), out)
            _collect_assigns(stmt.get('else_body'), out)
        elif kind in ('while', 'for'):
            _collect_assigns(stmt.get('body'), out)
        elif kind == 'try':
            _collect_assigns(stmt.get('body'), out)
            _collect_assigns(stmt.get('handlers'), out)
            _collect_assigns(stmt.get('finally_body'), out)
    return out


def _assigned_everywhere(stmts, name):
    """Tap moi RHS ma bien `name` duoc gan (de kiem tra TAT CA deu int64)."""
    out = []
    _collect_assigns(stmts, out)
    return [rhs for (n, rhs) in out if n == name]


def _collect_for_targets(stmts, out):
    """Gom bien dem `for <var> in range(...)` trong cay lenh DSL.

    R7 (2026-09-28): bien dem vong `for` KHONG duoc `_collect_assigns` bat
    (no khong phai `ten = rhs` ma la muc tieu cua vong), nen chua bao gio
    duoc xet. Hieu qua - bien dem do giu kieu `i32` (int32) trong khi
    phan con lai cua ham dung `i64`, va:

      for _qx1064 in range(min(len(starts), len(shape))):
          _qx1021.append(_qx1064)
      axes = _qx1021          # `axes` la tham so `list[i64]`

    `_qx1021` deduce thanh `List<int32>` (append bien i32) roi gan vao
    tham so `list[i64]`. Kieu `List<int32>` VA `List<int64>` KHAC nhau
    ve generic arg nen khong gan duoc - nhanh i32 -> i64 cua
    _widen_if_needed (R7) se sinh `conv.i8` tren MOT CON TRO OBJECT, cat
    con tro con 32 bit roi ep thanh int64: bien phai - chay xanh khong
    bao loi, gia tri rac. `_slice_shape` cua Inference la noi bi anh
    huong: doc phan tu 0 cua `List<int32>[0,1,2]` bang 8 byte cho
    `0x0000000100000000` = 4294967296 roi lam chi so `shape[...]`.

    Bien dem `range()` LUON an toan ep len i64: compiler sinh no bang
    bien dem int32, ma int32 tap thanh tap cua int64 nen ep rong hon
    khong bao gio lam mat gia tri. Cac noi dung bien dem deu da co
    ep kieu san (chi so qua `conv.ovf.i4`, truyen ham .NET qua
    `_widen_if_needed`), nen doi kieu luu tru la an toan.
    """
    if not stmts:
        return
    for stmt in stmts:
        if not isinstance(stmt, dict):
            continue
        kind = stmt.get('kind')
        if kind == 'for':
            var = stmt.get('var')
            if var:
                out.append(var)
            _collect_for_targets(stmt.get('body'), out)
        elif kind == 'if':
            _collect_for_targets(stmt.get('body'), out)
            _collect_for_targets(stmt.get('else_body'), out)
        elif kind in ('while', 'assign_scalar', 'expr'):
            _collect_for_targets(stmt.get('body'), out)
        elif kind == 'try':
            _collect_for_targets(stmt.get('body'), out)
            _collect_for_targets(stmt.get('handlers'), out)
            _collect_for_targets(stmt.get('finally_body'), out)
    return out


def narrowable_locals(stmts, sig=None, nested_closures=None, boxed_names=None):
    """Tap ten bien cuc bo cua ham DUOC khai bao native `i64` thay vi `int`.

    Tra ve set rong neu khong xac dinh duoc gi - phai an toan mac dinh.
    """
    if not stmts:
        return set()
    assigns = _collect_assigns(list(stmts), [])
    for_targets = set(_collect_for_targets(list(stmts), []))
    # Cong tac: dat TKV_DBG_NARROW=1 khi bien dich de xem ham nao duoc
    # narrow, bien dem vong nao duoc bat, va cac `kind` lenh co that.
    import os as _os
    if _os.environ.get('TKV_DBG_NARROW'):
        _kinds = sorted({_s.get('kind') for _s in stmts
                         if isinstance(_s, dict) and _s.get('kind')})
        print('[narrow-dbg] func=%s kinds=%s for_targets=%s assigned=%s' % (
            getattr(sig, 'name', '?'), _kinds, sorted(for_targets),
            sorted({n for (n, _) in assigns if n})))
    if not assigns and not for_targets:
        return set()
    params_i64 = set()
    if sig is not None:
        for p in getattr(sig, 'params', ()) or ():
            d = getattr(p, 'type_ann', None)
            dtype = getattr(d, 'dtype', None) if d is not None else None
            if dtype in ('i32', 'i64'):
                params_i64.add(p.name)
    forbidden = set(nested_closures or ()) | set(boxed_names or ())
    # R7 (2026-09-28): bien dem `for x in range(...)` - xem _collect_for_targets.
    # KHONG nam trong `assigns` (no khong phai gan) nen phai giong vao tap
    # khoi tao va CO CHE BAO TRONG fixpoint, neu khong no se bi loai o vong
    # dau tien vi khong co (name, rhs) nao tu `assigns` de xet lai no.
    for_targets = set(_collect_for_targets(list(stmts), []))
    # Fixpoint: khoi tao "tat ca ten duoc gan deu narrow", loai bo dan.
    narrow = {name for (name, _) in assigns if name} | for_targets
    for _ in range(8):
        before = set(narrow)
        for (name, rhs) in assigns:
            if name in for_targets:
                continue
            if not name or name in forbidden or name in params_i64:
                narrow.discard(name)
                continue
            if not _expr_int64(rhs, narrow, params_i64):
                narrow.discard(name)
        if narrow == before:
            break
    narrow -= forbidden
    narrow -= params_i64
    return narrow
