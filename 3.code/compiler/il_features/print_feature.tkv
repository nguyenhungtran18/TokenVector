import il_features.tkvstr as _tkvstr
from il_features.string_builtin import _is_bool_shaped

# 2026-09-28: 'print(..., sep=..., end=...)'. Truoc day print chi nhan danh
# SCH positional va PHAI noi bang 'ldstr " "' cung WriteLine() (het dong).
# Hai tham so nay bi bo qua im lang - mot loi 'im lang' vi 'print("a","b",
# sep="-")' in ra "a b" chu khong phai "a-b", va nguoi dung khong bao gio
# duoc loi nao de do la minh viet sai.
#
# GHI CHU GIOI HAN CO Y THUC: bieu thuc `sep`/`end` duoc SINH LAI cho moi
# lan dung thay vi tinh MOT LAN roi giu vao bien (giong Python). Ly do: khai
# bao bien phu o day di qua first-pass, con print la CALL STATEMENT nen
# khong co duong de chen. Hau qua duy nhat: `sep=f()` se goi `f()` nhieu
# lan. Thuc te `sep`/`end` luon la chuoi HANG so nen khong gi dang xay ra;
# neu can dung bien thi `s = "-"` roi `sep=s` - chi doc bien, khong goi ham.
def _emit_sep(sep_expr, scope, body, ctx):
    """Day 1 chuoi phan tach len stack (mac dinh 1 dau cach)."""
    if sep_expr is None:
        body.append('    ldstr " "')
        return
    dtype = ctx['infer_dtype'](sep_expr, scope, ctx.get('func_table'),
                                ctx.get('records'), ctx.get('record_methods'))
    if dtype not in ('str', None):
        raise SyntaxError(
            f"il_codegen: print(sep=...) phai la chuoi, gap kieu {dtype!r} - "
            f"'sep' la ky tu phan tach giua cac doi so")
    ctx['compile_expr'](sep_expr, scope, body, 'str', ctx)


def _emit_str_arg(arg, scope, body, ctx):
    """Bien 1 doi so cua print thanh chuoi tren stack (giu nguyen quy tac
    bool -> "True"/"False" cua ban goc)."""
    dtype = ctx['infer_dtype'](arg, scope, ctx.get('func_table'), ctx.get('records'),
                                ctx.get('record_methods'))
    if dtype is None:
        # ctx cua pass 2 khong co 'infer_literal_dtype' (no la moc cua
        # first-pass) - hang so tu suy tai cho, dung quy uoc CHUNG:
        # co dau '.' la f64, con lai la 'int'.
        dtype = ('f64' if (isinstance(arg, tuple) and arg[0] == 'num'
                           and _is_float_literal(arg[1])) else 'int')
    ctx['compile_expr'](arg, scope, body, dtype, ctx)
    # xem string_feature.py's _is_bool_shaped: compare/boolop/not/in/
    # all/any/startswith/endswith deu dtype='i32' nhung mang nghia
    # logic - print() phai in "True"/"False" nhu Python, khong phai so.
    _tkvstr.emit_to_str('bool' if (dtype == 'i32' and _is_bool_shaped(arg)) else dtype,
                        body, ctx)


def compile_print(call_node, scope, body, ctx):
    from il_core import _is_float_literal

    sep_expr = None
    end_expr = None
    positional = []
    for a in call_node[2]:
        if isinstance(a, tuple) and a[0] == 'kwarg':
            if a[1] == 'sep':
                sep_expr = a[2]
            elif a[1] == 'end':
                end_expr = a[2]
            else:
                raise SyntaxError(
                    f"il_codegen: print() khong nhan tham so tu khoa {a[1]!r} - "
                    f"chi 'sep' va 'end'")
        else:
            positional.append(a)
    args = positional

    if not args:
        # print() hoac print(end=...) - WriteLine() rong, hoac rong + end.
        if end_expr is None:
            body.append('    call void [mscorlib]System.Console::WriteLine()')
            return
        body.append('    call void [mscorlib]System.Console::Write(string)')
        _emit_str_arg(end_expr, scope, body, ctx)
        body.append('    call void [mscorlib]System.Console::Write(string)')
        return

    for k, arg in enumerate(args):
        if k:
            _emit_sep(sep_expr, scope, body, ctx)
        _emit_str_arg(arg, scope, body, ctx)
        if k:
            body.append('    call string [mscorlib]System.String::Concat(string, string)')
            body.append('    call string [mscorlib]System.String::Concat(string, string)')
    if end_expr is None:
        body.append('    call void [mscorlib]System.Console::WriteLine(string)')
    else:
        body.append('    call void [mscorlib]System.Console::Write(string)')
        _emit_str_arg(end_expr, scope, body, ctx)
        body.append('    call void [mscorlib]System.Console::Write(string)')
