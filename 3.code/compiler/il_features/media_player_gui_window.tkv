    A('    brfalse IL_RUN_FORM')
    A('    ldloc.0')
    A('    ldfld class [System.Windows.Forms]System.Windows.Forms.Label MediaPlayerForm::lblTitle')
    A('    ldsfld string MediaPlayerForm::audioPath')
    A('    call string [mscorlib]System.IO.Path::GetFileNameWithoutExtension(string)')
    A('    callvirt instance void [System.Windows.Forms]System.Windows.Forms.Control::set_Text(string)')
    A('')
    A('  IL_RUN_FORM:')
    A('    ldloc.0')
    A('    call void [System.Windows.Forms]System.Windows.Forms.Application::Run(class [System.Windows.Forms]System.Windows.Forms.Form)')
    A('    ldc.i4.0')
    A('    ret')
    A('  }')
    A('')
    return L

def ensure_class(ctx):
    emitted = ctx.get('emitted_types')
    if emitted is None or _HELPER_CLASS in emitted:
        return
    emitted.add(_HELPER_CLASS)

    lines = [
        '.subsystem 0x0002',
        f'.class public auto ansi beforefieldinit {_HELPER_CLASS} extends [System.Windows.Forms]System.Windows.Forms.Form',
        '{'
    ]
    lines.extend(_field_lines())
    lines.extend(_ctor_lines())
    lines.extend(_event_handler_lines())
    lines.extend(_sta_launcher_lines())
    lines.append('}')

    ctx['extra_classes'].append(lines)

def compile_media_player_gui_window(args, scope, out, dtype, ctx):
    ensure_class(ctx)
    if len(args) == 1:
        ctx['compile_expr'](args[0], scope, out, 'str', ctx)
    else:
        out.append('    ldnull')
    out.append(f'    call int32 {_HELPER_CLASS}::StartGui(string)')
    if dtype:
        ctx['widen_if_needed']('i32', dtype, out)

register_expr_builtin('media_player_gui_window', compile_media_player_gui_window, return_dtype='i32')
register_expr_builtin('launch_media_player_gui', compile_media_player_gui_window, return_dtype='i32')
