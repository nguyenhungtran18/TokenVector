    A('  // 13. OnPaint_Waveform (Direct replication of user image audio waveform bars)')
    A('  .method public hidebysig instance void OnPaint_Waveform(object sender, class [System.Windows.Forms]System.Windows.Forms.PaintEventArgs e) cil managed')
    A('  {')
    A('    .maxstack 16')
    A('    .locals init (')
    A('      [0] class [System.Drawing]System.Drawing.Graphics V_g,')
    A('      [1] class [System.Drawing]System.Drawing.Pen V_penBar,')
    A('      [2] int32 V_i,')
    A('      [3] int32 V_x,')
    A('      [4] int32 V_h,')
    A('      [5] int32 V_y')
    A('    )')
    A('    ldarg.2')
    A('    callvirt instance class [System.Drawing]System.Drawing.Graphics [System.Windows.Forms]System.Windows.Forms.PaintEventArgs::get_Graphics()')
    A('    stloc.0')
    A('    ldloc.0')
    A('    ldc.i4.2')
    A('    callvirt instance void [System.Drawing]System.Drawing.Graphics::set_SmoothingMode(valuetype [System.Drawing]System.Drawing.Drawing2D.SmoothingMode)')
    A('')
    A('    // Black Pen for waveform bars (width 2.5f)')
    A('    ldc.i4.0')
    A('    ldc.i4.0')
    A('    ldc.i4.0')
    A('    call valuetype [System.Drawing]System.Drawing.Color [System.Drawing]System.Drawing.Color::FromArgb(int32, int32, int32)')
    A('    ldc.r4 2.5')
    A('    newobj instance void [System.Drawing]System.Drawing.Pen::.ctor(valuetype [System.Drawing]System.Drawing.Color, float32)')
    A('    stloc.1')
    A('')
    A('    // Draw 48 vertical waveform bars matching the user image style')
    A('    ldc.i4.0')
    A('    stloc.2')
    A('  IL_WAVE_LOOP:')
    A('    ldloc.2')
    A('    ldc.i4 48')
    A('    bge IL_WAVE_DONE')
    A('')
    A('    // Bar X coordinate = i * 8 + 4')
    A('    ldloc.2')
    A('    ldc.i4.8')
    A('    mul')
    A('    ldc.i4.4')
    A('    add')
    A('    stloc.3')
    A('')
    A('    // Calculate rhythmic height: base wave pattern + anim dynamic modulation')
    A('    ldloc.2')
    A('    ldc.i4.6')
    A('    rem')
    A('    ldc.i4.5')
    A('    mul')
    A('    ldc.i4.8')
    A('    add')
    A('    stloc.s V_h')
    A('')
    A('    // If playing, modulate with animFrame for dynamic live bounce')
    A('    ldsfld int32 MediaPlayerForm::isPlaying')
    A('    brfalse IL_WAVE_DRAW_BAR')
    A('    ldloc.s V_h')
    A('    ldsfld int32 MediaPlayerForm::animFrame')
    A('    ldloc.2')
    A('    add')
    A('    ldc.i4.7')
    A('    rem')
    A('    ldc.i4.3')
    A('    mul')
    A('    add')
    A('    stloc.s V_h')
    A('')
    A('  IL_WAVE_DRAW_BAR:')
    A('    // Center vertically: y = 22 - (h / 2)')
    A('    ldc.i4 22')
    A('    ldloc.s V_h')
    A('    ldc.i4.2')
    A('    div')
    A('    sub')
    A('    stloc.s V_y')
    A('')
    A('    ldloc.0')
    A('    ldloc.1')
    A('    ldloc.3')
    A('    ldloc.s V_y')
    A('    ldloc.3')
    A('    ldloc.s V_y')
    A('    ldloc.s V_h')
    A('    add')
    A('    callvirt instance void [System.Drawing]System.Drawing.Graphics::DrawLine(class [System.Drawing]System.Drawing.Pen, int32, int32, int32, int32)')
    A('')
    A('    ldloc.2')
    A('    ldc.i4.1')
    A('    add')
    A('    stloc.2')
    A('    br IL_WAVE_LOOP')
    A('')
    A('  IL_WAVE_DONE:')
    A('    ret')
    A('  }')
