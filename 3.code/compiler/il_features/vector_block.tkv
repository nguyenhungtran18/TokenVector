# -*- coding: utf-8 -*-
"""Khoi vector 8 lane f32 tren BO NHO KHONG QUAN LY (R5, 2026-09-28).

BA TANG - va TANG 2 LA TANG BI CHAN, kiem chung bang CHAY THAT:

  T1  vector/intrinsic trong ngon ngu            : KHONG CO
  T2  compiler tu dong vectorize                  : KHONG CO pass nao
  T3  kieu vector cua CLR                         : KHONG CO tren
      .NET Framework 4.8 (chi co tu .NET Core 3.0+)

Module nay KHONG dinh nghia 1 kieu vector nao. No cung cap KHOI 8
LANE tren bo nho phang (contiguous unmanaged) doc/ghi bang 8 lenh
scalar - dung dung tinh "contiguous + unaligned-safe" cua CLR ma KHONG
can co 1 lenh vector nao ton tai. Do la nen tang cho moi duong SIMD
that sau nay (kernel C, hay doi target framework).

KHUYEN: 'f32x8' o day la MOT KHOI 8 float32 trong 1 struct 32 byte,
KHONG phai 1 vector phan cung. Kieu CLR vector that se cho lenh SIMD
1 lenh/8 lane KHONG TON TAI tren framework nao day - xem muc "CA TANG 2
BI CHAN" ben duoi truoc khi dung.

MO HINH
-------
Dem xuong la 1 hidden local KIEU f32x8, cap PHAI CONST cho moi ham
(giong 4 local cua 'int' - xem vector_block/scratch_locals va hook
tương ứng trong il_codegen.tkv). Ly do khong dung id(node) nhu
temps_fn cua cac builtin khac: 1 chuoi `v_load8 -> v_add8 -> v_hsum`
phai dung CHUNG 1 dem, ma moi lenh trong chuoi la 1 node rieng nen
khoa id() se tach chung thanh 3 dem khac nhau.

  p = alloc_bytes(64)
  v_load8(p, 0)          # 8 lane (32 byte) tu dia chi native
  v_mul8(2.0)            # nhan 8 lane voi 2.0
  s = v_hsum()           # tong 8 lane (dung o duoi khoi)
  v_store8(p, 0)         # ghi nguoc 32 byte

MOI offset (ca v_load8/v_store8 lan read_f32/write_f32) deu tinh theo
BYTE.

Mot ham chi co 1 dem xuong - 2 chuoi doc/ghi doc lap nhau trong cung
1 ham se GHI DE nhau. Cach dung nhieu khoi: tach thanh helper.

"CA TANG 2 BI CHAN" - ket qua do bang chay THAT, giu lai de khong
nghien cuu lai:
  * `System.Runtime.Intrinsics.Vector256<float32>` (de xuat cua
    SIMD_NOTES.md muc 7.2): ilasm 4.8 LAP file .il thanh cong - no
    KHONG kiem tra assembly co that hay khong - nhung luc CHAY nem
    `FileNotFoundException: Could not load file or assembly
    'System.Runtime.Intrinsics, Version=4.0.0.0'`. Khong ton tai tren
    .NET Framework, chi co tu .NET Core 3.0+.
  * `System.Numerics.Vector<float32>` (duong thay the): ilasm lap
    duoc, luc chay nem `TypeLoadException: Could not load type
    'System.Numerics.Vector`1'`. Doc `System.Numerics.dll` 4.0.0.0
    trong Framework64 bang reflection: chi export `Vector2`/`Vector3`/
    `Vector4` - KHONG co generic `Vector<T>` (cai do la .NET Core).
  * `System.Numerics.Vector4`: ton tai, `ldobj` doc/ghi duoc, NHUNG
    phep cong cua no la toan hoc float phan mem tren x86 - khong co
    lenh SIMD nao. Khong phai giai phap.
  * `Marshal.ReadSingle`/`WriteSingle`: KHONG TON TAI. Do bang
    reflection: `System.Runtime.InteropServices.Marshal` tren .NET
    Framework 4.8 co KHONG ham float/double nao (ke ca
    ReadDouble/WriteDouble), va `BitConverter` chi co
    `DoubleToInt64Bits`/`Int64BitsToDouble` - thieu ca
    `SingleToInt32Bits`/`Int32BitsToSingle`. Nen duong float32 phai
    dung lenh IL tho `ldind.r4`/`stind.r4` (da probe: chay OK, ke ca
    o dia chi LECH - nen can 32-byte alignment la KHONG bat buoc).
  * `stind.ref` KHONG hop le voi value type (ILASM: syntax error) -
    doc struct bang `ldobj`, ghi bang tach thanh lenh `stind.r4`.

Hai loi cua ilasm 4.8 can tranh (may sinh .il qua nen rat de gap):
  - `off` la TU KHOA GIU (dung `.field off` cho vararg) - ten tham so
    trong .il phai la `ofs`.
  - `ldc.i4.64` bi TU CHOI - dung `ldc.i4.s 64` hoac `ldc.i4 64`.
"""
from il_core import IL_SCALAR
from il_dispatch import register_expr_builtin

VEC_W = 8
VEC_DTYPE = 'f32x8'
VEC_CLASS = 'VBuf8'
VEC_LOCAL = '__vbuf8'

# 1 hidden local cho MOI ham (xem scratch_locals).
_LOCAL_IDX = {}


def register_vector_dtype():
    """Goi luc nap module - dang ky 'f32x8' vao bang kieu IL dung chung.

    IL_SCALAR keo theo moi noi tra cuu kieu cua local/tham so, nen 1
    dong la du cho ca kieu cua dem xuong.

    KHONG dang ky vao IL_LDC_OP: `ldc.r4 5` khong tao duoc struct 32
    byte. Hang so vector phai di qua `v_fill8(5.0)` - dung y het
    int_type.py, cung vi ly do no khong dang ky 'int' vao IL_LDC_OP.

    KHONG dang ky vao IL_NARROW_TO_I32: do do chi dung cho CHI SO."""
    IL_SCALAR[VEC_DTYPE] = f'valuetype {VEC_CLASS}'


def scratch_locals():
    """(ten, dtype) local nhap cho ham CO dung khoi vector. Xem hook
    trong il_codegen.tkv (_first_pass_collect_locals)."""
    return [(VEC_LOCAL, VEC_DTYPE)]


VBuf8_IL = [f'.class private auto ansi sequential {VEC_CLASS}',
            '       extends [mscorlib]System.ValueType',
            '{'] + [f'  .field public float32 f{i}' for i in range(VEC_W)] + ['}']


def ensure_class(ctx):
    """Chen class VBuf8 vao assembly MOT LAN (xem khuon int_type.tkv)."""
    emitted = ctx.setdefault('emitted_types', set())
    if VEC_CLASS in emitted:
        return
    emitted.add(VEC_CLASS)
    ctx['extra_classes'].append(VBuf8_IL)


def _local_idx(scope):
    """Chi so IL cua dem xuong trong ham dang bien dich.

    `scope` la _Scope o tang codegen (raise SyntaxError khi ten khong
    co) - KHONG co `.get()` (dung Python dict se bo qua quy tac rieng
    cua _Scope). `_DtypeOnlyScope` (first-pass) raise KeyError nen bat
    ca hai - xem ghi chu o class _Scope trong il_codegen.tkv."""
    try:
        entry = scope[VEC_LOCAL]
    except (SyntaxError, KeyError):
        raise SyntaxError(
            f'il_codegen: khoi vector ({VEC_DTYPE}) - local "{VEC_LOCAL}" chua '
            f'duoc khai bao trong ham nay (co the ham nay duoc sinh truc tiep '
            f'boi 1 duong khong qua _first_pass_collect_locals).')
    return entry[1]


def _addr(p_node, ofs_node, lane_byte_off, scope, out, ctx):
    """Day 'native int' cua p + ofs + lane_byte_off len stack.

    `ofs` tinh theo BYTE - giong het read_f32/write_f32/read_i32/... o
    nativebuf.tkv. (Phien ban dau cua ham nay nhan off theo LANE roi nhan
    *4 ben trong - het nhat do la nguon goc cua 1 loi heap corruption
    trong test: `v_store8(p, 32)` doc vao coi 32 la lane 128 nen ghi
    tran 64 byte ra ngoai buffer. MOI offset trong khoi vector deu la
    byte, het nhat nguoi doc kieu duoc suy ra tu 1 quy uoc.)

    Doc 1 khoi 8 lane lien tiep nen dia chi 4 byte cach nhau - can 32
    byte alignment KHONG bat buoc (da probe: ldind.r4/stind.r4 o dia chi
    lech chay OK, xem muc "CA TANG 2 BI CHAN")."""
    ctx['compile_expr'](p_node, scope, out, 'i64', ctx)
    if ofs_node is not None:
        _ofs_i32(ofs_node, scope, out, ctx)
        out.append('    conv.i8')
        out.append('    add')
    if lane_byte_off:
        out.append(f'    ldc.i4.s {lane_byte_off}')
        out.append('    conv.i8')
        out.append('    add')
    out.append('    conv.i')


def _ofs_i32(ofs_node, scope, out, ctx):
    """Offset byte thanh i32."""
    d = ctx['infer_dtype'](ofs_node, scope, ctx.get('func_table'))
    if d == 'i64':
        ctx['compile_expr'](ofs_node, scope, out, 'i64', ctx)
        out.append('    conv.i4')
    else:
        ctx['compile_expr'](ofs_node, scope, out, 'i32', ctx)


def _ldflda(idx, lane, out):
    """Day dia chi QUAN LY cua lane -> float32&.

    `ldflda` + `stind.r4`/`ldind.r4` la cach DUY NHAT ghi 1 field cua
    struct truc tiep ma khong can local tam: `stfld` chi nhan
    [object, value] nen phai giu object tren stack TRUOC khi tinh toan
    hang - ma o day gia tri la `dia chi cua field` nen `stind.r4`
    ([dia chi, value]) ghi thang vao field, khong can object."""
    out.append(f'    ldloca.s {idx}')
    out.append(f'    ldflda float32 {VEC_CLASS}::f{lane}')


def push_v_load8(args, scope, out, dtype, ctx):
    """'v_load8(p, off)' - nap 8 lane (32 byte) tu dia chi native, `off`
    tinh theo BYTE nhu read_f32/write_f32, tra lane 0."""
    if len(args) != 2:
        raise SyntaxError("il_codegen: v_load8(p, off) can dung 2 tham so")
    ensure_class(ctx)
    idx = _local_idx(scope)
    for lane in range(VEC_W):
        # [VBuf8&] (cho stfld) + dia chi native -> ldind.r4 -> stfld
        out.append(f'    ldloca.s {idx}')
        _addr(args[0], args[1], lane * 4, scope, out, ctx)
        out.append('    ldind.r4')
        out.append(f'    stfld float32 {VEC_CLASS}::f{lane}')
    out.append(f'    ldloc.s {idx}')
    out.append(f'    ldfld float32 {VEC_CLASS}::f0')


def push_v_store8(args, scope, out, dtype, ctx):
    """'v_store8(p, off)' - ghi 8 lane (32 byte) xuong dia chi native,
    `off` tinh theo BYTE, tra 0 de goi dang lenh doc lap."""
    if len(args) != 2:
        raise SyntaxError("il_codegen: v_store8(p, off) can dung 2 tham so")
    ensure_class(ctx)
    idx = _local_idx(scope)
    for lane in range(VEC_W):
        # [dia chi native] roi moi den [dia chi field] de lay gia tri:
        # stind.r4 pop value truoc, dia chi native o duoi.
        _addr(args[0], args[1], lane * 4, scope, out, ctx)
        _ldflda(idx, lane, out)
        out.append('    ldind.r4')
        out.append('    stind.r4')
    out.append('    ldc.i8 0')


def _push_lanewise(args, scope, out, ctx, ops, name):
    """Chung cho v_add8/v_sub8/v_mul8/v_mul8_add8: moi lane = lane (op0 a0) (op1 a1)...

    Toan hang va lenh phai XEN KẼ nhau (compile a0 roi `op0`, roi a1 roi
    `op1`), KHONG day het toan hang truoc roi moi ap lenh: day het truoc
    thi `v_mul8_add8(x, y)` ra `lane + x*y` thay vi `lane*x + y` (do
    `mul` ap tren 2 gia tri cuoi cùng la x va y).

    `dup` la BAT BUOC: `ldflda` day 1 dia chi QUAN LY len stack roi
    `ldind.r4` POP no de lay gia tri - nhung `stind.r4` o cuoi lai can
    dung dia chi do de ghi nguoc. Bo `dup` thi stack het truoc khi
    `stind.r4` chay va sinh 'InvalidProgramException' luc chay."""
    if len(args) != len(ops):
        raise SyntaxError(
            f"il_codegen: {name} - so tham so ({len(args)}) khong khop so phep "
            f"({len(ops)})")
    ensure_class(ctx)
    idx = _local_idx(scope)
    for lane in range(VEC_W):
        _ldflda(idx, lane, out)
        out.append('    dup')
        out.append('    ldind.r4')
        for arg, op in zip(args, ops):
            ctx['compile_expr'](arg, scope, out, 'f32', ctx)
            out.append('    ' + op)
        out.append('    stind.r4')
    out.append(f'    ldloc.s {idx}')
    out.append(f'    ldfld float32 {VEC_CLASS}::f0')


def push_v_add8(args, scope, out, dtype, ctx):
    """'v_add8(x)' - moi lane = lane + x."""
    _push_lanewise(args, scope, out, ctx, ['add'], 'v_add8(x)')


def push_v_sub8(args, scope, out, dtype, ctx):
    """'v_sub8(x)' - moi lane = lane - x."""
    _push_lanewise(args, scope, out, ctx, ['sub'], 'v_sub8(x)')


def push_v_mul8(args, scope, out, dtype, ctx):
    """'v_mul8(x)' - moi lane = lane * x."""
    _push_lanewise(args, scope, out, ctx, ['mul'], 'v_mul8(x)')


def push_v_fill8(args, scope, out, dtype, ctx):
    """'v_fill8(x)' - nap ca 8 lane = x (broadcast), tra lane 0."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: v_fill8(x) can dung 1 tham so")
    ensure_class(ctx)
    idx = _local_idx(scope)
    for lane in range(VEC_W):
        _ldflda(idx, lane, out)
        ctx['compile_expr'](args[0], scope, out, 'f32', ctx)
        out.append('    stind.r4')
    out.append(f'    ldloc.s {idx}')
    out.append(f'    ldfld float32 {VEC_CLASS}::f0')


def push_v_mul8_add8(args, scope, out, dtype, ctx):
    """'v_mul8_add8(x, y)' - moi lane = lane * x + y. Gop 2 phep trong
    1 vong ghi field (v_mul8 roi v_add8 se ghi 2 lan)."""
    _push_lanewise(args, scope, out, ctx, ['mul', 'add'], 'v_mul8_add8(x, y)')


def push_v_hsum(args, scope, out, dtype, ctx):
    """'v_hsum()' - tong 8 lane trong dem xuong (dung o duoi khoi).

    `ldfld` POP 1 phan tu (doi tuong) nen phai day `ldloc` LAI truoc
    MOI `ldfld` - day 1 lan roi `ldfld` 8 lan se lam phan tu thu 2
    tro thanh doi tuong va sinh `InvalidProgramException` luc chay."""
    if len(args) != 0:
        raise SyntaxError("il_codegen: v_hsum() khong co tham so")
    ensure_class(ctx)
    idx = _local_idx(scope)
    for lane in range(VEC_W):
        out.append(f'    ldloc.s {idx}')
        out.append(f'    ldfld float32 {VEC_CLASS}::f{lane}')
        if lane:
            out.append('    add')


def push_v_lane(args, scope, out, dtype, ctx):
    """'v_lane(i)' - rut lane i (CHI HANG SO 0..7: rut lane theo bien
    co nhanh dong, ma don vi tri nay giong het 'chi so hang so' cua
    lst[-1] nen de nhat la chi hang so)."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: v_lane(i) can dung 1 tham so")
    n = _literal_int(args[0])
    if n is None or not (0 <= n < VEC_W):
        raise SyntaxError(
            f"il_codegen: v_lane(i) - chi nhan HANG SO trong 0..{VEC_W - 1}")
    ensure_class(ctx)
    out.append('    ldloc ' + str(_local_idx(scope)))
    out.append(f'    ldfld float32 {VEC_CLASS}::f{n}')


def _literal_int(node):
    if isinstance(node, tuple) and node[0] == 'num' and '.' not in node[1]:
        try:
            return int(node[1], 0)
        except ValueError:
            return None
    return None


register_vector_dtype()
register_expr_builtin('v_load8', push_v_load8, 'f32')
register_expr_builtin('v_store8', push_v_store8, 'i64')
register_expr_builtin('v_fill8', push_v_fill8, 'f32')
register_expr_builtin('v_add8', push_v_add8, 'f32')
register_expr_builtin('v_sub8', push_v_sub8, 'f32')
register_expr_builtin('v_mul8', push_v_mul8, 'f32')
register_expr_builtin('v_mul8_add8', push_v_mul8_add8, 'f32')
register_expr_builtin('v_hsum', push_v_hsum, 'f32')
register_expr_builtin('v_lane', push_v_lane, 'f32')
