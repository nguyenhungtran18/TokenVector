+def _max_stack_for(body):
+    """Gia tri `.maxstack` du cho than ham nay.
+
+    Truoc day HANG SO 8 cho moi ham. Goi mot ham 9 THAM SO can 9 o tren
+    stack, nen IL sinh ra khong hop le: ilasm van dich, CLR nem
+    InvalidProgramException LUC CHAY, khong noi gi ve maxstack. Da do:
+    8 tham so chay tot, 9 tham so hong.
+
+    Uoc luong don gian, thien ve du: so tham so lon nhat trong moi lenh
+    `call`/`newobj` cua than ham, cong bien 8. `.maxstack` chi la muc
+    dat truoc nen dat du khong ton gi; dat THIEU thi hong."""
+    widest = 0
+    for line in body:
+        st = line.strip()
+        if not (st.startswith('call ') or st.startswith('callvirt ')
+                or st.startswith('newobj ')):
+            continue
+        at = st.find('(')
+        if at < 0:
+            continue
+        inside = st[at + 1:st.rfind(')')]
+        n = 0 if not inside.strip() else inside.count(',') + 1
+        if st.startswith('call instance') or st.startswith('callvirt'):
+            n = n + 1
+        if n > widest:
+            widest = n
+    return max(8, widest + 8)
+
