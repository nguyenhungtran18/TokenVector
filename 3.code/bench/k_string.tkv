# -*- coding: utf-8 -*-

def bm_str(reps: "i32", n: "i32") -> "i32":
    k = 0
    cs = 0
    while k < reps:
        buf = []
        i = 0
        while i < n:
            buf.append("abcdefgh")
            i = i + 1
        s = "".join(buf)
        cs = len(s)
        i = 0
        cnt = 0
        while i < n:
            ch = s[i:i + 1]
            if ch == "e":
                cnt = cnt + 1
            i = i + 1
        cs = cs + cnt
        k = k + 1
    print("cs=" + str(cs))
    return 0


def main() -> "i32":
    bm_str(3, 200000)
    return 0
