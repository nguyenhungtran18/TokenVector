class Circle:
    r: "f32"

    def __init__(self, r):
        self.r = r

    @property
    def area(self) -> "f32":
        return 3.0 * self.r * self.r


def bench_property(n: "i32") -> "f32":
    c = Circle(2.0)
    total = 0.0
    i = 0
    while i < n:
        total = total + c.area
        i = i + 1
    return total
