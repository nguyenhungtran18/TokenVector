def double_it(x: "i32") -> "i32":
    return x * 2


def compose(f: "func(i32)->i32") -> "func(i32)->i32":
    extra = 10

    def wrapped(x: "i32") -> "i32":
        nonlocal f, extra
        return f(x) + extra

    return wrapped


def bench_b3(n: "i32") -> "i32":
    g = compose(double_it)
    total = 0
    i = 0
    while i < n:
        total = total + (g(i) % 1000)
        i = i + 1
    return total
