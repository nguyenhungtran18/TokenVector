# Diem vao cua trinh bien dich TU-HOST (2026-09-25): `tkvc <nguon.tkv> <ra.exe>
# [ten_ham_vao]` hoac `tkvc @ds.txt` (hang loat). Gop SAU ban gop 117 file (xem _scratch/dung_tv.py) - khong
# nam trong cay .py vi CPython da co tkv.py (argparse/pathlib) lam CLI.


def dich_mot(nguon: "str", ra: "str", vao: "str") -> "i32":
    """Dich mot nguon; in ket qua. Tra 0 neu dich duoc, 1 neu loi (khong nem ngoai le ra ngoai)."""
    try:
        ra_exe = compile_tkv_cli(nguon, ra, vao)
        print("[tkvc] da dich: " + ra_exe)
        return 0
    except CliError as e:
        print("[tkvc] loi: " + nguon + ": " + str(e))
        return 1
    except TranspileError as e:
        print("[tkvc] loi dich: " + nguon + ": " + str(e))
        return 1
    except Exception as e:
        print("[tkvc] loi: " + nguon + ": " + str(e))
        return 1


def dich_lo(duong_ds: "str") -> "i32":
    """Che do HANG LOAT: `tkvc @ds.txt` - moi dong 'nguon<TAB>ra.exe<TAB>ten_ham_vao' (cot 3 co the vang).
    Dich lan luot trong MOT tien trinh (khoi dong trinh bien dich chi tra 1 lan). Tra so nguon loi."""
    loi = 0
    for dong in read_file(duong_ds).replace(chr(13), "").split(chr(10)):
        if dong.strip() == "":
            continue
        f = dong.split(chr(9))
        if len(f) < 2:
            print("[tkvc] dong sai dinh dang: " + dong)
            loi = loi + 1
            continue
        vao = None
        if len(f) >= 3 and f[2] != "":
            vao = f[2]
        loi = loi + dich_mot(f[0], f[1], vao)
    return loi


def main() -> "i32":
    ds = sys_argv()
    if len(ds) == 2 and ds[1].startswith("@"):
        arg1 = ds[1]
        so_loi = dich_lo(arg1[1:])
        if so_loi > 0:
            return 1
        return 0
    if len(ds) < 3:
        print("dung: tkvc <nguon.tkv> <ra.exe> [ten_ham_vao]  |  tkvc @ds.txt")
        return 2
    vao = None
    if len(ds) >= 4:
        vao = ds[3]
    return dich_mot(ds[1], ds[2], vao)
