# --- doc gia tri mot o arena (P8 Task 6 lo 3a) ------------------------


def _ar_ten_gan(pool: "list[str]", nid: "i32") -> "str":
    """Ten bien cua mot phep gan `X = ...` co DUNG MOT dich la TEN DON;
    None trong moi truong hop khac.

    `assign` co kids = [dich..., GIA TRI] nen dung 1 dich thi len(kids)==2.
    Gop phep thu nay lai mot cho vi TRUOC DAY moi nhanh pragma trong
    `_parse_program_ast` lap lai y het bon dong isinstance giong nhau."""
    if nid < 0 or ar_kind(pool, nid) != "assign":
        return None
    con = ar_kids(pool, nid)
    if len(con) != 2 or con[0] < 0 or ar_kind(pool, con[0]) != "name":
        return None
    return ar_col_a(pool, con[0])


def _ar_ten_import(pool: "list[str]", nid: "i32") -> "list[str]":
    """Ten cac module trong mot dong `import a, b as c`.

    Cot b la CSV dang 'ten' hoac 'ten:bi_danh' (da do). Lay TEN THAT, bo
    bi danh - dung nhu ban cu doc `alias.name` chu khong phai `asname`."""
    ra = []
    for muc in ar_csv_names(ar_col_b(pool, nid)):
        if not muc:
            continue
        ra.append(muc.split(":")[0])
    return ra


def _ar_module_importfrom(pool: "list[str]", nid: "i32") -> "str":
    """Ten module cua `from X import ...`; chuoi RONG neu la import tuong
    doi (`from . import x`).

    Cot a giu ca dau cham dan duong ('.', '..pkg'). `_ast_materialize` doc
    no bang `a.lstrip(".") or None`, nen o day dung DUNG mot luat do - lech
    di thi 'from . import x' se bi ghi nhan thanh mot module ten '.'."""
    return ar_col_a(pool, nid).lstrip(".")


def _la_goi_namedtuple(pool: "list[str]", nid: "i32") -> "i32":
    """True neu `nid` la loi goi `namedtuple(...)` hoac `X.namedtuple(...)`."""
    if nid < 0 or ar_kind(pool, nid) != "call":
        return False
    con = ar_kids(pool, nid)
    if not con or con[0] < 0:
        return False
    f = con[0]
    kf = ar_kind(pool, f)
    if kf == "name":
        return ar_col_a(pool, f) == 'namedtuple'
    if kf == "attr":
        return ar_col_a(pool, f) == 'namedtuple'
    return False


def _ar_ann_gan_co_gia_tri(pool: "list[str]", nid: "i32") -> "i32":
    """True neu `annassign` co dich la TEN DON va CO gia tri khoi tao.

    kids = [dich, annotation, GIA TRI]; -1 o cho gia tri = khong khoi tao."""
    con = ar_kids(pool, nid)
    if len(con) < 3 or con[2] < 0:
        return False
    return con[0] >= 0 and ar_kind(pool, con[0]) == "name"


def _ar_ten_loai(pool: "list[str]", nid: "i32") -> "str":
    """Ten loai node de DUA VAO THONG BAO LOI.

    TRUOC P8 Task 6: `ast.dump(node)` / `type(node).__name__` - in ra cau
    truc AST NOI BO cua compiler, thu ma nguoi viet TokenVector khong co khai
    niem gi. Nay in `kind` cua arena ('subscript', 'binop', ...): ngan hon va
    DE HIEU HON. Day la thay doi NGUOI DUNG THAY DUOC, co chu dich."""
    if nid < 0:
        return "<vang mat>"
    return ar_kind(pool, nid)


def _hang_so_co_kieu(pool: "list[str]", nid: "i32") -> "(str,str)":
    """(dtype, van ban) cua mot o `const_num` (2026-09-24) - thay cho gia tri
    Python int|float (union). CUNG luat voi `_ast_materialize._number`; van
    ban = str() cua gia tri do (str(float) == repr(float)), nen moi noi doc cu
    `str(v)` / `repr(v)` ra DUNG chuoi nhu truoc. So phuc: bao loi (xem duoi)."""
    clean = ar_col_a(pool, nid).replace("_", "")
    low = clean.lower()
    if low.startswith("0x") or low.startswith("-0x"):
        return ('i32', str(int(clean, 16)))
    if low.startswith("0o") or low.startswith("-0o"):
        return ('i32', str(int(clean, 8)))
    if low.startswith("0b") or low.startswith("-0b"):
        return ('i32', str(int(clean, 2)))
    if low.endswith("j"):
        # So phuc lam HANG cap module: truoc day roi vao nhanh 'i32' voi van
        # ban '(1+2j)' - IL sai AM THAM. Bao loi ro thay vi giu hanh vi sai.
        raise TranspileError(
            "hang so cap module kieu so phuc (" + clean + ") chua ho tro")
    if "." in clean or "e" in low:
        return ('f64', str(float(clean)))
    return ('i32', str(int(clean)))


def _annotation_to_type_str(pool: "list[str]", nid: "i32", ctx_name: "str") -> "str":
    if nid >= 0 and ar_kind(pool, nid) == "const_str":
        return ar_col_a(pool, nid)
    raise TranspileError(
        f"{ctx_name}: annotation phai la STRING kieu DSL (vd x: \"f32[4]\", -> \"f32\"), "
        f"gap {_ar_ten_loai(pool, nid)}")


def _default_literal_to_str(pool: "list[str]", nid: "i32", ctx_name: "str") -> "str":
    """Doi 1 gia tri mac dinh trong arena (vd 'b: "i32" = 10' hoac '= -5'
    hoac '= "Hello"') sang van ban literal ma typed_dsl_parser.py's tokenizer
    hieu duoc - CHI ho tro so (int/float, ke ca am) va chuoi/bool/None.

    P8 Task 6: arena TACH SAN cac loai (const_num/const_bool/const_none/
    const_str) nen khong con canh 'bool la lop con cua int' cua Python - thu
    tung buoc phai dat nhanh bool TRUOC nhanh int/float de tranh."""
    if nid < 0:
        raise TranspileError(f"{ctx_name}: thieu gia tri mac dinh")
    kind = ar_kind(pool, nid)
    if kind == "unaryop" and ar_col_a(pool, nid) == "-":
        con = ar_kids(pool, nid)
        if con and con[0] >= 0 and ar_kind(pool, con[0]) == "const_num":
            return '-' + _hang_so_co_kieu(pool, con[0])[1]
    if kind == "const_num":
        return _hang_so_co_kieu(pool, nid)[1]
    if kind == "const_str":
        return f'"{ar_col_a(pool, nid)}"'
    if kind == "const_bool":
        # True/False -> 1/0 (P8 Task 7, 2026-09-09). KHONG phai quy uoc moi:
        # il_core._ExprParser da doi True/False thanh hang so 1/0 tu 2026-08-03
        # ("DSL nay chi co so 0/1 lam gia tri chan ly"). Cho nay chi la mat xich
        # con thieu de quy uoc do dung duoc o GIA TRI MAC DINH.
        return '1' if ar_col_a(pool, nid) == "True" else '0'
    if kind == "const_none":
        # 'None' - tham chieu rong; typed_dsl_parser.parse_default_literal doi
        # thanh ('null',), codegen di qua _expr_null -> ldnull.
        return 'None'
    raise TranspileError(
        f"{ctx_name}: gia tri mac dinh chi ho tro literal so/chuoi/None (khong tham chieu bien), "
        f"gap {_ar_ten_loai(pool, nid)}")


INFERRED_DTYPE_MARKER = 'inferred'


class ThamSo:
    """Bang tham so cua mot funcdef, do tu arena (xem _ar_tham_so)."""

    ten: "list[str]"
    nid: "list[i32]"
    vararg: "str"
    vararg_nid: "i32"
    kwarg: "str"
    kwarg_nid: "i32"
    kwonly: "list[str]"
    kwonly_nid: "list[i32]"

    def __init__(self):
        self.ten = []
        self.nid = []
        self.vararg = None
        self.vararg_nid = -1
        self.kwarg = None
        self.kwarg_nid = -1
        self.kwonly = []
        self.kwonly_nid = []


def _ar_tham_so(pool: "list[str]", fn_nid: "i32") -> "ThamSo":
    """Bang tham so cua mot `funcdef`/`asyncfuncdef`, DO tu arena.

    Bo cuc (da DO, khong doan): cot b la CSV ten tham so CO DAU ('a,*rest',
    'a,**kw', 'a,*,b'), kids = [block, ret_ann, arg_meta...], moi `arg_meta`
    co col_a=ten va kids=[annotation, default] (-1 = vang).

    Dau '*' TRAN la mot token RIENG va KHONG chiem o arg_meta - no chi danh
    dau ranh gioi keyword-only. (Ban dau bo ma hoa ghi 'a,*,,b' va sinh mot
    o rac ten ',' vi parser tuong '*' luon co ten theo sau; da sua tan goc
    trong tkv_parser._parse_params.)

    Tra ve ThamSo (2026-09-25; truoc la dict KHONG dong nhat khai sai
    'dict[str,list[str]]' - ban tu-host cat int vao o list -> AccessViolation):
    ten (list ten thuong), nid (list o arg_meta tuong ung), vararg/kwarg (ten
    hoac None) + nid cua chung, kwonly (list ten)."""
    con = ar_kids(pool, fn_nid)
    metas = con[2:]
    ra = ThamSo()
    i = 0                      # chi so o arg_meta
    sau_sao = False            # da qua '*' thi ten thuong la keyword-only
    for tk in ar_csv_names(ar_col_b(pool, fn_nid)):
        if tk == '*':
            sau_sao = True
            continue           # dau phan cach - KHONG chiem o arg_meta
        if tk == '/':
            continue           # het positional-only - cung KHONG chiem o
        m = metas[i] if i < len(metas) else -1
        i += 1
        if tk.startswith('**'):
            ra.kwarg = tk[2:]
            ra.kwarg_nid = m
        elif tk.startswith('*'):
            ra.vararg = tk[1:]
            ra.vararg_nid = m
            sau_sao = True
        elif sau_sao:
            ra.kwonly.append(tk)
            ra.kwonly_nid.append(m)
        else:
            ra.ten.append(tk)
            ra.nid.append(m)
    return ra


def _ar_ann_cua(pool: "list[str]", meta_nid: "i32") -> "i32":
    """Annotation cua mot o `arg_meta` (kids[0]); -1 neu khong co."""
    if meta_nid < 0:
        return -1
    con = ar_kids(pool, meta_nid)
    return con[0] if con else -1


def _ar_mac_dinh_cua(pool: "list[str]", meta_nid: "i32") -> "i32":
    """Gia tri mac dinh cua mot o `arg_meta` (kids[1]); -1 neu khong co.

    Arena giu default NGAY TRONG o tham so, nen luat 'canh phai' cua
    `ast.arguments.defaults` bien mat - do la ly do ban arena cua
    `_params_with_defaults` ngan hon han ban cu."""
    if meta_nid < 0:
        return -1
    con = ar_kids(pool, meta_nid)
    return con[1] if len(con) > 1 else -1


def _params_with_defaults(pool: "list[str]", ten_ts: "list[str]", nid_ts: "list[i32]", ctx_name: "str", allow_inferred: "i32"=False) -> "list[str]":
    """`ten_ts`/`nid_ts` la HAI danh sach song song (ten tham so, o arg_meta),
    da bo 'self' neu co (xem _extract_record_method_sig_line).

    Ban cu phai canh phai `func_node.args.defaults` voi danh sach tham so vi
    ast gom moi default vao MOT danh sach chung. Arena giu default NGAY
    TRONG o tham so, nen toan bo phep tinh chi so do bien mat.

    allow_inferred (Task 2/5, duck-typing-inference, 2026-08-17): True CHI
    cho ham top-level THAT - khi True VA tham so khong co annotation, KHONG
    raise loi ma gan INFERRED_DTYPE_MARKER ('inferred'). Mac dinh False,
    giu nguyen hanh vi cu o MOI diem goi khac (method, nested-def, macro)."""
    parts = []
    for i in range(len(ten_ts)):
        ten = ten_ts[i]
        meta = nid_ts[i]
        ann = _ar_ann_cua(pool, meta)
        mac_dinh = _ar_mac_dinh_cua(pool, meta)
        arg_name = _rename_reserved_identifiers(ten)
        if ann < 0:
            if not allow_inferred:
                raise TranspileError(f"{ctx_name}: tham so '{ten}' thieu annotation kieu DSL")
            t = INFERRED_DTYPE_MARKER
        else:
            t = _annotation_to_type_str(pool, ann, f"{ctx_name} tham so '{ten}'")
        if mac_dinh >= 0:
            lit = _default_literal_to_str(pool, mac_dinh, f"{ctx_name} tham so '{ten}'")
            parts.append(f"{arg_name}: {t} = {lit}")
        else:
            parts.append(f"{arg_name}: {t}")
    return parts


def _extract_signature_line(pool: "list[str]", fn_nid: "i32", allow_varargs: "i32"=False, allow_inferred: "i32"=False) -> "str":
    """allow_varargs (Phase 5.1, 2026-08-11): True CHI cho ham top-level -
    '*args: T'/'**kwargs: T' dong nhat kieu (xem parse_param trong
    typed_dsl_parser.py). Decorator/method van BI CHAN (goi voi
    allow_varargs=False, gioi han co y thuc - xem checklist).

    allow_inferred (Task 2/5, duck-typing-inference, 2026-08-17): True CHI
    cho ham top-level THAT - truyen xuong _params_with_defaults, cho phep
    tham so thuong (khong phai *args/**kwargs) thieu annotation duoc gan
    dtype 'inferred'. Mac dinh False."""
    ten_ham = ar_col_a(pool, fn_nid)
    ts = _ar_tham_so(pool, fn_nid)
    if ts.kwonly:
        raise TranspileError(f"ham '{ten_ham}': chua ho tro tham so keyword-only")
    if not allow_varargs and (ts.vararg is not None or ts.kwarg is not None):
        raise TranspileError(f"ham '{ten_ham}': chi ho tro tham so thuong (khong *args/**kwargs/keyword-only)")
    parts = _params_with_defaults(pool, ts.ten, ts.nid, f"ham '{ten_ham}'",
                                  allow_inferred=allow_inferred)
    if allow_varargs:
        if ts.vararg is not None:
            ann = _ar_ann_cua(pool, ts.vararg_nid)
            if ann < 0:
                raise TranspileError(f"ham '{ten_ham}': '*{ts.vararg}' thieu annotation kieu DSL")
            t = _annotation_to_type_str(pool, ann, f"ham '{ten_ham}' tham so '*{ts.vararg}'")
            parts.append(f"*{_rename_reserved_identifiers(ts.vararg)}: {t}")
        if ts.kwarg is not None:
            ann = _ar_ann_cua(pool, ts.kwarg_nid)
            if ann < 0:
                raise TranspileError(f"ham '{ten_ham}': '**{ts.kwarg}' thieu annotation kieu DSL")
            t = _annotation_to_type_str(pool, ann, f"ham '{ten_ham}' tham so '**{ts.kwarg}'")
            parts.append(f"**{_rename_reserved_identifiers(ts.kwarg)}: {t}")
    # 'async def' (Phase 4, 2026-08-11) - prefix 'async' vao dong chu ky VAN
    # BAN de typed_dsl_parser.py's parse_signature nhan dien (Signature.is_async).
    prefix = "async " if ar_kind(pool, fn_nid) == "asyncfuncdef" else ""
    func_name = _rename_reserved_identifiers(ten_ham)
    ret_ann = ar_kids(pool, fn_nid)[1]      # kids = [block, ret_ann, arg_meta...]
    if ret_ann < 0:
        # P6 (2026-09-08): ham KHONG tra ve gia tri thi khong bat khai bao
        # kieu tra ve - '-> void' la thong tin THUA, bat go no khong lam
        # chuong trinh an toan hon. Ha tang da san sang tu truoc: chu ky
        # thieu '-> ret' duoc typed_dsl_parser chap nhan (return_type=None)
        # va il_codegen sinh '.method ... void ...' + 'ret' cho nhanh do.
        # Ham CO tra gia tri VAN bat buoc khai bao: do la cho khai bao mang
        # thong tin that va giu thong bao loi ro rang.
        if _returns_a_value(pool, fn_nid):
            raise TranspileError(
                f"ham '{ten_ham}': thieu return-type annotation (vd -> \"f32\":). "
                f"Chi ham KHONG tra ve gia tri moi duoc bo qua annotation nay.")
        return f"{prefix}{func_name}({', '.join(parts)}):"
    ret_t = _annotation_to_type_str(pool, ret_ann, f"ham '{ten_ham}' return type")
    return f"{prefix}{func_name}({', '.join(parts)}) -> {ret_t}:"


# Dat truoc _ten_trong_kieu (2026-09-29): ban tu-host doc hang cap module theo
# THU TU, dung truoc khi khai bao thi bao 'chua duoc khai bao'.
_CHU_DINH_DANH = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_'
_SO_DINH_DANH = '0123456789'

_TABLE_ELEM_OK: "list[str]" = ['i32', 'i64', 'f32', 'f64', 'str']


def _ten_trong_kieu(gdtype: "str") -> "set[str]":
    """Moi dinh danh xuat hien trong mot chuoi kieu.

    Dung lam `record_names` khi parse kieu cua BANG DIEU PHOI cap module:
    gia tri cua bang la `func(TkvNode,Scope,...)`, ma cac ten handle do
    den tu `__tkv_import__` - CHUA phan giai duoc o thi extract (module
    duoc import chi nap ve sau). Nen o day chi can parse DUOC hinh dang;
    phan giai THAT xay ra o `_table_init_lines`, noi co `records` va
    `func_table` day du - mot ten bia dat se chet o do, khong lot luoi.
    """
    # Quet tay (2026-09-25) thay re.findall(r'[A-Za-z_][A-Za-z_0-9]*') - cung
    # tap ten; ban tu-host chua co findall.
    ten_kieu = set()
    cur = ''
    for c in (gdtype or ''):
        if c in _CHU_DINH_DANH or (cur != '' and c in _SO_DINH_DANH):
            cur = cur + c
        else:
            if cur != '':
                ten_kieu.add(cur)
            cur = ''
    if cur != '':
        ten_kieu.add(cur)
    return ten_kieu


def _co_khoa_am(cap: "list[(i32,i32)]") -> "i32":
    """1 neu literal dict co khoa am ('**' mo rong) - thay
    'any([k < 0 for k, _v in cap])' (2026-09-29): comprehension giai tuple
    chua suy duoc kieu phan tu o ban tu-host."""
    for k, _v in cap:
        if k < 0:
            return 1
    return 0


def _o_bang_hang(pool: "list[str]", gname: "str", el_nid: "i32", vai: "str") -> "str":
    """Gia tri hang so/chuoi cua mot phan tu bang hang cap module (2026-09-29:
    nang tu ham long - ban tu-host khong suy duoc kieu tra ve cua ham long)."""
    if el_nid < 0:
        raise TranspileError(
            f"bang hang cap module '{gname}': moi {vai} phai la hang so/chuoi "
            f"don gian (bang nay duoc dung TRUOC khi chuong trinh chay)")
    k = ar_kind(pool, el_nid)
    if k == "const_num":
        return _hang_so_co_kieu(pool, el_nid)[1]
    if k == "const_str":
        return ar_col_a(pool, el_nid)
    # const_bool bi loai CO Y (giong ban cu: `isinstance(el.value, bool)`
    # bi tu choi) - bang hang khong nhan True/False.
    raise TranspileError(
        f"bang hang cap module '{gname}': moi {vai} phai la hang so/chuoi "
        f"don gian (bang nay duoc dung TRUOC khi chuong trinh chay)")


def _module_table_value(pool: "list[str]", gname: "str", gdtype: "str", v_nid: "i32") -> "list[list[str]]":
    """Gia tri cua mot BANG HANG cap module ('list[T]'/'set[T]' = literal).

    Tra ve list Python cac hang so - dung de sinh IL khoi tao thang trong
    Main (xem _global_init_lines), khong qua tang bieu thuc: moi phan tu
    deu la hang so nen khong can scope/ctx.

    Thu hep pham vi CO Y: chi 'list'/'set' phan tu vo huong. 'dict' hang
    CHUA lam duoc vi ngon ngu chua co dict literal co noi dung
    ('d = {"a": 1}' khong tokenize duoc) - do la mot tinh nang rieng."""
    try:
        ta = _parse_type_ann_str(gdtype or '')
    except SyntaxError:
        # Co the la bang dieu phoi 'dict[K, func(<ten handle>...)]' - xem
        # _ten_trong_kieu.
        ta = _parse_type_ann_str(gdtype or '', record_names=_ten_trong_kieu(gdtype))
        if not (ta.shape_ten == 'dict' and ta.elem_ta is not None
                and ta.elem_ta.shape_ten == 'func'):
            raise
    if ta.shape_ten not in ('list', 'set', 'dict'):
        raise TranspileError(
            f"bien module-level '{gname}': kieu {gdtype!r} chua ho tro o cap module. "
            f"Hien ho tro: kieu vo huong (i32/i64/f32/f64/str) va BANG HANG "
            f"'list[T]'/'set[T]'/'dict[K,V]' voi K/V vo huong.")
    # Bang RONG ('X: "list[list[i32]]" = []', 2026-09-25): khong co phan tu nao
    # de kiem - kieu long nhau chi can o `newobj` (il_type_str lo). Day la
    # hinh dang cua stmt_row._BODIES.
    if (ta.elem_ta is not None and v_nid >= 0 and ar_kind(pool, v_nid) in ('list', 'set', 'dict')
            and len(ar_kids(pool, v_nid)) == 0):
        return []
    if ta.elem_ta is not None and not (
            (ta.shape_ten == 'dict' and ta.elem_ta.shape_ten in ('func', 'tuple', 'set'))
            or (ta.shape_ten == 'list' and ta.elem_ta.shape_ten == 'tuple')):
        # Ngoai le `dict[K, func(...)]` (bang dieu phoi) - xu ly rieng ben
        # duoi, sau khi `_o_bang_hang` da co.
        # `dict[str, list[str]]` / `list[list[i32]]`... - `dtype` luc nay chi
        # la SENTINEL (kieu that nam trong elem_ta) nen phep kiem
        # `ta.dtype in _TABLE_ELEM_OK` o duoi se cho QUA nham, roi sinh
        # IL day mot chuoi vao mot o kieu List<string> - sai kieu AM THAM.
        # Ca am trong test/verify/module_table_test.py bat duoc dieu nay.
        raise TranspileError(
            f"bang hang cap module '{gname}': kieu {gdtype!r} long container - "
            f"chua ho tro. Bang hang chi nhan phan tu/khoa/gia tri VO HUONG "
            f"({'/'.join(_TABLE_ELEM_OK)}).")

    if (ta.shape_ten == 'dict' and ta.elem_ta is not None
            and ta.elem_ta.shape_ten == 'func'):
        # BANG DIEU PHOI cap module: `{'upper': compile_upper, ...}`. Gia tri
        # KHONG phai hang so ma la TEN MOT HAM - IL sinh ldftn+newobj o
        # _table_init_lines (cung idiom voi il_codegen._compile_funcref_arg).
        # Day la hinh dang cua 3 bang STR_METHODS* trong cay tu-host.
        if v_nid < 0 or ar_kind(pool, v_nid) != "dict":
            raise TranspileError(
                f"bang dieu phoi cap module '{gname}': gia tri phai la literal "
                f"{{...}} viet thang tai cho")
        if ta.key_dtype not in _TABLE_ELEM_OK:
            raise TranspileError(
                f"bang dieu phoi cap module '{gname}': khoa kieu {ta.key_dtype!r} "
                f"chua ho tro - chi {'/'.join(_TABLE_ELEM_OK)}")
        cap = _ar_cap_dict(pool, v_nid)
        if _co_khoa_am(cap):
            raise TranspileError(
                f"bang dieu phoi cap module '{gname}': khong ho tro '**' trong literal")
        ra: "list[list[str]]" = []
        for k, v in cap:
            if v < 0 or ar_kind(pool, v) != 'name':
                raise TranspileError(
                    f"bang dieu phoi cap module '{gname}': moi gia tri phai la TEN "
                    f"MOT HAM top-level viet thang (khong phai lambda/bieu thuc)")
            ra.append([_o_bang_hang(pool, gname, k, 'khoa'), ar_col_a(pool, v)])
        return ra

    if ta.shape_ten == 'dict' and ta.elem_ta is not None and ta.elem_ta.shape_ten == 'set':
        # BANG HANG dict-gia-tri-SET: `{'int': {'i32','i64'}, ...}` - hinh
        # dang cua typecheck._PY_SCALAR_ALIASES.
        if ta.key_dtype not in _TABLE_ELEM_OK or ta.elem_ta.dtype not in _TABLE_ELEM_OK:
            raise TranspileError(
                f"bang hang cap module '{gname}': khoa/phan tu set phai vo huong "
                f"- chi {'/'.join(_TABLE_ELEM_OK)}")
        if v_nid < 0 or ar_kind(pool, v_nid) != 'dict':
            raise TranspileError(
                f"bang hang cap module '{gname}': gia tri phai la literal "
                f"{{...}} viet thang tai cho")
        cap = _ar_cap_dict(pool, v_nid)
        if _co_khoa_am(cap):
            raise TranspileError(
                f"bang hang cap module '{gname}': khong ho tro '**' trong literal")
        ra: "list[list[str]]" = []
        for k, v in cap:
            if v < 0 or ar_kind(pool, v) != 'set':
                raise TranspileError(
                    f"bang hang cap module '{gname}': moi gia tri phai la mot "
                    f"set viet thang tai cho (vd {{'a', 'b'}})")
            hang: "list[str]" = [_o_bang_hang(pool, gname, k, 'khoa')]
            for e in ar_kids(pool, v):
                hang.append(_o_bang_hang(pool, gname, e, 'phan tu set'))
            ra.append(hang)
        return ra

    if ta.shape_ten == 'dict' and ta.elem_ta is not None and ta.elem_ta.shape_ten == 'tuple':
        # BANG HANG dict-gia-tri-tuple: `{'i32': ('int32', 'ReadInt32'), ...}`.
        # Cung ho hang voi list-cua-tuple ben duoi - hinh dang cua
        # pickle_feature._SPECS.
        dts = ta.elem_ta.tuple_dtypes
        if ta.key_dtype not in _TABLE_ELEM_OK:
            raise TranspileError(
                f"bang hang cap module '{gname}': khoa kieu {ta.key_dtype!r} "
                f"chua ho tro - chi {'/'.join(_TABLE_ELEM_OK)}")
        for t in dts:
            if t not in _TABLE_ELEM_OK:
                raise TranspileError(
                    f"bang hang cap module '{gname}': phan tu tuple kieu {t!r} "
                    f"chua ho tro - chi {'/'.join(_TABLE_ELEM_OK)}")
        if v_nid < 0 or ar_kind(pool, v_nid) != 'dict':
            raise TranspileError(
                f"bang hang cap module '{gname}': gia tri phai la literal "
                f"{{...}} viet thang tai cho")
        cap = _ar_cap_dict(pool, v_nid)
        if _co_khoa_am(cap):
            raise TranspileError(
                f"bang hang cap module '{gname}': khong ho tro '**' trong literal")
        ra: "list[list[str]]" = []
        for k, v in cap:
            if v < 0 or ar_kind(pool, v) != 'tuple':
                raise TranspileError(
                    f"bang hang cap module '{gname}': moi gia tri phai la mot "
                    f"tuple viet thang tai cho (vd ('a', 'b'))")
            con = ar_kids(pool, v)
            if len(con) != len(dts):
                raise TranspileError(
                    f"bang hang cap module '{gname}': tuple co {len(con)} phan tu, "
                    f"kieu khai {len(dts)}")
            hang: "list[str]" = [_o_bang_hang(pool, gname, k, 'khoa')]
            for c in con:
                hang.append(_o_bang_hang(pool, gname, c, 'phan tu tuple'))
            ra.append(hang)
        return ra

    if ta.shape_ten == 'dict':
        for t, vai in ((ta.key_dtype, 'khoa'), (ta.dtype, 'gia tri')):
            if t not in _TABLE_ELEM_OK:
                raise TranspileError(
                    f"bang hang cap module '{gname}': {vai} kieu {t!r} chua ho tro - "
                    f"chi {'/'.join(_TABLE_ELEM_OK)}")
        if v_nid < 0 or ar_kind(pool, v_nid) != "dict":
            raise TranspileError(
                f"bang hang cap module '{gname}': gia tri phai la literal "
                f"{{...}} viet thang tai cho")
        cap = _ar_cap_dict(pool, v_nid)
        if _co_khoa_am(cap):
            raise TranspileError(
                f"bang hang cap module '{gname}': khong ho tro '**' trong literal")
        ra_kv: "list[list[str]]" = []
        for k, v in cap:
            ra_kv.append([_o_bang_hang(pool, gname, k, 'khoa'), _o_bang_hang(pool, gname, v, 'gia tri')])
        return ra_kv

    if ta.shape_ten == 'list' and ta.elem_ta is not None and ta.elem_ta.shape_ten == 'tuple':
        # BANG HANG LIST-CUA-TUPLE: `[('a', 'x'), ('b', 'y')]`. Moi phan tu
        # la mot tuple HANG SO viet thang tai cho - hinh dang cua
        # stdlib_json._JSON_ESCAPES va stdlib_http_full._RESTRICTED_SETTERS.
        dts = ta.elem_ta.tuple_dtypes
        for t in dts:
            if t not in _TABLE_ELEM_OK:
                raise TranspileError(
                    f"bang hang cap module '{gname}': phan tu tuple kieu {t!r} "
                    f"chua ho tro - chi {'/'.join(_TABLE_ELEM_OK)}")
        if v_nid < 0 or ar_kind(pool, v_nid) != 'list':
            raise TranspileError(
                f"bang hang cap module '{gname}': gia tri phai la literal "
                f"[...] viet thang tai cho")
        ra: "list[list[str]]" = []
        for el in ar_kids(pool, v_nid):
            if el < 0 or ar_kind(pool, el) != 'tuple':
                raise TranspileError(
                    f"bang hang cap module '{gname}': moi phan tu phai la mot "
                    f"tuple viet thang tai cho (vd ('a', 'b'))")
            con = ar_kids(pool, el)
            if len(con) != len(dts):
                raise TranspileError(
                    f"bang hang cap module '{gname}': tuple co {len(con)} phan tu, "
                    f"kieu khai {len(dts)}")
            hang_tuple: "list[str]" = []
            for c in con:
                hang_tuple.append(_o_bang_hang(pool, gname, c, 'phan tu tuple'))
            ra.append(hang_tuple)
        return ra

    if ta.dtype not in _TABLE_ELEM_OK:
        raise TranspileError(
            f"bang hang cap module '{gname}': phan tu kieu {ta.dtype!r} chua ho tro - "
            f"chi {'/'.join(_TABLE_ELEM_OK)}")
    want = 'list' if ta.shape_ten == 'list' else 'set'
    # `set()` / `frozenset()` KHONG THAM SO = set RONG. Ngon ngu khong co cu
    # phap set rong ('{}' la dict), nen day la LO HONG cu phap chu khong phai
    # lua chon thiet ke: khong nhan thi mot `set[T]` rong cap module khong co
    # cach nao viet duoc. Chi nhan khi KHONG co doi so - `set([1,2])` van bi
    # tu choi vi phan tu se phai di qua tang bieu thuc.
    if want == 'set' and v_nid >= 0 and ar_kind(pool, v_nid) == 'call':
        con_goi = ar_kids(pool, v_nid)
        ham = con_goi[0] if con_goi else -1
        if ham >= 0 and ar_kind(pool, ham) == 'name'                 and ar_col_a(pool, ham) in ('set', 'frozenset') and len(con_goi) == 1:
            return []
    if v_nid < 0 or ar_kind(pool, v_nid) != want:
        raise TranspileError(
            f"bang hang cap module '{gname}': gia tri phai la literal "
            f"{'[...]' if ta.shape_ten == 'list' else '{...}'} viet thang tai cho")
    ra_pt: "list[list[str]]" = []
    for el in ar_kids(pool, v_nid):
        ra_pt.append([_o_bang_hang(pool, gname, el, 'phan tu')])
    return ra_pt


# Module chuan cua Python ma TokenVector KHONG resolve (P6, 2026-09-08).
#
# TokenVector khong co 'qualified access' ('re.match(...)'): moi thu vien
# chuan di qua builtin ham thang (`re_match`/`os_list_files`/...). Nhung
# file nguon VAN phai la Python CHAY DUOC - va Python thi CAN `import re`
# de dong `_RE = re.compile(...)` hoat dong. Do tren cay tu-host: 37 file
# co `import re`, va truoc thay doi nay MOI file trong so do deu hong ngay
# o dong import (TokenVector di tim mot module TokenVector ten 're').
#
# Cho nen: bo qua han cac ten duoi day. Chung KHONG duoc dem la lenh cap
# module (Import von da duoc bo qua) nhung VAN chan bien dich - mot rao can
# ma cong dem lenh cap module khong nhin thay, phat hien khi thu bien dich
# THAT mot file co `import re`.
_STDLIB_SHIM_MODULES: "set[str]" = {
    're', 'os', 'sys', 'math', 'json', 'random', 'time', 'io',
    'base64', 'hashlib', 'shutil', 'zipfile', 'sqlite3', 'itertools',
    'functools', 'subprocess', 'pathlib', 'datetime', 'string',
}


def _la_khoi_chi_cpython(pool: "list[str]", nid: "i32") -> "i32":
    """`if __tkv_chi_cpython__:` (khong co else) - khoi lenh chi chay duoi CPython."""
    con = ar_kids(pool, nid)
    if len(con) < 3 or con[2] >= 0 or con[0] < 0:
        return False
    return ar_kind(pool, con[0]) == "name" and ar_col_a(pool, con[0]) == "__tkv_chi_cpython__"


def _la_khoi_main(pool: "list[str]", nid: "i32") -> "i32":
    """`if __name__ == '__main__':` (khong co `elif`/`else`).

    Arena: `if` co kids = [test, block_then, block_else]; -1 = khong co else."""
    con = ar_kids(pool, nid)
    if len(con) < 3 or con[2] >= 0:
        return False
    t = con[0]
    if t < 0 or ar_kind(pool, t) != "compare":
        return False
    if ar_col_b(pool, t) != "==":
        return False
    hang = ar_kids(pool, t)
    if len(hang) != 2:
        return False
    trai, phai = hang[0], hang[1]
    if trai < 0 or ar_kind(pool, trai) != "name" or ar_col_a(pool, trai) != "__name__":
        return False
    return phai >= 0 and ar_kind(pool, phai) == "const_str" \
        and ar_col_a(pool, phai) == "__main__"


def _module_const_extra(pool: "list[str]", nid: "i32", module_consts: "dict[str,(str,str)]"=None) -> "(str,str)":
    """Gia tri cua mot HANG SO cap module ma dong `const_*` khong phu, hoac
    None neu node khong thuoc dang do.

    Hai dang, deu tinh duoc NGAY LUC BIEN DICH:
      - `-<so>` (unaryop): dong `const_num` khong bao gom dau am.
      - f-string ma MOI phan thay the la mot hang so module DA BIET.
    Truyen `module_consts` de tra cuu; goi voi None chi de HOI "co phai dang
    nay khong" (dung o dieu kien `elif`)."""
    if nid < 0 or ar_kind(pool, nid) != "assign":
        return None
    con = ar_kids(pool, nid)
    # kids = [dich..., GIA TRI]; dung 1 dich va dich phai la `name`.
    if len(con) != 2 or con[0] < 0 or ar_kind(pool, con[0]) != "name":
        return None
    v = con[1]
    if v < 0:
        return None
    kind_v = ar_kind(pool, v)
    if kind_v == "unaryop" and ar_col_a(pool, v) == "-":
        vcon = ar_kids(pool, v)
        if vcon and vcon[0] >= 0 and ar_kind(pool, vcon[0]) == "const_num":
            # (dtype, van ban) cua GIA TRI AM - doi dau GIA TRI roi str() de
            # ra dung chuoi cu `str(-v)` (vd -0 -> '0', -0.0 -> '-0.0').
            _dt, _tx = _hang_so_co_kieu(pool, vcon[0])
            if _dt == 'f64':
                return ('f64', str(-float(_tx)))
            return (_dt, str(-int(_tx)))
        return None
    if kind_v == "joinedstr":
        parts = []
        for x in ar_kids(pool, v):
            if x < 0:
                return None
            kx = ar_kind(pool, x)
            if kx == "const_str":
                parts.append(ar_col_a(pool, x))
                continue
            if kx != "formatted_value":
                return None
            # Cot a = conversion ('r'/'s'/'a'), cot b = format_spec. Ban cu
            # doi `x.conversion == -1 and x.format_spec is None` - o arena
            # tuong ung voi CA HAI cot RONG (da do: chuyen doi '!r' -> cot a 'r',
            # dinh dang '>3' -> cot b '>3'; viet bang chu vi macro f-string
            # doc ca dong chu thich chua dau ngoac nhon).
            if ar_col_a(pool, x) or ar_col_b(pool, x):
                return None
            xcon = ar_kids(pool, x)
            if not xcon or xcon[0] < 0 or ar_kind(pool, xcon[0]) != "name":
                return None
            ten = ar_col_a(pool, xcon[0])
            if module_consts is None:
                parts.append("")          # chi dang HOI dang, chua can gia tri
            elif ten in module_consts:
                parts.append(module_consts[ten][1])
            else:
                return None               # tham chieu ten CHUA biet -> khong phai hang
        return ('str', "".join(parts))
    return None


def doi_nhom_dat_ten(pat: "str") -> "str":
    """`(?P<ten>...)` (Python) -> `(?<ten>...)` (.NET).

    .NET KHONG hieu dang cua Python va nem `ArgumentException:
    Unrecognized grouping construct` LUC CHAY - dich van sach, nen
    khong cong nao o tang dich bat duoc. Ban gop tu-host co 19 cho
    dung dang nay."""
    return pat.replace("(?P<", "(?<")


def _re_compile_pattern(pool: "list[str]", nid: "i32", module_consts: "dict[str,(str,str)]"=None) -> "str":
    """Chuoi pattern cua `X = re.compile("...")` o cap module, hoac None.

    CHI nhan dang don gian nhat: dung MOT doi so va doi so do la chuoi
    literal. Dang co co (`re.compile(p, re.S)`) va dang noi chuoi chua ho
    tro - 93/100 truong hop trong cay tu-host thuoc dang nay."""
    if nid < 0 or ar_kind(pool, nid) != "assign":
        return None
    con = ar_kids(pool, nid)
    # assign: kids = [muc tieu..., GIA TRI] - gia tri o CUOI
    if len(con) != 2 or con[0] < 0 or ar_kind(pool, con[0]) != "name":
        return None
    v = con[1]
    if v < 0 or ar_kind(pool, v) != "call":
        return None
    # cot b = MOT o cho MOI doi so, rong neu doi so do la VI TRI (da do:
    # 'f(1,2)' -> ',', 'f(1, k=2)' -> ',k'). Nen "co doi so tu khoa" la
    # "co o KHAC RONG", khong phai "cot b khac rong".
    if any([t != '' for t in ar_csv_names(ar_col_b(pool, v))]):
        return None
    cv = ar_kids(pool, v)          # call: kids = [ham, doi so...]
    f = cv[0] if cv else -1
    if f < 0 or ar_kind(pool, f) != "attr" or ar_col_a(pool, f) != "compile":
        return None
    fk = ar_kids(pool, f)
    if not fk or fk[0] < 0 or ar_kind(pool, fk[0]) != "name" \
            or ar_col_a(pool, fk[0]) != "re":
        return None
    a = cv[1:]
    if not a or len(a) > 2:
        return None
    pat = _chuoi_hang(pool, a[0], module_consts)
    if pat is None:
        return None
    if len(a) == 2:
        co = _co_regex_inline(pool, a[1])
        if co is None:
            return None
        pat = co + pat
    return doi_nhom_dat_ten(pat)


# Co cua `re` -> co INLINE cua chinh cu phap regex. .NET Regex hieu cac co
# nay dat o DAU pattern, nen `re.compile(p, re.VERBOSE)` doc duoc thanh mot
# CHUOI pattern duy nhat - khong can mang theo mot tham so co rieng.
#
# LUU Y (danh doi CO Y THUC): Python's VERBOSE va .NET's
# IgnorePatternWhitespace khong giong nhau 100% o cac goc hiem. Voi cac
# pattern dang co trong compiler (deu chi dung khoang trang + chu thich '#')
# hai ben cho ket qua nhu nhau. Neu sau nay co pattern dung goc hiem, no se
# lo ra o cong doi chieu chu khong am tham.
_RE_FLAG_INLINE: "dict[str,str]" = {'VERBOSE': '(?x)', 'X': '(?x)',
                   'DOTALL': '(?s)', 'S': '(?s)',
                   'IGNORECASE': '(?i)', 'I': '(?i)',
                   'MULTILINE': '(?m)', 'M': '(?m)'}


def _co_regex_inline(pool: "list[str]", nid: "i32") -> "str":
    """`re.VERBOSE` / `re.S | re.M` -> chuoi co inline ('(?x)'), hoac None."""
    if nid < 0:
        return None
    kind = ar_kind(pool, nid)
    if kind == "binop" and ar_col_a(pool, nid) == "|":
        con = ar_kids(pool, nid)
        if len(con) != 2:
            return None
        l, r = _co_regex_inline(pool, con[0]), _co_regex_inline(pool, con[1])
        return None if l is None or r is None else l + r
    if kind == "attr":
        con = ar_kids(pool, nid)
        if con and con[0] >= 0 and ar_kind(pool, con[0]) == "name" \
                and ar_col_a(pool, con[0]) == 're':
            return _RE_FLAG_INLINE.get(ar_col_a(pool, nid))
    return None


def _chuoi_hang(pool: "list[str]", nid: "i32", module_consts: "dict[str,(str,str)]"=None) -> "str":
    """Gia tri cua mot bieu thuc CHUOI tinh duoc luc bien dich: chuoi literal,
    hoac phep NOI (`+`) cac chuoi literal va hang so module da biet."""
    if nid < 0:
        return None
    kind = ar_kind(pool, nid)
    if kind == "const_str":
        return ar_col_a(pool, nid)
    if kind == "binop" and ar_col_a(pool, nid) == "+":
        con = ar_kids(pool, nid)
        if len(con) != 2:
            return None
        l = _chuoi_hang(pool, con[0], module_consts)
        r = _chuoi_hang(pool, con[1], module_consts)
        return None if l is None or r is None else l + r
    if kind == "name" and module_consts is not None:
        ten = ar_col_a(pool, nid)
        if ten in module_consts and module_consts[ten][0] == 'str':
            return module_consts[ten][1]
    return None


def _returns_a_value(pool: "list[str]", fn_nid: "i32") -> "i32":
    """Than ham co `return <gia tri>` hoac `yield` nao KHONG? (khong tinh
    ham long ben trong - chung co chu ky rieng).

    `yield` tinh la CO tra ve: generator van phai khai bao kieu phan tu
    (vd -> "list[i32]"), khong duoc suy thanh void.

    Ten kind DA DO chu khong doan: 'yield from' la `yield_from` (toi doan
    `yieldfrom_expr` va SAI)."""
    stack = list(_ar_than(pool, fn_nid))
    while stack:
        nid = stack.pop()
        if nid < 0:
            continue
        kind = ar_kind(pool, nid)
        if kind == "funcdef" or kind == "asyncfuncdef" or kind == "lambda":
            continue                      # ham long: chu ky rieng, bo qua
        if kind == "return":
            con = ar_kids(pool, nid)
            if con and con[0] >= 0:
                return True
        if kind == "yield_expr" or kind == "yield_from":
            return True
        stack.extend(ar_kids(pool, nid))
    return False


def _func_type_signature(pool: "list[str]", fn_nid: "i32") -> "(list[str],str)":
    """(list kieu tham so, kieu tra ve) cua 1 ham top-level (khong tinh
    'self') - dung de so sanh chu ky luc mo rong decorator tuy bien
    (_expand_custom_decorator, Phase 4, 2026-08-11)."""
    ten_ham = ar_col_a(pool, fn_nid)
    ts = _ar_tham_so(pool, fn_nid)
    parts = []
    for i in range(len(ts.ten)):
        ann = _ar_ann_cua(pool, ts.nid[i])
        if ann < 0:
            raise TranspileError(f"ham '{ten_ham}': tham so '{ts.ten[i]}' thieu annotation")
        parts.append(_annotation_to_type_str(pool, ann, f"ham '{ten_ham}' tham so '{ts.ten[i]}'"))
    ret_ann = ar_kids(pool, fn_nid)[1]
    if ret_ann < 0:
        raise TranspileError(f"ham '{ten_ham}': thieu return-type annotation")
    ret_t = _annotation_to_type_str(pool, ret_ann, f"ham '{ten_ham}' return type")
    return parts, ret_t


def _expand_custom_decorator(pool: "list[str]", fn_nid: "i32", deco_nid: "i32", source_lines: "list[str]") -> "list[(str,list[str],i32)]":
    """'@deco' truoc 1 ham top-level (Phase 4, 2026-08-11) - desugar THANG
    thanh macro luc bien dich (KHONG dung ha tang func-delegate/closure
    runtime): tuong duong Python that 'f = deco(f)' nhung vi 'deco' o day
    BAT BUOC chi la 1 TEMPLATE thuan tuy (khong side-effect nao khac
    ngoai dinh nghia + tra ve 1 ham long - kiem tra RO RANG ben duoi),
    macro nay INLINE TRUC TIEP than 'wrapper' cua 'deco' lam than ham
    CONG KHAI moi cho 'f' - doi ten ham GOC thanh 1 ten AN (hidden) va
    doi MOI LOI GOI toi tham so bi bat (vd 'f(...)') trong than 'wrapper'
    thanh loi goi ten an do. Ket qua: hanh vi giong het 'f = deco(f)' that
    (vi 'deco' khong lam gi khac ngoai tra ve wrapper), nhung KHONG can mo
    phong "chay 1 lan luc nap module" - thu tuc AOT tinh khong co khai
    niem do.

    GIOI HAN CO Y THUC (thu hep pham vi, quyet dinh cua nguoi dung sau khi
    can nhac gia tri/effort qua 2 agent creative+critical): 'deco' CHI
    duoc nhan DUNG 1 tham so (chinh ham bi trang tri), than 'deco' CHI
    duoc gom DUNG 2 cau lenh (1 'def wrapper(...):' long + 1
    'return wrapper' - khong gi khac, macro nay KHONG BAO GIO thuc su goi
    'deco' luc chay nen moi side-effect khac se KHONG BAO GIO xay ra),
    chu ky 'wrapper' PHAI khop CHINH XAC (so luong + kieu tham so, kieu
    tra ve) voi chu ky ham goc 'f' VA voi kieu 'func(...)->...' ma 'deco'
    tu khai bao cho tham so/return cua no. Khong ho tro decorator co tham
    so (vd '@deco(x)'), khong ho tro decorator tren method trong class,
    khong ho tro xep chong nhieu decorator."""
    deco_name = ar_col_a(pool, deco_nid)
    public_name = ar_col_a(pool, fn_nid)
    ts_deco = _ar_tham_so(pool, deco_nid)

    if (ts_deco.vararg is not None or ts_deco.kwarg is not None
            or ts_deco.kwonly or len(ts_deco.ten) != 1
            or _ar_mac_dinh_cua(pool, ts_deco.nid[0]) >= 0):
        raise TranspileError(
            f"decorator '@{deco_name}' tren ham '{public_name}': 'def {deco_name}(...)' "
            f"phai nhan DUNG 1 tham so (chinh ham bi trang tri), khong *args/**kwargs/"
            f"tham so mac dinh")

    than_deco = _ar_than(pool, deco_nid)
    ok_hinh_dang = len(than_deco) == 2 and ar_kind(pool, than_deco[0]) == "funcdef" \
        and ar_kind(pool, than_deco[1]) == "return"
    if ok_hinh_dang:
        tra = ar_kids(pool, than_deco[1])
        v = tra[0] if tra else -1
        ok_hinh_dang = v >= 0 and ar_kind(pool, v) == "name" \
            and ar_col_a(pool, v) == ar_col_a(pool, than_deco[0])
    if not ok_hinh_dang:
        raise TranspileError(
            f"decorator '@{deco_name}' tren ham '{public_name}': than '{deco_name}' PHAI gom "
            f"DUNG 2 cau lenh - 1 'def wrapper(...):' long roi 'return wrapper' - khong ho tro "
            f"logic nao khac (macro nay khong bao gio thuc su GOI '{deco_name}' luc chay)")

    wrapper_nid = than_deco[0]
    param_name = ts_deco.ten[0]

    orig_param_types, orig_ret_t = _func_type_signature(pool, fn_nid)
    wrap_param_types, wrap_ret_t = _func_type_signature(pool, wrapper_nid)
    # SO SANH TAY (2026-10-10): container trong TokenVector so sanh THAM
    # CHIEU, nen `orig_param_types != wrap_param_types` LUON dung ke ca khi
    # hai list co cung noi dung - chinh no da chan oan test decorator.
    khop_chu_ky = 1
    if len(orig_param_types) != len(wrap_param_types):
        khop_chu_ky = 0
    else:
        for _i_ck, _p_ck in enumerate(orig_param_types):
            if _p_ck != wrap_param_types[_i_ck]:
                khop_chu_ky = 0
    if orig_ret_t != wrap_ret_t:
        khop_chu_ky = 0
    if not khop_chu_ky:
        raise TranspileError(
            f"decorator '@{deco_name}' tren ham '{public_name}': chu ky 'wrapper' trong "
            f"'{deco_name}' ({', '.join(wrap_param_types)} -> {wrap_ret_t}) phai KHOP CHINH XAC "
            f"voi chu ky '{public_name}' ({', '.join(orig_param_types)} -> {orig_ret_t}) - "
            f"decorator tuy bien hien CHI ho tro cung chu ky (khong doi kieu tham so/tra ve)")

    ann_ts = _ar_ann_cua(pool, ts_deco.nid[0])
    if ann_ts < 0:
        raise TranspileError(
            f"ham '{deco_name}': tham so '{param_name}' thieu annotation kieu DSL (ham dung lam "
            f"'@deco' PHAI khai annotation day du, KHONG duoc dung tham so kieu suy tu dong "
            f"'inferred')")
    deco_param_ann = _annotation_to_type_str(
        pool, ann_ts, f"ham '{deco_name}' tham so '{param_name}'")
    ann_ret = ar_kids(pool, deco_nid)[1]
    if ann_ret < 0:
        raise TranspileError(f"ham decorator '{deco_name}': thieu return-type annotation")
    deco_ret_ann = _annotation_to_type_str(pool, ann_ret, f"ham '{deco_name}' return type")
    for label, ann in (('tham so', deco_param_ann), ('return', deco_ret_ann)):
        ta = _parse_type_ann_str(ann, record_names=set())
        if ta.shape_ten != 'func' or ta.func_param_dtypes != orig_param_types or ta.dtype != orig_ret_t:
            raise TranspileError(
                f"ham decorator '{deco_name}': annotation {label} '{ann}' phai la "
                f"'func({', '.join(orig_param_types)}) -> {orig_ret_t}' (khop chu ky '{public_name}')")

    hidden_name = f'__deco_{deco_name}_{public_name}'

    orig_sig_line = _extract_signature_line(pool, fn_nid)
    orig_name_token = _rename_reserved_identifiers(public_name)
    hidden_sig_line = orig_sig_line.replace(orig_name_token + '(', hidden_name + '(', 1)
    hidden_body_lines = _body_source_lines(pool, source_lines, fn_nid)
    hidden_start_line = ar_line_lo(pool, _ar_than(pool, fn_nid)[0])

    wrapper_sig_line = _extract_signature_line(pool, wrapper_nid)
    wrapper_name_token = _rename_reserved_identifiers(ar_col_a(pool, wrapper_nid))
    public_sig_line = wrapper_sig_line.replace(wrapper_name_token + '(', orig_name_token + '(', 1)

    header_idx = ar_line_lo(pool, wrapper_nid) - 1
    indent = len(source_lines[header_idx]) - len(source_lines[header_idx].lstrip(' '))
    than_wrap = _ar_than(pool, wrapper_nid)
    start = ar_line_lo(pool, than_wrap[0]) - 1
    end = ar_line_hi(pool, than_wrap[-1])
    raw_body = source_lines[start:end]
    dedented = [ln[indent:] if len(ln) > indent else ln.lstrip(' ') for ln in raw_body]
    call_re = re.compile(r'\b' + re.escape(param_name) + r'\s*\(')
    public_body_lines = [call_re.sub(hidden_name + '(', ln) for ln in dedented]
    public_start_line = ar_line_lo(pool, than_wrap[0])

    return [(hidden_sig_line, hidden_body_lines, hidden_start_line),
            (public_sig_line, public_body_lines, public_start_line)]


def _body_source_lines(pool: "list[str]", source_lines: "list[str]", fn_nid: "i32", hoisted: "list[(str,list[str],i32)]"=None) -> "list[str]":
    """hoisted (2026-08-03): list OUT-parameter - moi 'def' long KHONG bat
    bien nao se duoc CHUYEN LEN top-level (doi ten '<ngoai>__<long>') va
    append vao day duoi dang (sig_line, body_lines) - xem _hoist_nested_def."""
    than = _ar_than(pool, fn_nid)
    if not than:
        raise TranspileError(f"ham '{ar_col_a(pool, fn_nid)}': than ham rong")
    start = ar_line_lo(pool, than[0])
    end = ar_line_hi(pool, than[-1])
    lines = source_lines[start - 1:end]
    _rewrite_nested_defs(pool, fn_nid, lines, start, hoisted=hoisted)
    return lines


def _reads_outer_names(pool: "list[str]", inner_nid: "i32", outer_nid: "i32") -> "i32":
    """True neu than ham long CO doc 1 ten von la local/tham so cua ham
    ngoai (2026-08-03). Dung de biet 'nonlocal' co THAT SU can hay khong -
    ham long doc lap hoan toan thi khong can (va Python cung khong cho
    viet 'nonlocal' rong)."""
    own = set(ar_csv_names(ar_col_b(pool, inner_nid)))
    rn_in = []
    rc_in = []
    ar_duyet(pool, inner_nid, rn_in, rc_in)
    for i in range(len(rn_in)):
        if ar_kind(pool, rn_in[i]) == "name" and rc_in[i] == "store":
            own.add(ar_col_a(pool, rn_in[i]))

    outer_names = set(ar_csv_names(ar_col_b(pool, outer_nid)))
    for st in _ar_than(pool, outer_nid):
        rn = []
        rc = []
        ar_duyet(pool, st, rn, rc)
        for i in range(len(rn)):
            if ar_kind(pool, rn[i]) == "name" and rc[i] == "store":
                outer_names.add(ar_col_a(pool, rn[i]))

    for i in range(len(rn_in)):
        if ar_kind(pool, rn_in[i]) != "name" or rc_in[i] != "load":
            continue
        ten = ar_col_a(pool, rn_in[i])
        if ten not in own and ten in outer_names:
            return True
    return False



def _hoist_nested_def(pool: "list[str]", inner_nid: "i32", outer_nid: "i32", lines: "list[str]", body_start_lineno: "i32", hoisted: "list[(str,list[str],i32)]"):
    """Chuyen 1 'def' long KHONG bat bien nao len top-level (2026-08-03).

    Ham long khong bat bien thi KHONG phai closure - no chi la 1 ham thuong
    dat nham cho. Truoc day bi tu choi o CA HAI tang (transpile doi dong
    'nonlocal', ma Python khong cho viet rong; codegen bao "khong bat bien
    nao"), du day la cach viet rat thuong gap.

    - Ten moi '<ham_ngoai>__<ham_long>' - tranh dung do voi ham top-level
      co san VA voi ham long CUNG TEN trong 1 ham khac.
    - Cac dong cua no bi xoa khoi than ham ngoai (thanh dong RONG - giu
      nguyen so dong, cung cach da lam voi dong 'nonlocal').
    - Cac LOI GOI trong than ham ngoai duoc doi sang ten moi.

    GIOI HAN (ghi ro): chi doi LOI GOI. Neu ham long duoc truyen di nhu 1
    GIA TRI (function reference) thi ten cu khong con -> bao loi "bien chua
    duoc khai bao" RO RANG luc bien dich, khong sai am tham."""
    ten_inner = ar_col_a(pool, inner_nid)
    start_idx = ar_line_lo(pool, inner_nid) - body_start_lineno
    end_idx = ar_line_hi(pool, inner_nid) - body_start_lineno
    indent = len(lines[start_idx]) - len(lines[start_idx].lstrip(' '))
    inner_lines = [ln[indent:] if len(ln) > indent else ln.lstrip(' ')
                   for ln in lines[start_idx + 1:end_idx + 1]]
    new_name = f'{ar_col_a(pool, outer_nid)}__{ten_inner}'
    sig_line = _extract_signature_line(pool, inner_nid)
    old_name = _rename_reserved_identifiers(ten_inner)
    sig_line = sig_line.replace(old_name + '(', new_name + '(', 1)
    dong_than = ar_line_lo(pool, _ar_than(pool, inner_nid)[0])
    # 'def' long BEN TRONG ham long: xu ly de quy TRUOC khi cat ra, de moi
    # tang deu duoc nang len top-level.
    _rewrite_nested_defs(pool, inner_nid, inner_lines, dong_than, hoisted=hoisted)
    hoisted.append((sig_line, inner_lines, dong_than))
    for i in range(start_idx, end_idx + 1):
        lines[i] = ''
    call_re = re.compile(r'\b' + re.escape(ten_inner) + r'\s*\(')
    for i, ln in enumerate(lines):
        if ln:
            lines[i] = call_re.sub(new_name + '(', ln)


def _rewrite_nested_defs(pool: "list[str]", fn_nid: "i32", lines: "list[str]", body_start_lineno: "i32", inherited_captures: "set[str]"=None,
                          hoisted: "list[(str,list[str],i32)]"=None):
    """Closure that (Buoc 4, 2026-07-29 - xem project-tokenvector-wave2-
    status memory, 'checkpoint tach session'): sua TAI CHO (in-place, GIU
    NGUYEN so dong) 1 'def long' (nested FunctionDef) truc tiep ben trong
    than 1 ham - (a) dong header 'def ten(...) -> "kieu":' duoc doi ve dang
    KHONG dau ngoac kep quanh annotation (giong het sig_line top-level, tai
    dung _extract_signature_line), de il_codegen.py's nested_def line-
    parser (il_features/closures.py) parse duoc THANG qua parse_typed_
    signature; (b) dong 'nonlocal x' (BAT BUOC ve mat cu phap de file .tkv
    con la Python HOP LE, chay duoc that duoi CPython - xem triet ly module
    nay) duoc XOA (thanh dong rong) vi il_codegen.py KHONG co khai niem
    'nonlocal' - bien bi bat duoc suy tu chinh phan tich bien tu do (xem
    il_features/closures.py's fpw_nested_def), khong can khai bao rieng.

    Slice thu hai (2026-07-29, N>=1 bien bi bat): N>=1 bien trong 1 dong
    'nonlocal a, b, ...' - MOI bien PHAI la 1 LOCAL cua ham NGOAI (gan qua
    '=' thuong, khai bao TRUOC ham long trong thu tu van ban nguon) HOAC
    (B3, Phase C.1, 2026-07-29) 1 THAM SO cua ham NGOAI (chi hop le neu
    kieu THAM CHIEU - kiem tra dtype cu the o tang duoi, xem il_features/
    closures.py's fpw_nested_def) - vi pham bat ky dieu kien nao o day se
    bao loi RO RANG (TranspileError) thay vi de il_codegen.py that bai kho
    hieu hon o tang duoi.

    Phase C.2 (2026-07-29): HO TRO N>=1 def long SONG SONG truc tiep trong
    CUNG 1 ham (khong con gioi han DUNG 1) - MOI def long duoc rewrite +
    kiem tra DOC LAP (vong lap duoi). CUNG ho tro def-long-TRONG-def-long
    (2+ tang, vd 'inner' nam trong 'mid' nam trong 'ham_ngoai') - DE QUY
    vao THAN cua tung 'inner' de tim + rewrite cac def long SAU HON NUA
    (tham so 'inherited_captures': tap ten bien MA CHINH 'func_node' nay DA
    tu bat tu 1 tang NGOAI HON NUA - neu 1 def-con-cua-func_node bat lai 1
    ten trong tap nay, KHONG can kiem tra '_check_captured_declared_before'
    (bien do von KHONG PHAI local THAT su cua func_node, ma la 1 tham chieu
    chuyen tiep tu tang xa hon - viec box/chuyen-tiep CELL dung 1 chuoi da
    duoc _load_boxed_cell_ref ho tro san, xem il_codegen.py))."""
    if inherited_captures is None:
        inherited_captures = set()
    lenh_def: "list[i32]" = _ar_lenh_long(pool, fn_nid, True)
    nested = sorted(lenh_def)
    if not nested:
        return
    ten_ngoai = ar_col_a(pool, fn_nid)
    outer_params: "set[str]" = set()
    for ten_tt in _ar_tham_so(pool, fn_nid).ten:
        outer_params.add(ten_tt)
    for inner in nested:
        ten_inner = ar_col_a(pool, inner)
        header_idx = ar_line_lo(pool, inner) - body_start_lineno
        indent = len(lines[header_idx]) - len(lines[header_idx].lstrip(' '))
        sig_line = _extract_signature_line(pool, inner)  # vd 'inc() -> i32:' (khong dau ngoac kep)
        lines[header_idx] = ' ' * indent + f'def {sig_line}'

        than_inner = _ar_than(pool, inner)
        dau = than_inner[0] if than_inner else -1
        if dau < 0 or ar_kind(pool, dau) != "nonlocal":
            if _reads_outer_names(pool, inner, fn_nid):
                raise TranspileError(
                    f"ham long '{ten_inner}' (trong ham '{ten_ngoai}'): BAT BUOC dong DAU "
                    f"TIEN trong than ham long phai la 'nonlocal <ten>, ...' (khai bao (cac) bien "
                    f"bi bat - dung cu phap Python THAT de file van chay duoc dung duoi CPython)")
            # (2026-08-03) Ham long KHONG dung bien nao cua ham ngoai thi
            # KHONG can 'nonlocal' - va Python that cung khong cho viet
            # 'nonlocal' rong. Truoc day van bat buoc, khien cach viet
            # thuong gap nhat ('def helper' thuan tuy, khong bat gi) bi tu
            # choi vo ly.
            if hoisted is None:
                _rewrite_nested_defs(pool, inner, lines, body_start_lineno, inherited_captures)
                continue
            _hoist_nested_def(pool, inner, fn_nid, lines, body_start_lineno, hoisted)
            continue
        ten_bat = ar_csv_names(ar_col_b(pool, dau))
        nl_idx = ar_line_lo(pool, dau) - body_start_lineno
        lines[nl_idx] = ''

        for captured_name in ten_bat:
            if captured_name in outer_params:
                # B3 (Phase C.1, 2026-07-29, xem project-tokenvector-wave2-status
                # memory): bat 1 THAM SO cua ham ngoai gio HOP LE (da bind san
                # luc vao ham, khong can "khai bao truoc" nhu local) NEU no la
                # kieu THAM CHIEU (list/dict/record/func...) - viec kiem tra
                # dtype cu the (scalar van CHUA ho tro bat qua tham so) nam o
                # tang duoi (il_features/closures.py's fpw_nested_def, co day
                # du TypeAnn luc do, o day chi la buoc tien xu ly cu phap THO,
                # chua biet dtype).
                continue
            if captured_name in inherited_captures:
                # Phase C.2: 'fn_nid' (vd 'mid') TU NO cung dang bat lai
                # ten nay tu 1 tang xa hon (vd 'a' tu 'make_deep') - khong
                # phai local THAT cua no nen KHONG kiem tra "khai bao
                # truoc", chi chuyen tiep (chain) nguyen ven.
                continue
            _check_captured_declared_before(pool, fn_nid, inner, captured_name)

        # De quy: 'inner' co the CUNG co def long rieng cua no - tap
        # inherited_captures cho vong de quy nay = MOI ten 'inner' se NHAN
        # LAI duoi dang closure_field (tham so THAM CHIEU cua chinh no +
        # MOI ten no vua bat o vong nay).
        # Hop bang vong lap (2026-09-29): 'set(f(x).ten) | set(ten_bat)' chua
        # dich duoc o ban tu-host.
        inner_inherited: "set[str]" = set()
        for ten_tt in _ar_tham_so(pool, inner).ten:
            inner_inherited.add(ten_tt)
        for ten_tt in ten_bat:
            inner_inherited.add(ten_tt)
        _rewrite_nested_defs(pool, inner, lines, body_start_lineno, inherited_captures=inner_inherited)


def _moi_con_la_chuoi(pool: "list[str]", nid: "i32") -> "i32":
    """1 neu nut co it nhat 1 con VA moi con la chuoi hang (const_str). Thay
    'kids and all([... for e in kids])' viet tren dong noi tiep bang dau gach
    cheo nguoc (2026-09-29): macro comprehension doc tung DONG nen khong
    nhan dong noi."""
    con = ar_kids(pool, nid)
    if len(con) == 0:
        return 0
    for e in con:
        if e < 0 or ar_kind(pool, e) != "const_str":
            return 0
    return 1


def _khoa_thanh_tap(d: "dict[str,i32]") -> "set[str]":
    """Tap khoa cua dict (2026-09-29) - thay 'set(d)': set() tren dict la
    dang ban tu-host chua dich duoc."""
    ra: "set[str]" = set()
    for k in d:
        ra.add(k)
    return ra


def _co_deco_interface(pool: "list[str]", decos: "list[i32]") -> "i32":
    """1 neu trong cac decorator co '@interface' (2026-09-29) - thay
    'any([... for d in ...])' nhieu dong: macro comprehension doc tung dong."""
    for d in decos:
        if d >= 0 and ar_kind(pool, d) == "name" and ar_col_a(pool, d) == 'interface':
            return 1
    return 0


def _cap_pool_nid(pool: "list[str]", nid: "i32") -> "(list[str],i32)":
    """Cap (pool, nid) - gan 'd[k] = (a, b)' truc tiep chua duoc ho tro o ban
    tu-host (2026-09-29), 'return a, b' thi co."""
    return pool, nid


def _cap_hang(dtype: "str", text: "str") -> "(str,str)":
    """Cap (dtype, van ban) cua mot hang so cap module (2026-09-29): gan
    'd[k] = (a, b)' truc tiep chua duoc ho tro o ban tu-host."""
    return dtype, text


def _cap_toan_cuc(dtype: "str", gia_tri: "list[list[str]]") -> "(str,list[list[str]])":
    """Cap (dtype, gia tri khoi tao) cua mot bien toan cuc cap module."""
    return dtype, gia_tri


def _ten_record(record_defs: "dict[str,list[(str,str)]]") -> "set[str]":
    """Tap ten record (2026-09-29) - thay 'set(record_defs)' (set() tren dict
    chua dich duoc o ban tu-host)."""
    ra: "set[str]" = set()
    for k in record_defs:
        ra.add(k)
    return ra


def _sao_tap(t: "set[str]") -> "set[str]":
    """Ban sao tap chuoi (2026-09-29) - thay 'set(t)' / hop tap bang
    comprehension: hai dang chua dich duoc o ban tu-host."""
    ra: "set[str]" = set()
    for k in t:
        ra.add(k)
    return ra


def _ten_record_ta(record_defs: "dict[str,list[(str,TypeAnn)]]") -> "set[str]":
    """Nhu _ten_record nhung cho bang record DA giai kieu (truong la TypeAnn)."""
    ra: "set[str]" = set()
    for k in record_defs:
        ra.add(k)
    return ra


def _thieu_khoa(can: "set[str]", co: "set[str]") -> "set[str]":
    """Cac key bat buoc con thieu (2026-09-29) - thay 'can - co': hieu tap
    chua dich duoc o ban tu-host."""
    ra: "set[str]" = set()
    for k in can:
        if k not in co:
            ra.add(k)
    return ra


def _ar_lenh_long(pool: "list[str]", fn_nid: "i32", lay_def: "i32") -> "list[i32]":
    """Moi nut trong than `fn_nid` KE CA trong khoi long (if/for/while/try...),
    khong di vao ham long/lambda (2026-09-28). lay_def=True: chi cac funcdef
    (def long nam trong 'if' truoc day bi bo sot); False: moi nut con lai."""
    ra: "list[i32]" = []
    stack = list(_ar_than(pool, fn_nid))
    while stack:
        nid = stack.pop()
        if nid < 0:
            continue
        kind = ar_kind(pool, nid)
        if kind == "funcdef":
            if lay_def:
                ra.append(nid)
            continue
        if kind == "asyncfuncdef" or kind == "lambda":
            continue
        if not lay_def:
            ra.append(nid)
        stack.extend(ar_kids(pool, nid))
    return ra


def _ar_than(pool: "list[str]", fn_nid: "i32") -> "list[i32]":
    """Cac CAU LENH trong than mot `funcdef` (kids[0] la dong `block`)."""
    con = ar_kids(pool, fn_nid)
    if not con or con[0] < 0:
        return []
    return ar_kids(pool, con[0])


def _check_captured_declared_before(pool: "list[str]", fn_nid: "i32", inner_nid: "i32", captured_name: "str"):
    dong_inner = ar_line_lo(pool, inner_nid)
    declared_before = False
    for st in _ar_lenh_long(pool, fn_nid, False):
        if st < 0:
            continue
        k_st = ar_kind(pool, st)
        con = ar_kids(pool, st)
        if k_st == "annassign":
            # (2026-09-25) phep gan CO CHU THICH cung la khai bao:
            # `locals_decl: "list[(str,TypeAnn)]" = []`. kids = [dich, ann, GIA TRI].
            if not (len(con) > 2 and con[2] >= 0 and con[0] >= 0):
                continue
        elif k_st != "assign":
            continue
        # `assign` co kids = [dich..., GIA TRI]; dung 1 dich thi len(con)==2.
        elif len(con) != 2 or con[0] < 0:
            continue
        dich = con[0]
        khop = ar_kind(pool, dich) == "name" and ar_col_a(pool, dich) == captured_name
        if not khop and (ar_kind(pool, dich) == "tuple" or ar_kind(pool, dich) == "list"):
            # 'a, b = ...' (2026-09-28) cung khai bao tung ten
            for _e in ar_kids(pool, dich):
                if _e >= 0 and ar_kind(pool, _e) == "name" and ar_col_a(pool, _e) == captured_name:
                    khop = True
        if not khop:
            continue
        d = ar_line_lo(pool, st)
        if d >= 0 and dong_inner >= 0 and d < dong_inner:
            declared_before = True
            break
    if not declared_before:
        raise TranspileError(
            f"ham '{ar_col_a(pool, fn_nid)}': bien bi bat '{captured_name}' phai duoc khai bao qua "
            f"1 phep gan thuong ('{captured_name} = ...') TRUOC ham long "
            f"'{ar_col_a(pool, inner_nid)}' trong thu tu van ban nguon")


def _extract_record_method_sig_line(pool: "list[str]", class_nid: "i32", method_nid: "i32", is_static: "i32"=False) -> "str":
    """Nhu _extract_signature_line, nhung BO QUA tham so dau tien ('self'
    - khong duoc co annotation, khac cac tham so khac) - khoang trong ngon
    ngu #1 (method that tren record). 'self' duoc il_codegen.py TU dong
    bind vao scope (xem gen_il_method/Scope.add_self), khong xuat hien
    trong dong chu ky sinh ra o day.

    is_static=True (Wave 1 Nhom B, 2026-07-29 - '@staticmethod'): method
    KHONG co 'self' - tat ca tham so (ke ca tham so DAU) deu can annotation
    kieu binh thuong, giong 1 ham top-level, xem _extract_record_def."""
    ten_m = ar_col_a(pool, method_nid)
    ten_c = ar_col_a(pool, class_nid)
    ts = _ar_tham_so(pool, method_nid)
    ten_ts = ts.ten
    nid_ts = ts.nid
    if is_static:
        if ten_ts and ten_ts[0] == 'self':
            raise TranspileError(
                f"method '{ten_m}' cua class '{ten_c}': "
                f"'@staticmethod' khong duoc co tham so 'self'")
    else:
        if not ten_ts or ten_ts[0] != 'self':
            raise TranspileError(
                f"method '{ten_m}' cua class '{ten_c}': tham so DAU TIEN "
                f"phai la 'self' (giong Python that)")
        if _ar_ann_cua(pool, nid_ts[0]) >= 0:
            raise TranspileError(
                f"method '{ten_m}' cua class '{ten_c}': 'self' khong duoc "
                f"co annotation kieu")
        ten_ts = ten_ts[1:]
        nid_ts = nid_ts[1:]
    if ts.vararg is not None or ts.kwarg is not None or ts.kwonly:
        raise TranspileError(
            f"method '{ten_m}': chi ho tro tham so thuong (khong *args/**kwargs/"
            f"keyword-only)")
    parts = _params_with_defaults(pool, ten_ts, nid_ts, f"method '{ten_m}'")
    m_name = _rename_reserved_identifiers(ten_m)
    # 'async def' method tren record (Task 3, 2026-08-12) - cung prefix
    # 'async ' nhu _extract_signature_line (ham top-level) de
    # typed_dsl_parser.py's parse_signature nhan dien (Signature.is_async).
    prefix = "async " if ar_kind(pool, method_nid) == "asyncfuncdef" else ""
    ret_ann = ar_kids(pool, method_nid)[1]
    if ret_ann < 0:
        return f"{prefix}{m_name}({', '.join(parts)}):"
    ret_t = _annotation_to_type_str(pool, ret_ann, f"method '{ten_m}' return type")
    return f"{prefix}{m_name}({', '.join(parts)}) -> {ret_t}:"


def _ar_so_base(pool: "list[str]", class_nid: "i32") -> "i32":
    """So O BASE cua mot `classdef` (cot b). CANH BAO da DO: bo ma hoa gop
    ca tham so keyword ('metaclass=M') vao day, moi keyword chiem 3 o va co
    mot o VANG (-1) o giua - nen khong duoc coi day la 'so base THAT'."""
    b = ar_col_b(pool, class_nid)
    return int(b) if b else 0


def _ar_base_nids(pool: "list[str]", class_nid: "i32") -> "list[i32]":
    """Cac o BASE cua mot `classdef`: kids[1 : 1+so_base]."""
    n = _ar_so_base(pool, class_nid)
    con = ar_kids(pool, class_nid)
    return con[1:1 + n]


def _ar_decorator(pool: "list[str]", fn_nid: "i32") -> "list[i32]":
    """Cac o DECORATOR cua mot `funcdef`: nam SAU khoi arg_meta trong kids.

    Bo cuc kids = [block, ret_ann, arg_meta..., decorator...] - ranh gioi
    duoc suy tu SO TOKEN co ten trong cot b.

    '*' TRAN va '/' la DAU PHAN CACH: chung CO mat trong cot b nhung KHONG
    chiem o arg_meta (xem `_ar_tham_so`, cung quy uoc). Truoc 2026-09-14
    ham nay dem ca chung, nen 'def g(a, *, b)' co decorator thi ranh gioi
    bi day di 1 o va decorator bi MAT AM THAM - khong loi, chi la
    '@deco' bien mat khoi IL. Da co bai kiem trong `test/cu_phap_day_du.py`."""
    csv = ar_col_b(pool, fn_nid)
    so_o = 0
    if csv:
        for t in csv.split(','):
            if t and t != '*' and t != '/':
                so_o += 1
    con = ar_kids(pool, fn_nid)
    return con[2 + so_o:]


def _ar_chi_cpython(pool: "list[str]", fn_nid: "i32") -> "i32":
    """True neu `funcdef` mang pragma `@__tkv_cpython_only__`.

    Nhan dien theo TEN, khong resolve - giong moi pragma khac cua ngon ngu
    (`__tkv_import__`, `__tkv_extern_class__`). Xem compiler/tkv_pragma.py.
    """
    for d in _ar_decorator(pool, fn_nid):
        if d >= 0 and ar_kind(pool, d) == "name" and                 ar_col_a(pool, d) == "__tkv_cpython_only__":
            return True
    return False


def _ar_la_docstring(pool: "list[str]", nid: "i32") -> "i32":
    """True neu cau lenh chi la mot chuoi hang dung mot minh (docstring)."""
    if nid < 0 or ar_kind(pool, nid) != "expr_stmt":
        return False
    con = ar_kids(pool, nid)
    return bool(con) and con[0] >= 0 and ar_kind(pool, con[0]) == "const_str"


def _extract_interface_def(pool: "list[str]", class_nid: "i32", source_lines: "list[str]") -> "dict[str,str]":
    """Phase C.4 (2026-07-29, xem project-tokenvector-wave2-status memory -
    huong F da chot: mixin = CIL interface). Parse 1 'class dang interface'
    (danh dau qua '@interface' o CLASS, khong phai method) - CHI cho phep
    khai bao METHOD (chu ky + 1 than THAT SU KHONG DUOC BIEN DICH, thuong
    la 'pass'/'...' - giong stub trong Python that, chi can hop le cu phap
    de file van chay duoc that duoi CPython, KHONG anh huong CIL sinh ra -
    interface method LUON abstract, khong co than). KHONG duoc co field
    (AnnAssign), KHONG '__init__', KHONG '@staticmethod'/'@property'.

    Tra ve dict {ten_method: sig_line} (sig_line dang 'ten(...) -> kieu:',
    KHONG dau ngoac kep - dung LAI _extract_record_method_sig_line)."""
    ten_c = ar_col_a(pool, class_nid)
    # `classdef` co cot b = SO O BASE, va bo ma hoa arena gop CA tham so
    # keyword vao day (da do: 'class A(B, metaclass=M)' cho 4 o) - nen mot
    # phep thu duy nhat "khac 0" chan ca hai truong hop cu chan rieng.
    if _ar_so_base(pool, class_nid) != 0:
        raise TranspileError(
            f"class '{ten_c}': '@interface' khong duoc co base class rieng "
            f"(interface la goc, khong ke thua interface khac)")
    methods = {}
    for stmt in _ar_than(pool, class_nid):
        k = ar_kind(pool, stmt)
        if _ar_la_docstring(pool, stmt):
            continue  # docstring cua class
        if k != "funcdef":
            raise TranspileError(
                f"class '{ten_c}' (@interface): CHI ho tro khai bao method (chu ky + "
                f"1 than stub 'pass'/'...' - khong bien dich) - gap {k} o dong "
                f"{ar_line_lo(pool, stmt)}")
        if _ar_decorator(pool, stmt):
            raise TranspileError(
                f"method '{ar_col_a(pool, stmt)}' cua interface '{ten_c}': khong ho tro decorator "
                f"(interface method luon la instance abstract)")
        ten_m = ar_col_a(pool, stmt)
        if ten_m in methods:
            raise TranspileError(f"interface '{ten_c}': trung ten method '{ten_m}'")
        methods[ten_m] = _extract_record_method_sig_line(pool, class_nid, stmt, is_static=False)
    if not methods:
        raise TranspileError(f"interface '{ten_c}': khong co method nao")
    return methods


_EXCEPTION_BASE_NAME = 'Exception'
# MOI ten loi CO SAN deu lam base duoc, khong rieng 'Exception' (2026-09-24).
# Python cho `class X(KeyError)`, va CLR cung cho (KeyNotFoundException la
# mot lop binh thuong). Truoc day chi 'Exception' lot qua, nen
# `BienChuaKhaiBao(SyntaxError, KeyError)` trong chinh cay trinh bien dich
# bi tu choi - rao chan 102/117 file tren duong tu-host.
#
# GIOI HAN CO THAT, khong vuot qua duoc: CLR DON KE THUA, nen mot lop KHONG
# the vua la InvalidOperationException vua la KeyNotFoundException. Da ke
# thua HAI ten loi co san la khong bieu dien duoc - phai chon mot.


# Ky tu ASCII in duoc KHONG thuoc dinh danh (ke ca khoang trang/tab/xuong dong).
_ASCII_NGOAI_DINH_DANH = ' \t\n\r!"#$%&\'()*+,-./:;<=>?@[\\]^`{|}~'


def _la_dinh_danh(ten: "str") -> "i32":
    """Tuong duong phep kiem isidentifier cua Python (2026-09-25): khong
    rong, ky tu dau la chu/'_', cac ky tu sau them chu so. Ky tu NGOAI ASCII
    duoc coi la chu (giu hanh vi Python nhan dinh danh Unicode, vd tieng Viet).
    LECH DA BIET: ky tu dieu khien ASCII (tru tab/xuong dong) va ky tu Unicode
    khong phai chu (vd zero-width) duoc NHAN, Python thi tu choi - hai trinh
    chua co chr() hay escape hex chung de liet ke; chi gap o khai bao hong."""
    if ten == '':
        return False
    i = 0
    for c in ten:
        if c in _CHU_DINH_DANH:
            pass
        elif c in _SO_DINH_DANH:
            if i == 0:
                return False
        elif c in _ASCII_NGOAI_DINH_DANH:
            return False
        i += 1
    return True


def _bang_ds_chuoi_rong() -> "dict[str,list[str]]":
    """Bang RONG co kieu ten -> danh sach chuoi (2026-09-25)."""
    return {}


class DinhNghiaLop:
    """Ket qua _extract_record_def (2026-09-25) - thay bo 5 phan tu.
    methods_raw la 4-tuple (sig_line, body_lines, is_static, is_property);
    base_name co the None (khong ke thua); init_sig/init_body la chu ky va
    than `__init__` CO CHU GIAI (chuoi rong/list rong neu khong co) - boc ra de
    il_codegen xet viec noi than vao `.ctor`, KHONG phai de bien dich thanh
    method rieng."""

    fields: "list[(str,str)]"
    methods_raw: "list[(str,list[str],i32,i32)]"
    base_name: "str"
    base_info: "list[str]"
    interface_names: "list[str]"
    init_sig: "str"
    init_body: "list[str]"

    def __init__(self, fields: "list[(str,str)]", methods_raw: "list[(str,list[str],i32,i32)]", base_name: "str", base_info: "list[str]", interface_names: "list[str]", init_sig: "str", init_body: "list[str]"):
        self.fields = fields
        self.methods_raw = methods_raw
        self.base_name = base_name
        self.base_info = base_info
        self.interface_names = interface_names
        self.init_sig = init_sig
        self.init_body = init_body


def _init_du_chu_thich(pool: "list[str]", fn_nid: "i32") -> "i32":
    """__init__ co chu thich kieu cho MOI tham so (tru self)? Chi khi do moi
    dich __init__ that (2026-09-25); __init__ KHONG chu thich giu ngu nghia cu
    (bi bo qua, .ctor tu field) de khong pha cac chuong trinh da co."""
    ts = _ar_tham_so(pool, fn_nid)
    for i in range(len(ts.ten)):
        if ts.ten[i] == 'self':
            continue
        if _ar_ann_cua(pool, ts.nid[i]) < 0:
            return False
    return True


def _extract_record_def(pool: "list[str]", class_nid: "i32", source_lines: "list[str]", known_records: "dict[str,list[(str,str)]]"=None, known_interfaces: "dict[str,dict[str,str]]"=None) -> "DinhNghiaLop":
    """Parse 1 'class dang record' (huong tiep theo sau tuple/nhieu gia
    tri tra ve, va khoang trong ngon ngu #1 - "method that tren record"):
    field khai bao dang AnnAssign (khong gia tri khoi tao), TOI DA 1
    '__init__' (bi qua luc bien dich, chi de file van la Python that
    chay duoc), va 0+ method THAT (tham so dau '(self)', khong annotation).

    Ke thua (B1, 2026-07-29, xem project-tokenvector-wave2-status memory):
    HO TRO 1 base class DUY NHAT ('(object)'/khong ngoac van tuong duong
    "khong ke thua" nhu truoc) - base PHAI la 1 record DA khai bao TRUOC DO
    trong CUNG file (known_records: dict ten->fields DA parse xong, theo
    THU TU xuat hien - giong quy uoc Python that: dÃ¹ng truoc khi dinh nghia
    la loi). KHONG ho tro da ke thua GIUA 2 RECORD (nhieu base la record
    cung luc). KHONG nested class.

    Da ke thua qua interface (Phase C.4, 2026-07-29 - huong F da chot,
    "mixin = CIL interface"): CAC base SAU base DAU TIEN (neu co) PHAI la
    ten 1 '@interface' DA khai bao truoc do (known_interfaces: dict ten->
    {method:sig}) - vd 'class Dog(Animal, Flyable, Swimmable):' = ke thua
    THAT tu Animal (record) + implements Flyable/Swimmable (interface,
    method Dog TU VIET, CLR tu anh xa qua ten+chu ky trung khop, KHONG can
    field/state chia se). Tra ve THEM `interface_names: list[str]`.

    Tra ve (fields: list[(field_name, dtype_str)] - DA FLATTEN, field cua
    base (neu co) DUNG THEO THU TU TRUOC, roi den field RIENG cua class
    nay - giu dinh dang list[(name,dtype)] CU de MOI noi khac dung
    'records' dict (il_type_str, record_feature.py...) KHONG can doi gi;
    methods_raw: list[(sig_line, body_lines, is_static, is_property)] - CHI
    method RIENG cua class nay (KHONG lap lai method ke thua tu base - CLR tu
    dispatch qua v-table, xem gen_record_types); base_name: ten class cha
    hoac None; interface_names: list ten interface duoc implement)."""
    if not known_records:
        known_records = {}
    if not known_interfaces:
        known_interfaces = {}
    ten_c = ar_col_a(pool, class_nid)
    o_base = _ar_base_nids(pool, class_nid)
    # Bo ma hoa arena gop tham so keyword vao khoi base va de lai mot o
    # VANG (-1) o giua (da do voi 'class A(B, metaclass=M)'). Do la dau
    # hieu duy nhat con lai de nhan ra keyword, nen chan theo dau hieu do.
    if any([b_nid < 0 for b_nid in o_base]):
        raise TranspileError(f"class '{ten_c}': khong ho tro tham so keyword trong base class")
    # 'b_nid' (chi so nut) tach khoi 'b' (ten lop, chuoi) ben duoi: hat giong
    # chot kieu bien theo TEN trong ca ham (2026-09-25).
    for b_nid in o_base:
        if ar_kind(pool, b_nid) != "name":
            raise TranspileError(
                f"class '{ten_c}': base class phai la 1 TEN DON GIAN "
                f"(vd 'class Dog(Animal):'), gap {ar_kind(pool, b_nid)} o dong "
                f"{ar_line_lo(pool, class_nid)}")
    all_bases = [ar_col_a(pool, b_nid) for b_nid in o_base if ar_col_a(pool, b_nid) != 'object']
    # 'Exception' la base DAC BIET (Giai doan 3, 2026-08-03): khong phai
    # record do nguoi dung khai bao ma la System.Exception cua .NET - cho
    # phep 'class MyError(Exception):' de co exception TU DINH NGHIA dung
    # duoc voi 'raise'/'except'. Van la Python hop le (Exception co san).
    record_bases_found = [b for b in all_bases
                          if b in known_records or b in EXC_CLR]
    interface_names = [b for b in all_bases if b in known_interfaces]
    unknown_bases = [b for b in all_bases
                     if b not in known_records and b not in known_interfaces
                     and b not in EXC_CLR]
    exc_bases = [b for b in all_bases if b in EXC_CLR]
    if len(exc_bases) > 1:
        raise TranspileError(
            f"class '{ten_c}': ke thua {sorted(exc_bases)} - CLR DON KE THUA nen "
            f"mot lop khong the la nhieu loai loi cung luc. Chon MOT, roi sua cac "
            f"cho 'except' con lai de bat thang ten lop nay.")
    if unknown_bases:
        raise TranspileError(
            f"class '{ten_c}': base {sorted(unknown_bases)} chua duoc khai bao la "
            f"'class dang record' HOAC '@interface' TRUOC DO trong file (phai dinh nghia TRUOC "
            f"derived, giong quy uoc Python that)")
    base_name = record_bases_found[0] if record_bases_found else None
    # Phase 3.1 (2026-08-11, port tu cay .tkv tu-host): CHO PHEP nhieu base
    # la record (khac gioi han "1 base RECORD DUY NHAT" ban dau) - CLR chi
    # cho 1 base class THAT (extends), nen base_info gom CA CHUOI cac
    # record-base tim thay khi > 1 (dung boi gen_record_types/_field_owner_
    # class/_method_owner_class de resolve field/method qua toan bo pha he,
    # KHONG chi base dau tien).
    base_info = record_bases_found          # LUON list - xem tkv_types.cac_base
    own_fields = []
    # base 'Exception' KHONG dong gop field nao (field cua System.Exception
    # la cua .NET, khong nam trong he thong record cua DSL). Gop field TU
    # MOI record-base tim thay (khong chi base dau tien) - 1 base sau vi
    # thuc te la '@interface' se tra ve [] (interface khong co field trong
    # known_records) nen khong anh huong truong hop pho bien (1 base).
    base_fields = []
    for b in record_bases_found:
        sec_f = known_records.get(b, [])
        for f_tuple in sec_f:
            if f_tuple not in base_fields:
                base_fields.append(f_tuple)
    fields = list(base_fields)
    # (2026-08-13) Chan field TRUNG TEN THAT giua nhieu base da ke thua (vd
    # class Combo(BaseA, BaseB) voi ca 2 base cung khai bao field 'val' KHAC
    # dtype). Neu khong chan o day, CIL sinh field theo ten tho, se crash
    # MissingFieldException luc chay. Field kim cuong HOP LE (2 base cung 1
    # to tien chung, field den tu to tien do) KHONG duoc chan nham: 2 owner
    # khac nhau nhung f_tuple (ten, dtype) GIONG HET nhau -> day la ke thua
    # hop le qua to tien chung, khong phai collision. Chi collision THAT khi
    # cung 1 ten field nhung f_tuple KHAC NHAU giua cac owner (dtype khac,
    # hoac field khac ban chat) tu 2 base doc lap.
    # Moi ten field -> cac dtype KHAC NHAU gap qua cac base (2026-09-25: list
    # thay set-cua-tuple; f_tuple = (ten, dtype) nen tuple khac nhau <=> dtype
    # khac nhau). Thong diep giu y het: van ban tuple ('ten', 'dtype').
    _dtype_cua_truong = _bang_ds_chuoi_rong()
    for b in record_bases_found:
        if b in known_records:
            for f_tuple in known_records[b]:
                fn = f_tuple[0]
                if fn not in _dtype_cua_truong:
                    _dtype_cua_truong[fn] = []
                if f_tuple[1] not in _dtype_cua_truong[fn]:
                    _dtype_cua_truong[fn].append(f_tuple[1])
    _chi_tiet = []
    for fn in _dtype_cua_truong:
        if len(_dtype_cua_truong[fn]) > 1:
            _vb = []
            for _dt in _dtype_cua_truong[fn]:
                _vb.append("('" + fn + "', '" + _dt + "')")
            _chi_tiet.append(f"'{fn}' co dtype khac nhau giua cac base: {sorted(_vb)}")
    if _chi_tiet:
        details = '; '.join(_chi_tiet)
        raise TranspileError(
            f"class '{ten_c}': field trung ten giua nhieu base da ke thua ({details}) - "
            f"CIL sinh field theo ten tho, khong phan biet duoc field trung ten tu base khac nhau "
            f"(se crash MissingFieldException luc chay neu khong chan o day). Doi ten field o 1 "
            f"trong cac base de tranh trung.")
    methods_raw = []
    init_sig = ""
    init_body: "list[str]" = []
    for stmt in _ar_than(pool, class_nid):
        k = ar_kind(pool, stmt)
        if _ar_la_docstring(pool, stmt):
            continue  # docstring cua class
        if k == "pass":
            # (2026-10-12) `pass` trong than record - bo qua y het, cung duong
            # voi docstring o tren. Python that cho phep `class B(A): pass`:
            # lop con KHONG khai bao gi them ma van thuoc pha he cua base.
            # Record CIL duoc sinh tu danh sach field nen than rong la hop le.
            # Truoc day dong nay ruc vao nhanh validate ben duoi (chi nhan
            # 'annassign' / method THAT) nem TranspileError, va CA 2 compiler
            # cung tu choi y het - gap chung da dong o day.
            continue
        if k == "funcdef" and ar_col_a(pool, stmt) == '__init__' and (exc_bases or not _init_du_chu_thich(pool, stmt)):
            # (2026-09-25) CHI lop NGOAI LE con bo qua __init__ (thong diep di
            # qua System.Exception::.ctor(string)); lop thuong: __init__ la
            # METHOD THAT, goi sau .ctor - xem il_codegen._expr_call.
            # BO QUA HOAN TOAN luc transpile (khong dung de sinh CIL - .ctor
            # THAT duoc gen_record_types() tu sinh tu chinh cac field ben
            # duoi) - CHI de file .tkv van la Python HOP LE, chay duoc that
            # (vd 'Point(1.0, 2.0)' goi duoc duoi CPython that khi doi
            # chieu ket qua), giong dung tinh than '.tkv van la Python that'
            # da xac lap tu Buoc 9 (doi ten .py->.tkv).
            continue
        if k == "funcdef" and ar_col_a(pool, stmt) == '__init__':
            init_sig = _extract_record_method_sig_line(pool, class_nid, stmt, is_static=False)
            init_body = _body_source_lines(pool, source_lines, stmt)
        if (k == "funcdef" or k == "asyncfuncdef") and                 _ar_chi_cpython(pool, stmt):
            # PRAGMA `@__tkv_cpython_only__` (xem compiler/tkv_pragma.py):
            # gian giao DI TRU. Bo qua y het `__init__` o tren - CPython van
            # chay method nay, TokenVector coi nhu khong co. Khong co no thi
            # cau di tru duy nhat la khai SAI kieu cho `__getitem__`.
            continue
        if k == "funcdef" or k == "asyncfuncdef":
            # Method THAT (khong phai __init__) - KHOANG TRONG #1, khac
            # __init__: co bien dich THAT sang CIL instance method (xem
            # gen_il_method), khong chi bo qua.
            #
            # '@staticmethod' (Wave 1 Nhom B, 2026-07-29): method KHONG
            # 'self' - bien dich thanh CIL 'static' (nhu 1 ham top-level)
            # thay vi 'instance', van goi duoc qua cu phap CO SAN
            # 'obj.method(...)' (giong Python that: staticmethod goi qua
            # INSTANCE van hop le).
            # '@property' (Phase C.3, 2026-07-29): method la 1 GETTER binh
            # thuong (instance, CHI nhan 'self', co return type) -
            # 'obj.propname' (doc, KHONG goi ()) o BAT KY dau se duoc
            # desugar THANH 'obj.propname()' TRUOC KHI parse xuong
            # il_codegen.py (xem _desugar_property_reads). CHI ho tro
            # GETTER - KHONG ho tro setter (@x.setter): gan '.propname =
            # value' se bao loi ro rang o tang duoi vi KHONG duoc desugar.
            # '@classmethod'/decorator tuy bien khac KHONG duoc ho tro (can
            # 'cls' runtime, ngoai pham vi).
            ten_m = ar_col_a(pool, stmt)
            # Vong lap thay comprehension + hieu tap (2026-09-29): ban tu-host
            # chua dich duoc hai dang do.
            decorator_names: "list[str]" = []
            for d in _ar_decorator(pool, stmt):
                if d >= 0 and ar_kind(pool, d) == "name":
                    decorator_names.append(ar_col_a(pool, d))
            unsupported: "set[str]" = set()
            for dn in decorator_names:
                if dn != 'staticmethod' and dn != 'property':
                    unsupported.add(dn)
            if unsupported:
                raise TranspileError(
                    f"method '{ten_m}' cua class '{ten_c}': decorator "
                    f"{sorted(unsupported)} chua duoc ho tro (chi '@staticmethod'/'@property')")
            is_static = 'staticmethod' in decorator_names
            is_property = 'property' in decorator_names
            if is_static and is_property:
                raise TranspileError(
                    f"method '{ten_m}' cua class '{ten_c}': '@staticmethod' va "
                    f"'@property' khong the dung CUNG luc")
            if is_property and len(_ar_tham_so(pool, stmt).ten) != 1:
                raise TranspileError(
                    f"method '{ten_m}' cua class '{ten_c}': '@property' (getter) "
                    f"CHI duoc nhan dung 1 tham so 'self', khong tham so nao khac")
            sig_line = _extract_record_method_sig_line(pool, class_nid, stmt, is_static=is_static)
            body_lines = _body_source_lines(pool, source_lines, stmt)
            methods_raw.append((sig_line, body_lines, is_static, is_property))
            continue
        # `annassign` co kids = [dich, annotation, GIA TRI]; -1 = khong co
        # gia tri khoi tao (dang DUY NHAT duoc chap nhan lam field).
        con = ar_kids(pool, stmt) if k == "annassign" else []
        if k != "annassign" or (len(con) > 2 and con[2] >= 0):
            raise TranspileError(
                f"class '{ten_c}': 'class dang record' chi ho tro cac dong "
                f"khai bao field DON THUAN 'ten: \"dtype\"' (khong gia tri mac dinh), "
                f"1 '__init__' TUY CHON (bi qua luc bien dich), va cac method THAT "
                f"(tham so dau '(self)') - gap {k} o dong {ar_line_lo(pool, stmt)}")
        if con[0] < 0 or ar_kind(pool, con[0]) != "name":
            raise TranspileError(
                f"class '{ten_c}': field o dong {ar_line_lo(pool, stmt)} phai la 1 ten don")
        ten_f = ar_col_a(pool, con[0])
        dtype = _annotation_to_type_str(pool, con[1], f"class '{ten_c}' field '{ten_f}'")
        # Field KHONG vo huong (container 'list[str]'/'dict[k,v]', hoac 1
        # class khac) GIU NGUYEN VAN BAN o day - ten class trong CUNG file
        # co the khai bao SAU ('class A: b: "B"'), nen viec phan giai doi
        # sang _resolve_record_field_types(), chay khi da biet DU ten cac
        # record (2026-08-03, dot 1).
        if ten_f in dict(base_fields):
            raise TranspileError(
                f"class '{ten_c}': field '{ten_f}' da co san o base class "
                f"'{base_name}' - khong duoc khai bao lai (ghi de field ke thua chua ho tro)")
        fields.append((ten_f, dtype))
    if not fields:
        raise TranspileError(f"class '{ten_c}': record khong co field nao")
    return DinhNghiaLop(fields, methods_raw, base_name, base_info, interface_names, init_sig, init_body)


def _tach_khoang_trang(v: "str") -> "list[str]":
    """Tuong duong str.split() KHONG doi so (2026-09-25): tach theo moi khoang
    trang (space/tab/xuong dong), bo phan rong."""
    ra_tach = []
    cur = ''
    for c in v:
        if c == ' ' or c == '\t' or c == '\n' or c == '\r':
            if cur != '':
                ra_tach.append(cur)
            cur = ''
        else:
            cur = cur + c
    if cur != '':
        ra_tach.append(cur)
    return ra_tach


def _extract_namedtuple_def(pool: "list[str]", assign_nid: "i32") -> "(str,list[(str,str)])":
    """'Point = namedtuple("Point", ["x", "y"])' hoac dang chuoi cach nhau
    boi khoang trang 'namedtuple("Point", "x y")' (Phase 3.2, 2026-08-11).
    Desugar NGAY O TANG PARSE thanh field list dung dinh dang (name, dtype)
    HET NHU 1 record thuong - field MAC DINH kieu "i32".

    Tra ve (record_name, fields: list[(name, "i32")])."""
    acon = ar_kids(pool, assign_nid)
    record_name = ar_col_a(pool, acon[0])
    call = acon[-1]
    ccon = ar_kids(pool, call)
    # `call` co kids = [ham, arg...]; cot b la CSV ten keyword (rong = vi tri).
    args = ccon[1:]
    co_keyword = False
    for ten_kw in ar_csv_names(ar_col_b(pool, call)):
        if ten_kw:
            co_keyword = True
    if len(args) < 2 or co_keyword:
        raise TranspileError(
            f"'{record_name} = namedtuple(...)': can dung 2 tham so vi tri "
            f"(typename:str, field_names:list[str] hoac str cach nhau boi "
            f"khoang trang), khong ho tro tham so keyword")
    typename_nid, fields_nid = args[0], args[1]
    if typename_nid < 0 or ar_kind(pool, typename_nid) != "const_str":
        raise TranspileError(f"'{record_name} = namedtuple(...)': tham so dau (typename) phai la 1 chuoi")
    typename = ar_col_a(pool, typename_nid)
    if typename != record_name:
        raise TranspileError(
            f"'{record_name} = namedtuple(\"{typename}\", ...)': typename phai GIONG "
            f"ten bien duoc gan ('{record_name}') - chua ho tro 2 ten khac nhau")
    kind_f = ar_kind(pool, fields_nid) if fields_nid >= 0 else ""
    if kind_f == "const_str":
        field_names = _tach_khoang_trang(ar_col_a(pool, fields_nid).replace(',', ' '))
    elif kind_f in ("list", "tuple") and _moi_con_la_chuoi(pool, fields_nid):
        field_names = [ar_col_a(pool, e) for e in ar_kids(pool, fields_nid)]
    else:
        raise TranspileError(
            f"'{record_name} = namedtuple(...)': tham so thu 2 (field_names) phai la 1 list "
            f"chuoi hoac 1 chuoi cach nhau boi khoang trang, vd ['x','y'] hoac \"x y\"")
    if not field_names:
        raise TranspileError(f"'{record_name} = namedtuple(...)': can it nhat 1 field")
    return record_name, [(fn, 'i32') for fn in field_names]


_FUNC_NAME_RE = re.compile(r'^(\w+)\(')


def _desugar_property_reads(body_lines: "list[str]", property_names: "set[str]") -> "list[str]":
    """@property (Phase C.3, 2026-07-29, xem project-tokenvector-wave2-
    status memory - huong B da chot): rewrite VAN BAN THO 'obj.propname'
    (truy cap kieu FIELD, KHONG co '()') THANH 'obj.propname()' (goi
    method THAT) cho MOI ten trong 'property_names' - ap dung TOAN CUC
    theo TEN (khong scope theo tung kieu record cu the, don gian hoa co
    y thuc: 2 record KHAC NHAU dat CUNG 1 ten property se CHIA SE quy tac
    desugar - chap nhan duoc vi ten property thuong mang tinh mo ta ro
    rang, giong quy uoc dat ten bien khac trong DSL).

    CHI desugar dang DOC (khong theo sau '(' - tranh sua 'obj.propname()'
    da la 1 loi goi that thanh 2 cap ngoac). KHONG xu ly dang GHI ('obj.
    propname = value') - @property setter CHUA ho tro, dang GHI se KHONG
    duoc desugar nen tu nhien bao loi ro rang o tang duoi (field khong ton
    tai, vi 'propname' khong phai field THAT cua record)."""
    if not property_names:
        return body_lines
    prop_re = re.compile(r'\b(\w+)\.(' + '|'.join([re.escape(p) for p in property_names]) + r')\b(?!\s*\()')
    # Chuoi thay the thay lambda (2026-09-25) - cung ket qua 'obj.ten()'.
    return [prop_re.sub(r'\1.\2()', line) for line in body_lines]


_EXTERN_METHOD_KEYS: "set[str]" = {'name', 'assembly', 'class', 'method', 'params', 'returns'}
_EXTERN_METHOD_REQUIRED: "set[str]" = {'name', 'assembly', 'class', 'method', 'returns'}


# --- doc arena cho pragma dict-literal (P8 Task 6 lo 2) ---------------
# TRUOC: cac ham duoi nhan node `ast.Dict`/`ast.List`/`ast.Constant` da vat
# chat hoa. Nay chung doc THANG arena.
#
# KHAC BIET PHAI DO CHU KHONG DOAN: `ast.Dict` tach `.keys` va `.values`
# thanh HAI list; arena de khoa va gia tri XEN KE trong CUNG mot `kids`
# ([k1, v1, k2, v2, ...]). Doan nham cho nay thi moi pragma deu parse sai.

def _ar_cap_dict(pool: "list[str]", nid: "i32") -> "list[(i32,i32)]":
    """Cac cap (khoa_nid, gia_tri_nid) cua mot dong `dict` trong arena."""
    con = ar_kids(pool, nid)
    ra = []
    i = 0
    while i + 1 < len(con):
        ra.append((con[i], con[i + 1]))
        i = i + 2
    return ra


def _ar_chuoi(pool: "list[str]", nid: "i32") -> "str":
    """Gia tri neu `nid` la string literal, else None."""
    if nid < 0 or ar_kind(pool, nid) != "const_str":
        return None
    return ar_col_a(pool, nid)


def _ar_bool(pool: "list[str]", nid: "i32") -> "i32":
    """1 (True) / 0 (False) neu `nid` la bool literal, -1 neu khong phai (i32 khong mang duoc None)."""
    if nid < 0 or ar_kind(pool, nid) != "const_bool":
        return -1
    if ar_col_a(pool, nid) == "True":
        return 1
    return 0


def _ar_la_list(pool: "list[str]", nid: "i32") -> "i32":
    return nid >= 0 and ar_kind(pool, nid) == "list"


def _ar_la_dict(pool: "list[str]", nid: "i32") -> "i32":
    return nid >= 0 and ar_kind(pool, nid) == "dict"


class ExternHam:
    """Mot muc __tkv_extern_method__ (2026-09-25 - thay dict khong dong nhat)."""

    name: "str"
    assembly: "str"
    lop_clr: "str"
    method: "str"
    params: "list[str]"
    returns: "str"

    def __init__(self, name: "str", assembly: "str", lop_clr: "str", method: "str", params: "list[str]", returns: "str"):
        self.name = name
        self.assembly = assembly
        self.lop_clr = lop_clr
        self.method = method
        self.params = params
        self.returns = returns


class ExternPinvoke:
    """Mot muc __tkv_extern_pinvoke__."""

    name: "str"
    dll: "str"
    symbol: "str"
    convention: "str"
    params: "list[str]"
    returns: "str"

    def __init__(self, name: "str", dll: "str", symbol: "str", convention: "str", params: "list[str]", returns: "str"):
        self.name = name
        self.dll = dll
        self.symbol = symbol
        self.convention = convention
        self.params = params
        self.returns = returns


class ExternPt:
    """Mot method (thuong hoac static) cua __tkv_extern_class__."""

    name: "str"
    params: "list[str]"
    returns: "str"

    def __init__(self, name: "str", params: "list[str]", returns: "str"):
        self.name = name
        self.params = params
        self.returns = returns


class ExternTt:
    """Mot property cua __tkv_extern_class__; readonly mac dinh True."""

    name: "str"
    dtype: "str"
    readonly: "i32"

    def __init__(self, name: "str", dtype: "str", readonly: "i32"):
        self.name = name
        self.dtype = dtype
        self.readonly = readonly


class ExternLop:
    """Mot muc __tkv_extern_class__ (khoa 'class' cua pragma -> lop_clr)."""

    name: "str"
    assembly: "str"
    lop_clr: "str"
    ctor: "list[str]"
    methods: "list[ExternPt]"
    properties: "list[ExternTt]"
    static_methods: "list[ExternPt]"

    def __init__(self, name: "str", assembly: "str", lop_clr: "str", ctor: "list[str]", methods: "list[ExternPt]", properties: "list[ExternTt]", static_methods: "list[ExternPt]"):
        self.name = name
        self.assembly = assembly
        self.lop_clr = lop_clr
        self.ctor = ctor
        self.methods = methods
        self.properties = properties
        self.static_methods = static_methods


def _parse_extern_method_dict_literal(pool: "list[str]", nid: "i32") -> "ExternHam":
    """__tkv_extern_method__ (Task 2, 2026-08-14 - xem docs/superpowers/
    plans/2026-08-14-extern-method.md): parse 1 phan tu dict-literal cua
    pragma thanh record ExternHam (2026-09-25; truoc la dict khong dong
    nhat) - validate SHAPE (dict, key hop le, value dung kieu) o day;
    validate NGHIEP VU (dtype hop le, assembly da khai bao, trung ten
    builtin...) la Task 3."""
    if not _ar_la_dict(pool, nid):
        raise TranspileError(
            "__tkv_extern_method__: moi phan tu phai la 1 dict voi cac key "
            "name/assembly/class/method/params/returns")
    chuoi = {}
    params = []
    co_khoa = set()
    for k_nid, v_nid in _ar_cap_dict(pool, nid):
        key = _ar_chuoi(pool, k_nid)
        if key is None:
            raise TranspileError("__tkv_extern_method__: key dict phai la chuoi")
        if key not in _EXTERN_METHOD_KEYS:
            raise TranspileError(
                f"__tkv_extern_method__: key '{key}' khong hop le - chi chap nhan "
                f"{sorted(_EXTERN_METHOD_KEYS)}")
        co_khoa.add(key)
        if key == 'params':
            if not _ar_la_list(pool, v_nid):
                raise TranspileError("__tkv_extern_method__: 'params' phai la 1 list chuoi")
            params = []
            for elt in ar_kids(pool, v_nid):
                s = _ar_chuoi(pool, elt)
                if s is None:
                    raise TranspileError("__tkv_extern_method__: moi phan tu 'params' phai la chuoi")
                params.append(s)
        else:
            s = _ar_chuoi(pool, v_nid)
            if s is None:
                raise TranspileError(f"__tkv_extern_method__: gia tri '{key}' phai la chuoi")
            chuoi[key] = s
    co_khoa.add('params')
    missing = _thieu_khoa(_EXTERN_METHOD_REQUIRED, co_khoa)
    if missing:
        raise TranspileError(
            f"__tkv_extern_method__: thieu key bat buoc {sorted(missing)}")
    return ExternHam(chuoi['name'], chuoi['assembly'], chuoi['class'], chuoi['method'],
                     params, chuoi['returns'])


_EXTERN_CLASS_KEYS: "set[str]" = {'name', 'assembly', 'class', 'ctor', 'methods', 'properties', 'static_methods'}
_EXTERN_CLASS_REQUIRED: "set[str]" = {'name', 'assembly', 'class', 'ctor', 'methods'}
_EXTERN_CLASS_METHOD_KEYS: "set[str]" = {'name', 'params', 'returns'}
_EXTERN_CLASS_METHOD_REQUIRED: "set[str]" = {'name', 'params', 'returns'}
_EXTERN_CLASS_PROPERTY_KEYS: "set[str]" = {'name', 'dtype', 'readonly'}
_EXTERN_CLASS_PROPERTY_REQUIRED: "set[str]" = {'name', 'dtype'}


def _parse_str_list_literal(pool: "list[str]", nid: "i32", ctx_label: "str") -> "list[str]":
    if not _ar_la_list(pool, nid):
        raise TranspileError(f"{ctx_label} phai la 1 list")
    out = []
    for elt in ar_kids(pool, nid):
        s = _ar_chuoi(pool, elt)
        if s is None:
            raise TranspileError(f"{ctx_label}: moi phan tu phai la string literal")
        out.append(s)
    return out


def _parse_extern_class_method_dict_literal(pool: "list[str]", nid: "i32") -> "ExternPt":
    if not _ar_la_dict(pool, nid):
        raise TranspileError("__tkv_extern_class__'s 'methods': moi phan tu phai la 1 dict-literal")
    chuoi = {}
    params = []
    co_khoa = set()
    for k_nid, v_nid in _ar_cap_dict(pool, nid):
        key = _ar_chuoi(pool, k_nid)
        if key is None:
            raise TranspileError("__tkv_extern_class__'s method dict: key phai la string literal")
        if key not in _EXTERN_CLASS_METHOD_KEYS:
            raise TranspileError(
                f"__tkv_extern_class__'s method dict: key {key!r} khong hop le, "
                f"chi chap nhan {sorted(_EXTERN_CLASS_METHOD_KEYS)}")
        co_khoa.add(key)
        if key == 'params':
            params = _parse_str_list_literal(pool, v_nid, "__tkv_extern_class__'s method 'params'")
        else:
            s = _ar_chuoi(pool, v_nid)
            if s is None:
                raise TranspileError(f"__tkv_extern_class__'s method dict: key {key!r} phai la string literal")
            chuoi[key] = s
    missing = _thieu_khoa(_EXTERN_CLASS_METHOD_REQUIRED, co_khoa)
    if missing:
        raise TranspileError(f"__tkv_extern_class__'s method dict thieu key bat buoc: {sorted(missing)}")
    return ExternPt(chuoi['name'], params, chuoi['returns'])


def _parse_extern_class_property_dict_literal(pool: "list[str]", nid: "i32") -> "ExternTt":
    """__tkv_extern_class__ (Task 1, extern-class-property): parse 1 phan tu
    dict-literal cua key 'properties' thanh record ExternTt (2026-09-25;
    truoc la dict) - validate SHAPE o day (dict, key hop le, value dung
    kieu); 'readonly' mac dinh True neu vang mat. Validate NGHIEP VU (dtype
    hop le, collision voi 'methods'...) la o compile_tkv_cli."""
    if not _ar_la_dict(pool, nid):
        raise TranspileError("__tkv_extern_class__'s 'properties': moi phan tu phai la 1 dict-literal")
    chuoi = {}
    readonly = True
    co_khoa = set()
    for k_nid, v_nid in _ar_cap_dict(pool, nid):
        key = _ar_chuoi(pool, k_nid)
        if key is None:
            raise TranspileError("__tkv_extern_class__'s property dict: key phai la string literal")
        if key not in _EXTERN_CLASS_PROPERTY_KEYS:
            raise TranspileError(
                f"__tkv_extern_class__'s property dict: key {key!r} khong hop le, "
                f"chi chap nhan {sorted(_EXTERN_CLASS_PROPERTY_KEYS)}")
        co_khoa.add(key)
        if key == 'readonly':
            b = _ar_bool(pool, v_nid)
            if b < 0:
                raise TranspileError("__tkv_extern_class__'s property 'readonly' phai la True/False")
            readonly = b == 1
        else:
            s = _ar_chuoi(pool, v_nid)
            if s is None:
                raise TranspileError(f"__tkv_extern_class__'s property dict: key {key!r} phai la string literal")
            chuoi[key] = s
    missing = _thieu_khoa(_EXTERN_CLASS_PROPERTY_REQUIRED, co_khoa)
    if missing:
        raise TranspileError(f"__tkv_extern_class__'s property dict thieu key bat buoc: {sorted(missing)}")
    return ExternTt(chuoi['name'], chuoi['dtype'], readonly)


def _parse_extern_class_dict_literal(pool: "list[str]", nid: "i32") -> "ExternLop":
    """__tkv_extern_class__ (Task 1, 2026-08-18 - xem docs/superpowers/
    plans/extern-class): parse 1 phan tu dict-literal cua pragma thanh
    record ExternLop (2026-09-25; truoc la dict khong dong nhat) - validate
    SHAPE (dict, key hop le, value dung kieu) o day; validate NGHIEP VU
    (dtype hop le, assembly da khai bao...) la Task 3, giong het cach lam
    voi _parse_extern_method_dict_literal."""
    if not _ar_la_dict(pool, nid):
        raise TranspileError("__tkv_extern_class__ phai la 1 list cac dict-literal")
    chuoi = {}
    ctor = []
    methods = []
    properties = []
    static_methods = []
    co_khoa = set()
    for k_nid, v_nid in _ar_cap_dict(pool, nid):
        key = _ar_chuoi(pool, k_nid)
        if key is None:
            raise TranspileError("__tkv_extern_class__: key phai la string literal")
        if key not in _EXTERN_CLASS_KEYS:
            raise TranspileError(
                f"__tkv_extern_class__: key {key!r} khong hop le, "
                f"chi chap nhan {sorted(_EXTERN_CLASS_KEYS)}")
        co_khoa.add(key)
        if key == 'ctor':
            ctor = _parse_str_list_literal(pool, v_nid, "__tkv_extern_class__'s 'ctor'")
        elif key == 'methods':
            if not _ar_la_list(pool, v_nid):
                raise TranspileError("__tkv_extern_class__'s 'methods' phai la 1 list")
            methods = [_parse_extern_class_method_dict_literal(pool, m)
                       for m in ar_kids(pool, v_nid)]
        elif key == 'properties':
            if not _ar_la_list(pool, v_nid):
                raise TranspileError("__tkv_extern_class__'s 'properties' phai la 1 list")
            properties = [_parse_extern_class_property_dict_literal(pool, p)
                          for p in ar_kids(pool, v_nid)]
        elif key == 'static_methods':
            # Task 2 (Phase 9d Part A, 2026-08-26): 'static_methods' dung
            # CHUNG shape voi 'methods' (dict {'name','params','returns'}) -
            # tai su dung y het _parse_extern_class_method_dict_literal,
            # KHONG viet ham parse rieng.
            if not _ar_la_list(pool, v_nid):
                raise TranspileError("__tkv_extern_class__'s 'static_methods' phai la 1 list")
            static_methods = [_parse_extern_class_method_dict_literal(pool, m)
                              for m in ar_kids(pool, v_nid)]
        else:
            s = _ar_chuoi(pool, v_nid)
            if s is None:
                raise TranspileError(f"__tkv_extern_class__: key {key!r} phai la string literal")
            chuoi[key] = s
    co_khoa.add('properties')
    co_khoa.add('static_methods')
    missing = _thieu_khoa(_EXTERN_CLASS_REQUIRED, co_khoa)
    if missing:
        raise TranspileError(f"__tkv_extern_class__ thieu key bat buoc: {sorted(missing)}")
    return ExternLop(chuoi['name'], chuoi['assembly'], chuoi['class'], ctor, methods,
                     properties, static_methods)


_EXTERN_PINVOKE_KEYS: "set[str]" = {'name', 'dll', 'symbol', 'convention', 'params', 'returns'}
_EXTERN_PINVOKE_REQUIRED: "set[str]" = {'name', 'dll', 'symbol', 'convention', 'returns'}


def _parse_extern_pinvoke_dict_literal(pool: "list[str]", nid: "i32") -> "ExternPinvoke":
    """__tkv_extern_pinvoke__ (Task 2, 2026-08-17 - xem docs/superpowers/
    plans/2026-08-17-extern-pinvoke.md): parse 1 phan tu dict-literal cua
    pragma thanh record ExternPinvoke (2026-09-25; truoc la dict khong dong
    nhat: name/dll/symbol/convention/params/returns) - validate SHAPE
    (dict, key hop le, value dung kieu) o day; validate NGHIEP VU (dtype
    hop le, sinh pinvokeimpl, dang ky dong builtin...) la Task 3."""
    if not _ar_la_dict(pool, nid):
        raise TranspileError(
            "__tkv_extern_pinvoke__: moi phan tu phai la 1 dict voi cac key "
            "name/dll/symbol/convention/params/returns")
    chuoi = {}
    params = []
    co_khoa = set()
    for k_nid, v_nid in _ar_cap_dict(pool, nid):
        key = _ar_chuoi(pool, k_nid)
        if key is None:
            raise TranspileError("__tkv_extern_pinvoke__: key dict phai la chuoi")
        if key not in _EXTERN_PINVOKE_KEYS:
            raise TranspileError(
                f"__tkv_extern_pinvoke__: key '{key}' khong hop le - chi chap nhan "
                f"{sorted(_EXTERN_PINVOKE_KEYS)}")
        co_khoa.add(key)
        if key == 'params':
            if not _ar_la_list(pool, v_nid):
                raise TranspileError("__tkv_extern_pinvoke__: 'params' phai la 1 list chuoi")
            params = []
            for elt in ar_kids(pool, v_nid):
                s = _ar_chuoi(pool, elt)
                if s is None:
                    raise TranspileError("__tkv_extern_pinvoke__: moi phan tu 'params' phai la chuoi")
                params.append(s)
        else:
            s = _ar_chuoi(pool, v_nid)
            if s is None:
                raise TranspileError(f"__tkv_extern_pinvoke__: gia tri '{key}' phai la chuoi")
            chuoi[key] = s
    co_khoa.add('params')
    missing = _thieu_khoa(_EXTERN_PINVOKE_REQUIRED, co_khoa)
    if missing:
        raise TranspileError(
            f"__tkv_extern_pinvoke__: thieu key bat buoc {sorted(missing)}")
    return ExternPinvoke(chuoi['name'], chuoi['dll'], chuoi['symbol'], chuoi['convention'],
                         params, chuoi['returns'])


# Task 3 (2026-08-14, __tkv_extern_method__): bang dtype DSL -> ten kieu CIL
# dung trong chu ky 'call' - doi chieu IL_SCALAR (il_core.py) de khong lech
# chinh ta ('int32'/'float64'/'string'...). Khong dua 'object'/'thread' vao
# day - Phase 1 CHI ho tro scalar co ban (xem spec "Pham vi KHONG lam").
#
# Phase 9b (2026-08-24, bool): 'bool' la 1 ngoai le CO CHU DICH cua nguyen
# tac tren - KHONG phai "mo rong tuy tien". .NET IL 'bool' tuong thich
# bit-for-bit voi 'int32' tren CIL evaluation stack (0/1, khong can
# conv.* chuyen doi), CHI khac ten kieu trong CHU KY method (dung de .NET
# runtime resolve overload luc nap assembly - sai ten kieu la nguyen nhan
# MissingMethodException, xem bai hoc Critical 2 cua Phase 9a). TokenVector
# KHONG co kieu bool rieng - gia tri phia TokenVector LUON la i32 (0/1),
# 'bool' O DAY chi la 1 NHAN CHO CHU KY IL, khong phai 1 dtype TokenVector
# moi (KHONG dua vao typed_dsl_parser.py's DTYPES - xem Global Constraints
# cua plan Phase 9b). _widen_if_needed (il_codegen.py) da xac nhan AN TOAN
# no-op voi dtype la 'bool' (khong khop nhanh if nao, khong KeyError) -
# khong can sua gi them o codegen.

def _is_valid_extern_dtype(dtype: "str") -> "i32":
    """True neu dtype la 1 scalar co dinh (_EXTERN_DTYPE_TO_IL) HOAC 1
    dtype enum hop le dinh dang 'enum:<assembly>:<FullName>' (Phase 9c).
    KHONG kiem tra extern_class_defs/container o day - nguoi goi tu ket
    hop voi cac dieu kien do, giong het pattern '_dtype not in
    _EXTERN_DTYPE_TO_IL and _dtype not in extern_class_defs' da co.

    LUU Y (final review Phase 9c, Important #3): dinh dang 'enum:...' o
    day CHI xac nhan cu phap (2 phan dot-separated identifier hop le),
    KHONG xac minh underlying type cua enum thuc su la System.Int32 -
    dieu do do ben sinh dtype dam bao (tools/tkv_bind/type_map.py::
    map_enum). Xem comment tai dinh nghia _EXTERN_ENUM_DTYPE_RE ve rui ro
    khi 1 file .tkv viet tay dung dtype nay cho enum khong backed Int32."""
    return dtype in _EXTERN_DTYPE_TO_IL or bool(_EXTERN_ENUM_DTYPE_RE.match(dtype))




# Phase 9g (2026-08-27): grammar CHUOI GON cho dtype 'array[T]' - CHI 5
# kieu scalar {i32,i64,f32,f64,str} (KHONG 'bool' - xem Global Constraints
# cua plan nay), KHONG dung _parse_type_ann_str (khac han 'list[T]' - do
# la kieu TokenVector THAT, con 'array[T]' CHI ton tai o bien extern, khong
# co gia tri "TypeAnn shape='array'" nao trong he thong kieu TokenVector).
_EXTERN_ARRAY_DTYPE_RE = re.compile(r'^array\[(i32|i64|f32|f64|str)\]$')
# Phase 9i (2026-08-28): grammar cho 'array[array[T]]' - DUNG DUY NHAT 1
# cap long (T van chi 5 scalar, khong ho tro long them 1 cap nua - vd
# 'array[array[array[i32]]]' KHONG khop regex nay, tu dong bi tu choi o
# _validate_extern_class_container_dtype ma khong can code rieng chan).
_EXTERN_NESTED_ARRAY_DTYPE_RE = re.compile(
    r'^array\[array\[(i32|i64|f32|f64|str)\]\]$')


def _validate_extern_class_container_dtype(_dtype: "str", extern_class_defs: "dict[str,i32]", ctx_label: "str") -> "i32":
    """Task 1 (extern-class-list, 2026-08-18) + Task 1 (extern-class-dict,
    2026-08-19): validate 1 dtype string KHONG khop _EXTERN_DTYPE_TO_IL/
    extern_class_defs truc tiep - xu ly 2 dang container: 'list[T]' (T =
    scalar hop le HOAC 1 handle type da khai) va 'dict[K,V]' (K = CHI
    scalar - parser tu ep dieu nay san, xem typed_dsl_parser.py dong
    222-233; V = scalar HOAC 1 handle type da khai, giong T cua list).
    Dung parse_type_ann_str (compiler/typed_dsl_parser.py) de parse va
    tai dung logic validate dtype cua no (record_names KHONG truyen vao -
    extern_class field khong tham chieu record). Tu choi container-cua-
    container (list/dict long nhau) bang check elem_ta.shape sau khi
    parse. Raise TranspileError (khong phai SyntaxError) de dong nhat voi
    cac nhanh validate khac trong ham goi - ctx_label la doan mo ta ngu
    canh (vd ten method/'ctor') de gop vao message loi cho de debug.
    Neu _dtype KHONG bat dau bang 'list[' hoac 'dict[' (khong phai
    container ho tro), tra ve False - nguoi goi tu quyet dinh raise loi cu
    (message khac nhau giua 4 diem goi nen khong gop vao day)."""
    if _dtype.startswith('list['):
        try:
            _list_ta = _parse_type_ann_str(_dtype, extern_class_names=_khoa_thanh_tap(extern_class_defs))
        except SyntaxError as e:
            raise TranspileError(
                f"__tkv_extern_class__: {ctx_label} dung dtype {_dtype!r} khong hop le - {e}")
        if _list_ta.elem_ta is not None and _list_ta.elem_ta.shape_ten in ('list', 'dict'):
            # Phase 7 (2026-08-19): 'list[list[T]]' (T scalar, DUNG 2 lop)
            # duoc CHO PHEP - truoc day CHAN TUYET DOI moi 'list'/'dict'
            # long nhau. Van CHAN: (a) elem_ta.shape_ten=='dict' (khong lam
            # list[dict[...]] o lan nay), (b) elem_ta.shape_ten=='list' NHUNG
            # LOP TRONG DO LAI long them 1 lop nua (elem_ta.elem_ta is not
            # None - tuc 3 lop tro len), (c) elem_ta.shape_ten=='list' va T
            # (dtype cua lop trong cung) la handle-type (nam trong
            # extern_class_defs) - chi ho tro T scalar trong lan nay.
            #
            # BUG THAT tim thay o phien nay (regression tu ban vet Phase 7
            # dau tien): dieu kien o TREN truoc day la 'elem_ta is not
            # None' KHONG kem 'shape in (list, dict)' - 'list[HandleType]'
            # (vd 'list[Sb]') CUNG co elem_ta != None (parser boc
            # TypeAnn(Sb, 'extern_class') lam elem_ta cho MOI dtype IDENT
            # khong phai scalar thuong, xem typed_dsl_parser.py's parse_type_ann,
            # nhanh 'list'), nen bi lot vao nhanh nay VA bi tu choi NHAM
            # (elem_ta.shape_ten=='extern_class' != 'list' -> is_ok_list_of_list=False)
            # - phat hien qua extern_class_list_parse_test.py's
            # 'list_handle_return_accepted' bi tu choi nham. Them dieu
            # kien 'shape in (list, dict)' o TREN de CHI vao nhanh nay khi
            # THAT SU la container long nhau (list/dict o trong), giu
            # nguyen duong 'list[HandleType]' don gian (elem_ta.shape_ten==
            # 'extern_class') di thang qua 'return True' ben duoi, KHONG
            # dong cham gi (giong het hanh vi TRUOC Phase 7).
            is_ok_list_of_list = (
                _list_ta.elem_ta.shape_ten == 'list'
                and _list_ta.elem_ta.elem_ta is None
                and _list_ta.elem_ta.dtype not in extern_class_defs
            )
            if not is_ok_list_of_list:
                raise TranspileError(
                    f"__tkv_extern_class__: {ctx_label} dung dtype {_dtype!r} - KHONG ho tro "
                    f"container-cua-container dang nay (chi ho tro dung 'list[list[T]]' voi "
                    f"T la dtype vo huong, khong ho tro dict long nhau/3 lop tro len/T la "
                    f"handle-type)")
        return True
    if _dtype.startswith('dict['):
        try:
            _dict_ta = _parse_type_ann_str(_dtype, extern_class_names=_khoa_thanh_tap(extern_class_defs))
        except SyntaxError as e:
            raise TranspileError(
                f"__tkv_extern_class__: {ctx_label} dung dtype {_dtype!r} khong hop le - {e}")
        # K (khoa) da bi parser tu ep ve DTYPES (scalar) TRUOC KHI toi
        # day - 1 K khong hop le (vd 1 ten handle type) da lam
        # parse_type_ann_str tu raise SyntaxError o tren roi, KHONG can
        # kiem tra rieng K o day.
        if _dict_ta.elem_ta is not None and _dict_ta.elem_ta.shape_ten in ('list', 'dict'):
            raise TranspileError(
                f"__tkv_extern_class__: {ctx_label} dung dtype {_dtype!r} - KHONG ho tro "
                f"container-cua-container (list/dict long nhau)")
        return True
    if _dtype.startswith('array['):
        if _EXTERN_ARRAY_DTYPE_RE.match(_dtype):
            return True
        # Phase 9i (2026-08-28): 'array[array[T]]' - DUNG 1 cap long, T
        # van chi 5 scalar (KHONG handle-type, KHONG bool/enum, KHONG long
        # them 1 cap nua - regex da tu gioi han dieu do, xem dinh nghia
        # _EXTERN_NESTED_ARRAY_DTYPE_RE). Check TRUOC nhanh handle-type
        # ben duoi - neu khong, '_elem' se la 'array[i32]' (khong nam
        # trong extern_class_defs) va bi rot xuong raise nham.
        if _EXTERN_NESTED_ARRAY_DTYPE_RE.match(_dtype):
            return True
        # Phase 9j (2026-08-28): 'array[array[Widget]]' - T (phan tu
        # TRONG) la 1 handle-type DA khai (khong phai 5 scalar) - mo rong
        # Phase 9i giong het cach Phase 9h mo rong array[T] 1 cap. KHONG
        # sua nested_array_extern.py (codegen da tong quat theo inner_elem
        # tu Phase 9i, xem dieu tra plan nay) - CHI can cho qua validate.
        if _dtype.startswith('array[array[') and _dtype.endswith(']]'):
            _inner = _dtype[len('array[array['):-2]
            if _inner in extern_class_defs:
                return True
        # Phase 9h (2026-08-27): 'array[T]' voi T la 1 handle-type DA khai
        # (nam trong extern_class_defs) - mo rong ngoai 5 scalar Phase 9g,
        # dung idiom marshal GIONG HET (ToArray()/List<T>::.ctor(IEnumerable<T>)),
        # chi khac IL text phan tu (xem _il_array_elem_type, il_codegen.py).
        _elem = _dtype[len('array['):-1]
        if _elem in extern_class_defs:
            return True
        raise TranspileError(
            f"__tkv_extern_class__: {ctx_label} dung dtype {_dtype!r} khong hop le - "
            f"'array[T]' chi ho tro T la 1 trong {{'i32','i64','f32','f64','str'}}, "
            f"'array[array[T]]' (T cung tap do, DUNG 1 cap long), 1 handle-type DA khai "
            f"qua __tkv_extern_class__ trong file nay, hoac 'array[array[HandleType]]' "
            f"(HandleType DA khai, DUNG 1 cap long) (khong ho tro "
            f"bool/enum/handle-type CHUA khai/mang 2 chieu vuong T[,]/long qua 1 cap)")
    return False

# Regex ten class .NET hop le (vd 'System.Math', 'MyLib.Foo_Bar') va ten
# method don gian (khong dau cham, vd 'Pow') - dung de validate buoc 2/3
# cua _validate_and_register_extern_method (KHONG phai validate day du CLI
# ten .NET, chi chan cac gia tri ro rang sai/injection vao chuoi IL).
_EXTERN_CLASS_NAME_RE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$')
_EXTERN_METHOD_NAME_RE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*$')
# Regex ten assembly .NET hop le (vd 'System.Math', 'MyLib.Foo_Bar') - dung de
# validate buoc (1) cua _validate_and_register_extern_method (fix review
# finding M2: 'assembly' truoc day chi check membership, khong check FORMAT -
# cung dang regex voi _EXTERN_CLASS_NAME_RE vi ten assembly .NET cung theo
# quy tac chu/so/gach duoi/dau cham).
_EXTERN_ASSEMBLY_NAME_RE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$')

# 3 assembly .NET GAC mac dinh LUON co san (khong can nguoi dung khai bao qua
# __tkv_extern_assembly__) - hang so module-level DUY NHAT, dung CHUNG boi ca
# declared_assembly_names (validate __tkv_extern_method__) LAN seen_extern
# (dedupe '.assembly extern' phat sinh) trong compile_tkv_cli (fix review
# finding M4: truoc day 2 noi tu viet lai literal set nay, de lech neu sua 1
# cho ma quen cho kia).
_DEFAULT_GAC_ASSEMBLIES: "set[str]" = {'mscorlib', 'System', 'System.Core'}


def _make_extern_static_call_codegen(assembly: "str", dotnet_class: "str", method_name: "str",
                                      param_dtypes: "list[str]", return_dtype: "str") -> "func(list[TkvNode],Scope,list[str],str,Ctx)->void":
    """Factory tra ve codegen_fn dung chu ky active().expr_builtin_codegen hien co
    (fn(args, scope, out, dtype, ctx), doi chieu
    il_features/stdlib_math.py::_make_math_func_compiler) - goi 1 static
    method .NET NGOAI qua 'call'. KHAC _make_math_func_compiler: MOI tham
    so ep theo dung dtype khai bao RIENG vi tri cua no (params_dtypes[i]),
    khong ep dong loat 1 dtype - vd System.Math::Pow(f64,f64) nhung 1 ham
    khac co the la (i32,f64). Tinh truoc il_param_types/il_ret_type/
    call_prefix NGOAI closure (chi tinh 1 lan luc dang ky, khong tinh lai
    moi lan goi bieu thuc)."""
    il_param_types = [_extern_il_type_text(d) for d in param_dtypes]
    il_ret_type = 'void' if return_dtype is None else _extern_il_type_text(return_dtype)
    call_prefix = f'    call {il_ret_type} [{assembly}]{dotnet_class}::{method_name}'

    def _codegen(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
        nonlocal assembly, call_prefix, dotnet_class, il_param_types, method_name, param_dtypes
        if len(args) != len(param_dtypes):
            raise SyntaxError(
                f"il_codegen: '{method_name}' (extern [{assembly}]{dotnet_class}) can dung "
                f"{len(param_dtypes)} tham so, duoc goi voi {len(args)}")
        for arg_node, want_dtype in zip(args, param_dtypes):
            # Phase 9b fix-of-fix (bool, 2026-08-25): il_param_types (tren) da
            # tinh SAN tu want_dtype THO (giu 'bool' cho chu ky IL) - o day
            # dtype truyen vao compile_expr phai la dtype PHIA TOKENVECTOR
            # (i32 thay bool), khong dung want_dtype tho truc tiep.
            # Critical 2 (final review Phase 9d Part B): 'object'/'type' bi
            # tu choi TRUOC diem nay o dang ky (_validate_and_register_
            # extern_method) - nen tai day want_dtype KHONG BAO GIO la
            # 'object'/'type' (chi con lai de code tu-tai-lieu-hoa/phong thu
            # neu validate thay doi trong tuong lai, _compile_extern_object_arg
            # van AN TOAN goi duoc voi moi dtype khac).
            _compile_extern_object_arg(arg_node, scope, out, want_dtype, ctx)
        out.append(f'{call_prefix}({", ".join(il_param_types)})')
        # Khong can widen thu cong o day (khac compile_pow/...): builtin nay
        # dang ky voi return_dtype != None (xem _validate_and_register_
        # extern_method), nen dispatch chung _expr_call (il_codegen.py) TU
        # goi widen_if_needed(return_dtype, dtype, out) sau khi ham nay tra
        # ve - xem chu thich o register_expr_builtin('pow', ...) giai thich
        # vi sao widen 2 lan la BUG.
    return _codegen


# Task 4 (extern-class, 2026-08-18): instance method (callvirt) codegen.
#
# PHAT HIEN QUAN TRONG lech voi brief goc: brief gia dinh khoa dang ky
# trong EXPR_METHOD_CODEGEN la (ten_class, method_name) (vd ('Sb',
# 'ToString')) - giong het cach __tkv_extern_method__ dang ky builtin THEO
# TEN HAM. Doc THAT compile_method_call (compiler/il_features/
# record_feature.py dong 231-232):
#     _, _, obj_ta = scope[obj_name]
#     registered = EXPR_METHOD_CODEGEN.get((obj_ta.shape or obj_ta.dtype, method_name))
# obj_ta.shape cua MOI bien extern-class deu la CHUOI HANG 'extern_class'
# (Task 2, typed_dsl_parser.py dong 305) - KHONG PHAI ten class rieng cua
# no. Vi 'shape' uu tien truoc 'or dtype', khoa THAT SU la
# ('extern_class', method_name): DUY NHAT 1 khoa cho MOI extern-class cung
# khai 1 ten method (vd ca 'Sb' lan 1 handle-type khac deu co 'ToString'
# se CUNG tra cuu 1 khoa). Vi vay KHONG THE dong cung assembly/class/
# param_dtypes/return_dtype vao closure luc dang ky (khac han
# _make_extern_static_call_codegen o tren) - closure phai tu phan giai
# class THUC cua bien nhan (obj_ta.dtype, vd 'Sb') O MOI LAN GOI, qua
# il_extern_dtype._EXTERN_CLASS_DEFS (bien module-level, xem Task 2/3). 2 he
# qua thiet ke:
#   1) Dang ky idempotent theo method_name (khong theo (class, method)):
#      2 extern-class KHAC nhau cung khai 1 ten method la BINH THUONG (vd
#      C# thuc te nhieu class deu co ToString()) - lan dang ky thu 2 tro
#      di CHI BO QUA (closure dau tien da tu phan giai dung cho MOI bien),
#      khong raise ValueError nhu brief gia dinh (brief's dup-check dua
#      tren khoa SAI nen se raise oan cho truong hop hop le nay).
#   2) object nhan CHUA duoc load san len stack luc registered(...) duoc
#      goi (compile_method_call goi THANG voi node con nguyen TEN BIEN o
#      node[1], KHONG phai gia tri da o tren stack) - closure phai tu goi
#      ctx['load_var_ref'](obj_name, scope, out) truoc, khac ban nhap cua
#      brief (bien nhan dau tien duoc coi la "da san tren stack").
def _nap_extern_classes(extern_classes: "list[ExternLop]") -> "dict[str,i32]":
    """Nap cac decl pragma vao ARENA cua il_extern_dtype, tra BANG TRA CUU
    ten -> CHI SO hang.

    Ban cu giu thang `{d.name: d}` - gia tri la dict LONG ('methods' la
    danh sach cac dict) nen bang khong khai kieu duoc, va no la lenh cap
    module cuoi cung chan phep gop o `il_extern_dtype`. Arena bo tang long
    bang cach chi giu CHI SO, dung cach da dung cho cau lenh va bieu thuc.

    Cac decl van la dict Python o day: chung la san pham TAM cua bo phan
    tich pragma, nam trong THAN HAM chu khong o cap module, nen khong chan
    gi ca."""
    bang = {}
    for d in extern_classes:
        bang[d.name] = _nap_mot_extern_class(d)
    return bang


def _nap_mot_extern_class(d: "ExternLop") -> "i32":
    """Mot decl pragma -> mot hang trong arena, tra CHI SO.

    CO HAI noi xay bang (`compile_tkv_cli` va duong `_transpile_extracted`)
    - dung chung ham nay de khong lech: ban dau toi chi doi mot noi, va noi
    con lai van nhet dict vao mot bang da khai `dict[str,i32]`."""
    # `m`/`p` o day la DICT phia phan tich pragma, KHONG phai chi so arena
    # - dung `d['...']` chu khong dung accessor.
    pts = [il_extern_dtype.them_pt(m.name, m.params, m.returns)
           for m in d.methods]
    tts = [il_extern_dtype.them_tt(p.name, p.dtype, p.readonly)
           for p in d.properties]
    pt_tinh = [il_extern_dtype.them_pt(m.name, m.params, m.returns)
               for m in d.static_methods]
    return il_extern_dtype.them_lop(
        d.name, d.assembly, d.lop_clr, d.ctor, pts, tts, pt_tinh)


def _extern_class_method_lookup(class_name: "str", method_name: "str") -> "(i32,i32)":
    """Tra (decl, method_def) cho 1 (ten-class-handle-type-THUC, ten-method)
    - tra cuu DONG qua il_extern_dtype._EXTERN_CLASS_DEFS (dang active trong
    pham vi 1 lan compile_tkv_cli, xem ghi chu tren)."""
    if class_name not in il_extern_dtype._EXTERN_CLASS_DEFS:
        raise SyntaxError(
            f"il_codegen: extern-class '{class_name}' khong ton tai trong pham vi bien dich nay")
    decl = il_extern_dtype._EXTERN_CLASS_DEFS[class_name]
    for m in il_extern_dtype.ex_pts(decl):
        if il_extern_dtype.ex_pt_ten(m) == method_name:
            return decl, m
    # Task 2 (extern-class-property, 2026-08-18): 'get_X' KHONG nam that
    # trong decl['methods'] (chi 'properties') - tong hop 1 method-dict GIA
    # tai cho ('name': 'get_X', 'params': [], 'returns': prop['dtype']) de
    # tai dung TOAN BO pipeline _make_extern_class_method_codegen/
    # _make_extern_class_method_return_ta san co (Option (a) - sua CHINH ham
    # tra cuu nay, khong dong method-dict gia vao decl['methods'] that vi se
    # anh huong validate dup-check o duoi qua _seen_method_names).
    if method_name.startswith('get_'):
        prop_name = method_name[len('get_'):]
        _nguon_lap3 = il_extern_dtype.ex_tts(decl)
        if not _nguon_lap3:
            _nguon_lap3 = []
        for p in _nguon_lap3:
            if il_extern_dtype.ex_tt_ten(p) == prop_name:
                return decl, il_extern_dtype.them_pt(method_name, [], il_extern_dtype.ex_tt_dtype(p))
    # Task 3 (extern-class-property, 2026-08-18): tuong tu 'get_X' o tren -
    # 'set_X' cung KHONG nam that trong decl['methods'], tong hop 1
    # method-dict gia voi 1 tham so (kieu cua property) va 'returns':
    # 'void'. LUU Y: khong dung method-dict nay qua
    # _make_extern_class_method_codegen (no goi _il_ctor_param_type(m['returns'], ...)
    # se KeyError vi IL_SCALAR khong co khoa 'void', roi goi widen_if_needed
    # vo dieu kien nhu the co gia tri tren stack - SAI cho 1 lenh void) - phai
    # dung _make_extern_class_property_setter_codegen rieng (xem duoi).
    if method_name.startswith('set_'):
        prop_name = method_name[len('set_'):]
        _nguon_lap4 = il_extern_dtype.ex_tts(decl)
        if not _nguon_lap4:
            _nguon_lap4 = []
        for p in _nguon_lap4:
            if il_extern_dtype.ex_tt_ten(p) == prop_name:
                return decl, il_extern_dtype.them_pt(method_name, [il_extern_dtype.ex_tt_dtype(p)], 'void')
    raise SyntaxError(
        f"il_codegen: extern-class '{class_name}' khong co method '{method_name}'")


def _make_extern_class_method_return_ta(method_name: "str") -> "func(TypeAnn)->TypeAnn":
    """Factory tra 1 ham 1-tham-so fn(obj_ta) -> TypeAnn dung dung chu ky
    return_ta_fn cua register_expr_method (xac nhan qua _infer_dtype/
    _get_container_ta trong il_codegen.py: goi 'resolver(obj_ta)' 1 tham
    so DUY NHAT) - TypeAnn tra ve PHU THUOC ca obj_ta.dtype (ten class
    THUC cua bien nhan) lan method_name (dong bo boc ngoai), khong phai 1
    hang so tinh (2 extern-class khac nhau cung ten method co the tra kieu
    KHAC nhau)."""
    def _return_ta(obj_ta: "TypeAnn") -> "TypeAnn":
        nonlocal method_name
        _decl, m = _extern_class_method_lookup(obj_ta.dtype, method_name)
        ret = il_extern_dtype.ex_pt_returns(m)
        if ret in il_extern_dtype._EXTERN_CLASS_DEFS:
            return TypeAnn(ret, 'extern_class')
        # Phase 9g (2026-08-27): quy doi 'array[T]' -> 'list[T]' TRUOC khi
        # check startswith, de dtype nay CUNG di qua nhanh _parse_type_ann_str
        # ben duoi (TypeAnn shape='list' dung) thay vi roi xuong nhanh cuoi
        # (TypeAnn(dtype='list[str]', shape=None) SAI - gay KeyError khi
        # dung bien do sau nay, giong bug da ghi nhan o Task 2 extern-class-list).
        # Identity voi 'list[T]'/'dict[K,V]' that (khong doi hanh vi cu).
        ret = _tokenvector_facing_dtype(ret)
        if ret.startswith('list[') or ret.startswith('dict['):
            # Task 2 (extern-class-list, 2026-08-18) + Task 2 (extern-
            # class-dict, 2026-08-19): method/property-getter tra ve
            # 'list[T]'/'dict[K,V]' PHAI duoc khai bao voi shape='list'/
            # 'dict' dung (qua _parse_type_ann_str, da qua validate o
            # Task 1's _validate_extern_class_container_dtype) - truoc day
            # roi ve nhanh 'return TypeAnn(ret, None)' o duoi, tao ra
            # TypeAnn co dtype=CA CHUOI ('dict[str,i32]') va shape=None ->
            # il_type_str/_local_il_type sau do tra cuu
            # IL_SCALAR['dict[str,i32]'] va nem KeyError khi khai bao
            # local nhan ket qua method/property nay.
            return _parse_type_ann_str(ret, extern_class_names=il_extern_dtype.ten_lop_extern())
        # Phase 9b (bool): 'ret' o day la dtype PHIA IL-signature (co the la
        # 'bool'), nhung TypeAnn tra ve day la dtype PHIA TOKENVECTOR (dung
        # cho type inference cua bien nhan ket qua) - TokenVector KHONG co
        # kieu bool rieng, phai quy doi 'bool' -> 'i32' O DAY, KHONG dung
        # 'ret' tho. Cac dtype con lai (i32/i64/f32/f64/str) giu nguyen.
        return TypeAnn(_tokenvector_facing_dtype(ret), None)
    return _return_ta


def _make_extern_class_method_codegen(method_name: "str") -> "func(TkvNode,Scope,list[str],str,Ctx)":
    """Factory tra codegen_fn dung CHUNG cho MOI extern-class khai method
    trung ten 'method_name' (xem ghi chu khoi tren ve ly do khong the dong
    cung assembly/class/param_dtypes nhu _make_extern_static_call_codegen).
    Chu ky closure: fn(node, scope, out, dtype, ctx) - dung CHU KY THAT cua
    EXPR_METHOD_CODEGEN (xac nhan qua compile_method_call, KHONG phai ban
    nhap fn(obj_name, args, scope, out, dtype, ctx) cua brief)."""
    def _codegen(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
        nonlocal method_name
        obj_name, _mname, args = ea_str(node), eb_str(node), ec_ds(node)
        obj_ta = scope.tra(obj_name).ta
        decl, m = _extern_class_method_lookup(obj_ta.dtype, method_name)
        param_dtypes = il_extern_dtype.ex_pt_params(m)
        if len(args) != len(param_dtypes):
            raise SyntaxError(
                f"il_codegen: method {method_name!r} tren {il_extern_dtype.ex_lop(decl)!r} ky vong "
                f"{len(param_dtypes)} tham so, nhan duoc {len(args)}")
        ctx.load_var_ref(obj_name, scope, out)
        il_params = []
        for arg_node, want_dtype in zip(args, param_dtypes):
            il_params.append(_il_ctor_param_type(want_dtype, il_extern_dtype._EXTERN_CLASS_DEFS))
            # Phase 9b fix-of-fix (bool, 2026-08-25): il_params (chu ky IL)
            # giu want_dtype THO ('bool'); dtype truyen vao compile_expr phai
            # la dtype PHIA TOKENVECTOR - xem _tokenvector_facing_dtype.
            # Critical 1 + Important 1 (final review Phase 9d Part B): box
            # gia tri value-type khi want_dtype=='object' + tu choi dtype
            # thuc te khac 'type' khi want_dtype=='type'.
            _compile_extern_object_arg(arg_node, scope, out, want_dtype, ctx)
        il_ret_type = _il_ctor_param_type(il_extern_dtype.ex_pt_returns(m), il_extern_dtype._EXTERN_CLASS_DEFS)
        call_target = f"[{il_extern_dtype.ex_assembly(decl)}]{il_extern_dtype.ex_lop(decl)}"
        out.append(
            f"    callvirt instance {il_ret_type} {call_target}::{method_name}"
            f"({', '.join(il_params)})")
        _marshal_extern_return_array(il_extern_dtype.ex_pt_returns(m), out, ctx)
        # widen_if_needed la no-op an toan khi actual_dtype la 1 ten class
        # handle-type (khong khop int/float set nao ca, xem _widen_if_needed
        # trong il_codegen.py dong 1044) - goi VO DIEU KIEN, khong can if
        # rieng cho truong hop tra ve scalar vs handle-type. 'actual' dtype
        # truyen vao PHAI la dtype PHIA TOKENVECTOR (Critical 1b, final
        # review Phase 9b) - m['returns'] tho co the la 'bool', nhung gia
        # tri THAT SU tren stack luc nay da la i32 (0/1, tu callvirt tra ve
        # kieu IL 'bool' - bit-for-bit tuong thich i32 tren stack, xem chu
        # thich _EXTERN_DTYPE_TO_IL o tren) nen widen phai so sanh tu i32,
        # khong phai tu chuoi 'bool' (widen_if_needed khong nhan dien 'bool'
        # la 1 dtype so - se bo qua sai 1 truong hop can widen i32->f32/f64).
        ctx.widen_if_needed(_tokenvector_facing_dtype(il_extern_dtype.ex_pt_returns(m)), dtype, out)
    return _codegen


def _make_extern_class_property_setter_codegen(method_name: "str") -> "func(TkvNode,Scope,list[str],str,Ctx)":
    """Task 3 (extern-class-property, 2026-08-18): factory RIENG cho
    'set_X' - KHONG the tai dung _make_extern_class_method_codegen o tren
    vi 2 ly do: (1) m['returns']=='void' se lam
    il_codegen._il_ctor_param_type('void', ...) nem KeyError (IL_SCALAR
    khong co khoa 'void' - xem il_core.py), (2) callvirt tra ve void
    KHONG day gia tri nao len stack, nen goi widen_if_needed(...) VO DIEU
    KIEN nhu _make_extern_class_method_codegen lam se sai (widen tuong
    tren dinh stack 1 gia tri KHONG TON TAI). Chu ky closure GIONG HET
    _make_extern_class_method_codegen: fn(node, scope, out, dtype, ctx),
    node = ('method_call', obj_name, method_name, args) (fake_node dung
    boi codegen_attr_assign trong record_feature.py)."""
    def _codegen(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
        nonlocal method_name
        obj_name, _mname, args = ea_str(node), eb_str(node), ec_ds(node)
        obj_ta = scope.tra(obj_name).ta
        decl, m = _extern_class_method_lookup(obj_ta.dtype, method_name)
        param_dtypes = il_extern_dtype.ex_pt_params(m)
        if len(args) != len(param_dtypes):
            raise SyntaxError(
                f"il_codegen: setter {method_name!r} tren {il_extern_dtype.ex_lop(decl)!r} ky vong "
                f"{len(param_dtypes)} tham so, nhan duoc {len(args)}")
        ctx.load_var_ref(obj_name, scope, out)
        il_params = []
        for arg_node, want_dtype in zip(args, param_dtypes):
            il_params.append(_il_ctor_param_type(want_dtype, il_extern_dtype._EXTERN_CLASS_DEFS))
            # Phase 9b fix-of-fix (bool, 2026-08-25): xem chu thich tuong tu
            # o _make_extern_class_method_codegen - il_params giu want_dtype
            # THO, compile_expr nhan dtype PHIA TOKENVECTOR.
            # Critical 1 + Important 1 (final review Phase 9d Part B): box
            # gia tri value-type khi want_dtype=='object' + tu choi dtype
            # thuc te khac 'type' khi want_dtype=='type'.
            _compile_extern_object_arg(arg_node, scope, out, want_dtype, ctx)
        call_target = f"[{il_extern_dtype.ex_assembly(decl)}]{il_extern_dtype.ex_lop(decl)}"
        out.append(
            f"    callvirt instance void {call_target}::{method_name}"
            f"({', '.join(il_params)})")
        # KHONG goi widen_if_needed: setter la void, khong co gia tri
        # tren stack de widen.
    return _codegen


def _make_extern_class_method_void_codegen(method_name: "str") -> "func(TkvNode,Scope,list[str],str,Ctx)":
    """Phase 9a (2026-08-24): factory RIENG cho method instance
    'returns':'void' - mirror HET _make_extern_class_property_setter_codegen
    (2 ly do giong het: (1) _il_ctor_param_type('void',...) se KeyError,
    (2) callvirt void khong day gia tri len stack nen KHONG duoc goi
    widen_if_needed). Khac setter O CHO: khong gioi han 1 tham so - dung
    param_dtypes THAT cua method (co the 0..N tham so), va TEN method
    trong IL la method_name that (khong phai 'set_X')."""
    def _codegen(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
        nonlocal method_name
        obj_name, _mname, args = ea_str(node), eb_str(node), ec_ds(node)
        obj_ta = scope.tra(obj_name).ta
        decl, m = _extern_class_method_lookup(obj_ta.dtype, method_name)
        param_dtypes = il_extern_dtype.ex_pt_params(m)
        if len(args) != len(param_dtypes):
            raise SyntaxError(
                f"il_codegen: method {method_name!r} tren {il_extern_dtype.ex_lop(decl)!r} ky vong "
                f"{len(param_dtypes)} tham so, nhan duoc {len(args)}")
        ctx.load_var_ref(obj_name, scope, out)
        il_params = []
        for arg_node, want_dtype in zip(args, param_dtypes):
            il_params.append(_il_ctor_param_type(want_dtype, il_extern_dtype._EXTERN_CLASS_DEFS))
            # Phase 9b fix-of-fix (bool, 2026-08-25): xem chu thich tuong tu
            # o _make_extern_class_method_codegen - il_params giu want_dtype
            # THO, compile_expr nhan dtype PHIA TOKENVECTOR.
            # Critical 1 + Important 1 (final review Phase 9d Part B): box
            # gia tri value-type khi want_dtype=='object' + tu choi dtype
            # thuc te khac 'type' khi want_dtype=='type'.
            _compile_extern_object_arg(arg_node, scope, out, want_dtype, ctx)
        call_target = f"[{il_extern_dtype.ex_assembly(decl)}]{il_extern_dtype.ex_lop(decl)}"
        out.append(
            f"    callvirt instance void {call_target}::{method_name}"
            f"({', '.join(il_params)})")
        # Khong widen: method void khong co gia tri tren stack.
    return _codegen


# Task 3 (2026-08-17, __tkv_extern_pinvoke__): whitelist calling convention
# ho tro cho pinvokeimpl - chi 2 gia tri pho bien nhat tren Windows (spec
# KHONG yeu cau ho tro 'thiscall'/'fastcall').
_EXTERN_CONVENTIONS: "set[str]" = {'cdecl', 'stdcall'}


def _ten_lop_ctx_pinvoke(ctx: "Ctx") -> "str":
    return (ctx.class_name if ctx is not None else None) or 'Program'


def _make_extern_pinvoke_call_codegen(hidden_name: "str", param_dtypes: "list[str]", return_dtype: "str") -> "func(list[TkvNode],Scope,list[str],str,Ctx)":
    """Task 3 (2026-08-17, __tkv_extern_pinvoke__): factory TUONG TU
    _make_extern_static_call_codegen o tren, nhung goi 1 hidden method
    pinvokeimpl BEN TRONG CHINH class chuong trinh hien tai (khong phai
    [assembly]class ben ngoai) - dung _ten_lop_ctx_pinvoke(ctx) giong cach
    stdlib_cjson.py lam (doc ctx['class_name'], fallback 'Program').
    return_dtype co the la None (ham 'void' - Phase 2 CHO PHEP, khac
    Phase 1)."""
    il_param_types = [_EXTERN_DTYPE_TO_IL[d] for d in param_dtypes]
    il_ret_type = 'void' if return_dtype is None else _EXTERN_DTYPE_TO_IL[return_dtype]

    def _codegen(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
        nonlocal hidden_name, param_dtypes
        if len(args) != len(param_dtypes):
            raise SyntaxError(
                f"il_codegen: '{hidden_name}' (extern pinvoke) can dung "
                f"{len(param_dtypes)} tham so, duoc goi voi {len(args)}")
        compile_expr = ctx.compile_expr
        for arg_node, want_dtype in zip(args, param_dtypes):
            # Phase 9b fix-of-fix (bool, 2026-08-25): il_param_types (tren) da
            # tinh SAN tu want_dtype THO (giu 'bool' cho chu ky IL) - o day
            # dtype truyen vao compile_expr phai la dtype PHIA TOKENVECTOR.
            compile_expr(arg_node, scope, out, _tokenvector_facing_dtype(want_dtype), ctx)
        out.append(f'    call {il_ret_type} {_ten_lop_ctx_pinvoke(ctx)}::{hidden_name}'
                    f'({", ".join(il_param_types)})')
        # Khong widen thu cong o day - giong _make_extern_static_call_codegen,
        # dispatch chung (_expr_call/codegen_call_stmt) tu lo widen qua
        # return_dtype dang ky voi register_expr_builtin.
    return _codegen


# Regex ten file DLL hop le (vd 'msvcrt.dll', 'my-lib_v2.dll') - chu/so/
# gach duoi/gach ngang/dau cham/khoang trang, PHAI ket thuc '.dll', KHONG
# duoc chua '..'/'/'/'\\' (chan path traversal/injection vao chuoi IL).
_EXTERN_DLL_NAME_RE = re.compile(r'^[\w\-. ]+\.dll$')
# Regex ten symbol C hop le (identifier C chuan).
_EXTERN_SYMBOL_NAME_RE = re.compile(r'^[A-Za-z_]\w*$')


def _validate_and_register_extern_pinvoke(reg: "Registry", decl: "ExternPinvoke", pinvoke_decl_lines_out: "list[str]"):
    """Task 3 (2026-08-17, __tkv_extern_pinvoke__): validate 1 decl da
    parse SHAPE boi _parse_extern_pinvoke_dict_literal, 6 buoc THEO DUNG
    THU TU trong spec, moi buoc fail rieng 1 TranspileError. Sau khi qua
    het: sinh hidden method '__pinvoke_{name}', APPEND 1 dong
    'pinvokeimpl' vao pinvoke_decl_lines_out, dang ky builtin qua
    register_expr_builtin (returns='void' -> return_dtype=None, KHAC
    Phase 1 la truong hop DAU TIEN cho phep void)."""
    name = decl.name
    dll = decl.dll
    symbol = decl.symbol
    convention = decl.convention
    params = decl.params
    returns = decl.returns

    # (1) dll phai khop regex ten file .dll hop le.
    if not _EXTERN_DLL_NAME_RE.match(dll):
        raise TranspileError(
            f"__tkv_extern_pinvoke__ '{name}': 'dll' = {dll!r} khong phai ten file .dll hop le "
            f"(vd 'msvcrt.dll' - chu/so/gach duoi/gach ngang/dau cham/khoang trang, phai ket "
            f"thuc '.dll', khong duoc chua duong dan)")
    # (2) symbol phai khop regex identifier C hop le.
    if not _EXTERN_SYMBOL_NAME_RE.match(symbol):
        raise TranspileError(
            f"__tkv_extern_pinvoke__ '{name}': 'symbol' = {symbol!r} khong phai identifier C "
            f"hop le (vd 'sqrt')")
    # (3) convention phai nam trong whitelist.
    if convention not in _EXTERN_CONVENTIONS:
        raise TranspileError(
            f"__tkv_extern_pinvoke__ '{name}': 'convention' = {convention!r} khong hop le - "
            f"chi ho tro {sorted(_EXTERN_CONVENTIONS)}")
    # (4) moi params phai nam trong bang dtype ho tro.
    for i, p in enumerate(params):
        if p not in _EXTERN_DTYPE_TO_IL:
            raise TranspileError(
                f"__tkv_extern_pinvoke__ '{name}': params[{i}] = {p!r} khong phai dtype hop le - "
                f"chi ho tro {sorted(_EXTERN_DTYPE_TO_IL)}")
        # Critical 2 (final review Phase 9d Part B, 2026-08-27): 'object'/
        # 'type' duoc Task 2 them vao _EXTERN_DTYPE_TO_IL de _il_ctor_
        # param_type/il_type_str (chi dung boi __tkv_extern_class__) short-
        # circuit dung - nhung viec them do lam __tkv_extern_pinvoke__ (kiem
        # tra membership TRUC TIEP tren _EXTERN_DTYPE_TO_IL, khong qua
        # _is_valid_extern_dtype) AM THAM chap nhan 2 dtype nay, du plan
        # Phase 9d Part B noi RO KHONG dung/mo rong __tkv_extern_pinvoke__.
        # marshaling P/Invoke cho object/System.Type CHUA duoc thiet ke/rao
        # xet (ngoai pham vi fix nay) - tu choi RO RANG thay vi de lot am
        # tham roi that bai kho hieu o ilasm/luc chay.
        if p in ('object', 'type'):
            raise TranspileError(
                f"__tkv_extern_pinvoke__ '{name}': params[{i}] = {p!r} chua duoc ho tro - "
                f"dtype 'object'/'type' CHI ho tro tren __tkv_extern_class__ (method/ctor), "
                f"chua co thiet ke marshaling P/Invoke cho dtype nay (Phase 9d Part B)")
    # (5) returns phai la 'void' HOAC nam trong bang dtype scalar (KHAC
    # Phase 1 - Phase 2 CHO PHEP void).
    if returns != 'void' and returns not in _EXTERN_DTYPE_TO_IL:
        raise TranspileError(
            f"__tkv_extern_pinvoke__ '{name}': returns = {returns!r} khong phai dtype hop le - "
            f"chi ho tro 'void' hoac {sorted(_EXTERN_DTYPE_TO_IL)}")
    if returns in ('object', 'type'):
        raise TranspileError(
            f"__tkv_extern_pinvoke__ '{name}': returns = {returns!r} chua duoc ho tro - "
            f"dtype 'object'/'type' CHI ho tro tren __tkv_extern_class__ (method/ctor), "
            f"chua co thiet ke marshaling P/Invoke cho dtype nay (Phase 9d Part B)")
    # (6) name phai la identifier Python hop le.
    if not _la_dinh_danh(name):
        raise TranspileError(
            f"__tkv_extern_pinvoke__: 'name' = {name!r} khong phai identifier hop le")

    hidden_name = f'__pinvoke_{name}'
    return_dtype = None if returns == 'void' else returns
    il_ret_type = 'void' if return_dtype is None else _EXTERN_DTYPE_TO_IL[return_dtype]
    il_param_types = [_EXTERN_DTYPE_TO_IL[p] for p in params]
    il_param_list = ', '.join(il_param_types)
    pinvoke_decl_lines_out.append(
        f'.method public hidebysig static pinvokeimpl("{dll}" as "{symbol}" {convention})\n'
        f'    {il_ret_type} {hidden_name}({il_param_list}) cil managed preservesig {{}}')

    codegen_fn = _make_extern_pinvoke_call_codegen(hidden_name, params, return_dtype)
    # Phase 9b fix-of-fix (bool, 2026-08-25): giong _validate_and_register_
    # extern_method - 'return_dtype' tho (co the la 'bool') PHAI giu nguyen
    # cho codegen_fn (IL call signature can dung 'bool' de .NET resolve
    # dung method). Nhung gia tri dang ky voi register_expr_builtin phai la
    # dtype PHIA TOKENVECTOR (i32 thay bool) - dung _tokenvector_facing_dtype
    # de quy doi, an toan voi return_dtype=None (void) vi ham do tra ve None
    # khong doi khi dtype != 'bool'.
    register_expr_builtin(reg, name, codegen_fn, _tokenvector_facing_dtype(return_dtype))
    if return_dtype is None:
        # Fix Critical (2026-08-17): danh dau RIENG "ham nay THAT SU void" -
        # xem EXTERN_VOID_BUILTIN_NAMES o tren, dung boi codegen_call_stmt
        # (file_io.py) thay cho heuristic sai "return_dtype is None => void".
        EXTERN_VOID_BUILTIN_NAMES.add(name)


def _validate_and_register_extern_method(reg: "Registry", decl: "ExternHam", declared_assembly_names: "set[str]"):
    """Task 3 (2026-08-14): validate 1 decl da parse SHAPE boi
    _parse_extern_method_dict_literal, roi dang ky dong qua
    register_expr_builtin (il_dispatch.py) - 7 buoc THEO DUNG THU TU trong
    spec, moi buoc fail rieng 1 TranspileError liet ke ro gia tri sai +
    gia tri hop le mong doi."""
    name = decl.name
    assembly = decl.assembly
    dotnet_class = decl.lop_clr
    method_name = decl.method
    params = decl.params
    returns = decl.returns

    # (1) assembly phai khop regex ten assembly .NET hop le (fix M2), ROI
    # phai da duoc khai bao (extern_assemblies hoac 3 assembly mac dinh luon
    # co san mscorlib/System/System.Core).
    if not _EXTERN_ASSEMBLY_NAME_RE.match(assembly):
        raise TranspileError(
            f"__tkv_extern_method__ '{name}': 'assembly' = {assembly!r} khong phai ten assembly "
            f".NET hop le (vd 'System.Xml' - chu/so/gach duoi/dau cham, bat dau bang chu hoac gach duoi)")
    if assembly not in declared_assembly_names:
        raise TranspileError(
            f"__tkv_extern_method__ '{name}': assembly '{assembly}' chua duoc khai bao qua "
            f"__tkv_extern_assembly__ - cac assembly da biet: {sorted(declared_assembly_names)}")
    # (2) class phai khop regex ten class .NET hop le.
    if not _EXTERN_CLASS_NAME_RE.match(dotnet_class):
        raise TranspileError(
            f"__tkv_extern_method__ '{name}': 'class' = {dotnet_class!r} khong phai ten class "
            f".NET hop le (vd 'System.Math' - chu/so/gach duoi/dau cham, bat dau bang chu hoac gach duoi)")
    # (3) method phai khop regex identifier don gian (khong dau cham).
    if not _EXTERN_METHOD_NAME_RE.match(method_name):
        raise TranspileError(
            f"__tkv_extern_method__ '{name}': 'method' = {method_name!r} khong phai identifier "
            f".NET don gian hop le (vd 'Pow' - khong duoc chua dau cham)")
    # (4) moi params phai nam trong bang dtype ho tro.
    for i, p in enumerate(params):
        if not _is_valid_extern_dtype(p) and p not in il_extern_dtype._EXTERN_CLASS_DEFS:
            raise TranspileError(
                f"__tkv_extern_method__ '{name}': params[{i}] = {p!r} khong phai dtype hop le - "
                f"chi ho tro {sorted(_EXTERN_DTYPE_TO_IL)} hoac 1 handle type da khai trong "
                f"__tkv_extern_class__")
        # (Phase 9k, 2026-08-31): 'object'/'type' truoc day BI TU CHOI o day
        # vi _extern_il_type_text (dung boi _make_extern_static_call_codegen
        # ben duoi) chua co short-circuit dung cho 'type', va codegen argument
        # (_compile_extern_object_arg) chua ton tai. CA HAI da duoc bo sung
        # tu Phase 9d Part B/9e (xem _extern_il_type_text's nhanh 'type' va
        # il_codegen._compile_extern_object_arg - ca 2 da AN TOAN voi moi
        # dtype, tu ghi ro trong chinh docstring cua chung la "phong thu cho
        # tuong lai neu validate thay doi"). Phat hien qua tkv-bind chay THAT
        # tren NuGet Newtonsoft.Json: JsonConvert.SerializeObject(object)
        # bi bo qua vi gioi han nay - xac nhan ha tang codegen da san sang,
        # chi con validate chan nham. Go bo chan, cho phep 'object'/'type'
        # tren __tkv_extern_method__ giong het __tkv_extern_class__. Test
        # compile+run that xac nhan (xem test/verify/extern_method_object_test.py).
    # (5) returns phai nam trong bang dtype scalar HOAC 'void' (Phase 9a mo
    # rong: void OK, nhung CHI khi ham duoc goi dang LENH DOC LAP - xem
    # buoc (7) duoi ve cach dang ky EXTERN_VOID_BUILTIN_NAMES, va
    # file_io.py::codegen_call_stmt ve cach dispatch. Goi ham void TRONG
    # bieu thuc (vd 'x = ten_ham()') se tu bao loi o nhanh khac (khong co
    # gia tri de gan) - khong can chan rieng o day.
    if (returns != 'void' and not _is_valid_extern_dtype(returns)
            and returns not in il_extern_dtype._EXTERN_CLASS_DEFS):
        raise TranspileError(
            f"__tkv_extern_method__ '{name}': returns = {returns!r} khong phai dtype hop le - "
            f"chi ho tro 'void' hoac {sorted(_EXTERN_DTYPE_TO_IL)} hoac 1 handle type da khai "
            f"trong __tkv_extern_class__")
    # (Phase 9k, 2026-08-31): xem chu thich tuong tu o nhanh params[i] ben
    # tren - go bo chan 'object'/'type' cho returns, ha tang codegen da san
    # sang (return_dtype 'object' di qua duong _expr_call/widen_if_needed
    # CHUNG nhu moi extern-method khac, khong can nhanh rieng).
    # (6) name phai la identifier Python hop le (dung lam ten builtin goi
    # duoc trong code .tkv).
    if not _la_dinh_danh(name):
        raise TranspileError(
            f"__tkv_extern_method__: 'name' = {name!r} khong phai identifier hop le")
    # (7) qua het validate - tao codegen + dang ky. void (Phase 9a) dang ky
    # return_dtype=None + them vao EXTERN_VOID_BUILTIN_NAMES (giong het
    # _validate_and_register_extern_pinvoke lam voi pinvoke) de
    # file_io.py::codegen_call_stmt nhan ra day la builtin THAT SU void khi
    # goi dang lenh doc lap - guard chong trung ten co san trong
    # register_expr_builtin se tu bung ValueError neu 'name' da duoc dang
    # ky boi builtin khac.
    return_dtype = None if returns == 'void' else returns
    codegen_fn = _make_extern_static_call_codegen(assembly, dotnet_class, method_name, params, return_dtype)
    # Phase 9b (bool): 'return_dtype' o tren PHAI giu nguyen 'bool' (neu co)
    # cho codegen_fn - .NET runtime can thay dung 'bool' trong chu ky
    # call/callvirt de resolve method (xem Critical 2, Phase 9a). Nhung gia
    # tri dang ky voi register_expr_builtin la dtype PHIA TOKENVECTOR (dung
    # cho type inference cua bien nhan ket qua qua EXPR_BUILTIN_DTYPE) -
    # TokenVector KHONG co kieu bool rieng nen phai quy doi 'bool' -> 'i32'
    # RIENG o day, KHONG dung return_dtype tho.
    tkv_return_dtype = _tokenvector_facing_dtype(return_dtype)
    # Phase 9e (2026-08-27): return_dtype la 1 handle-type da khai qua
    # __tkv_extern_class__ -> dang ky return_shape='extern_class' de bien
    # nhan ket qua duoc gan TypeAnn(dtype=<handle class>, shape=
    # 'extern_class'), cho phep goi tiep instance method tren ket qua tra
    # ve (giong het cach bien tao qua ctor 'Sb()' duoc gan shape).
    _return_shape = 'extern_class' if return_dtype in il_extern_dtype._EXTERN_CLASS_DEFS else None
    register_expr_builtin(reg, name, codegen_fn, tkv_return_dtype, return_shape=_return_shape)
    if return_dtype is None:
        EXTERN_VOID_BUILTIN_NAMES.add(name)


DAU_CHI_CPYTHON = "# __tkv_cpython_only__"


def _la_dong_chi_cpython(source_lines: "list[str]", dong: "i32") -> "i32":
    """True neu dong nguon `dong` (1-based) mang pragma cuoi dong
    `# __tkv_cpython_only__`.

    Doi dung CHU THICH o cuoi dong, khong phai chuoi con - nen mot dong
    chi NHAC TEN pragma trong van ban (vd trong tai lieu) khong bi nhan
    nham. Xem them cong pragma_khong_ket_trong_chuoi_test."""
    if dong < 1 or dong > len(source_lines):
        return False
    return source_lines[dong - 1].rstrip().endswith(DAU_CHI_CPYTHON)

class ChuongTrinh:
    """Noi dung da phan tich cua MOT chuong trinh (2026-09-24) - thay bo
    14 phan tu tra ve tu _parse_program_ast / 13 phan tu tu
    extract_program_file (ban nay khong co import_names: da giai xong).
    Bo tuple chua container khong khai duoc kieu cho ban tu-host.

    GHI CHU KIEU: record_defs mang VAN BAN kieu truoc khi
    _resolve_record_field_types chay, TypeAnn sau do (doi tai cho);
    extern_methods/pinvokes/classes la dict KHONG dong nhat (co gia tri
    list) - khai theo annotation san co cua ham sinh, can record rieng."""

    record_defs: "dict[str,list[(str,TypeAnn)]]"
    record_defs_tho: "dict[str,list[(str,str)]]"
    record_methods_raw: "dict[str,list[(str,list[str],i32)]]"
    record_bases: "dict[str,list[str]]"
    record_interfaces: "dict[str,list[str]]"
    interface_defs: "dict[str,dict[str,str]]"
    pairs: "list[(str,list[str],i32)]"
    import_names: "list[(str,i32)]"
    extern_assemblies: "list[(str,str,str)]"
    extern_methods: "list[ExternHam]"
    extern_pinvokes: "list[ExternPinvoke]"
    extern_classes: "list[ExternLop]"
    module_consts: "dict[str,(str,str)]"
    module_globals: "dict[str,(str,list[list[str]])]"
    inferred_ast_nodes_by_func: "dict[str,(list[str],i32)]"
    record_init_sigs: "dict[str,str]"
    record_init_bodies: "dict[str,list[str]]"

    def __init__(self, record_defs: "dict[str,list[(str,TypeAnn)]]", record_defs_tho: "dict[str,list[(str,str)]]", record_methods_raw: "dict[str,list[(str,list[str],i32)]]", record_bases: "dict[str,list[str]]", record_interfaces: "dict[str,list[str]]",
                 interface_defs: "dict[str,dict[str,str]]", pairs: "list[(str,list[str],i32)]", import_names: "list[(str,i32)]", extern_assemblies: "list[(str,str,str)]", extern_methods: "list[ExternHam]",
                 extern_pinvokes: "list[ExternPinvoke]", extern_classes: "list[ExternLop]", module_consts: "dict[str,(str,str)]", module_globals: "dict[str,(str,list[list[str]])]",
                 inferred_ast_nodes_by_func: "dict[str,(list[str],i32)]", record_init_sigs: "dict[str,str]", record_init_bodies: "dict[str,list[str]]"):
        self.record_defs = record_defs
        self.record_defs_tho = record_defs_tho
        self.record_methods_raw = record_methods_raw
        self.record_bases = record_bases
        self.record_interfaces = record_interfaces
        self.interface_defs = interface_defs
        self.pairs = pairs
        self.import_names = import_names
        self.extern_assemblies = extern_assemblies
        self.extern_methods = extern_methods
        self.extern_pinvokes = extern_pinvokes
        self.extern_classes = extern_classes
        self.module_consts = module_consts
        self.module_globals = module_globals
        self.inferred_ast_nodes_by_func = inferred_ast_nodes_by_func
        self.record_init_sigs = record_init_sigs
        self.record_init_bodies = record_init_bodies


def _ten_extern_class(extern_classes: "list[ExternLop]") -> "set[str]":
    """Tap ten cac extern class da khai (2026-09-25) - thay set-comprehension
    lay khoa 'name' cua tung dict, ma ban tu-host chua suy duoc kieu."""
    ra = set()
    for d in extern_classes:
        ra.add(d.name)
    return ra


def _ten_truoc_ngoac(sig_line: "str") -> "str":
    """Ten dau dong ngay truoc '(' - tuong duong `re.match(r'^(\\w+)\\(', s)`
    (2026-09-25): tra '' khi khong khop. \\w = chu cai/chu so/'_'."""
    k = sig_line.find('(')
    if k <= 0:
        return ''
    for c in sig_line[:k]:
        if not (c.isalpha() or c == '_' or c in '0123456789'):
            return ''
    return sig_line[:k]


def _bang_method_tho4() -> "dict[str,list[(str,list[str],i32,i32)]]":
    """Bang RONG co kieu cho record_methods_raw4 (2026-09-25): trinh that
    chua nhan khai bao local dict co kieu, nen kieu di qua kieu tra ve."""
    return {}


def _thay_goi_static(src: "str", tim: "str", moi: "str") -> "str":
    """Thay 'Lop.ham(' bang 'Lop__ham(' (khi truoc no khong phai ky tu ten hay '.') (2026-10-01)."""
    ra = ''
    i = 0
    n = len(src)
    ltim = len(tim)
    while i < n:
        j = src.find(tim, i)
        if j < 0:
            break
        ok = True
        if j > 0:
            kt = src[j - 1]
            if kt.isalpha() or kt.isdigit() or kt == '_' or kt == '.':
                ok = False
        ra = ra + src[i:j]
        if ok:
            ra = ra + moi
        else:
            ra = ra + tim
        i = j + ltim
    ra = ra + src[i:]
    return ra


def _nang_static_method(src: "str") -> "str":
    """'Lop.ham(args)' voi ham la @staticmethod cua Lop (2026-10-01): sao chep thanh ham cap module 'Lop__ham'
    (cuoi nguon) va doi cac loi goi 'Lop.ham(' thanh 'Lop__ham('. Ban trong class van giu cho 'obj.ham(...)'."""
    if '@staticmethod' not in src:
        return src
    cac = src.split(chr(10))
    n = len(cac)
    lop = ''
    ten_lop = []
    ten_ham = []
    them = []
    i = 0
    while i < n:
        dong = cac[i]
        if dong.startswith('class '):
            tl = dong[6:]
            tl = tl.split('(')[0]
            tl = tl.split(':')[0]
            lop = tl.strip()
        elif dong != '' and not dong.startswith(' ') and not dong.startswith('#'):
            lop = ''
        if lop != '' and dong == '    @staticmethod' and i + 1 < n:
            hdr = cac[i + 1]
            if hdr.startswith('    def '):
                rest = hdr[8:]
                ten = rest.split('(')[0]
                them.append('')
                them.append('def ' + lop + '__' + rest)
                j = i + 2
                while j < n:
                    ln = cac[j]
                    if ln.strip() == '':
                        them.append('')
                    elif ln.startswith('        '):
                        them.append(ln[4:])
                    else:
                        break
                    j += 1
                ten_lop.append(lop)
                ten_ham.append(ten)
        i += 1
    if len(ten_lop) == 0:
        return src
    ra = src + chr(10) + chr(10).join(them) + chr(10)
    k = 0
    while k < len(ten_lop):
        ra = _thay_goi_static(ra, ten_lop[k] + '.' + ten_ham[k] + '(', ten_lop[k] + '__' + ten_ham[k] + '(')
        k += 1
    return ra


def _thay_ngoai_nhay(src: "str", tim: "str", moi: "str") -> "str":
    """Thay `tim` bang `moi` NGOAI chuoi ky tu (quet tung dong, nhay dong/don) - tranh viet lai chinh cac
    chuoi hang trong ma nguon cua trinh bien dich."""
    ra = []
    for dong in src.split(chr(10)):
        if tim not in dong:
            ra.append(dong)
            continue
        kq = ''
        nhay = ''
        i = 0
        n = len(dong)
        while i < n:
            c = dong[i]
            if nhay != '':
                kq = kq + c
                if c == chr(92) and i + 1 < n:
                    kq = kq + dong[i + 1]
                    i += 1
                elif c == nhay:
                    nhay = ''
                i += 1
                continue
            if c == '"' or c == "'":
                nhay = c
                kq = kq + c
                i += 1
                continue
            if dong.startswith(tim, i):
                kq = kq + moi
                i += len(tim)
                continue
            kq = kq + c
            i += 1
        ra.append(kq)
    return chr(10).join(ra)


def _nang_defaultdict(src: "str") -> "str":
    """'defaultdict(int)' / 'defaultdict(float)' / 'defaultdict(str)' / 'defaultdict(lambda: 0)' (2026-10-01):
    nha may mac dinh la ham nguoi dung 0 tham so - them ham '__dd_int' / '__dd_float' / '__dd_str' cuoi nguon."""
    if 'defaultdict(' not in src:
        return src
    ra = src
    them = []
    moi = _thay_ngoai_nhay(_thay_ngoai_nhay(ra, 'defaultdict(int)', 'defaultdict(__dd_int)'), 'defaultdict(lambda: 0)', 'defaultdict(__dd_int)')
    if moi != ra:
        ra = moi
        them.append('def __dd_int() -> "i32":')
        them.append('    return 0')
    moi = _thay_ngoai_nhay(_thay_ngoai_nhay(ra, 'defaultdict(float)', 'defaultdict(__dd_float)'), 'defaultdict(lambda: 0.0)', 'defaultdict(__dd_float)')
    if moi != ra:
        ra = moi
        them.append('def __dd_float() -> "f64":')
        them.append('    return 0.0')
    moi = _thay_ngoai_nhay(_thay_ngoai_nhay(ra, 'defaultdict(str)', 'defaultdict(__dd_str)'), 'defaultdict(lambda: "")', 'defaultdict(__dd_str)')
    if moi != ra:
        ra = moi
        them.append('def __dd_str() -> "str":')
        them.append('    return ""')
    if len(them) == 0:
        return ra
    return ra + chr(10) + chr(10) + chr(10).join(them) + chr(10)


def _kiem_container_chua_gan(record_defs_tho: "dict[str,list[(str,str)]]", record_methods_raw4: "dict[str,list[(str,list[str],i32,i32)]]", pairs: "list[(str,list[str],i32)]") -> "(str,str)":
    """(ten_class, ten_field) cua field container CHUA co `.field = ...` o bat
    ky than ham nao; (None, None) neu moi field deu duoc gan it nhat mot lan."""
    gop_all = []
    for rname in record_methods_raw4:
        for _sig_line, body_lines, _is_static, _is_property in record_methods_raw4[rname]:
            gop_all.append(chr(10).join(body_lines))
    for _sig, body_lines, _start in pairs:
        gop_all.append(chr(10).join(body_lines))
    gop = chr(10).join(gop_all)
    for rname in record_defs_tho:
        for ten_f, dtype in record_defs_tho[rname]:
            la_container = dtype.startswith('list[') or dtype.startswith('dict[') or dtype.startswith('set[')
            if not la_container:
                continue
            mau = '.' + ten_f + ' ='
            if gop.find(mau) >= 0:
                continue
            if gop.find('.' + ten_f + '=') >= 0:
                continue
            return rname, ten_f
    return None, None


def _parse_program_ast(source_text: "str", la_import: "i32"=False, hoan_giai_field: "i32"=False) -> "ChuongTrinh":
    """Parse THUAN 1 file nguon TokenVector (`.tkv`) THAT - KHONG doc file
    nao khac, KHONG resolve import - chi tra ve THANG PHAN NOI DUNG cua
    CHINH file nay: (record_defs, record_methods_raw, record_bases, pairs,
    import_names). record_bases (B1, 2026-07-29): dict ten-record ->
    ten-class-cha (hoac None neu khong ke thua) - xem _extract_record_def.
    import_names: list ten module (KHONG co duoi '.tkv') lay tu bien
    module-level '__tkv_import__' (xem extract_program_file - khoang
    trong ngon ngu #3, "import module TokenVector khac"). 'import X'/
    'from X import Y' THAT (cu phap Python chuan) van duoc BO QUA nhu
    truoc gio (chi de file chay duoc duoi CPython that, vd numpy/helper
    module rieng cua File I/O) - '__tkv_import__' la co che RIENG, MOI,
    danh cho cross-file GIUA CAC FILE .tkv (khac hoan toan y nghia)."""
    # P8 Task 6 (lo 5): KHONG con vat chat hoa cay node nua - ham nay doc
    # THANG arena. `parse_arena` dung lai chinh parser native, chi bo buoc
    # dung cay object o giua.
    source_text = _nang_static_method(source_text)
    source_text = _nang_defaultdict(source_text)
    _pool = []
    _toks = []
    _van = source_text if source_text.endswith(chr(10)) else source_text + chr(10)
    _tkv_tokenize_lex(_van, _toks)
    _goc = _tkv_parse_module(_pool, _toks)
    _than_mod = ar_kids(_pool, _goc)
    source_lines = source_text.split('\n')
    record_defs_tho = _bang_record_tho_rong()
    record_methods_raw4 = _bang_method_tho4()
    record_bases = {}
    record_init_sigs: "dict[str,str]" = {}
    record_init_bodies: "dict[str,list[str]]" = {}
    module_consts = {}
    module_globals = {}
    record_interfaces = {}
    interface_defs = {}
    pairs: "list[(str,list[str],i32)]" = []
    # Task 3/5 (duck-typing-inference, 2026-08-17): dict ten-ham-top-level ->
    # ast.FunctionDef/AsyncFunctionDef GOC (CHI gom ham co >=1 tham so thieu
    # annotation, tuc se thanh dtype 'inferred'). Luu AST GOC (chua goi
    # collect_inferred_constraints() ngay o day) vi tai DAY record_defs CHUA
    # day du (vong lap cac cau lenh cap module con dang chay, record khai
    # bao SAU chua thay) - dtype 'inferred' khong can record_names
    # de PARSE, nhung 1 tham so KHAC (co annotation) cua CUNG ham co the
    # tham chieu record khai bao sau -> parse_typed_signature() se that bai
    # neu goi som. Doi den luc sig_body_pairs duoc xay (compile_tkv_cli/
    # _transpile_extracted, sau khi TOAN BO file/import da duyet xong,
    # record_defs day du) moi parse Signature that va goi
    # collect_inferred_constraints(), gan ket qua vao sig.inferred_constraints
    # - gan CUNG kieu voi module_consts/module_globals (dict cap-module
    # threading xuyen extract_program/extract_program_file/compile_tkv_cli).
    inferred_ast_nodes_by_func: "dict[str,(list[str],i32)]" = {}
    import_names: "list[(str,i32)]" = []
    extern_assemblies: "list[(str,str,str)]" = []
    extern_methods = []
    extern_pinvokes = []
    extern_classes = []
    type_aliases = {}
    # Decorator tuy bien tren ham top-level (Phase 4, 2026-08-11, xem
    # _expand_custom_decorator): pre-pass tim MOI ham top-level duoc dung
    # lam '@deco' - ham do la 1 TEMPLATE thuan tuy (macro luc bien dich),
    # KHONG duoc tu no bien dich thanh 1 ham binh thuong (chu ky cua no
    # dung 'func(...)->...' - shape ma parse_signature CHUA ho tro cho
    # tham so/return ham THAT, se bao loi neu di qua duong thuong).
    top_level_funcs = {}
    for n in _than_mod:
        if ar_kind(_pool, n) == "funcdef":
            top_level_funcs[ar_col_a(_pool, n)] = n
    decorator_template_names = set()
    for n in _than_mod:
        if ar_kind(_pool, n) != "funcdef":
            continue
        deco = _ar_decorator(_pool, n)
        if len(deco) == 1 and deco[0] >= 0 and ar_kind(_pool, deco[0]) == "name" \
                and ar_col_a(_pool, deco[0]) in top_level_funcs:
            decorator_template_names.add(ar_col_a(_pool, deco[0]))
    for nid in _than_mod:
        kind = ar_kind(_pool, nid)
        ten_nid = ar_col_a(_pool, nid)
        _ten_gan = _ar_ten_gan(_pool, nid)
        _gia_tri = ar_kids(_pool, nid)[-1] if _ten_gan is not None else -1
        if kind == "funcdef" or kind == "asyncfuncdef":
            if _ar_chi_cpython(_pool, nid) or                     ten_nid == "__tkv_cpython_only__":
                # PRAGMA `@__tkv_cpython_only__` o cap HAM (doi xung voi cap
                # METHOD, xem _extract_record_def): gian giao DI TRU, CPython
                # chay, TokenVector coi nhu khong co. Chinh
                # CHINH ham pragma (`compiler/tkv_pragma.py`) duoc bo qua
                # THEO TEN: no khong the tu danh dau bang chinh no (decorator
                # phai ton tai TRUOC `def`), va neu bien dich no thi MOI file
                # import pragma se chet vi "thieu return-type annotation".
                # Cung kieu ngoai le theo ten nhu `__init__` cua record.
                continue
            if kind == "funcdef" and ten_nid in decorator_template_names:
                continue  # chi la template cho 1 '@deco' khac, khong tu no la 1 ham
            deco = _ar_decorator(_pool, nid)
            if deco:
                if kind == "funcdef" and len(deco) == 1 and deco[0] >= 0 \
                        and ar_kind(_pool, deco[0]) == "name" \
                        and ar_col_a(_pool, deco[0]) in top_level_funcs:
                    deco_nid = top_level_funcs[ar_col_a(_pool, deco[0])]
                    hai_cap = _expand_custom_decorator(
                        _pool, nid, deco_nid, source_lines)
                    pairs.append(hai_cap[0])
                    pairs.append(hai_cap[1])
                    continue
                raise TranspileError(
                    f"ham '{ten_nid}': decorator khong duoc ho tro. Hien CHI ho tro '@deco' "
                    f"khi 'deco' la 1 ham top-level KHAC duoc khai bao trong CUNG file, dang "
                    f"'def deco(f: \"func(...)->...\") -> \"func(...)->...\":' voi than gom DUNG "
                    f"1 'def wrapper(...):' long + 'return wrapper' (xem _expand_custom_decorator)")
            # 'asyncfuncdef' (Phase 4, 2026-08-11) - 'async def' o top-level,
            # xem _extract_signature_line ('async ' prefix). 'async def' lam
            # record method (Task 3, 2026-08-12): xem _extract_record_def va
            # _extract_record_method_sig_line ('async ' prefix).
            sig_line = _extract_signature_line(_pool, nid, allow_varargs=True, allow_inferred=True)
            _ts_top = _ar_tham_so(_pool, nid)
            if any([_ar_ann_cua(_pool, m) < 0 for m in _ts_top.nid]):
                # Task 3/5 (duck-typing-inference): giu lai CHO trong arena de
                # goi collect_inferred_constraints() sau, xem ghi chu
                # inferred_ast_nodes_by_func o tren.
                # (pool, nid) thay vi node: duck_typing doc THANG arena.
                # Pool di BEN TRONG dict san co nen 20 dong duong ong
                # xuyen extract_program/_build_sig_body_pairs khong doi.
                inferred_ast_nodes_by_func[ten_nid] = _cap_pool_nid(_pool, nid)
            hoisted: "list[(str,list[str],i32)]" = []
            body_lines = _body_source_lines(_pool, source_lines, nid, hoisted=hoisted)
            pairs.append((sig_line, body_lines, ar_line_lo(_pool, _ar_than(_pool, nid)[0])))
            # 'def' long khong bat bien nao da duoc nang len top-level -
            # them vao chuong trinh nhu ham binh thuong.
            pairs.extend(hoisted)
        elif kind == "classdef":
            if ten_nid in record_defs_tho or ten_nid in interface_defs:
                raise TranspileError(f"trung ten class '{ten_nid}'")
            _con_c = ar_kids(_pool, nid)
            _deco_c = _con_c[1 + _ar_so_base(_pool, nid):]
            is_interface = _co_deco_interface(_pool, _deco_c)
            if is_interface:
                # Phase C.4 (2026-07-29): '@interface' - mixin CIL interface
                # (huong F), KHONG phai 1 record (khong field/state).
                interface_defs[ten_nid] = _extract_interface_def(_pool, nid, source_lines)
                continue
            dl = _extract_record_def(
                _pool, nid, source_lines,
                known_records=record_defs_tho, known_interfaces=interface_defs)
            record_defs_tho[ten_nid] = dl.fields
            record_methods_raw4[ten_nid] = dl.methods_raw
            record_bases[ten_nid] = dl.base_info
            record_interfaces[ten_nid] = dl.interface_names
            if dl.init_sig != "":
                record_init_sigs[ten_nid] = dl.init_sig
                record_init_bodies[ten_nid] = dl.init_body
        elif _ten_gan == '__tkv_import__':
            # Co che IMPORT RIENG cua TokenVector (khoang trong ngon ngu #3):
            # 'import' THAT cua Python KHONG dung duoc de tham chieu 1 file
            # .tkv khac (Python's import machinery chi tim '.py', khong
            # biet '.tkv') - dung 1 phep GAN chuoi/list-chuoi HOP LE 100%
            # (chay duoc that duoi CPython, khong lam gi luc runtime, giong
            # tinh than annotation-la-string da dung xuyen suot du an) lam
            # PRAGMA rieng cho compiler doc.
            # NOI chu KHONG gan de (sua 2026-09-17): phep gan cu XOA SACH
            # moi `import X`/`from X import ...` da thu TRUOC do trong cung
            # file.  `bootstrap_all.py` dat `__tkv_import__` o dong 110, sau
            # ~80 dong `from il_features.X import ...` (dong 28-108) - nen ca
            # 80 canh do bi vut va file chi gop duoc 1 module thay vi 80.
            # Do la rao THAT cua viec lap `tkvc_v0`, khong phai so file con
            # truot frontend.
            if ar_kind(_pool, _gia_tri) == "const_str":
                import_names.append((ar_col_a(_pool, _gia_tri), 1))
            elif _ar_la_list(_pool, _gia_tri) and _moi_con_la_chuoi(_pool, _gia_tri):
                for e in ar_kids(_pool, _gia_tri):
                    import_names.append((ar_col_a(_pool, e), 1))
            else:
                raise TranspileError(
                    "__tkv_import__ phai la 1 chuoi hoac list chuoi (ten file .tkv KHONG co "
                    "duoi '.tkv', vd __tkv_import__ = 'shapes' hoac ['shapes', 'utils'])")
        elif _ten_gan == '__tkv_extern_assembly__':
            # Co che MO RONG (Wave 3, 2026-07-29, xem project-tokenvector-
            # wave2-status memory - "package ecosystem"): khai bao THEM 1
            # hoac nhieu '.assembly extern' vao IL sinh ra, de cac stdlib
            # function MOI (vd http_get dung [System]) hoac tuong lai
            # (DB/thu vien .NET khac) co the tham chieu assembly ngoai
            # mscorlib/System/System.Core da co san CUNG SAN, KHONG can sua
            # tay phan header IL trong compile_tkv_cli() moi lan them 1
            # thu vien moi. Moi phan tu: 1 chuoi ten (dung publickeytoken/
            # version CHUAN cua .NET Framework GAC, da XAC MINH THAT qua
            # ilasm.exe), HOAC 1 tuple 3 phan tu (ten, publickeytoken_hex_
            # or_None, version_or_None) cho assembly RIENG/thu vien ngoai
            # KHONG dung token chuan .NET Framework (vd 1 .dll private dat
            # canh file .exe, publickeytoken=None nghia la KHONG ky ten
            # manh - .assembly extern bare).
            elts = ar_kids(_pool, _gia_tri) if _ar_la_list(_pool, _gia_tri) else [_gia_tri]
            for e in elts:
                ke = ar_kind(_pool, e) if e >= 0 else ''
                if ke == "const_str":
                    extern_assemblies.append((ar_col_a(_pool, e), 'DEFAULT', 'DEFAULT'))
                elif ke == "tuple" and len(ar_kids(_pool, e)) == 3:
                    parts = []
                    for sub in ar_kids(_pool, e):
                        ks = ar_kind(_pool, sub) if sub >= 0 else ''
                        if ks == "const_none":
                            parts.append(None)
                        elif ks == "const_str":
                            parts.append(ar_col_a(_pool, sub))
                        else:
                            raise TranspileError(
                                "__tkv_extern_assembly__ tuple 3 phan tu phai la (ten:str, "
                                "publickeytoken:str_hoac_None, version:str_hoac_None)")
                    extern_assemblies.append((parts[0], parts[1], parts[2]))
                else:
                    raise TranspileError(
                        "__tkv_extern_assembly__ phai la 1 chuoi/list chuoi (ten assembly .NET "
                        "Framework GAC chuan, vd 'System.Xml') hoac tuple 3 phan tu (ten, "
                        "publickeytoken_hex_or_None, version_or_None) cho assembly rieng")
        elif _ten_gan == '__tkv_extern_method__':
            # Pragma khai bao goi 1 static method .NET NGOAI (Task 2,
            # 2026-08-14 - xem docs/superpowers/plans/2026-08-14-extern-
            # method.md): moi phan tu la 1 dict-literal shape co dinh, chi
            # PARSE SHAPE o day (validate nghiep vu + dang ky dong builtin
            # la Task 3, trong compile_tkv_cli, sau khi co ca
            # extern_assemblies de doi chieu 'assembly' da khai bao chua).
            if not _ar_la_list(_pool, _gia_tri):
                raise TranspileError("__tkv_extern_method__ phai la 1 list cac dict")
            for elt in ar_kids(_pool, _gia_tri):
                extern_methods.append(_parse_extern_method_dict_literal(_pool, elt))
        elif _ten_gan == '__tkv_extern_pinvoke__':
            # Pragma khai bao goi 1 ham trong DLL native qua P/Invoke
            # (Phase 2, 2026-08-17 - xem docs/superpowers/plans/2026-08-17-
            # extern-pinvoke.md): moi phan tu la 1 dict-literal shape co
            # dinh, chi PARSE SHAPE o day (validate nghiep vu + sinh
            # pinvokeimpl + dang ky dong builtin la Task 3, trong
            # compile_tkv_cli).
            if not _ar_la_list(_pool, _gia_tri):
                raise TranspileError("__tkv_extern_pinvoke__ phai la 1 list cac dict")
            for elt in ar_kids(_pool, _gia_tri):
                extern_pinvokes.append(_parse_extern_pinvoke_dict_literal(_pool, elt))
        elif _ten_gan == '__tkv_type_alias__':
            # BI DANH KIEU (2026-09-24): mot dict-literal `ten -> chuoi kieu
            # THAT`. KHONG sinh kieu moi, KHONG noi long phep kiem - dich
            # cua bi danh van phai la mot kieu hop le, va mot ten CHUA khai
            # bao dung lam bi danh van bi tu choi.
            #
            # VI SAO CAN: 2257 annotation trong cay trinh bien dich dung
            # `TkvNode`/`TkvSig`/`TkvTable`/`TkvFn`/`TkvTypeAnn`, nhung
            # nhung ten do KHONG khai o dau ca. Duoi CPython annotation chi
            # la chuoi nen khong ai kiem; duoi TokenVector chung la ten bia
            # va chan 95/117 file tren duong tu-host. Chung deu co kieu THAT
            # (vd `TkvNode` la chi so arena = i32) - bi danh giu lai gia tri
            # TAI LIEU cua cai ten ma van khai duoc kieu.
            if not _ar_la_dict(_pool, _gia_tri):
                raise TranspileError("__tkv_type_alias__ phai la 1 dict {ten: 'kieu'}")
            for _k_nid, _v_nid in _ar_cap_dict(_pool, _gia_tri):
                _k = _ar_chuoi(_pool, _k_nid)
                _v = _ar_chuoi(_pool, _v_nid)
                if _k is None or _v is None:
                    raise TranspileError(
                        "__tkv_type_alias__: ca khoa lan gia tri phai la chuoi literal")
                type_aliases[_k] = _v
        elif _ten_gan == '__tkv_extern_class__':
            # Pragma khai bao 1 handle-type .NET NGOAI (ctor + methods)
            # (Task 1, 2026-08-18 - xem docs/superpowers/plans/extern-class):
            # moi phan tu la 1 dict-literal shape co dinh, chi PARSE SHAPE o
            # day (validate nghiep vu + codegen la cac Task sau, giong het
            # cach lam voi __tkv_extern_method__/__tkv_extern_pinvoke__).
            if not _ar_la_list(_pool, _gia_tri):
                raise TranspileError("__tkv_extern_class__ phai la 1 list cac dict")
            for elt in ar_kids(_pool, _gia_tri):
                extern_classes.append(_parse_extern_class_dict_literal(_pool, elt))
        elif kind == "import":
            # 'import X' (Phase 6.2, 2026-08-11) - port TU cay .tkv tu-host
            # (da co san, DA chay that - xem _find_module_path/
            # extract_program_file): coi MOI 'import X'/'from X import ...'
            # nhu 1 module TokenVector can resolve/gop (giong __tkv_import__),
            # KHONG con phan biet "thu vien ngoai" - TokenVector khong co
            # khai niem goi qua 'X.ten()' (qualified access), cac thu vien
            # chuan (os/re/random/...) deu di qua builtin ham thang
            # (os_list_files/re_findall/...), KHONG qua 'import os'.
            # Ngoai le duy nhat: 'tkv_import_hook' (marker rieng, giong
            # '__tkv_import__') - dong nay chi CHAY THAT duoi CPython de
            # dang ky FileFinder path_hook cho '.tkv' (xem tkv_import_hook.py)
            # khi file can 'from X import ...' HOAT DONG dung luc chay
            # `python file.tkv` truc tiep - KHONG phai 1 module TokenVector.
            for ten_mod in _ar_ten_import(_pool, nid):
                if ten_mod == 'tkv_import_hook':
                    continue
                if ten_mod in _STDLIB_SHIM_MODULES:
                    continue
                import_names.append((ten_mod, 0))
            continue
        elif kind == "importfrom":
            _mod = _ar_module_importfrom(_pool, nid)
            if _mod and _mod not in _STDLIB_SHIM_MODULES:
                import_names.append((_mod, 0))
            continue
        elif _ar_la_docstring(_pool, nid):
            continue  # module docstring
        elif _ten_gan == 'interface':
            # '@interface' (Phase C.4, 2026-07-29) KHONG phai decorator co
            # san cua Python that - file .tkv PHAI TU dinh nghia 1 shim
            # (vd 'interface = lambda cls: cls') de van CHAY DUOC that duoi
            # CPython (giong tinh than '.tkv van la Python that' xuyen suot
            # du an) - compiler CHI can biet TEN 'interface' xuat hien o
            # decorator_list cua 1 class, KHONG quan tam GIA TRI THAT cua
            # no, nen bo qua HOAN TOAN dong gan nay (khong yeu cau dang
            # lambda cu the, chi can 1 TEN don gian giong '__tkv_import__').
            continue
        elif _ten_gan is not None and _la_goi_namedtuple(_pool, _gia_tri):
            # collections.namedtuple (Phase 3.2, 2026-08-11): desugar THANH
            # 1 record binh thuong NGAY O TANG PARSE - tai su dung 100%
            # pipeline record co san (gen_record_types/record_feature.py)
            # ben duoi, KHONG runtime wrapper (xem _extract_namedtuple_def).
            record_name, fields = _extract_namedtuple_def(_pool, nid)
            if record_name in record_defs_tho or record_name in interface_defs:
                raise TranspileError(f"trung ten class '{record_name}' (namedtuple)")
            record_defs_tho[record_name] = fields
            record_methods_raw4[record_name] = []
            record_bases[record_name] = []
            record_interfaces[record_name] = []
        elif _ten_gan is not None and ar_kind(_pool, _gia_tri) in ("const_num", "const_str"):
            # HANG SO cap module (2026-08-03): 'MAX = 10' / 'NAME = "x"'.
            # CHI nhan HANG so/chuoi - KHONG phai bien toan cuc that (khong
            # gan lai duoc, khong co o nho): moi noi dung se duoc thay bang
            # chinh hang so do luc bien dich. Bien toan cuc GHI DUOC la 1
            # thu khac han (can .field static + ngu nghia doc/ghi xuyen
            # ham) - chua lam, va cach viet quen thuoc nhat trong script
            # la hang so. 'const_bool' KHONG thuoc dien nay (ban cu loai
            # bool ra khoi (int, float, str) bang isinstance).
            # (dtype, van ban) - xem _hang_so_co_kieu (2026-09-24).
            if ar_kind(_pool, _gia_tri) == "const_str":
                module_consts[_ten_gan] = _cap_hang('str', ar_col_a(_pool, _gia_tri))
            else:
                module_consts[_ten_gan] = _hang_so_co_kieu(_pool, _gia_tri)
        elif _module_const_extra(_pool, nid) is not None:
            # Ba dang HANG SO cap module ma `const_num`/`const_str` khong phu
            # (P6, 2026-09-08) - deu la HANG THAT, tinh duoc ngay luc bien
            # dich:
            #   ABSENT = -1                      (unaryop: -<so>)
            #   CPLX = f'valuetype {COMPLEX_CLASS}'   (f-string toan hang da biet)
            module_consts[_ten_gan] = _module_const_extra(_pool, nid, module_consts)
        elif _ten_gan == '__tkv_chi_cpython__':
            # Bien CANH danh dau khoi chi-CPython (2026-09-25) - khong mang
            # gia tri gi cho chuong trinh; hat giong cung bo qua no.
            continue
        elif kind == "if" and _la_khoi_chi_cpython(_pool, nid):
            # `if __tkv_chi_cpython__:` - lenh CHI chay duoi CPython (sys.path,
            # Path...). Bo qua ca khoi, giong hat giong.
            continue
        elif kind == "if" and _la_khoi_main(_pool, nid):
            # `if __name__ == '__main__':` - khoi tu-kiem, KHONG BAO GIO chay
            # khi file duoc import/bien dich. Bo qua han thay vi bat nguoi
            # viet phai xoa: giu duoc thoi quen de mot doan thu nghiem ngay
            # trong file, ma van bien dich duoc bang TokenVector.
            continue
        elif _re_compile_pattern(_pool, nid, module_consts) is not None:
            # `_RE = re.compile(r'...')` o cap module (P6, 2026-09-08).
            #
            # Do tren cay tu-host: 100 dong nhu vay, nhom LON NHAT trong so
            # lenh cap module con lai. Chung KHONG can kieu du lieu moi: API
            # regex cua chinh TokenVector nhan CHUOI PATTERN
            # (`re_match(pattern, s)`, xem il_features/stdlib_re.py) chu
            # khong nhan doi tuong compiled. Nen `re.compile(<chuoi>)` duoc
            # ghi nhan dung bang CHUOI PATTERN - mot hang so module binh
            # thuong.
            #
            # Ben Python that, dong nay VAN tao doi tuong Pattern nhu cu
            # (file .py chay nguyen ven) - day chi la cach TokenVector DOC
            # no. Pham vi: 1 doi so va phai la chuoi literal.
            module_consts[_ten_gan] = _cap_hang('str', _re_compile_pattern(_pool, nid, module_consts))
        elif kind == "annassign" and _ar_ann_gan_co_gia_tri(_pool, nid):
            # BIEN toan cuc GHI DUOC ('global', 2026-08-11): 'counter: "i32" = 0'
            # o cap module - PHAN BIET voi hang so o tren qua AnnAssign (co
            # annotation kieu) thay vi Assign thuong. Sinh 1 '.field private
            # static' THAT (xem gen_il_program/build_generic_main) - doc/ghi
            # xuyen ham qua tu khoa 'global x' trong than ham (xem
            # il_codegen.py's _extract_global_decls). Thu hep pham vi co y:
            # CHI nhan gia tri khoi tao la 1 hang so/chuoi don gian (giong
            # module_consts), KHONG bieu thuc phuc tap.
            _con_ann = ar_kids(_pool, nid)
            gname = ar_col_a(_pool, _con_ann[0])
            if gname in module_consts:
                raise TranspileError(
                    f"'{gname}' da khai bao la hang so module (Assign khong annotation) - "
                    f"khong the vua la hang so vua la bien global (AnnAssign)")
            gdtype = _annotation_to_type_str(_pool, _con_ann[1], f"bien module-level '{gname}'")
            if gdtype not in ('i32', 'i64', 'f32', 'f64', 'str'):
                # P6 buoc 2 (2026-09-08): BANG HANG BAT BIEN cap module -
                # 'list[T]'/'set[T]' voi gia tri la literal toan HANG SO.
                # Do tren cay tu-host: 63/104 container cap module la bang
                # tra cuu CHI DOC; ep chung luon qua ctx la bat ca compiler
                # tra gia cho mot han che khong dem lai gi. Phan KHA BIEN
                # that ({}/[] rong: 21 registry + _EXTERN_CLASS_DEFS) VAN
                # phai qua ctx - o day chi nhan literal co san noi dung.
                tval = _module_table_value(_pool, gname, gdtype, _con_ann[2])
                module_globals[gname] = _cap_toan_cuc(gdtype, tval)
                continue
            _kv = ar_kind(_pool, _con_ann[2])
            # (dtype, [[van ban]]) - cung dang voi bang hang (2026-09-24).
            if _kv == "const_str":
                module_globals[gname] = _cap_toan_cuc(gdtype, [[ar_col_a(_pool, _con_ann[2])]])
            elif _kv == "const_num":
                module_globals[gname] = _cap_toan_cuc(gdtype, [[_hang_so_co_kieu(_pool, _con_ann[2])[1]]])
            elif (_kv == "unaryop" and ar_col_a(_pool, _con_ann[2]) == "-"
                  and gdtype in ('i32', 'i64', 'f32', 'f64')):
                # HANG SO AM o cap module: `KRG_CHU: "i32" = -1`. Nhanh tren chi
                # nhan `const_num` nen truoc day bi tu choi, va `seed_emit.tkv`
                # phai viet `0 - 1` de NE chinh gioi han cua compiler nay.
                _kn = ar_kids(_pool, _con_ann[2])
                if not (_kn and _kn[0] >= 0 and ar_kind(_pool, _kn[0]) == "const_num"):
                    raise TranspileError(
                        f"bien module-level '{gname}': hang so am chi chap nhan "
                        f"'-<so>' don gian")
                module_globals[gname] = _cap_toan_cuc(
                    gdtype, [['-' + _hang_so_co_kieu(_pool, _kn[0])[1]]])
            else:
                raise TranspileError(
                    f"bien module-level '{gname}': gia tri khoi tao phai la 1 hang so/chuoi "
                    f"don gian (giong hang so module), khong phai bieu thuc")
        elif _la_dong_chi_cpython(source_lines, ar_line_lo(_pool, nid)):
            # PRAGMA `# __tkv_cpython_only__` o CUOI DONG: cau lenh cap
            # module nay CHI ton tai cho duong chay CPython, TokenVector
            # BO QUA han.
            #
            # Vi sao can (2026-09-17, tren duong den fixed-point cua P7):
            # `tkv_compile.py` mo dau bang bon dong bootstrap CPython -
            # `COMPILER_DIR = Path(__file__).parent / "compiler"`, hai
            # `sys.path.insert(...)`, va `plugin_loader.load_plugins()`.
            # Chung ton tai DUY NHAT de CPython tim thay goi compiler va
            # nap plugin dong. Voi mot ban TokenVector da bien dich thi
            # CA BON deu vo nghia: tham chieu cheo file di qua
            # `__tkv_import__` luc BIEN DICH, va plugin duoc bien dich
            # thang vao chuong trinh chu khong nap luc chay.
            #
            # KHAC `__tkv_cpython_only__` trong compiler/tkv_pragma.py:
            # cai do la decorator cho METHOD cua record va la GIAN GIAO
            # di tru ("PHAI BIEN MAT khi di tru xong"). Cai nay danh dau
            # CAU LENH CAP MODULE va la nhu cau LAU DAI - chung nao con
            # chay duoc bang CPython thi con can bootstrap cua CPython.
            #
            # Hinh thuc la mot CHU THICH nen no hop le 100% duoi Python
            # va khong lam gi luc chay - cung tinh than voi
            # `__tkv_import__` va annotation-la-chuoi.
            continue
        else:
            raise TranspileError(
                f"Chi ho tro dinh nghia ham/class-record top-level, HANG SO cap module "
                f"(vd MAX = 10), bien global co kieu (vd 'counter: \"i32\" = 0'), "
                f"(va '__tkv_import__') trong "
                f"1 file TokenVector; gap {kind} o dong {ar_line_lo(_pool, nid)} (bien "
                f"module-level khac/... chua ho tro)")
    if not pairs and not la_import:
        # `la_import`: mot module DUOC IMPORT co the chi chua record, hang
        # so, hoac gian giao (vd compiler/tkv_pragma.py - ca file la mot
        # pragma). Doi no phai co ham DSL la SAI: phep kiem nay sinh ra de
        # bat "nguoi dung bien dich mot file khong co gi de bien dich", tuc
        # chi dung cho file CHINH. Truoc 2026-09-14 no ap cho ca hai, nen
        # module thuan-record phai them mot ham GIA cho qua cua.
        raise TranspileError("File khong co ham top-level nao co annotation kieu DSL")

    # @property (Phase C.3, 2026-07-29): gom TEN property TOAN CHUONG TRINH
    # (moi record_methods_raw[*] hien la 4-tuple co is_property, xem
    # _extract_record_def) - PHAI lam SAU KHI het vong lap tren (property co
    # the khai bao o 1 class xuat hien SAU 1 ham/method dung no trong van
    # ban nguon), roi desugar 'obj.propname' -> 'obj.propname()' tren TOAN
    # BO body_lines (ham top-level LAN method record) TRUOC KHI tra ve -
    # tra record_methods_raw VE LAI dang 3-tuple cu (sig_line, body_lines,
    # is_static) de _build_record_methods/gen_record_types KHONG can doi gi.
    property_names: "set[str]" = set()
    for ten_rec_pt in record_methods_raw4:
        methods_raw = record_methods_raw4[ten_rec_pt]
        for sig_line, _body_lines, _is_static, is_property in methods_raw:
            if is_property:
                ten_pt = _ten_truoc_ngoac(sig_line)
                if ten_pt != '':
                    property_names.add(ten_pt)

    record_methods_raw = {}
    if property_names:
        doi_pairs: "list[(str,list[str],i32)]" = []
        for cap in pairs:
            doi_pairs.append((cap[0], _desugar_property_reads(cap[1], property_names), cap[2]))
        pairs = doi_pairs
        for rname in record_methods_raw4:
            methods_raw = record_methods_raw4[rname]
            record_methods_raw[rname] = [
                (sig_line, _desugar_property_reads(body_lines, property_names), is_static)
                for sig_line, body_lines, is_static, _is_property in methods_raw]
    else:
        for rname in record_methods_raw4:
            methods_raw = record_methods_raw4[rname]
            record_methods_raw[rname] = [
                (sig_line, body_lines, is_static)
                for sig_line, body_lines, is_static, _is_property in methods_raw]

    # PHAI dang ky TRUOC `_resolve_record_field_types` - dat sau thi phep
    # phan giai field da chay xong voi bang RONG. Gop them (khong xoa) vi
    # duong `extract_program_file` goi ham nay MOI FILE trong cay import.
    them_bi_danh(type_aliases)
    # HOAN phan giai kieu field (2026-09-24): truoc day chay NGAY tai day,
    # tuc la voi record_defs CUA RIENG FILE NAY. Nen mot field tham chieu
    # record cua file duoc `__tkv_import__` luon chet - phep gop cac cay
    # import xay ra SAU. Co lap duoc trong 12 dong:
    #     kieuA.tkv:  class Diem: x: "i32"
    #     dungB.tkv:  __tkv_import__ = "kieuA"
    #                 class Hop: d: "Diem"      -> "dtype 'Diem' khong hop le"
    # Day la rao chan 100/117 file tren duong tu-host - khong lien quan gi
    # toi `TkvNode`/`Scope`/bi danh nhu thong bao loi khien nguoi ta tuong.
    # Gio phan giai MOT LAN o cho goi ngoai cung, khi da gop du record.
    record_defs = _bang_record_rong()
    if not hoan_giai_field:
        record_defs = _resolve_record_field_types(record_defs_tho, extern_class_names=_ten_extern_class(extern_classes))
    # Field container KHONG duoc gan o BAT CU dau nao phai bi tu choi: no se
    # NULL am tham. Chu tinh ca gan trong `__init__` LAN gan ben ngoai ctor
    # (Cua A, 2026-09-30) nen quet ca hai.
    _r_cn, _f_cn = _kiem_container_chua_gan(record_defs_tho, record_methods_raw4, pairs)
    if _r_cn is not None:
        raise TranspileError(
            f"class '{_r_cn}': field container '{_f_cn}' CHUA duoc gan o BAT CU "
            f"dau nao - gan trong __init__ hoac ben ngoai constructor, neu khong "
            f"field luon null va khong ai bao")
    return ChuongTrinh(record_defs, record_defs_tho, record_methods_raw, record_bases, record_interfaces, interface_defs, pairs, import_names, extern_assemblies, extern_methods, extern_pinvokes, extern_classes, module_consts, module_globals, inferred_ast_nodes_by_func, record_init_sigs, record_init_bodies)


def _bang_record_rong() -> "dict[str,list[(str,TypeAnn)]]":
    """Bang record RONG co kieu (2026-09-25)."""
    return {}


def _bang_record_tho_rong() -> "dict[str,list[(str,str)]]":
    """Bang record VAN BAN rong co kieu (2026-09-25)."""
    return {}


def _resolve_record_field_types(record_defs: "dict[str,list[(str,str)]]", extern_class_names: "set[str]"=None) -> "dict[str,list[(str,TypeAnn)]]":
    """Doi kieu field KHONG vo huong tu VAN BAN sang TypeAnn, SAU KHI da
    biet du ten cac record trong file (2026-08-03, dot 1): field co the la
    1 container ('list[str]', 'dict[str,f64]'), 1 record khac ('Node'), hay
    container CUA record ('list[Node]') - ke ca khai bao SAU (tham chieu
    tien, vd 'class Node: next: "Node"'). Field vo huong GIU NGUYEN dang
    chuoi dtype nhu cu (khong doi dinh dang du lieu da co).
    extern_class_names (Task 2, extern-class, 2026-08-18): ten cac
    handle-type khai bao qua __tkv_extern_class__ trong CUNG file - chap
    nhan lam kieu field y het 1 record (thread xuong _parse_type_ann_str)."""
    if extern_class_names is None:
        extern_class_names = set()   # (2026-09-25) mac dinh la None: trinh that chi nhan literal
    record_names = _ten_record(record_defs)
    # Bang MOI (2026-09-25) thay ghi de tai cho - xem ChuongTrinh.record_defs_tho.
    da_giai = _bang_record_rong()
    for rname in record_defs:
        fields = record_defs[rname]
        resolved = []
        for fname, dtype in fields:
            if dtype in DTYPES:
                # CHUAN HOA (2026-09-15): truoc day field VO HUONG giu nguyen
                # dang CHUOI con field container/record thanh TypeAnn, nen mot
                # `records[ten]` chua CA HAI kieu trong cung mot danh sach.
                # Do la rao tu-host: khong dtype DSL nao phu duoc
                # `list[(str,str)] | list[(str,TypeAnn)]`. Nay MOI field deu
                # la TypeAnn -> `dict[str,list[(str,TypeAnn)]]`.
                resolved.append((fname, TypeAnn(dtype, None)))
                continue
            if dtype in record_names:
                resolved.append((fname, TypeAnn(dtype, 'record')))
                continue
            try:
                ta = _parse_type_ann_str(dtype, record_names=record_names,
                                          extern_class_names=extern_class_names)
            except SyntaxError as e:
                raise TranspileError(
                    f"class '{rname}' field '{fname}': dtype {dtype!r} khong hop le "
                    f"(vo huong: {sorted(DTYPES)}; container: 'list[...]'/'dict[khoa,gia_tri]'; "
                    f"hoac ten 1 class da khai bao trong file) - {e}")
            # BI DANH (`__tkv_type_alias__`) giai ra DUNG hai hinh dang cua
            # hai nhanh truc tiep o tren - vo huong (`TkvNode` -> i32) va
            # record (`TkvSig` -> Signature). Parser da kiem dich hop le.
            if (ta.shape_ten == 'record' and ta.dtype in record_names) or (
                    not ta.shape_ten and ta.dtype in DTYPES):
                resolved.append((fname, ta))
                continue
            # 'tuple' them 2026-09-14 (LAN THU TU cung mot hinh dang:
            # `il_type_str` DA sinh IL cho shape nay - ValueTuple`2 - va chi
            # phep kiem la chan. Truoc do la func/extern_class/set).
            if ta.shape_ten not in ('list', 'dict', 'set', 'tuple', 'func',
                                'extern_class'):
                raise TranspileError(
                    f"class '{rname}' field '{fname}': dtype {dtype!r} khong hop le - field chi "
                    f"duoc la VO HUONG {sorted(DTYPES)}, 1 class da khai bao, hoac container "
                    f"'list[...]'/'dict[khoa,gia_tri]'")
            resolved.append((fname, ta))
        da_giai[rname] = resolved
    return da_giai


# DIEM VAO THAY THE (2026-09-24): chi test/cong do CPython goi; duong tu-host
# di qua compile_tkv_cli. Trong khoi `if` nay nen hai trinh TokenVector bo qua,
# con CPython van dinh nghia y het luc import.
if __tkv_chi_cpython__:
    def extract_program(source_text: "str"):
        """Parse mot file nguon TokenVector (`.tkv`) THAT tu VAN BAN THO
        (khong co duong dan file that), tra ve (record_defs, record_methods_raw,
        record_bases, record_interfaces, interface_defs, pairs) - xem
        _parse_program_ast. KHONG ho tro '__tkv_import__' (can duong dan thu
        muc de tim file import - dung extract_program_file() / compile_tkv_cli()
        / transpile_file() cho truong hop do)."""
        _ct = _parse_program_ast(source_text)
        record_defs = _ct.record_defs
        record_methods_raw = _ct.record_methods_raw
        record_bases = _ct.record_bases
        record_interfaces = _ct.record_interfaces
        interface_defs = _ct.interface_defs
        pairs = _ct.pairs
        import_names = _ct.import_names
        extern_assemblies = _ct.extern_assemblies
        extern_methods = _ct.extern_methods
        extern_pinvokes = _ct.extern_pinvokes
        extern_classes = _ct.extern_classes
        module_consts = _ct.module_consts
        module_globals = _ct.module_globals
        inferred_ast_nodes_by_func = _ct.inferred_ast_nodes_by_func
        if import_names:
            raise TranspileError(
                f"file co '__tkv_import__'/'import X'/'from X import ...' = {[t for t, _bb in import_names]!r} nhung "
                f"duoc goi qua extract_program(source_text) (khong co duong dan file that) - dung "
                f"extract_program_file(tkv_path) hoac compile_tkv_cli()/transpile_file() (co duong "
                f"dan) de import cheo file hoat dong")
        return (record_defs, record_methods_raw, record_bases, record_interfaces, interface_defs, pairs,
                extern_assemblies, extern_methods, extern_pinvokes, extern_classes, module_consts,
                module_globals, inferred_ast_nodes_by_func)


def _duong_tim_them() -> "list[str]":
    """Thu muc tim module THEM cua NOI CHAY (2026-09-24). Ban tu-host:
    khong co - noi chay .NET khong co khai niem `sys.path`. Ban CPython
    dinh nghia lai ben duoi (khoi `__tkv_chi_cpython__`) tra `sys.path`."""
    return []


def _sao_dll_simd(out_exe: "str") -> "i32":
    """Sao runtime/System.Numerics.Vectors.dll canh .exe (chuong trinh dung SIMD). Ban tu-host: chua sao
    (hat giong khong co file_copy) - dat dll canh exe bang tay. Ban CPython dinh nghia lai ben duoi."""
    return 0


def _goc_du_an() -> "str":
    """Goc du an (noi co `stdlib/`). Ban tu-host: thu muc cua exe dang chay.
    Ban CPython dinh nghia lai ben duoi: thu muc cua tkv_compile.py."""
    return path_dirname(path_abspath(sys_argv()[0]))


# Duong dan la CHUOI (2026-09-24), khong `pathlib.Path`: ban tu-host khong co
# Path, con cac builtin path_* thi CA HAI trinh bien dich deu co. Ben CPython,
# cac ten path_*/read_file la shim os.path dinh nghia trong khoi duoi.
if __tkv_chi_cpython__:
    import os

    def _duong_tim_them():
        # '' trong sys.path = thu muc HIEN TAI; `Path('').exists()` cu la True
        # con `os.path.isdir('')` la False - doi sang '.' de giu dung hanh vi.
        return [str(_p) or '.' for _p in sys.path]

    def _goc_du_an():
        return os.path.dirname(os.path.abspath(__file__))

    def path_join(a, b):
        return os.path.join(a, b)

    def _sao_dll_simd(out_exe):
        # Framework 4.8: System.Numerics.Vectors.dll trong GAC la facade RONG (khong co Vector<T>);
        # ban that goi kem o runtime/ - sao canh file .exe vua dung.
        import shutil
        nguon = os.path.join(_goc_du_an(), 'runtime', 'System.Numerics.Vectors.dll')
        if os.path.isfile(nguon):
            shutil.copyfile(nguon, os.path.join(os.path.dirname(str(out_exe)), 'System.Numerics.Vectors.dll'))
        return 0

    def path_isfile(p):
        return os.path.isfile(p)

    def path_isdir(p):
        return os.path.isdir(p)

    def path_abspath(p):
        return os.path.abspath(p)

    def path_dirname(p):
        return os.path.dirname(p)

    def path_basename(p):
        return os.path.basename(p)

    def read_file(p):
        with open(p, encoding='utf-8') as _f:
            return _f.read()


def _ung_vien_module(thu_muc: "str", ten: "str", ra: "list[str]"):
    """Bon ung vien trong MOT thu muc: <ten>.tkv, <ten>/__init__.tkv, roi ban
    .py tuong ung - dung thu tu cu cua nhanh sys.path."""
    ra.append(path_join(thu_muc, ten + '.tkv'))
    ra.append(path_join(path_join(thu_muc, ten), '__init__.tkv'))
    ra.append(path_join(thu_muc, ten + '.py'))
    ra.append(path_join(path_join(thu_muc, ten), '__init__.py'))


def _find_module_path(imp_name: "str", base_dir: "str") -> "str":
    """Tim file module cho 1 ten import (Phase 6.2, 2026-08-11 - port
    NGUYEN VEN tu cay .tkv tu-host, da chay THAT o do): uu tien file
    '.tkv' (native TokenVector) truoc '.py' (fallback, hiem dung), tim
    trong thu muc cua file dang bien dich, roi 'stdlib/'/'vendor/' (cung
    cho tuong doi/goc du an), roi cac thu muc tim THEM cua noi chay
    (CPython: sys.path; ban tu-host: khong co).

    TEN CO DAU CHAM (2026-09-17): 'il_features.async_await' duoc thu CA
    HAI dang - nguyen van (mot file ten co dau cham) VA dang duong dan
    ('il_features/async_await'). Dang nguyen van thu TRUOC.

    CHUOI thay Path (2026-09-24) - xem ghi chu khoi shim o tren. Doi
    TRUNG TINH hanh vi: cung ung vien, cung thu tu. CHUA giai quyet cach
    ban tu-host tim module compiler cua chinh no: hien `tkv_compile.tkv`
    giai `il_core` ra `compiler/il_core.py` qua sys.path, ma import giai ra
    '.py' thi BI BO QUA (xem extract_program_file) - them ung vien
    'compiler/<ten>.tkv' se doi han hanh vi do (gop CA compiler), la mot
    quyet dinh rieng."""
    dang = [imp_name]
    if '.' in imp_name:
        dang.append(imp_name.replace('.', '/'))
    goc = _goc_du_an()
    candidates = []
    for ten in dang:
        candidates.append(path_join(base_dir, ten + '.tkv'))
        candidates.append(path_join(path_join(base_dir, ten), '__init__.tkv'))
        candidates.append(path_join(path_join(base_dir, 'stdlib'), ten + '.tkv'))
        candidates.append(path_join(path_join(path_join(base_dir, 'stdlib'), ten), '__init__.tkv'))
        candidates.append(path_join(path_join(goc, 'stdlib'), ten + '.tkv'))
        candidates.append(path_join(path_join(path_join(goc, 'stdlib'), ten), '__init__.tkv'))
        candidates.append(path_join(path_join(base_dir, 'vendor'), ten + '.tkv'))
        candidates.append(path_join(path_join(path_join(base_dir, 'vendor'), ten), '__init__.tkv'))
        candidates.append(path_join(base_dir, ten + '.py'))
        candidates.append(path_join(path_join(base_dir, ten), '__init__.py'))
        candidates.append(path_join(path_join(base_dir, 'vendor'), ten + '.py'))
        candidates.append(path_join(path_join(path_join(base_dir, 'vendor'), ten), '__init__.py'))
    for cand in candidates:
        if path_isfile(cand):
            return path_abspath(cand)
    for sp in _duong_tim_them():
        if not path_isdir(sp):
            continue
        sp_cands = []
        for ten in dang:
            _ung_vien_module(sp, ten, sp_cands)
        for cand in sp_cands:
            if path_isfile(cand):
                return path_abspath(cand)
    return None


def _ten_cac_ham(pairs: "list[(str,list[str],i32)]") -> "set[str]":
    """Ten cac ham top-level trong pairs (2026-09-25) - tuong duong set-comp
    cu dung _FUNC_NAME_RE ('^(\\w+)\\('), bo sig_line khong khop."""
    ra = set()
    for cap in pairs:
        ten = _ten_truoc_ngoac(cap[0])
        if ten != '':
            ra.add(ten)
    return ra


# Thu vien chuan Python KHAC (ngoai shim) - chi dung o nhanh chi-CPython; giu
# nguyen tien to (khong phai module TokenVector trong khong gian ten gop).
_PY_STDLIB_KHAC: "set[str]" = {
    'collections', 'ast', 'copy', 'glob', 'tempfile', 'struct', 'typing', 'traceback',
    'inspect', 'importlib', 'types', 'keyword', 'bisect', 'textwrap', 'codecs', 'platform',
    'ctypes', 'threading', 'queue', 'heapq', 'operator', 'enum', 'dataclasses', 'argparse',
    'csv', 'pickle', 'urllib', 'http', 'socket', 'uuid', 'decimal', 'fractions', 'statistics',
    'unicodedata', 'locale', 'warnings', 'contextlib', 'abc', 'weakref', 'gc', 'signal',
    'errno', 'stat', 'fnmatch', 'pprint', 'difflib', 'numbers', 'array', 'calendar',
    'builtins', 'site', 'linecache', 'tokenize', 'token', 'dis', 'marshal', 'zlib', 'gzip',
    'tarfile', 'shlex', 'getpass', 'hmac', 'secrets', 'webbrowser', 'multiprocessing',
    'concurrent', 'asyncio', 'logging', 'unittest', 'doctest', 'timeit', 'cProfile',
    'profile', 'pstats', 'pdb', 'string', 'math', 'cmath', 'numpy'}


_IMPORT_BI_DANH_RE = re.compile(r'^\s*import\s+([\w.]+)(?:\s+as\s+(\w+))?\s*$')


_FROM_AS_RE = re.compile(r'^\s*from\s+[\w.]+\s+import\s+(.+?)\s*$')
_FROM_MOD_RE = re.compile(r'^\s*from\s+([\w.]+)\s+import\s')


def _ten_module_python(mod: "str", ten: "str") -> "str":
    """Ten ham/hang so cua module Python (math, re, json, os.path, random, itertools, string, sys) -> ten builtin
    TokenVector; '' neu khong co anh xa (2026-10-01)."""
    if mod == 'math':
        if ten == 'pi':
            return 'math_pi()'
        if ten == 'e':
            return 'math_e()'
        if ten == 'gcd':
            return 'math_gcd'
        if ten == 'fabs':
            return 'abs'
        if ten == 'degrees' or ten == 'radians' or ten == 'log2' or ten == 'isnan' or ten == 'isinf' or ten == 'isclose' or ten == 'copysign' or ten == 'fsum':
            return 'math_' + ten
        return ten
    if mod == 're':
        if ten == 'findall' or ten == 'split' or ten == 'sub':
            return 're_' + ten
        return ''
    if mod == 'json':
        if ten == 'loads':
            return 'json_loads'
        if ten == 'dumps':
            return 'json_dumps_py'
        return ''
    if mod == 'os.path' or mod == 'path':
        if ten == 'join' or ten == 'exists' or ten == 'isfile' or ten == 'isdir' or ten == 'basename' or ten == 'dirname' or ten == 'abspath' or ten == 'normpath' or ten == 'splitext':
            return 'path_' + ten
        return ''
    if mod == 'os':
        if ten == 'getenv':
            return 'os_getenv'
        if ten == 'mkdir':
            return 'os_mkdir'
        if ten == 'remove' or ten == 'unlink':
            return 'os_remove'
        return ''
    if mod == 'random':
        if ten == 'random':
            return 'random'
        if ten == 'randint' or ten == 'randrange' or ten == 'uniform' or ten == 'choice' or ten == 'sample':
            return ten
        return ''
    if mod == 'itertools':
        if ten == 'chain' or ten == 'combinations' or ten == 'product':
            return ten
        return ''
    if mod == 'string':
        if ten == 'ascii_lowercase':
            return '"abcdefghijklmnopqrstuvwxyz"'
        if ten == 'ascii_uppercase':
            return '"ABCDEFGHIJKLMNOPQRSTUVWXYZ"'
        if ten == 'ascii_letters':
            return '"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"'
        if ten == 'digits':
            return '"0123456789"'
        return ''
    if mod == 'time':
        if ten == 'time':
            return 'time_time'
        if ten == 'perf_counter' or ten == 'monotonic':
            return 'time_perf'
        if ten == 'sleep':
            return 'time_sleep'
        return ''
    if mod == 'sys':
        if ten == 'argv':
            return 'sys_argv()'
        return ''
    return ''


def _doi_ten_import(src: "str") -> "list[(str,str)]":
    """'from m import a as b, c' -> [(b, a)] (2026-09-28). Bo qua bi danh trung
    ten mot ham/lop dinh nghia trong chinh nguon (khong doi ten dinh nghia)."""
    ra: "list[(str,str)]" = []
    # Gop 'from m import (' nhieu dong thanh 1 dong (2026-09-28), bo chu thich.
    cac_dong: "list[str]" = []
    dang_gop = ""
    for dong in src.split(chr(10)):
        d = dong.split('#')[0]
        if dang_gop != "":
            dang_gop = dang_gop + " " + d.strip()
            if ')' in d:
                cac_dong.append(dang_gop)
                dang_gop = ""
            continue
        if _FROM_AS_RE.match(d) and d.rstrip().endswith('(') and ')' not in d:
            dang_gop = d.rstrip()
            continue
        cac_dong.append(d)
    for dong in cac_dong:
        m = _FROM_AS_RE.match(dong)
        if not m:
            continue
        mm = _FROM_MOD_RE.match(dong)
        if mm:
            mod_tn = mm.group(1)
            for manh in m.group(1).strip().strip('()').split(','):
                phan = manh.split()
                if len(phan) == 1:
                    dich = _ten_module_python(mod_tn, phan[0])
                    if dich != '' and dich != phan[0] and ('def ' + phan[0] + '(') not in src:
                        ra.append((phan[0], dich))
        for manh in m.group(1).strip().strip('()').split(','):
            phan = manh.split()
            if len(phan) == 3 and phan[1] == 'as' and phan[0] != phan[2]:
                if ('def ' + phan[2] + '(') in src or ('class ' + phan[2]) in src:
                    continue
                ra.append((phan[2], phan[0]))
    return ra


def _bi_danh_import(src: "str") -> "list[str]":
    """Ten dung de goi module sau 'import X' / 'import a.b as c' (2026-09-26)."""
    ra = []
    for dong in src.split(chr(10)):
        m = _IMPORT_BI_DANH_RE.match(dong)
        if not m:
            continue
        goc = m.group(1).split('.')[0]
        if goc in _STDLIB_SHIM_MODULES or goc in _PY_STDLIB_KHAC:
            # 're.match(...)'/'os.path...' la BUILTIN co duong rieng - giu ten module
            continue
        if m.group(2) is not None:
            ra.append(m.group(2))
        elif '.' not in m.group(1):
            ra.append(m.group(1))
    return ra


def extract_program_file(tkv_path: "str", _visited: "set[str]"=None, la_import: "i32"=False) -> "ChuongTrinh":
    """Nhu extract_program(), nhung doc THANG tu 1 file that (co duong dan)
    va DE QUY giai quyet '__tkv_import__' (khoang trong ngon ngu #3 - chia
    du an thanh nhieu file .tkv) - tim file '<ten>.tkv' trong CUNG thu muc
    voi file dang xu ly, gop TOAN BO ham/record/method cua no vao ket qua
    CHUNG (bao loi RO RANG neu trung ten ham/class giua 2 file - khong
    am tham ghi de). _visited: tap duong dan TUYET DOI da xu ly (chong
    import vong lap - vd A import B, B import lai A: lan gap lai A THU
    HAI se bi BO QUA thay vi de quy vo han, vi noi dung A da duoc gop
    roi tu lan dau).

    Gioi han da biet (@property, Phase C.3, 2026-07-29): desugar
    'obj.propname'->'obj.propname()' (xem _desugar_property_reads) chay
    RIENG trong _parse_program_ast cua TUNG file (theo property_names CHI
    cua file DO) - 1 property khai bao o file A se KHONG duoc desugar
    trong ham/method cua file B dang '__tkv_import__' A (van hoat dong binh
    thuong neu dung TRONG CUNG 1 file, truong hop pho bien nhat)."""
    # CHUOI, khong Path (2026-09-24) - xem _find_module_path. `str(...)`: noi
    # goi CPython (test, transpile_file) van co the truyen Path.
    tkv_path = path_abspath(str(tkv_path))
    if _visited is None:
        _visited = {tkv_path}
    # CRLF -> LF (2026-09-25): CPython 'open()' tu doi dong moi, read_file cua
    # ban tu-host thi KHONG - tep checkout CRLF tung vo o bo phan tich.
    source_text = read_file(tkv_path).replace('\r\n', '\n')
    if not la_import:
        il_codegen.dat_bi_danh_module(_bi_danh_import(source_text))
        il_codegen.dat_doi_ten_import(_doi_ten_import(source_text), True)
    else:
        il_codegen.them_bi_danh_module(_bi_danh_import(source_text))
        il_codegen.dat_doi_ten_import(_doi_ten_import(source_text), False)
    _ct = _parse_program_ast(source_text, la_import=la_import, hoan_giai_field=True)
    record_defs_tho = _ct.record_defs_tho
    record_methods_raw = _ct.record_methods_raw
    record_bases = _ct.record_bases
    record_interfaces = _ct.record_interfaces
    interface_defs = _ct.interface_defs
    pairs = _ct.pairs
    import_names = _ct.import_names
    extern_assemblies = _ct.extern_assemblies
    extern_methods = _ct.extern_methods
    extern_pinvokes = _ct.extern_pinvokes
    extern_classes = _ct.extern_classes
    module_consts = _ct.module_consts
    module_globals = _ct.module_globals
    inferred_ast_nodes_by_func = _ct.inferred_ast_nodes_by_func
    record_init_sigs = _ct.record_init_sigs
    record_init_bodies = _ct.record_init_bodies
    func_names = _ten_cac_ham(pairs)

    for imp_name, bat_buoc in import_names:
        imp_path = _find_module_path(imp_name, path_dirname(tkv_path))
        # `bat_buoc` = den tu pragma `__tkv_import__` (y muon TUONG MINH: day
        # la mot module TokenVector, thieu no thi chuong trinh sai) -> khong
        # tim thay la LOI.
        #
        # `import X` / `from X import ...` THUONG thi khac: mot file .tkv van
        # la Python THAT chay duoc, nen no co the import module CPython chi de
        # chay doi chieu duoi CPython (vd `_file_io_helpers.py` cai dat
        # read_file/write_file - nhung ham ma TokenVector coi la BUILTIN).
        # Hop dong nay duoc ghi ngay trong ma nguon mau:
        #   sample_json.tkv - "'__tkv_import__' khong dung o day (json_helpers
        #   la module Python THAT, khong phai .tkv khac) - dung 'from ...
        #   import' THAT (bi extract_program() bo qua luc bien dich)"
        # va trong docstring cua chinh cac helper do.
        #
        # Phase 6.2 (2026-08-11) port co che import TU cay tu-host, noi cac
        # module compiler .tkv import lan nhau ('from il_core import ...') va
        # THAT SU can gop - nhung buoc do coi MOI import la module TokenVector,
        # lam vo hop dong tren. Phan biet dung: gop khi giai ra file '.tkv';
        # giai ra '.py' (hoac khong thay) nghia la module CPython ben ngoai ->
        # BO QUA. Da do: khong file .tkv nao trong repo dung 'import X' thuong
        # tro toi mot module .tkv, nen phan biet nay khong pha duong tu-host.
        if not bat_buoc and (imp_path is None or not imp_path.endswith('.tkv')):
            continue
        if imp_path is None:
            raise TranspileError(
                f"file '{path_basename(tkv_path)}': import module '{imp_name}' khong tim thay trong "
                f"thu muc hien tai hoac site-packages ({_duong_tim_them()!r})")
        if imp_path in _visited:
            continue
        _visited.add(imp_path)
        _ct_imp = extract_program_file(
             imp_path, _visited, la_import=True)
        imp_record_defs_tho = _ct_imp.record_defs_tho
        imp_record_methods_raw = _ct_imp.record_methods_raw
        imp_record_bases = _ct_imp.record_bases
        imp_record_interfaces = _ct_imp.record_interfaces
        imp_interface_defs = _ct_imp.interface_defs
        imp_pairs = _ct_imp.pairs
        imp_extern_assemblies = _ct_imp.extern_assemblies
        imp_extern_methods = _ct_imp.extern_methods
        imp_extern_pinvokes = _ct_imp.extern_pinvokes
        imp_extern_classes = _ct_imp.extern_classes
        imp_module_consts = _ct_imp.module_consts
        imp_module_globals = _ct_imp.module_globals
        imp_inferred_ast_nodes_by_func = _ct_imp.inferred_ast_nodes_by_func
        imp_record_init_sigs = _ct_imp.record_init_sigs
        imp_record_init_bodies = _ct_imp.record_init_bodies
        imp_func_names = _ten_cac_ham(imp_pairs)

        dup_funcs = set()
        for _t in imp_func_names:
            if _t in func_names:
                dup_funcs.add(_t)
        if dup_funcs:
            raise TranspileError(
                f"trung ten ham {sorted(dup_funcs)} giua file '{path_basename(tkv_path)}' va import "
                f"'{imp_name}.tkv'")
        dup_records = set()
        for _t in imp_record_defs_tho:
            if _t in record_defs_tho:
                dup_records.add(_t)
        if dup_records:
            raise TranspileError(
                f"trung ten class {sorted(dup_records)} giua file '{path_basename(tkv_path)}' va import "
                f"'{imp_name}.tkv'")
        dup_interfaces = set()
        for _t in imp_interface_defs:
            if _t in interface_defs:
                dup_interfaces.add(_t)
        if dup_interfaces:
            raise TranspileError(
                f"trung ten interface {sorted(dup_interfaces)} giua file '{path_basename(tkv_path)}' va "
                f"import '{imp_name}.tkv'")

        pairs.extend(imp_pairs)
        for _t in imp_func_names:
            func_names.add(_t)
        record_defs_tho.update(imp_record_defs_tho)
        record_methods_raw.update(imp_record_methods_raw)
        record_bases.update(imp_record_bases)
        record_interfaces.update(imp_record_interfaces)
        interface_defs.update(imp_interface_defs)
        extern_assemblies.extend(imp_extern_assemblies)
        extern_methods.extend(imp_extern_methods)
        extern_pinvokes.extend(imp_extern_pinvokes)
        extern_classes.extend(imp_extern_classes)
        # Hang so cap module cua file IMPORT dung duoc trong file goc (giong
        # ham/record) - trung ten thi file GOC thang (khai bao gan hon).
        for k in imp_module_consts:
            v = imp_module_consts[k]
            module_consts.setdefault(k, v)
        # Bien global cua file IMPORT (2026-08-11) - cung quy uoc: trung
        # ten thi file GOC thang.
        for k_g in imp_module_globals:
            v_g = imp_module_globals[k_g]
            module_globals.setdefault(k_g, v_g)
        # Task 3/5 (duck-typing-inference): AST goc cua ham 'inferred' o
        # file IMPORT - dup_funcs o tren da dam bao khong trung ten voi file
        # goc nen .update() an toan (khong ghi de nham).
        inferred_ast_nodes_by_func.update(imp_inferred_ast_nodes_by_func)
        for k_is in imp_record_init_sigs:
            record_init_sigs.setdefault(k_is, imp_record_init_sigs[k_is])
            record_init_bodies.setdefault(k_is, imp_record_init_bodies[k_is])

    # Phan giai kieu field MOT LAN, o cho goi NGOAI CUNG, khi `record_defs`
    # da gop du ca cay `__tkv_import__` - xem ghi chu `hoan_giai_field`.
    # Chi lan ngoai cung moi lam: mot file duoc import co the tham chieu
    # record cua file ANH EM, nen giai som o tung muc de quy van thieu.
    record_defs = _bang_record_rong()
    if not la_import:
        record_defs = _resolve_record_field_types(record_defs_tho,
                                     extern_class_names=_ten_extern_class(extern_classes))
    return ChuongTrinh(record_defs, record_defs_tho, record_methods_raw, record_bases, record_interfaces, interface_defs, pairs, [], extern_assemblies, extern_methods, extern_pinvokes, extern_classes, module_consts, module_globals, inferred_ast_nodes_by_func, record_init_sigs, record_init_bodies)


def _bang_method_rong() -> "dict[str,dict[str,Signature]]":
    """Bang RONG co kieu ten-record -> {ten-method: Signature} (2026-09-25)."""
    return {}


def _bang_than_method_rong() -> "dict[str,list[(Signature,list[str])]]":
    """Bang RONG co kieu ten-record -> [(Signature, body_lines)] (2026-09-25)."""
    return {}


def _build_record_methods(record_defs: "dict[str,list[(str,TypeAnn)]]", record_methods_raw: "dict[str,list[(str,list[str],i32)]]", record_bases: "dict[str,list[str]]"=None,
                           extern_class_names: "set[str]"=None) -> "(dict[str,dict[str,Signature]],dict[str,list[(Signature,list[str])]],dict[str,dict[str,Signature]])":
    """Parse TAT CA sig_line THO cua method (record_methods_raw) thanh
    Signature THAT - lam RIENG, SAU khi record_defs (fields) da biet DU
    (khong lam ben trong extract_program) de method co the tham chieu
    BAT KY record nao trong file (ke ca khai bao SAU no) qua record_names.

    record_bases (B1, 2026-07-29): dict ten-record -> ten-class-cha (hoac
    None) - neu co, 'record_methods' tra ve la VIEW DA GOP (method ke thua
    tu to tien + method RIENG, method RIENG de len SAU nen THANG method ke
    thua neu trung ten - dung khi 1 CALL SITE (vd 'dog.speak()') can biet
    Signature cua 1 method du no dinh nghia o Dog hay o Animal). KHONG
    truyen (None, mac dinh) tuong duong record_bases rong - hanh vi CU
    (chi method RIENG cua tung record), an toan cho MOI caller khong ke
    thua. record_method_bodies LUON CHI method RIENG (khong lap - CLR tu
    dispatch method ke thua qua v-table, xem gen_record_types) - KHONG bi
    anh huong boi gop nay.

    Tra ve (record_methods: {ten-record: {ten-method: Signature}} - DA GOP
    neu co record_bases, record_method_bodies: {ten-record: [(Signature,
    body_lines), ...]} - CHI method RIENG)."""
    if extern_class_names is None:
        extern_class_names = set()   # (2026-09-25) mac dinh la None: trinh that chi nhan literal
    if not record_bases:
        record_bases = {}
    record_names = _ten_record_ta(record_defs)
    record_methods_own = _bang_method_rong()
    record_method_bodies = _bang_than_method_rong()
    for rname in record_methods_raw:
        methods_raw = record_methods_raw[rname]
        sigs = {}
        bodies = []
        for sig_line, body_lines, is_static in methods_raw:
            m_sig = parse_typed_signature(sig_line, record_names=record_names,
                                           extern_class_names=extern_class_names)
            m_sig.is_static = is_static
            if m_sig.name in sigs:
                raise TranspileError(f"class '{rname}': trung ten method '{m_sig.name}'")
            sigs[m_sig.name] = m_sig
            bodies.append((m_sig, body_lines))
        record_methods_own[rname] = sigs
        record_method_bodies[rname] = bodies

    for rname in record_defs:
        bases = cac_base(record_bases, rname)
        if len(bases) > 1:
            # Phase 3.1 (2026-08-11) - bases[1:] khong dong gop field nhung
            # DONG GOP method MAC DINH (default method body, neu co) khi
            # record chinh CHUA tu dinh nghia method cung ten - giong y
            # tuong "default method" cua Java interface, tranh nguoi dung
            # phai chep lai body giong het nhau cho moi record implement.
            #
            # Fix MRO da-base (2026-08-13, muc 6.10): bases[1:] KHONG CHI la
            # '@interface' - co the la record THAT (vd 'class Duck(Flyer,
            # Swimmer)'). Truoc day vong lap CHI duyet bases[1:], BO SOT
            # bases[0] hoan toan - ket qua: khi 2+ base CUNG override 1
            # method trung ten, base CUOI "thang" mot cach tinh co (vi chi
            # no duoc copy chu dong vao day, con base[0] le ra dua vao CIL
            # 'extends' that + _method_owner_class fallback, nhung fallback
            # do khong bao gio chay vi 'isinstance(base, str)' luon False
            # khi base la LIST da-base) - SAI so voi CPython that (da xac
            # nhan qua spike: 'Duck(Flyer, Swimmer)' ca 2 override 'speak',
            # CPython tra ve 'flyer-speak' - base DAU TIEN thang theo MRO,
            # khong phai base cuoi). Duyet CA 'bases' (bao gom bases[0]) de
            # base DAU TIEN duoc uu tien dung ('own_names' add truoc thi
            # base do thang - giu nguyen than vong lap, chi doi pham vi).
            own_names = set()
            if rname in record_method_bodies:
                for m_c in record_method_bodies[rname]:
                    own_names.add(m_c[0].name)
            for sec in bases:
                if sec not in record_method_bodies:
                    continue
                for m_b in record_method_bodies[sec]:
                    m_sig = m_b[0]
                    b_lines = m_b[1]
                    if m_sig.name not in own_names:
                        record_method_bodies[rname].append((m_sig, b_lines))
                        own_names.add(m_sig.name)
                        own_de_tien = record_methods_own[rname]
                        own_de_tien[m_sig.name] = m_sig

    record_methods = _bang_method_rong()
    for rname in record_defs:
        visited: "set[str]" = set()
        queue = [rname]
        chain = []
        while queue:
            cur = queue.pop(0)
            if cur in visited:
                continue
            visited.add(cur)
            chain.append(cur)
            queue.extend(cac_base(record_bases, cur))
        merged: "dict[str,Signature]" = {}
        for c in reversed(chain):  # goc truoc, roi den con - con THANG neu trung ten (override)
            if c in record_methods_own:
                for _k, _v in record_methods_own[c].items():
                    merged[_k] = _v
        record_methods[rname] = merged
    return record_methods, record_method_bodies, record_methods_own


def _build_sig_body_pairs(pairs: "list[(str,list[str],i32)]", record_defs: "dict[str,list[(str,TypeAnn)]]", record_methods: "dict[str,dict[str,Signature]]", inferred_ast_nodes_by_func: "dict[str,(list[str],i32)]"=None,
                           extern_class_names: "set[str]"=None) -> "list[(Signature,list[str],i32)]":
    """Parse TOAN BO `pairs` (sig_line VAN BAN) thanh Signature THAT, GAN
    THEM `sig.inferred_constraints` (Task 3/5, duck-typing-inference,
    2026-08-17) cho MOI Signature co >=1 tham so dtype 'inferred' - goi
    collect_inferred_constraints() voi AST GOC luu trong
    `inferred_ast_nodes_by_func` (xem _parse_program_ast). Dat RIENG ham
    nay (thay vi lap lai list-comprehension o 2 noi) de compile_tkv_cli va
    _transpile_extracted dung CHUNG 1 logic, tranh 2 noi lech nhau.

    `sig.inferred_constraints` LUON duoc gan (dict[param_name -> list[Constraint]],
    RONG {} neu ham khong co tham so inferred nao hoac inferred_ast_nodes_by_func
    khong duoc truyen) - Task 4 co the doc thang `sig.inferred_constraints`
    ma khong can hasattr()."""
    if extern_class_names is None:
        extern_class_names = set()   # (2026-09-25) mac dinh la None: trinh that chi nhan literal
    if not inferred_ast_nodes_by_func:
        inferred_ast_nodes_by_func = {}
    sig_body_pairs = []
    for sig_line, body_lines, start_line in pairs:
        # Task 2 (extern-class, 2026-08-18): boc SyntaxError thanh
        # TranspileError - dong nhat voi cach _resolve_record_field_types
        # da lam (field dung ten kieu chua khai bao), giup mot ten
        # handle-type chua khai bao qua __tkv_extern_class__ (hoac bat ky
        # loi cu phap chu ky nao khac) bao loi qua 1 loai exception ON
        # DINH (TranspileError) thay vi SyntaxError tho tu tang parser noi
        # bo - khong doi NOI DUNG thong bao loi, chi doi LOAI exception.
        try:
            sig = parse_typed_signature(sig_line, record_names=_ten_record_ta(record_defs),
                                         extern_class_names=extern_class_names)
        except SyntaxError as e:
            raise TranspileError(str(e))
        func_arena = inferred_ast_nodes_by_func.get(sig.name)
        if func_arena is not None:
            # (pool, nid) tu P8 Task 6 - duck_typing doc THANG arena.
            _pool_fn, _nid_fn = func_arena
            sig.inferred_constraints = collect_inferred_constraints(
                sig, _pool_fn, _nid_fn, record_defs, record_methods)
        else:
            sig.inferred_constraints = {}
        sig_body_pairs.append((sig, body_lines, start_line))
    return sig_body_pairs


def _fresh_registry() -> "Registry":
    """Mot bo bang dieu phoi MOI da bootstrap day du.

    P6 chang 1c (2026-09-08): truoc day co MOT bo dung chung tao luc import
    (`_ACTIVE` trong il_dispatch) - vua la lenh cap module (khong bien dich
    duoc bang TokenVector), vua la trang thai TOAN CUC dung chung giua cac
    luot bien dich trong CUNG tien trinh, phai don bang finally-pop.
    Moi luot bien dich gio co bo RIENG, khong con dam nhau."""
    reg = new_registry()
    bootstrap_all(reg)
    return reg


def _khung_hang(module_consts: "dict[str,(str,str)]") -> "dict[str,(str,str)]":
    """Hang so cap module -> (dtype, van ban IL) cho LOI bien dich.

    Ranh gioi co kieu (2026-09-24): `module_consts` mang gia tri PYTHON
    (int|str|float - union ngon ngu khong khai duoc); il_codegen chi can dtype
    va van ban da escape (Binding.const_value von la str). Tinh MOT lan o day,
    CHEP DUNG ba nhanh cu cua gen_il_function."""
    ra = {}
    for cname in (module_consts or {}):
        cval = module_consts[cname]
        if cval[0] == 'str':
            # Xuong dong/tab/CR THAT trong hang (vd mau regex (?x) nhieu dong)
            # phai duoc thoat thanh chuoi 2 ky tu: ilasm khong nhan xuong dong
            # tho trong chuoi (2026-09-29).
            ra[cname] = _cap_hang('str', '"' + _thoat_ldstr(cval[1]) + '"')
        else:
            ra[cname] = cval
    return ra


def _khung_bien(module_globals: "dict[str,(str,list[list[str]])]") -> "dict[str,str]":
    """Bien/bang cap module -> dtype. Loi bien dich KHONG doc gia tri khoi
    tao (do la viec cua build_generic_main, phia trinh dieu khien)."""
    khung_bien = {}
    if module_globals:
        for g in module_globals:
            gv = module_globals[g]
            khung_bien[g] = gv[0]
    return khung_bien


# DIEM VAO THAY THE (2026-09-24): chi test/cong do CPython goi; duong tu-host
# di qua compile_tkv_cli. Trong khoi `if` nay nen hai trinh TokenVector bo qua,
# con CPython van dinh nghia y het luc import.
if __tkv_chi_cpython__:
    def _transpile_extracted(reg: "Registry", record_defs: "dict[str,list[(str,TypeAnn)]]", record_methods_raw, pairs, class_name: "str", with_guards: "i32",
                              module_consts=None, extra_classes: "list[list[str]]"=None, module_globals=None,
                              inferred_ast_nodes_by_func: "dict[str,(list[str],i32)]"=None, extern_class_names: "set[str]"=None,
                              record_bases: "dict[str,list[str]]"=None) -> "list[str]":
        """Phan CHUNG cua transpile_program/transpile_file - nhan ket qua da
        extract (tu 1 file don le HOAC da gop nhieu file qua
        extract_program_file/__tkv_import__), sinh CIL method that."""
        # extern_class_names (P8 Task 7, 2026-09-09): PHAI luong xuong, neu khong
        # thi ten handle-type dung trong ANNOTATION THAM SO cua ham ('codegen_fn:
        # "func(TkvNode, ...)"') khong duoc nhan -> "Ky vong dtype ..., gap
        # 'TkvNode'". Hai cho parse chu ky (_build_sig_body_pairs va
        # _build_record_methods) von DA nhan tham so nay - chi duong
        # transpile_file/_transpile_extracted la chua truyen.
        # record_bases (2026-09-10): LAN THU HAI cung mot lo hong o CUNG ham nay.
        # Chu thich ngay tren mo ta lan thu nhat - `extern_class_names` bi duong
        # transpile_file/_transpile_extracted vut bo. `record_bases` cung vay: no
        # bi giai nen vao `_rb` roi bo di, nen MOI thu lien quan KE THUA (to tien
        # chung cua list tron lop con, phan giai field/method ke thua) deu chay
        # voi bang RONG tren duong nay.
        #
        # Hau qua rong hon: cong doi chieu IL dung chinh `transpile_file`, nen
        # hanh vi ke thua xua nay nam NGOAI tam kiem cua cong - y het chuyen
        # extern_classes truoc do.
        # ARENA BIEU THUC phai dat lai o DAY, truoc MOI phep phan tich bieu
        # thuc cua chuong trinh nay - `default_node` cua tham so duoc sinh ngay
        # trong `_build_record_methods`/`_build_sig_body_pairs` ben duoi, nen
        # dat lai muon hon (vd trong `gen_il_program`) lam chung treo.
        reset_pool_bieu_thuc()
        record_methods, _, _ = _build_record_methods(record_defs, record_methods_raw,
                                                      record_bases=record_bases,
                                                      extern_class_names=extern_class_names)
        sig_body_pairs = _build_sig_body_pairs(pairs, record_defs, record_methods,
                                                inferred_ast_nodes_by_func,
                                                extern_class_names=extern_class_names)
        return gen_il_program(reg, sig_body_pairs, class_name=class_name, with_guards=with_guards,
                               records=record_defs, record_methods=record_methods,
                               record_bases=record_bases,
                               hang_mod=_khung_hang(module_consts), extra_classes=extra_classes,
                               bien_mod=_khung_bien(module_globals))


# DIEM VAO THAY THE (2026-09-24): chi test/cong do CPython goi; duong tu-host
# di qua compile_tkv_cli. Trong khoi `if` nay nen hai trinh TokenVector bo qua,
# con CPython van dinh nghia y het luc import.
if __tkv_chi_cpython__:
    def transpile_program(source_text: "str", class_name: "str"='Program', with_guards: "i32"=True,
                           extra_classes: "list[list[str]]"=None) -> "list[str]":
        """Pipeline day du: source TokenVector (`.tkv`) THAT -> list CIL
        method (dung gen_il_program - da co func_table cho goi ham cheo nhau).
        LUU Y: neu source co 'class dang record', KHONG dung ham nay truc tiep
        de ra 1 file .il hoan chinh - method_lines tra ve CHUA co cac '.class
        value' cua record (xem compile_tkv_cli, noi ghep gen_record_types()
        RIENG ben ngoai class chuong trinh chinh). KHONG ho tro '__tkv_import__'
        (xem extract_program) - dung transpile_file() cho file co import cheo."""
        # Bang bi danh phai DAT LAI moi chuong trinh, y nhu arena bieu thuc:
        # bi danh cua file truoc con sot lai se lam mot ten bia o file sau
        # LOT LUOI - phep kiem tu nhien yeu di ma khong ai bao.
        dat_bi_danh({})
        (record_defs, record_methods_raw, _rb, _ri, _idefs, pairs, _ea, _em, _ep, _ec,
         module_consts, module_globals, inferred_ast_nodes_by_func) = extract_program(source_text)
        reg = _fresh_registry()
        return _transpile_extracted(reg, record_defs, record_methods_raw, pairs, class_name, with_guards,
                                     module_consts=module_consts, extra_classes=extra_classes,
                                     module_globals=module_globals,
                                     inferred_ast_nodes_by_func=inferred_ast_nodes_by_func,
                                     record_bases=_rb)


# DIEM VAO THAY THE (2026-09-24): chi test/cong do CPython goi; duong tu-host
# di qua compile_tkv_cli. Trong khoi `if` nay nen hai trinh TokenVector bo qua,
# con CPython van dinh nghia y het luc import.
if __tkv_chi_cpython__:
    def transpile_file(tkv_path: "str", class_name: "str"='Program', with_guards: "i32"=True,
                        extra_classes: "list[list[str]]"=None, reg: "Registry"=None) -> "list[str]":
        """Nhu transpile_program, nhung doc THANG tu file (co duong dan) nen
        ho tro '__tkv_import__' (khoang trong ngon ngu #3 - import module
        TokenVector khac) qua extract_program_file()."""
        # Bang bi danh phai DAT LAI moi chuong trinh, y nhu arena bieu thuc:
        # bi danh cua file truoc con sot lai se lam mot ten bia o file sau
        # LOT LUOI - phep kiem tu nhien yeu di ma khong ai bao.
        dat_bi_danh({})
        _ct = extract_program_file(tkv_path)
        record_defs = _ct.record_defs
        record_methods_raw = _ct.record_methods_raw
        _rb = _ct.record_bases
        pairs = _ct.pairs
        extern_classes = _ct.extern_classes
        module_consts = _ct.module_consts
        module_globals = _ct.module_globals
        inferred_ast_nodes_by_func = _ct.inferred_ast_nodes_by_func
        # API cong khai: caller khong bat buoc biet den bo bang dieu phoi.
        if reg is None:
            reg = _fresh_registry()
        # Task 7 (P8, 2026-09-09): TRUOC DAY duong nay VUT BO `extern_classes` (bien
        # ten `_ec`), trong khi `compile_tkv_cli` thi day chung vao
        # `il_extern_dtype._EXTERN_CLASS_DEFS`. Hau qua: moi file dung
        # `__tkv_extern_class__` deu nem `KeyError` o `il_type_str` khi di qua
        # `transpile_file` - va CONG DOI CHIEU IL (p8_il_gate.py) dung chinh
        # `transpile_file`, nen cac mau extern-class nam trong nhom "khong bien dich
        # duoc ca hai" suot ca P8, tuc NGOAI tam kiem chung cua cong.
        #
        # Lo ra khi do rao R1: thong bao loi cua compiler quang cao handle type dung
        # duoc lam tham so `func(...)`, thu that thi vo - hoa ra khong phai gioi han
        # ngon ngu ma la duong nay thieu buoc day.
        truoc = il_extern_dtype._EXTERN_CLASS_DEFS
        il_extern_dtype.dat_bang_extern_class(_nap_extern_classes(extern_classes))
        try:
            return _transpile_extracted(reg, record_defs, record_methods_raw, pairs, class_name,
                                         with_guards, module_consts=module_consts,
                                         extra_classes=extra_classes, module_globals=module_globals,
                                         inferred_ast_nodes_by_func=inferred_ast_nodes_by_func,
                                         extern_class_names=_ten_extern_class(extern_classes),
                                         record_bases=_rb)
        finally:
            # Khoi phuc gia tri TRUOC do (khong xoa trang): `compile_tkv_cli` co the
            # dang giu bo cua no va goi xuong day.
            il_extern_dtype.dat_bang_extern_class(truoc)


# ============================================================
# CLI tu dong (huong tiep theo sau ROADMAP.md 9 buoc): tu truoc gio moi
# vi du/test trong session deu phai TU TAY viet 1 method Main() bang IL
# (doc argv, goi ham, in ket qua) - tuc TokenVector moi dung duoc "qua
# script Python", chua phai "cong cu bien dich that goi tu dong lenh".
# build_generic_main()/compile_tkv_cli() tu dong sinh Main() cho BAT KY
# ham entry nao co tham so/return VO HUONG (i32/i64/f32/f64/str) - khong
# them tinh nang ngon ngu moi, chi dong goi lai ha tang codegen DA CO va
# DA VERIFY (parse argv theo dtype, in ket qua) thanh 1 lenh `tkv build`.
#
# Gioi han THAT (chua ho tro): tham so/return la mang/list/dict - argv la
# chuoi PHANG, chua co quy uoc serialize container ro rang; se bao loi
# ro rang (CliError) thay vi doan mo.
# ============================================================

class CliError(Exception):
    msg: "str"


# Dtype nhan duoc lam tham so/ket qua cua CLI tu sinh. Hai bang lenh IL duoi la
# HAM chu khong bang cap module (2026-09-25): bang cap module chua nhan gia tri
# long container (dict[str, list[str]]).
_CLI_DTYPES: "set[str]" = {'i32', 'i64', 'f32', 'f64', 'str'}


def _cli_parse_seq(d: "str") -> "list[str]":
    """Lenh IL doi argv[i] (string) sang dtype `d`."""
    if d == 'i32':
        return ['call int32 [mscorlib]System.Int32::Parse(string)']
    if d == 'i64':
        return ['call int64 [mscorlib]System.Int64::Parse(string)']
    if d == 'f32':
        return ['call class [mscorlib]System.Globalization.CultureInfo '
                '[mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()',
                'call float32 [mscorlib]System.Single::Parse(string, '
                'class [mscorlib]System.IFormatProvider)']
    if d == 'f64':
        return ['call class [mscorlib]System.Globalization.CultureInfo '
                '[mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()',
                'call float64 [mscorlib]System.Double::Parse(string, '
                'class [mscorlib]System.IFormatProvider)']
    return []   # 'str': argv[i] da la string san


def _cli_print_seq(d: "str") -> "list[str]":
    """Lenh IL doi ket qua dtype `d` sang string de in."""
    if d == 'i32':
        return ['call instance string [mscorlib]System.Int32::ToString()']
    if d == 'i64':
        return ['call instance string [mscorlib]System.Int64::ToString()']
    if d == 'f32':
        return ['call class [mscorlib]System.Globalization.CultureInfo '
                '[mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()',
                'call instance string [mscorlib]System.Single::ToString(class [mscorlib]System.IFormatProvider)']
    if d == 'f64':
        return ['call class [mscorlib]System.Globalization.CultureInfo '
                '[mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()',
                'call instance string [mscorlib]System.Double::ToString(class [mscorlib]System.IFormatProvider)']
    return []   # 'str': in thang


def _thoat_ldstr(v: "str") -> "str":
    """Thoat mot chuoi de dat trong 'ldstr "..."' cua ilasm (2026-09-29): gach
    cheo, nhay kep, va xuong dong / CR / tab THAT (ilasm khong nhan xuong dong
    tho trong chuoi - gap o mau regex (?x) nhieu dong va bang '\\n' -> '\\n')."""
    ra = v.replace(chr(92), chr(92) * 2).replace('"', chr(92) + '"')
    ra = ra.replace(chr(10), chr(92) + 'n').replace(chr(13), chr(92) + 'r')
    ra = ra.replace(chr(9), chr(92) + 't')
    # Ky tu dieu khien con lai (vd NUL): thoat bat phan 3 chu so.
    ket = ''
    for c in ra:
        if ord(c) < 32:
            ket = ket + chr(92) + '0' + str(ord(c) // 8) + str(ord(c) % 8)
        else:
            ket = ket + c
    return ket


def _bang_hang_push(dt: "str", v: "str") -> "str":
    if dt == 'str':
        return f'    ldstr "{_thoat_ldstr(v)}"'
    return f'    {IL_LDC_OP[dt]} {v}'


def _bang_funcref_push(ten_ham: "str", class_name: "str", func_table: "dict[str,TkvSig]", gname: "str", records: "dict[str,list[(str,TkvTypeAnn)]]", ta: "TypeAnn") -> "list[str]":
    """Delegate cho 1 TEN HAM top-level - cung idiom voi
    il_codegen._compile_funcref_arg (ldnull + ldftn + newobj), va cung
    ly do phai dung TypeAnn DAY DU cua tung tham so: chi lay `.dtype`
    thi 'f(xs: list[str])' sinh ra 'f(string)' va nem
    MissingMethodException LUC CHAY (assemble van qua)."""
    callee = (func_table or {}).get(ten_ham)
    if callee is None:
        raise TranspileError(
            f"bang dieu phoi cap module '{gname}': '{ten_ham}' khong phai "
            f"1 ham top-level da dinh nghia trong chuong trinh")
    # (2026-10-06) Gom 2 list dtype thanh 2 CHUOI roi so `!=`: `!=` tren 2
    # list la SO THAM CHIEU (ceq) nen khong dung truc tiep duoc. String so
    # theo GIA TRI (da probe) nen cach nay dung ca duoi compiler cu va moi.
    mong_s = ""
    _fps = ta.elem_ta.func_params
    if _fps is not None:
        for _p in _fps:
            mong_s = mong_s + "," + str(_p.dtype)
    co_s = ""
    for _q in callee.params:
        co_s = co_s + "," + str(_q.type_ann.dtype)
    if co_s != mong_s:
        raise TranspileError(
            f"bang dieu phoi cap module '{gname}': chu ky ham '{ten_ham}' "
            f"({co_s}) khong khop kieu gia tri khai bao ({mong_s})")
    params_il = ', '.join([_func_slot_il(p.type_ann, records) for p in callee.params])
    ret_il = _func_slot_il(callee.return_type, records) if callee.return_type is not None else 'void'
    return ['    ldnull',
            f'    ldftn {ret_il} {class_name}::{_il_ident(ten_ham)}({params_il})',
            f'    newobj instance void {_il_type_str(ta.elem_ta, records)}::.ctor(object, native int)']


def _table_init_lines(gname: "str", gdtype: "str", values: "list[list[str]]", class_name: "str",
                      func_table: "dict[str,TkvSig]"=None, records: "dict[str,list[(str,TkvTypeAnn)]]"=None) -> "list[str]":
    """IL dung mot BANG HANG cap module ('list[T]'/'set[T]') roi 'stsfld'.

    Goi tu _global_init_lines, tuc chay MOT LAN dau Main() truoc ham entry -
    cung cho, cung cach voi bien global vo huong (tranh '.cctor', xem
    docstring _global_init_lines)."""
    try:
        ta = _parse_type_ann_str(gdtype)
    except SyntaxError:
        ta = _parse_type_ann_str(gdtype, record_names=_ten_trong_kieu(gdtype))
    il_t = _il_type_str(ta, records)

    lines = [f'    newobj instance void {il_t}::.ctor()']
    if ta.shape_ten == 'dict' and ta.elem_ta is not None and ta.elem_ta.shape_ten == 'func':
        for hang in values:
            lines.append('    dup')
            lines.append(_bang_hang_push(ta.key_dtype, hang[0]))
            lines.extend(_bang_funcref_push(hang[1], class_name, func_table, gname, records, ta))
            lines.append(f'    callvirt instance void {il_t}::Add(!0, !1)')
    elif ta.shape_ten == 'dict' and ta.elem_ta is not None and ta.elem_ta.shape_ten == 'set':
        set_il = _il_type_str(ta.elem_ta, records)
        for hang in values:
            lines.append('    dup')
            lines.append(_bang_hang_push(ta.key_dtype, hang[0]))
            lines.append(f'    newobj instance void {set_il}::.ctor()')
            for e in hang[1:]:
                lines.append('    dup')
                lines.append(_bang_hang_push(ta.elem_ta.dtype, e))
                lines.append(f'    callvirt instance bool {set_il}::Add(!0)')
                lines.append('    pop')      # HashSet.Add tra bool
            lines.append(f'    callvirt instance void {il_t}::Add(!0, !1)')
    elif ta.shape_ten == 'dict' and ta.elem_ta is not None and ta.elem_ta.shape_ten == 'tuple':
        dts = ta.elem_ta.tuple_dtypes
        tup_il = _il_tupleN(dts, ta.elem_ta.tuple_tas, records)
        _ph = []
        _j = 0
        while _j < len(dts):
            _ph.append('!' + str(_j))
            _j += 1
        ctor = ', '.join(_ph)
        for hang in values:
            lines.append('    dup')
            lines.append(_bang_hang_push(ta.key_dtype, hang[0]))
            for dt, v in zip(dts, hang[1:]):
                lines.append(_bang_hang_push(dt, v))
            lines.append(f'    newobj instance void {tup_il}::.ctor({ctor})')
            lines.append(f'    callvirt instance void {il_t}::Add(!0, !1)')
    elif ta.shape_ten == 'dict':
        # Dictionary<K,V>::Add(!0, !1) tra void. PHAI dung SAU moi nhanh
        # 'dict' DAC BIET (func/set/tuple) - dieu kien cua no bao trum
        # chung, dat truoc thi chung thanh MA CHET va bang bi dung sai kieu
        # (da xay ra that: `ldstr "('int32', 'ReadInt32')"` nhet vao o
        # ValueTuple, assemble qua nhung AccessViolation luc chay).
        for hang in values:
            lines.append('    dup')
            lines.append(_bang_hang_push(ta.key_dtype, hang[0]))
            lines.append(_bang_hang_push(ta.dtype, hang[1]))
            lines.append(f'    callvirt instance void {il_t}::Add(!0, !1)')
    elif ta.shape_ten == 'list' and ta.elem_ta is not None and ta.elem_ta.shape_ten == 'tuple':
        dts = ta.elem_ta.tuple_dtypes
        tup_il = _il_tupleN(dts, ta.elem_ta.tuple_tas, records)
        _ph = []
        _j = 0
        while _j < len(dts):
            _ph.append('!' + str(_j))
            _j += 1
        ctor = ', '.join(_ph)
        for hang in values:
            lines.append('    dup')
            for dt, v in zip(dts, hang):
                lines.append(_bang_hang_push(dt, v))
            lines.append(f'    newobj instance void {tup_il}::.ctor({ctor})')
            lines.append(f'    callvirt instance void {il_t}::Add(!0)')
    else:
        add_ret = 'void' if ta.shape_ten == 'list' else 'bool'
        for hang in values:
            lines.append('    dup')
            lines.append(_bang_hang_push(ta.dtype, hang[0]))
            lines.append(f'    callvirt instance {add_ret} {il_t}::Add(!0)')
            if add_ret != 'void':
                lines.append('    pop')      # HashSet.Add tra bool - bo di
    lines.append(f"    stsfld {il_t} {class_name}::'{gname}'")
    return lines


def _global_init_lines(module_globals: "dict[str,(str,list[list[str]])]", class_name: "str", func_table: "dict[str,TkvSig]"=None, records: "dict[str,list[(str,TkvTypeAnn)]]"=None) -> "list[str]":
    """Sinh cac dong IL khoi tao TAT CA bien module-level GHI DUOC ('global',
    2026-08-11) - goi 1 LAN DUY NHAT dau Main(), TRUOC khi goi ham entry.
    Tranh dung '.cctor' (chua kiem chung trong codebase nay, cung tinh than
    ghi chu o il_features/logging_feature.py) - khoi tao TRUC TIEP trong
    than Main la duong da kiem chung an toan (giong cach CLI doc argv)."""
    lines = []
    for gname in (module_globals or {}):
        g_gt = module_globals[gname]
        gdtype = g_gt[0]
        if gdtype not in IL_SCALAR:
            # BANG HANG cap module (P6 buoc 2): dung container roi stsfld.
            # Moi phan tu la HANG SO nen sinh IL thang o day duoc, khong
            # can scope/ctx cua tang bieu thuc.
            lines.extend(_table_init_lines(gname, gdtype, g_gt[1], class_name,
                                           func_table=func_table, records=records))
            continue
        il_t = IL_SCALAR[gdtype]
        fname = "'" + gname + "'"
        gval = g_gt[1][0][0]
        if gdtype == 'str':
            lines.append(f'    ldstr "{_thoat_ldstr(gval)}"')
        else:
            lines.append(f'    {IL_LDC_OP[gdtype]} {gval}')
        lines.append(f'    stsfld {il_t} {class_name}::{fname}')
    return lines


def _build_main_tuple(sig: "TkvSig", class_name: "str", body: "list[str]", module_globals: "dict[str,(str,list[list[str]])]"=None,
                      func_table: "dict[str,TkvSig]"=None, records: "dict[str,list[(str,TkvTypeAnn)]]"=None) -> "list[str]":
    """Phan duoi cua build_generic_main cho ham tra ValueTuple: doc tung
    ItemN qua get_ItemN (System.Tuple, 2026-09-26) - phan tu value type cat vao
    local tam roi lay DIA CHI de goi ToString - roi noi thanh '(a, b)'."""
    dtypes = sig.return_type.tuple_dtypes
    tup_il = il_type_str(sig.return_type)
    body.append('    stloc.0')
    body.append('    ldstr "("')
    i = 0
    for d in dtypes:
        i += 1
        if i > 1:
            body.append('    ldstr ", "')
            body.append('    call string [mscorlib]System.String::Concat(string, string)')
        # Kieu cua field PHAI ghi bang PLACEHOLDER generic ('!0', '!1'...)
        # chu KHONG phai kieu da the the ('int32') - neu khong, CLR bao
        # MissingFieldException LUC CHAY (da gap that o day). Cung quy uoc
        # voi '!0' cua List::get_Item o cac module khac.
        if d == 'str':
            body.append('    ldloc.0')
            body.append(f'    callvirt instance !{i - 1} {tup_il}::get_Item{i}()')
        else:
            # System.Tuple (2026-09-26): doc qua get_ItemN, cat vao local tam
            # CUNG kieu roi lay DIA CHI (ToString tren value type can dia chi).
            body.append('    ldloc.0')
            body.append(f'    callvirt instance !{i - 1} {tup_il}::get_Item{i}()')
            body.append(f'    stloc __cli_t_{d}')
            body.append(f'    ldloca __cli_t_{d}')
            for op in _cli_print_seq(d):
                body.append('    ' + op)
            if d in ('f32', 'f64'):
                body.append('    dup')
                body.append('    ldstr "."')
                body.append('    callvirt instance bool [mscorlib]System.String::Contains(string)')
                body.append(f'    brtrue cli_tup{i}_hasdot')
                body.append('    ldstr ".0"')
                body.append('    call string [mscorlib]System.String::Concat(string, string)')
                body.append(f'    br cli_tup{i}_end')
                body.append(f'  cli_tup{i}_hasdot:')
                body.append(f'  cli_tup{i}_end:')
        body.append('    call string [mscorlib]System.String::Concat(string, string)')
    body.append('    ldstr ")"')
    body.append('    call string [mscorlib]System.String::Concat(string, string)')
    body.append('    call void [mscorlib]System.Console::WriteLine(string)')
    body.append('    ret')
    method = [
        '  .method public static void Main(string[] args) cil managed',
        '  {',
        '    .entrypoint',
        '    .maxstack 8',
        f'    .locals init ({tup_il} __cli_ret, int32 __cli_t_i32, int64 __cli_t_i64, '
        f'float32 __cli_t_f32, float64 __cli_t_f64)',
    ]
    method += _global_init_lines(module_globals, class_name,
                                 func_table=func_table, records=records)
    method += body
    method.append('  }')
    return method



def _cli_default_literal(param: "Param", sig: "TkvSig") -> "str":
    """1 lenh IL day GIA TRI MAC DINH cua 1 tham so len stack (2026-08-03).
    CHI nhan hang so/chuoi - bieu thuc mac dinh phuc tap thi bao loi RO
    RANG thay vi sinh ma sai."""
    node = param.default_node
    dtype = param.type_ann.dtype
    if ekind(node) == 'str_lit' and dtype == 'str':
        return f'ldstr {ea_str(node)}'
    if ekind(node) == 'num' and dtype in IL_LDC_OP:
        return f'{IL_LDC_OP[dtype]} {ea_str(node)}'
    if (ekind(node) == 'neg' and ekind(ea_nut(node)) == 'num'
            and dtype in IL_LDC_OP):
        return f'{IL_LDC_OP[dtype]} -{ea_str(ea_nut(node))}'
    raise CliError(
        f"tkv build: tham so '{param.name}' cua ham '{sig.name}' co gia tri mac dinh "
        f"khong phai hang so don gian - CLI tu dong chi day duoc hang so/chuoi. "
        f"Truyen du doi so khi chay, hoac doi mac dinh thanh 1 hang.")


def build_generic_main(sig: "TkvSig", class_name: "str", module_globals: "dict[str,(str,list[list[str]])]"=None,
                       func_table: "dict[str,TkvSig]"=None, records: "dict[str,list[(str,TkvTypeAnn)]]"=None) -> "list[str]":
    """Sinh 1 method Main(string[] args) TU DONG cho ham entry `sig`: doc
    N tham so vo huong tu argv THEO DUNG THU TU tham so (parse dung dtype,
    InvariantCulture cho f32/f64 - xem bug locale that da sua o Buoc 1-3),
    goi ham, in ket qua ra stdout."""
    for p in sig.params:
        if not p.type_ann.la_vo_huong() or p.type_ann.dtype not in _CLI_DTYPES:
            raise CliError(
                f"tkv build: tham so '{p.name}' cua ham '{sig.name}' co "
                f"dtype={p.type_ann.dtype!r} shape={p.type_ann.shape_repr()} - CLI tu "
                f"dong hien CHI ho tro tham so VO HUONG (i32/i64/f32/f64/str), "
                f"khong ho tro mang/list/dict (argv la chuoi phang, chua co quy "
                f"uoc serialize container).")
    if sig.return_type is None:
        raise CliError(
            f"tkv build: ham '{sig.name}' khong co return type - CLI tu dong "
            f"can in ket qua nen ham entry BAT BUOC phai return gia tri.")
    is_tuple_ret = sig.return_type.shape_ten == 'tuple'
    if is_tuple_ret:
        bad = [d for d in sig.return_type.tuple_dtypes if d not in _CLI_DTYPES]
        if bad:
            raise CliError(
                f"tkv build: ham '{sig.name}' tra tuple co phan tu kieu {bad} - CLI tu "
                f"dong chi in duoc phan tu VO HUONG (i32/i64/f32/f64/str).")
    elif not sig.return_type.la_vo_huong() or sig.return_type.dtype not in _CLI_DTYPES:
        raise CliError(
            f"tkv build: ham '{sig.name}' return dtype={sig.return_type.dtype!r} "
            f"shape={sig.return_type.shape_repr()} - CLI tu dong hien CHI ho tro "
            f"return VO HUONG (i32/i64/f32/f64/str) hoac tuple cac gia tri vo huong.")

    body = []
    for i, p in enumerate(sig.params):
        if p.default_node < 0:
            body.append('    ldarg.0')
            body.append(f'    ldc.i4 {i}')
            body.append('    ldelem.ref')
            for op in _cli_parse_seq(p.type_ann.dtype):
                body.append('    ' + op)
            continue
        # Tham so CO GIA TRI MAC DINH (2026-08-03): truoc day Main van doc
        # thang argv[i] -> chay 'ham.exe 4' cho ham f(a, b=3) nem
        # IndexOutOfRangeException kho hieu (bug THAT tim ra bang
        # scratch/probe_runtime.py). Nay: thieu doi so thi dung mac dinh.
        default_il = _cli_default_literal(p, sig)
        miss_lbl = f'cli_def{i}_miss'
        done_lbl = f'cli_def{i}_done'
        body.append('    ldarg.0')
        body.append('    ldlen')
        body.append('    conv.i4')
        body.append(f'    ldc.i4 {i}')
        body.append(f'    ble {miss_lbl}')
        body.append('    ldarg.0')
        body.append(f'    ldc.i4 {i}')
        body.append('    ldelem.ref')
        for op in _cli_parse_seq(p.type_ann.dtype):
            body.append('    ' + op)
        body.append(f'    br {done_lbl}')
        body.append(f'  {miss_lbl}:')
        body.append(f'    {default_il}')
        body.append(f'  {done_lbl}:')

    params_il = ', '.join([il_type_str(p.type_ann) for p in sig.params])
    ret_il = il_type_str(sig.return_type)
    # Ten ham cung phai boc nhay don (2026-08-03): 'flags' la tu khoa
    # ILASM - 1 ham ten do lam ca file khong assemble duoc. Xem
    # _il_ident trong il_codegen.py (cung ly do, o vi tri goi).
    body.append(f"    call {ret_il} {class_name}::'{sig.name}'({params_il})")

    if is_tuple_ret:
        # Ham tra TUPLE lam entry CLI (2026-08-03): in ra dang '(a, b)' -
        # dung het cua Python de doi chieu duoc THANG. Truoc day bi tu
        # choi hoan toan, du tuple dung NOI BO van chay tot.
        return _build_main_tuple(sig, class_name, body, module_globals=module_globals,
                                 func_table=func_table, records=records)

    ret_dtype = sig.return_type.dtype
    if ret_dtype == 'str':
        body.append('    call void [mscorlib]System.Console::WriteLine(string)')
        locals_decl = ''
    else:
        # Can DIA CHI (khong the lay dia chi 1 gia tri TAM tren stack) de
        # goi ToString() - instance method tren value type - cung ly do da
        # ap dung cho str() builtin trong il_codegen.py.
        body.append('    stloc.0')
        body.append('    ldloca.s 0')
        for op in _cli_print_seq(ret_dtype):
            body.append('    ' + op)
        if ret_dtype in ('f32', 'f64'):
            # BUG THAT tim thay qua chinh test CLI moi (sample_cli_smoke2.tkv,
            # scale_f32(3.5, 2.0) in ra "7" thay vi "7.0") - CUNG 1 loi
            # locale/format da sua truoc do trong str() builtin cua
            # il_codegen.py (Single/Double.ToString() bo dau cham cho so
            # tron) nhung quen ap dung lai o day - vong lap "them dau .0
            # neu thieu" giong het pattern da xac minh.
            body.append('    dup')
            body.append('    ldstr "."')
            body.append('    callvirt instance bool [mscorlib]System.String::Contains(string)')
            body.append('    brtrue cli_ret_hasdot')
            body.append('    ldstr ".0"')
            body.append('    call string [mscorlib]System.String::Concat(string, string)')
            body.append('    br cli_ret_end')
            body.append('  cli_ret_hasdot:')
            body.append('  cli_ret_end:')
        body.append('    call void [mscorlib]System.Console::WriteLine(string)')
        locals_decl = ret_il
    body.append('    ret')

    method = [
        '  .method public static void Main(string[] args) cil managed',
        '  {',
        '    .entrypoint',
        '    .maxstack 8',
    ]
    if locals_decl:
        method.append(f'    .locals init ({locals_decl} __cli_ret)')
    method += _global_init_lines(module_globals, class_name,
                                 func_table=func_table, records=records)
    method += body
    method.append('  }')
    return method


def _compute_record_overrides(record_bases: "dict[str,list[str]]", record_methods: "dict[str,dict[str,Signature]]") -> "dict[str,set[str]]":
    """B1 (2026-07-29): tra ve dict ten-record -> set ten-method DA xuat
    hien o BAT KY to tien nao (base/base-cua-base...) - dung de
    gen_record_types() quyet dinh 'virtual' (override, method da co slot
    tu to tien) vs 'newslot virtual' (lan dau xuat hien, mo slot moi) cho
    method RIENG cua record do. record_methods: {ten-record: {ten-method:
    Signature}} (tu _build_record_methods) - CHI method RIENG (khong lap
    lai method ke thua), nen di CA chuoi to tien la du (khong bi dem
    trung method cua chinh no)."""
    overrides = {}
    for name in record_methods:
        seen = set()
        visited: "set[str]" = set()
        queue = []
        queue.extend(cac_base(record_bases, name))
        while queue:
            cur = queue.pop(0)
            if cur in visited:
                continue
            visited.add(cur)
            if cur in record_methods:
                for _k in record_methods[cur]:
                    seen.add(_k)
            queue.extend(cac_base(record_bases, cur))
        overrides[name] = seen
    return overrides


def compile_tkv_cli(tkv_path: "str", out_exe: "str", entry_name: "str"=None, class_name: "str"='TKVApp', debug: "i32"=False,
                     reg: "Registry"=None) -> "str":
    """Bien dich 1 file `.tkv` THAT thanh `.exe` GOI DUOC TU DONG LENH
    TRUC TIEP (tu dong sinh Main(), khong can tu tay viet IL nhu moi vi
    du truoc day trong session) - argv[0..] anh xa THEO THU TU tham so
    cua ham entry, in ket qua ra stdout.

    entry_name=None: neu file chi co 1 ham, dung ham do; neu nhieu ham,
    can co 1 ham ten 'main' hoac phai truyen entry_name ro rang. Ho tro
    '__tkv_import__' (khoang trong ngon ngu #3) qua extract_program_file -
    entry_name co the la ham dinh nghia trong file IMPORT, khong chi file
    goc (func_table gop CA HAI)."""
    # P6 chang 1c: MOI luot bien dich co bo bang dieu phoi RIENG. Caller
    # co the truyen `reg` de TU KIEM TRA nhung gi luot do dang ky
    # (cac test extern lam vay) - mac dinh la mot bo moi tinh.
    if reg is None:
        reg = _fresh_registry()
    _ct = extract_program_file(tkv_path)
    record_defs = _ct.record_defs
    record_methods_raw = _ct.record_methods_raw
    record_bases = _ct.record_bases
    record_interfaces = _ct.record_interfaces
    interface_defs = _ct.interface_defs
    pairs = _ct.pairs
    extern_assemblies = _ct.extern_assemblies
    extern_methods = _ct.extern_methods
    extern_pinvokes = _ct.extern_pinvokes
    extern_classes = _ct.extern_classes
    module_consts = _ct.module_consts
    module_globals = _ct.module_globals
    inferred_ast_nodes_by_func = _ct.inferred_ast_nodes_by_func
    record_init_sigs = _ct.record_init_sigs
    record_init_bodies = _ct.record_init_bodies

    # Task 2 (extern-class, 2026-08-18): extern_class_defs (ten handle-type
    # -> decl dict goc {'name','assembly','class','ctor','methods'}) - dung
    # boi il_type_str (qua bien module-level _EXTERN_CLASS_DEFS, xem finally
    # -pop duoi) va boi parse_typed_signature/parse_type_ann_str (qua
    # extern_class_names, tap TEN don thuan) de chap nhan Sb lam dtype
    # tham so/return/field. Trung ten giua CAC entry CUNG 1 pragma da duoc
    # Task 1's _parse_extern_class_dict_literal xac nhan KHONG can validate
    # them o day (parse shape khong kiem trung - kiem o day, truoc khi
    # dung lam dict-key, de bao loi ro rang thay vi entry sau am tham de
    # len entry truoc).
    extern_class_defs = {}
    for _decl in extern_classes:
        if _decl.name in extern_class_defs:
            raise TranspileError(
                f"__tkv_extern_class__: ten {_decl.name!r} khai bao TRUNG LAP "
                f"trong cung 1 pragma")
        extern_class_defs[_decl.name] = _nap_mot_extern_class(_decl)
    extern_class_names = _khoa_thanh_tap(extern_class_defs)

    # Xem ghi chu cung loai o `_transpile_extracted` - day la duong vao
    # THU HAI cua "mot chuong trinh".
    reset_pool_bieu_thuc()
    # 2026-09-29: `__init__` noi duoc vao `.ctor` (it tham so, dung thu tu,
    # dung kieu so voi danh sach field vo huong) -> LOAI no khoi bang method,
    # vi `.ctor` se chay than no. Nguoc lai giu nguyen: `_expr_call` tao
    # `.ctor` rong roi goi `__init__` that nhu truoc day. Xem
    # il_codegen._init_noi_vao_ctor / _ctor_init_body_il.
    ds_noi_vao_ctor: "list[str]" = []
    for _rname in record_init_sigs:
        if il_codegen._init_noi_vao_ctor(_rname, record_init_sigs[_rname], record_defs, record_bases):
            ds_noi_vao_ctor.append(_rname)
    init_sigs_noi: "dict[str,str]" = {}
    init_bodies_noi: "dict[str,list[str]]" = {}
    for _rname in ds_noi_vao_ctor:
        init_sigs_noi[_rname] = record_init_sigs[_rname]
        init_bodies_noi[_rname] = record_init_bodies[_rname]
        _mr_moi: "list[(str,list[str],i32)]" = []
        for _sig_line, _body_lines, _is_static in record_methods_raw[_rname]:
            if _ten_truoc_ngoac(_sig_line) != '__init__':
                _mr_moi.append((_sig_line, _body_lines, _is_static))
        record_methods_raw[_rname] = _mr_moi
    record_methods, record_method_bodies, record_methods_own = _build_record_methods(
        record_defs, record_methods_raw, record_bases=record_bases,
        extern_class_names=extern_class_names)
    record_overrides = _compute_record_overrides(record_bases, record_methods)
    sig_body_pairs = _build_sig_body_pairs(pairs, record_defs, record_methods,
                                            inferred_ast_nodes_by_func,
                                            extern_class_names=extern_class_names)
    func_table = {sig.name: sig for sig, _, _start in sig_body_pairs}

    if entry_name is None:
        if len(sig_body_pairs) == 1:
            entry_name = sig_body_pairs[0][0].name
        elif 'main' in func_table:
            entry_name = 'main'
        else:
            ten_ham_ds: "list[str]" = []
            for ten_ham in func_table:
                ten_ham_ds.append(ten_ham)
            raise CliError(
                f"tkv build: file co {len(sig_body_pairs)} ham ({', '.join(ten_ham_ds)}), "
                f"khong ro entry point nao - dat ten 1 ham la 'main' hoac chi ro entry_name.")
    if entry_name not in func_table:
        raise CliError(f"tkv build: khong tim thay ham entry '{entry_name}' trong {tkv_path}")

    # Task 3 (2026-08-14, __tkv_extern_method__): dang ky dong CAC builtin
    # extern method NGAY TRUOC gen_il_program (de dung duoc TRONG CUNG luot
    # compile nay) - declared_assembly_names gop ten cac assembly da khai
    # bao qua __tkv_extern_assembly__ (extern_assemblies LUON la list tuple
    # 3 phan tu (ten, pubkeytoken_or_'DEFAULT'_or_None, version_or_'DEFAULT'
    # _or_None) - xem Task 1's dieu tra) voi 3 assembly mac dinh luon co san.
    # try/finally BOC TOAN BO phan con lai cua ham (khong chi gen_il_program)
    # - EXPR_BUILTIN_CODEGEN/EXPR_BUILTIN_DTYPE la dict CAP MODULE, khong tu
    # reset giua 2 lan goi compile_tkv_cli trong CUNG process; bat cu
    # exception nao giua chung (ilasm loi, gen_il_program loi...) van phai
    # trigger pop, neu khong "ro ri" sang lan compile file khac tiep theo.
    declared_assembly_names = _sao_tap(_DEFAULT_GAC_ASSEMBLIES)
    for asm_name, _pkt, _ver in extern_assemblies:
        declared_assembly_names.add(asm_name)

    # Task 3 (extern-class, 2026-08-18): validate MOI entry extern_classes
    # TRUOC khi dung lam dict-key/dang ky (extern_class_defs da build o
    # tren, nhung CHUA validate noi dung - chi Task 1 xac nhan trung ten
    # CUNG pragma). TAI DUNG regex/helper da co san cho __tkv_extern_method__
    # (_EXTERN_ASSEMBLY_NAME_RE khong dung o day vi 'class' o day validate
    # rieng qua regex ten class .NET - _EXTERN_CLASS_NAME_RE da co san, xem
    # _validate_and_register_extern_method) thay vi viet lai logic.
    for _decl in extern_classes:
        if not _la_dinh_danh(_decl.name):
            raise TranspileError(
                f"__tkv_extern_class__: 'name' {_decl.name!r} khong phai identifier hop le")
        if _decl.name in reg.expr_builtin_codegen or _decl.name in record_defs:
            raise ValueError(
                f"__tkv_extern_class__: ten {_decl.name!r} DA duoc dang ky truoc do "
                f"(trung voi builtin hoac record co san) - doi ten khac")
        if _decl.assembly not in declared_assembly_names:
            raise TranspileError(
                f"__tkv_extern_class__: assembly {_decl.assembly!r} chua duoc khai qua "
                f"__tkv_extern_assembly__ - cac assembly da biet: {sorted(declared_assembly_names)}")
        if not _EXTERN_CLASS_NAME_RE.match(_decl.lop_clr):
            raise TranspileError(
                f"__tkv_extern_class__: 'class' {_decl.lop_clr!r} khong dung dinh dang ten "
                f"class .NET hop le (vd 'System.Text.StringBuilder')")
        for _pdtype in _decl.ctor:
            if not _is_valid_extern_dtype(_pdtype) and _pdtype not in extern_class_defs:
                if not _validate_extern_class_container_dtype(
                        _pdtype, extern_class_defs, f"'ctor' cua {_decl.name!r}"):
                    raise TranspileError(
                        f"__tkv_extern_class__: 'ctor' cua {_decl.name!r} dung dtype "
                        f"{_pdtype!r} khong ho tro (chi {sorted(_EXTERN_DTYPE_TO_IL)} hoac 1 "
                        f"handle type da khai trong CUNG pragma)")

    # Task 4 (extern-class, 2026-08-18): validate MOI method cua MOI decl -
    # CUNG vong lap voi validate ctor o tren de nhat quan, nhung tach RIENG
    # (khong gop 1 vong for) vi kiem tra dup ten method la THEO TUNG decl
    # (1 decl khong duoc khai 2 method trung ten), khac han kiem tra dup
    # 'name' cua decl (theo TOAN BO extern_classes, da lam o Task 1).
    for _decl in extern_classes:
        _seen_method_names = set()
        for _m in _decl.methods:
            if _m.name in _seen_method_names:
                raise TranspileError(
                    f"__tkv_extern_class__: method {_m.name!r} khai TRUNG LAP "
                    f"trong {_decl.name!r}")
            _seen_method_names.add(_m.name)
            if not _EXTERN_METHOD_NAME_RE.match(_m.name):
                raise TranspileError(
                    f"__tkv_extern_class__: method name {_m.name!r} sai dinh dang")
            for _pdtype in _m.params:
                if not _is_valid_extern_dtype(_pdtype) and _pdtype not in extern_class_defs:
                    if not _validate_extern_class_container_dtype(
                            _pdtype, extern_class_defs,
                            f"method {_m.name!r} cua {_decl.name!r}"):
                        raise TranspileError(
                            f"__tkv_extern_class__: method {_m.name!r} cua {_decl.name!r} "
                            f"dung dtype tham so {_pdtype!r} khong ho tro (chi "
                            f"{sorted(_EXTERN_DTYPE_TO_IL)} hoac 1 handle type da khai trong "
                            f"CUNG pragma)")
            # Phase 9a mo rong (2026-08-24): 'returns':'void' CHO PHEP -
            # xem _make_extern_class_method_void_codegen (dispatch rieng,
            # KHONG dung chung _make_extern_class_method_codegen vi ham do
            # goi il_codegen._il_ctor_param_type('void',...) se KeyError
            # (IL_SCALAR khong co khoa 'void') roi widen_if_needed VO DIEU
            # KIEN nhu co gia tri tren stack - SAI cho callvirt void. Nhanh
            # nay CHI CON kiem tra dtype thuoc extern_class_defs neu can -
            # 'void' khong nam trong _EXTERN_DTYPE_TO_IL/extern_class_defs
            # nen phai tach RIENG truoc nhanh do (xem duoi).
            if _m.returns != 'void' and not _is_valid_extern_dtype(_m.returns) and _m.returns not in extern_class_defs:
                if not _validate_extern_class_container_dtype(
                        _m.returns, extern_class_defs,
                        f"method {_m.name!r} cua {_decl.name!r}"):
                    raise TranspileError(
                        f"__tkv_extern_class__: method {_m.name!r} cua {_decl.name!r} "
                        f"returns {_m.returns!r} khong ho tro (chi {sorted(_EXTERN_DTYPE_TO_IL)} "
                        f"hoac 1 handle type da khai trong CUNG pragma)")

    # Task 2 (Phase 9d Part A, 2026-08-26, static_methods): validate MOI
    # entry 'static_methods' cua MOI decl - CUNG cau truc voi vong lap
    # validate 'methods' o tren (tai dung y het _EXTERN_METHOD_NAME_RE,
    # _is_valid_extern_dtype, _validate_extern_class_container_dtype cho
    # tung tham so/return), CHI KHAC 1 diem quan trong ve pham vi dedup:
    #
    # __tkv_extern_method__ dung 1 tap `seen_static_names` TOAN CUC (ca file)
    # de dedup ten static method, vi CAC static method do duoc dang ky thanh
    # 1 ham top-level DUY NHAT trong khong gian ten global cua chuong trinh
    # (khong co "class" nao gan/phan tach chung). Nguoc lai, static_methods
    # o day thuoc VE 1 class (goi qua `ClassName.Method()` - xem Task 3/4 se
    # lam codegen), nen 2 class KHAC nhau hoan toan duoc phep dung CHUNG 1
    # ten static method (vd ca System.Text.StringBuilder va System.String
    # deu co the co static method "Foo" ma khong xung dot) - dedup CHI can
    # THEO TUNG decl (per-class), giong het cach 'methods' dedup theo tung
    # decl (_seen_method_names o vong lap tren), KHONG phai global nhu
    # __tkv_extern_method__'s seen_static_names.
    #
    # Rieng TRONG CUNG 1 class, static method KHONG duoc trung ten voi
    # instance method (methods) CUNG class do - vi ca hai deu se anh xa
    # thanh 1 "pseudo-method-name" tren cung class trong codegen sau nay
    # (Task 3/4), tranh nham lan goi tinh vs goi qua instance.
    for _decl in extern_classes:
        _seen_method_names = set([m.name for m in _decl.methods])
        # M5 (final review Phase 9d Part A, 2026-08-26): check trung ten o
        # tren CHI so voi 'methods' (instance), thieu 'properties' cua CHINH
        # class - _render() hien KHONG tung sinh 'properties' nen rui ro
        # THAP trong thuc te, nhung 1 pragma viet tay van co the khai
        # 'properties' + 'static_methods' trung ten ma khong bi chan o day
        # (defense-in-depth, cung ly do voi check 'methods' o duoi).
        _seen_property_names = set([p.name for p in _decl.properties])
        _seen_static_method_names = set()
        for _m in _decl.static_methods:
            if _m.name in _seen_static_method_names:
                raise TranspileError(
                    f"__tkv_extern_class__: static method {_m.name!r} khai TRUNG LAP "
                    f"trong {_decl.name!r}")
            _seen_static_method_names.add(_m.name)
            if _m.name in _seen_method_names:
                raise TranspileError(
                    f"__tkv_extern_class__: static method {_m.name!r} cua {_decl.name!r} "
                    f"TRUNG TEN voi 1 method (instance) DA khai trong 'methods' cua CHINH class "
                    f"nay - doi ten khac")
            if _m.name in _seen_property_names:
                raise TranspileError(
                    f"__tkv_extern_class__: static method {_m.name!r} cua {_decl.name!r} "
                    f"TRUNG TEN voi 1 property DA khai trong 'properties' cua CHINH class nay - "
                    f"doi ten khac")
            if not _EXTERN_METHOD_NAME_RE.match(_m.name):
                raise TranspileError(
                    f"__tkv_extern_class__: static method name {_m.name!r} sai dinh dang")
            for _pdtype in _m.params:
                if not _is_valid_extern_dtype(_pdtype) and _pdtype not in extern_class_defs:
                    if not _validate_extern_class_container_dtype(
                            _pdtype, extern_class_defs,
                            f"static method {_m.name!r} cua {_decl.name!r}"):
                        raise TranspileError(
                            f"__tkv_extern_class__: static method {_m.name!r} cua {_decl.name!r} "
                            f"dung dtype tham so {_pdtype!r} khong ho tro (chi "
                            f"{sorted(_EXTERN_DTYPE_TO_IL)} hoac 1 handle type da khai trong "
                            f"CUNG pragma)")
            if _m.returns != 'void' and not _is_valid_extern_dtype(_m.returns) and _m.returns not in extern_class_defs:
                if not _validate_extern_class_container_dtype(
                        _m.returns, extern_class_defs,
                        f"static method {_m.name!r} cua {_decl.name!r}"):
                    raise TranspileError(
                        f"__tkv_extern_class__: static method {_m.name!r} cua {_decl.name!r} "
                        f"returns {_m.returns!r} khong ho tro (chi {sorted(_EXTERN_DTYPE_TO_IL)} "
                        f"hoac 1 handle type da khai trong CUNG pragma)")

    # SUA CRITICAL 2-cua-fix (2026-08-24, re-review sau Critical 1/2): kiem
    # tra NHAT QUAN void-ness giua CAC decl KHAC NHAU cung khai 1 ten method
    # phai chay o day - TRUOC vong lap dang ky EXPR_METHOD_CODEGEN ben duoi -
    # va CHI dung du lieu decl da parse (_m.returns), KHONG dung trang
    # thai dang ky nao ca. Ly do: ban truoc dat check nay BEN TRONG vong lap
    # dang ky (dan xen voi register_expr_method) nen khi phat hien lech va
    # raise TranspileError, vong lap da dang ky XONG 1 vai method truoc do
    # vao EXPR_METHOD_CODEGEN (module-level dict) roi moi raise - dang ky do
    # KHONG duoc don don vi finally-cleanup cua compile_tkv_cli chi pop
    # nhung ten da nam trong registered_extern_class_method_names, ma vong
    # lap bi abort giua chung nen list nay dung nhung con thieu cac ten SAU
    # diem raise van co the da dang ky mot phan - ket qua: 1 factory "mo coi"
    # con lai trong EXPR_METHOD_CODEGEN sang lan compile_tkv_cli() KE TIEP
    # trong CUNG process, khien 1 chuong trinh HOAN TOAN hop le nhung tinh
    # co dung lai dung ten method do "thua ke" nham factory cu. Gom check
    # nay thanh 1 pass RIENG, chay TRUOC moi register_expr_method, dam bao
    # neu raise thi CHUA co gi duoc dang ky - khong con gi de don don.
    _extern_class_method_void_by_name: "dict[str,i32]" = {}
    for _decl in extern_classes:
        for _m in _decl.methods:
            _mname = _m.name
            _is_void = 0
            if _m.returns == 'void':
                _is_void = 1
            if _mname in _extern_class_method_void_by_name and _extern_class_method_void_by_name[_mname] != _is_void:
                raise TranspileError(
                    f"__tkv_extern_class__: method {_mname!r} da duoc khai "
                    f"voi kieu tra ve KHAC (void vs co gia tri) tu 1 extern-class "
                    f"khac trong cung file ({_decl.name!r} khai "
                    f"'returns': {_m.returns!r}) - phai NHAT QUAN void hoac "
                    f"co gia tri cho MOI class khai method cung ten {_mname!r}")
            _extern_class_method_void_by_name[_mname] = _is_void

    # Task 1 (extern-class-property, 2026-08-18): validate MOI property cua
    # MOI decl - dup ten property (theo TUNG decl), dinh dang ten, dtype hop
    # le, va collision guard voi pseudo-method get_X/set_X ma Task 2/3 se
    # dang ky - phai kiem tra o day (truoc khi dang ky EXPR_METHOD_CODEGEN)
    # de bat loi som, tranh dang ky trung ten method THAT.
    for _decl in extern_classes:
        _seen_method_names = set([m.name for m in _decl.methods])
        _seen_prop_names = set()
        for _p in _decl.properties:
            if _p.name in _seen_prop_names:
                raise TranspileError(
                    f"__tkv_extern_class__: property {_p.name!r} khai TRUNG LAP "
                    f"trong {_decl.name!r}")
            _seen_prop_names.add(_p.name)
            if not re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', _p.name):
                raise TranspileError(f"__tkv_extern_class__: property name {_p.name!r} sai dinh dang")
            if not _is_valid_extern_dtype(_p.dtype) and _p.dtype not in extern_class_defs:
                if not _validate_extern_class_container_dtype(
                        _p.dtype, extern_class_defs,
                        f"property {_p.name!r} cua {_decl.name!r}"):
                    raise TranspileError(
                        f"__tkv_extern_class__: property {_p.name!r} cua {_decl.name!r} "
                        f"dung dtype {_p.dtype!r} khong ho tro")
            _get_name = f"get_{_p.name}"
            _set_name = f"set_{_p.name}"
            if _get_name in _seen_method_names or _set_name in _seen_method_names:
                raise TranspileError(
                    f"__tkv_extern_class__: property {_p.name!r} cua {_decl.name!r} "
                    f"sinh ten pseudo-method {_get_name!r}/{_set_name!r} TRUNG voi 1 method "
                    f"THAT da khai trong 'methods' - doi ten method hoac property")

    registered_extern_names = []
    pinvoke_decl_lines = []
    registered_pinvoke_names = []
    # Task 4 (extern-class, 2026-08-18): dang ky dong method - khoa THAT SU
    # trong EXPR_METHOD_CODEGEN chi la ('extern_class', method_name) (xem
    # ghi chu lon o _make_extern_class_method_codegen), nen dang ky
    # IDEMPOTENT theo method_name (bo qua neu method_name nay DA duoc dang
    # ky boi 1 decl khac TRONG CUNG lan compile - closure tu phan giai
    # dung class luc goi qua obj_ta.dtype, khong can dang ky lai).
    #
    # SUA CRITICAL 2 (2026-08-24, final review Phase 9a): idempotent-theo-
    # ten CHI an toan khi CA HAI decl dung CHUNG 1 cap factory/dispatch,
    # tuc CUNG void-ness. Kiem tra NHAT QUAN void-ness gio da chuyen thanh
    # 1 pass RIENG chay TRUOC vong lap nay (xem block _extern_class_method_
    # void_by_name o tren, canh vong lap validate method) - dam bao neu co
    # lech void/co-gia-tri giua 2 decl thi raise TranspileError TRUOC KHI
    # bat ky register_expr_method nao chay, nen vong lap dang ky nay khong
    # con can theo doi void-ness nua, chi con idempotent don gian theo ten.
    registered_extern_class_method_names = []
    for _decl in extern_classes:
        for _m in _decl.methods:
            _mname = _m.name
            _key = khoa_method('extern_class', _mname)
            if _key in reg.expr_method_codegen:
                continue
            if _m.returns == 'void':
                # Phase 9a: khong dung return_ta_fn (khong co gia tri de
                # suy TypeAnn) - dang ky voi return_dtype=None, KHONG
                # result_shape (result_shape bat buoc di kem return_ta_fn,
                # xem register_expr_method's docstring). _stmt_method_call_stmt
                # (il_codegen.py) se tu nhan ra qua EXPR_METHOD_DTYPE
                # tra ve None + khong tim thay trong EXPR_METHOD_SHAPE de
                # QUYET dinh khong 'pop' (xem Step 6 file nay).
                register_expr_method(reg, 
                    'extern_class', _mname,
                    _make_extern_class_method_void_codegen(_mname))
            else:
                register_expr_method(reg, 
                    'extern_class', _mname,
                    _make_extern_class_method_codegen(_mname),
                    return_ta_fn=_make_extern_class_method_return_ta(_mname),
                    result_shape='extern_class')
            registered_extern_class_method_names.append(_mname)
    # Task 2 (extern-class-property, 2026-08-18): dang ky dong getter
    # 'get_X' cho MOI property khai trong 'properties' - dung LAI CHINH
    # _make_extern_class_method_codegen/_make_extern_class_method_return_ta
    # (khong can factory rieng, xem sua _extern_class_method_lookup o tren
    # de no tu tong hop method-dict gia cho 'get_X'). Idempotent theo
    # method_name giong vong lap methods o tren (2 extern-class khac nhau
    # cung ten property la hop le).
    registered_extern_class_property_names = []
    for _decl in extern_classes:
        for _p in _decl.properties:
            _getter_name = f"get_{_p.name}"
            _getter_key = khoa_method('extern_class', _getter_name)
            if _getter_key in reg.expr_method_codegen:
                continue
            register_expr_method(reg, 
                'extern_class', _getter_name,
                _make_extern_class_method_codegen(_getter_name),
                return_ta_fn=_make_extern_class_method_return_ta(_getter_name),
                result_shape='extern_class')
            registered_extern_class_property_names.append(_getter_name)
            # Task 3 (extern-class-property, 2026-08-18): dang ky them
            # setter 'set_X' CHI KHI property khai readonly=False - dung
            # factory rieng _make_extern_class_property_setter_codegen
            # (void-safe, xem docstring cua no). Idempotent theo
            # method_name giong het getter, gop chung 1 list
            # registered_extern_class_property_names de finally-pop duoi
            # don CA HAI khong can code rieng.
            if not _p.readonly:
                _setter_name = f"set_{_p.name}"
                _setter_key = khoa_method('extern_class', _setter_name)
                if _setter_key not in reg.expr_method_codegen:
                    register_expr_method(reg, 
                        'extern_class', _setter_name,
                        _make_extern_class_property_setter_codegen(_setter_name),
                        return_ta_fn=None,
                        result_shape=None)
                    registered_extern_class_property_names.append(_setter_name)
    # Task 2 (extern-class, 2026-08-18): set bien module-level TAM THOI cua
    # il_codegen.py's il_type_str NGAY TRUOC gen_il_program (CUNG try/finally
    # voi EXPR_BUILTIN_CODEGEN/EXPR_BUILTIN_DTYPE o duoi) - xem giai thich
    # day du tai il_codegen.py's _EXTERN_CLASS_DEFS docstring.
    il_extern_dtype.dat_bang_extern_class(extern_class_defs)
    try:
        for decl in extern_methods:
            _validate_and_register_extern_method(reg, decl, declared_assembly_names)
            registered_extern_names.append(decl.name)

        # Task 3 (2026-08-17, __tkv_extern_pinvoke__): dang ky dong CAC
        # builtin pinvoke - CUNG khoi try/finally voi extern_methods o tren
        # (khong tao try/finally rieng thu 2), pop trong CUNG finally duoi.
        for decl_p in extern_pinvokes:
            _validate_and_register_extern_pinvoke(reg, decl_p, pinvoke_decl_lines)
            registered_pinvoke_names.append(decl_p.name)

        # extra_classes (Buoc 4 - closure that, 2026-07-29): OUT-parameter cua
        # gen_il_program - moi 'def long' trong chuong trinh se append vao day
        # 1 hoac nhieu khoi '.class' MOI (cell/closure, xem il_features/
        # closures.py) can ghep RIENG vao IL text, giong het cach lam voi
        # record_type_lines o duoi.
        extra_classes: "list[list[str]]" = []
        # emitted_types (2026-08-13, sua cung __str__ record): 1 set CHUNG giua
        # gen_il_program (ham top-level) va gen_record_types (method tren
        # record) ben duoi - truoc day moi ham tu tao set RIENG, khien 1 dtype
        # dung o CA hai noi (vd TkvStr, khi 1 record __str__ goi str()/+ ben
        # trong than method) bi ensure_class() sinh '.class' 2 LAN -> ilasm loi
        # 'Duplicate method declaration'. Xem il_codegen.py's gen_il_program.
        emitted_types: "set[str]" = set()
        # Task 4/5 (2026-08-17, duck-typing-inference): monomorphize cua
        # tham so 'inferred' - `monomorphize_cache`/`pending_monomorphize`
        # la 2 BIEN CUC BO cua CHINH lan goi compile_tkv_cli nay (khoi tao
        # moi o day, KHONG phai dict module-level nhu EXPR_BUILTIN_CODEGEN)
        # - TU DONG khong ro ri sang lan goi compile_tkv_cli tiep theo
        # trong CUNG process (khong can finally-pop thu cong, khac
        # __tkv_extern_method__/__tkv_extern_pinvoke__ o tren - kien truc
        # cho phep dung bien cuc bo o day nen uu tien no, dung theo brief).
        #
        # Vong lap FIXPOINT (Task 1 report - tom tat rui ro #3): 1 ham
        # 'inferred' KHI resolve xong (thanh 1 Signature monomorphize MOI,
        # xem il_features/duck_typing.py's resolve_call_site) co the TU NO
        # goi tiep 1 ham 'inferred' KHAC voi kieu cu the MOI - moi lan goi
        # gen_il_program se sinh THEM cac phan tu vao pending_monomorphize
        # (qua _expr_call, il_codegen.py) neu gap loi goi nhu vay - can lap
        # lai cho toi khi KHONG con phan tu MOI nao. gen_il_program duoc
        # goi LAI TREN TOAN BO 'sig_body_pairs' (da mo rong them cac ham
        # monomorphize) MOI vong - AN TOAN khong sinh trung '.method' vi
        # CHI ket qua cua LAN GOI CUOI CUNG duoc dung lam 'method_lines'
        # (cac lan goi truoc bi bo ket qua, khong noi chuoi tich luy) -
        # extra_classes/emitted_types la 2 object CHIA SE xuyen MOI lan goi
        # (dedupe san co, xem gen_il_program's docstring) nen tai-bien-dich
        # cac ham DA compile roi khong sinh '.class' trung.
        _MAX_MONOMORPHIZE_ROUNDS = 1000
        monomorphize_cache = {}
        pending_monomorphize: "list[(Signature,list[str],i32)]" = []
        method_lines = gen_il_program(reg, sig_body_pairs, class_name=class_name, records=record_defs,
                                       record_methods=record_methods, extra_classes=extra_classes,
                                       record_bases=record_bases, hang_mod=_khung_hang(module_consts),
                                       bien_mod=_khung_bien(module_globals),
                                       source_path=str(tkv_path), debug=debug,
                                       emitted_types=emitted_types,
                                       monomorphize_cache=monomorphize_cache,
                                        pending_monomorphize=pending_monomorphize)
        _monomorphize_rounds = 0
        while pending_monomorphize:
            _monomorphize_rounds += 1
            if _monomorphize_rounds > _MAX_MONOMORPHIZE_ROUNDS:
                raise CliError(
                    f"tkv build: vong lap monomorphize tham so 'inferred' vuot qua "
                    f"{_MAX_MONOMORPHIZE_ROUNDS} vong lap - nghi ngo co bug logic gay "
                    f"de quy vo han giua cac ham dung tham so kieu suy tu dong.")
            new_pairs = pending_monomorphize[:]
            pending_monomorphize.clear()
            sig_body_pairs.extend(new_pairs)
            method_lines = gen_il_program(reg, sig_body_pairs, class_name=class_name, records=record_defs,
                                           record_methods=record_methods, extra_classes=extra_classes,
                                           record_bases=record_bases, hang_mod=_khung_hang(module_consts),
                                           bien_mod=_khung_bien(module_globals),
                                           source_path=str(tkv_path), debug=debug,
                                           emitted_types=emitted_types,
                                           monomorphize_cache=monomorphize_cache,
                                           pending_monomorphize=pending_monomorphize)
        main_method = build_generic_main(func_table[entry_name], class_name, module_globals=module_globals,
                                         func_table=func_table, records=record_defs)
        record_type_lines = gen_record_types(reg, record_defs, record_method_bodies=record_method_bodies,
                                              record_methods=record_methods, class_name=class_name,
                                              func_table=func_table, record_bases=record_bases,
                                              record_overrides=record_overrides,
                                              record_interfaces=record_interfaces,
                                              interface_defs=interface_defs,
                                              hang_mod=_khung_hang(module_consts),
                                              bien_mod=_khung_bien(module_globals),
                                              record_methods_own=record_methods_own,
                                              # Task 3 (2026-08-12): CUNG 1 list
                                              # extra_classes voi gen_il_program o
                                              # tren - 'async def' method tren
                                              # record can ghi '.class' closure
                                              # cua no vao day de duoc ghep vao IL
                                              # text (extra_class_lines o duoi),
                                              # neu khong ilasm.exe bao 'Reference
                                              # to undefined class'.
                                               extra_classes=extra_classes,
                                               emitted_types=emitted_types,
                                               source_path=str(tkv_path), debug=debug,
                                               record_init_sigs=init_sigs_noi,
                                               record_init_bodies=init_bodies_noi)
        # Vong lap thay rut gon LONG HAI 'for' (2026-09-25) - ban tu-host suy
        # kieu phan tu cua rut gon hai tang ra i32 (List<int32> noi bang join).
        extra_class_lines: "list[str]" = []
        for block in extra_classes:
            extra_class_lines.extend(block)

        # DB that qua P/Invoke sqlite3.dll (Wave 3, 2026-07-29 - xem
        # il_features/stdlib_sqlite.py) - CHI ghep 6 khai bao pinvokeimpl vao
        # class chuong trinh KHI THAT SU dung it nhat 1 ham db_* (tranh khai
        # bao pinvoke thua/doi hoi sqlite3.dll canh file .exe cho chuong
        # trinh khong dung DB).
        sqlite_decl_lines = (SQLITE_PINVOKE_DECL_LINES
                              if any([_uses_sqlite(body_lines) for _sig, body_lines, _start in pairs])
                              else [])

        # --- BEGIN GEMINI ADDED CODE: cJSON P/Invoke Extraction ---
        cjson_decl_lines = (CJSON_PINVOKE_DECL_LINES
                              if any([_uses_cjson(body_lines) for _sig, body_lines, _start in pairs])
                              else [])
        # --- END GEMINI ADDED CODE ---

        # Co che MO RONG (Wave 3, 2026-07-29, "package ecosystem" - xem
        # __tkv_extern_assembly__ trong _parse_program_ast, project-tokenvector-
        # wave2-status memory): THEM cac '.assembly extern' do nguoi dung khai
        # bao, ngoai 3 assembly LUON CO SAN (mscorlib/System.Core/System).
        # 'DEFAULT'/'DEFAULT' = dung publickeytoken+version CHUAN .NET Framework
        # (da xac minh THAT qua ilasm.exe voi System.Xml - CUNG 1 token/ver
        # ap dung cho moi assembly GAC chuan cua Framework 4.0). Dedupe theo
        # ten (khong khai bao lai mscorlib/System/System.Core du nguoi dung
        # lo khai bao trung).
        _default_pubkeytoken = 'B7 7A 5C 56 19 34 E0 89'
        extern_lines = []
        seen_extern = _sao_tap(_DEFAULT_GAC_ASSEMBLIES)
        for asm_name, pubkeytoken, version in extern_assemblies:
            if asm_name in seen_extern:
                continue
            seen_extern.add(asm_name)
            if pubkeytoken == 'DEFAULT' and version == 'DEFAULT':
                extern_lines.append(
                    f'.assembly extern {asm_name} {{ .publickeytoken = ({_default_pubkeytoken} ) .ver 4:0:0:0 }}\n')
            elif pubkeytoken and version:
                extern_lines.append(
                    f'.assembly extern {asm_name} {{ .publickeytoken = ({pubkeytoken} ) .ver {version} }}\n')
            elif version:
                # (Phase 9k, 2026-08-31): phat hien qua compile+run THAT tren
                # NuGet Newtonsoft.Json (khong ky ten manh/khong pubkeytoken,
                # nhung CO version that 13.0.0.0) - truoc day nhanh nay KHONG
                # TON TAI, 'version' bi ROI MAT khi pubkeytoken=None du nguoi
                # dung DA khai qua tuple 3 phan tu - ilasm tu dien .ver
                # 0:0:0:0 cho '.assembly extern X {}' (khong co dau '.ver'),
                # CLR loader tu choi load file that (13.0.0.0 != 0.0.0.0) voi
                # FileLoadException "manifest definition does not match".
                # Assembly khong ky ten manh VAN can .ver khop dung de CLR
                # bind (khong phai "khop bat ky version" nhu tung gia dinh).
                extern_lines.append(f'.assembly extern {asm_name} {{ .ver {version} }}\n')
            elif pubkeytoken:
                extern_lines.append(
                    f'.assembly extern {asm_name} {{ .publickeytoken = ({pubkeytoken} ) }}\n')
            else:
                extern_lines.append(f'.assembly extern {asm_name} {{}}\n')

        il_text = (
            f'.assembly extern mscorlib {{}}\n'
            f'.assembly extern System.Core {{ .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }}\n'
            # System.Text.RegularExpressions.Regex (re_match/re_sub, Wave 2
            # 2026-07-29) nam trong assembly "System" (KHAC "System.Core" o
            # tren) - can khai bao rieng, xac minh THAT qua ilasm.exe (thieu
            # se FileNotFoundException luc CHAY, khong phai luc assemble).
            f'.assembly extern System {{ .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }}\n'
            # System.Numerics.BigInteger - duong CHAM cua kieu 'int' (so nguyen
            # vo han chu so, moc 6 buoc 2 2026-08-05, xem il_features/int_type.py).
            # Khai bao LUON: 1 dong '.assembly extern' khong dung den khong ton
            # gi luc chay va re hon la doi khai bao theo tung chuong trinh.
            f'.assembly extern System.Numerics {{ .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }}\n'
            + ''.join(extern_lines)
            + f'.assembly {class_name} {{}}\n.module {class_name}.exe\n\n'
            + '\n'.join(record_type_lines) + ('\n\n' if record_type_lines else '')
            + '\n'.join(extra_class_lines) + ('\n\n' if extra_class_lines else '')
            + f'.class public auto ansi {class_name} extends [mscorlib]System.Object\n{{\n'
            + '\n'.join(method_lines) + '\n' + '\n'.join(main_method) + '\n'
            + '\n'.join(sqlite_decl_lines) + ('\n' if sqlite_decl_lines else '')
            # --- BEGIN GEMINI ADDED CODE: cJSON P/Invoke Injection ---
            + '\n'.join(cjson_decl_lines) + ('\n' if cjson_decl_lines else '')
            # --- END GEMINI ADDED CODE ---
            + '\n'.join(pinvoke_decl_lines) + ('\n' if pinvoke_decl_lines else '')
            + '}\n'
        )
        # Di qua assemble_il_to_exe (tokenvector_compile.py) chu khong tu goi
        # ilasm: o do co buoc 'on dinh' tranh duong tinh gia cua Defender voi
        # mot PE vua dung xong - xem docstring cua no.
        try:
            ket_qua_exe = assemble_il_to_exe(il_text, out_exe, debug=debug)
            if 'System.Numerics.Vectors' in il_text:
                _sao_dll_simd(str(out_exe))
            return ket_qua_exe
        except TokenVectorError as e:
            raise CliError(str(e))
    finally:
        for _nm in registered_extern_names:
            reg.expr_builtin_codegen.pop(_nm, None)
            reg.expr_builtin_goi.pop(_nm, None)
            reg.expr_builtin_goi_nut.pop(_nm, None)
            reg.expr_builtin_dtype.pop(_nm, None)
            EXTERN_VOID_BUILTIN_NAMES.discard(_nm)
        for _nm in registered_pinvoke_names:
            reg.expr_builtin_codegen.pop(_nm, None)
            reg.expr_builtin_goi.pop(_nm, None)
            reg.expr_builtin_goi_nut.pop(_nm, None)
            reg.expr_builtin_dtype.pop(_nm, None)
            EXTERN_VOID_BUILTIN_NAMES.discard(_nm)
        for _mname in registered_extern_class_method_names:
            _key = khoa_method('extern_class', _mname)
            reg.expr_method_codegen.pop(_key, None)
            reg.expr_method_shape.pop(_key, None)
            reg.expr_method_result_shape.pop(_key, None)
        for _getter_name in registered_extern_class_property_names:
            _key = khoa_method('extern_class', _getter_name)
            reg.expr_method_codegen.pop(_key, None)
            reg.expr_method_shape.pop(_key, None)
            reg.expr_method_result_shape.pop(_key, None)
        il_extern_dtype.dat_bang_extern_class({})
