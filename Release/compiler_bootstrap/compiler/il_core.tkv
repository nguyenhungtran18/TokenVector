# Thu hep CO KIEM TRA ve int32, CHI dung o vi tri CHI SO (2026-08-05).
# dtype -> chuoi IL day du cua lenh chuyen. il_features/*.py tu dang ky
# vao day luc nap module (il_core KHONG duoc import nguoc len feature).
#
# Vi sao rieng chi so duoc thu hep trong khi _widen_if_needed cam tiet:
# get_Item/get_Chars/ldelem cua .NET nhan int32, do la mot o int32 THAT
# chu khong phai lua chon cua ta. Python cung khong cho chi so vuot
# ssize_t. Nen day khong phai "cat am tham" ma la kiem tra bien - va no
# NEM khi khong vua, chu khong quan vong.
IL_NARROW_TO_I32: "dict[str,str]" = {}


def il_array_rank_type(dtype: "str", rank: "i32") -> "str":
    base = IL_SCALAR[dtype]
    if rank == 1:
        return f'{base}[]'
    giua = '0...'
    j = 1
    while j < rank:
        giua = giua + ',0...'
        j = j + 1
    return base + '[' + giua + ']'


def emit_index_scalar(idx_node: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """Day GIA TRI CHI SO (int32) len stack.

    Truong hop rieng duy nhat: bieu thuc chi so co dtype nam trong
    IL_NARROW_TO_I32 (hien la 'int' - so nguyen vo han chu so). Trong mot
    ham tra ve 'int', MOI bien khong chu thich deu la 'int', KE CA bien
    dem vong lap - nen 'xs[j]' voi j la bien dem la chuyen BINH THUONG,
    khong phai truong hop la. Khong co nhanh nay thi
    _widen_if_needed bao loi va 'int' khong dung lam phan tu list duoc.
    Xem il_features/int_type.py's ToI32 - no NEM khi khong vua int32."""
    # Goi THANG `ctx['infer_dtype'](...)` chu khong qua mot bien trung
    # gian: trinh bien dich tu-host nhan ra dang goi nay (arity cua
    # `infer_dtype` thay doi theo cho goi nen no khong khai duoc thanh mot
    # truong `func(...)`), con mot bien giu ham lay tu `.get()` thi no bao
    # "goi ham chua khai". `.get` nam TRONG try de giu nguyen hanh vi cu
    # duoi CPython: thieu khoa -> d = None -> khong lam hep.
    if IL_NARROW_TO_I32:
        try:
            d = ctx.infer_dtype(idx_node, scope, ctx.func_table, None, None, None)
        except Exception:
            d = None
        narrow = IL_NARROW_TO_I32.get(d)
        if narrow is not None:
            ctx.compile_expr(idx_node, scope, out, d, ctx)
            out.append(narrow)
            return
    ctx.compile_expr(idx_node, scope, out, 'i32', ctx)


def emit_index_value(name: "str", idx_node: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx", count_getter_il: "str"):
    """Day gia tri CHI SO len stack cho 'name[idx_node]' (Wave 3, 2026-
    07-29 - chi so am tai compile-time, vd 'lst[-1]'/'s[-1]', muc tieu
    Claude tu tin dung viet code that). GOI SAU KHI 'name' da duoc
    load_var_ref 1 LAN (cho chinh lenh index/get_Item/get_Chars sap
    goi) - truong hop hang so am can load THEM 1 LAN NUA rieng (cho
    get_Count/get_Length), ham nay tu lo, khong gia dinh gi khac tren
    stack. `count_getter_il` la chuoi IL DAY DU cua lenh callvirt lay do
    dai (vd 'callvirt instance int32 ...::get_Count()'). CHI ho tro hang
    so am TAI COMPILE-TIME - bieu thuc am DONG ('lst[-i]') van dung
    duong nguyen (se throw ArgumentOutOfRangeException luc chay, giong
    .NET that, KHONG gia lap wraparound cua Python) - gioi han co y
    thuc, xem _neg_literal_int trong il_codegen.py."""
    n = ctx.neg_literal_int(idx_node)
    if n is None:
        emit_index_scalar(idx_node, scope, out, ctx)
        return
    ctx.load_var_ref(name, scope, out)
    out.append(f'    {count_getter_il}')
    out.append(f'    ldc.i4 {n}')
    out.append('    sub')


