# --- Dinh danh node (P8/3b phep lat, 2026-09-18) ----------------------
#
# Backend sinh ten bien tam tu dinh danh node: '__strtmp{...}',
# '__Lambda_{...}', '__dictiter{...}_en'...
#
# Truoc day day la mot BANG `_NID_MAP` danh so theo `id(obj)`. Hai doi
# hoi cua no - dinh danh on dinh giua cac lan chay, va hai node khac nhau
# khong bao gio trung so - nay duoc thoa MIEN PHI: sau phep lat, mot node
# CHINH LA chi so dong cua no trong arena `expr_row`. Moi lan xuat hien
# co mot dong rieng nen moi lan co mot so rieng, va so do tai lap duoc vi
# no tuy thu tu phan tich chu khong tuy dia chi o nho.
#
# DAY LA RAO SO MOT cua duong gang self-host da duoc go: `_NID_MAP = {}`
# la lenh cap module lam phep gop dung o module thu HAI, va `nid()` cu
# KHONG THE bien dich vi TokenVector khong co `id()`.
#
# `nid` giu lai lam MOT TEN GOI: 188 cho goi khong phai sua, va ten do noi
# ro y dinh ("lay dinh danh de dat ten bien tam") hon la dung thang bien.


def nid(obj: "i32") -> "i32":
    """Dinh danh node - nay chinh la node (xem ghi chu o tren)."""
    return obj


def reset_nid():
    """KHONG CON LAM GI - giu lai de khong phai sua cho goi.

    Arena bieu thuc PHAI duoc dat lai SOM HON diem nay. `gen_il_program`
    tung duoc coi la "diem vao duy nhat cua mot chuong trinh", nhung CHU KY
    HAM da duoc phan tich TRUOC do (`_build_sig_body_pairs`,
