# -*- coding: utf-8 -*-
"""ast_row - doc mot DONG ARENA cua parser native (P8 Task 6, lo 0).

Arena cua `tkv_parser` co dung hinh dang ma `stmt_row` da dung o Task 3/4:

    pool[nid] = "<kind>\t<a>\t<b>\t<kids csv>\t<lines>"

Bo accessor nay TRUOC DAY nam nho trong `_ast_materialize.py` - dung module
sap bi xoa. Nhac ra day de:

  1. Consumer (`tkv_compile.py`, `duck_typing.py`) doc THANG arena, khong qua
     tang object trung gian - do la ca noi dung cua Task 6.
  2. Module nay TU-HOST DUOC (khong lenh cap module, khong lop dong, moi ham
     co annotation), khac han `_ast_compat`/`_ast_materialize`.

VI SAO KHONG DUNG LOP NODE: `isinstance` cua TokenVector giai TINH luc compile
(thiet ke Phase 4), nen "duyet list node tron kieu roi isinstance phan nhanh"
- dung cach doc AST - khong chay duoc. So sanh CHUOI `kind` thi khong can da
hinh. Xem docs/BUGS_TODO.md va plan 2026-09-10-P8-task6-xoa-shim-ast.md.

BANG ANH XA kind <-> lop `ast` cu: sinh BANG SCRIPT (khong chep tay) ra
docs/superpowers/specs/_scratch/p8_task6_anh_xa_kind_lop.json.
"""

def unesc(text: "str") -> "str":
    """Giai ma cot a/b - PHAI khop `_unesc_field` cua tkv_ast.tkv.

    Arena ma hoa tab that thanh hai ky tu (backslash + chu t), va backslash
    thanh hai backslash, truoc khi ghi row: mot tab lac trong a/b lam lech
    HET cac cot phia sau MA KHONG bao loi. Doc row bang split() ma quen giai
    ma thi moi chuoi nguon chua backslash deu sai.

    Docstring nay KHONG dung tien to raw-string - parser native chua doc
    duoc no. Ghi ra day thay vi de nguoi sau tuong la tuy tien."""
    if "\\" not in text:
        return text
    out = []
    i = 0
    n = len(text)
    while i < n:
        ch = text[i]
        if ch == "\\" and i + 2 <= n:
            nxt = text[i + 1]
            if nxt == "t":
                out.append("\t")
                i += 2
                continue
            if nxt == "\\":
                out.append("\\")
                i += 2
                continue
        out.append(ch)
        i += 1
    return "".join(out)


def row(pool: "list[str]", nid: "i32") -> "list[str]":
    """Nam cot cua mot node, cot a/b da giai ma.

    `pool[-1]` KHONG bao loi trong Python - no tra ve hang CUOI (node
    `module`). Mot id -1 (sentinel "vang mat") lot vao day vi vay se bien
    thanh node module MOT CACH LANG LE. Chan tai cho."""
    if nid < 0:
        raise ValueError("ast_row: id node am (" + str(nid) + ") - sentinel " +
                         "-1 lot vao cho bat buoc phai co node")
    # Gan ra bien truoc: goi method chuoi TREN BIEU THUC chua ho tro.
    dong = pool[nid]
    parts = dong.split("\t", 4)
    while len(parts) < 5:
        parts.append("")
    parts[1] = unesc(parts[1])
    parts[2] = unesc(parts[2])
    return parts


def kind_of(pool: "list[str]", nid: "i32") -> "str":
    """Ten loai node - THAY CHO `isinstance(node, ast.X)`."""
    return row(pool, nid)[0]


def col_a(pool: "list[str]", nid: "i32") -> "str":
    return row(pool, nid)[1]


def col_b(pool: "list[str]", nid: "i32") -> "str":
    return row(pool, nid)[2]


def kids(pool: "list[str]", nid: "i32") -> "list[i32]":
    csv = row(pool, nid)[3]
    if not csv:
        return []
    # Vong 'for' tuong minh thay list comprehension: module nay PHAI tu-host
    # duoc, do la ly do no ton tai.
    ra = []
    for x in csv.split(","):
        ra.append(int(x))
    return ra


def csv_names(text: "str") -> "list[str]":
    if not text:
        return []
    return text.split(",")


def line_lo(pool: "list[str]", nid: "i32") -> "i32":
    """So dong DAU cua node, -1 neu dong khong mang thong tin dong.

    Cot 5 cua arena co dang "lo-hi" va CHI cac dong CAU LENH mang no; node
    BIEU THUC de trong (da do: 'assign' co '1-1', 'name'/'binop' trong).
    Tra -1 thay vi None de kieu tra ve la 'i32' thuan - module nay phai
    tu-host duoc."""
    txt = row(pool, nid)[4]
    if not txt:
        return -1
    if "-" not in txt:
        return -1
    phan = txt.split("-")
    lo = phan[0]
    if not lo:
        return -1
    return int(lo)


def line_hi(pool: "list[str]", nid: "i32") -> "i32":
    """So dong CUOI cua node, -1 neu dong khong mang thong tin dong.

    Cung nguon voi `line_lo` (cot 5 dang "lo-hi"), lay nua SAU. Can cho cac
    cho phai CAT dung khoang dong cua mot cau lenh trong van ban nguon (vd
    nang mot 'def' long len top-level)."""
    txt = row(pool, nid)[4]
    if not txt:
        return -1
    if "-" not in txt:
        return -1
    phan = txt.split("-")
    hi = phan[1]
    if not hi:
        return -1
    return int(hi)
