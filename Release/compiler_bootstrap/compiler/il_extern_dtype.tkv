# -*- coding: utf-8 -*-
"""Van ban kieu CIL cho dtype EXTERN - module LA, GO CHU TRINH import.

Truoc day ba thu nay nam hai ben mot chu trinh:

    il_codegen._il_ctor_param_type
          -> (import cuc bo) tkv_compile._extern_il_type_text
          -> il_codegen._EXTERN_CLASS_DEFS

Chu trinh THAT: mot ham o il_codegen can mot ham o tkv_compile, ma ham do
lai can TRANG THAI CAP MODULE cua il_codegen. Khong go duoc bang cach doi
sang `from X import f` (da thu: `partially initialized module`), nen ca ba
chuyen han sang day. Module nay KHONG import gi ngoai `re` - no phai la LA.

QUAN TRONG - `_EXTERN_CLASS_DEFS` bi GAN LAI, khong phai sua tai cho:
`tkv_compile` gan lai thuoc tinh nay 4 cho, trong do co mot cap save/restore
long nhau (`compile_tkv_cli` ngoai co the dang giu bo cua no). Vi vay nguoi
dung PHAI doc qua THUOC TINH MODULE:

    import il_extern_dtype
    ... il_extern_dtype._EXTERN_CLASS_DEFS ...

`from il_extern_dtype import _EXTERN_CLASS_DEFS` se HONG AM THAM: ben nhap
giu dict CU trong khi tkv_compile da gan thuoc tinh sang dict MOI.
"""
import re

# _EXTERN_CLASS_DEFS (Task 2, extern-class, 2026-08-18): bien module-level
# TAM THOI, set/reset (finally-pop, giong het pattern EXPR_BUILTIN_CODEGEN/
# EXPR_BUILTIN_DTYPE o il_dispatch.py) boi tkv_compile.py's compile_tkv_cli
# NGAY TRUOC gen_il_program moi luot compile - ten handle-type ->
# decl dict goc cua pragma ({'name','assembly','class','ctor','methods'}).
# Ly do dung bien module-level thay vi them tham so 'ctx'/'extern_class_defs'
# vao il_type_str: ham nay co TOI 85 diem goi (records: dict truyen VI TRI,
# khong phai qua 1 ctx dict) rai khap il_codegen.py/il_features/*.py - sua
# chu ky se phai doi CA 85 diem goi, rui ro cao/cong suc lon so voi loi
# ich (chi 1 nhanh moi can doc them 1 bang tra cuu). KHONG tu reset giua 2
# lan goi compile_tkv_cli trong CUNG process - caller PHAI tu pop trong
# finally (xem tkv_compile.py's compile_tkv_cli, cung khoi finally voi
# EXPR_BUILTIN_CODEGEN/EXPR_BUILTIN_DTYPE).
# ARENA EXTERN-CLASS (2026-09-18). Truoc do day la
# `dict[str, <decl dict>]` - gia tri la mot dict LONG (co 'methods' la
# DANH SACH CAC DICT), nen khong khai kieu duoc, va no la lenh cap module
# CUOI CUNG chan phep gop tai file nay.
#
# Cach go giong het `expr_row`/`stmt_row`: tang trong chi con la CHI SO,
# nen khong con kieu long nao. Ba arena chuoi, va bang tra cuu thanh
# `dict[str,i32]` - khai duoc.
#
# KHONG dat lai arena giua hai lan compile: chi so da phat ra phai giu
# nguyen nghia. Chi BANG TRA CUU duoc gan lai (tkv_compile luu/khoi phuc
# trong `finally`, xem ghi chu tren), va do la du de cach ly hai lan
# bien dich - hang thua chi ton bo nho, khong sai nghia.
# CHI SO BAT DAU TU MOC, KHONG TU 0 - dung ly do da ghi trong docstring
# cua `expr_row`, va toi da vap LAI dung no khi dung arena nay: mot cho
# viet `prop = ... if decl else None`, va CHI SO 0 LA FALSY nen lop dau
# tien trong bang bi coi nhu khong ton tai (sai am tham, bao "khong phai
# property da khai" trong khi property co that).
#
# Ba moc KHAC NHAU cho ba arena: mot chi so lop lot vao cho doi chi so
# phuong thuc se nem IndexError ngay, thay vi doc nham mot hang co that.
# Dau phan cach cho DANH SACH DTYPE trong mot o. KHONG dung dau phay:
# dtype container co dau phay BEN TRONG ('dict[str,i32]') nen noi bang
# dau phay lam MOT tham so bi tach thanh HAI - cong bao "constructor
# 'Sb' ky vong 2 tham so, nhan duoc 1". Cung loai bay ma `esc` sinh ra
# de chan, chi khac tang.
#
# Danh sach CHI SO (pts/tts/pt_tinh) VAN dung dau phay: chung la so
# nguyen, khong bao gio chua dau phay.
def ngan_ds() -> "str":
    """Ky tu ngan danh sach (chr(31)). HAM thay hang cap module (2026-09-25):
    trinh bien dich chi nhan hang cap module la LITERAL, va lexer hat giong
    khong co thoat hex de viet literal nay."""
    return chr(31)

MOC_LOP = 3000000
MOC_PT = 4000000
MOC_TT = 5000000

_HANG_LOP: "list[str]" = []
_HANG_PT: "list[str]" = []
_HANG_TT: "list[str]" = []

_EXTERN_CLASS_DEFS: "dict[str,i32]" = {}


def _esc_ex(s: "str") -> "str":
    """Che tab de `split` khong lech. Ten hau to `_ex` vi `expr_row` va
    `stmt_row` deu da co ham `esc` rieng - phep gop lam phang moi module
    vao MOT chuong trinh nen trung ten la loi (da vap that o phien nay)."""
    if s is None:
        return ""
    return str(s).replace("\\", "\\\\").replace("\t", "\\t")


def dat_bang_extern_class(bang: "dict[str,i32]") -> "i32":
    """GAN LAI bang tra cuu (2026-09-25) - thay cho `il_extern_dtype._EXTERN_
    CLASS_DEFS = ...` tu module khac, ma ban tu-host chua gan duoc bien cua
    module khac. `global` giu dung hop dong cu: nguoi doc qua THUOC TINH
    module thay bang moi."""
    global _EXTERN_CLASS_DEFS
    _EXTERN_CLASS_DEFS = bang
    return 0


def ten_lop_extern() -> "set[str]":
    """Tap ten extern class trong bang tra cuu (2026-09-29) - thay
    'set(il_extern_dtype._EXTERN_CLASS_DEFS)' o module khac: ban tu-host
    chua dung duoc set() tren dict doc qua THUOC TINH module."""
    ra = set()
    for ten in _EXTERN_CLASS_DEFS:
        ra.add(ten)
    return ra


def reset_extern_classes():
    """Xoa bang tra cuu (arena giu nguyen - xem ghi chu tren)."""
    _EXTERN_CLASS_DEFS.clear()


def them_pt(ten: "str", params: "list[str]", returns: "str") -> "i32":
    """Mot hang PHUONG THUC (hoac static method) - tra CHI SO."""
    _HANG_PT.append(_esc_ex(ten) + "\t" + ngan_ds().join(params) + "\t" + _esc_ex(returns))
    return MOC_PT + len(_HANG_PT) - 1


def them_tt(ten: "str", dtype: "str", readonly: "i32") -> "i32":
    """Mot hang THUOC TINH (property) - tra CHI SO."""
    _HANG_TT.append(_esc_ex(ten) + "\t" + _esc_ex(dtype) + "\t" + ("1" if readonly else ""))
    return MOC_TT + len(_HANG_TT) - 1


def them_lop(ten: "str", assembly: "str", lop: "str", ctor: "list[str]",
             pts: "list[i32]", tts: "list[i32]", pt_tinh: "list[i32]") -> "i32":
    """Mot hang LOP - tra CHI SO. `pts`/`tts`/`pt_tinh` la CHI SO, khong
    phai doi tuong: do chinh la cho kieu long bien mat."""
    _HANG_LOP.append("\t".join([
        _esc_ex(ten), _esc_ex(assembly), _esc_ex(lop), ngan_ds().join(ctor),
        ",".join([str(x) for x in pts]), ",".join([str(x) for x in tts]),
        ",".join([str(x) for x in pt_tinh])]))
    return MOC_LOP + len(_HANG_LOP) - 1


def _o_lop(c: "i32", i: "i32") -> "str":
    return _HANG_LOP[c - MOC_LOP].split("\t")[i]


def ex_ten(c: "i32") -> "str":
    return _o_lop(c, 0)


def ex_assembly(c: "i32") -> "str":
    return _o_lop(c, 1)


def ex_lop(c: "i32") -> "str":
    return _o_lop(c, 2)


def ex_ctor(c: "i32") -> "list[str]":
    v = _o_lop(c, 3)
    return [] if v == "" else v.split(ngan_ds())


def _ds_so(v: "str") -> "list[i32]":
    return [] if v == "" else [int(x) for x in v.split(",")]


def ex_pts(c: "i32") -> "list[i32]":
    """CHI SO cac phuong thuc - goi `ex_pt_*` de doc tung cai."""
    return _ds_so(_o_lop(c, 4))


def ex_tts(c: "i32") -> "list[i32]":
    return _ds_so(_o_lop(c, 5))


def ex_pt_tinh(c: "i32") -> "list[i32]":
    return _ds_so(_o_lop(c, 6))


def ex_pt_ten(m: "i32") -> "str":
    return _HANG_PT[m - MOC_PT].split("\t")[0]


def ex_pt_params(m: "i32") -> "list[str]":
    v = _HANG_PT[m - MOC_PT].split("\t")[1]
    return [] if v == "" else v.split(ngan_ds())


def ex_pt_returns(m: "i32") -> "str":
    return _HANG_PT[m - MOC_PT].split("\t")[2]


def ex_tt_ten(t: "i32") -> "str":
    return _HANG_TT[t - MOC_TT].split("\t")[0]


def ex_tt_dtype(t: "i32") -> "str":
    return _HANG_TT[t - MOC_TT].split("\t")[1]


def ex_tt_readonly(t: "i32") -> "i32":
    return _HANG_TT[t - MOC_TT].split("\t")[2] == "1"



_EXTERN_DTYPE_TO_IL: "dict[str,str]" = {'i32': 'int32', 'i64': 'int64', 'f32': 'float32',
                        'f64': 'float64', 'str': 'string', 'bool': 'bool',
                        # Task 3 (RamGuard TokenVector Rewrite, 2026-08-31):
                        # 'u64' - mirror 'bool'/'enum:...', can vi 1 so
                        # property BCL that (vd ComputerInfo.
                        # AvailablePhysicalMemory) tra ve System.UInt64,
                        # callvirt doi khop CHINH XAC chu ky 'unsigned
                        # int64' - dung 'int64' gay MissingMethodException
                        # (xem task-3-report.md). Gia tri PHIA TOKENVECTOR
                        # van la i64 thuong qua _tokenvector_facing_dtype.
                        'u64': 'unsigned int64',
                        # Phase 9d Part B (2026-08-27): 'object' CHAP NHAN
                        # BAT KY handle-type __tkv_extern_class__ nao lam
                        # tham so (System.Object passthrough) - dtype nay
                        # KHONG can validate rieng vi _expr_var's
                        # widen_if_needed la no-op an toan voi moi dtype
                        # KHONG phai so (da xac nhan qua doc code, xem
                        # Architecture cua plan Phase 9d Part B), va CIL
                        # cho phep nap MOI reference type vao vi tri tham
                        # so khai 'object' ma khong can castclass. 'type'
                        # la dtype rieng cho System.Type (dung voi
                        # typeof(ClassName), xem Task 3) - IL text cua no
                        # LA CHUOI DAC BIET 'type' o day (khong phai IL
                        # that), duoc _il_ctor_param_type short-circuit
                        # thanh 'class [mscorlib]System.Type' truoc khi
                        # dung (xem duoi, mirror enum:... cua Phase 9c) -
                        # entry nay trong _EXTERN_DTYPE_TO_IL CHI can co
                        # mat de _is_valid_extern_dtype/validate loops
                        # cong nhan 'type' la 1 dtype hop le, GIA TRI
                        # 'type' o day KHONG bao gio duoc dung truc tiep
                        # lam van ban IL (luon di qua short-circuit rieng).
                        'object': 'object', 'type': 'type'}

# Phase 9c (2026-08-26, enum): dtype "tham so hoa" cho tham so/return la 1
# .NET enum (underlying Int32) - KHONG the la 1 hang so co dinh nhu 'bool'
# vi moi enum co 1 ten kieu CIL rieng ('valuetype [Assembly]Full.Name').
# Dinh dang: "enum:<ten-assembly>:<FullName>" - ca 2 phan deu PHAI khop
# _EXTERN_ASSEMBLY_NAME_RE/_EXTERN_CLASS_NAME_RE (chan injection vao van
# ban CIL, giong moi validate khac trong file nay).
#
# QUAN TRONG (final review Phase 9c, Important #3): dinh dang nay CHI GIA
# DINH (khong xac minh) rang underlying type cua enum la System.Int32 -
# viec dam bao dieu do la trach nhiem CUA BEN SINH ra dtype string nay
# (tools/tkv_bind/type_map.py::map_enum, kiem tra underlyingType truoc khi
# tra ve). Regex nay KHONG the (va khong) tu kiem tra underlying type -
# 1 file .tkv viet tay dung dtype 'enum:...' cho 1 enum KHONG backed boi
# Int32 (vd Byte/Int16/Int64) se BI SAI LECH AM THAM (silently misbehave):
# CIL signature dung ten kieu enum that (dung), nhung TokenVector van doi
# xu voi gia tri tren stack nhu i32 thuong (_tokenvector_facing_dtype) ->
# sai do rong/dau, khong loi bien dich ro rang. Mo rong dinh dang trong
# tuong lai (vd them truong thu 4 "enum:<assembly>:<FullName>:<underlying>")
# se can thiet de compiler tu ve (self-defending) truoc truong hop nay -
# NGOAI PHAM VI final review nay (documentation-only fix).
_EXTERN_ENUM_DTYPE_RE = re.compile(
    r'^enum:(?P<assembly>[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)'
    r':(?P<full_name>[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)$')



def _extern_il_type_text(dtype: "str") -> "str":
    """Van ban kieu CIL dung trong chu ky 'call'/'callvirt'/'newobj' cho 1
    dtype da qua _is_valid_extern_dtype. Scalar co dinh -> tra thang
    _EXTERN_DTYPE_TO_IL[dtype] (hanh vi CU, khong doi). dtype enum ->
    'valuetype [assembly]FullName' (Phase 9c) - GIA TRI tren stack van la
    1 i32 thuong (enum Int32-backed tuong thich bit-for-bit), CHI ten kieu
    trong chu ky la khac 'int32'."""
    if dtype == 'type':
        # Critical 2 (final review Phase 9d Part B, 2026-08-27): 'type'
        # KHONG duoc short-circuit o day truoc fix nay - _EXTERN_DTYPE_TO_IL
        # co khoa 'type' -> 'type' (CHI la placeholder validation, khong
        # phai IL that, xem chu thich tai _EXTERN_DTYPE_TO_IL) nen nhanh
        # 'il is not None' ben duoi se tra thang chuoi 'type' theo NGHIA
        # DEN - sinh chu ky IL sai ('call ... Method(type)'), ilasm that bai
        # voi loi cu phap. Mirror y het short-circuit da co cua
        # _il_ctor_param_type (il_codegen.py) - dung LAI cung 1 chuoi IL
        # ('class [mscorlib]System.Type'). Sau Critical 2's fix o
        # _validate_and_register_extern_method/_validate_and_register_
        # extern_pinvoke (tu choi 'type' truoc khi toi day), nhanh nay
        # thuc te KHONG con duong goi tu 2 diem do nua - giu lai de
        # _extern_il_type_text() TU THAN AN TOAN (defense-in-depth) neu co
        # diem goi moi trong tuong lai quen kiem tra truoc.
        return 'class [mscorlib]System.Type'
    if dtype in _EXTERN_CLASS_DEFS:
        # Phase 9e (2026-08-27): handle-type (vd 'Sb') lam dtype cho
        # __tkv_extern_method__ - mirror y het IL text mau
        # _make_extern_class_method_codegen dung cho instance method
        # (f"[{decl['assembly']}]{decl['class']}"), CHI khac 'class ' prefix
        # vi day la chu ky tham so/return, khong phai call_target.
        _c = _EXTERN_CLASS_DEFS[dtype]
        return f"class [{ex_assembly(_c)}]{ex_lop(_c)}"
    il = _EXTERN_DTYPE_TO_IL.get(dtype)
    if il is not None:
        return il
    m = _EXTERN_ENUM_DTYPE_RE.match(dtype)
    if m is None:
        raise KeyError(dtype)
    return f"valuetype [{m.group('assembly')}]{m.group('full_name')}"



def _tokenvector_facing_dtype(dtype: "str") -> "str":
    """Phase 9b (bool, 2026-08-24): quy doi 1 dtype KHAI BAO trong pragma
    (co the la 'bool') sang dtype PHIA TOKENVECTOR dung cho type inference
    (register_expr_builtin's return_dtype, TypeAnn cua ket qua method/
    property-getter extern-class). TokenVector KHONG co kieu bool ban dia -
    gia tri LUON la i32 (0/1) o phia goi/nhan. CHI dung ham nay o cac diem
    DANG KY/type-inference; KHONG dung trong cac factory sinh chu ky IL
    thuc su (_make_extern_static_call_codegen va tuong duong o extern-
    class) - noi do PHAI giu nguyen 'bool' de .NET runtime resolve dung
    overload (sai ten kieu la MissingMethodException, xem Critical 2 Phase
    9a). None (vd return_dtype=None cho ham 'void') di qua khong doi.
    Phase 9c (2026-08-26): mo rong cho dtype enum 'enum:...' - cung quy
    doi ve i32, cung ly do het voi bool - TokenVector khong co kieu enum
    rieng, gia tri LUON la i32 phia goi/nhan."""
    if dtype == 'bool':
        return 'i32'
    if dtype == 'u64':
        # Task 3 (RamGuard TokenVector Rewrite, 2026-08-31): mirror 'bool' -
        # TokenVector khong co kieu unsigned rieng, gia tri PHIA TOKENVECTOR
        # LUON la i64 thuong (IL_SCALAR chi co i32/i64/f32/f64). 'u64' o
        # day CHI la nhan cho chu ky IL (_EXTERN_DTYPE_TO_IL), khong phai
        # 1 dtype TokenVector moi.
        return 'i64'
    if isinstance(dtype, str) and dtype.startswith('enum:'):
        return 'i32'
    if isinstance(dtype, str) and dtype.startswith('array['):
        # Phase 9g (2026-08-27): dtype khai bao la 1 mang .NET that (dung
        # cho chu ky IL that su goi method .NET), nhung PHIA TOKENVECTOR
        # (type inference, bien nhan ket qua, code nguoi dung thao tac)
        # LUON thay day la 1 list[T] binh thuong - gia tri THAT SU tren
        # stack da duoc marshal thanh List<T> ngay sau loi goi (xem
        # il_codegen._marshal_extern_return_array), nen quy doi dtype ve
        # 'list[T]' o day la DUNG voi gia tri thuc te tai thoi diem dtype
        # nay duoc dung cho type inference/khai bao bien.
        #
        # Phase 9i (2026-08-28): DOI thanh DE QUY (truoc day slice PHANG
        # 'list[' + dtype[7:] - SAI voi 'array[array[i32]]' vi con thua 1
        # dau ']' cua lop ngoai chua bi cat, vd cho ket qua sai
        # 'list[array[i32]]]' co 3 dau ']' khong khop 2 dau '['). De quy:
        # 'array[array[i32]]' -> inner='array[i32]' -> de quy tiep ->
        # 'list[i32]' -> boc 1 lop 'list[...]' nua -> 'list[list[i32]]'
        # DUNG. Voi dtype 1 cap cu ('array[i32]'), inner='i32' KHONG bat
        # dau 'array[' nen de quy tra ve 'i32' nguyen ven (khop dieu kien
        # dung 'return dtype' o cuoi ham) - HANH VI CU 100% khong doi.
        inner = dtype[len('array['):-1]
        return 'list[' + _tokenvector_facing_dtype(inner) + ']'
    return dtype


# Ten builtin extern tra 'void' - tap KHA BIEN, chi duoc THEM vao (khong
# bao gio gan lai), nen `from ... import` an toan.
EXTERN_VOID_BUILTIN_NAMES: "set[str]" = set()
