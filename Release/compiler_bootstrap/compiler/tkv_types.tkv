# -*- coding: utf-8 -*-
"""Ba KIEU nen cua DSL: `TypeAnn`, `Param`, `Signature`.

TACH RA khoi `typed_dsl_parser.py` ngay 2026-09-14. Ly do KHONG phai gu
thammy ma la mot rang buoc do duoc: `__tkv_import__` keo CA module duoc
import, nen mot file muon dung `TypeAnn` lien file thi `typed_dsl_parser`
PHAI bien dich duoc tron ven - ma no chua, vi `tokenize` tra
`list[tuple(str,str,int)]` (TUPLE 3 PHAN TU, DSL chi nhan dung 2).

Module nay CHI chua dinh nghia kieu, khong ham nao, nen no bien dich duoc
ngay. (Module duoc import khong bat buoc co ham DSL - da mo duong cung
ngay, xem `_parse_program_ast(..., la_import=True)`.)

`typed_dsl_parser` import lai ba ten nay, nen MOI cho `from typed_dsl_parser
import TypeAnn/Param/Signature` trong cay van chay y nguyen.
"""
from tkv_pragma import __tkv_cpython_only__

# BI DANH KIEU (2026-09-24) - khai o day vi `tkv_types` nam o goc cay
# `__tkv_import__`, nen moi file trong cay deu nhin thay.
#
# VI SAO CAN: 2257 annotation trong cay trinh bien dich dung nhung ten nay,
# nhung chung KHONG duoc khai o dau ca. Duoi CPython annotation chi la mot
# chuoi nen khong ai kiem; duoi TokenVector chung la ten BIA va chan
# 95/117 file tren duong tu-host. Ca ba deu co kieu THAT, do duoc tu ma:
#
#   TkvNode     `expr_row._nut` tra `int(van)` hoac None - chi so arena.
#   TkvSig      `gen_il_function(reg, sig: "TkvSig", ...)` nhan dung cai ma
#               cho khac khai la `Signature` (cung mot file dung ca hai ten).
#   TkvTypeAnn  `_func_slot_il(o_ta: "TypeAnn", records: "dict[str,list[
#               (str,TkvTypeAnn)]]")` - mot dong dung ca hai ten cho mot kieu.
#
# Bi danh KHONG sinh kieu moi va KHONG noi long phep kiem: dich cua no van
# phai la kieu hop le, va mot ten bia dat van bi tu choi nhu truoc.
#
# CHUA co bi danh: `TkvTable` va `TkvFn`. Chung KHONG phai bi danh cua mot
# kieu that - `TkvTable` co y la mot HANDLE MO cho bang du lieu long nhau
# (mo khoa BIEN DICH, khong cho an toan kieu), moi cho dung mot hinh dang
# khac nhau. Dat cho chung mot kieu cu the la khai SAI. Viec rieng.
# LOAI LOI CO SAN -> kieu CLR. Dat o day (goc cay `__tkv_import__`) de ca
# `il_codegen` (sinh `extends`) lan `il_features/control_flow` (sinh
# `raise`/`except`) doc CUNG MOT bang - truoc day chi control_flow co, con
# il_codegen giu rieng hang `EXCEPTION_BASE_NAME = 'Exception'`, nen mot lop
# ke thua `KeyError` hop le voi cho nay lai vo hinh voi cho kia.
#
# RANG BUOC khi them mot dong (chep tu control_flow, van con hieu luc): kieu
# CLR moi KHONG duoc nam cung nhanh thua ke voi kieu da co, vi `except` cua
# CLR bat theo QUAN HE KE THUA.
EXC_CLR: "dict[str, str]" = {
    'Exception': '[mscorlib]System.Exception',
    'ZeroDivisionError': '[mscorlib]System.DivideByZeroException',
    'KeyError': '[mscorlib]System.Collections.Generic.KeyNotFoundException',
    'IndexError': '[mscorlib]System.ArgumentOutOfRangeException',
    'ValueError': '[mscorlib]System.FormatException',
    'OverflowError': '[mscorlib]System.OverflowException',
    'SyntaxError': '[mscorlib]System.InvalidOperationException',
    # (2026-09-25) cung bang voi hat giong (exc_dung_san) - moi loai mot kieu
    # CLR RIENG, khong nam duoi kieu nao khac trong bang.
    'TypeError': '[mscorlib]System.InvalidCastException',
    'AttributeError': '[mscorlib]System.MissingMemberException',
    'RuntimeError': '[mscorlib]System.ApplicationException',
    'AssertionError': '[mscorlib]System.NotSupportedException',
      'OSError': '[mscorlib]System.IO.IOException',
      # (2026-10-06) StopIteration = InvalidOperationException - chinh la kieu
      # ma push_next (iter_next.tkv) `newobj` + `throw` khi iterator het du lieu
      # ma khong co default. Giong CPython: `except StopIteration` bat duoc.
      'StopIteration': '[mscorlib]System.InvalidOperationException',
      # (2026-10-06) dong bo voi _EXC_TYPE_MAP cua bootstrap
      # (compiler/il_features/control_flow.tkv): chi them loai co tuong duong
      # CLR that su, gia tri y het ban bootstrap.
      'NotImplementedError': '[mscorlib]System.NotImplementedException',
      'MemoryError': '[mscorlib]System.OutOfMemoryException',
      'ArithmeticError': '[mscorlib]System.ArithmeticException',
      'EOFError': '[mscorlib]System.IO.EndOfStreamException',
      'FileNotFoundError': '[mscorlib]System.IO.FileNotFoundException',
      'PermissionError': '[mscorlib]System.UnauthorizedAccessException',
      'IsADirectoryError': '[mscorlib]System.UnauthorizedAccessException',
      'NotADirectoryError': '[mscorlib]System.UnauthorizedAccessException',
      'ImportError': '[mscorlib]System.IO.FileNotFoundException',
  }

__tkv_type_alias__ = {
    "TkvNode": "i32",
    "TkvSig": "Signature",
    "TkvTypeAnn": "TypeAnn",
}


# BASE cua mot record (2026-09-24). `record_bases[ten]` LUON la `list[str]`:
# [] = khong base, [b] = mot base, [b0, b1...] = da base (Phase 3.1 - b0 la
# base THAT cho `extends`, phan con lai la interface). Truoc day gia tri la
# `None | str | list[str]` va moi noi doc phai `isinstance` - mot union ma
# ngon ngu khong khai duoc; annotation 'dict[str,str]' khi do la KHAI SAI
# cho ca da base (ca nay chay that, xem test/sample_da_base.tkv).
def cac_base(record_bases: "dict[str,list[str]]", ten: "str") -> "list[str]":
    """Moi base khai cua `ten` (rong neu khong co / khong phai record)."""
    bs = record_bases.get(ten)
    if bs is None:
        return []
    return bs


def base_that(record_bases: "dict[str,list[str]]", ten: "str") -> "str":
    """Base THAT (`extends`) cua `ten` - base dau tien; None neu khong co."""
    bs = cac_base(record_bases, ten)
    if len(bs) == 0:
        return None
    return bs[0]


class TypeAnn:
    """Kieu cua mot gia tri trong DSL.

    Thanh RECORD 2026-09-14 (rao R1): truoc do day la mot class Python
    THUONG, nen TokenVector khong dung duoc `TypeAnn(...)` - va vi the
    `ctx['TypeAnn']` (60+ cho goi) khong khai kieu duoc.

    TRUONG `shape` LA MOT UNION: `None` (vo huong) | mot CHUOI hinh dang
    ('list'/'dict'/'tuple'/'record'/'func'/'set'/'extern_class'...) | mot
    `list[int]` (SO CHIEU cua mang co dinh, vd `[4]`). Ngon ngu khong co sum
    type, nen record tach lam HAI truong co bien phan biet:
        shape_ten : chuoi hinh dang, "" khi vo huong hoac khi la mang
        dims      : so chieu, [] khi khong phai mang co dinh

    `.shape` van CON, nhu mot `@property` CHI DANH CHO CPYTHON
    (`@__tkv_cpython_only__`) tra lai dung union cu. Nho vay **334 cho doc
    `.shape` trong cay KHONG phai doi gi ca** - chung di tru dan sang
    `shape_ten`/`dims`. Do dung viec ma pragma nay sinh ra de lam.
    Da do: khong cho nao GAN `.shape` sau khi dung, nen property khong
    setter la an toan.
    """

    dtype: "str"
    shape_ten: "str"
    dims: "list[i32]"
    key_dtype: "str"
    tuple_dtypes: "list[str]"
    tuple_tas: "list[TypeAnn]"
    elem_ta: "TypeAnn"
    func_params: "list[TypeAnn]"
    func_ret_ta: "TypeAnn"
    logic: "i32"

    def __init__(self, dtype: "str", shape: "str", key_dtype: "str"=None, tuple_dtypes: "list[str]"=None, elem_ta: "TypeAnn"=None,
                 func_params: "list[TypeAnn]"=None, func_ret_ta: "TypeAnn"=None, tuple_tas: "list[TypeAnn]"=None,
                 dims: "list[i32]"=None, logic: "i32"=0):
        # logic = 1: gia tri "mang nghia logic" (bool cua Python) - luu int32 nhung in ra True/False (2026-10-01).
        # Voi list/dict thi co nghia PHAN TU/GIA TRI la bool.
        self.logic = logic
        self.dtype = dtype          # 'f32' | 'f64' | 'i32' | 'i64' | 'str' (VALUE dtype khi shape='dict')
        # Hai truong TokenVector doc duoc (xem docstring lop). 2026-09-25: `shape`
        # tung la UNION khong khai kieu (chuoi HOAC danh sach so chieu) - ban
        # tu-host coi no la i32, cat CHUOI vao o int32 va shape_ten luon "":
        # MAT het thong tin hinh dang. Nay `shape` CHI la chuoi; so chieu mang
        # co dinh di qua tham so rieng `dims`.
        self.shape_ten = ""
        if shape is not None:
            self.shape_ten = shape
        self.dims = []
        if dims is not None:
            for _d in dims:
                self.dims.append(_d)
        self.key_dtype = key_dtype  # CHI dung khi shape == 'dict' (dtype cua khoa)
        self.tuple_dtypes = tuple_dtypes  # CHI dung khi shape == 'tuple' - list[str] DUNG 2 phan tu
        # Wave 2 (2026-07-29) - container long nhau: khi shape=='list'/'dict'
        # VA phan tu/gia tri KHONG PHAI vo huong/record ma la 1 container
        # KHAC (List<List<T>>, Dictionary<K, List<T>>), elem_ta giu TypeAnn
        # DAY DU (de quy) cua phan tu/gia tri do - `dtype` luc nay CHI la 1
        # sentinel khong dung truc tiep (xem il_type_str trong il_codegen.py).
        # None (mac dinh) = truong hop cu, khong doi hanh vi cac tinh nang
        # da co (backward-compatible).
        self.elem_ta = elem_ta
        # func_params: CHI dung khi shape == 'func' (Wave 3, 2026-07-29,
        # "function reference" HEP - khong phai closure that, xem
        # project-tokenvector-wave2-status memory). list[TypeAnn] cua cac
        # THAM SO. SUA 2026-09-17: chu thich cu ghi 'list[str] cac dtype
        # tham so (scalar-only)' - dung tu thoi Wave 3 nhung DA LAC HAU.
        # Khai bao truong o dau lop va ca ba cho khoi tao that deu la
        # TypeAnn: stdlib_functional.py `[p.type_ann for p in
        # callee.params]`, il_codegen.py `Param(n, ta) for n, ta in
        # zip(param_names, target_ta.func_params)`.
        # `dtype` cua chinh TypeAnn nay la dtype TRA VE. CHI dung duoc lam KIEU THAM SO cua 1 ham khac (truyen 1
        # ten ham top-level TRUC TIEP tai diem goi) - KHONG ho tro gan lai
        # vao 1 bien local thuong (khong co FIRST_PASS_WALK cho truong hop
        # do, gioi han co y thuc de tranh dung vao van de "bien tu do sau
        # khi ham ngoai return" cua closure that).
        self.func_params = func_params
        # func_ret_ta (P6, 2026-09-08): TypeAnn DAY DU cua kieu TRA VE khi
        # kieu do KHONG vo huong (vd 'func(str)->list[str]'). None = tra ve
        # vo huong, dung `dtype` nhu truoc.
        self.func_ret_ta = func_ret_ta
        # tuple_tas: TypeAnn DAY DU cua tung phan tu tuple, CHI dat khi co
        # it nhat MOT phan tu khong vo huong (vd `(str, TypeAnn)`). Cung
        # loi voi `func_ret_ta` o tren: duong VO HUONG khong doi mot chut
        # nao (45 cho doc `tuple_dtypes` giu nguyen), phan moi di duong
        # rieng. None = tuple toan phan tu vo huong, y het truoc day.
        self.tuple_tas = tuple_tas

    def la_vo_huong(self) -> "i32":
        """Thay cho `.shape is None` cu: KHONG phai container, cung KHONG
        phai mang co dinh - tuc mot kieu vo huong.

        `.shape` la @property CHI-CPYTHON nen TokenVector khong doc duoc;
        hai truong no tach ra la `shape_ten` (chuoi hinh dang, "" khi vo
        huong hoac khi la mang) va `dims` ([] khi khong phai mang). Nen
        dieu kien tuong duong la CA HAI cung rong - mot minh `shape_ten`
        la KHONG du, vi mang co dinh cung co shape_ten == ""."""
        if self.shape_ten != "":
            return 0
        if len(self.dims) > 0:
            return 0
        return 1

    @property
    @__tkv_cpython_only__
    def shape(self):
        """CAU DI TRU - tra lai UNION goc cho 334 cho doc `.shape`.
        TokenVector doc `shape_ten`/`dims`. PHAI BIEN MAT khi di tru xong."""
        if self.shape_ten != "":
            return self.shape_ten
        if len(self.dims) > 0:
            return list(self.dims)
        return None

    def shape_repr(self) -> "str":
        """Chuoi Y HET `repr(self.shape)` cu, dung tu `shape_ten`/`dims`.

        Muc dich: 14 cho chan doan viet `shape={ta.shape_repr()}` vua vuong
        `.shape` (property CHI-CPYTHON) vua vuong `!r` (f-string khong ho tro
        chuyen doi). Doi sang method nay go CA HAI ma KHONG doi mot ky tu nao
        cua thong bao loi.

        KHAC BIET CON LAI, noi ro: neu `shape` GOC la mot TUPLE thi `repr` cu
        ra '(4,)' con day ra '[4]'. Chua thay duong nao trong cay tao TypeAnn
        voi shape tuple, nhung do KHONG phai chung minh."""
        if self.shape_ten != "":
            return "'" + self.shape_ten + "'"
        if len(self.dims) > 0:
            r = ""
            for d in self.dims:
                if r != "":
                    r = r + ", "
                r = r + str(d)
            return "[" + r + "]"
        return "None"

    def shape_str(self) -> "str":
        """Chuoi Y HET `str(self.shape)` cu (khong dau nhay quanh ten hinh
        dang), song doi voi `shape_repr` von la `repr`. Tach rieng vi ba cho
        chan doan noi `.shape` vao f-string bang phep chuyen STR, khong phai
        `!r` - dung nham thi thong bao loi doi mot ky tu."""
        if self.shape_ten != "":
            return self.shape_ten
        if len(self.dims) > 0:
            r = ""
            for d in self.dims:
                if r != "":
                    r = r + ", "
                r = r + str(d)
            return "[" + r + "]"
        return "None"

    @property
    def func_param_dtypes(self) -> "list[str]":
        """Danh sach dtype (chuoi) cua cac tham so 'func' - dung o nhung cho
        chi can SO SANH/in ra ten kieu. func_params luu TypeAnn day du."""
        return [p.dtype for p in (self.func_params or [])]

    def __repr__(self) -> "str":
        # Viet bang bien cuc bo + gan __repr__() tuong minh (2026-09-29): ban
        # tu-host chua noi duoc truong container/record vao f-string. Chu ra
        # y het ban cu duoi CPython.
        tds = "None"
        tdl = self.tuple_dtypes
        if tdl is not None:
            tds = repr(tdl)
        ela = "None"
        et = self.elem_ta
        if et is not None:
            ela = et.__repr__()
        fps = "None"
        fpl = self.func_params
        if fpl is not None:
            partes: "list[str]" = []
            for fp in fpl:
                partes.append(fp.__repr__())
            fps = "[" + ", ".join(partes) + "]"
        return (f'TypeAnn({self.dtype}, shape={self.shape_str()}, key_dtype={self.key_dtype}, '
                f'tuple_dtypes={tds}, elem_ta={ela}, func_params={fps})')


class Param:
    """Mot tham so cua ham/method trong DSL."""

    name: "str"
    type_ann: "TypeAnn"
    # `default_node`: chi so nut bieu thuc cua gia tri mac dinh, hoac -1 neu
    # KHONG co (2026-09-29: truoc day None - nut la so nguyen nen None khong
    # bieu dien duoc o ban tu-host).
    default_node: "TkvNode"
    is_vararg: "i32"
    is_kwarg: "i32"

    def __init__(self, name: "str", type_ann: "TypeAnn", default_node: "TkvNode"=-1, is_vararg: "i32"=False,
                 is_kwarg: "i32"=False):
        self.name = name
        self.type_ann = type_ann
        # default_node: node bieu thuc ('num'/'str_lit'/'neg', ...) hoac
        # None (khong co gia tri mac dinh). CHI ho tro literal so/chuoi
        # (Wave 2, 2026-07-29) - khong ho tro bieu thuc tham chieu bien
        # khac (Python cho phep nhung mac dinh chi tinh 1 lan luc dinh
        # nghia ham, DSL nay chua co khai niem do - gioi han co y thuc).
        self.default_node = default_node
        # is_vararg/is_kwarg (Phase 5.1, 2026-08-11): '*name: T'/'**name: T'
        # - THAM SO CUOI CUNG cua ham top-level, dong nhat kieu (tat ca gia
        # tri du them cung 1 dtype T). type_ann o day KHONG con la scalar T
        # nua ma da la 'list' (vararg) / 'dict' key='str' (kwarg) - xem
        # parse_param. Gioi han co y thuc: khong ho tro tren decorator/method
        # (chi ham top-level, xem tkv_compile.py's _extract_signature_line).
        self.is_vararg = is_vararg
        self.is_kwarg = is_kwarg

    def __repr__(self) -> "str":
        ta_s = "None"
        if self.type_ann is not None:
            ta_s = self.type_ann.__repr__()
        dn = "None"
        if self.default_node >= 0:
            dn = str(self.default_node)
        return f'Param({self.name}: {ta_s} = {dn})'


class Constraint:
    """Mot rang buoc suy ra tu than ham cho mot tham so 'inferred'."""

    kind: "str"     # 'field' | 'method' | 'operator'
    name: "str"     # ten field/method; "" khi kind == 'operator'
    arity: "i32"    # so tham so; chi co nghia khi kind == 'method', 0 neu khong
    op: "str"       # ky hieu toan tu ('+', '=='...); "" khi kind != 'operator'

    def __init__(self, kind: "str", name: "str", arity: "i32", op: "str"):
        self.kind = kind
        self.name = name
        self.arity = arity
        self.op = op


class Signature:
    """Chu ky mot ham/method trong DSL."""

    name: "str"
    params: "list[Param]"
    return_type: "TypeAnn"
    body_mode: "str"
    body_expr: "str"
    is_static: "i32"
    is_async: "i32"
    # is_generator (2026-09-24): TRUNG THAI BA GIA TRI, truoc day ma hoa bang
    # SU CO MAT cua thuoc tinh (`hasattr`) - mot cua thoat chi-CPython.
    # -1 = chua xet (gen_il_program chua chay), 0 = khong, 1 = co.
    is_generator: "i32"
    # HAM SINH ('yield'): il_codegen dat hai truong nay khi no nhan ra mot
    # generator (xem `_chuan_bi_sig_generator`). Truoc day chung duoc GAN
    # DONG, thu duoc duoi CPython nhung TokenVector khong doc duoc ("lop
    # Signature khong co truong 'generator_elem_dtype'"). Khai tuong minh,
    # mac dinh rong cho ham thuong. Khong cho nao dung `hasattr` de phan
    # biet, nen viec luon co truong KHONG doi hanh vi nhanh nao.
    generator_elem_dtype: "str"
    generator_class_name: "str"
    # Rang buoc suy duoc cho tham so 'inferred' - duck_typing dat sau khi
    # collect_inferred_constraints chay. CUNG LY DO voi hai truong tren:
    # truoc day gan DONG roi doc bang `getattr(sig, ..., None) or {}`, dang
    # ma TokenVector khong doc duoc. Mac dinh rong cho ham thuong.
    inferred_constraints: "dict[str,list[Constraint]]"

    def __init__(self, name: "str", params: "list[Param]", return_type: "TypeAnn", body_mode: "str", body_expr: "str"=None, is_static: "i32"=False,
                 is_async: "i32"=False):
        self.name = name
        self.params = params                # list[Param]
        self.return_type = return_type      # TypeAnn hoac None
        self.body_mode = body_mode          # 'expr' | 'block'
        self.body_expr = body_expr          # str hoac None (chi co khi 'expr')
        # is_static: True cho method record co '@staticmethod' (Wave 1,
        # 2026-07-29) - KHONG bind 'self', gen_il_method goi gen_il_function
        # voi self_type_ann=None (giong ham top-level), xem tkv_compile.py's
        # _extract_record_method_sig_line/compile_method_call.
        self.is_static = is_static
        # is_async: True cho 'async def' (Phase 4, 2026-08-11 - port tu cay
        # .tkv tu-host, thiet ke da co san va CHAY DUOC that: KHONG phai
        # state-machine/continuation that, ham 'async def' van chay DONG BO
        # den het roi ket qua duoc boc vao 1 Task<T> DA HOAN TAT qua
        # Task.FromResult<T>(...) truoc 'ret' (xem il_features/control_flow.py's
        # codegen_return) - 'await' o phia goi chi don gian goi .get_Result()
        # dong bo (xem il_features/async_await.py). Giu dung cu phap Python
        # that (async def/await) nhung KHONG co overlap/concurrency THAT -
        # du cho code CPU-bound, ngoai pham vi lam concurrency that.
        self.is_async = is_async
        self.generator_elem_dtype = ""
        self.generator_class_name = ""
        self.is_generator = -1
        self.inferred_constraints = {}

    def __repr__(self) -> "str":
        pd: "list[str]" = []
        for prm in self.params:
            pd.append(prm.__repr__())
        rt = "None"
        if self.return_type is not None:
            rt = self.return_type.__repr__()
        return (f'Signature({self.name}, params=[' + ", ".join(pd) + f'], '
                f'return_type={rt}, body_mode={self.body_mode!r})')


class TranspileError(Exception):
    # Field DAU TIEN kieu str duoc truyen cho .ctor(string) cua base
    # System.Exception nen `.Message` co gia tri (xem
    # test/sample_user_exception.tkv). Duoi CPython day CHI la mot
    # annotation - khong tao thuoc tinh, khong doi `__init__` - nen
    # `TranspileError("abc")` va `str(e)` giu nguyen hanh vi cu.
    msg: "str"


# ------------------------------------------------------------------
# CHUYEN TU `il_codegen` XUONG DAY (2026-09-24).
#
# VI SAO: `Registry` (o il_dispatch) khai truong kieu
# `dict[str, func(list[TkvNode], Scope)->str]`. Nhung `Scope` truoc day
# nam o `il_codegen`, ma `il_codegen` IMPORT `il_dispatch` - nen nhin
# nguoc len khong thay: mot THAM CHIEU TIEN XUYEN MODULE. Duoi CPython
# khong ai kiem (annotation chi la chuoi); duoi TokenVector no chan
# 100/117 file tren duong tu-host.
#
# Bi danh kieu KHONG cuu duoc cho nay: `Scope` la mot record THAT, khong
# phai ten goi khac cua mot kieu vo huong.
#
# Ca ba lop chi phu thuoc `TypeAnn` (da o file nay), nen chuyen xuong day
# la khep kin - va `tkv_types` nam o goc cay `__tkv_import__` nen moi
# file deu nhin thay. Khong module nao IMPORT `Scope`/`Binding` theo ten
# (chung chi xuat hien trong annotation), nen phep chuyen khong pha cho
# goi nao.
# ------------------------------------------------------------------


def bit_logic(mask: "i32", i: "i32") -> "i32":
    """Bit thu i (0 = thap nhat) cua `mask` - TypeAnn.logic cua tuple: bit i = phan tu i mang nghia bool."""
    m = mask
    k = 0
    while k < i:
        m = m // 2
        k += 1
    return m % 2


class BienChuaKhaiBao(KeyError):
    """Ten khong co trong `Scope`.

    2026-09-24 - DON ke thua `KeyError` (truoc do la `SyntaxError, KeyError`):
    CLR DON KE THUA nen mot lop khong the vua la InvalidOperationException
    vua la KeyNotFoundException. Ke thua doi la khong bieu dien duoc trong
    CIL, va no chan 102/117 file tren duong tu-host - khong phai thieu tinh
    nang ma la gioi han that cua nen chay.

    CHON `KeyError` vi DA DEM: 34/35 cho bat quanh mot loi goi `.tra()` bat
    `KeyError` (dung lam LUONG DIEU KHIEN: "tham chieu xuoi, bo qua"). DUY
    NHAT mot cho bat rieng `SyntaxError` (il_features/string_builtin.py) -
    da doi cho do sang bat thang `BienChuaKhaiBao`, ro nghia hon ca truoc.

    Ghi chu cu de lai ben duoi vi no giai thich VI SAO tung ke thua ca hai:

    Truoc 2026-09-21 co hai lop scope rieng nem hai loai khac nhau:
    `_Scope` nem `SyntaxError` (thong bao cho nguoi dung: "bien chua duoc
    khai bao"), `_DtypeOnlyScope` nem `KeyError` (~10 cho dung lam LUONG
    DIEU KHIEN: "tham chieu xuoi, bo qua"). Ca hai cach bat deu dang ton
    tai trong cay va deu DUNG cho muc dich cua no.

    Gop hai lop lam mot thi loai ngoai le khong con phan biet duoc theo
    lop nua. Doi theo TEN BIEN (`infer_scope` -> mot method khac) da thu
    va SAI: `_infer_dtype` nhan chinh doi tuong do qua tham so ten
    `scope`, nen phep doi khong voi toi -> 49 test vo. Loai ngoai le la
    thuoc tinh cua DOI TUONG, khong phai cua ten bien dang cam no.

    Ke thua ca hai giu NGUYEN VEN ca hai cach bat san co, khong phai ra
    soat ~20 cho `except`.

    Ten bien thieu di kem o THUOC TINH `.ten`, khong o `args`: cho bat o
    `_fpp_assign_scalar` can chinh cai ten do de hoi `func_table`
    ('foo + 1' voi foo la ham top-level thi bao loi ro rang thay vi
    "bien chua khai bao"). `KeyError(name)` cu de ten o `args[0]`,
    nhung `SyntaxError.__init__` kiem so doi so rat chat (msg kem bo
    bon (file, dong, cot, text)) nen khong nhet them vao `args` duoc."""

    ten: "str"


class Binding:
    """MOT rang buoc ten -> cho luu tru, thay cho tuple (kind, idx, TypeAnn).

    Vi sao KHONG con la tuple: o thang thu hai, tuple cu luu `int` (arg/
    local/boxed/selfarg), `str` (const), `None` (global) hoac CHINH MOT
    TUPLE (closure_field). Do la mot union 4 nhanh - khong khai duoc kieu
    nao ma khong sai, nen ca duong `scope[...]` mu kieu voi trinh tu-host.
    Do that 2026-09-21: 45/114 dong loi dich nam trong ham dung Scope kieu
    tuple; rieng `fpw_for_in_iter` sup 17 dong tu dung MOT cho thao tuple.

    Moi bien the chi dung o ma no can; o thua de trong. Doc `kind` truoc
    roi moi doc o tuong ung - y het cach ma khoi `if kind == ...` trong
    `_load_var_ref` von da lam.

      kind            o dung
      'arg'           idx      (chi so tham so CIL)
      'selfarg'       idx = 0  ('self' cua instance method)
      'local'         idx      (chi so local CIL)
      'boxed'         idx      (local giu THAM CHIEU toi mot cell)
      'const'         const_value (chinh gia tri, khong co o nho)
      'global'        -        (doc/ghi qua .field static; xem add_global)
      'closure_field' closure_class + field_name
      'closure_field_direct'  closure_class + field_name + il_t
    """

    kind: "str"
    idx: "i32"
    const_value: "str"
    closure_class: "str"
    field_name: "str"
    il_t: "str"
    ta: "TypeAnn"

    def __init__(self, kind: "str", idx: "i32"=-1, const_value: "str"='',
                 closure_class: "str"='', field_name: "str"='',
                 il_t: "str"='', ta: "TypeAnn"=None):
        self.kind = kind
        self.idx = idx
        self.const_value = const_value
        self.closure_class = closure_class
        self.field_name = field_name
        self.il_t = il_t
        self.ta = ta


class Scope:
    """Anh xa ten bien -> (kind, index_hoac_None, TypeAnn).
    kind = 'arg' | 'local' | 'selfarg' ('self' trong 1 instance method -
    xem add_self, khac 'arg' o cach lay dia chi, xem _load_var_addr) |
    'boxed' | 'closure_field' (Buoc 4 - closure that, 2026-07-29, xem
    project-tokenvector-wave2-status memory):
      - 'boxed': 1 local cua HAM NGOAI bi 1 ham long BAT - TypeAnn van la
        TypeAnn VO HUONG goc (logic dtype khong doi, moi noi khac VAN coi
        no la scalar binh thuong), nhung slot local THAT su giu 1 THAM
        CHIEU toi 1 'cell' object (xem _cell_class_name) - idx la chi so
        local nhu 'local' thuong, CHI khac o cach _load_var_ref/
        _stmt_assign_scalar doc/ghi (qua ldfld/stfld, khong ldloc/stloc
        truc tiep gia tri).
      - 'closure_field': 1 bien bi bat, DOC/GHI TU BEN TRONG chinh ham
        long (than method cua closure class) - khong phai local/tham so
        cua method do, ma la 1 FIELD cua 'self' (the hien closure). idx
        la tuple (closure_class_name, field_name), KHONG phai so nguyen.

    Tu 2026-09-21 la RECORD that (truoc do la handle-type RONG
    `Scope`): handle-type mo khoa BIEN DICH chu khong cho DOC
    TRUONG, nen `self.vars[name]` van mu kieu - do duoc la loi DAU
    BANG sau khi da co `Binding`."""

    vars: "dict[str,Binding]"
    class_name: "str"

    def __init__(self):
        self.vars = {}
        self.class_name = 'Program'

    def add_arg(self, name: "str", idx: "i32", type_ann: "TypeAnn"):
        self.vars[name] = Binding('arg', idx=idx, ta=type_ann)

    def add_boxed(self, name: "str", idx: "i32", type_ann: "TypeAnn"):
        self.vars[name] = Binding('boxed', idx=idx, ta=type_ann)

    def add_self(self, name: "str", type_ann: "TypeAnn"):
        # 'self' trong 1 instance method LUON o arg index 0 (quy uoc CIL
        # cho instance method), va kieu cua no la !T& (managed pointer)
        # CHU KHONG PHAI !T nhu tham so thuong - da xac minh THAT bang
        # probe_record_method.il (Scale() sua field truc tiep qua ldarg.0
        # khong can ldarga lai).
        self.vars[name] = Binding('selfarg', idx=0, ta=type_ann)

    def add_local(self, name: "str", idx: "i32", type_ann: "TypeAnn"):
        self.vars[name] = Binding('local', idx=idx, ta=type_ann)

    def add_const(self, name: "str", value: "str", type_ann: "TypeAnn"):
        """Hang so cap module ('MAX = 10' o dau file .tkv, 2026-08-03) -
        KHONG co o nho: 'idx' giu CHINH gia tri Python, va _load_var_ref
        sinh 'ldc'/'ldstr' thay vi 'ldloc'. Nho vay moi noi khac (suy
        dtype, so sanh, truyen tham so...) dung nguyen duong cu."""
        self.vars[name] = Binding('const', const_value=value, ta=type_ann)

    def add_global(self, name: "str", type_ann: "TypeAnn"):
        """Bien module-level GHI DUOC ('global x' trong than ham, 2026-08-11)
        - KHONG co local slot: doc/ghi qua '.field private static' cua
        chinh class chuong trinh (xem self.class_name, gan trong
        gen_il_function) qua ldsfld/stsfld (xem _load_var_ref/
        _stmt_assign_scalar). idx = None (khong dung, giong quy uoc cua
        'closure_field' voi tuple)."""
        self.vars[name] = Binding('global', ta=type_ann)

    def set(self, name: "str", type_ann: "TypeAnn"):
        """Ghi mot rang buoc CHI CO KIEU (chua biet chi so o nho) - tang
        first-pass dung, truoc khi cap phat local."""
        self.vars[name] = Binding('local', ta=type_ann)

    def dat_tam(self, name: "str", type_ann: "TypeAnn"):
        """Rang buoc AO cho mot BIEU THUC (kind '__expr__') - khong co o
        nho, chi de duong suy kieu nhin thay mot ten tam. string_join dung
        no roi `xoa()` ngay trong `finally`. Dat o day de phep dung
        `Binding` nam TRON trong il_codegen (module tinh nang khong import
        duoc ten do)."""
        self.vars[name] = Binding('__expr__', ta=type_ann)

    def xoa(self, name: "str"):
        """Go mot rang buoc - doi xung voi `dat_tam`."""
        del self.vars[name]

    def tra(self, name: "str") -> "Binding":
        """Tra cuu mot rang buoc. Thay cho `scope[name]` - xem `Binding`.

        NEM SyntaxError (khong phai KeyError) khi thieu ten: nhieu cho goi
        bat dung loai nay de bao "bien chua khai bao" cho nguoi dung, doi
        loai ngoai le se lam chung TRUOT qua."""
        if name not in self.vars:
            loi = BienChuaKhaiBao(
                f'il_codegen: bien {name!r} chua duoc khai bao/tham so')
            loi.ten = name
            raise loi
        return self.vars[name]

    def __getitem__(self, name: "str") -> "Binding":
        """CAU DI TRU - vai cho con doc `scope[name]`. Xoa khi het."""
        return self.tra(name)

    def __contains__(self, name: "str") -> "i32":
        return name in self.vars
