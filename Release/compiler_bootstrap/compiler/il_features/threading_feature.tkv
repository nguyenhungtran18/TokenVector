# -*- coding: utf-8 -*-
"""Lap trinh Da luong Tinh (Moc 22, 2026-08-09) - thread_spawn, thread_join, thread_sleep.

Cung mot file .tkv, 2 duong chay (CPython & TokenVector .exe), cung ket qua 100%.
"""
import il_codegen as _ilc
from il_core import IL_SCALAR
from il_dispatch import register_expr_builtin
from expr_row import ea_str, ekind

_THR_MARK = 'TkvThr_'

__tkv_import__ = "il_dispatch"


def _il_kieu_doi_so(ta: "TypeAnn", ctx: "Ctx") -> "str":
    """Chuoi kieu IL cua tham so worker (scalar hoac container/record)."""
    if ta.la_vo_huong():
        return IL_SCALAR[ta.dtype]
    return ctx.il_type_str(ta, ctx.records)


def _spawn_co_doi_so(args: "list[TkvNode]", fn_name: "str", sig: "TkvSig", il_ret: "str", class_name: "str", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """thread_spawn(fn, x): worker co DUNG 1 tham so. Task.Factory.StartNew<R>(Func<object,R>, object state);
    Func<object,R> can ham nhan 'object' nen sinh lop trung gian TkvThr_<fn>::Run(object) (unbox/castclass roi goi fn)."""
    if sig is None or len(sig.params) != 1:
        raise SyntaxError("il_codegen: thread_spawn(fn, x): '" + fn_name + "' phai co DUNG 1 tham so")
    p_ta = sig.params[0].type_ann
    il_p = _il_kieu_doi_so(p_ta, ctx)
    la_scalar = p_ta.la_vo_huong() and p_ta.dtype not in ('str', 'object', 'thread')
    ten_lop = _THR_MARK + fn_name
    if ten_lop not in ctx.emitted_types:
        ctx.emitted_types.add(ten_lop)
        ep = '    unbox.any ' + il_p if la_scalar else '    castclass ' + il_p
        ctx.extra_classes.append([
            '.class public auto ansi beforefieldinit ' + ten_lop + ' extends [mscorlib]System.Object',
            '{',
            '  .method public static ' + il_ret + ' Run(object o) cil managed',
            '  {',
            '    .maxstack 8',
            '    ldarg.0',
            ep,
            '    call ' + il_ret + ' ' + class_name + '::' + fn_name + '(' + il_p + ')',
            '    ret',
            '  }',
            '}',
        ])
    out.append('    call class [mscorlib]System.Threading.Tasks.TaskFactory '
               '[mscorlib]System.Threading.Tasks.Task::get_Factory()')
    out.append('    ldnull')
    out.append('    ldftn ' + il_ret + ' ' + ten_lop + '::Run(object)')
    out.append('    newobj instance void class [mscorlib]System.Func`2<object,' + il_ret + '>::.ctor(object, native int)')
    ctx.compile_expr(args[1], scope, out, p_ta.dtype, ctx)
    if la_scalar:
        out.append('    box ' + il_p)
    out.append('    callvirt instance class [mscorlib]System.Threading.Tasks.Task`1<!!0> '
               '[mscorlib]System.Threading.Tasks.TaskFactory::StartNew<' + il_ret + '>('
               'class [mscorlib]System.Func`2<object,!!0>, object)')


def compile_thread_spawn(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """thread_spawn(fn_name) -> Task<T> handle (T = kieu tra ve THAT cua
    fn_name), luu tren stack duoi dang 'object' (xem IL_SCALAR['thread']
    trong il_core.py). Sua 2026-08-10 (docs/BUGS_TODO.md muc G): TRUOC DAY
    dung System.Threading.Thread/ThreadStart (delegate 'void', KHONG CO
    kenh tra gia tri - thread_join() luon phai hardcode tra ve 0). Task<T>
    (cung ho Task da dung cho async/await, xem async_await.py) co
    get_Result() tra DUNG gia tri worker tinh ra, block cho toi khi xong -
    y het ngu nghia thread_spawn+thread_join truoc day (van chay task tren
    ThreadPool thread rieng, khong phai luong chinh)."""
    if not args or len(args) > 2:
        raise SyntaxError("il_codegen: thread_spawn(fn) hoac thread_spawn(fn, doi_so) - ten ham target va toi da 1 doi so")
    fn_node = args[0]
    if ekind(fn_node) != 'var':
        raise SyntaxError(f"il_codegen: thread_spawn() nhan ten ham target, nhan duoc: {fn_node!r}")
    fn_name = ea_str(fn_node)
    # Doc TRUONG thang: `Ctx` luon CO hai truong nay nen `ctx.get(k, md)` cu
    # (qua cau getattr) khong bao gio tra mac dinh - giu dung hanh vi do.
    class_name = ctx.class_name
    func_table = ctx.func_table
    sig = func_table.get(fn_name)
    ret_dtype = sig.return_type.dtype if (sig and sig.return_type) else 'i64'
    il_ret = IL_SCALAR.get(ret_dtype, 'int64')
    # Luu kieu tra ve THAT cua worker theo TEN BIEN se duoc gan ('t1' trong
    # 't1 = thread_spawn(worker)') - _stmt_assign_scalar (il_codegen.py) da
    # ghi san ctx.assign_target_name TRUOC khi goi ham nay.
    target_name = ctx.assign_target_name
    if target_name:
        ctx.thread_ret_types[target_name] = ret_dtype
    # Dung Task.Factory.StartNew<T>() thay vi Task.Run<T>() - Task.Run()
    # CHI co tu .NET Framework 4.5, trong khi ilasm.exe dang dung nam o
    # thu muc Framework v4.0.30319 (assemble doi voi mscorlib v4.0, KHONG
    # co Task.Run) - da xac minh THAT bang probe .il doc lap tay viet
    # 2026-08-10 (MissingMethodException voi Task.Run, chay dung voi
    # Task.Factory.StartNew - co san tu .NET 4.0 goc, khong phai 4.5).
    if len(args) == 2:
        _spawn_co_doi_so(args, fn_name, sig, il_ret, class_name, scope, out, ctx)
        return
    out.append('    call class [mscorlib]System.Threading.Tasks.TaskFactory '
               '[mscorlib]System.Threading.Tasks.Task::get_Factory()')
    out.append('    ldnull')
    out.append(f'    ldftn {il_ret} {class_name}::{fn_name}()')
    out.append(f'    newobj instance void class [mscorlib]System.Func`1<{il_ret}>::.ctor(object, native int)')
    out.append(f'    callvirt instance class [mscorlib]System.Threading.Tasks.Task`1<!!0> '
               f'[mscorlib]System.Threading.Tasks.TaskFactory::StartNew<{il_ret}>('
               f'class [mscorlib]System.Func`1<!!0>)')

def compile_thread_join(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """thread_join(thread_var) -> gia tri THAT tra ve boi worker (khong
    con hardcode 0, xem compile_thread_spawn). Tra ve dtype khong ro (chua
    tung gan qua thread_spawn trong CUNG ham - vd tham so ham, khong phai
    local) thi mac dinh 'i64' (pham vi that su dung nhieu nhat), giu
    tuong thich nguoc thay vi bao loi cung."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: thread_join() nhan 1 tham so la bien thread")
    t_node = args[0]
    var_name = ea_str(t_node) if ekind(t_node) == 'var' else None
    ret_dtype = ctx.thread_ret_types.get(var_name, 'i64')
    il_ret = IL_SCALAR.get(ret_dtype, 'int64')
    ctx.compile_expr(t_node, scope, out, 'thread', ctx)
    out.append(f'    castclass class [mscorlib]System.Threading.Tasks.Task`1<{il_ret}>')
    out.append(f'    callvirt instance !0 class [mscorlib]System.Threading.Tasks.Task`1<{il_ret}>::get_Result()')
    ctx.widen_if_needed(ret_dtype, dtype, out)

def compile_thread_sleep(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """thread_sleep(ms) -> System.Threading.Thread::Sleep(ms)."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: thread_sleep() nhan 1 tham so la so miligiay (ms)")
    ms_node = args[0]
    ctx.compile_expr(ms_node, scope, out, 'i32', ctx)
    out.append('    call void [mscorlib]System.Threading.Thread::Sleep(int32)')
    out.append('    ldc.i4.0')


def compile_lock_acquire(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """lock_acquire("ten") - khoa co TEN toan tien trinh (String.Intern + Monitor.Enter); cung ten = cung khoa."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: lock_acquire(ten) nhan 1 chuoi la ten khoa")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    call string [mscorlib]System.String::Intern(string)')
    out.append('    call void [mscorlib]System.Threading.Monitor::Enter(object)')
    out.append('    ldc.i4.0')


def compile_lock_release(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 1:
        raise SyntaxError("il_codegen: lock_release(ten) nhan 1 chuoi la ten khoa")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    call string [mscorlib]System.String::Intern(string)')
    out.append('    call void [mscorlib]System.Threading.Monitor::Exit(object)')
    out.append('    ldc.i4.0')


def _nap_dia_chi_bien(name: "str", scope: "Scope", out: "list[str]", ten_ham: "str") -> "str":
    """Day DIA CHI cua bien so nguyen i32/i64 (local/tham so/bien 'global') len stack; tra dtype."""
    rb = scope.tra(name)
    ta = rb.ta
    if not ta.la_vo_huong() or ta.dtype not in ('i32', 'i64'):
        raise SyntaxError("il_codegen: " + ten_ham + "(" + name + ", ...) can bien i32 hoac i64, '" + name + "' co dtype=" + str(ta.dtype))
    if rb.kind == 'global':
        out.append('    ldsflda ' + IL_SCALAR[ta.dtype] + ' ' + scope.class_name + '::' + _ilc._il_ident(name))
    elif rb.kind == 'arg':
        out.append('    ldarga.s ' + str(rb.idx))
    elif rb.kind == 'local':
        out.append('    ldloca.s ' + str(rb.idx))
    else:
        raise SyntaxError("il_codegen: " + ten_ham + "(" + name + ", ...): bien '" + name + "' (loai " + rb.kind + ") khong lay duoc dia chi - dung bien 'global', local hoac tham so")
    return ta.dtype


def compile_atomic_add(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """atomic_add(x, n) -> gia tri MOI cua x (Interlocked.Add tren dia chi bien). x: bien global/local i32 hoac i64."""
    if len(args) != 2 or ekind(args[0]) != 'var':
        raise SyntaxError("il_codegen: atomic_add(x, n) can ten bien x va so nguyen n")
    d = _nap_dia_chi_bien(ea_str(args[0]), scope, out, 'atomic_add')
    ctx.compile_expr(args[1], scope, out, d, ctx)
    t = IL_SCALAR[d]
    out.append('    call ' + t + ' [mscorlib]System.Threading.Interlocked::Add(' + t + '&, ' + t + ')')
    ctx.widen_if_needed(d, dtype, out)


def compile_atomic_inc(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 1 or ekind(args[0]) != 'var':
        raise SyntaxError("il_codegen: atomic_inc(x) can ten bien x")
    d = _nap_dia_chi_bien(ea_str(args[0]), scope, out, 'atomic_inc')
    t = IL_SCALAR[d]
    out.append('    call ' + t + ' [mscorlib]System.Threading.Interlocked::Increment(' + t + '&)')
    ctx.widen_if_needed(d, dtype, out)


def compile_parallel_for(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """parallel_for(fn, n): chay fn(i) cho i = 0..n-1 SONG SONG (System.Threading.Tasks.Parallel.For).
    fn PHAI la ham top-level 'def fn(i: "i32") -> "void"'; fn phai an toan da luong (dung atomic_add/lock)."""
    if len(args) != 2 or ekind(args[0]) != 'var':
        raise SyntaxError("il_codegen: parallel_for(fn, n) can ten ham worker va so vong lap n")
    fn_name = ea_str(args[0])
    sig = ctx.func_table.get(fn_name)
    if sig is None or len(sig.params) != 1 or sig.params[0].type_ann.dtype != 'i32' or not sig.params[0].type_ann.la_vo_huong():
        raise SyntaxError("il_codegen: parallel_for: '" + fn_name + "' phai la ham dang def " + fn_name + "(i: \"i32\") -> \"void\"")
    if sig.return_type is not None and sig.return_type.dtype != 'void':
        raise SyntaxError("il_codegen: parallel_for: '" + fn_name + "' phai tra void (khai bao -> \"void\")")
    out.append('    ldc.i4.0')
    ctx.compile_expr(args[1], scope, out, 'i32', ctx)
    out.append('    ldnull')
    out.append('    ldftn void ' + ctx.class_name + '::' + fn_name + '(int32)')
    out.append('    newobj instance void class [mscorlib]System.Action`1<int32>::.ctor(object, native int)')
    out.append('    call valuetype [mscorlib]System.Threading.Tasks.ParallelLoopResult [mscorlib]System.Threading.Tasks.Parallel::For(int32, int32, class [mscorlib]System.Action`1<int32>)')
    out.append('    pop')
    out.append('    ldc.i4.0')


def _dtype_atomic(args: "list[TkvNode]", scope: "Scope", func_table: "dict[str,TkvSig]") -> "str":
    if len(args) >= 1 and ekind(args[0]) == 'var':
        try:
            ta = scope.tra(ea_str(args[0])).ta
        except KeyError:
            return 'i64'
        if ta.dtype in ('i32', 'i64'):
            return ta.dtype
    return 'i64'


def compile_cpu_count(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    out.append('    call int32 [mscorlib]System.Environment::get_ProcessorCount()')


def compile_thread_id(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    out.append('    call class [mscorlib]System.Threading.Thread [mscorlib]System.Threading.Thread::get_CurrentThread()')
    out.append('    callvirt instance int32 [mscorlib]System.Threading.Thread::get_ManagedThreadId()')


def bootstrap_threading_feature(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_expr_builtin(reg, 'thread_spawn', compile_thread_spawn, 'thread')
    # 'i64' (sua 2026-08-10, truoc la 'i32' - SAI voi moi vi du tai lieu dung
    # worker tra 'i64', bien nhan ket qua bi ep kieu i32 tu first-pass du
    # join() co doc dung gia tri i64. Van la gioi han: worker tra 'f64'/'str'
    # se bi ep sai kieu o BUOC NAY (truoc ca luc goi compile_thread_join) - xem
    # docs/BUGS_TODO.md muc G, chua giai quyet duoc tong quat cho moi dtype.
    register_expr_builtin(reg, 'thread_join', compile_thread_join, 'i64')
    register_expr_builtin(reg, 'thread_sleep', compile_thread_sleep, 'i32')
    register_expr_builtin(reg, 'lock_acquire', compile_lock_acquire, 'i32')
    register_expr_builtin(reg, 'lock_release', compile_lock_release, 'i32')
    register_expr_builtin(reg, 'atomic_add', compile_atomic_add, 'i64', return_dtype_fn=_dtype_atomic)
    register_expr_builtin(reg, 'atomic_inc', compile_atomic_inc, 'i64', return_dtype_fn=_dtype_atomic)
    register_expr_builtin(reg, 'parallel_for', compile_parallel_for, 'i32')
    register_expr_builtin(reg, 'cpu_count', compile_cpu_count, 'i32')
    register_expr_builtin(reg, 'thread_id', compile_thread_id, 'i32')
