# -*- coding: utf-8 -*-
"""Chan ly Python cho toan hang logic (2026-09-26) - module LA (chi import
expr_row) de ca operators.py va control_flow.py dung chung ma khong vong import."""

from expr_row import ea_ds, ea_str, eb_nut, eb_str, ec_nut, ekind

__tkv_import__ = "expr_row"


def la_chuoi_vo_huong(node: "TkvNode", scope: "Scope") -> "i32":
    """Bieu thuc co GIA TRI la chuoi (khong phai so sanh/phep logic ra 0/1,
    khong phai container ma dtype phan tu la str)."""
    k = ekind(node)
    if k in ('compare', 'not', 'in'):
        return False
    if k == 'var':
        try:
            ta = scope.tra(ea_str(node)).ta
        except (KeyError, SyntaxError):
            return False
        return ta is not None and ta.la_vo_huong() and ta.dtype == 'str'
    if k == 'boolop':
        return la_chuoi_vo_huong(eb_nut(node), scope) and la_chuoi_vo_huong(ec_nut(node), scope)
    return k in ('str_lit', 'call', 'method_call', 'method_call_expr', 'attr', 'attr_expr', 'index', 'index_expr', 'ternary')


def container_var_ta(node: "TkvNode", scope: "Scope", ctx: "Ctx"=None) -> "TypeAnn":
    """TypeAnn cua BIEN list/dict/set (2026-09-29), hoac None. Chan ly Python
    cua container la 'khong rong' - truoc day 'while stack:' / 'if d:' chi
    kiem tra tham chieu khac null nen LUON dung (SAI AM THAM: 'stack.pop()'
    tren list rong nem ArgumentOutOfRange)."""
    if ekind(node) == 'attr' and ctx is not None:
        # 'obj.truong' (2026-09-29): truong list/dict/set cua 1 record.
        try:
            ta_obj = scope.tra(ea_str(node)).ta
        except (KeyError, SyntaxError):
            return None
        if ta_obj is None or ta_obj.shape_ten != 'record' or not ctx.records:
            return None
        for ten_tr, fd in ctx.records.get(ta_obj.dtype, []):
            if ten_tr == eb_str(node) and fd.shape_ten in ('list', 'dict', 'set', 'frozenset'):
                return fd
        return None
    if ekind(node) == 'call' and ctx is not None and ctx.func_table:
        # 'if not f(x)' (2026-09-29): ham tra list/dict/set - chan ly cung la 'khong rong'.
        sig = ctx.func_table.get(ea_str(node))
        if sig is not None and sig.return_type is not None and sig.return_type.shape_ten in ('list', 'dict', 'set', 'frozenset'):
            return sig.return_type
        return None
    if ekind(node) != 'var':
        return None
    try:
        ta = scope.tra(ea_str(node)).ta
    except (KeyError, SyntaxError):
        return None
    if ta is not None and ta.shape_ten in ('list', 'dict', 'set', 'frozenset'):
        return ta
    return None


def nap_container_khong_rong(node: "TkvNode", ta: "TypeAnn", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """Day 1 int32: Count > 0 cua container (List/Dictionary/HashSet)."""
    if ekind(node) == 'var':
        ctx.load_var_ref(ea_str(node), scope, out)
    else:
        ctx.compile_expr(node, scope, out, ta.dtype, ctx)
    # Null-an-toan (2026-09-29): tham so container mac dinh None ('closure_captures: list = None')
    # la SAI trong Python - get_Count tren null se NullReferenceException.
    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    out.append('    dup')
    out.append(f'    brfalse cont_null_{n}')
    out.append(f'    callvirt instance int32 {ctx.il_type_str(ta, ctx.records)}::get_Count()')
    out.append('    ldc.i4.0')
    out.append('    cgt')
    out.append(f'    br cont_het_{n}')
    out.append(f'  cont_null_{n}:')
    out.append('    pop')
    out.append('    ldc.i4.0')
    out.append(f'  cont_het_{n}:')


def nap_chan_ly(node: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """Day chan ly Python (0/1 int32) cua 1 toan hang logic (2026-09-26):
    chuoi -> khac rong (truoc day 'brfalse' tren tham chieu: "" la DUNG)."""
    if ctx is not None and ekind(node) == 'list_literal':
        # 'not []' / '[1] or x' (2026-10-01): literal list - chan ly biet luc bien dich
        if len(ea_ds(node)) > 0:
            out.append('    ldc.i4.1')
        else:
            out.append('    ldc.i4.0')
        return
    if ctx is not None and ekind(node) == 'dict_rong':
        out.append('    ldc.i4.0')
        return
    if ctx is not None:
        ta_c = container_var_ta(node, scope, ctx)
        if ta_c is not None:
            nap_container_khong_rong(node, ta_c, scope, out, ctx)
            return
    if ctx is not None and la_chuoi_vo_huong(node, scope):
        try:
            d = ctx.infer_dtype(node, scope, ctx.func_table, ctx.records, ctx.record_methods, None)
        except (KeyError, SyntaxError):
            d = None
        if d == 'str':
            ctx.compile_expr(node, scope, out, 'str', ctx)
            out.append('    call bool [mscorlib]System.String::IsNullOrEmpty(string)')
            out.append('    ldc.i4.0')
            out.append('    ceq')
            return
    ctx.compile_expr(node, scope, out, 'i32', ctx)
