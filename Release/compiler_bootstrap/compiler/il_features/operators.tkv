# -*- coding: utf-8 -*-
"""Toan tu so hoc/boolean/so sanh (Phase 1 buoc 6, 2026-07-28) - tag
'binop'/'boolop'/'neg'/'not'/'compare' cua _compile_expr (TRU nhanh
string, da chuyen sang string_feature.py o buoc 5 - file nay GOI LAI
qua ctx['compile_binop_concat']/ctx['compile_compare_str'] duoc tiem tu
core, giu dung tinh than 'binop'/'compare' O DAY vi day la tag SO HOC
CO BAN (string la truong hop dac biet duoc uy quyen ra ngoai, khac
index/in noi list/dict/set moi la chu so huu chinh); cong voi ho macro
TEXT-LEVEL dense/normalize/argmax/add/sub/mul/scale/matvec/apply +
compound-assign +=/-=/... tren bien/chi-so (KHONG bao gom compound-assign
tren field record, thuoc record_feature.py).

Quy uoc dependency-injection qua `ctx` giong cac buoc truoc. Macro
_COMPOUND_ATTR_RE (dung chung constant _COMPOUND_ASSIGN_OPS) o
record_feature.py se dinh nghia LAI cung 1 dict nho nay - chap nhan
trung lap 1 dict hang so 5 phan tu thay vi import cheo giua 2 feature
file."""
from tkv_types import TypeAnn, cac_base
import re

from il_core import IL_LDC_OP, nid
import il_features.int_type as _int_type
from il_dispatch import register_macro_expander, register_expr_codegen
from il_features.stdlib_math import compile_pow as _compile_pow
from il_features.complex_type import compile_binop_complex
from il_features.vector4_type import compile_binop_vector4
from il_features.datetime_py import la_dtype_ngay_gio, hop_kieu_ngay_gio
from il_features.int_type import compile_binop_int, compile_compare_int, compile_divmod_pow, compile_neg_int
from il_features.regex_match import emit_success
from expr_row import ea_ds, ea_nut, ea_str, eb_nut, ec_nut, ekind
from il_features.chan_ly import nap_chan_ly, container_var_ta, nap_container_khong_rong
from il_features.record_feature import _method_owner_class
import il_codegen as _ilc
from il_features.list_type import il_list_type, il_list_elem_ilstr, ta_set_toan_tu, _SET_OPS_TOAN_TU
from il_features.set_type import il_set_type
import il_features.complex_type as _complex_type
import il_features.regex_match as _regex_match
from il_features.slicing import _ensure_class_slice, _SLICE_CLASS

_BIT_OPS: "dict[str, str]" = {'&': 'and', '|': 'or', '^': 'xor', '<<': 'shl', '>>': 'shr'}
_COMPOUND_ASSIGN_OPS: "dict[str, str]" = {'+=': '+', '-=': '-', '*=': '*', '/=': '/', '%=': '%', '//=': '//', '**=': '**', '&=': '&', '|=': '|', '^=': '^', '<<=': '<<', '>>=': '>>'}
_COMPOUND_OP_PATTERN = r'(//=|\*\*=|<<=|>>=|\+=|-=|\*=|/=|%=|&=|\|=|\^=)'
# Pattern VIET LIEN mot mach thay vi noi chuoi (2026-09-18): dang
# `re.compile(a + b)` lam `_re_compile_pattern` tu choi (no chi nhan
# MOT doi so la chuoi literal) -> chan phep gop self-host. Doan
# `(//=|\*\*=|<<=|>>=|\+=|-=|\*=|/=|%=|&=|\|=|\^=)` chinh la `_COMPOUND_OP_PATTERN` o tren -
# giu hang do lai vi cho khac con doc, nhung KHONG noi vao day nua.
_COMPOUND_INDEX_RE = re.compile(r'^(\w+)\[(.+)\]\s*(//=|\*\*=|<<=|>>=|\+=|-=|\*=|/=|%=|&=|\|=|\^=)\s*(.+)$')
_COMPOUND_VAR_RE = re.compile(r'^(\w+)\s*(//=|\*\*=|<<=|>>=|\+=|-=|\*=|/=|%=|&=|\|=|\^=)\s*(.+)$')

_DENSE_RE = re.compile(r"^(\w+)\s*=\s*dense\(\s*(\w+)\s*,\s*(\w+)\s*,\s*(\w+)\s*,\s*['\"](\w+)['\"]\s*\)\s*$")
_DENSE_ACTIVATIONS: "set[str]" = {'none', 'tanh', 'sigmoid', 'relu'}
_NORMALIZE_RE = re.compile(r'^(\w+)\s*=\s*normalize\(\s*(\w+)\s*,\s*(\w+)\s*,\s*(\w+)\s*\)\s*$')
_ARGMAX_RE = re.compile(r'^(\w+)\s*=\s*argmax\(\s*(\w+)\s*\)\s*$')
_BINOP_MACRO_RE = re.compile(r'^(\w+)\s*=\s*(add|sub|mul)\(\s*(\w+)\s*,\s*(\w+)\s*\)\s*$')
_BINOP_MACRO_OP: "dict[str, str]" = {'add': '+', 'sub': '-', 'mul': '*'}
_SCALE_RE = re.compile(r'^(\w+)\s*=\s*scale\(\s*(\w+)\s*,\s*([\w.\-]+)\s*\)\s*$')
_MATVEC_RE = re.compile(r'^(\w+)\s*=\s*matvec\(\s*(\w+)\s*,\s*(\w+)\s*\)\s*$')
_APPLY_RE = re.compile(r"^(\w+)\s*=\s*apply\(\s*(\w+)\s*,\s*['\"](\w+)['\"]\s*\)\s*$")
_APPLY_FUNCS: "set[str]" = {'tanh', 'sigmoid', 'relu', 'exp', 'sqrt', 'sin', 'cos', 'abs'}


__tkv_import__ = "il_dispatch"


def _emit_int_floor_div_or_mod(node: "TkvNode", op: "str", left: "TkvNode", right: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'//' va '%' tren SO NGUYEN theo dung ngu nghia Python (2026-08-03).

    CIL 'div'/'rem' cat VE 0 (giong C#); Python lam tron VE AM VO CUC:
        Python: -7 // 2 == -4, -7 % 3 == 2
        CIL   : -7 /  2 == -3, -7 rem 3 == -1
    Voi 2 toan hang CUNG DAU thi trung nhau - vi vay bug nay AM THAM:
    bien dich duoc, chay duoc, chi sai khi gap so am. Do THAT bang cach
    doi chieu CPython (scratch/probe_confidence.py) moi lo ra.

    Sua theo dung cong thuc chuan:
        q = a / b ; r = a rem b
        neu r != 0 VA (a XOR b) < 0  ->  q = q - 1   (floor div)
        neu r != 0 VA (r XOR b) < 0  ->  r = r + b   (modulo)
    'a XOR b < 0' = "hai toan hang KHAC DAU" (bit dau khac nhau) - re hon
    2 phep so sanh rieng.

    Can 4 o nho vi moi toan hang dung LAI nhieu lan; chung duoc cap phat o
    first-pass qua _walk_intdiv_nodes (il_codegen.py) voi khoa id(node)."""
    compile_expr = ctx.compile_expr
    try:
        a_idx = scope.tra(f'__idiv{nid(node)}_a').idx
        b_idx = scope.tra(f'__idiv{nid(node)}_b').idx
        q_idx = scope.tra(f'__idiv{nid(node)}_q').idx
        r_idx = scope.tra(f'__idiv{nid(node)}_r').idx
    except KeyError:
        raise SyntaxError(
            "il_codegen: '//' hoac '%' tren so nguyen thieu o nho tam - bieu thuc nay "
            "khong di qua first-pass (bao loi thay vi sinh ma cat-ve-0 SAI am tham)")

    zero = '    ldc.i4.0' if dtype == 'i32' else '    ldc.i8 0'
    one = '    ldc.i4.1' if dtype == 'i32' else '    ldc.i8 1'

    compile_expr(left, scope, out, dtype, ctx)
    out.append(f'    stloc.s {a_idx}')
    compile_expr(right, scope, out, dtype, ctx)
    out.append(f'    stloc.s {b_idx}')
    out.append(f'    ldloc.s {a_idx}')
    out.append(f'    ldloc.s {b_idx}')
    out.append('    div')
    out.append(f'    stloc.s {q_idx}')
    out.append(f'    ldloc.s {a_idx}')
    out.append(f'    ldloc.s {b_idx}')
    out.append('    rem')
    out.append(f'    stloc.s {r_idx}')

    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    done_lbl = f"{ctx.prefix}_idiv{n}_done"

    # Khong can chinh khi r == 0 (chia het).
    out.append(f'    ldloc.s {r_idx}')
    out.append(zero)
    out.append(f'    beq {done_lbl}')
    # Khong can chinh khi 2 ve CUNG DAU.
    if op == '//':
        out.append(f'    ldloc.s {a_idx}')
    else:
        out.append(f'    ldloc.s {r_idx}')
    out.append(f'    ldloc.s {b_idx}')
    out.append('    xor')
    out.append(zero)
    out.append(f'    bge {done_lbl}')
    if op == '//':
        out.append(f'    ldloc.s {q_idx}')
        out.append(one)
        out.append('    sub')
        out.append(f'    stloc.s {q_idx}')
    else:
        out.append(f'    ldloc.s {r_idx}')
        out.append(f'    ldloc.s {b_idx}')
        out.append('    add')
        out.append(f'    stloc.s {r_idx}')
    out.append(f'  {done_lbl}:')
    out.append(f'    ldloc.s {q_idx if op == "//" else r_idx}')


def _narrow_int_result(dtype: "str", out: "list[str]", ctx: "Ctx"):
    """BUG THAT (2026-08-05 lat 4): cac nhanh 'int' cua compile_binop day
    len stack mot TkvInt va TRA VE NGAY, bo qua `dtype` ma NGU CANH yeu
    cau. Truoc khi 'int' la mac dinh toan cuc dieu do vo hai vi chi ma
    trong ham '-> int' moi di vao day. Nay 'a * 100 + b' trong mot ham
    '-> i32' sinh 'ret' voi mot STRUCT tren stack o cho khai bao int32:
    ilasm nuot, chuong trinh in ra 0 - SAI AM THAM, dung lop nguy hiem
    nhat. Thu hep CO KIEM TRA qua chinh _widen_if_needed."""
    if dtype is not None and dtype != 'int':
        ctx.widen_if_needed('int', dtype, out)


def ta_ds_cua_nut(node: "TkvNode", scope: "Scope", ctx: "Ctx") -> "TypeAnn":
    """TypeAnn (shape 'list') cua mot bieu thuc-list dung o '+' (2026-09-29):
    bien list, loi goi ham tra list, hoac chinh phep '+' cua hai list. Literal
    '[a, b]' khong co TypeAnn rieng (tra None - lay kieu tu ve ben kia)."""
    k = ekind(node)
    if k == 'var' or k == 'slice':
        try:
            ta = scope.tra(ea_str(node)).ta
        except (KeyError, SyntaxError):
            return None
        if ta is not None and ta.shape_ten == 'list':
            return ta
        return None
    if k == 'call':
        sig = None
        if ctx is not None and ctx.func_table:
            sig = ctx.func_table.get(ea_str(node))
        if sig is not None and sig.return_type is not None and sig.return_type.shape_ten == 'list':
            return sig.return_type
        return None
    if k == 'binop' and ea_str(node) == '+':
        ta_l = ta_ds_cua_nut(eb_nut(node), scope, ctx)
        if ta_l is not None:
            return ta_l
        return ta_ds_cua_nut(ec_nut(node), scope, ctx)
    return None


def _compile_noi_list(ta: "TypeAnn", left: "TkvNode", right: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """'a + b' voi hai list: List<T> MOI = a roi AddRange(b) (khong sua a, b)."""
    if ta.elem_ta is not None:
        raise SyntaxError(
            "il_codegen: '+' tren list chua container long nhau (list[list[...]]) chua ho tro")
    list_type = il_list_type(ta.dtype, ctx.records)
    out.append(f'    newobj instance void {list_type}::.ctor()')
    for ve in (left, right):
        out.append('    dup')
        ctx.compile_expr(ve, scope, out, ta.dtype, ctx)
        out.append(f'    callvirt instance void {list_type}::AddRange(class '
                   f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')


def _compile_lap_list(ta: "TypeAnn", ds_node: "TkvNode", n_node: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """'ds * n': List<T> MOI gom n ban sao noi tiep cua ds (n <= 0 -> rong), goi TkvSlice::RepL<T>."""
    if ta.elem_ta is not None:
        raise SyntaxError(
            "il_codegen: '*' tren list chua container long nhau (list[list[...]]) chua ho tro - "
            "dung vong lap/comprehension de tao tung dong rieng")
    _ensure_class_slice(ctx)
    elem_il = il_list_elem_ilstr(ta.dtype, ctx.records)
    ctx.compile_expr(ds_node, scope, out, ta.dtype, ctx)
    ctx.compile_expr(n_node, scope, out, 'i32', ctx)
    out.append(f'    call class [mscorlib]System.Collections.Generic.List`1<!!0> {_SLICE_CLASS}::RepL<{elem_il}>'
               f'(class [mscorlib]System.Collections.Generic.List`1<!!0>, int32)')


def compile_binop(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"=None):
    """EXPR_CODEGEN entry cho tag 'binop' - nhanh string uy quyen ra
    ctx['compile_binop_concat'] (string_feature.py), phan con lai (so
    hoc +-*/%) o day."""
    op, left, right = ea_str(node), eb_nut(node), ec_nut(node)
    if op == '*' and ctx is not None:
        # lap list 'ds * n' / 'n * ds' (literal, bien, loi goi ham) - TkvSlice::RepL (2026-09-30)
        ta_lap = _ilc._ta_ds_hang(left, scope)
        if ta_lap is None:
            ta_lap = ta_ds_cua_nut(left, scope, ctx)
        if ta_lap is not None:
            _compile_lap_list(ta_lap, left, right, scope, out, ctx)
            return
        ta_lap = _ilc._ta_ds_hang(right, scope)
        if ta_lap is None:
            ta_lap = ta_ds_cua_nut(right, scope, ctx)
        if ta_lap is not None:
            _compile_lap_list(ta_lap, right, left, scope, out, ctx)
            return
    if op == '|' and ctx is not None and ekind(left) == 'var':
        try:
            ta_dict = scope.tra(ea_str(left)).ta
        except (KeyError, SyntaxError):
            ta_dict = None
        if ta_dict is not None and ta_dict.shape_ten == 'dict':
            raise SyntaxError("il_codegen: 'dict | dict' chua ho tro - dung d.update(other) (2026-10-01)")
    if op in _SET_OPS_TOAN_TU and ctx is not None:
        ta_tap = ta_set_toan_tu(node, scope)
        if ta_tap is not None:
            # phep toan tap hop: HashSet MOI chep tu ben trai roi UnionWith/... (2026-09-30)
            kieu_tap = il_set_type(ta_tap.dtype, ctx.records)
            ctx.compile_expr(left, scope, out, ta_tap.dtype, ctx)
            out.append(f'    newobj instance void {kieu_tap}::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
            out.append('    dup')
            ctx.compile_expr(right, scope, out, ta_tap.dtype, ctx)
            out.append(f'    callvirt instance void {kieu_tap}::{_SET_OPS_TOAN_TU[op]}(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
            return
    if op == '+' and ctx is not None:
        ta_ds = ta_ds_cua_nut(left, scope, ctx)
        if ta_ds is None:
            ta_ds = ta_ds_cua_nut(right, scope, ctx)
        if ta_ds is not None:
            _compile_noi_list(ta_ds, left, right, scope, out, ctx)
            return
    infer_dtype = ctx.infer_dtype
    func_table = (ctx.func_table if ctx is not None else None)
    # Suy dtype THAT cua toan hang tu chinh no (khong dua vao `dtype`
    # ben ngoai) - can THIET khi ham co CA bien so lan bien string: vd
    # ham numeric goi 1 bieu thuc con la string-concat, `dtype` truyen
    # vao la numeric nhung toan hang '+' o day la 2 string.
    left_dtype = infer_dtype(left, scope, func_table, None, None, None)
    right_dtype = infer_dtype(right, scope, func_table, None, None, None)
    operand_dtype = _ilc._hop_kieu_so(left_dtype, right_dtype) or dtype
    if (operand_dtype in _ilc._KIEU_NGUYEN or left_dtype is None and right_dtype is None) and (_ilc._contains_float_literal(left) or _ilc._contains_float_literal(right)) and op in ('+', '-', '*', '/', '%'):
        operand_dtype = 'f64'
    records = (ctx.records if ctx is not None else None) or {}
    if op == '+' and operand_dtype in records:
        # __add__ cho record (6.5, dunder overload - muc 5/5, 2026-08-13):
        # a + b tren 2 gia tri CUNG kieu record co
        # __add__(self, other) -> T goi callvirt. KHONG co fallback mac
        # dinh nhu __eq__ - thieu __add__ la loi RO, khong ROI xuong
        # nhanh 'add' CIL tren 2 object reference (vo nghia/crash).
        record_methods = (ctx.record_methods if ctx is not None else None) or {}
        dunder = record_methods.get(operand_dtype, {}).get('__add__')
        if dunder is None:
            raise SyntaxError(
                f"il_codegen: record '{operand_dtype}' khong co __add__ - "
                f"'+' tren record can dinh nghia "
                f"'def __add__(self, other) -> \"T\": ...' (T la kieu tra ve tuy chon)")
        record_bases = (ctx.record_bases if ctx is not None else None) or {}
        ancestors = {operand_dtype}
        walk = operand_dtype
        while len(cac_base(record_bases, walk)) == 1:
            walk = cac_base(record_bases, walk)[0]
            ancestors.add(walk)
        if len(dunder.params) != 1 or \
                dunder.params[0].type_ann.dtype not in ancestors or \
                dunder.params[0].type_ann.shape_ten != 'record' or \
                dunder.return_type is None:
            raise SyntaxError(
                f"il_codegen: record '{operand_dtype}' co __add__ nhung chu ky sai - "
                f"can dung 1 tham so CUNG kieu record (hoac to tien) va tra ve 1 kieu "
                f"bat ky ('def __add__(self, other) -> \"T\":')")
        compile_expr = ctx.compile_expr
        compile_expr(left, scope, out, operand_dtype, ctx)
        compile_expr(right, scope, out, operand_dtype, ctx)
        owner = _method_owner_class(ctx, operand_dtype, '__add__')
        param_il = ctx.il_type_str(dunder.params[0].type_ann, records)
        ret_dtype = dunder.return_type.dtype
        ret_il = ctx.il_type_str(dunder.return_type, records)
        out.append(f'    callvirt instance {ret_il} {owner}::__add__({param_il})')
        if dunder.return_type.la_vo_huong():
            ctx.widen_if_needed(ret_dtype, dtype, out)
        return
    if op == '/' and (operand_dtype == 'i32' or operand_dtype == 'i64') and not la_dtype_ngay_gio(left_dtype) and not la_dtype_ngay_gio(right_dtype):
        # '/' giua hai so nguyen tra FLOAT nhu Python (2026-10-02; truoc day chia nguyen, sai am tham: 7/2 -> 3):
        # doi ca hai ve f64 roi chia; chia cho 0 van nem ZeroDivisionError (float chia 0 chi cho inf).
        if dtype == 'i32' or dtype == 'i64':
            raise SyntaxError("il_codegen: '/' giua hai so nguyen tra SO THUC (Python 3) nhung ngu canh doi so nguyen "
                              "(vd 'return a / b' trong ham -> \"i32\", hoac gan vao bien i32) - dung '//' cho chia nguyen, "
                              "hoac khai bao ket qua la \"f64\"")
        ctx.label_counter[0] += 1
        nk = ctx.label_counter[0]
        khac0 = f'{ctx.prefix}_tdiv{nk}_nz'
        ctx.compile_expr(left, scope, out, operand_dtype, ctx)
        out.append('    conv.r8')
        ctx.compile_expr(right, scope, out, operand_dtype, ctx)
        out.append('    dup')
        out.append(f'    brtrue {khac0}')
        out.append('    pop')
        out.append('    ldstr "division by zero"')
        out.append('    newobj instance void [mscorlib]System.DivideByZeroException::.ctor(string)')
        out.append('    throw')
        out.append(f'  {khac0}:')
        out.append('    conv.r8')
        out.append('    div')
        ctx.widen_if_needed('f64', dtype, out)
        return
    if (la_dtype_ngay_gio(left_dtype) or la_dtype_ngay_gio(right_dtype)) and hop_kieu_ngay_gio(op, left_dtype, right_dtype) != '':
        # datetime/date/timedelta (2026-10-02): cung la int64 ticks - cong/tru/nhan/chia nguyen tren ticks; moi ve bien dich
        # theo CHINH dtype cua no (so nguyen hang -> i64), khong theo dtype ngu canh (vd 'timedelta' khong co lenh ldc).
        dt_l = left_dtype
        if not la_dtype_ngay_gio(dt_l):
            dt_l = 'i64'
        dt_r = right_dtype
        if not la_dtype_ngay_gio(dt_r):
            dt_r = 'i64'
        ctx.compile_expr(left, scope, out, dt_l, ctx)
        ctx.compile_expr(right, scope, out, dt_r, ctx)
        if op == '+':
            out.append('    add')
        elif op == '-':
            out.append('    sub')
        elif op == '*':
            out.append('    mul')
        else:
            out.append('    div')
        return
    if operand_dtype == 'str' or (op == '*' and 'str' in (left_dtype, right_dtype)):
        # '"ab" * 3' VA '3 * "ab"' (2026-08-03): Python cho phep ca 2
        # chieu. Chieu thu hai co left_dtype='i32' nen KHONG loc duoc bang
        # operand_dtype - phai xet ca hai ve, neu khong no roi xuong nhanh
        # so hoc va sinh 'mul' tren 1 tham chieu chuoi (AccessViolation
        # luc chay - da gap THAT khi test).
        ctx.compile_binop_concat(op, left, right, scope, out, ctx)
        return
    if dtype == 'int' and operand_dtype in ('i32', 'i64'):
        # BUG THAT (2026-08-05 lat 4): khi NGU CANH doi 'int' nhung ca hai
        # toan hang suy ra i32/i64 (vd 'lst[i] * (i + 1)' voi lst la
        # list[i32]), nhanh so-may ben duoi bien dich TUNG toan hang voi
        # dtype='int' - tuc moi ben bi nang thanh TkvInt - roi sinh
        # 'mul.ovf'/'add.ovf' TREN HAI STRUCT. ilasm nuot, CLR nem
        # BadImageFormatException luc chay (list_batch3_test). Tinh o kieu
        # 'int' moi la dung ca ve IL lan ve ngu nghia Python.
        operand_dtype = 'int'
    if op in _BIT_OPS and operand_dtype not in ('int', 'i32', 'i64', 'bool', 'i16', 'i8', 'u8', 'u16', 'u32', 'u64'):
        raise SyntaxError(
            f"il_codegen: toan tu bit '{op}' chi ho tro tren so nguyen (int/i32/i64/bool), "
            f"gap kieu {operand_dtype!r}")
    if op in _BIT_OPS and operand_dtype != 'int':
        # so nguyen may: 'and'/'or'/'xor'/'shl'/'shr' (shr = dich so hoc, lam tron ve am vo cuc
        # nhu Python). Ket qua rong theo kieu toan hang, khong tran (chi khac Python khi dich trai tran).
        _bit_dt = 'i64' if 'i64' in (left_dtype, right_dtype) else ('i32' if operand_dtype == 'bool' else operand_dtype)
        ctx.compile_expr(left, scope, out, _bit_dt, ctx)
        ctx.compile_expr(right, scope, out, ('i32' if op in ('<<', '>>') else _bit_dt), ctx)
        out.append('    ' + _BIT_OPS[op])
        return
    if operand_dtype == 'int' and op in ('+', '-', '*'):
        # Kieu 'int' vo han chu so (moc 6 buoc 2, 2026-08-05) - duong
        # nhanh noi tuyen + duong cham BigInteger, xem int_type.py.
        compile_binop_int(op, left, right, scope, out, ctx)
        _narrow_int_result(dtype, out, ctx)
        return
    if operand_dtype == 'int':
        # Moc 6 lat 2 (2026-08-05). Ba phep nay di helper chu khong noi
        # tuyen - xem int_type.compile_divmod_pow.
        if op in ('//', '%', '**', '&', '|', '^', '<<', '>>'):
            compile_divmod_pow(op, left, right, scope, out, ctx)
            _narrow_int_result(dtype, out, ctx)
            return
        if op == '/':
            # Python true division: int / int -> float (2026-09-30, qua TkvInt::ToF64 moi ben roi div)
            _int_type.ensure_class_int(ctx)
            ctx.compile_expr(left, scope, out, 'int', ctx)
            out.append('    call float64 TkvInt::ToF64(valuetype TkvInt)')
            ctx.compile_expr(right, scope, out, 'int', ctx)
            out.append('    call float64 TkvInt::ToF64(valuetype TkvInt)')
            out.append('    div')
            return
    if operand_dtype == 'complex':
        # Muc 6.8 (2/4, 2026-08-13): '+'/'-'/'*'/'/' giua 2 gia tri
        # 'complex' - uy quyen ra complex_type.py (goi static Add/Subtract/
        # Multiply/Divide co san tren System.Numerics.Complex).
        compile_binop_complex(op, left, right, scope, out, ctx)
        return
    if operand_dtype == 'f32x4':
        # (port 2026-10-06 tu bootstrap operators): '+'/'-'/'*'/'/' giua 2
        # gia tri 'f32x4' - uy quyen ra vector4_type.py (operator op_* cua
        # System.Numerics.Vector4, 1 lenh = 4 MAC).
        compile_binop_vector4(op, left, right, scope, out, ctx)
        return
    compile_expr = ctx.compile_expr
    if op == '**':
        # 'x ** y' (Wave 3, 2026-07-29) - tai dung THANG pow()'s codegen
        # (System.Math::Pow, chi co overload float64) - KHONG viet lai.
        _compile_pow([left, right], scope, out, dtype, ctx)
        return
    if op in ('//', '%') and operand_dtype in ctx.int_dtypes:
        # SUA 2026-08-03: truoc day dung THANG 'div'/'rem' cua CIL (cat ve
        # 0) va ghi chu do la "gioi han co y thuc" - nhung do la SAI AM
        # THAM voi so am, khong phai gioi han chap nhan duoc. Nay sinh dung
        # ngu nghia floor cua Python.
        _emit_int_floor_div_or_mod(node, op, left, right, scope, out,
                                           operand_dtype, ctx)
        return
    if op == '//':
        # Con lai: dtype THUC (f32/f64) - Math.Floor(a/b), khong co van de
        # dau (Floor dung nghia THAT).
        float_dtypes = ctx.float_dtypes
        compile_expr(left, scope, out, dtype, ctx)
        compile_expr(right, scope, out, dtype, ctx)
        out.append('    div')
        if operand_dtype in float_dtypes:
            if dtype != 'f64':
                out.append('    conv.r8')
            out.append('    call float64 [mscorlib]System.Math::Floor(float64)')
            if dtype != 'f64':
                out.append(f'    {IL_LDC_OP[dtype].replace("ldc.", "conv.")}')
        return
    compile_expr(left, scope, out, dtype, ctx)
    compile_expr(right, scope, out, dtype, ctx)
    if operand_dtype in ctx.int_dtypes and op in ('+', '-', '*'):
        # TRAN SO PHAI BAO, KHONG DUOC IM LANG (2026-08-04).
        #
        # Python co so nguyen VO HAN chu so; TokenVector chi co i32/i64.
        # Truoc ban va nay, 'add'/'sub'/'mul' cua CIL QUAN VONG lang le:
        #   fact(13) -> CPython 6227020800, TokenVector 1932053504
        #   fact(20) -> CPython 2432902008176640000, TokenVector -2102132736
        #   2**31    -> CPython 2147483648, TokenVector -2147483648  (AM!)
        # 13! la mot phep tinh HET SUC BINH THUONG, va no da sai san.
        #
        # 'add.ovf'/'sub.ovf'/'mul.ovf' nem OverflowException thay vi tra
        # so rac. Day CHUA phai ngang bang Python (Python tra dung ket qua,
        # khong nem), nhung theo dung thu tu uu tien cua du an: sai AM THAM
        # nguy hiem hon han loi ON AO. Buoc sau moi doi bieu dien sang
        # BigInteger de ngang bang that.
        #
        # KHONG ap cho '/' va '%': '//' va '%' so nguyen di duong rieng
        # (_emit_int_floor_div_or_mod) va phep chia khong the tran, tru
        # MIN_VALUE / -1 - truong hop do CIL da tu nem roi.
        out.append({'+': '    add.ovf', '-': '    sub.ovf',
                    '*': '    mul.ovf'}[op])
        return
    out.append({'+': '    add', '-': '    sub', '*': '    mul', '/': '    div', '%': '    rem'}[op])


def compile_boolop(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"=None):
    """EXPR_CODEGEN entry cho tag 'boolop' - toan hang la ket qua so
    sanh (int32 0/1) - dung dtype='i32' rieng cho ca 2 ve (khac
    'compare', noi TOAN HANG dung dtype that con KET QUA moi la i32).

    SHORT-CIRCUIT (2026-08-02): ban truoc sinh THANG 'and'/'or' bitwise
    cua CIL, tuc TINH CA HAI VE roi moi hop nhat - SAI ngu nghia Python
    va la loi THAT da xac minh: 'i < len(lst) and lst[i] == x' nem
    ArgumentOutOfRangeException khi i == len(lst), du ve trai da sai.
    Probe: test/sc_probe.tkv.

    Nay sinh nhanh nhay theo mau CIL chuan, KHONG can bien tam (khac
    ternary): 'dup' giu lai gia tri ve trai lam KET QUA neu nhay tat.
        a and b:  <a> dup brfalse END pop <b> END:
        a or  b:  <a> dup brtrue  END pop <b> END:
    Ca 2 duong vao END deu de dung 1 gia tri i32 tren stack nen stack
    hop le. Ve phai CHI chay khi ve trai khong quyet dinh duoc ket qua.
    """
    op, left, right = ea_str(node), eb_nut(node), ec_nut(node)
    compile_expr = ctx.compile_expr
    # Ctx LUON co label_counter (khoi tao trong __init__) - dieu kien cu
    # "'label_counter' not in ctx" luon sai (2026-09-25).
    if ctx is None:
        # Khong co bo dem nhan (duong goi phu, vd _eval_const_dim) -
        # giu hanh vi cu, khong short-circuit. An toan vi cac duong nay
        # chi tinh hang so, khong co truy cap phan tu.
        compile_expr(left, scope, out, 'i32', ctx)
        compile_expr(right, scope, out, 'i32', ctx)
        out.append('    and' if op == 'and' else '    or')
        return

    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    end_lbl = f"{ctx.prefix}_sc{n}_end"
    nap_chan_ly(left, scope, out, ctx)
    out.append('    dup')
    out.append(f"    {'brfalse' if op == 'and' else 'brtrue'} {end_lbl}")
    out.append('    pop')
    nap_chan_ly(right, scope, out, ctx)
    out.append(f'  {end_lbl}:')


def compile_neg(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"=None):
    if dtype == 'int':
        # 'neg' cua CIL an mot SO MAY, kieu 'int' la struct - xem
        # int_type.compile_neg.
        compile_neg_int(ea_nut(node), scope, out, ctx)
        return
    ctx.compile_expr(ea_nut(node), scope, out, dtype, ctx)
    out.append('    neg')


def compile_not(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"=None):
    """'not expr' - phu dinh boolean, toan hang la ket qua 0/1 (i32,
    giong 'boolop') - 'ceq' voi 0 la cach CIL chuan lat 0/1 (khong co
    opcode 'not' rieng cho boolean, chi co 'not' bitwise tren so nguyen
    - dung sai o day se lat SAI bit thay vi lat gia tri 0/1)."""
    # P6 (2026-09-08): 'not m' voi m la ket qua khop regex. Bien dich toan
    # hang o kieu 'i32' se day nguyen HANDLE len stack roi so voi 0 - tuc
    # thu NULL, ma Regex.Match tra ve Match.Empty (doi tuong THAT) khi khong
    # khop -> 'not m' LUON cho 0. Loi nay khong crash, chi cho ket qua SAI:
    # phat hien vi .exe lech CPython dung o ca "khong khop".
    _nat = None
    if ctx is not None and ctx.infer_dtype is not None:
        _nat = ctx.infer_dtype(ea_nut(node), scope, ctx.func_table,
                                  ctx.records, ctx.record_methods, None)
    if _nat == 'match':
        ctx.compile_expr(ea_nut(node), scope, out, 'match', ctx)
        emit_success(out)
        out.append('    ldc.i4.0')
        out.append('    ceq')
        return
    nap_chan_ly(ea_nut(node), scope, out, ctx)
    out.append('    ldc.i4.0')
    out.append('    ceq')


_EQ_HELPER_CLASS = 'TkvEq'


def _ensure_class_eq(ctx: "Ctx"):
    """TkvEq::ListEq<T>(a, b): 'a == b' cua hai list la so sanh NOI DUNG nhu Python
    (2026-09-29). Truoc day 'ceq' tren tham chieu: hai list bang nhau van la False.
    null == null la True; mot ben null la False. Sinh 1 lan/chuong trinh."""
    emitted = ctx.emitted_types
    if emitted is None or _EQ_HELPER_CLASS in emitted:
        return
    emitted.add(_EQ_HELPER_CLASS)
    lst = 'class [mscorlib]System.Collections.Generic.List`1<!!0>'
    ienum = 'class [mscorlib]System.Collections.Generic.IEnumerable`1<!!0>'
    ctx.extra_classes.append([
        f'.class public auto ansi beforefieldinit {_EQ_HELPER_CLASS} extends [mscorlib]System.Object',
        '{',
        f'  .method public static bool ListEq<T>({lst} a, {lst} b) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldarg.0',
        '    ldarg.1',
        '    ceq',
        '    brfalse TKVEQ_KHAC',
        '    ldc.i4.1',
        '    ret',
        '  TKVEQ_KHAC:',
        '    ldarg.0',
        '    brfalse TKVEQ_SAI',
        '    ldarg.1',
        '    brfalse TKVEQ_SAI',
        '    ldarg.0',
        '    ldarg.1',
        f'    call bool [System.Core]System.Linq.Enumerable::SequenceEqual<!!0>({ienum}, {ienum})',
        '    ret',
        '  TKVEQ_SAI:',
        '    ldc.i4.0',
        '    ret',
        '  }',
        '}',
    ])


def _la_ds_rong_literal(nut: "TkvNode") -> "i32":
    return ekind(nut) == 'list_literal' and len(ea_ds(nut)) == 0


def _ta_ds_so_sanh(nut: "TkvNode", scope: "Scope", ctx: "Ctx") -> "TypeAnn":
    """TypeAnn list cua 1 toan hang '==': bien/truong/loi goi ham, hoac ket qua cua
    method (property da duoc bung thanh 'x.ten()'). None neu khong phai list."""
    ta = container_var_ta(nut, scope, ctx)
    if ta is not None:
        return ta
    if ekind(nut) == 'list_literal' and len(ea_ds(nut)) > 0:
        # '[x] == ds' (2026-09-29): literal list vo huong - dtype chung cua cac phan tu
        chung = None
        for el in ea_ds(nut):
            try:
                d_el = _ilc._infer_dtype(ctx.reg, el, scope, ctx.func_table, ctx.records, ctx.record_methods)
            except (KeyError, SyntaxError):
                return None
            if d_el is None and ekind(el) == 'num':
                d_el = 'f64' if '.' in ea_str(el) else 'i32'
            if d_el not in ('str', 'i32', 'i64', 'f32', 'f64') or (chung is not None and d_el != chung):
                return None
            chung = d_el
        return TypeAnn(chung, 'list')
    try:
        return _ilc._shaped_return_ta_of_call(ctx.reg, nut, ctx.func_table, scope, ctx.records, ctx.record_methods)
    except (KeyError, SyntaxError):
        return None


def _compile_so_sanh_ds(op: "str", left: "TkvNode", right: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx") -> "i32":
    """'a == b' / 'a != b' tren list: so sanh NOI DUNG. Tra True neu da xu ly."""
    if _la_ds_rong_literal(right) or _la_ds_rong_literal(left):
        nut = left if _la_ds_rong_literal(right) else right
        ta_n = container_var_ta(nut, scope, ctx)
        if ta_n is None or ta_n.shape_ten != 'list':
            return False
        # 'x == []' <=> x rong (None cung khac []): Count > 0 doi ngau
        nap_container_khong_rong(nut, ta_n, scope, out, ctx)
        if op == '==':
            out.append('    ldc.i4.0')
            out.append('    ceq')
        return True
    ta_l = _ta_ds_so_sanh(left, scope, ctx)
    ta_r = _ta_ds_so_sanh(right, scope, ctx)
    if ta_l is None or ta_r is None or ta_l.shape_ten != 'list' or ta_r.shape_ten != 'list':
        return False
    if ta_l.elem_ta is not None or ta_r.elem_ta is not None or ta_l.dtype != ta_r.dtype:
        return False
    _ensure_class_eq(ctx)
    ctx.compile_expr(left, scope, out, ta_l.dtype, ctx)
    ctx.compile_expr(right, scope, out, ta_l.dtype, ctx)
    lst = 'class [mscorlib]System.Collections.Generic.List`1<!!0>'
    out.append(f'    call bool {_EQ_HELPER_CLASS}::ListEq<{il_list_elem_ilstr(ta_l.dtype, ctx.records)}>({lst}, {lst})')
    if op == '!=':
        out.append('    ldc.i4.0')
        out.append('    ceq')
    return True


def _container_ta(node: "TkvNode", scope: "Scope", records: "dict[str,list[(str,TkvTypeAnn)]]") -> "TypeAnn":
    """TypeAnn cua toan hang neu no la CONTAINER (list/dict/set/...).

    Tra None neu toan hang khong phai bien container - tuc la hoac la
    scalar, hoac la bien chua co TypeAnn (chua qua first-pass).

    Ly do can ham nay (port 2026-10-06 tu bootstrap operators L~641):
    _infer_dtype tra dtype ma BO QUA shape. `a = [1, 2]` suy ra dtype='int'
    (tu literal) nen `a == b` cho hai list di vao nhanh TkvInt va nem
    InvalidCastException luc chay - `TkvInt.Cmp` cuon mot `List<int>`
    reference. So sanh 2 container phai la SO THAM CHIEU (`ceq` tren 2
    object reference), va day la thu duy nhat co y nghia dung trong
    runtime .NET."""
    if ekind(node) != 'var':
        return None
    vname = ea_str(node)
    if vname not in scope:
        return None
    ta = scope.tra(vname).ta
    if ta is None or ta.shape_ten not in (
            'list', 'dict', 'set', 'frozenset', 'defaultdict', 'counter'):
        return None
    return ta


def _compile_container_compare(op: "str", left: "TkvNode", right: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx", records: "dict[str,list[(str,TkvTypeAnn)]]", dtype: "str") -> "i32":
    """'==' / '!=' tren 2 container: SO THAM CHIEU bang `ceq`.

    Tra 1 neu da xu ly xong (ca hai deu bien container). Tra 0 neu 1 trong
    2 ve khong phai bien container (de caller di tiep duong cu)."""
    lta = _container_ta(left, scope, records)
    rta = _container_ta(right, scope, records)
    if lta is None and rta is None:
        return 0
    if lta is None or rta is None:
        return 0
    if op != '==' and op != '!=':
        raise SyntaxError(
            "il_codegen: '" + op + "' khong ap dung cho container (chi '==' va '!=' "
            "- so sanh vung tren tham chieu khong co nghia; hay so sanh "
            "theo phan tu)")
    # Nap bang dtype PHAN TU: truyen dtype container se bien bien thanh gia tri.
    ctx.compile_expr(left, scope, out, lta.dtype, ctx)
    ctx.compile_expr(right, scope, out, rta.dtype, ctx)
    out.append('    ceq')
    if op == '!=':
        out.append('    ldc.i4.0')
        out.append('    ceq')
    return 1


def compile_compare(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"=None):
    """EXPR_CODEGEN entry cho tag 'compare' - nhanh string uy quyen ra
    ctx['compile_compare_str'] (string_feature.py), phan con lai (so
    sanh so hoc) o day. Ket qua LUON la int32 0/1 (khong phai dtype cua
    toan hang) - dung ceq/cgt/clt CHUAN CIL, cac toan tu con lai
    (!=,>=,<=) suy tu 3 cai do bang 1 lan phu dinh (ldc.i4.0; ceq).
    __eq__ cho record (6.5, dunder overload - muc 2, 2026-08-13): '=='/
    '!=' tren 2 gia tri CUNG kieu record co __eq__(self, other) -> "i32"
    goi callvirt thay vi ceq (reference-compare mac dinh)."""
    op, left, right = ea_str(node), eb_nut(node), ec_nut(node)
    # (2026-10-06) Hai bien container thi so THAM CHIEU (ceq) truoc moi
    # nhanh khac - neu khong, `a == b` voi hai list di vao TkvInt::Cmp va
    # nem InvalidCastException luc chay. `x == []` (1 ve la literal) van
    # roi xuong nhanh cu ben duoi.
    if (op == '==' or op == '!=') and ctx is not None and _compile_container_compare(op, left, right, scope, out, ctx, (ctx.records if ctx is not None else None) or {}, dtype) == 1:
        return
    if (op == '==' or op == '!=') and ctx is not None and _compile_so_sanh_ds(op, left, right, scope, out, ctx):
        return
    operand_dtype = ctx.resolve_compare_operand_dtype(
        left, right, scope, (ctx.func_table if ctx is not None else None), dtype,
        (ctx.records if ctx is not None else None), (ctx.record_methods if ctx is not None else None))
    if operand_dtype == 'str':
        ctx.compile_compare_str(op, left, right, scope, out, ctx)
        return
    if operand_dtype == 'int':
        compile_compare_int(op, left, right, scope, out, ctx)
        return
    compile_expr = ctx.compile_expr
    records = (ctx.records if ctx is not None else None) or {}
    if op in ('==', '!=') and operand_dtype in records:
        record_methods = (ctx.record_methods if ctx is not None else None) or {}
        dunder = record_methods.get(operand_dtype, {}).get('__eq__')
        if dunder is not None:
            record_bases = (ctx.record_bases if ctx is not None else None) or {}
            ancestors = {operand_dtype}
            walk = operand_dtype
            while len(cac_base(record_bases, walk)) == 1:
                walk = cac_base(record_bases, walk)[0]
                ancestors.add(walk)
            if len(dunder.params) != 1 or dunder.params[0].type_ann.dtype not in ancestors or \
                    dunder.params[0].type_ann.shape_ten != 'record' or \
                    dunder.return_type is None or dunder.return_type.dtype != 'i32' or \
                    not dunder.return_type.la_vo_huong():
                raise SyntaxError(
                    f"il_codegen: record '{operand_dtype}' co __eq__ nhung chu ky sai - can "
                    f"dung 1 tham so CUNG kieu record va tra ve \"i32\" "
                    f"('def __eq__(self, other) -> \"i32\":')")
            compile_expr(left, scope, out, operand_dtype, ctx)
            compile_expr(right, scope, out, operand_dtype, ctx)
            owner = _method_owner_class(ctx, operand_dtype, '__eq__')
            param_il = ctx.il_type_str(dunder.params[0].type_ann, records)
            out.append(f'    callvirt instance int32 {owner}::__eq__({param_il})')
            if op == '!=':
                out.append('    ldc.i4.0')
                out.append('    ceq')
            return
    if op in ('<', '>', '<=', '>=') and operand_dtype in records:
        # 2026-09-28: __lt__ cho so sanh vung tren record. Truoc nay chi co
        # '=='/'!=' nen 'a < b' roi xuong duong so hoc chung va tra ve MOT HANG
        # SO - im lang va SAI. KHONG co Testkit nao so sanh 2 record nen khong
        # ai bat.
        #
        # CHI can __lt__: '>' va '<=' goi __lt__ voi HAI VE DAO LAI, '>=' la
        # 'not __lt__' - dung y het Python, Python cung khong can __le__/__ge__.
        record_methods = (ctx.record_methods if ctx is not None else None) or {}
        lt = record_methods.get(operand_dtype, {}).get('__lt__')
        if lt is None:
            raise SyntaxError(
                f"il_codegen: so sanh vung ('{op}') tren record "
                f"'{operand_dtype}' can '__lt__' - record do chua viet. "
                f"Khong co no, phep so sanh se tra ve MOT HANG SO bat ke gia "
                f"tri, nen bien dich bao loi o day thay vi sinh ma sai. "
                f"(vd 'def __lt__(self, other) -> \"i32\":' - '>' va '>=' suy "
                f"ra tu __lt__ theo he hop nhu Python)")
        record_bases = (ctx.record_bases if ctx is not None else None) or {}
        ancestors = {operand_dtype}
        walk = operand_dtype
        while len(cac_base(record_bases, walk)) == 1:
            walk = cac_base(record_bases, walk)[0]
            ancestors.add(walk)
        if len(lt.params) != 1 or lt.params[0].type_ann.dtype not in ancestors or \
                lt.params[0].type_ann.shape_ten != 'record' or \
                lt.return_type is None or lt.return_type.dtype != 'i32' or \
                not lt.return_type.la_vo_huong():
            raise SyntaxError(
                f"il_codegen: record '{operand_dtype}' co __lt__ nhung chu ky "
                f"sai - can dung 1 tham so CUNG kieu record va tra ve \"i32\" "
                f"('def __lt__(self, other) -> \"i32\":')")
        # Thu tu len stack: this truoc, tham so sau. `swap` khi 'a > b' thanh
        # 'b.__lt__(a)'.
        if op in ('>', '<='):
            compile_expr(right, scope, out, operand_dtype, ctx)
            compile_expr(left, scope, out, operand_dtype, ctx)
        else:
            compile_expr(left, scope, out, operand_dtype, ctx)
            compile_expr(right, scope, out, operand_dtype, ctx)
        owner = _method_owner_class(ctx, operand_dtype, '__lt__')
        param_il = ctx.il_type_str(lt.params[0].type_ann, records)
        out.append(f'    callvirt instance int32 {owner}::__lt__({param_il})')
        if op in ('<=', '>='):
            out.append('    ldc.i4.0')
            out.append('    ceq')
        return
    compile_expr(left, scope, out, operand_dtype, ctx)
    compile_expr(right, scope, out, operand_dtype, ctx)
    compare_opcode, compare_negated = ctx.compare_opcode, ctx.compare_negated
    if op in compare_opcode:
        out.append(f'    {compare_opcode[op]}')
    else:
        out.append(f'    {compare_negated[op]}')
        out.append('    ldc.i4.0')
        out.append('    ceq')


def try_expand_compound_index(line: "str") -> "str":
    """MACRO_EXPANDERS entry: 'lst[i] += expr'."""
    stripped = line.strip()
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    m = _COMPOUND_INDEX_RE.match(stripped)
    if not m:
        return None
    name, idx, cop, rhs = m.groups()
    op = _COMPOUND_ASSIGN_OPS[cop]
    return f'{ind}{name}[{idx}] = {name}[{idx}] {op} ({rhs})'


def try_expand_compound_var(line: "str") -> "str":
    """MACRO_EXPANDERS entry: 'x += expr'."""
    stripped = line.strip()
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    m = _COMPOUND_VAR_RE.match(stripped)
    if not m:
        return None
    name, cop, rhs = m.groups()
    op = _COMPOUND_ASSIGN_OPS[cop]
    return f'{ind}{name} = {name} {op} ({rhs})'


def try_expand_dense(line: "str") -> "str":
    global _dense_counter
    stripped = line.strip()
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    m = _DENSE_RE.match(stripped)
    if not m:
        return None
    name, inp, w, b, act = m.groups()
    if act not in _DENSE_ACTIVATIONS:
        raise SyntaxError(f"il_codegen: dense() activation {act!r} khong ho tro "
                           f"(chi: {sorted(_DENSE_ACTIVATIONS)})")
    n = _dense_counter
    _dense_counter = _dense_counter + 1
    pj, pi, ps, pv = f'__dense{n}_j', f'__dense{n}_i', f'__dense{n}_s', f'__dense{n}_v'
    lines_out = [
        f'{ind}{name} = np.zeros({w}.shape[1], dtype=np.float32)',
        f'{ind}for {pj} in range({w}.shape[1]):',
        f'{ind}    {ps} = 0.0',
        f'{ind}    for {pi} in range({w}.shape[0]):',
        f'{ind}        {ps} = {ps} + {inp}[{pi}] * {w}[{pi}, {pj}]',
    ]
    if act == 'none':
        lines_out.append(f'{ind}    {name}[{pj}] = {ps} + {b}[{pj}]')
    elif act == 'tanh':
        lines_out.append(f'{ind}    {name}[{pj}] = tanh({ps} + {b}[{pj}])')
    elif act == 'sigmoid':
        lines_out.append(f'{ind}    {name}[{pj}] = 1.0 / (1.0 + exp(-({ps} + {b}[{pj}])))')
    elif act == 'relu':
        lines_out.append(f'{ind}    {pv} = {ps} + {b}[{pj}]')
        lines_out.append(f'{ind}    {name}[{pj}] = ({pv} > 0.0) ? {pv} : 0.0')
    return '\n'.join(lines_out)


_dense_counter: "i32" = 0


def try_expand_normalize(line: "str") -> "str":
    global _normalize_counter
    stripped = line.strip()
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    m = _NORMALIZE_RE.match(stripped)
    if not m:
        return None
    name, x, x_min, x_max = m.groups()
    n = _normalize_counter
    _normalize_counter = _normalize_counter + 1
    pi = f'__norm{n}_i'
    return (f'{ind}{name} = np.zeros({x}.shape[0], dtype=np.float32)\n'
            f'{ind}for {pi} in range({x}.shape[0]):\n'
            f'{ind}    {name}[{pi}] = ({x}[{pi}] - {x_min}[{pi}]) / ({x_max}[{pi}] - {x_min}[{pi}])')


_normalize_counter: "i32" = 0


def try_expand_argmax(line: "str") -> "str":
    global _argmax_counter
    stripped = line.strip()
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    m = _ARGMAX_RE.match(stripped)
    if not m:
        return None
    name, arr = m.groups()
    n = _argmax_counter
    _argmax_counter = _argmax_counter + 1
    pk, pbest = f'__argmax{n}_k', f'__argmax{n}_bestval'
    return (f'{ind}{pbest} = {arr}[0]\n'
            f'{ind}{name} = 0.0\n'
            f'{ind}for {pk} in range({arr}.shape[0]):\n'
            f'{ind}    if {arr}[{pk}] > {pbest}:\n'
            f'{ind}        {pbest} = {arr}[{pk}]\n'
            f'{ind}        {name} = {pk}')


_argmax_counter: "i32" = 0


def try_expand_binop_macro(line: "str") -> "str":
    global _binop_macro_counter
    # add/sub/mul: c = a OP b, elementwise, CUNG shape (khong kiem tra
    # shape o day - guard-check cua ham goi da lam viec do; macro nay chi
    # gia dinh a/b CUNG do dai, dung shape cua `a` lam bien vong lap,
    # giong het quy uoc dense() dung shape cua tham so dau).
    stripped = line.strip()
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    m = _BINOP_MACRO_RE.match(stripped)
    if not m:
        return None
    name, macro, a, b = m.groups()
    op = _BINOP_MACRO_OP[macro]
    n = _binop_macro_counter
    _binop_macro_counter = _binop_macro_counter + 1
    pi = f'__{macro}{n}_i'
    return (f'{ind}{name} = np.zeros({a}.shape[0], dtype=np.float32)\n'
            f'{ind}for {pi} in range({a}.shape[0]):\n'
            f'{ind}    {name}[{pi}] = {a}[{pi}] {op} {b}[{pi}]')


_binop_macro_counter: "i32" = 0


def try_expand_scale(line: "str") -> "str":
    global _scale_counter
    # scale: c = a * s (s la scalar - so hoac ten bien scalar).
    stripped = line.strip()
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    m = _SCALE_RE.match(stripped)
    if not m:
        return None
    name, a, s = m.groups()
    n = _scale_counter
    _scale_counter = _scale_counter + 1
    pi = f'__scale{n}_i'
    return (f'{ind}{name} = np.zeros({a}.shape[0], dtype=np.float32)\n'
            f'{ind}for {pi} in range({a}.shape[0]):\n'
            f'{ind}    {name}[{pi}] = {a}[{pi}] * {s}')


_scale_counter: "i32" = 0


def try_expand_matvec(line: "str") -> "str":
    global _matvec_counter
    # matvec: c = W . x (nhan ma tran-vector THUAN, khong bias/
    # activation - giong dense() nhung tru phan do; input TRUOC, trong so
    # SAU, giong quy uoc dense(input, W, ...)).
    stripped = line.strip()
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    m = _MATVEC_RE.match(stripped)
    if not m:
        return None
    name, x, w = m.groups()
    n = _matvec_counter
    _matvec_counter = _matvec_counter + 1
    pj, pi, ps = f'__mv{n}_j', f'__mv{n}_i', f'__mv{n}_s'
    return (f'{ind}{name} = np.zeros({w}.shape[1], dtype=np.float32)\n'
            f'{ind}for {pj} in range({w}.shape[1]):\n'
            f'{ind}    {ps} = 0.0\n'
            f'{ind}    for {pi} in range({w}.shape[0]):\n'
            f'{ind}        {ps} = {ps} + {x}[{pi}] * {w}[{pi}, {pj}]\n'
            f'{ind}    {name}[{pj}] = {ps}')


_matvec_counter: "i32" = 0


def try_expand_apply(line: "str") -> "str":
    global _apply_counter
    # apply: c = FN(a) tung phan tu (activation dung rieng, khong qua
    # dense() - vd chi can kich hoat lai 1 mang co san, khong phai vua
    # nhan ma tran vua kich hoat).
    stripped = line.strip()
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    m = _APPLY_RE.match(stripped)
    if not m:
        return None
    name, a, ham_ten = m.groups()
    if ham_ten not in _APPLY_FUNCS:
        raise SyntaxError(f"il_codegen: apply() ham {ham_ten!r} khong ho tro "
                           f"(chi: {sorted(_APPLY_FUNCS)})")
    n = _apply_counter
    _apply_counter = _apply_counter + 1
    pi, pv = f'__apply{n}_i', f'__apply{n}_v'
    lines_out = [
        f'{ind}{name} = np.zeros({a}.shape[0], dtype=np.float32)',
        f'{ind}for {pi} in range({a}.shape[0]):',
    ]
    if ham_ten == 'sigmoid':
        lines_out.append(f'{ind}    {name}[{pi}] = 1.0 / (1.0 + exp(-({a}[{pi}])))')
    elif ham_ten == 'relu':
        lines_out.append(f'{ind}    {pv} = {a}[{pi}]')
        lines_out.append(f'{ind}    {name}[{pi}] = ({pv} > 0.0) ? {pv} : 0.0')
    else:
        lines_out.append(f'{ind}    {name}[{pi}] = {ham_ten}({a}[{pi}])')
    return '\n'.join(lines_out)


_apply_counter: "i32" = 0


def bootstrap_operators(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    # Dang ky vao il_dispatch NGAY LUC MODULE NAP.
    register_expr_codegen(reg, 'binop', compile_binop)
    register_expr_codegen(reg, 'boolop', compile_boolop)
    register_expr_codegen(reg, 'neg', compile_neg)
    register_expr_codegen(reg, 'not', compile_not)
    register_expr_codegen(reg, 'compare', compile_compare)
    register_macro_expander(reg, 'compound_index', try_expand_compound_index)
    register_macro_expander(reg, 'compound_var', try_expand_compound_var)
    register_macro_expander(reg, 'dense', try_expand_dense)
    register_macro_expander(reg, 'normalize', try_expand_normalize)
    register_macro_expander(reg, 'argmax', try_expand_argmax)
    register_macro_expander(reg, 'binop_macro', try_expand_binop_macro)
    register_macro_expander(reg, 'scale', try_expand_scale)
    register_macro_expander(reg, 'matvec', try_expand_matvec)
    register_macro_expander(reg, 'apply', try_expand_apply)
