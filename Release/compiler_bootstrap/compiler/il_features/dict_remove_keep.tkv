# -*- coding: utf-8 -*-
"""Xoa/chen dict GIU THU TU CHEN nhu Python (2026-10-02).

`Dictionary<K,V>.Remove` cua .NET de lai mot o trong va khoa MOI them sau do chui vao o do, nen thu tu duyet lech Python
(d={b,a,c}; d.pop('a'); d['a']=9 -> Python b,c,a; .NET b,a,c).

`TkvDictOps::RemoveKeep<K,V>(d, k)` xoa roi danh dau dict la "ban" (ConditionalWeakTable, O(1)). `TkvDictOps::Set<K,V>(d, k, v)` thay
cho `set_Item`: neu dict ban VA khoa la khoa MOI thi dung lai thu tu truoc (chep cac muc con lai ra list tam, `Clear()` reset danh sach
o trong, them lai tuan tu - O(n), chi mot lan moi cap xoa-roi-chen), roi moi ghi. Chuong trinh khong tung xoa chi ton mot kiem tra
co tinh. Xoa lien tiep khong chen: O(1) moi lan."""


__tkv_import__ = ["il_dispatch", "tkv_types"]

_OPS_CLASS = 'TkvDictOps'
_DIC = 'class [mscorlib]System.Collections.Generic.Dictionary`2<!!0,!!1>'
_KVP = 'valuetype [mscorlib]System.Collections.Generic.KeyValuePair`2<!!0,!!1>'
_LST = 'class [mscorlib]System.Collections.Generic.List`1<valuetype [mscorlib]System.Collections.Generic.KeyValuePair`2<!!0,!!1>>'
_CWT = 'class [mscorlib]System.Runtime.CompilerServices.ConditionalWeakTable`2<object,object>'


def _ensure_class_ops(ctx: "Ctx"):
    if ctx.emitted_types is None or _OPS_CLASS in ctx.emitted_types:
        return
    ctx.emitted_types.add(_OPS_CLASS)
    c = []
    c.append('.class public auto ansi beforefieldinit TkvDictOps extends [mscorlib]System.Object')
    c.append('{')
    c.append('  .field public static bool Any')
    c.append(f'  .field public static {_CWT} Dirty')
    # Rebuild<K,V>(d)
    c.append(f'  .method public static void Rebuild<K, V>({_DIC} d) cil managed')
    c.append('  {')
    c.append('    .maxstack 8')
    c.append(f'    .locals init ({_LST} tmp, {_KVP} kv, int32 i)')
    c.append('    ldarg.0')
    c.append(f'    newobj instance void {_LST}::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    c.append('    stloc.0')
    c.append('    ldarg.0')
    c.append(f'    callvirt instance void {_DIC}::Clear()')
    c.append('    ldc.i4.0')
    c.append('    stloc.2')
    c.append('  RB_L:')
    c.append('    ldloc.2')
    c.append('    ldloc.0')
    c.append(f'    callvirt instance int32 {_LST}::get_Count()')
    c.append('    bge RB_E')
    c.append('    ldarg.0')
    c.append('    ldloc.0')
    c.append('    ldloc.2')
    c.append(f'    callvirt instance !0 {_LST}::get_Item(int32)')
    c.append('    stloc.1')
    c.append('    ldloca.s 1')
    c.append(f'    call instance !0 {_KVP}::get_Key()')
    c.append('    ldloca.s 1')
    c.append(f'    call instance !1 {_KVP}::get_Value()')
    c.append(f'    callvirt instance void {_DIC}::Add(!0, !1)')
    c.append('    ldloc.2')
    c.append('    ldc.i4.1')
    c.append('    add')
    c.append('    stloc.2')
    c.append('    br RB_L')
    c.append('  RB_E:')
    c.append('    ret')
    c.append('  }')
    # RemoveKeep<K,V>(d, k)
    c.append(f'  .method public static bool RemoveKeep<K, V>({_DIC} d, !!0 k) cil managed')
    c.append('  {')
    c.append('    .maxstack 8')
    c.append('    .locals init (object o)')
    c.append('    ldarg.0')
    c.append('    ldarg.1')
    c.append(f'    callvirt instance bool {_DIC}::Remove(!0)')
    c.append('    brtrue RK_OK')
    c.append('    ldc.i4.0')
    c.append('    ret')
    c.append('  RK_OK:')
    c.append('    ldarg.0')
    c.append(f'    callvirt instance int32 {_DIC}::get_Count()')
    c.append('    brfalse RK_DONE')
    c.append('    ldc.i4.1')
    c.append('    stsfld bool TkvDictOps::Any')
    c.append(f'    ldsfld {_CWT} TkvDictOps::Dirty')
    c.append('    brtrue RK_HAVE')
    c.append(f'    newobj instance void {_CWT}::.ctor()')
    c.append(f'    stsfld {_CWT} TkvDictOps::Dirty')
    c.append('  RK_HAVE:')
    c.append(f'    ldsfld {_CWT} TkvDictOps::Dirty')
    c.append('    ldarg.0')
    c.append('    ldloca.s 0')
    c.append(f'    callvirt instance bool {_CWT}::TryGetValue(!0, !1&)')
    c.append('    brtrue RK_DONE')
    c.append(f'    ldsfld {_CWT} TkvDictOps::Dirty')
    c.append('    ldarg.0')
    c.append('    ldarg.0')
    c.append(f'    callvirt instance void {_CWT}::Add(!0, !1)')
    c.append('  RK_DONE:')
    c.append('    ldc.i4.1')
    c.append('    ret')
    c.append('  }')
    # Set<K,V>(d, k, v)
    c.append(f'  .method public static void Set<K, V>({_DIC} d, !!0 k, !!1 v) cil managed')
    c.append('  {')
    c.append('    .maxstack 8')
    c.append('    .locals init (object o)')
    c.append('    ldsfld bool TkvDictOps::Any')
    c.append('    brfalse ST_PUT')
    c.append(f'    ldsfld {_CWT} TkvDictOps::Dirty')
    c.append('    ldarg.0')
    c.append('    ldloca.s 0')
    c.append(f'    callvirt instance bool {_CWT}::TryGetValue(!0, !1&)')
    c.append('    brfalse ST_PUT')
    c.append('    ldarg.0')
    c.append('    ldarg.1')
    c.append(f'    callvirt instance bool {_DIC}::ContainsKey(!0)')
    c.append('    brtrue ST_PUT')
    c.append('    ldarg.0')
    c.append(f'    call void TkvDictOps::Rebuild<!!0, !!1>({_DIC})')
    c.append(f'    ldsfld {_CWT} TkvDictOps::Dirty')
    c.append('    ldarg.0')
    c.append(f'    callvirt instance bool {_CWT}::Remove(!0)')
    c.append('    pop')
    c.append('  ST_PUT:')
    c.append('    ldarg.0')
    c.append('    ldarg.1')
    c.append('    ldarg.2')
    c.append(f'    callvirt instance void {_DIC}::set_Item(!0, !1)')
    c.append('    ret')
    c.append('  }')
    c.append('}')
    ctx.extra_classes.append(c)


def _tach_doi_so_kieu(dict_type: "str") -> "list[str]":
    """'class [..]Dictionary`2<K,V>' -> [K, V] (K, V la chuoi kieu IL, co the long nhau)."""
    mo = dict_type.find('<')
    trong = dict_type[mo + 1:len(dict_type) - 1]
    ra = []
    sau = 0
    dau = 0
    i = 0
    while i < len(trong):
        c = trong[i]
        if c == '<':
            sau += 1
        elif c == '>':
            sau -= 1
        elif c == ',' and sau == 0:
            ra.append(trong[dau:i].strip())
            dau = i + 1
        i += 1
    ra.append(trong[dau:].strip())
    return ra


def emit_dict_remove(dict_type: "str", out: "list[str]", ctx: "Ctx"):
    """Tren stack: [dict, khoa] -> [bool]; thay cho `callvirt Dictionary::Remove(!0)`, giu thu tu chen."""
    _ensure_class_ops(ctx)
    kv = _tach_doi_so_kieu(dict_type)
    # chu ky trong MethodSpec dung dang MO (!!0, !!1) cua dinh nghia, chi danh sach tham so kieu la cu the
    out.append(f'    call bool {_OPS_CLASS}::RemoveKeep<{kv[0]}, {kv[1]}>({_DIC}, !!0)')


def emit_dict_set(dict_type: "str", out: "list[str]", ctx: "Ctx"):
    """Tren stack: [dict, khoa, gia tri] -> []; thay cho `callvirt Dictionary::set_Item(!0, !1)`, giu thu tu chen."""
    _ensure_class_ops(ctx)
    kv = _tach_doi_so_kieu(dict_type)
    out.append(f'    call void {_OPS_CLASS}::Set<{kv[0]}, {kv[1]}>({_DIC}, !!0, !!1)')
