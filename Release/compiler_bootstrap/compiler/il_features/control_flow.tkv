# Kenh doc gia tri cua `return <v>` trong generator (khong co StopIteration).
GEN_RET_NAME = '__gen_ret__'

_FOR_RANGE_RE = re.compile(r'^for\s+(\w+)\s+in\s+range\((.+)\)\s*:\s*$')
_WHILE_RE = re.compile(r'^while\s+(.+):\s*$')
_IF_RE = re.compile(r'^if\s+(.+):\s*$')
_ELSE_RE = re.compile(r'^else\s*:\s*$')
_ELIF_RE = re.compile(r'^elif\s+(.+):\s*$')
_MATCH_RE = re.compile(r'^match\s+(.+):\s*$')
_CASE_RE = re.compile(r'^case\s+(.+):\s*$')
_RETURN_RE = re.compile(r'^return\s+(.+)$')
_BREAK_RE = re.compile(r'^break\s*$')
_CONTINUE_RE = re.compile(r'^continue\s*$')
_TRY_RE = re.compile(r'^try\s*:\s*$')
_EXCEPT_RE = re.compile(r'^except\s*:\s*$')
# 'except <Loai>:' hoac 'except <Loai> as <ten>:' (2026-08-03) - dang
# 'as' la cach viet BINH THUONG cua Python that khi can doc thong diep loi.
# 'except (A, B) as e:' (2026-09-26): nhieu loai -> MOI loai 1 handler, CHUNG than.
_EXCEPT_TUPLE_RE = re.compile(r'^except\s*\(\s*(\w+(?:\s*,\s*\w+)*)\s*,?\s*\)(?:\s+as\s+(\w+))?\s*:\s*$')
_EXCEPT_TYPED_RE = re.compile(r'^except\s+(\w+)(?:\s+as\s+(\w+))?\s*:\s*$')
_FINALLY_RE = re.compile(r'^finally\s*:\s*$')
_RAISE_RE = re.compile(r'^raise\s+(\w+)\((.*)\)(?:\s+from\s+(\w+))?\s*$')
# 'raise' TRAN (khong ten loi/tham so, Phase 6.3, 2026-08-12) - nem LAI
# CHINH exception dang duoc bat, CHI hop le ben trong 1 khoi 'except'
# (xem codegen_raise's rethrow + ctx['in_except_handler']).
_BARE_RAISE_RE = re.compile(r'^raise\s*$')
_RAISE_VAR_RE = re.compile(r'^raise\s+(\w+)\s*$')
_FOR_IN_LIST_RE = re.compile(r'^for\s+(\w+)\s+in\s+(\w+)\s*:\s*$')
# B5 (sua doc lap tren 2 nhanh, gop lai - ban tong quat hon duoc giu):
# 'for x in <bieu thuc>:' vd 'for x in v1.split(","):' - container KHONG
# con la 1 TEN BIEN TRAN. (?!\w+\s*\() loai tru CHINH XAC 2 dang da co
# line-parser RIENG chay SAU macro-expansion (khong duoc "cuop" mat
# truoc khi toi luot chung): 'for x in range(n):' va 'for x in
# ten_ham(args):' (_FOR_IN_GEN_RE) - ca hai co dang 'TEN(' ngay sau
# 'in'; 'v1.split(",")' bat dau bang 'v1.' (dau cham, khong phai dau
# ngoac) nen KHONG khop lookahead, duoc macro nay nhan. '.+?' khong tham
# (lazy) + neo ':$' de khong an dau ':' nam trong chinh bieu thuc (vd
# chuoi ky tu chua ':').
_FOR_IN_EXPR_RE = re.compile(r'^for\s+(\w+)\s+in\s+(?!\w+\s*\()(.+?)\s*:\s*$')

# Anh xa ten loai loi Python THAT -> kieu CLR THAT tuong ung.
#
# Chu thich cu ghi "DSL khong co 'raise' nen khong the nem loi tuy y" - DA
# LAC HAU: 'raise' da co, va chinh bang nay quyet dinh nem/bat duoc gi.
#
# RANG BUOC khi them mot dong: kieu CLR moi KHONG duoc nam cung nhanh thua
# ke voi kieu da co, vi 'except' cua CLR bat theo QUAN HE KE THUA. Vi du
# cu the da can nhac va LOAI BO: `SyntaxError -> System.ArgumentException`
# se lam `except SyntaxError` bat nham ca `IndexError`, boi
# `ArgumentOutOfRangeException` ke thua `ArgumentException`.
#
# 'SyntaxError' (2026-09-14): can cho muc tieu TU-HOST - chinh ma nguon
# compiler nem `raise SyntaxError(...)` o khap noi (7 file tu-host chet o
# day). Chon `InvalidOperationException`: ke thua THANG `SystemException`,
# khong phai to tien hay hau due cua bat ky kieu nao o tren. CLR khong co
# kieu nao mang nghia "sai cu phap" - day la anh xa theo RANG BUOC bat/nem,
# khong phai theo nghia den.


__tkv_import__ = ["il_dispatch", "tkv_types"]


_EXC_CTOR_2STR: "set[str]" = {'IndexError'}


def _derives_from_exception(name: "str", record_bases: "dict[str,list[str]]") -> "i32":
    """Record 'name' co ke thua System.Exception khong - XET CA CHUOI base
    (2026-08-03): code that hay co PHAN CAP loi ('class CalcError(Exception)'
    roi 'class LexError(CalcError)'), truoc day chi chap nhan base TRUC TIEP
    la 'Exception' nen lop chau bi tu choi luc 'raise'/'except'."""
    seen = set()
    cur = name
    while cur is not None and cur not in seen:
        seen.add(cur)
        base = base_that(record_bases, cur)
        if base in EXC_CLR:
            return True
        cur = base
    return False


def _resolve_exc_clr_type(exc_name: "str", ctx: "Ctx", where: "str") -> "str":
    """Ten loai loi trong DSL -> ten kieu CLR dung trong IL. 3 nguon, theo
    thu tu: (a) EXC_CLR (loai co san, anh xa sang class BCL); (b)
    record NGUOI DUNG tu dinh nghia co base 'Exception' ('class
    MyError(Exception):', Giai doan 3 2026-08-03); (c) khong hop le -> bao
    loi RO RANG ngay, liet ke ca 2 nhom hop le.

    Chi record co base DUNG la 'Exception' moi duoc chap nhan: 1 record
    thuong ('class Point:') KHONG ke thua System.Exception nen 'throw' no
    se lam CLR nem InvalidProgramException luc CHAY - phai chan luc bien
    dich."""
    if exc_name in EXC_CLR:
        return EXC_CLR[exc_name]
    records = (ctx.records if ctx is not None else None) or {}
    record_bases = (ctx.record_bases if ctx is not None else None) or {}
    if exc_name in records and _derives_from_exception(exc_name, record_bases):
        return f'class {exc_name}'
    user_excs = sorted([n for n in records if _derives_from_exception(n, record_bases)])
    co_san = sorted([k for k in EXC_CLR])
    raise SyntaxError(
        f"il_codegen: {where} - loai loi '{exc_name}' khong hop le. Loai co san: "
        f"{_ds_repr(co_san)}. Loai tu dinh nghia trong chuong trinh nay: "
        f"{_ds_repr(user_excs)} (khai bao bang 'class {exc_name}(Exception):' voi field dau "
        f"tien kieu str lam thong diep).")


def _ds_repr(ds: "list[str]") -> "str":
    """repr() cua list[str] nhu Python: ['a', 'b']."""
    phan = []
    for x in ds:
        phan.append("'" + x + "'")
    return '[' + ', '.join(phan) + ']'


def declare_scalar_int(name: "str", locals_decl: "list[(str,TypeAnn)]", declared_names: "set[str]", infer_scope: "Scope"=None):
    if name not in declared_names:
        declared_names.add(name)
        ta = TypeAnn('i32', None)
        locals_decl.append((name, ta))
        if infer_scope is not None:
            infer_scope.set(name, ta)


def _contains_break_continue(stmts: "list[i32]") -> "i32":
    """True neu co 'break'/'continue' o BAT KY DAU trong cay - dung de
    chan 'break'/'continue' BEN TRONG 'finally:' luc parse: giong 'return',
    'br' thuan tuy KHONG duoc phep thoat khoi mot khoi finally (chi
    'endfinally'), nen chua ho tro thay vi sinh IL sai."""
    for stmt in stmts:
        if lay_str(stmt, 'kind') in ('break', 'continue'):
            return True
        if lay_str(stmt, 'kind') == 'try':
            if _contains_break_continue(lay_than(stmt, 'body')):
                return True
            if any([_contains_break_continue(body_of(v)) for v in lay_handlers_vung(stmt)]):
                return True
            if lay_than(stmt, 'finally_body') is not None and _contains_break_continue(lay_than(stmt, 'finally_body')):
                return True
        else:
            for sub_key in ('body', 'else_body'):
                sub = lay_than(stmt, sub_key)
                if sub and _contains_break_continue(sub):
                    return True
    return False


def _contains_return(stmts: "list[i32]") -> "i32":
    """True neu co it nhat 1 'return' o BAT KY DAU trong cay (duyet ca
    for/while/if/try long nhau) - dung de biet 1 khoi try/except co CAN
    epilogue (bien tam __ret_tmp + nhan cuoi ham) hay khong: 'ret' truc
    tiep BEN TRONG .try/catch la SAI cu phap CIL that su (ECMA-335 III.3.64
    'leave' - da xac minh THAT bang probe.il/probe2.il rieng, khong doan) -
    return ben trong try/except phai luu gia tri roi 'leave' toi 1 nhan O
    NGOAI ca .try LAN .catch, noi moi duoc 'ret' that su."""
    for stmt in stmts:
        if lay_str(stmt, 'kind') in ('return', 'return_tuple'):
            return True
        if lay_str(stmt, 'kind') == 'try':
            if _contains_return(lay_than(stmt, 'body')):
                return True
            if any([_contains_return(body_of(v)) for v in lay_handlers_vung(stmt)]):
                return True
            # 'finally_body' CO THE co return that su tu chinh no (chinh
            # loi nay se bi chan RIENG luc parse) nen o day CHI can quan
            # tam 'try'/'except' co return de biet co can epilogue hay
            # khong; finally_body KHONG duoc tinh vi return trong do da
            # bi cam hoan toan.
        else:
            for sub_key in ('body', 'else_body'):
                sub = lay_than(stmt, sub_key)
                if sub and _contains_return(sub):
                    return True
    return False


def _stmts_end_in_return(stmts: "list[i32]") -> "i32":
    """True neu KHOI lenh nay CHAC CHAN ket thuc bang 'return' tren MOI
    duong di (dung de biet 1 dong 'br' ngay sau do co unreachable hay
    khong). 'for' KHONG bao gio duoc tinh la chac chan return (vong lap co
    the chay 0 lan)."""
    if not stmts:
        return False
    last = stmts[-1]
    if lay_str(last, 'kind') in ('return', 'return_tuple', 'raise'):
        # 'raise' (thuong LAN tran, Phase 6.3, 2026-08-12) - 'throw'/'rethrow'
        # cung la 1 dang ket thuc khoi HOP LE (giong 'ret'), them 1 lenh
        # 'leave' NGAY SAU no la code khong bao gio toi (unreachable) - voi
        # 'rethrow' con te hon: phat sinh IL sai (da xac nhan THAT gay
        # AccessViolationException luc chay, khong chi ly thuyet).
        return True
    if lay_str(last, 'kind') == 'if' and lay_than(last, 'else_body') is not None:
        return (_stmts_end_in_return(lay_than(last, 'body'))
                and _stmts_end_in_return(lay_than(last, 'else_body')))
    return False


def gen_il_guard_lines(sig: "TkvSig", label_prefix: "str", label_counter: "list[i32]") -> "list[str]":
    """Guard-check runtime (GIONG muc dich gen_csharp_guard_lines): kiem tra
    kich thuoc THAT cua tham so luc goi ham khop voi shape khai bao - VAN
    CAN runtime GetLength() (khac voi tinh kich thuoc mang tam trong than
    ham, cai do da biet hang so luc codegen)."""
    out = []
    for arg_idx, p in enumerate(sig.params):
        ta = p.type_ann
        # BUG THAT phat hien qua tham so kieu 'func' (Wave 3, 2026-07-29):
        # ta.shape KHONG PHAI luon la list[int] (kich thuoc mang co dinh) -
        # con co the la 1 CHUOI sentinel ('list'/'dict'/'record'/'file'/
        # 'tuple'/'set'/'func'/...) cho cac shape khac. `if ta.shape is
        # None: continue` truoc day chi loai duoc truong hop scalar, con
        # 'for dim_idx, dim_size in enumerate(ta.shape)' voi ta.shape la 1
        # CHUOI se lap qua TUNG KY TU cua chuoi do (vd 'func' -> 'f','u',
        # 'n','c') va sinh IL guard SAI/vo nghia - chua tung lo truoc day
        # vi khong co test nao dung list/dict/record/file lam THAM SO ham
        # (chi dung lam bien local trong than ham). Guard nay CHI co y
        # nghia cho mang co dinh that (list[int]).
        if len(ta.dims) == 0:
            continue
        for dim_idx, dim_size in enumerate(ta.dims):
            label_counter[0] += 1
            lbl = f'{label_prefix}_guard_ok_{label_counter[0]}'
            out.append(f'    ldarg.s {arg_idx}')
            out.append(f'    ldc.i4 {dim_idx}')
            out.append('    callvirt instance int32 [mscorlib]System.Array::GetLength(int32)')
            out.append(f'    ldc.i4 {dim_size}')
            out.append(f'    beq {lbl}')
            out.append(f'    ldstr "{p.name} phai co kich thuoc chieu {dim_idx} = {dim_size}"')
            out.append('    newobj instance void [mscorlib]System.ArgumentException::.ctor(string)')
            out.append('    throw')
            out.append(f'  {lbl}:')
    return out


_me_for_in_list_counter: "i32" = 0
# B1 (docs/BUGS_TODO.md): 'for k in d:' (d la dict) truoc day LOT QUA
# macro nay nhu the d la list -> 'd[idx]' voi idx SO NGUYEN tren
# Dictionary<string,...> -> nem exception LUC CHAY, khong bao gi luc
# bien dich. Macro CHI thay VAN BAN (chua co known_shapes) nen khong tu
# biet d la dict - can 1 tap ten bien "da biet la dict" duoc quet TRUOC
# (xem set_known_dict_vars, goi tu _expand_macros trong il_codegen.py)
# bang cach quet '<ten> = {}' o CA THAN HAM truoc khi macro chay.
_known_dict_vars: "set[str]" = set()


def set_known_dict_vars(names: "set[str]"):
    """Goi 1 LAN moi than ham (tu _expand_macros) TRUOC khi macro chay,
    voi tap ten bien duoc gan '{} ' truc tiep trong than ham nay. Dict
    module-level nen PHAI duoc goi lai (kha ca voi tap RONG) cho MOI than
    ham - khong duoc de sot tap cua than ham truoc."""
    global _known_dict_vars
    _known_dict_vars = set(names)


# 'for x in <set>:' (2026-09-26): HashSet khong lay duoc theo chi so -> viet
# lai thanh 'for x in s.to_list():' (duong bieu thuc, danh gia 1 lan).
_known_set_vars: "set[str]" = set()


def set_known_set_vars(names: "set[str]"):
    """Nhu set_known_dict_vars, cho bien kieu set/frozenset."""
    global _known_set_vars
    _known_set_vars = set(names)


# 6.7 (iterator protocol tuy bien, 2026-08-13): 'for x in <bien_record>:'
# CUNG khop CHINH XAC _FOR_IN_LIST_RE (regex do la '\w+' don gian, khong
# phan biet list/dict/record) - neu khong chan o day, macro nay se VIET
# LAI NHAM record thanh 'for i in range(len(r)): x = r[i]' TRUOC KHI line-
# parser 'for_in_iter' (try_parse_for_in_record, o duoi file nay) kip
# chay, pha vo hoan toan tinh nang moi (loi bien dich mo ho tu len()/index
# tren 1 record thay vi __iter__/__next__). Giong het co che _known_dict_vars
# o tren: 1 tap ten bien "da biet la record" duoc quet TRUOC (xem
# set_known_record_vars, goi tu _expand_macros trong il_codegen.py) tu (a)
# tham so ham co kieu record VA (b) local gan truc tiep tu 1 loi goi
# constructor record ('r = Res(...)').
_known_record_vars: "set[str]" = set()


def set_known_record_vars(names: "set[str]"):
    """Goi 1 LAN moi than ham (tu _expand_macros) TRUOC khi macro chay,
    voi tap ten bien DA BIET la kieu record trong than ham nay (tham so
    kieu record + local gan tu constructor record). PHAI goi lai (ke ca
    voi tap RONG) cho MOI than ham - khong duoc de sot tap cua than ham
    truoc, giong set_known_dict_vars."""
    global _known_record_vars
    _known_record_vars = set(names)


def is_known_record_var(name: "str") -> "i32":
    """Getter cho macro khac module (vd dict_update) kiem tra receiver
    co phai record da biet khong (2026-10-09)."""
    if name in _known_record_vars:
        return 1
    return 0


_SET_OP_RE = re.compile(r'^(\w+\s*(?::\s*"[^"]*"\s*)?=\s*)(\w+)\s*([-|&])\s*(\w+)\s*$')


def _set_op_method(op: "str") -> "str":
    if op == '-':
        return 'difference'
    if op == '|':
        return 'union'
    return 'intersection'


def try_expand_set_op(line: "str") -> "str":
    """'x = a - b' / 'a | b' / 'a & b' voi a la SET da biet (2026-09-26) ->
    'x = a.difference(b)' / union / intersection (method da co san)."""
    stripped = line.strip()
    m = _SET_OP_RE.match(stripped)
    if not m or m.group(2) not in _known_set_vars:
        return None
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    return f'{ind}{m.group(1)}{m.group(2)}.{_set_op_method(m.group(3))}({m.group(4)})'


_FOR_IN_CALL_HAU_TO_RE = re.compile(r'^for\s+(\w+)\s+in\s+(\w+\(.*\)\s*[.\[].*?)\s*:\s*$')
_FOR_IN_BUILTIN_DS_RE = re.compile(r'^for\s+(\w+)\s+in\s+((?:reversed|sorted|list|set)\(.*\))\s*:\s*$')


def try_expand_for_in_list(line: "str") -> "str":
    global _me_for_in_list_counter
    # for x in lst: - lap TRUC TIEP qua list - KHONG can codegen moi:
    # List<T> da ho tro doc theo chi so (get_Item/get_Count), nen chi can
    # khai trien THANH VAN BAN sang dang for-range+doc-chi-so da co san.
    # Khong kiem tra `container` co THAT la list o day (thuan text, chua
    # co known_shapes) - neu sai, loi se lo RO RANG sau o len()/index cua
    # _compile_expr (khong am tham). Regex nay KHONG khop 'for i in
    # range(n):' (container phai la 1 TEN BIEN TRAN).
    stripped = line.strip()
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    m = _FOR_IN_LIST_RE.match(stripped)
    if m:
        var, container = m.groups()
        if container in _known_record_vars:
            # 6.7: container DA BIET la 1 bien kieu record (khong phai
            # list/dict/set) - KHONG duoc viet lai thanh range(len())/
            # index (record khong co len()/get_Item) - de nguyen VAN BAN,
            # nhuong lai cho line-parser 'for_in_iter' (try_parse_for_in_
            # record) o tang parse xu ly qua __iter__/__next__.
            return None
        if container in _known_dict_vars:
            # B1: container la dict da biet -> phai kiem tra o DAY, TRUOC
            # nhanh list-index ngay ben duoi (container la '\w+' don gian
            # nen KHOP CA HAI regex - neu kiem o nhanh EXPR o duoi thi
            # khong bao gio toi luot vi nhanh nay da return truoc). Viet
            # lai thanh dang '.keys()' - vong lap _expand_macros (co diem
            # dung) se tu khop lai o CHINH macro nay o VONG SAU (regex B5
            # nhan bat ky bieu thuc, ke ca '<ten>.keys()'), tai dung ha
            # tang List<K> da co san cua dict.keys().
            return f'{ind}for {var} in {container}.keys():'
        if container in _known_set_vars:
            return f'{ind}for {var} in {container}.to_list():'
        n = _me_for_in_list_counter
        _me_for_in_list_counter = _me_for_in_list_counter + 1
        idx = f'__iterlist{n}_idx'
        # 2026-09-26: di qua __tkv_lap (quyet dinh luc codegen: dict -> khoa,
        # set -> phan tu, con lai -> chinh bien) thay vi doan tu van ban.
        src = f'__iterlist{n}_src'
        return (f'{ind}{src} = __tkv_lap({container})\n'
                f'{ind}for {idx} in range(len({src})):\n{ind}    {var} = {src}[{idx}]')
    # B5 (2026-08-05): container la 1 BIEU THUC (vd 'v1.split(",")'),
    # khong phai ten bien tran - _FOR_IN_LIST_RE o tren khong khop. Phai
    # do KET QUA ra 1 bien tam TRUOC khi lap: Python chi goi bieu thuc
    # MOT LAN (danh gia iterable 1 lan roi lap qua ket qua), viet lai
    # thang thanh range(len(expr)) + expr[idx] se GOI LAI expr moi vong
    # lap - sai neu expr co side-effect (vd ham thay doi trang thai) va
    # cham hon O(n^2) khong can thiet. Giao Gemini nghien cuu regex loai
    # tru 'range(...)'/'ten_ham(...)' (co line-parser rieng chay SAU
    # macro-expansion, khong duoc macro nay cuop mat).
    m2 = _FOR_IN_EXPR_RE.match(stripped)
    if not m2:
        # 'for x in reversed(xs)/sorted(xs)/...' (2026-09-26): builtin tra LIST
        # - khong phai generator, di duong bieu thuc (bien tam) nhu B5.
        m2 = _FOR_IN_BUILTIN_DS_RE.match(stripped)
    if not m2:
        # 'for x in f(a, b).split(","):' (2026-09-26): loi goi CO hau to
        # (method/chi so) la BIEU THUC thuong, khong phai goi generator.
        m2 = _FOR_IN_CALL_HAU_TO_RE.match(stripped)
    if not m2:
        return None
    var, expr = m2.groups()
    if expr in _known_dict_vars:
        # B1: container la dict da biet -> lap qua KHOA, dung dung ngu
        # nghia Python ('for k in d:' == 'for k in d.keys():'). Viet lai
        # thanh dang '.keys()' - vong lap _expand_macros (co diem dung)
        # se tu khop lai o CHINH macro nay o VONG SAU (regex B5 nhan bat
        # ky bieu thuc, ke ca '<ten>.keys()'), tai dung ha tang List<K> da
        # co san cua dict.keys().
        return f'{ind}for {var} in {expr}.keys():'
    n = _me_for_in_list_counter
    _me_for_in_list_counter = _me_for_in_list_counter + 1
    tmp = f'__iterexpr{n}_tmp'
    src = f'__iterexpr{n}_src'
    idx = f'__iterexpr{n}_idx'
    if _la_tuple_ngoac(expr):
        # 'for x in ("a", "b"):' (2026-09-26): duyet tuple literal = duyet list
        gon = expr.strip()
        expr = '[' + gon[1:len(gon) - 1] + ']'
    # 2026-09-26: qua __tkv_lap nhu nhanh ten bien - bieu thuc tra DICT
    # truoc day bi duyet theo chi so (doc gia tri thay khoa).
    return (f'{ind}{tmp} = {expr}\n'
            f'{ind}{src} = __tkv_lap({tmp})\n'
            f'{ind}for {idx} in range(len({src})):\n'
            f'{ind}    {var} = {src}[{idx}]')


def _la_tuple_ngoac(expr: "str") -> "i32":
    """'(a, b, ...)' - cap ngoac NGOAI CUNG bao ca bieu thuc va co dau phay
    o muc 1 ben trong (khong phai '(a + b)')."""
    t = expr.strip()
    if len(t) < 2 or t[0] != '(' or t[len(t) - 1] != ')':
        return False
    sau = 0
    nhay = ''
    co_phay = False
    i = 0
    while i < len(t):
        c = t[i]
        if nhay != '':
            if c == chr(92):
                i += 1
            elif c == nhay:
                nhay = ''
        elif c == '"' or c == "'":
            nhay = c
        elif c == '(' or c == '[' or c == '{':
            sau += 1
        elif c == ')' or c == ']' or c == '}':
            sau -= 1
            if sau == 0 and i != len(t) - 1:
                return False
        elif c == ',' and sau == 1:
            co_phay = True
        i += 1
    return co_phay


_ASSERT_RE = re.compile(r'^assert\s+(.+)$')


def try_parse_match(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """'match SUBJECT:' / 'case PATTERN:' (Phase 13, 2026-08-29) - DESUGAR
    THANH chuoi if/elif/else LONG NHAU (tai su dung NGUYEN VEN {'kind':
    'if', ...} da co, KHONG them kind moi/khong them STMT_CODEGEN/
    FIRST_PASS_WALK moi) - dung y het ky thuat 'elif' -> 'if' de quy o
    try_parse_if ben tren, chi khac o CHO desugar dien ra tren CAY STMT
    (khong phai van ban tho) vi 'case' can gom nhieu dong con thanh 1
    block truoc khi bien doi.

    GIOI HAN CO Y THUC (ghi ro, khong am tham thu hep): CHI ho tro
    'match'/'case' cho PHAN NHO cu phap that cua Python - khong phai
    structural pattern matching day du:
    - Pattern MOI 'case' CHI duoc la 1 HANG SO literal (so/chuoi/bool -
      bool da tu quy ve 'num' 1/0 boi parse_expr, xem il_core.py) HOAC
      wildcard '_'. KHONG ho tro capture-pattern ('case x:' gan bien),
      class-pattern ('case Point(x=0, y=0):'), sequence-pattern
      ('case [a, b]:'), OR-pattern ('case 1 | 2:'), guard ('case x if
      cond:'). Ly do: cac dang do can 1 tang phan tich cau truc rieng
      (khong the desugar THANG ve so sanh '==') - ngoai pham vi Phase 13,
      danh cho phase sau neu can.
    - 'case _:' (wildcard) NEU CO PHAI la case CUOI CUNG - giong Python
      that (wildcard sau cung se lam 'case' phia sau khong bao gio chay
      toi, CPython tu canh bao 'unreachable' - o day BAO LOI ro rang luc
      bien dich thay vi am tham cho qua).
    - PHAI co it nhat 1 'case' voi pattern hang so (ngoai wildcard)."""
    m_match = _MATCH_RE.match(line)
    if not m_match:
        return None
    subject_node = parse_expr(m_match.group(1))
    pos += 1
    if pos >= len(lines) or lines[pos][0] <= indent_level:
        raise SyntaxError(f"il_codegen: 'match {m_match.group(1)}:' khong co 'case' nao (block rong)")
    case_indent = lines[pos][0]
    cases: "list[(i32,list[i32])]" = []
    default_body = None
    while pos < len(lines) and lines[pos][0] == case_indent:
        case_line = lines[pos][1]
        m_case = _CASE_RE.match(case_line)
        if not m_case:
            raise SyntaxError(
                f"il_codegen: ben trong 'match' chi duoc phep 'case PATTERN:', gap: {case_line!r}")
        pattern_src = m_case.group(1).strip()
        pos += 1
        if pos >= len(lines) or lines[pos][0] <= case_indent:
            raise SyntaxError(f"il_codegen: 'case {pattern_src}:' khong co than khoi (block rong)")
        body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
        if pattern_src == '_':
            if default_body is not None:
                raise SyntaxError(
                    "il_codegen: 'match' chi duoc co DUNG 1 'case _:' (wildcard)")
            default_body = body
        else:
            if default_body is not None:
                raise SyntaxError(
                    "il_codegen: 'case _:' (wildcard) PHAI la 'case' CUOI CUNG trong 'match' "
                    "(giong Python that - case sau wildcard khong bao gio chay toi)")
            pattern_node = parse_expr(pattern_src)
            if ekind(pattern_node) not in ('num', 'str_lit'):
                raise SyntaxError(
                    f"il_codegen: 'case {pattern_src}:' - Phase 13 CHI ho tro pattern la HANG SO "
                    f"literal (so/chuoi/bool) hoac wildcard '_' - KHONG ho tro capture-pattern/"
                    f"class-pattern/sequence-pattern/OR-pattern/guard")
            cases.append((pattern_node, body))
    if not cases:
        raise SyntaxError(
            "il_codegen: 'match' can it nhat 1 'case' voi pattern hang so (ngoai 'case _:')")
    # 0 = chua co (chi so stmt bat dau tu 1, o 0 de trong) - kieu i32 khong
    # mang duoc None (2026-09-26).
    result = 0
    for pattern_node, body in reversed(cases):
        cond_node = mk4('compare', o_str('=='), o_nut(subject_node), o_nut(pattern_node))
        else_body = [result] if result != 0 else default_body
        # Dieu kien la node DUNG SAN (`mk4` o tren), khong co van ban nguon
        # nao - nen ghi THANG chi so node vao o `cond_node`, bo trong o
        # `cond_text`. Xem `stmt_row.get`, muc "TRUONG LUU THANG".
        result = intern(make5('if', None, str(intern_body(body)),
                             None if else_body is None else str(intern_body(else_body)),
                             str(cond_node)))
    return result, pos


def _split_top_level_comma(text: "str") -> "list[str]":
    """Tach 'text' tai dau ',' O TOP-LEVEL (do sau ngoac '('/'[' bang 0,
    bo qua dau ',' BEN TRONG chuoi "...") - dung cho 'assert cond, msg'
    de tach dung ke ca khi cond CHINH NO co dau ',' long (vd 'assert
    f(a, b) == c, \"loi\"'). Tra ve 1 phan tu neu khong co ',' top-level
    (khong co msg tuy chon)."""
    depth = 0
    in_str = False
    for i, c in enumerate(text):
        if in_str:
            if c == '"':
                in_str = False
        elif c == '"':
            in_str = True
        elif c in '([':
            depth += 1
        elif c in ')]':
            depth -= 1
        elif c == ',' and depth == 0:
            return [text[:i].strip(), text[i + 1:].strip()]
    return [text.strip()]


def try_expand_assert(line: "str") -> "str":
    """'assert cond' / 'assert cond, "msg"' (Wave 3, 2026-07-29, muc
    tieu Claude tu tin dung viet code that - assert RAT pho bien trong
    validation/test) - macro TEXT-LEVEL, viet lai THANH 'if not (cond):
    raise Exception(msg)' (tai dung HOAN TOAN ha tang if/raise co san,
    KHONG can codegen/AssertionError rieng - .NET khong co lop
    AssertionError chuan trong mscorlib nen dung Exception chung, giong
    EXC_CLR's 'Exception' catch-all)."""
    stripped = line.strip()
    m = _ASSERT_RE.match(stripped)
    if not m:
        return None
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    parts = _split_top_level_comma(m.group(1))
    cond = parts[0]
    msg_expr = parts[1] if len(parts) == 2 else '"AssertionError"'
    return f'{ind}if not ({cond}):\n{ind}    raise Exception({msg_expr})'


def try_parse_if(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    m_if = _IF_RE.match(line)
    if not m_if:
        return None
    cond_node = parse_expr(m_if.group(1))
    pos += 1
    if pos >= len(lines) or lines[pos][0] <= indent_level:
        raise SyntaxError(f"il_codegen: 'if {m_if.group(1)}:' khong co than khoi (block rong)")
    body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
    else_body = None
    if pos < len(lines) and lines[pos][0] == indent_level and _ELIF_RE.match(lines[pos][1]):
        # 'elif' (2026-08-03) = 'else:' chua DUNG 1 lenh 'if' - dung y
        # nghia cua Python. Parse DE QUY chinh try_parse_if tu dong 'elif'
        # (coi no nhu 1 'if' o CUNG muc thut le) roi boc ket qua lam
        # else_body => chuoi elif dai bao nhieu cung duoc, va KHONG can
        # them 'kind' moi nao cho codegen/first-pass.
        elif_line = lines[pos][1].replace('elif', 'if', 1)
        sub_lines = list(lines)
        sub_lines[pos] = (lines[pos][0], elif_line)
        elif_stmt, pos = try_parse_if(reg, elif_line, sub_lines, pos, indent_level, sig,
                                       known_shapes, parse_block_fn)
        else_body = [elif_stmt]
    elif pos < len(lines) and lines[pos][0] == indent_level and _ELSE_RE.match(lines[pos][1]):
        pos += 1
        if pos >= len(lines) or lines[pos][0] <= indent_level:
            raise SyntaxError("il_codegen: 'else:' khong co than khoi (block rong)")
        else_body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
    # `else_body` co the None (khong co nhanh else) -> sentinel vang mat.
    return intern(make4('if', m_if.group(1), str(intern_body(body)),
                                 None if else_body is None else str(intern_body(else_body)))), pos




def _literal_step_int(step_node: "TkvNode") -> "i32":
    """'range(...)' step CHI ho tro HANG SO NGUYEN tai compile-time (Wave
    3, 2026-07-29 - hoan tat muc 'range() co step am' con thieu tu Wave
    2's ke hoach goc) - can biet DAU (duong/am) NGAY LUC BIEN DICH de
    chon dung lenh nhay (bge/ble, xem codegen_for), khac bound/start co
    the la bieu thuc DONG BAT KY (chi can dung IL). Bieu thuc step DONG
    (vd 'range(0, n, k)' voi k la tham so) CHUA duoc ho tro - gioi han
    co y thuc, bao loi ro rang thay vi doan sai huong vong lap."""
    if ekind(step_node) == 'num' and '.' not in ea_str(step_node):
        return int(ea_str(step_node))
    if (ekind(step_node) == 'neg' and la_node(ea_nut(step_node))
            and ekind(ea_nut(step_node)) == 'num'
            and '.' not in ea_str(ea_nut(step_node))):
        return -int(ea_str(ea_nut(step_node)))
    raise SyntaxError(
        "il_codegen: 'range(start, stop, step)' - step CHI ho tro hang so nguyen "
        "tai compile-time (vd -1, 2), chua ho tro bieu thuc step DONG (vd 1 tham so)")


def try_parse_for(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    m_for = _FOR_RANGE_RE.match(line)
    if not m_for:
        return None
    var, args_text = m_for.group(1), m_for.group(2)
    parts = _split_all_top_level_commas(args_text)
    if len(parts) == 1:
        start_node, bound_expr, step = None, parts[0], 1
    elif len(parts) == 2:
        start_node, bound_expr, step = parse_expr(parts[0]), parts[1], 1
    elif len(parts) == 3:
        start_node, bound_expr = parse_expr(parts[0]), parts[1]
        step = _literal_step_int(parse_expr(parts[2]))
        if step == 0:
            raise SyntaxError("il_codegen: 'range(...)' step khong duoc bang 0")
    else:
        raise SyntaxError(f"il_codegen: 'range(...)' nhan 1-3 tham so (start, stop, step), gap {len(parts)}")
    bound_node = parse_expr(bound_expr)
    pos += 1
    if pos >= len(lines) or lines[pos][0] <= indent_level:
        raise SyntaxError(f"il_codegen: 'for {var} in range(...):' khong co than khoi (block rong)")
    body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
    return intern(make6('for', var, parts[0] if len(parts) > 1 else None,
                                 bound_expr, str(step),
                                 str(intern_body(body)))), pos


def try_parse_while(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    m_while = _WHILE_RE.match(line)
    if not m_while:
        return None
    cond_node = parse_expr(m_while.group(1))
    pos += 1
    if pos >= len(lines) or lines[pos][0] <= indent_level:
        raise SyntaxError(f"il_codegen: 'while {m_while.group(1)}:' khong co than khoi (block rong)")
    body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
    return intern(make3('while', m_while.group(1),
                                 str(intern_body(body)))), pos


def _co_break_thoat_khoi_vung(stmts: "list[i32]") -> "i32":
    """True neu co break/continue THUC SU thoat khoi vung protected hien tai.

    KHAC `_contains_break_continue`: khong quet than for/while long ben trong
    (break o do thuoc ve vong lap con), va cung khong quet try long ben trong
    (tranh doc bang handler trong luc parse - no la nguyen nhan gay
    AccessViolation truoc day). Chi quet truc tiep va than 'if' long ngay."""
    for stmt in stmts:
        k = lay_str(stmt, 'kind')
        if k == 'break' or k == 'continue':
            return True
        if k == 'for' or k == 'while' or k == 'try':
            continue
        for sub_key in ('body', 'else_body'):
            sub = lay_than(stmt, sub_key)
            if sub and _co_break_thoat_khoi_vung(sub):
                return True
    return False


def try_parse_try(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    if not _TRY_RE.match(line):
        return None
    pos += 1
    if pos >= len(lines) or lines[pos][0] <= indent_level:
        raise SyntaxError("il_codegen: 'try:' khong co than khoi (block rong)")
    body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)

    # 0 hoac nhieu 'except <Loai>:' (theo THU TU, giong Python - loai
    # KHOP DAU TIEN thang), sau do TOI DA 1 'except:' tran (bat MOI loai,
    # PHAI la cai CUOI CUNG neu co - dung Python that: 'except:' sau 1
    # 'except <Loai>:' khac la hop le, nguoc lai thi khong).
    handlers: "list[(str,list[i32])]" = []
    handler_vars: "list[str]" = []
    bare_seen = False
    while pos < len(lines) and lines[pos][0] == indent_level:
        next_line = lines[pos][1]
        m_typed = _EXCEPT_TYPED_RE.match(next_line)
        m_bare = _EXCEPT_RE.match(next_line)
        m_tuple = _EXCEPT_TUPLE_RE.match(next_line)
        if bare_seen:
            break  # da gap 'except:' tran, khong con except nao duoc phep sau no
        if m_tuple:
            ten_loai = [t.strip() for t in m_tuple.group(1).split(',') if t.strip()]
            pos += 1
            if pos >= len(lines) or lines[pos][0] <= indent_level:
                raise SyntaxError("il_codegen: 'except (...):' khong co than khoi (block rong)")
            handler_body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
            for ten in ten_loai:
                handlers.append((ten, handler_body))
                handler_vars.append(m_tuple.group(2))
        elif m_typed:
            exc_name = m_typed.group(1)
            bind_name = m_typed.group(2)
            # KHONG kiem tra ten o day nua (Giai doan 3, 2026-08-03): tu khi
            # co exception TU DINH NGHIA ('class MyError(Exception):'), tinh
            # hop le phu thuoc danh sach record - thu chi biet duoc o tang
            # CODEGEN (ctx['records']/ctx['record_bases']), khong phai luc
            # parse tung dong. Kiem tra da chuyen sang _resolve_exc_clr_type.
            pos += 1
            if pos >= len(lines) or lines[pos][0] <= indent_level:
                raise SyntaxError(f"il_codegen: 'except {exc_name}:' khong co than khoi (block rong)")
            handler_body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
            handlers.append((exc_name, handler_body))
            handler_vars.append(bind_name)
        elif m_bare:
            bare_seen = True
            pos += 1
            if pos >= len(lines) or lines[pos][0] <= indent_level:
                raise SyntaxError("il_codegen: 'except:' khong co than khoi (block rong)")
            handler_body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
            handlers.append((None, handler_body))
            handler_vars.append(None)
        else:
            break

    # 'else:' cua 'try' (2026-09-28) - chay khi KHONG co exception nao duoc
    # bat. Thu tu dung: giao nhu Python, 'else' nam sau TAT CA 'except' va
    # TRUOC 'finally'. Vong while o tren tu `break` ra o day vi cac regex
    # 'except' khong khop 'else:'.
    else_body = None
    if pos < len(lines) and lines[pos][0] == indent_level and _ELSE_RE.match(lines[pos][1]):
        if not handlers:
            raise SyntaxError(
                "il_codegen: 'try/else' khong co 'except' nao - 'else' chi co "
                "nghia khi co it nhat 1 'except' (Python that cung tu choi)")
        pos += 1
        if pos >= len(lines) or lines[pos][0] <= indent_level:
            raise SyntaxError("il_codegen: 'else:' cua 'try' khong co than khoi (block rong)")
        else_body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)

    finally_body = None
    if pos < len(lines) and lines[pos][0] == indent_level and _FINALLY_RE.match(lines[pos][1]):
        pos += 1
        if pos >= len(lines) or lines[pos][0] <= indent_level:
            raise SyntaxError("il_codegen: 'finally:' khong co than khoi (block rong)")
        finally_body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)

    if not handlers and finally_body is None:
        raise SyntaxError(
            "il_codegen: 'try:' phai co it nhat 1 'except' hoac 1 'finally:' theo sau")
    if finally_body is not None and _contains_return(finally_body):
        raise SyntaxError(
            "il_codegen: 'return' ben trong 'finally:' chua duoc ho tro (CIL khong "
            "cho phep thoat som khoi finally - chi 'endfinally' duoc phep; Python "
            "that cung khuyen cao khong nen return trong finally)")
    if finally_body is not None and _contains_break_continue(finally_body):
        # DON GIAN HOA CO CHU DICH: chan CA truong hop break/continue long
        # trong 1 for/while dinh nghia BEN TRONG chinh finally (thuc ra van
        # hop le, vi khong "thoat" khoi finally) - chua phan biet duoc 2
        # truong hop nay o day, thanh ra tu choi rong hon can thiet, nhung
        # AN TOAN (khong bao gio sinh IL sai) hon la co gang phan biet ma sai.
        raise SyntaxError(
            "il_codegen: 'break'/'continue' ben trong 'finally:' chua duoc ho tro "
            "(CIL khong cho phep 'br' thuan tuy thoat khoi finally, chi 'endfinally' "
            "- ke ca khi vong lap dinh nghia BEN TRONG finally cung chua phan biet "
            "duoc o buoc nay, tu choi RONG HON can thiet de dam bao an toan)")
    if else_body is not None and finally_body is not None and _contains_break_continue(else_body):
        # Cung ly do voi 'finally' o tren: khi co 'finally', than 'else' duoc
        # sinh BEN TRONG .try cua finally (de no chay truoc khi finally), nen
        # 'br' thuan cua 'break' se thoat khoi mot vung protected - CIL tu choi.
        raise SyntaxError(
            "il_codegen: 'break'/'continue' trong 'else' cua 'try' KHI CO "
            "'finally:' chua duoc ho tro - CIL khong cho phep 'br' thuan thoat "
            "khoi vung .try bao vuc cua finally (chi 'leave' duoc phep)")
    if finally_body is not None and _co_break_thoat_khoi_vung(body):
        # `break`/`continue` THUC SU thuoc vong lap ngoai try khi co
        # 'finally' se thoat bang `br` ra khoi vung .try bao vuc cua finally -
        # CIL tu choi. Break trong vong lap long ben trong thi KHONG thuoc
        # nhanh nay (xem `_co_break_thoat_khoi_vung`).
        raise SyntaxError(
            "il_codegen: 'break'/'continue' trong than 'try' khi co 'finally:' "
            "chua duoc ho tro - CIL khong cho phep 'br' thuan thoat khoi vung "
            ".try bao vuc cua finally (chi 'leave' duoc phep). Truoc khi chan, "
            "truong hop nay sinh IL khong hop le va nem InvalidProgramException "
            "LUC CHAY. Cach vong: bo 'finally' hoac dat 'break' o ngoai vong.")
    # `handlers` la danh sach cap (ten|None, than) -> hai truong SONG SONG:
    # ten ngan cach phay, va chi so vung than ngan cach phay.
    return intern(make7(
        'try',
        str(intern_body(body)),
        ",".join([e or '' for e, _hb in handlers]) if handlers else None,
        ",".join([str(intern_body(hb)) for _e, hb in handlers]) if handlers else None,
        ",".join([v or '' for v in handler_vars]) if handler_vars else None,
        None if finally_body is None else str(intern_body(finally_body)),
        None if else_body is None else str(intern_body(else_body)))), pos


def try_parse_break(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    if not _BREAK_RE.match(line):
        return None
    return intern(make1('break')), pos + 1


def try_parse_pass(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """'pass' (2026-09-26) - lenh RONG, khong sinh IL."""
    if line.strip() != 'pass':
        return None
    return intern(make1('pass')), pos + 1


def codegen_pass(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    return


def try_parse_continue(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    if not _CONTINUE_RE.match(line):
        return None
    return intern(make1('continue')), pos + 1


def try_parse_return(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    if line.strip() == 'return':
        # `return` TRAN (2026-09-24; 11/117 file cua cay tu-host dung).
        # Ham CO kieu -> dung nghia Python la `return None`. Ham void ->
        # stmt 'return' voi expr_text None, codegen sinh `ret`/`leave`.
        if sig.return_type is not None:
            return intern(make2('return', 'None')), pos + 1
        return intern(make2('return', None)), pos + 1
    m_ret = _RETURN_RE.match(line)
    if not m_ret:
        return None
    expr_text = m_ret.group(1)
    expr_nodes = parse_expr_list(expr_text)
    if len(expr_nodes) == 1:
        return intern(make2('return', expr_text)), pos + 1
    if 2 <= len(expr_nodes) <= MAX_TUPLE_ARITY:
        # 'return a, b, ...' - tra ve tuple 2-7 phan tu.
        return intern(make2('return_tuple', expr_text)), pos + 1
    raise SyntaxError(
        f"il_codegen: 'return {expr_text}' co {len(expr_nodes)} gia tri - "
        f"tuple tra ve ho tro 2-{MAX_TUPLE_ARITY} gia tri")


def try_parse_raise(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    if _BARE_RAISE_RE.match(line):
        return intern(make5('raise', None, None, None, '1')), pos + 1
    m_var = _RAISE_VAR_RE.match(line)
    if m_var:
        # 'raise loi' (2026-09-29): nem lai 1 DOI TUONG ngoai le da co trong 1
        # bien. Dung lai loai 'raise' (cac kiem tra "cau lenh ket thuc" giu
        # nguyen): bare='2', ten bien nam o exc_type.
        return intern(make5('raise', m_var.group(1), None, None, '2')), pos + 1
    m_raise = _RAISE_RE.match(line)
    if not m_raise:
        return None
    # 'raise ValueError("thong diep")' - TU nem 1 exception (khac 'except'
    # chi BAT loi CLR tu nem tu 1 phep toan that) - dung LAI CHINH
    # EXC_CLR da co cho 'except <Loai>:'. Msg co the rong ('raise
    # ValueError()' - .ctor khong tham so). '... from err' (exception
    # chaining, 2026-08-12) - 'err' PHAI la 1 bien da khai bao kieu
    # Exception-tuong-thich (sentinel 'Exception' tu 'except BuiltinType
    # as e:' HOAC 1 record tu dinh nghia ke thua Exception) - tinh hop le
    # kiem o CODEGEN (giong _resolve_exc_clr_type), o day chi tach van ban.
    exc_type, msg_text, from_name = m_raise.groups()
    # Tinh hop le cua ten kiem tra o CODEGEN (_resolve_exc_clr_type) - xem
    # ghi chu tuong tu o nhanh 'except' phia tren.
    msg_text = msg_text.strip()
    msg_node = parse_expr(msg_text) if msg_text else None
    return intern(make5('raise', exc_type, msg_text or None, from_name, None)), pos + 1


def fpw_for(stmt: "i32", ctx: "WalkCtx"):
    declare_scalar_int(lay_str(stmt, 'var'), ctx.locals_decl, ctx.declared_names, ctx.infer_scope)
    if lay_nut(stmt, 'start_node') is not None:
        ctx.collect_ternary_temps(lay_nut(stmt, 'start_node'))
    ctx.collect_ternary_temps(lay_nut(stmt, 'bound_node'))
    # PHAI chay TRUOC walk_fn: no doi kind cua cac cau lenh don chuoi
    # thanh 'sb_append', va walk_fn phai thay kind MOI.
    plan_str_accum(stmt, ctx)
    ctx.walk_fn(lay_than(stmt, 'body'))


def fpw_while(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'cond_node'))
    plan_str_accum(stmt, ctx)
    ctx.walk_fn(lay_than(stmt, 'body'))


def _mau_thu_hep(stmt: "i32", records: "dict[str,list[(str,TkvTypeAnn)]]") -> "(str,str)":
    """(ten_bien, ten_lop) neu dieu kien dung DUNG mau `isinstance(<bien>,
    <Lop>)`; (None, None) neu khong.

    THU HEP KIEU (C2, 2026-09-10) - nhan DANG CO GIOI HAN, khong phai he kieu
    nhay cam theo luong day du. Ly do chon C2: no phu dung mau ma 134 cho trong
    tkv_compile.py dung (`isinstance(node, ast.X)` roi doc field rieng cua X),
    va hop voi cach compiler nay von duoc xay (nhan dang theo mau).

    NGOAI MAU thi KHONG thu hep - `elif`, `and`/`or`, `not`, `isinstance` long
    trong bieu thuc lon hon. Chung KHONG bao loi rieng: chung don gian khong
    duoc thu hep, va viec doc field rieng se bao loi "record X khong co field
    Y" nhu truoc. Do la tu choi RO RANG, khong phai tra loi sai."""
    cond = lay_nut(stmt, 'cond_node')
    if not (la_node(cond) and eso_o(cond) >= 3):
        return None, None
    if ekind(cond) != 'call' or ea_str(cond) != 'isinstance':
        return None, None
    args = eb_ds(cond)
    if not isinstance(args, list) or len(args) != 2:
        return None, None
    a, b = args[0], args[1]
    if not (la_node(a) and ekind(a) == 'var'):
        return None, None
    if not (la_node(b) and ekind(b) == 'var'):
        return None, None
    if not records:
        records = {}
    if ea_str(b) not in records:
        return None, None            # isinstance(x, int) - khong phai record
    return ea_str(a), ea_str(b)


def _ten_local_thu_hep(stmt: "i32") -> "str":
    """Ten local an cho mot `if isinstance(...)`.

    Dat theo CHI SO POOL cua chinh cau lenh: no on dinh va GIONG NHAU o ca
    first-pass lan codegen, nen hai luot khong the lech ten. Day dung la thu
    ma P8/3b-1 lam duoc - dua danh tinh ve mot mien duy nhat."""
    return '__nar%d' % stmt


def fpw_if(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'cond_node'))
    ten_bien, ten_lop = _mau_thu_hep(stmt, ctx.records)
    if ten_lop is not None:
        # Local AN giu ban da ep kieu. Khong tai dung o nho cua bien goc vi o
        # do khai kieu BASE - CIL khong cho luu lop con vao mot o kieu base ma
        # khong ep, va ep xong thi can mot o kieu lop con de giu.
        ctx.declare_named(_ten_local_thu_hep(stmt),
                             TypeAnn(ten_lop, 'record'))
    ctx.walk_fn(lay_than(stmt, 'body'))
    if lay_than(stmt, 'else_body') is not None:
        ctx.walk_fn(lay_than(stmt, 'else_body'))


def fpw_try(stmt: "i32", ctx: "WalkCtx"):
    if _contains_return(lay_than(stmt, 'body')) or \
            any([_contains_return(body_of(v)) for v in lay_handlers_vung(stmt)]) or \
            (lay_than(stmt, 'else_body') is not None and _contains_return(lay_than(stmt, 'else_body'))):
        ctx.needs_epilogue[0] = True
    ctx.walk_fn(lay_than(stmt, 'body'))
    # 'except E as e:' - khai bao 'e' nhu 1 local kieu record E (voi
    # exception TU DINH NGHIA) hoac kieu sentinel 'Exception' (voi loai co
    # san cua BCL - vd ValueError/KeyError/... - Phase 6.9/6.3, 2026-08-12,
    # port tu cay .tkv tu-host: str(e) doc duoc .Message qua nhanh moi trong
    # string_feature.py, khong con bao loi nhu truoc).
    records = ctx.records
    for exc_name, bind in zip(lay_handlers_exc(stmt), lay_ds_str(stmt, 'handler_vars') or []):
        if bind is None:
            continue
        if exc_name in records:
            ctx.declare_named(bind, TypeAnn(exc_name, 'record'))
        else:
            ctx.declare_named(bind, TypeAnn('Exception', None))
    for handler_body in [body_of(_v) for _v in lay_handlers_vung(stmt)]:
        ctx.walk_fn(handler_body)
    if lay_than(stmt, 'else_body') is not None:
        ctx.walk_fn(lay_than(stmt, 'else_body'))
    if lay_than(stmt, 'finally_body') is not None:
        ctx.walk_fn(lay_than(stmt, 'finally_body'))


def fpw_return(stmt: "i32", ctx: "WalkCtx"):
    nut_tra = lay_nut(stmt, 'expr_node')
    if nut_tra is None:
        return                                  # `return` tran cua ham void
    # `return None` trong generator la ket thuc binh thuong (khong co gia tri)
    # - khong can kenh `__gen_ret__`. Phan biet o day vi node 'null' van la
    # mot BIEU THUC, khong phai `return` tran.
    if ekind(nut_tra) == 'null':
        ctx.collect_ternary_temps(nut_tra)
        return
    fn_sig = ctx.sig
    if fn_sig is not None and fn_sig.is_generator == 1:
        gdtype = None
        bm = ctx.bien_mod
        if GEN_RET_NAME in bm:
            gdtype = bm[GEN_RET_NAME]
        else:
            try:
                gdtype = ctx.infer_scope.tra(GEN_RET_NAME).ta.dtype
            except Exception:
                gdtype = None
        if gdtype is None:
            raise SyntaxError(
                "il_codegen: '" + GEN_RET_NAME + "' CHUA duoc khai bao - ham generator "
                + fn_sig.name + " co 'return " + (lay_str(stmt, 'expr_text') or '') +
                "', can gia tri tra ve. Khai bao o cap module: " + GEN_RET_NAME + ': "i32" = 0')
        dat_ghi_chu(stmt, 'gen_ret_dtype', gdtype)
    ctx.collect_ternary_temps(lay_nut(stmt, 'expr_node'))


def fpw_raise(stmt: "i32", ctx: "WalkCtx"):
    if lay_nut(stmt, 'msg_node') is not None:
        ctx.collect_ternary_temps(lay_nut(stmt, 'msg_node'))


def fpp_for(stmt: "i32", ctx: "PrescanCtx"):
    infer_scope = ctx.infer_scope
    if lay_str(stmt, 'var') not in infer_scope:
        infer_scope.set(lay_str(stmt, 'var'), TypeAnn('i32', None))
    ctx.prescan_fn(lay_than(stmt, 'body'))


def fpp_while_if(stmt: "i32", ctx: "PrescanCtx"):
    ctx.prescan_fn(lay_than(stmt, 'body'))
    if lay_than(stmt, 'else_body') is not None:
        ctx.prescan_fn(lay_than(stmt, 'else_body'))


def fpp_try(stmt: "i32", ctx: "PrescanCtx"):
    ctx.prescan_fn(lay_than(stmt, 'body'))
    for handler_body in [body_of(_v) for _v in lay_handlers_vung(stmt)]:
        ctx.prescan_fn(handler_body)
    if lay_than(stmt, 'else_body') is not None:
        ctx.prescan_fn(lay_than(stmt, 'else_body'))
    if lay_than(stmt, 'finally_body') is not None:
        ctx.prescan_fn(lay_than(stmt, 'finally_body'))


# ---------------------------------------------------------------------------
# LICM - nho bieu thuc BAT BIEN ra khoi vong lap (2026-10-13)
# ---------------------------------------------------------------------------
#
# VI SAO PHAI LAM: .NET Framework JIT KHONG tu LICM (no loop-invariant code
# motion), nen compiler phai lam. Mot bieu thuc thuan tinh `A + B` / `A - B`
# / `A * B` (A, B la bien) duoc TINH MOT LAN truoc vong, roi moi lan lap chi
# con `ldloc` 1 lenh.
#
# PHAM VI (co chut, dung y het):
#   - CHI phep `+ - *` tren BIEN VOHUONG. `//`, `%`, `/` bi loai: `//` voi
#     so am nem loi chia 0, `%` thi nua thuong - chay 1 lan truoc vong thi
#     thay doi ca bien dau tien cua chuoi. Hen gian, dung.
#   - CHI bien co binding 'local'/'arg'/'const'. KHONG 'global' (mot ham goi
#     trong vong co the doi no), KHONG 'boxed'/'closure_field', KHONG 'selfarg'.
#   - KHONG bien nao trong than vong duoc GAN (quet ca vong long, if/else,
#     for...in; co 'try'/'nested_def' thi BO LUON).
#   - KHONG co `walrus` trong bieu thuc.
#   - Vong co `else` thi bo luon.
#   - `gen_ctx is not None` (generator) thi bo: local trong generator la FIELD
#     cua class, khai them o luc CODEGEN thi khong kip.
#
# MOI THAY DOI NGHIA (xem het, dung bo qua):
#   Phep `+ - *` tren so nguyen dung `.ovf` (nem OverflowError). Sau khi nho,
#   phep do chay o MOI LAN thay vi moi vong lap - nen mot vong KHONG chay lan
#   nao co the nem loi ma truoc day khong nem. Day la doi doi lap chuan cua moi
#   bo toi uu "speculative" (LLVM/Roslyn cung vay).

# Kind -> TRUONG chua ten duoc GAN (',' tach; "" = khong gan gi bien nao).
# Kind KHONG co trong bang -> TU DONG BO LUON (xem `_licm_quet`).
_LICM_MUC: "dict[str,str]" = {
    "assign_scalar": "name",
    "assign_typed_decl": "name",
    "assign_typed_container_new": "name",
    "idx_assign": "name",
    "tuple_assign": "targets_text",
    "assign_multi_target": "targets_text",
    "for": "var",
    "for_in_iter": "var,record_var",
    "for_in_dict_items": "key_var,val_var",
    "for_in_generator": "var",
    "for_in_call_list": "var",
    "with_open": "var",
    "with_ctx": "var",
    "assign_iter": "name",
    "assign_open": "name",
    "assign_list_new": "name",
    "assign_list_literal": "name",
    "assign_list_from": "name",
    "assign_list_slice": "name",
    "assign_list_repeat": "name",
    "assign_list_count": "name",
    "assign_dict_new": "name",
    "assign_set_new": "name",
    "assign_bytearray_new": "name",
    "assign_bytes_new": "name",
    "assign_bytes_literal": "name",
    "assign_f32buf_new": "name",
    "assign_frozenset_new": "name",
    "assign_frozenset_empty": "name",
    "assign_frozenset_literal": "name",
    "assign_tuple_identity": "name",
    "assign_repeat_str": "name",
    "assign_os_getenv": "name",
    "assign_os_list_files": "name",
    "assign_os_mkdir": "name",
    "assign_shutil_rmtree": "name",
    "assign_md5_hex": "name",
    "assign_sha256_hex": "name",
    "assign_base64_encode": "name",
    "assign_base64_decode": "name",
