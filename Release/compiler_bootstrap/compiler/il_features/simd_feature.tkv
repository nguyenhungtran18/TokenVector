# -*- coding: utf-8 -*-
"""SIMD tren mang so (2026-09-30): simd_dot/simd_sum/simd_max/simd_min/simd_add/simd_sub/simd_mul/simd_scale/simd_axpy
dua tren System.Numerics.Vector<T> (System.Numerics.Vectors.dll co san trong .NET Framework 4.6+). RyuJIT bien
Vector<T> thanh lenh SIMD that cua CPU (SSE2, va AVX/AVX2 khi JIT ho tro - do rong that doc qua simd_lanes_f32()).
.NET Framework KHONG co System.Runtime.Intrinsics (chi .NET Core 3.0+), nen Vector<T> la duong SIMD kha dung.

Doi so la bien MANG rank 1 (np.zeros(n, dtype=np.float32) hoac tham so 'f32[N]'), kieu phan tu f32/f64/i32/i64
dong nhat. Chieu dai lay theo mang ngan nhat; phan le cuoi (khong tron mot vector) tinh vo huong."""
from il_dispatch import register_expr_builtin
from expr_row import ea_str, ekind

__tkv_import__ = "il_dispatch"

_SIMD_CLASS = 'TkvSimd'
# BEGIN KERNEL DATA (sinh boi tools/simd_kernels.py --ghi, KHONG sua tay)
_KERN_AVX2_B64 = ''
_KERN_AVX2_OFFS = '0,96,176,240,304,368,432,512,592,672,736,800,864,928'
_KERN_SSE_B64 = ''
_KERN_SSE_OFFS = '0,80,144,208,272,336,400,480,560,624,704,784,864,944'
# END KERNEL DATA
_VEC_ASM = '[System.Numerics.Vectors]System.Numerics.Vector'
# Ban .NET Framework (C:\Windows\Microsoft.NET\Framework\v4.0.30319\
# System.Numerics.Vectors.dll) CHI co type forwarder (Vector2/3/4, Matrix...),
# KHONG co Vector<T> - nen phai ship ban NuGet lib/net46 trong
# `Release/runtime/System.Numerics.Vectors.dll` (do _sao_dll_simd trong
# tkv_compile.tkv copy sang canh .exe). Version khai bao phai KHOP DUNG file
# do: AssemblyVersion 4.1.2.0. Sai version => FileLoadException 0x80131040
# "manifest definition does not match the assembly reference" luc CHAY.
_VEC_EXTERN = '.assembly extern System.Numerics.Vectors { .publickeytoken = (B0 3F 5F 7F 11 D5 0A 3A ) .ver 4:1:2:0 }'


def _ten_il(d: "str") -> "str":
    if d == 'f32':
        return 'float32'
    if d == 'f64':
        return 'float64'
    if d == 'i32':
        return 'int32'
    return 'int64'


def _hau_to(d: "str") -> "str":
    if d == 'f32':
        return 'F32'
    if d == 'f64':
        return 'F64'
    if d == 'i32':
        return 'I32'
    return 'I64'


def _ldelem(d: "str") -> "str":
    if d == 'f32':
        return 'ldelem.r4'
    if d == 'f64':
        return 'ldelem.r8'
    if d == 'i32':
        return 'ldelem.i4'
    return 'ldelem.i8'


def _stelem(d: "str") -> "str":
    if d == 'f32':
        return 'stelem.r4'
    if d == 'f64':
        return 'stelem.r8'
    if d == 'i32':
        return 'stelem.i4'
    return 'stelem.i8'


def _vec(d: "str") -> "str":
    return 'valuetype ' + _VEC_ASM + '`1<' + _ten_il(d) + '>'


def _vop(d: "str", ten: "str") -> "str":
    v = _vec(d)
    g = 'valuetype ' + _VEC_ASM + '`1<!0>'
    return 'call ' + g + ' ' + v + '::' + ten + '(' + g + ', ' + g + ')'


def _pt_vong_2(d: "str", ten: "str", vop_ten: "str", sop: "str") -> "list[str]":
    """ten(T[] a, T[] b, T[] o): o[i] = a[i] <op> b[i] (vector roi phan le)."""
    t = _ten_il(d)
    v = _vec(d)
    return [
        '  .method public static void ' + ten + _hau_to(d) + '(' + t + '[] a, ' + t + '[] b, ' + t + '[] o) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (int32 i, int32 n, int32 w, ' + v + ' vt)',
        '    ldarg.0', '    ldlen', '    conv.i4', '    ldarg.1', '    ldlen', '    conv.i4', '    call int32 [mscorlib]System.Math::Min(int32, int32)',
        '    ldarg.2', '    ldlen', '    conv.i4', '    call int32 [mscorlib]System.Math::Min(int32, int32)', '    stloc.1',
        '    call int32 ' + v + '::get_Count()', '    stloc.2',
        '    ldc.i4.0', '    stloc.0',
        '  V_LOOP:',
        '    ldloc.0', '    ldloc.2', '    add', '    ldloc.1', '    bgt V_TAIL',
        '    ldarg.0', '    ldloc.0', '    newobj instance void ' + v + '::.ctor(!0[], int32)',
        '    ldarg.1', '    ldloc.0', '    newobj instance void ' + v + '::.ctor(!0[], int32)',
        '    ' + _vop(d, vop_ten), '    stloc.3',
        '    ldloca.s vt', '    ldarg.2', '    ldloc.0', '    call instance void ' + v + '::CopyTo(!0[], int32)',
        '    ldloc.0', '    ldloc.2', '    add', '    stloc.0', '    br V_LOOP',
        '  V_TAIL:',
        '    ldloc.0', '    ldloc.1', '    bge V_END',
        '    ldarg.2', '    ldloc.0', '    ldarg.0', '    ldloc.0', '    ' + _ldelem(d), '    ldarg.1', '    ldloc.0', '    ' + _ldelem(d), '    ' + sop, '    ' + _stelem(d),
        '    ldloc.0', '    ldc.i4.1', '    add', '    stloc.0', '    br V_TAIL',
        '  V_END:',
        '    ret',
        '  }',
    ]


def _pt_scale(d: "str") -> "list[str]":
    t = _ten_il(d)
    v = _vec(d)
    return [
        '  .method public static void Scale' + _hau_to(d) + '(' + t + '[] a, ' + t + ' s, ' + t + '[] o) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (int32 i, int32 n, int32 w, ' + v + ' vs, ' + v + ' vt)',
        '    ldarg.0', '    ldlen', '    conv.i4', '    ldarg.2', '    ldlen', '    conv.i4', '    call int32 [mscorlib]System.Math::Min(int32, int32)', '    stloc.1',
        '    call int32 ' + v + '::get_Count()', '    stloc.2',
        '    ldloca.s vs', '    ldarg.1', '    call instance void ' + v + '::.ctor(!0)',
        '    ldc.i4.0', '    stloc.0',
        '  V_LOOP:',
        '    ldloc.0', '    ldloc.2', '    add', '    ldloc.1', '    bgt V_TAIL',
        '    ldarg.0', '    ldloc.0', '    newobj instance void ' + v + '::.ctor(!0[], int32)',
        '    ldloc.3',
        '    ' + _vop(d, 'op_Multiply'), '    stloc.s vt',
        '    ldloca.s vt', '    ldarg.2', '    ldloc.0', '    call instance void ' + v + '::CopyTo(!0[], int32)',
        '    ldloc.0', '    ldloc.2', '    add', '    stloc.0', '    br V_LOOP',
        '  V_TAIL:',
        '    ldloc.0', '    ldloc.1', '    bge V_END',
        '    ldarg.2', '    ldloc.0', '    ldarg.0', '    ldloc.0', '    ' + _ldelem(d), '    ldarg.1', '    mul', '    ' + _stelem(d),
        '    ldloc.0', '    ldc.i4.1', '    add', '    stloc.0', '    br V_TAIL',
        '  V_END:',
        '    ret',
        '  }',
    ]


def _pt_axpy(d: "str") -> "list[str]":
    """Axpy(T alpha, T[] x, T[] y): y[i] += alpha * x[i]."""
    t = _ten_il(d)
    v = _vec(d)
    return [
        '  .method public static void Axpy' + _hau_to(d) + '(' + t + ' alpha, ' + t + '[] x, ' + t + '[] y) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (int32 i, int32 n, int32 w, ' + v + ' va, ' + v + ' vt)',
        '    ldarg.1', '    ldlen', '    conv.i4', '    ldarg.2', '    ldlen', '    conv.i4', '    call int32 [mscorlib]System.Math::Min(int32, int32)', '    stloc.1',
        '    call int32 ' + v + '::get_Count()', '    stloc.2',
        '    ldloca.s va', '    ldarg.0', '    call instance void ' + v + '::.ctor(!0)',
        '    ldc.i4.0', '    stloc.0',
        '  V_LOOP:',
        '    ldloc.0', '    ldloc.2', '    add', '    ldloc.1', '    bgt V_TAIL',
        '    ldarg.2', '    ldloc.0', '    newobj instance void ' + v + '::.ctor(!0[], int32)',
        '    ldarg.1', '    ldloc.0', '    newobj instance void ' + v + '::.ctor(!0[], int32)',
        '    ldloc.3',
        '    ' + _vop(d, 'op_Multiply'),
        '    ' + _vop(d, 'op_Addition'), '    stloc.s vt',
        '    ldloca.s vt', '    ldarg.2', '    ldloc.0', '    call instance void ' + v + '::CopyTo(!0[], int32)',
        '    ldloc.0', '    ldloc.2', '    add', '    stloc.0', '    br V_LOOP',
        '  V_TAIL:',
        '    ldloc.0', '    ldloc.1', '    bge V_END',
        '    ldarg.2', '    ldloc.0', '    ldarg.2', '    ldloc.0', '    ' + _ldelem(d), '    ldarg.0', '    ldarg.1', '    ldloc.0', '    ' + _ldelem(d), '    mul', '    add', '    ' + _stelem(d),
        '    ldloc.0', '    ldc.i4.1', '    add', '    stloc.0', '    br V_TAIL',
        '  V_END:',
        '    ret',
        '  }',
    ]


def _lay_tong_lane(d: "str") -> "list[str]":
    """[acc tren stack] -> T: tong cac lane = Vector.Dot(acc, Vector<T>.One)."""
    t = _ten_il(d)
    v = _vec(d)
    return [
        '    call valuetype ' + _VEC_ASM + '`1<!0> ' + v + '::get_One()',
        '    call !!0 ' + _VEC_ASM + '::Dot<' + t + '>(valuetype ' + _VEC_ASM + '`1<!!0>, valuetype ' + _VEC_ASM + '`1<!!0>)',
    ]


def _pt_dot(d: "str") -> "list[str]":
    t = _ten_il(d)
    v = _vec(d)
    return ([
        '  .method public static ' + t + ' Dot' + _hau_to(d) + '(' + t + '[] a, ' + t + '[] b) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (int32 i, int32 n, int32 w, ' + v + ' acc, ' + t + ' s)',
        '    ldarg.0', '    ldlen', '    conv.i4', '    ldarg.1', '    ldlen', '    conv.i4', '    call int32 [mscorlib]System.Math::Min(int32, int32)', '    stloc.1',
        '    call int32 ' + v + '::get_Count()', '    stloc.2',
        '    call valuetype ' + _VEC_ASM + '`1<!0> ' + v + '::get_Zero()', '    stloc.3',
        '    ldc.i4.0', '    stloc.0',
        '  V_LOOP:',
        '    ldloc.0', '    ldloc.2', '    add', '    ldloc.1', '    bgt V_RED',
        '    ldloc.3',
        '    ldarg.0', '    ldloc.0', '    newobj instance void ' + v + '::.ctor(!0[], int32)',
        '    ldarg.1', '    ldloc.0', '    newobj instance void ' + v + '::.ctor(!0[], int32)',
        '    ' + _vop(d, 'op_Multiply'),
        '    ' + _vop(d, 'op_Addition'), '    stloc.3',
        '    ldloc.0', '    ldloc.2', '    add', '    stloc.0', '    br V_LOOP',
        '  V_RED:',
        '    ldloc.3',
    ] + _lay_tong_lane(d) + [
        '    stloc.s s',
        '  V_TAIL:',
        '    ldloc.0', '    ldloc.1', '    bge V_END',
        '    ldloc.s s', '    ldarg.0', '    ldloc.0', '    ' + _ldelem(d), '    ldarg.1', '    ldloc.0', '    ' + _ldelem(d), '    mul', '    add', '    stloc.s s',
        '    ldloc.0', '    ldc.i4.1', '    add', '    stloc.0', '    br V_TAIL',
        '  V_END:',
        '    ldloc.s s', '    ret',
        '  }',
    ])


def _pt_sum(d: "str") -> "list[str]":
    t = _ten_il(d)
    v = _vec(d)
    return ([
        '  .method public static ' + t + ' Sum' + _hau_to(d) + '(' + t + '[] a) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (int32 i, int32 n, int32 w, ' + v + ' acc, ' + t + ' s)',
        '    ldarg.0', '    ldlen', '    conv.i4', '    stloc.1',
        '    call int32 ' + v + '::get_Count()', '    stloc.2',
        '    call valuetype ' + _VEC_ASM + '`1<!0> ' + v + '::get_Zero()', '    stloc.3',
        '    ldc.i4.0', '    stloc.0',
        '  V_LOOP:',
        '    ldloc.0', '    ldloc.2', '    add', '    ldloc.1', '    bgt V_RED',
        '    ldloc.3',
        '    ldarg.0', '    ldloc.0', '    newobj instance void ' + v + '::.ctor(!0[], int32)',
        '    ' + _vop(d, 'op_Addition'), '    stloc.3',
        '    ldloc.0', '    ldloc.2', '    add', '    stloc.0', '    br V_LOOP',
        '  V_RED:',
        '    ldloc.3',
    ] + _lay_tong_lane(d) + [
        '    stloc.s s',
        '  V_TAIL:',
        '    ldloc.0', '    ldloc.1', '    bge V_END',
        '    ldloc.s s', '    ldarg.0', '    ldloc.0', '    ' + _ldelem(d), '    add', '    stloc.s s',
        '    ldloc.0', '    ldc.i4.1', '    add', '    stloc.0', '    br V_TAIL',
        '  V_END:',
        '    ldloc.s s', '    ret',
        '  }',
    ])


def _pt_cuc_tri(d: "str", ten: "str", bo_qua: "str") -> "list[str]":
    """Max/Min: moi lane khoi tao = a[0] (khong doi ket qua); giam lane bang so sanh vo huong.
    bo_qua: 'ble' (Max: x <= r thi giu r) hoac 'bge' (Min)."""
    t = _ten_il(d)
    v = _vec(d)
    vg = 'valuetype ' + _VEC_ASM + '`1<!!0>'
    return [
        '  .method public static ' + t + ' ' + ten + _hau_to(d) + '(' + t + '[] a) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (int32 i, int32 n, int32 w, ' + v + ' acc, ' + t + ' r, int32 k, ' + t + ' x)',
        '    ldarg.0', '    ldlen', '    conv.i4', '    stloc.1',
        '    ldloc.1', '    brtrue V_OK',
        '    ldstr "' + ten.lower() + '() arg is an empty sequence"', '    newobj instance void [mscorlib]System.ArgumentException::.ctor(string)', '    throw',
        '  V_OK:',
        '    call int32 ' + v + '::get_Count()', '    stloc.2',
        '    ldarg.0', '    ldc.i4.0', '    ' + _ldelem(d), '    stloc.s r',
        '    ldloca.s acc', '    ldloc.s r', '    call instance void ' + v + '::.ctor(!0)',
        '    ldc.i4.0', '    stloc.0',
        '  V_LOOP:',
        '    ldloc.0', '    ldloc.2', '    add', '    ldloc.1', '    bgt V_RED',
        '    ldloc.3',
        '    ldarg.0', '    ldloc.0', '    newobj instance void ' + v + '::.ctor(!0[], int32)',
        '    call ' + vg + ' ' + _VEC_ASM + '::' + ten + '<' + t + '>(' + vg + ', ' + vg + ')',
        '    stloc.3',
        '    ldloc.0', '    ldloc.2', '    add', '    stloc.0', '    br V_LOOP',
        '  V_RED:',
        '    ldc.i4.0', '    stloc.s k',
        '  V_RL:',
        '    ldloc.s k', '    ldloc.2', '    bge V_TAIL',
        '    ldloca.s acc', '    ldloc.s k', '    call instance !0 ' + v + '::get_Item(int32)', '    stloc.s x',
        '    ldloc.s x', '    ldloc.s r', '    ' + bo_qua + ' V_S1',
        '    ldloc.s x', '    stloc.s r',
        '  V_S1:',
        '    ldloc.s k', '    ldc.i4.1', '    add', '    stloc.s k', '    br V_RL',
        '  V_TAIL:',
        '    ldloc.0', '    ldloc.1', '    bge V_END',
        '    ldarg.0', '    ldloc.0', '    ' + _ldelem(d), '    stloc.s x',
        '    ldloc.s x', '    ldloc.s r', '    ' + bo_qua + ' V_S2',
        '    ldloc.s x', '    stloc.s r',
        '  V_S2:',
        '    ldloc.0', '    ldc.i4.1', '    add', '    stloc.0', '    br V_TAIL',
        '  V_END:',
        '    ldloc.s r', '    ret',
        '  }',
    ]


def _doi_ten_v(khoi: "list[str]") -> "list[str]":
    """Doi ten phuong thuc dau tien 'Xxx<H>(' thanh 'Xxx<H>V(' (ban Vector<T>, fallback cua kernel native)."""
    ra = list(khoi)
    dong = ra[0]
    vt = dong.index('(')
    ra[0] = dong[:vt] + 'V' + dong[vt:]
    return ra


def _mang_khoi(ten_ham: "str", tham_so: "list[str]", tra_ve: "str", d: "str", loai: "str", ma_kern: "int") -> "list[str]":
    """Dispatcher: neu co kernel native (AVX2/SSE) thi ghim mang + calli, nguoc lai goi ban Vector<T> '...V'."""
    t = _ten_il(d)
    h = _hau_to(d)
    L = []
    L.append('  .method public static ' + tra_ve + ' ' + ten_ham + h + '(' + ', '.join(tham_so) + ') cil managed')
    L.append('  {')
    L.append('    .maxstack 8')
    # cac mang (kieu T[]) trong tham_so: xac dinh vi tri
    mang = []
    for i, ts in enumerate(tham_so):
        if ts.startswith(t + '[]'):
            mang.append(i)
    loc = 'native int k, int32 n'
    for j in range(len(mang)):
        loc = loc + ', ' + t + '& pinned p' + str(j)
    L.append('    .locals init (' + loc + ')')
    L.append('    ldc.i4 ' + str(ma_kern))
    L.append('    call native int ' + _SIMD_CLASS + '::Kern(int32)')
    L.append('    stloc.0')
    L.append('    ldloc.0')
    L.append('    brfalse V_VEC')
    # n = min do dai cac mang
    L.append('    ldarg.' + str(mang[0]))
    L.append('    ldlen')
    L.append('    conv.i4')
    for i in mang[1:]:
        L.append('    ldarg.' + str(i))
        L.append('    ldlen')
        L.append('    conv.i4')
        L.append('    call int32 [mscorlib]System.Math::Min(int32, int32)')
    L.append('    stloc.1')
    L.append('    ldloc.1')
    L.append('    brfalse V_VEC')
    for j, i in enumerate(mang):
        L.append('    ldarg.' + str(i))
        L.append('    ldc.i4.0')
        L.append('    ldelema ' + t)
        L.append('    stloc.s ' + str(2 + j))
    # nap doi so cho kernel theo thu tu tham so goc; sau do n, roi con tro ham
    ct = []
    j = 0
    for i, ts in enumerate(tham_so):
        if i in mang:
            L.append('    ldloc.s ' + str(2 + j))
            L.append('    conv.i')
            ct.append('native int')
            j += 1
        else:
            L.append('    ldarg.' + str(i))
            ct.append(t)
    L.append('    ldloc.1')
    ct.append('int32')
    L.append('    ldloc.0')
    L.append('    calli unmanaged stdcall ' + tra_ve + '(' + ', '.join(ct) + ')')
    L.append('    ret')
    L.append('  V_VEC:')
    for i in range(len(tham_so)):
        L.append('    ldarg.' + str(i))
    kt = []
    for ts2 in tham_so:
        vt2 = ts2.rfind(' ')
        kt.append(ts2[:vt2])
    L.append('    call ' + tra_ve + ' ' + _SIMD_CLASS + '::' + ten_ham + h + 'V(' + ', '.join(kt) + ')')
    L.append('    ret')
    L.append('  }')
    return L


def _pt_native_ho_tro() -> "list[str]":
    """Init/Kern/Isa + P/Invoke kernel32: nap kernel vao bo nho thuc thi (VirtualAlloc RWX)."""
    ra = [
        '  .field public static valuetype [mscorlib]System.IntPtr[] tab',
        '  .field public static int32 st',
        '  .field public static int32 isa',
        '  .method public hidebysig static pinvokeimpl("kernel32.dll" as "IsProcessorFeaturePresent" winapi) int32 IsProcessorFeaturePresent(int32) cil managed preservesig { }',
        '  .method public hidebysig static pinvokeimpl("kernel32.dll" as "VirtualAlloc" winapi) native int VirtualAlloc(native int, native int, int32, int32) cil managed preservesig { }',
        '  .method public static void Init() cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (string e, string b64, native int mem, uint8[] code, int32 i)',
        '    ldc.i4.2',
        '    stsfld int32 ' + _SIMD_CLASS + '::st',
        '    ldc.i4.0',
        '    stsfld int32 ' + _SIMD_CLASS + '::isa',
        '    ldstr "TKV_SIMD_ISA"',
        '    call string [mscorlib]System.Environment::GetEnvironmentVariable(string)',
        '    stloc.0',
        '    ldloc.0',
        '    ldstr "off"',
        '    call bool [mscorlib]System.String::op_Equality(string, string)',
        '    brtrue I_END',
        '    ldloc.0',
        '    ldstr "sse"',
        '    call bool [mscorlib]System.String::op_Equality(string, string)',
        '    brtrue I_SSE',
        '    ldc.i4.s 40',
        '    call int32 ' + _SIMD_CLASS + '::IsProcessorFeaturePresent(int32)',
        '    brfalse I_END',
        '    ldc.i4.1',
        '    stsfld int32 ' + _SIMD_CLASS + '::isa',
        '    ldstr "' + _KERN_AVX2_B64 + '"',
        '    stloc.1',
        '    br I_GO',
        '  I_SSE:',
        '    ldc.i4.2',
        '    stsfld int32 ' + _SIMD_CLASS + '::isa',
        '    ldstr "' + _KERN_SSE_B64 + '"',
        '    stloc.1',
        '  I_GO:',
        '    ldloc.1',
        '    call uint8[] [mscorlib]System.Convert::FromBase64String(string)',
        '    stloc.3',
        '    ldc.i4.0',
        '    conv.i',
        '    ldloc.3',
        '    ldlen',
        '    conv.i4',
        '    ldc.i4 64',
        '    add',
        '    conv.i',
        '    ldc.i4 12288',
        '    ldc.i4.s 64',
        '    call native int ' + _SIMD_CLASS + '::VirtualAlloc(native int, native int, int32, int32)',
        '    stloc.2',
        '    ldloc.2',
        '    brfalse I_END',
        '    ldloc.3',
        '    ldc.i4.0',
        '    ldloc.2',
        '    ldloc.3',
        '    ldlen',
        '    conv.i4',
        '    call void [mscorlib]System.Runtime.InteropServices.Marshal::Copy(uint8[], int32, native int, int32)',
        '    ldc.i4.s 14',
        '    newarr [mscorlib]System.IntPtr',
        '    stsfld valuetype [mscorlib]System.IntPtr[] ' + _SIMD_CLASS + '::tab',
        '    ldsfld int32 ' + _SIMD_CLASS + '::isa',
        '    ldc.i4.1',
        '    bne.un I_OFF_SSE',
    ]
    for isa_ten, offs_s in (('AVX2', _KERN_AVX2_OFFS), ('SSE', _KERN_SSE_OFFS)):
        if isa_ten == 'SSE':
            ra.append('  I_OFF_SSE:')
        for k, off in enumerate(offs_s.split(',')):
            ra += [
                '    ldsfld valuetype [mscorlib]System.IntPtr[] ' + _SIMD_CLASS + '::tab',
                '    ldc.i4.s ' + str(k),
                '    ldloc.2',
                '    ldc.i4 ' + off,
                '    conv.i',
                '    add',
                '    stelem valuetype [mscorlib]System.IntPtr',
            ]
        if isa_ten == 'AVX2':
            ra.append('    br I_OK')
    ra += [
        '  I_OK:',
        '    ldc.i4.1',
        '    stsfld int32 ' + _SIMD_CLASS + '::st',
        '  I_END:',
        '    ret',
        '  }',
        '  .method public static native int Kern(int32 id) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldsfld int32 ' + _SIMD_CLASS + '::st',
        '    brtrue K_GO',
        '    call void ' + _SIMD_CLASS + '::Init()',
        '  K_GO:',
        '    ldsfld int32 ' + _SIMD_CLASS + '::st',
        '    ldc.i4.1',
        '    bne.un K_NONE',
        '    ldsfld valuetype [mscorlib]System.IntPtr[] ' + _SIMD_CLASS + '::tab',
        '    ldarg.0',
        '    ldelem valuetype [mscorlib]System.IntPtr',
        '    ret',
        '  K_NONE:',
        '    ldc.i4.0',
        '    conv.i',
        '    ret',
        '  }',
        '  .method public static int32 Isa() cil managed',
        '  {',
        '    .maxstack 8',
        '    ldc.i4.0',
        '    call native int ' + _SIMD_CLASS + '::Kern(int32)',
        '    pop',
        '    ldsfld int32 ' + _SIMD_CLASS + '::st',
        '    ldc.i4.1',
        '    bne.un N_NONE',
        '    ldsfld int32 ' + _SIMD_CLASS + '::isa',
        '    ret',
        '  N_NONE:',
        '    ldc.i4.0',
        '    ret',
        '  }',
    ]
    return ra


def _lop_simd() -> "list[str]":
    ra = ['.class public auto ansi beforefieldinit ' + _SIMD_CLASS + ' extends [mscorlib]System.Object', '{']
    ra = ra + _pt_native_ho_tro()
    ii = 0
    for d in ('f32', 'f64'):
        t = _ten_il(d)
        ra = ra + _doi_ten_v(_pt_dot(d))
        ra = ra + _doi_ten_v(_pt_sum(d))
        ra = ra + _doi_ten_v(_pt_vong_2(d, 'Add', 'op_Addition', 'add'))
        ra = ra + _doi_ten_v(_pt_vong_2(d, 'Sub', 'op_Subtraction', 'sub'))
        ra = ra + _doi_ten_v(_pt_vong_2(d, 'Mul', 'op_Multiply', 'mul'))
        ra = ra + _doi_ten_v(_pt_scale(d))
        ra = ra + _doi_ten_v(_pt_axpy(d))
        ra = ra + _mang_khoi('Dot', [t + '[] a', t + '[] b'], t, d, 'dot', ii * 7 + 0)
        ra = ra + _mang_khoi('Sum', [t + '[] a'], t, d, 'sum', ii * 7 + 1)
        ra = ra + _mang_khoi('Add', [t + '[] a', t + '[] b', t + '[] o'], 'void', d, 'add', ii * 7 + 2)
        ra = ra + _mang_khoi('Sub', [t + '[] a', t + '[] b', t + '[] o'], 'void', d, 'sub', ii * 7 + 3)
        ra = ra + _mang_khoi('Mul', [t + '[] a', t + '[] b', t + '[] o'], 'void', d, 'mul', ii * 7 + 4)
        ra = ra + _mang_khoi('Scale', [t + '[] a', t + ' s', t + '[] o'], 'void', d, 'scale', ii * 7 + 5)
        ra = ra + _mang_khoi('Axpy', [t + ' alpha', t + '[] x', t + '[] y'], 'void', d, 'axpy', ii * 7 + 6)
        ii += 1
    for d in ('i32', 'i64'):
        ra = ra + _pt_vong_2(d, 'Add', 'op_Addition', 'add')
        ra = ra + _pt_vong_2(d, 'Sub', 'op_Subtraction', 'sub')
        ra = ra + _pt_vong_2(d, 'Mul', 'op_Multiply', 'mul')
        ra = ra + _pt_scale(d)
        ra = ra + _pt_axpy(d)
        ra = ra + _pt_dot(d)
        ra = ra + _pt_sum(d)
    for d in ('f32', 'f64', 'i32', 'i64'):
        ra = ra + _pt_cuc_tri(d, 'Max', 'ble')
        ra = ra + _pt_cuc_tri(d, 'Min', 'bge')
    ra.append('}')
    return ra


def _ensure_extern(ctx: "Ctx"):
    emitted = ctx.emitted_types
    if emitted is None or 'TkvVecExtern' in emitted:
        return
    emitted.add('TkvVecExtern')
    ctx.extra_classes.append([_VEC_EXTERN])


def _ensure_class_simd(ctx: "Ctx"):
    emitted = ctx.emitted_types
    if emitted is None or _SIMD_CLASS in emitted:
        return
    _ensure_extern(ctx)
    emitted.add(_SIMD_CLASS)
    ctx.extra_classes.append(_lop_simd())


def _dtype_mang(node: "TkvNode", scope: "Scope", ten_ham: "str") -> "str":
    """dtype phan tu cua bien MANG rank 1 (f32/f64/i32/i64); loi ro neu khong dung."""
    if ekind(node) != 'var':
        raise SyntaxError("il_codegen: " + ten_ham + "() nhan BIEN mang rank 1 (vd np.zeros(n, dtype=np.float32)), gap bieu thuc")
    ta = scope.tra(ea_str(node)).ta
    if not ta.dims or len(ta.dims) != 1 or ta.dtype not in ('f32', 'f64', 'i32', 'i64'):
        raise SyntaxError(
            "il_codegen: " + ten_ham + "(" + ea_str(node) + ") can mang rank 1 kieu f32/f64/i32/i64, "
            "'" + ea_str(node) + "' co dtype=" + str(ta.dtype) + " shape=" + ta.shape_str())
    return ta.dtype


def _dtype_tra_ve(args: "list[TkvNode]", scope: "Scope", func_table: "dict[str,TkvSig]") -> "str":
    if len(args) >= 1 and ekind(args[0]) == 'var':
        try:
            ta = scope.tra(ea_str(args[0])).ta
        except KeyError:
            return 'f64'
        if ta.dims and len(ta.dims) == 1 and ta.dtype in ('f32', 'f64', 'i32', 'i64'):
            return ta.dtype
    return 'f64'


def _nap_mang(node: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    ctx.load_var_ref(ea_str(node), scope, out)


def compile_simd_dot(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 2:
        raise SyntaxError("il_codegen: simd_dot(a, b) can 2 mang cung kieu")
    d = _dtype_mang(args[0], scope, 'simd_dot')
    if _dtype_mang(args[1], scope, 'simd_dot') != d:
        raise SyntaxError("il_codegen: simd_dot(a, b): hai mang phai CUNG kieu phan tu")
    _ensure_class_simd(ctx)
    _nap_mang(args[0], scope, out, ctx)
    _nap_mang(args[1], scope, out, ctx)
    out.append('    call ' + _ten_il(d) + ' ' + _SIMD_CLASS + '::Dot' + _hau_to(d) + '(' + _ten_il(d) + '[], ' + _ten_il(d) + '[])')
    ctx.widen_if_needed(d, dtype, out)


def _compile_thu_gon(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx", ten: "str", hop: "str"):
    if len(args) != 1:
        raise SyntaxError("il_codegen: simd_" + ten.lower() + "(a) can 1 mang")
    d = _dtype_mang(args[0], scope, 'simd_' + ten.lower())
    _ensure_class_simd(ctx)
    _nap_mang(args[0], scope, out, ctx)
    out.append('    call ' + _ten_il(d) + ' ' + _SIMD_CLASS + '::' + hop + _hau_to(d) + '(' + _ten_il(d) + '[])')
    ctx.widen_if_needed(d, dtype, out)


def compile_simd_sum(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _compile_thu_gon(args, scope, out, dtype, ctx, 'Sum', 'Sum')


def compile_simd_max(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _compile_thu_gon(args, scope, out, dtype, ctx, 'Max', 'Max')


def compile_simd_min(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _compile_thu_gon(args, scope, out, dtype, ctx, 'Min', 'Min')


def _compile_vong_2(args: "list[TkvNode]", scope: "Scope", out: "list[str]", ctx: "Ctx", ten_ham: "str", hop: "str"):
    if len(args) != 3:
        raise SyntaxError("il_codegen: " + ten_ham + "(a, b, ra) can 3 mang cung kieu (ket qua ghi vao mang 'ra')")
    d = _dtype_mang(args[0], scope, ten_ham)
    if _dtype_mang(args[1], scope, ten_ham) != d or _dtype_mang(args[2], scope, ten_ham) != d:
        raise SyntaxError("il_codegen: " + ten_ham + ": ba mang phai CUNG kieu phan tu")
    _ensure_class_simd(ctx)
    _nap_mang(args[0], scope, out, ctx)
    _nap_mang(args[1], scope, out, ctx)
    _nap_mang(args[2], scope, out, ctx)
    t = _ten_il(d)
    out.append('    call void ' + _SIMD_CLASS + '::' + hop + _hau_to(d) + '(' + t + '[], ' + t + '[], ' + t + '[])')
    out.append('    ldc.i4.0')


def compile_simd_add(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _compile_vong_2(args, scope, out, ctx, 'simd_add', 'Add')


def compile_simd_sub(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _compile_vong_2(args, scope, out, ctx, 'simd_sub', 'Sub')


def compile_simd_mul(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _compile_vong_2(args, scope, out, ctx, 'simd_mul', 'Mul')


def compile_simd_scale(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 3:
        raise SyntaxError("il_codegen: simd_scale(a, s, ra) can mang a, so vo huong s, mang ra")
    d = _dtype_mang(args[0], scope, 'simd_scale')
    if _dtype_mang(args[2], scope, 'simd_scale') != d:
        raise SyntaxError("il_codegen: simd_scale: mang a va ra phai CUNG kieu phan tu")
    _ensure_class_simd(ctx)
    _nap_mang(args[0], scope, out, ctx)
    ctx.compile_expr(args[1], scope, out, d, ctx)
    _nap_mang(args[2], scope, out, ctx)
    t = _ten_il(d)
    out.append('    call void ' + _SIMD_CLASS + '::Scale' + _hau_to(d) + '(' + t + '[], ' + t + ', ' + t + '[])')
    out.append('    ldc.i4.0')


def compile_simd_axpy(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 3:
        raise SyntaxError("il_codegen: simd_axpy(alpha, x, y) can so vo huong alpha, mang x, mang y (y += alpha * x)")
    d = _dtype_mang(args[1], scope, 'simd_axpy')
    if _dtype_mang(args[2], scope, 'simd_axpy') != d:
        raise SyntaxError("il_codegen: simd_axpy: x va y phai CUNG kieu phan tu")
    _ensure_class_simd(ctx)
    ctx.compile_expr(args[0], scope, out, d, ctx)
    _nap_mang(args[1], scope, out, ctx)
    _nap_mang(args[2], scope, out, ctx)
    t = _ten_il(d)
    out.append('    call void ' + _SIMD_CLASS + '::Axpy' + _hau_to(d) + '(' + t + ', ' + t + '[], ' + t + '[])')
    out.append('    ldc.i4.0')


def compile_simd_lanes_f32(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _ensure_extern(ctx)
    out.append('    call int32 ' + _vec('f32') + '::get_Count()')


def compile_simd_lanes_f64(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _ensure_extern(ctx)
    out.append('    call int32 ' + _vec('f64') + '::get_Count()')


def compile_simd_hw(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _ensure_extern(ctx)
    out.append('    call bool ' + _VEC_ASM + '::get_IsHardwareAccelerated()')


def compile_simd_isa(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """simd_isa() -> 0 = Vector<T> (khong co kernel native), 1 = AVX2 native, 2 = SSE native (TKV_SIMD_ISA=sse)."""
    _ensure_class_simd(ctx)
    out.append('    call int32 ' + _SIMD_CLASS + '::Isa()')


def bootstrap_simd_feature(reg: "Registry"):
    """Dang ky cua module nay - goi tu compiler/bootstrap_all.py."""
    register_expr_builtin(reg, 'simd_dot', compile_simd_dot, 'f64', return_dtype_fn=_dtype_tra_ve)
    register_expr_builtin(reg, 'simd_sum', compile_simd_sum, 'f64', return_dtype_fn=_dtype_tra_ve)
    register_expr_builtin(reg, 'simd_max', compile_simd_max, 'f64', return_dtype_fn=_dtype_tra_ve)
    register_expr_builtin(reg, 'simd_min', compile_simd_min, 'f64', return_dtype_fn=_dtype_tra_ve)
    register_expr_builtin(reg, 'simd_add', compile_simd_add, 'i32')
    register_expr_builtin(reg, 'simd_sub', compile_simd_sub, 'i32')
    register_expr_builtin(reg, 'simd_mul', compile_simd_mul, 'i32')
    register_expr_builtin(reg, 'simd_scale', compile_simd_scale, 'i32')
    register_expr_builtin(reg, 'simd_axpy', compile_simd_axpy, 'i32')
    register_expr_builtin(reg, 'simd_lanes_f32', compile_simd_lanes_f32, 'i32')
    register_expr_builtin(reg, 'simd_lanes_f64', compile_simd_lanes_f64, 'i32')
    register_expr_builtin(reg, 'simd_hw', compile_simd_hw, 'bool')
    register_expr_builtin(reg, 'simd_isa', compile_simd_isa, 'i32')
