# -*- coding: utf-8 -*-
"""print(...) - moc 7 (2026-08-05).

Truoc ban va nay 'print' KHONG TON TAI trong DSL: mot file .tkv chay
duoc bang CPython nhung khong bien dich duoc neu no in bat cu thu gi -
tuc bat bien cot loi cua du an ("cung mot file, hai duong chay, cung ket
qua") khong the kiem chung tren chinh cach quan sat pho bien nhat.

Ngu nghia lay dung cua Python: cac doi so duoc str() roi noi bang MOT
dau cach, ket thuc bang xuong dong. Moi doi so di qua CUNG mot duong
chuyen chuoi voi str() (tkvstr.emit_to_str) - do la yeu cau cua chinh
moc 7: hai duong dinh dang so thuc song song thi chac chan lech nhau.

2026-09-28 (port tu compiler/il_features/print_feature.tkv): them
`sep=`/`end=`. Truoc day hai tham so nay bi BO QUA IM LANG -
`print("a","b", sep="-")` bien dich xong roi in ra "a b", khong bao loi
gi ca; nguoi dung tuong la sai cu phap. Day la lo "im lang" nguy hiem
hon ca loi, nen phai bao loi ro rang khi ten khoa sai.

GHI CHU GIOI HAN CO Y THUC: bieu thuc `sep`/`end` duoc SINH LAI cho moi
lan dung thay vi tinh MOT LAN roi giu vao bien (giong Python). Ly do: khai
bao bien phu o day di qua first-pass, con print la CALL STATEMENT nen
khong co duong de chen. Hau qua duy nhat: `sep=f()` se goi `f()` nhieu
lan. Thuc te `sep`/`end` luon la chuoi HANG so nen khong gi dang xay ra;
neu can dung bien thi `s = "-"` roi `sep=s` - chi doc bien, khong goi ham.
"""
import il_features.tkvstr as _tkvstr
from il_features.string_builtin import _is_bool_shaped
from il_features.tkvstr import emit_to_str
from expr_row import eb_ds, ekind, ea_str, eb_nut, la_node


__tkv_import__ = "il_dispatch"


def _lay_kwarg(args_ds: "list[TkvNode]", ten: "str") -> "TkvNode":
    """Node bieu thuc cua `ten=` trong danh sach tham so, `None` neu
    khong co. Doc lai tu `args_ds` thay vi giu bien phu: bien node se
    phai khai `None` roi gan - first-pass kiem kieu bien do, ma
    `TkvNode` la alias cua so nguyen nen khong gon nhu `str`."""
    for a in args_ds:
        if ekind(a) == 'kwarg' and ea_str(a) == ten:
            return eb_nut(a)
    return None


def _emit_sep(sep_expr: "TkvNode", scope: "Scope", body: "list[str]", ctx: "Ctx"):
    """Day 1 chuoi phan tach len stack (mac dinh 1 dau cach)."""
    if sep_expr is None:
        body.append('    ldstr " "')
        return
    dtype = ctx.infer_dtype(sep_expr, scope, ctx.func_table,
                            ctx.records, ctx.record_methods, None)
    if dtype not in ("str", None):
        raise SyntaxError(
            f"il_codegen: print(sep=...) phai la chuoi, gap kieu '{dtype}' - "
            f"'sep' la ky tu phan tach giua cac doi so")
    ctx.compile_expr(sep_expr, scope, body, 'str', ctx)


def _emit_str_arg(arg: "TkvNode", scope: "Scope", body: "list[str]", ctx: "Ctx"):
    """Bien 1 doi so cua print thanh chuoi tren stack (giu nguyen quy tac
    bool -> "True"/"False" cua ban goc)."""
    dtype = ctx.infer_dtype(arg, scope, ctx.func_table, ctx.records,
                            ctx.record_methods, None)
    if dtype is None:
        # ctx cua pass 2 khong co 'infer_literal_dtype' (no la moc cua
        # first-pass) - hang so tu suy tai cho, dung quy uoc CHUNG:
        # co dau '.' la f64, con lai la 'int'.
        dtype = ('f64' if (la_node(arg) and ekind(arg) == 'num' and '.' in ea_str(arg))
                 else 'int')
    ctx.compile_expr(arg, scope, body, dtype, ctx)
    # xem string_feature.tkv's _is_bool_shaped: compare/boolop/not/in/
    # all/any/startswith/endswith deu dtype='i32' nhung mang nghia
    # logic - print() phai in "True"/"False" nhu Python, khong phai so.
    emit_to_str('bool' if (dtype == 'i32' and _is_bool_shaped(arg, scope, ctx.func_table)) else dtype,
                body, ctx)


def compile_print(call_node: "TkvNode", scope: "Scope", body: "list[str]", ctx: "Ctx"):
    args_ds = eb_ds(call_node)
    # Ten khoa sai -> BAO LOI, khong bo qua (xem docstring dau file).
    for a in args_ds:
        if ekind(a) == 'kwarg':
            kname = ea_str(a)
            if kname != 'sep' and kname != 'end':
                raise SyntaxError(
                    f"il_codegen: print() khong nhan tham so tu khoa '{kname}' - "
                    f"chi 'sep' va 'end'")
    k = 0
    for a in args_ds:
        if ekind(a) == 'kwarg':
            continue
        if k:
            _emit_sep(_lay_kwarg(args_ds, 'sep'), scope, body, ctx)
        _emit_str_arg(a, scope, body, ctx)
        if k:
            body.append('    call string [mscorlib]System.String::Concat(string, string)')
            body.append('    call string [mscorlib]System.String::Concat(string, string)')
        k = k + 1
    end_expr = _lay_kwarg(args_ds, 'end')
    if k == 0:
        # print() hoac print(end=...) - WriteLine() rong, hoac rong + end.
        if end_expr is None:
            body.append('    call void [mscorlib]System.Console::WriteLine()')
            return
        _emit_str_arg(end_expr, scope, body, ctx)
        body.append('    call void [mscorlib]System.Console::Write(string)')
        return
    if end_expr is None:
        body.append('    call void [mscorlib]System.Console::WriteLine(string)')
    else:
        # HAI lenh `Write`, va thu tu RAT QUAN TRONG: lenh thu nhat DUNG
        # de day het chuoi doi so vua ghep tren xuong (WriteLine se lam
        # viec do nhung o day ta phai tu viet), lenh thu hai moi la noi
        # `end`. Bo lenh thu nuat di se bien chuoi doi so con treo tren
        # ngan xep - CLR nem InvalidProgramException luc chay.
        body.append('    call void [mscorlib]System.Console::Write(string)')
        _emit_str_arg(end_expr, scope, body, ctx)
        body.append('    call void [mscorlib]System.Console::Write(string)')