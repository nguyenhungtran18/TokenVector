# -*- coding: utf-8 -*-
"""sys.argv / sys.exit(code) (Phase 5.4, 2026-08-12) - anh xa THANG sang
Environment.GetCommandLineArgs()/Environment.Exit(int32) (xac minh THAT
qua PowerShell reflection truoc khi viet: ca 2 method deu ton tai, dung
chu ky - GetCommandLineArgs() tra 'string[]', Exit() nhan 1 tham so
'int'). Quy uoc dat ten GIONG cac module 'os.path'/'re' truoc (path_*/
re_*): TokenVector KHONG co khai niem namespace object THAT (moi import
gop phang ten vao namespace hien tai) nen 'sys.argv'/'sys.exit(code)'
duoc anh xa thanh 2 ten FLAT rieng: 'sys_argv()' (goi NHU 1 HAM, tra
list[str] - KHONG phai thuoc tinh 'sys.argv' truy cap truc tiep, gioi
han co y thuc giong cach 'os.path.exists()' -> 'path_exists()') va
'sys_exit(code)' (ham VOID, dung nhu 1 lenh doc lap - giong write_file/
log_X/pickle_dump_X, xem file_io.py's codegen_call_stmt).

sys_argv(): Environment.GetCommandLineArgs() tra 1 MANG string[] CO CA
duong dan file .exe o phan tu 0 - KHOP dung quy uoc Python that
(sys.argv[0] la ten script, sys.argv[1:] la doi so nguoi dung), khac
tham so 'args' cua chinh Main(string[] args) (KHONG co ten file, chi la
doi so nguoi dung - da dung rieng cho co che CLI tu dong bind tham so
entry, xem build_generic_main trong tkv_compile.py). Boc thanh
List<string> qua .ctor(IEnumerable<string>) - array THAT SU implement
IEnumerable<T>, tien le da dung o stdlib_aggregates.py (HashSet -> List
1 lan qua cung duong nay).

sys.path: KHONG lam - chuong trinh da AOT-compile thanh .exe tinh, khong
co dynamic import runtime nao de "duong tim module" con y nghia (cung ly
do da bo qua pdb o phan chien luoc Loai 2 dau checklist)."""
from il_dispatch import register_expr_builtin
from il_features.list_type import il_list_type


__tkv_import__ = "il_dispatch"


def push_sys_argv(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if args:
        raise SyntaxError("il_codegen: sys_argv() khong nhan tham so nao")
    list_type = il_list_type('str', ctx.records)
    out.append('    call string[] [mscorlib]System.Environment::GetCommandLineArgs()')
    out.append(
        f'    newobj instance void {list_type}::.ctor(class '
        f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')


def codegen_sys_exit(call_args: "list[TkvNode]", scope: "Scope", body: "list[str]", ctx: "Ctx"):
    if len(call_args) != 1:
        raise SyntaxError("il_codegen: sys_exit(code) can dung 1 tham so")
    ctx.compile_expr(call_args[0], scope, body, 'i32', ctx)
    body.append('    call void [mscorlib]System.Environment::Exit(int32)')


SYS_STMT_CODEGEN: "dict[str,func(list[TkvNode],Scope,list[str],Ctx)->void]" = {'sys_exit': codegen_sys_exit}


def push_now_ms(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if args:
        raise SyntaxError("il_codegen: now_ms() khong nhan tham so nao")
    out.append('    call int32 [mscorlib]System.Environment::get_TickCount()')
    out.append('    conv.r8')


def push_now_us(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if args:
        raise SyntaxError("il_codegen: now_us() khong nhan tham so nao")
    out.append('    call int32 [mscorlib]System.Environment::get_TickCount()')
    out.append('    conv.i8')
    out.append('    ldc.i8 1000')
    out.append('    mul')


def push_gc_collect(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if args:
        raise SyntaxError("il_codegen: gc_collect() khong nhan tham so nao")
    out.append('    call void [mscorlib]System.GC::Collect()')
    out.append('    ldc.i4 0')


def push_gc_allocated_bytes(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if args:
        raise SyntaxError("il_codegen: gc_allocated_bytes() khong nhan tham so nao")
    out.append('    ldc.i4 0')
    out.append('    call int64 [mscorlib]System.GC::GetTotalMemory(bool)')


def push_gc_counts(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """gc_counts() -> 'gen0/gen1/gen2' - so lan GC da chay moi the he do (that,
    qua GC.CollectionCount(int)). Ban truoc hard-code `ldstr ""` nen downstream
    in ra 'GC ' rong va gate 0/0/0 khong bao gio xanh - cai bay am thanh."""
    if args:
        raise SyntaxError("il_codegen: gc_counts() khong nhan tham so nao")
    # Ghep bang Concat(string,string) long nhau, KHONG dung mang 5 phan tu:
    # moi Concat2 an dung 2 phan tu vua day nhat, nen phai xen ke push/concat.
    for gen in (0, 1, 2):
        if gen > 0:
            out.append('    ldstr "/"')
            out.append('    call string [mscorlib]System.String::Concat(string, string)')
        out.append(f'    ldc.i4 {gen}')
        out.append('    call int32 [mscorlib]System.GC::CollectionCount(int32)')
        # KHONG dung `call instance Int32::ToString()`: voi value type, `call
        # instance` can MANAGED POINTER (ldloca) chu khong phai gia tri tho -
        # day gia tri -> NullReferenceException. Convert::ToString(int32) la
        # static, nhan int32 truc tiep nen an toan.
        out.append('    call string [mscorlib]System.Convert::ToString(int32)')
        if gen > 0:
            out.append('    call string [mscorlib]System.String::Concat(string, string)')


def bootstrap_stdlib_sys(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_expr_builtin(reg, 'sys_argv', push_sys_argv, 'str', return_shape='list')
    register_expr_builtin(reg, 'now_ms', push_now_ms, 'f64')
    register_expr_builtin(reg, 'now_us', push_now_us, 'i64')
    register_expr_builtin(reg, 'gc_collect', push_gc_collect, 'i32')
    register_expr_builtin(reg, 'gc_allocated_bytes', push_gc_allocated_bytes, 'i64')
    register_expr_builtin(reg, 'gc_counts', push_gc_counts, 'str')
