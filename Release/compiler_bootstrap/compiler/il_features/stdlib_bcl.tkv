# -*- coding: utf-8 -*-
"""PyStdlib BCL (Moc 33, 2026-08-09) - re, random qua BCL .NET.

Cung mot file .tkv, 2 duong chay (CPython & TokenVector .exe), cung ket qua.

TRUOC 2026-11-03: module nay CO Y khong nam trong `bootstrap_all` vi codegen
phat loi goi toi cac method helper chi ton tai trong mot HANG CHUOI khong ai
tham chieu (`TkvApp::TkvReReplace`...) -> chuong trinh bien dich trot lot roi
nem `MissingMethodException` luc chay.

NAY: helper duoc phat THAT thanh mot class rieng `TkvBcl` (khuon `IPOW_CLASS`
trong il_features/stdlib_math.py: `ctx.extra_classes.append(...)` co canh gac
`emitted_types`), va module da duoc noi trong `bootstrap_all.tkv`. Vi sao phai
la CLASS RIENG chu khong phai method cua class dang sinh: tai thoi diem codegen
KHONG co co che "them method vao chinh class dang sinh" - xem ghi chu cu.
"""
from il_dispatch import register_expr_builtin

__tkv_import__ = "il_dispatch"

BCL_CLASS = 'TkvBcl'


def _ensure_bcl_class(ctx: "Ctx"):
    """Chen .class TkvBcl DUNG MOT LAN (cung co che ensure_class cua int_type)."""
    emitted = ctx.emitted_types
    if emitted is None or BCL_CLASS in emitted:
        return
    emitted.add(BCL_CLASS)
    ctx.extra_classes.append(_gen_bcl_class_il())


def _gen_bcl_class_il() -> "list[str]":
    """`Regex.Replace` va `Random.Next`.

    `rnd` la FIELD TINH khoi tao LAN DAU, khong phai `newobj Random` moi lan
    goi: `System.Random` khong tham so duoc seed bang dong ho, nen tao moi lan
    trong cung mot tick se tra CUNG mot day so - dung ra la ngau nhien ma lai
    thanh hang so lap lai.
    """
    return [
        f'.class public abstract sealed auto ansi {BCL_CLASS}',
        '       extends [mscorlib]System.Object',
        '{',
        '  .field private static class [mscorlib]System.Random rnd',
        '  .method public static string ReReplace(string text, string pattern, string repl) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldarg.0',
        '    ldarg.1',
        '    ldarg.2',
        '    call string [System]System.Text.RegularExpressions.Regex::Replace(string, string, string)',
        '    ret',
        '  }',
        '  .method public static int32 Randint(int32 lo, int32 hi) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldsfld class [mscorlib]System.Random TkvBcl::rnd',
        '    brtrue RAND_HAVE',
        '    newobj instance void [mscorlib]System.Random::.ctor()',
        '    stsfld class [mscorlib]System.Random TkvBcl::rnd',
        '  RAND_HAVE:',
        '    ldsfld class [mscorlib]System.Random TkvBcl::rnd',
        '    ldarg.0',
        '    ldarg.1',
        '    ldc.i4.1',
        '    add',
        '    callvirt instance int32 [mscorlib]System.Random::Next(int32, int32)',
        '    ret',
        '  }',
        '}',
    ]


def compile_re_replace(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """re_replace(text, pattern, replacement) -> Regex.Replace."""
    if len(args) != 3:
        raise SyntaxError("il_codegen: re_replace(text, pattern, replacement) nhan 3 tham so")
    _ensure_bcl_class(ctx)
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    ctx.compile_expr(args[1], scope, out, 'str', ctx)
    ctx.compile_expr(args[2], scope, out, 'str', ctx)
    out.append(f'    call string {BCL_CLASS}::ReReplace(string, string, string)')
    if dtype:
        ctx.widen_if_needed('str', dtype, out)


def compile_random_randint(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """random_randint(min, max) -> so nguyen trong [min, max] KIEP KIN ca hai
    dau, giong `random.randint` cua Python (`Random.Next` cua .NET la nua mo
    [min, max) nen helper phai cong 1 vao `max`)."""
    if len(args) != 2:
        raise SyntaxError("il_codegen: random_randint(min, max) nhan 2 tham so")
    _ensure_bcl_class(ctx)
    ctx.compile_expr(args[0], scope, out, 'i32', ctx)
    ctx.compile_expr(args[1], scope, out, 'i32', ctx)
    out.append(f'    call int32 {BCL_CLASS}::Randint(int32, int32)')
    if dtype:
        ctx.widen_if_needed('i32', dtype, out)


def bootstrap_stdlib_bcl(reg: "Registry") -> "i32":
    """Dang ky cua module nay - goi tu `bootstrap_all.tkv`.

    Khong rang buoc thu tu: ca hai builtin vao BANG `expr_builtin_codegen`
    (tra cuu theo ten), khong vao danh sach thu tuan tu.
    """
    register_expr_builtin(reg, 're_replace', compile_re_replace, return_dtype='str')
    register_expr_builtin(reg, 'random_randint', compile_random_randint, return_dtype='i32')
    return 0
