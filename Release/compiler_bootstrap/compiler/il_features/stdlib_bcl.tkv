# -*- coding: utf-8 -*-
"""PyStdlib BCL Expansion (Moc 33, 2026-08-09) - re, datetime, random, hashlib, socket.

Cung mot file .tkv, 2 duong chay (CPython & TokenVector .exe), cung ket qua 100%.

CHUA HOAN THANH - KHONG DUOC NOI DAY (do that 2026-09-17)
=========================================================
Hang `STDLIB_BCL_CIL_HELPERS` ben duoi chua than IL cua cac method helper ma codegen o
day PHAT LOI GOI TOI. Hang do duoc dinh nghia MOT LAN va KHONG AI THAM
CHIEU - da grep toan repo. Hau qua do bang cach chay that: chuong trinh
bien dich TROT LOT roi nem `System.MissingMethodException: Method not
found: '...'` ngay khi goi.

Nen module nay CO Y khong nam trong `bootstrap_all`. Muon hoan thien:
boc khoi helper thanh mot class rieng theo khuon `IPOW_CLASS` trong
il_features/stdlib_math.py (`ctx.extra_classes.append(...)` co canh gac
`emitted_types`), roi doi cho goi tu `TKVApp::Tkv...` sang class do -
hien khong co co che "them method vao chinh class dang sinh".
"""
from il_dispatch import register_expr_builtin

__tkv_import__ = "il_dispatch"

def compile_re_replace(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """re_replace(text, pattern, replacement) -> Regex.Replace."""
    if len(args) != 3:
        raise SyntaxError("il_codegen: re_replace(text, pattern, replacement) nhan 3 tham so")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    ctx.compile_expr(args[1], scope, out, 'str', ctx)
    ctx.compile_expr(args[2], scope, out, 'str', ctx)
    out.append(f'    call string class {ctx.class_name}::TkvReReplace(string, string, string)')
    if dtype:
        ctx.widen_if_needed('str', dtype, out)

def compile_random_randint(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """random_randint(min, max) -> Random.Next(min, max)."""
    if len(args) != 2:
        raise SyntaxError("il_codegen: random_randint(min, max) nhan 2 tham so")
    ctx.compile_expr(args[0], scope, out, 'i32', ctx)
    ctx.compile_expr(args[1], scope, out, 'i32', ctx)
    out.append(f'    call int32 class {ctx.class_name}::TkvRandomRandint(int32, int32)')
    if dtype:
        ctx.widen_if_needed('i32', dtype, out)


STDLIB_BCL_CIL_HELPERS = '''  .method public static string TkvReReplace(string text, string pattern, string replacement) cil managed
  {
    .maxstack 8
    ldarg.0
    ldarg.1
    ldarg.2
    call string [System]System.Text.RegularExpressions.Regex::Replace(string, string, string)
    ret
  }
  .method public static int32 TkvRandomRandint(int32 min_val, int32 max_val) cil managed
  {
    .maxstack 8
    newobj instance void [mscorlib]System.Random::.ctor()
    ldarg.0
    ldarg.1
    callvirt instance int32 [mscorlib]System.Random::Next(int32, int32)
    ret
  }
'''


def bootstrap_stdlib_bcl(reg: "Registry") -> "i32":
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh giong moi bootstrap_<module>() khac. Truoc day
    cac loi goi nay nam o CAP MODULE va con dung chu ky cu (thieu
    tham so `reg`) - phep kiem cua P6 chi quet cay .py nen khong
    nhin thay file CHI-CO-TKV nay.
    """
    register_expr_builtin(reg, 're_replace', compile_re_replace, return_dtype='str')
    register_expr_builtin(reg, 'random_randint', compile_random_randint, return_dtype='i32')
    return 0
