# -*- coding: utf-8 -*-
"""Slicing 'a[i:j]' cho list VA string (2026-07-29, Wave 1 Nhom A - P0).
Cu phap parse tag 'slice' o il_core.py (dung CHUNG cho ca 2 truong hop,
khong co syntax rieng - phan biet luc CODEGEN qua shape/dtype cua bien
nguon, giong cach _expr_index re nhanh list/dict/string/mang).

PHAM VI CO CHU DICH (gioi han da biet, khong phai thieu cong suc): CHI ho
tro slice o vi tri RHS TRUC TIEP cua 1 phep gan don ('sub = lst[i:j]' /
'sub = s[i:j]') - KHONG ho tro long trong bieu thuc khac (vd
'foo(lst[i:j])', 'lst[i:j][0]'). Ly do: local AN giu gia tri 'start'
(tinh 1 lan, dung 2 lan - lam tham so dau cua GetRange()/Substring() VA
lam so hang tru khi tinh 'count') chi duoc cap phat o 2 diem vao BIET
TRUOC (_fpw_assign_scalar cho truong hop string, fpw_assign_list_slice o
day cho truong hop list) - dung slice o noi khac se bi loi ro rang luc
compile (thieu local AN), khong bao gio sinh sai ma khong bao.

Chi so AM (Python 'lst[-2:]'): CHI ho tro HANG SO tai compile-time (vd
'lst[-2:]'/'s[:-1]'), giong emit_index_value's gioi han cho 'lst[-1]' -
doi thanh Count/Length - N. Bieu thuc am DONG ('lst[-i:]') VAN chua ho
tro - .NET GetRange()/Substring() se nem ArgumentOutOfRangeException LUC
CHAY neu dung (khong kiem tra rieng luc compile)."""
import stmt_row as _row
import re

from il_core import parse_expr, nid
from il_dispatch import (
    register_assign_rhs_parser, register_expr_builtin, register_expr_codegen,
    register_first_pass_walk, register_stmt_codegen,
)
from tkv_types import TypeAnn
from stmt_row import intern, lay_nut, lay_str, make3
from expr_row import ea_str, eb_nut, ec_nut, ekind

_SLICE_RHS_RE = re.compile(r'^(\w+)\[[^\[\]]*:[^\[\]]*\]$')


__tkv_import__ = ["il_dispatch", "tkv_types"]

def try_rhs_list_slice(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    """ASSIGN_RHS_PARSERS entry: 'sub = lst[i:j]' KHI 'lst' DA BIET la
    list (known_shapes, seed tu tham so HOAC tu 'lst = []' truoc do trong
    CUNG ham). Khong khop (tra None) khi nguon KHONG phai list - roi
    xuong fallback 'assign_scalar' chung (truong hop string, _infer_dtype's
    nhanh 'slice' xu ly, xem il_codegen.py)."""
    m = _SLICE_RHS_RE.match(rhs.strip())
    if not m or known_shapes.get(m.group(1)) != 'list':
        return None
    node = parse_expr(rhs)
    if ekind(node) != 'slice':
        return None
    known_shapes[name] = 'list'
    return intern(make3('assign_list_slice', name, rhs))


_SLICE_CLASS = 'TkvSlice'


def _ensure_class_slice(ctx: "Ctx"):
    """TkvSlice::Norm/Cnt - chi so cat lat theo ngu nghia Python (am -> +n, roi kep vao
    [0, n]; do dai am -> 0), thay cho GetRange/Substring nem ArgumentOutOfRange (2026-09-30)."""
    emitted = ctx.emitted_types
    if emitted is None or _SLICE_CLASS in emitted:
        return
    emitted.add(_SLICE_CLASS)
    ctx.extra_classes.append([
        f'.class public auto ansi beforefieldinit {_SLICE_CLASS} extends [mscorlib]System.Object',
        '{',
        '  .method public static int32 Norm(int32 i, int32 n) cil managed',
        '  {',
        '    .maxstack 4',
        '    ldarg.0',
        '    ldc.i4.0',
        '    bge TKVSL_NN',
        '    ldarg.0',
        '    ldarg.1',
        '    add',
        '    dup',
        '    ldc.i4.0',
        '    bge TKVSL_OK',
        '    pop',
        '    ldc.i4.0',
        '  TKVSL_OK:',
        '    ret',
        '  TKVSL_NN:',
        '    ldarg.0',
        '    ldarg.1',
        '    ble TKVSL_LE',
        '    ldarg.1',
        '    ret',
        '  TKVSL_LE:',
        '    ldarg.0',
        '    ret',
        '  }',
        '  .method public static int32 Cnt(int32 stop, int32 start) cil managed',
        '  {',
        '    .maxstack 4',
        '    ldarg.0',
        '    ldarg.1',
        '    sub',
        '    dup',
        '    ldc.i4.0',
        '    bge TKVSL_C',
        '    pop',
        '    ldc.i4.0',
        '  TKVSL_C:',
        '    ret',
        '  }',
        '  .method public static int32 NegNorm(int32 a, int32 n) cil managed',
        '  {',
        '    .maxstack 4',
        '    ldarg.0', '    ldc.i4.0', '    bge TKVSL_N1',
        '    ldarg.0', '    ldarg.1', '    add', '    dup', '    ldc.i4.0', '    bge TKVSL_N0',
        '    pop', '    ldc.i4.m1',
        '  TKVSL_N0:', '    ret',
        '  TKVSL_N1:',
        '    ldarg.0', '    ldarg.1', '    blt TKVSL_N2',
        '    ldarg.1', '    ldc.i4.1', '    sub', '    ret',
        '  TKVSL_N2:', '    ldarg.0', '    ret',
        '  }',
        '  .method public static int32 Lo(int32 a, int32 fl, int32 st, int32 n) cil managed',
        '  {',
        '    .maxstack 4',
        '    ldarg.2', '    ldc.i4.0', '    blt TKVSL_LN',
        '    ldarg.1', '    ldc.i4.1', '    and', '    brtrue TKVSL_LA',
        '    ldc.i4.0', '    ret',
        '  TKVSL_LA:', '    ldarg.0', '    ldarg.3', '    call int32 TkvSlice::Norm(int32, int32)', '    ret',
        '  TKVSL_LN:',
        '    ldarg.1', '    ldc.i4.1', '    and', '    brtrue TKVSL_LB',
        '    ldarg.3', '    ldc.i4.1', '    sub', '    ret',
        '  TKVSL_LB:', '    ldarg.0', '    ldarg.3', '    call int32 TkvSlice::NegNorm(int32, int32)', '    ret',
        '  }',
        '  .method public static int32 Hi(int32 b, int32 fl, int32 st, int32 n) cil managed',
        '  {',
        '    .maxstack 4',
        '    ldarg.2', '    ldc.i4.0', '    blt TKVSL_HN',
        '    ldarg.1', '    ldc.i4.2', '    and', '    brtrue TKVSL_HA',
        '    ldarg.3', '    ret',
        '  TKVSL_HA:', '    ldarg.0', '    ldarg.3', '    call int32 TkvSlice::Norm(int32, int32)', '    ret',
        '  TKVSL_HN:',
        '    ldarg.1', '    ldc.i4.2', '    and', '    brtrue TKVSL_HB',
        '    ldc.i4.m1', '    ret',
        '  TKVSL_HB:', '    ldarg.0', '    ldarg.3', '    call int32 TkvSlice::NegNorm(int32, int32)', '    ret',
        '  }',
        '  .method public static class [mscorlib]System.Collections.Generic.List`1<!!0> StepL<T>(class [mscorlib]System.Collections.Generic.List`1<!!0> s, int32 a, int32 b, int32 st, int32 fl) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (class [mscorlib]System.Collections.Generic.List`1<!!0> r, int32 n, int32 i, int32 h)',
        '    ldarg.3', '    brtrue TKVSL_SOK',
        '    ldstr "slice step cannot be zero"', '    newobj instance void [mscorlib]System.ArgumentException::.ctor(string)', '    throw',
        '  TKVSL_SOK:',
        '    ldarg.0', '    callvirt instance int32 class [mscorlib]System.Collections.Generic.List`1<!!0>::get_Count()', '    stloc.1',
        '    newobj instance void class [mscorlib]System.Collections.Generic.List`1<!!0>::.ctor()', '    stloc.0',
        '    ldarg.1', '    ldarg.s fl', '    ldarg.3', '    ldloc.1', '    call int32 TkvSlice::Lo(int32, int32, int32, int32)', '    stloc.2',
        '    ldarg.2', '    ldarg.s fl', '    ldarg.3', '    ldloc.1', '    call int32 TkvSlice::Hi(int32, int32, int32, int32)', '    stloc.3',
        '  TKVSL_LP:',
        '    ldarg.3', '    ldc.i4.0', '    blt TKVSL_LD',
        '    ldloc.2', '    ldloc.3', '    bge TKVSL_LE', '    br TKVSL_LB2',
        '  TKVSL_LD:',
        '    ldloc.2', '    ldloc.3', '    ble TKVSL_LE',
        '  TKVSL_LB2:',
        '    ldloc.0', '    ldarg.0', '    ldloc.2', '    callvirt instance !0 class [mscorlib]System.Collections.Generic.List`1<!!0>::get_Item(int32)',
        '    callvirt instance void class [mscorlib]System.Collections.Generic.List`1<!!0>::Add(!0)',
        '    ldloc.2', '    ldarg.3', '    add', '    stloc.2', '    br TKVSL_LP',
        '  TKVSL_LE:', '    ldloc.0', '    ret',
        '  }',
        '  .method public static class [mscorlib]System.Collections.Generic.List`1<!!0> RepL<T>(class [mscorlib]System.Collections.Generic.List`1<!!0> s, int32 n) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (class [mscorlib]System.Collections.Generic.List`1<!!0> r, int32 i)',
        '    newobj instance void class [mscorlib]System.Collections.Generic.List`1<!!0>::.ctor()', '    stloc.0',
        '    ldc.i4.0', '    stloc.1',
        '  TKVSL_RL:',
        '    ldloc.1', '    ldarg.1', '    bge TKVSL_RE',
        '    ldloc.0', '    ldarg.0', '    callvirt instance void class [mscorlib]System.Collections.Generic.List`1<!!0>::AddRange(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)',
        '    ldloc.1', '    ldc.i4.1', '    add', '    stloc.1', '    br TKVSL_RL',
        '  TKVSL_RE:', '    ldloc.0', '    ret',
        '  }',
        '  .method public static string StepS(string s, int32 a, int32 b, int32 st, int32 fl) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (class [mscorlib]System.Text.StringBuilder r, int32 n, int32 i, int32 h)',
        '    ldarg.3', '    brtrue TKVSL_TOK',
        '    ldstr "slice step cannot be zero"', '    newobj instance void [mscorlib]System.ArgumentException::.ctor(string)', '    throw',
        '  TKVSL_TOK:',
        '    ldarg.0', '    callvirt instance int32 [mscorlib]System.String::get_Length()', '    stloc.1',
        '    newobj instance void [mscorlib]System.Text.StringBuilder::.ctor()', '    stloc.0',
        '    ldarg.1', '    ldarg.s fl', '    ldarg.3', '    ldloc.1', '    call int32 TkvSlice::Lo(int32, int32, int32, int32)', '    stloc.2',
        '    ldarg.2', '    ldarg.s fl', '    ldarg.3', '    ldloc.1', '    call int32 TkvSlice::Hi(int32, int32, int32, int32)', '    stloc.3',
        '  TKVSL_SP:',
        '    ldarg.3', '    ldc.i4.0', '    blt TKVSL_SD',
        '    ldloc.2', '    ldloc.3', '    bge TKVSL_SE', '    br TKVSL_SB',
        '  TKVSL_SD:',
        '    ldloc.2', '    ldloc.3', '    ble TKVSL_SE',
        '  TKVSL_SB:',
        '    ldloc.0', '    ldarg.0', '    ldloc.2', '    callvirt instance char [mscorlib]System.String::get_Chars(int32)',
        '    callvirt instance class [mscorlib]System.Text.StringBuilder [mscorlib]System.Text.StringBuilder::Append(char)', '    pop',
        '    ldloc.2', '    ldarg.3', '    add', '    stloc.2', '    br TKVSL_SP',
        '  TKVSL_SE:', '    ldloc.0', '    callvirt instance string [mscorlib]System.Object::ToString()', '    ret',
        '  }',
        '}',
    ])


def compile_slice(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """EXPR_CODEGEN entry cho tag 'slice' - dung CHUNG list/string.

    THU TU STACK: tinh 'start' TRUOC, luu vao local AN (can dung 2 lan);
    nap nguon, nap start (lam tham so 1), tinh 'stop' (mac dinh =
    get_Count()/get_Length() cua nguon neu vang mat), nap lai start tu
    local, 'sub' de duoc count=stop-start - dung THU TU nay (KHONG phai
    'start-stop') vi IL 'sub' tinh (gia_tri_duoi - gia_tri_tren) tren 2
    phan tu DINH stack, da xac minh THAT qua ilasm.exe compile+run doi
    chieu ket qua voi Python that (xem STATUS.md)."""
    # Tach ra 3 phep gan THUONG (khong go bo tuple): 'src_name' bi ham long
    # '_emit_bound' bat, ma TokenVector chi nhan phep gan thuong lam cho khai bao.
    src_name = ea_str(node)
    start_node = eb_nut(node)
    stop_node = ec_nut(node)
    src_ta = scope.tra(src_name).ta
    _ensure_class_slice(ctx)
    compile_expr = ctx.compile_expr
    load_var_ref = ctx.load_var_ref
    # Khai bao TRUOC ham long '_emit_bound' (no bat bien nay): TokenVector
    # doi bien bi bat co 1 phep gan THUONG truoc dinh nghia ham long,
    # khong nhan phep gan chi nam trong cac nhanh if/elif.
    count_call = ''

    if src_ta.shape_ten == 'list':
        list_type = ctx.il_type_str(src_ta, (ctx.records if ctx is not None else None))
        count_call = f'callvirt instance int32 {list_type}::get_Count()'
        # QUAN TRONG (giong get_Item's '!0'): return type cua GetRange()
        # duoc dinh nghia TREN generic type MO (List`1<!0>), KHONG phai
        # kieu da thay the (vd List`1<int32>) - metadata phai ghi dung
        # nhu vay, bug that phat hien qua ilasm.exe chay (MissingMethodException).
        slice_call = (
            f'callvirt instance class [mscorlib]System.Collections.Generic.List`1<!0> '
            f'{list_type}::GetRange(int32, int32)')
    elif src_ta.dtype == 'str' and src_ta.la_vo_huong():
        count_call = 'callvirt instance int32 [mscorlib]System.String::get_Length()'
        slice_call = 'callvirt instance string [mscorlib]System.String::Substring(int32, int32)'
    else:
        raise SyntaxError(
            f"il_codegen: '{src_name}[i:j]' chi ho tro tren list hoac string, "
            f"'{src_name}' co shape={src_ta.shape_repr()} dtype={src_ta.dtype!r}")

    _ten_slice = f'__slice{nid(node)}_start'
    try:
        start_idx = scope.tra(_ten_slice).idx
    except KeyError:
        # (2026-10-15) giong ternary (xem _expr_ternary trong il_codegen):
        # LICM viet lai AST (_licm_viet_node tao node 'slice' MOI qua mk4)
        # nen slice nay first-pass CHUA TUNG thay -> chua khai bao temp.
        # Cap temp ngay tai day (AN TOAN: `.locals init` sinh SAU codegen
        # tu ctx.locals_decl, giong cach LICM tu cap __licmN).
        ctx.locals_decl.append((_ten_slice, TypeAnn('i32', None)))
        start_idx = len(ctx.locals_decl) - 1
        scope.add_local(_ten_slice, start_idx, TypeAnn('i32', None))

    def _emit_bound(bnode: "TkvNode", default_is_count: "i32"):
        # Chi so am HANG SO tai compile-time (vd -2) -> Count/Length - N,
        # giong emit_index_value cua il_core.py (chi so don, khong
        # slice) - xem gioi han o docstring dau file.
        nonlocal compile_expr, count_call, ctx, load_var_ref, out, scope, src_name
        if bnode is None:
            if default_is_count:
                load_var_ref(src_name, scope, out)
                out.append(f'    {count_call}')
            else:
                out.append('    ldc.i4.0')
            return
        compile_expr(bnode, scope, out, 'i32', ctx)
        load_var_ref(src_name, scope, out)
        out.append(f'    {count_call}')
        out.append(f'    call int32 {_SLICE_CLASS}::Norm(int32, int32)')

    _emit_bound(start_node, default_is_count=False)
    out.append(f'    stloc.s {start_idx}')

    load_var_ref(src_name, scope, out)
    out.append(f'    ldloc.s {start_idx}')
    _emit_bound(stop_node, default_is_count=True)
    out.append(f'    ldloc.s {start_idx}')
    out.append(f'    call int32 {_SLICE_CLASS}::Cnt(int32, int32)')
    out.append(f'    {slice_call}')


def compile_slice_step(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'name[a:b:c]' -> slice_step(name, a, b, c, co) (il_core parse_factor). Ngu nghia Python:
    buoc am duyet nguoc, chi so am/vuot bien bi kep, buoc 0 nem ValueError. list va string."""
    if len(args) != 5 or ekind(args[0]) != 'var':
        raise SyntaxError("il_codegen: slice co buoc chi ho tro tren 1 bien list hoac string")
    src_name = ea_str(args[0])
    src_ta = scope.tra(src_name).ta
    _ensure_class_slice(ctx)
    compile_expr = ctx.compile_expr
    if src_ta.shape_ten == 'list':
        if src_ta.elem_ta is not None:
            raise SyntaxError("il_codegen: slice co buoc tren list long nhau (list[list[...]]) chua ho tro")
        list_type = ctx.il_type_str(src_ta, (ctx.records if ctx is not None else None))
        vt = list_type.index('<')
        elem_il = list_type[vt + 1:len(list_type) - 1]
        ctx.load_var_ref(src_name, scope, out)
        k = 1
        while k <= 4:
            compile_expr(args[k], scope, out, 'i32', ctx)
            k = k + 1
        out.append(f'    call class [mscorlib]System.Collections.Generic.List`1<!!0> {_SLICE_CLASS}::StepL<{elem_il}>'
                   f'(class [mscorlib]System.Collections.Generic.List`1<!!0>, int32, int32, int32, int32)')
        return
    if src_ta.dtype == 'str' and src_ta.la_vo_huong():
        ctx.load_var_ref(src_name, scope, out)
        k = 1
        while k <= 4:
            compile_expr(args[k], scope, out, 'i32', ctx)
            k = k + 1
        out.append(f'    call string {_SLICE_CLASS}::StepS(string, int32, int32, int32, int32)')
        return
    raise SyntaxError(
        f"il_codegen: '{src_name}[a:b:c]' chi ho tro tren list hoac string, "
        f"'{src_name}' co shape={src_ta.shape_repr()} dtype={src_ta.dtype!r}")


def fpw_assign_list_slice(stmt: "i32", ctx: "WalkCtx"):
    src_name = ea_str(lay_nut(stmt, 'slice_node'))
    src_ta = ctx.infer_scope.tra(src_name).ta
    ta = TypeAnn(src_ta.dtype, 'list')
    ctx.declare_named(lay_str(stmt, 'name'), ta)
    ctx.declare_named(f'__slice{nid(lay_nut(stmt, "slice_node"))}_start', TypeAnn('i32', None))
    _sn = lay_nut(stmt, 'slice_node')
    start_node, stop_node = eb_nut(_sn), ec_nut(_sn)
    if start_node is not None:
        ctx.collect_ternary_temps(start_node)
    if stop_node is not None:
        ctx.collect_ternary_temps(stop_node)


def codegen_assign_list_slice(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    ta = scope.tra(lay_str(stmt, 'name')).ta
    ctx.compile_expr(lay_nut(stmt, 'slice_node'), scope, body, ta.dtype, ctx)
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def bootstrap_slicing(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_assign_rhs_parser(reg, 'list_slice', try_rhs_list_slice)
    register_expr_codegen(reg, 'slice', compile_slice)
    register_expr_builtin(reg, 'slice_step', compile_slice_step, 'str')
    register_first_pass_walk(reg, 'assign_list_slice', fpw_assign_list_slice)
    register_stmt_codegen(reg, 'assign_list_slice', codegen_assign_list_slice)
