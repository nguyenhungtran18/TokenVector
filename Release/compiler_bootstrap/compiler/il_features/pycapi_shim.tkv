# -*- coding: utf-8 -*-
"""CPython C-API Compatibility Shim (Moc 37, 2026-08-09) - PyObject & C-Extension interop.

Cung mot file .tkv, 2 duong chay (CPython & TokenVector .exe), cung ket qua.

TRUOC 2026-11-03: module nay CO Y khong nam trong `bootstrap_all` vi codegen
phat loi goi toi cac method helper chi ton tai trong mot HANG CHUOI khong ai
tham chieu -> chuong trinh bien dich trot lot roi nem `MissingMethodException`
luc chay.

NAY: helper duoc phat THAT thanh class rieng `TkvPyCapi` (khuon `IPOW_CLASS`
trong il_features/stdlib_math.py: `ctx.extra_classes.append(...)` co canh gac
`emitted_types`), va module da duoc noi trong `bootstrap_all.tkv`.

GIOI HAN CON LAI (khong phai loi wiring): gia tri tra ve co dtype `object`,
nen tu trong DSL chi dung duoc o nhung cho nhan `object` (vd tham so cua ham
extern khai `object`). Chua co phep toan nao tren `object` (len/index/str...),
tuc day moi la lop NEN de C-extension truyen PyObject qua lai, khong phai
mot API nguoi dung cuoi.
"""
from il_dispatch import register_expr_builtin

__tkv_import__ = "il_dispatch"

PYCAPI_CLASS = 'TkvPyCapi'


def _ensure_pycapi_class(ctx: "Ctx"):
    """Chen .class TkvPyCapi DUNG MOT LAN (cung co che ensure_class int_type)."""
    emitted = ctx.emitted_types
    if emitted is None or PYCAPI_CLASS in emitted:
        return
    emitted.add(PYCAPI_CLASS)
    ctx.extra_classes.append(_gen_pycapi_class_il())


def _gen_pycapi_class_il() -> "list[str]":
    return [
        f'.class public abstract sealed auto ansi {PYCAPI_CLASS}',
        '       extends [mscorlib]System.Object',
        '{',
        '  .method public static class [mscorlib]System.Collections.Generic.List`1<object> PyTupleNew(int32 size) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldarg.0',
        '    newobj instance void class [mscorlib]System.Collections.Generic.List`1<object>::.ctor(int32)',
        '    ret',
        '  }',
        '  .method public static class [mscorlib]System.Collections.Generic.Dictionary`2<object,object> PyDictNew() cil managed',
        '  {',
        '    .maxstack 8',
        '    newobj instance void class [mscorlib]System.Collections.Generic.Dictionary`2<object,object>::.ctor()',
        '    ret',
        '  }',
        '}',
    ]


def compile_py_tuple_new(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """py_tuple_new(size) -> List<object> as PyTuple."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: py_tuple_new(size) nhan 1 tham so i32")
    _ensure_pycapi_class(ctx)
    ctx.compile_expr(args[0], scope, out, 'i32', ctx)
    out.append(f'    call class [mscorlib]System.Collections.Generic.List`1<object> {PYCAPI_CLASS}::PyTupleNew(int32)')
    if dtype:
        ctx.widen_if_needed('object', dtype, out)


def compile_py_dict_new(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """py_dict_new() -> Dictionary<object, object> as PyDict."""
    _ensure_pycapi_class(ctx)
    out.append(f'    call class [mscorlib]System.Collections.Generic.Dictionary`2<object,object> {PYCAPI_CLASS}::PyDictNew()')
    if dtype:
        ctx.widen_if_needed('object', dtype, out)


def bootstrap_pycapi_shim(reg: "Registry") -> "i32":
    """Dang ky cua module nay - goi tu `bootstrap_all.tkv`.

    Khong rang buoc thu tu: ca hai builtin vao BANG `expr_builtin_codegen`
    (tra cuu theo ten), khong vao danh sach thu tuan tu.
    """
    register_expr_builtin(reg, 'py_tuple_new', compile_py_tuple_new, return_dtype='object')
    register_expr_builtin(reg, 'py_dict_new', compile_py_dict_new, return_dtype='object')
    return 0
