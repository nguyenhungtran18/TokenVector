# -*- coding: utf-8 -*-
"""d.get(k, default) (2026-07-29) - soan nhap boi Gemini, dung khop chu ky
method_call that ngay lan dau. Re nhanh kieu ternary (label_counter/prefix)
dua theo ContainsKey().

GIOI HAN DA BIET (giong path_exists()): key_node duoc compile_expr HAI
LAN (1 lan ContainsKey, 1 lan get_Item neu nhanh do chay) - an toan neu k
la 1 bien/hang, co the tinh lai sai neu k la 1 bieu thuc phuc tap co
side-effect."""


__tkv_import__ = "il_dispatch"
from expr_row import ea_ds, ea_str, ec_ds, ekind
from il_features.dict_type import emit_contains_key


def _la_rong(nut: "TkvNode") -> "i32":
    k = ekind(nut)
    return k == 'dict_rong' or (k == 'list_literal' and len(ea_ds(nut)) == 0)


def compile_dict_method_get(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    obj_name, args = ea_str(node), ec_ds(node)
    if len(args) != 1 and len(args) != 2:
        raise SyntaxError("il_codegen: d.get(k) / d.get(k, default) can 1 hoac 2 tham so")
    ta = scope.tra(obj_name).ta
    if ta.shape_ten != 'dict':
        raise SyntaxError(f"il_codegen: '{obj_name}.get(...)' can '{obj_name}' la dict")
    key_node = args[0]
    # d.get(k) KHONG mac dinh (2026-09-25): Python tra None. Chi lam duoc khi
    # GIA TRI la kieu THAM CHIEU (None = null); gia tri so thi None khong co
    # dang IL nao - bao loi ro thay vi tra 0 am tham.
    gia_tri_so = ta.elem_ta is None and ta.dtype in ('i32', 'i64', 'f32', 'f64', 'bool', 'int')
    if len(args) == 1 and gia_tri_so:
        raise SyntaxError(f"il_codegen: '{obj_name}.get(k)' tren dict gia tri so ({ta.dtype}) "
                          f"can gia tri mac dinh - None khong bieu dien duoc bang so")
    default_node = args[1] if len(args) == 2 else None
    dict_type = ctx.il_type_str(ta, ctx.records)
    compile_expr = ctx.compile_expr
    load_var_ref = ctx.load_var_ref

    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    miss_lbl = f"{ctx.prefix}_dget{n}_miss"
    end_lbl = f"{ctx.prefix}_dget{n}_end"

    load_var_ref(obj_name, scope, out)
    compile_expr(key_node, scope, out, ta.key_dtype, ctx)
    emit_contains_key(dict_type, ta.key_dtype, out, ctx)
    out.append(f'    brfalse {miss_lbl}')

    load_var_ref(obj_name, scope, out)
    compile_expr(key_node, scope, out, ta.key_dtype, ctx)
    out.append(f'    callvirt instance !1 {dict_type}::get_Item(!0)')
    ctx.widen_if_needed(ta.dtype, dtype, out)
    out.append(f'    br {end_lbl}')

    out.append(f'  {miss_lbl}:')
    # Gia tri MAC DINH phai bien dich theo dtype GIA TRI CUA DICT roi moi
    # widen ve dtype ngu canh - truoc day dung thang `dtype` cua ngu canh
    # nen 'seen.get(w, 0)' trong 1 ham tra ve 'str' sinh 'ldc <str> 0'
    # (KeyError luc bien dich). 2026-08-03, dot 3.
    if default_node is None:
        out.append('    ldnull')
    elif _la_rong(default_node) and ta.elem_ta is not None:
        # d.get(k, {}) / d.get(k, []) (2026-09-26): container RONG theo kieu gia tri
        out.append(f'    newobj instance void {ctx.il_type_str(ta.elem_ta, ctx.records)}::.ctor()')
    else:
        compile_expr(default_node, scope, out, ta.dtype, ctx)
        ctx.widen_if_needed(ta.dtype, dtype, out)

    out.append(f'  {end_lbl}:')
