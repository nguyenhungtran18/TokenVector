# -*- coding: utf-8 -*-
"""Out-buffer native + doc/ghi bo nho khong quan ly (R2, 2026-09-22).

Mo khoa: clipboard (GlobalLock + copy), vkEnumeratePhysicalDevices,
RegQueryValueExA, HarfBuzz glyph arrays, GetWindowTextA - moi noi can
cap phat + doc bo nho native tra ve qua con tro out-param (gap A2).

Tat ca con tro la i64 (opaque handle, giong dia chi 64-bit). Bo nho cap
boi AllocHGlobal - GIAI PHONG bang free_bytes (leak neu quen, giong
C - khong co GC cho vung nay).

- alloc_bytes(n) -> i64: cap n bytes, tra dia chi.
- free_bytes(p) -> i64: giai phong, tra 0 (de goi dang lenh doc lap).
- read_u8(p, off) -> i32: 1 byte (0-255).
- write_u8(p, off, v) -> i64: ghi 1 byte (v bi cat u8 - dung conv.ovf.u1
  nen vuot pham vi NEM chu khong cat am tham), tra 0.
- read_ansi(p, off, n) -> str: n bytes thanh chuoi ANSI.
- read_i32(p, off) -> i32 / write_i32(p, off, v) -> i64.
- read_i64(p, off) -> i64 / write_i64(p, off, v) -> i64.
- read_f32(p, off) -> f32 / write_f32(p, off, v) -> i64 (R5, 2026-09-28):
  doc/ghi 4 byte float32 bang lenh IL tho ldind.r4/stind.r4. KHONG
  ton tai ham nao trong .NET Framework 4.8 de lam viec nay (Marshal
  khong co ham float/double nao, BitConverter khong co
  SingleToInt32Bits) - da do bang reflection, xem push_read_f32.
- vtable_cell(fn) -> i64: boc 1 con tro ham THO (vd tu 'callback_X(f)')
  vao 1 o 1 muc (AllocHGlobal(8) + WriteInt64) - dung THANG lam 'base'
  cho loi goi __tkv_vtable__ '"this": "false", slot 0' (emitter 1 muc
  tuong: base TRO TOI MANG con tro ham -> fn[slot]). Tranh pattern thu
  cong alloc_bytes(8) + write_i64(cell, 0, fn) (de truyen nham raw fn
  lam base -> doc nham memory -> AV, xem _make_vtable_call_codegen).
  Giai phong bang free_bytes nhu o thuong.

BSTR/COM (F4c+, 2026-09-23) - mo UIA full-text (GetFullText -> HRESULT +
BSTR-out): calli KHONG marshal string (str=BSTR se corrupt heap neu free
sai allocator) nen di duong con tro THO + Marshal thu cong:
- bstr_alloc(s) -> i64: StringToBSTR (cap BSTR tu chuoi TKV).
- bstr_free(p) -> i64: FreeBSTR, tra 0 (goi dang lenh doc lap).
- bstr_read(p) -> str: PtrToStringBSTR (null -> "" nhu read_ansi).
Pattern HRESULT-out: cell = alloc_bytes(8); hr = iface_get_text(iface,
slot, cell); bp = read_i64(cell, 0); s = bstr_read(bp); bstr_free(bp);
free_bytes(cell).

PORT tu compiler/il_features/nativebuf.tkv (2026-10-06). Co hoc:
ctx['infer_dtype']/ctx['compile_expr']/ctx.get()/ctx['label_counter']
-> ctx.<field>. infer_dtype goi du 6 tham so (them None, giong int_builtin).
"""

from il_dispatch import register_expr_builtin

__tkv_import__ = "il_dispatch"

_MARSHAL = '[mscorlib]System.Runtime.InteropServices.Marshal'


def _compile_n_i32(n_node: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """Bien dich 'n' (kich thuoc/offset) thanh int32: 'int' ha qua ToI32
    co kiem tra, i64 ha qua conv.ovf.i4, con lai thang i32."""
    n_dtype = ctx.infer_dtype(n_node, scope, ctx.func_table, None, None, None)
    if n_dtype == 'i64':
        ctx.compile_expr(n_node, scope, out, 'i64', ctx)
        out.append('    conv.ovf.i4')
    else:
        ctx.compile_expr(n_node, scope, out, 'i32', ctx)


def _compile_ptr(p_node: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """Bien dich con tro i64 thanh 'native int' tren stack."""
    ctx.compile_expr(p_node, scope, out, 'i64', ctx)
    out.append('    conv.i')


def _compile_ptr_off(p_node: "TkvNode", off_node: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """'native int' cua p+off."""
    ctx.compile_expr(p_node, scope, out, 'i64', ctx)
    _compile_n_i32(off_node, scope, out, ctx)
    out.append('    conv.i8')
    out.append('    add')
    out.append('    conv.i')


def push_alloc_bytes(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 1:
        raise SyntaxError("il_codegen: alloc_bytes(n) can dung 1 tham so")
    _compile_n_i32(args[0], scope, out, ctx)
    out.append(f'    call native int {_MARSHAL}::AllocHGlobal(int32)')
    out.append('    conv.i8')


def push_free_bytes(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 1:
        raise SyntaxError("il_codegen: free_bytes(p) can dung 1 tham so")
    _compile_ptr(args[0], scope, out, ctx)
    out.append(f'    call void {_MARSHAL}::FreeHGlobal(native int)')
    out.append('    ldc.i8 0')


def push_read_u8(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 2:
        raise SyntaxError("il_codegen: read_u8(p, off) can dung 2 tham so")
    _compile_ptr_off(args[0], args[1], scope, out, ctx)
    out.append(f'    call uint8 {_MARSHAL}::ReadByte(native int)')


def push_write_u8(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 3:
        raise SyntaxError("il_codegen: write_u8(p, off, v) can dung 3 tham so")
    # WriteByte(IntPtr, int32 offset, uint8 value) - 3 doi so RIENG (khac
    # cac ham Read* 1-doi-so dung con tro da cong san): KHONG dung
    # _compile_ptr_off o day (tung gop p+off thanh 1 con tro dan toi thieu
    # 1 doi so -> InvalidProgram luc chay, phat hien qua verify R2).
    _compile_ptr(args[0], scope, out, ctx)
    _compile_n_i32(args[1], scope, out, ctx)
    ctx.compile_expr(args[2], scope, out, 'i32', ctx)
    out.append('    conv.ovf.u1')
    out.append(f'    call void {_MARSHAL}::WriteByte(native int, int32, uint8)')
    out.append('    ldc.i8 0')


def push_read_ansi(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 3:
        raise SyntaxError("il_codegen: read_ansi(p, off, n) can dung 3 tham so")
    _compile_ptr_off(args[0], args[1], scope, out, ctx)
    _compile_n_i32(args[2], scope, out, ctx)
    out.append(f'    call string {_MARSHAL}::PtrToStringAnsi(native int, int32)')
    # PtrToStringAnsi tra null khi vung nho chua null o byte dau (title
    # rong) - null.string se NullRef luc len()/so sanh. Chuan hoa ve ""
    # (khong can temp: dup + nhay).
    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    pre = ctx.prefix
    if pre is None:
        pre = 'buf'
    done = f"{pre}_ansi{n}_nonnull"
    out.append('    dup')
    out.append(f'    brtrue {done}')
    out.append('    pop')
    out.append('    ldstr ""')
    out.append(f'  {done}:')


def push_read_i32(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 2:
        raise SyntaxError("il_codegen: read_i32(p, off) can dung 2 tham so")
    _compile_ptr_off(args[0], args[1], scope, out, ctx)
    out.append(f'    call int32 {_MARSHAL}::ReadInt32(native int)')


def push_write_i32(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 3:
        raise SyntaxError("il_codegen: write_i32(p, off, v) can dung 3 tham so")
    _compile_ptr_off(args[0], args[1], scope, out, ctx)
    ctx.compile_expr(args[2], scope, out, 'i32', ctx)
    out.append(f'    call void {_MARSHAL}::WriteInt32(native int, int32)')
    out.append('    ldc.i8 0')


def push_read_f32(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'read_f32(p, off)' (R5, 2026-09-28): doc 4 byte float32 tu dia chi
    native bang ldind.r4 (Marshal khong co ham float tren .NET 4.8)."""
    if len(args) != 2:
        raise SyntaxError("il_codegen: read_f32(p, off) can dung 2 tham so")
    _compile_ptr_off(args[0], args[1], scope, out, ctx)
    out.append('    ldind.r4')


def push_write_f32(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'write_f32(p, off, v)' (R5, 2026-09-28): ghi 4 byte float32 bang
    stind.r4. Ghi float32 nguyen ban - KHONG ep i32 truoc (se cat mang
    exponent va lam sai so bit)."""
    if len(args) != 3:
        raise SyntaxError("il_codegen: write_f32(p, off, v) can dung 3 tham so")
    _compile_ptr_off(args[0], args[1], scope, out, ctx)
    ctx.compile_expr(args[2], scope, out, 'f32', ctx)
    out.append('    stind.r4')
    out.append('    ldc.i8 0')


def push_read_i64(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 2:
        raise SyntaxError("il_codegen: read_i64(p, off) can dung 2 tham so")
    _compile_ptr_off(args[0], args[1], scope, out, ctx)
    out.append(f'    call int64 {_MARSHAL}::ReadInt64(native int)')


def push_write_i64(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 3:
        raise SyntaxError("il_codegen: write_i64(p, off, v) can dung 3 tham so")
    _compile_ptr_off(args[0], args[1], scope, out, ctx)
    ctx.compile_expr(args[2], scope, out, 'i64', ctx)
    out.append(f'    call void {_MARSHAL}::WriteInt64(native int, int64)')
    out.append('    ldc.i8 0')


def push_vtable_cell(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'vtable_cell(fn)' (P1, 2026-09-23): boc con tro ham THO 'fn' (i64)
    vao 1 o 1 muc - stack: [cell, cell, fn] -> WriteInt64(cell, fn) dan
    2 phan tu tren, con lai [cell] -> conv.i8. Khong temp rieng (dup)."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: vtable_cell(fn) can dung 1 tham so (con tro ham tho i64)")
    out.append('    ldc.i4.8')
    out.append(f'    call native int {_MARSHAL}::AllocHGlobal(int32)')
    out.append('    dup')
    ctx.compile_expr(args[0], scope, out, 'i64', ctx)
    out.append(f'    call void {_MARSHAL}::WriteInt64(native int, int64)')
    out.append('    conv.i8')


def push_bstr_alloc(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'bstr_alloc(s)' (P2, 2026-09-23): cap BSTR tu chuoi TKV (OleAuto32
    StringToBSTR - dung allocator cho BSTR, giai phong bang bstr_free)."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: bstr_alloc(s) can dung 1 tham so chuoi")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append(f'    call native int {_MARSHAL}::StringToBSTR(string)')
    out.append('    conv.i8')


def push_bstr_free(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'bstr_free(p)' (P2, 2026-09-23): FreeBSTR, tra 0 (goi dang lenh)."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: bstr_free(p) can dung 1 tham so (con tro BSTR i64)")
    _compile_ptr(args[0], scope, out, ctx)
    out.append(f'    call void {_MARSHAL}::FreeBSTR(native int)')
    out.append('    ldc.i8 0')


def push_bstr_read(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'bstr_read(p)' (P2, 2026-09-23): PtrToStringBSTR. KHAC read_ansi:
    PtrToStringBSTR NEM ArgumentNullException khi p == 0 (Ansi tra null)
    nen kiem tra zero TRUOC (ceq + brtrue) roi moi goi - null -> ""."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: bstr_read(p) can dung 1 tham so (con tro BSTR i64)")
    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    pre = ctx.prefix
    if pre is None:
        pre = 'buf'
    null_lbl = f"{pre}_bstr{n}_null"
    done = f"{pre}_bstr{n}_done"
    ctx.compile_expr(args[0], scope, out, 'i64', ctx)
    out.append('    dup')
    out.append('    ldc.i8 0')
    out.append('    ceq')
    out.append(f'    brtrue {null_lbl}')
    out.append('    conv.i')
    out.append(f'    call string {_MARSHAL}::PtrToStringBSTR(native int)')
    out.append(f'    br {done}')
    out.append(f'  {null_lbl}:')
    out.append('    pop')
    out.append('    ldstr ""')
    out.append(f'  {done}:')


def bootstrap_nativebuf(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_expr_builtin(reg, 'alloc_bytes', push_alloc_bytes, 'i64')
    register_expr_builtin(reg, 'free_bytes', push_free_bytes, 'i64')
    register_expr_builtin(reg, 'read_u8', push_read_u8, 'i32')
    register_expr_builtin(reg, 'write_u8', push_write_u8, 'i64')
    register_expr_builtin(reg, 'read_ansi', push_read_ansi, 'str')
    register_expr_builtin(reg, 'read_i32', push_read_i32, 'i32')
    register_expr_builtin(reg, 'write_i32', push_write_i32, 'i64')
    register_expr_builtin(reg, 'read_f32', push_read_f32, 'f32')
    register_expr_builtin(reg, 'write_f32', push_write_f32, 'i64')
    register_expr_builtin(reg, 'read_i64', push_read_i64, 'i64')
    register_expr_builtin(reg, 'write_i64', push_write_i64, 'i64')
    register_expr_builtin(reg, 'vtable_cell', push_vtable_cell, 'i64')
    register_expr_builtin(reg, 'bstr_alloc', push_bstr_alloc, 'i64')
    register_expr_builtin(reg, 'bstr_free', push_bstr_free, 'i64')
    register_expr_builtin(reg, 'bstr_read', push_bstr_read, 'str')
