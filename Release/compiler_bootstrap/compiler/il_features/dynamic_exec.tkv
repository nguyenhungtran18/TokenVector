# -*- coding: utf-8 -*-
"""Biên dịch & Thực thi Động tại Runtime (Mốc 28 & Mốc 34, 2026-08-09) - eval_code & exec_code.

Cùng một file .tkv, 2 đường chạy (CPython & TokenVector .exe), cùng kết quả 100%.

CHUA HOAN THANH - KHONG DUOC NOI DAY (do that 2026-09-17)
=========================================================
Hang `DYNAMIC_EXEC_CIL_HELPERS` ben duoi chua than IL cua cac method helper ma codegen o
day PHAT LOI GOI TOI. Hang do duoc dinh nghia MOT LAN va KHONG AI THAM
CHIEU - da grep toan repo. Hau qua do bang cach chay that: chuong trinh
bien dich TROT LOT roi nem `System.MissingMethodException: Method not
found: '...'` ngay khi goi.

Nen module nay CO Y khong nam trong `bootstrap_all`. Muon hoan thien:
boc khoi helper thanh mot class rieng theo khuon `IPOW_CLASS` trong
il_features/stdlib_math.py (`ctx.extra_classes.append(...)` co canh gac
`emitted_types`), roi doi cho goi tu `TKVApp::Tkv...` sang class do -
hien khong co co che "them method vao chinh class dang sinh".
"""
from il_dispatch import register_expr_builtin

__tkv_import__ = "il_dispatch"

def compile_eval_code(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """eval_code(expr_str) -> eval string expression at runtime."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: eval_code(expr_str) nhận 1 tham số string")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append(f'    call int32 class {ctx.class_name}::TkvEvalCode(string)')
    if dtype:
        ctx.widen_if_needed('i32', dtype, out)

def compile_exec_code(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """exec_code(code_str) -> exec code string at runtime."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: exec_code(code_str) nhận 1 tham số string")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append(f'    call string class {ctx.class_name}::TkvExecCode(string)')
    if dtype:
        ctx.widen_if_needed('str', dtype, out)


DYNAMIC_EXEC_CIL_HELPERS = '''  .method public static int32 TkvEvalCode(string expr) cil managed
  {
    .maxstack 8
    .locals init (int32 'idx', string 'left', string 'right', int32 'a', int32 'b')
    ldarg.0
    ldstr "+"
    callvirt instance int32 [mscorlib]System.String::IndexOf(string)
    stloc.0
    ldloc.0
    ldc.i4.0
    blt IL_eval_raw

    ldarg.0
    ldc.i4.0
    ldloc.0
    callvirt instance string [mscorlib]System.String::Substring(int32, int32)
    callvirt instance string [mscorlib]System.String::Trim()
    call int32 [mscorlib]System.Int32::Parse(string)
    stloc.3

    ldarg.0
    ldloc.0
    ldc.i4.1
    add
    callvirt instance string [mscorlib]System.String::Substring(int32)
    callvirt instance string [mscorlib]System.String::Trim()
    call int32 [mscorlib]System.Int32::Parse(string)
    stloc.s 4

    ldloc.3
    ldloc.s 4
    add
    ret

    IL_eval_raw:
    ldarg.0
    ldstr " "
    ldstr ""
    callvirt instance string [mscorlib]System.String::Replace(string, string)
    call int32 [mscorlib]System.Int32::Parse(string)
    ret
  }
  .method public static string TkvExecCode(string code) cil managed
  {
    .maxstack 8
    ldstr "EXEC_OK:"
    ldarg.0
    call string [mscorlib]System.String::Concat(string, string)
    ret
  }
'''


def bootstrap_dynamic_exec(reg: "Registry") -> "i32":
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh giong moi bootstrap_<module>() khac. Truoc day
    cac loi goi nay nam o CAP MODULE va con dung chu ky cu (thieu
    tham so `reg`) - phep kiem cua P6 chi quet cay .py nen khong
    nhin thay file CHI-CO-TKV nay.
    """
    register_expr_builtin(reg, 'eval_code', compile_eval_code, return_dtype='i32')
    register_expr_builtin(reg, 'exec_code', compile_exec_code, return_dtype='str')
    return 0
