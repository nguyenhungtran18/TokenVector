# -*- coding: utf-8 -*-
"""t.count(x) / t.index(x) tren BIEN tuple dong deu (2026-10-02), va ham dung chung `tuple_var_thanh_lit`.

Tuple la System.Tuple`N (khong co count/index nhu list): sinh thang IL so sanh x voi Item1..ItemN. `x` phai la bieu
thuc DON GIAN (bien/so/chuoi hang) vi duoc danh gia N lan. `t.index(x)` khong thay -> ValueError (nhu Python)."""
from il_dispatch import register_expr_method
from tkv_types import TypeAnn, EXC_CLR
from expr_row import ea_str, ec_ds, ekind, mk2, mk3, o_ds, o_str


__tkv_import__ = ["il_dispatch", "tkv_types"]

def tuple_var_thanh_lit(name: "str", ta: "TypeAnn") -> "TkvNode":
    """Nut tuple_lit gom cac nut `name[0]`, `name[1]`, ... (tuple bien -> tuple literal)."""
    phan = []
    for i in range(len(ta.tuple_dtypes)):
        so = mk2('num', o_str(str(i)))
        phan.append(mk3('index', o_str(name), o_ds([so])))
    return mk2('tuple_lit', o_ds(phan))


def _dtype_so_sanh(name: "str", ta: "TypeAnn", x: "TkvNode", ctx: "Ctx", scope: "Scope") -> "str":
    d0 = ta.tuple_dtypes[0]
    for d in ta.tuple_dtypes:
        if d != d0:
            raise SyntaxError(f"il_codegen: '{name}.count/index(...)' chi ho tro tuple moi phan tu cung kieu (gap {ta.tuple_dtypes})")
    if d0 not in ('i32', 'i64', 'f64', 'str') or ta.logic != 0:
        raise SyntaxError(f"il_codegen: '{name}.count/index(...)' chi ho tro tuple i32/i64/f64/str (khong phai bool)")
    if ekind(x) not in ('var', 'num', 'str_lit'):
        raise SyntaxError(f"il_codegen: '{name}.count/index(x)': x phai la bien/so/chuoi hang (gan bieu thuc ra bien truoc)")
    return d0


def _so_sanh_bang(d: "str", out: "list[str]"):
    if d == 'str':
        out.append('    call bool [mscorlib]System.String::op_Equality(string, string)')
    else:
        out.append('    ceq')


def _phan_tu(name: "str", i: "i32", scope: "Scope", out: "list[str]", d: "str", ctx: "Ctx"):
    so = mk2('num', o_str(str(i)))
    ctx.compile_expr(mk3('index', o_str(name), o_ds([so])), scope, out, d, ctx)


def compile_tuple_count(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    name = ea_str(node)
    args = ec_ds(node)
    if len(args) != 1:
        raise SyntaxError("il_codegen: t.count(x) can dung 1 tham so")
    ta = scope.tra(name).ta
    d = _dtype_so_sanh(name, ta, args[0], ctx, scope)
    out.append('    ldc.i4.0')
    for i in range(len(ta.tuple_dtypes)):
        _phan_tu(name, i, scope, out, d, ctx)
        ctx.compile_expr(args[0], scope, out, d, ctx)
        _so_sanh_bang(d, out)
        out.append('    add')
    ctx.widen_if_needed('i32', dtype, out)


def compile_tuple_index(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    name = ea_str(node)
    args = ec_ds(node)
    if len(args) != 1:
        raise SyntaxError("il_codegen: t.index(x) can dung 1 tham so")
    ta = scope.tra(name).ta
    d = _dtype_so_sanh(name, ta, args[0], ctx, scope)
    ctx.label_counter[0] += 1
    k = ctx.label_counter[0]
    het = f'{ctx.prefix}_tidx{k}_het'
    n = len(ta.tuple_dtypes)
    for i in range(n):
        _phan_tu(name, i, scope, out, d, ctx)
        ctx.compile_expr(args[0], scope, out, d, ctx)
        _so_sanh_bang(d, out)
        out.append(f'    brfalse {ctx.prefix}_tidx{k}_{i}')
        out.append(f'    ldc.i4 {i}')
        out.append(f'    br {het}')
        out.append(f'  {ctx.prefix}_tidx{k}_{i}:')
    out.append('    ldstr "tuple.index(x): x not in tuple"')
    out.append(f'    newobj instance void {EXC_CLR["ValueError"]}::.ctor(string)')
    out.append('    throw')
    out.append(f'  {het}:')
    ctx.widen_if_needed('i32', dtype, out)


def bootstrap_tuple_methods(reg: "Registry"):
    register_expr_method(reg, 'tuple', 'count', compile_tuple_count, 'i32')
    register_expr_method(reg, 'tuple', 'index', compile_tuple_index, 'i32')
