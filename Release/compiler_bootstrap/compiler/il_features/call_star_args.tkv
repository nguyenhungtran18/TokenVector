# -*- coding: utf-8 -*-
"""`f(*xs)` va `f(**kw)` - truyen lap tham so tai DIEM GOI HAM (2026-09-29).

Ban Python (compiler/il_features/call_star_args.tkv) lam o tang AST: parse
`('star', expr)` / `('star2', expr)` roi sua node tai cho. Ban tu-host khong
port yeu nguyen cach do vi 2 ly do da gap that:

1. Row arena cua TokenVector la CHUOI bat bien; `stmt_row.dat_nut` chi ghi
   duoc khi truong co mat trong `_LAYOUT`, con `assign_scalar` luu ve phai
   bang VAN BAN (`rhs_text`) nen moi lan ghi de deu phai nho qua `_MEMO_NUT`
   - va noi do KHONG duoc `_expand_macros` dat lai giua 2 pass.
2. Cay `dict`/`list` long nhau cua Python o day la danh sach TkvNode; port
   `_expand_node` dang de quy tren dict khong co kieu tinh ngay duoc.

Nen ban nay lam o tang VAN BAN, ngay truoc `_expand_macros` cua il_codegen:
quet MOT LAN tren TOAN BO than ham (da noi cac dong bang '\n') va thay
`*[...]` / `*ten` / `**{...}` / `**ten` bang dang mo rong phang, roi de
parser THUAN chay tiep. Mot LAN quet ca thanh ham (thay vi tung dong) la
bat buoc: lenh goi nhieu dong, chuoi nhieu dong va comment deu khong the
quet dung khi tach theo tung dong.

Quet ca mot lan cung xu ly duoc long nhau: `f(*g(*[1, 2]))` - bieu thuc
nguon duoc quet LAI de quy truoc khi phan loai.

Nguon duoc chap nhan giong het ban Python:

- `f(*[1, 2, 3])` - list literal ngay tai choi goi;
- `xs = [1, 2, 3]` roi `f(*xs)` - bien duoc gan DUNG MOT list literal trong
  ham nay va KHONG xuat hien o cho khac;
- `f(**{"a": 1})` - dict literal ngay tai choi goi;
- `kw = {"a": 1}` roi `f(**kw)` - tuong tu cho dict.

Nguon khac bi TU CHOI ro rang (nem SyntaxError) vi arity cua TokenVector la
tinh: khong the dem phan tu / doc khoa luc chay ma van sua chu ky `call`.
"""

import re

_ASSIGN_OPS: "set[str]" = {'=', '+', '-', '*', '/', '%', '<', '>', '!', '&', '|', '^', ':'}


# --- tien ich van ban --------------------------------------------------------

def _sao_la_ten_don(v: "str") -> "i32":
    if v == '':
        return 0
    c0 = v[0]
    if not (c0.isalpha() or c0 == '_'):
        return 0
    for c in v:
        if not (c.isalpha() or c.isdigit() or c == '_'):
            return 0
    return 1


def _sao_tach_phay0(trong: "str") -> "list[str]":
    """Tach theo dau phay o muc ngoac 0, bo qua dau trong chuoi."""
    ra: "list[str]" = []
    dau = 0
    sau = 0
    nhay = ''
    i = 0
    n = len(trong)
    while i < n:
        c = trong[i]
        if nhay != '':
            if c == chr(92):
                i += 2
                continue
            if c == nhay:
                nhay = ''
            i += 1
            continue
        if c == '"' or c == "'":
            nhay = c
            i += 1
            continue
        if c == '(' or c == '[' or c == '{':
            sau += 1
        elif c == ')' or c == ']' or c == '}':
            sau -= 1
        elif c == ',' and sau == 0:
            ra.append(trong[dau:i].strip())
            dau = i + 1
        i += 1
    ra.append(trong[dau:].strip())
    return ra


def _sao_vi_tri_ngoac_dong(s: "str", mo: "i32") -> "i32":
    """Vi tri ngoac dong khop voi ngoac mo tai `mo`; -1 neu khong co."""
    sau = 0
    nhay = ''
    i = mo
    n = len(s)
    while i < n:
        c = s[i]
        if nhay != '':
            if c == chr(92):
                i += 2
                continue
            if c == nhay:
                nhay = ''
            i += 1
            continue
        if c == '"' or c == "'":
            nhay = c
            i += 1
            continue
        if c == '(' or c == '[' or c == '{':
            sau += 1
        elif c == ')' or c == ']' or c == '}':
            sau -= 1
            if sau == 0:
                return i
        i += 1
    return -1


def _sao_vi_tri_hai_cham(s: "str") -> "i32":
    """Vi tri ':' dau tien o muc ngoac 0 va ngoai chuoi; -1 neu khong co."""
    sau = 0
    nhay = ''
    i = 0
    n = len(s)
    while i < n:
        c = s[i]
        if nhay != '':
            if c == chr(92):
                i += 2
                continue
            if c == nhay:
                nhay = ''
            i += 1
            continue
        if c == '"' or c == "'":
            nhay = c
            i += 1
            continue
        if c == '(' or c == '[' or c == '{':
            sau += 1
        elif c == ')' or c == ']' or c == '}':
            sau -= 1
        elif c == ':' and sau == 0:
            return i
        i += 1
    return -1


def _sao_ten_xuat_hien(dong: "str", ten: "str") -> "i32":
    """Ten xuat hien nguyen TU (khong phinh ten dai hon / thuoc tinh)."""
    i = dong.find(ten)
    while i >= 0:
        truoc = ''
        if i > 0:
            truoc = dong[i - 1]
        sau = ''
        if i + len(ten) < len(dong):
            sau = dong[i + len(ten)]
        ok_truoc = not (truoc.isalpha() or truoc.isdigit() or truoc == '_' or truoc == '.')
        ok_sau = not (sau.isalpha() or sau.isdigit() or sau == '_')
        if ok_truoc == 1 and ok_sau == 1:
            return 1
        i = dong.find(ten, i + 1)
    return 0


# --- gan literal mot dong ----------------------------------------------------

def _sao_vi_tri_bang(s: "str") -> "i32":
    """Vi tri '=' cua phep GAN that (khong phai '==', '!=', '<=', '+=', ...)
    o muc ngoac 0 va ngoai chuoi; -1 neu khong co."""
    sau = 0
    nhay = ''
    i = 0
    n = len(s)
    while i < n:
        c = s[i]
        if nhay != '':
            if c == chr(92):
                i += 2
                continue
            if c == nhay:
                nhay = ''
            i += 1
            continue
        if c == '"' or c == "'":
            nhay = c
            i += 1
            continue
        if c == '(' or c == '[' or c == '{':
            sau += 1
        elif c == ')' or c == ']' or c == '}':
            sau -= 1
        elif c == '=' and sau == 0:
            truoc = ''
            if i > 0:
                truoc = s[i - 1]
            if truoc == '' or not (truoc in _ASSIGN_OPS):
                return i
        i += 1
    return -1


def _sao_ten_gan(s: "str") -> "str":
    """Ten bien o ve TRAI cua phep gan, hoac '' neu khong phai gan ten don."""
    vt = _sao_vi_tri_bang(s)
    if vt < 0:
        return ''
    ten = s[:vt].strip()
    if _sao_la_ten_don(ten) == 0:
        return ''
    return ten


def _sao_ve_gan(s: "str") -> "str":
    """Ve PHAI cua phep gan (khong kiem tra lai ve ten), '' neu khong gan."""
    vt = _sao_vi_tri_bang(s)
    if vt < 0:
        return ''
    return s[vt + 1:].strip()


def _sao_la_ll_mot_dong(rhs: "str") -> "i32":
    """1 neu rhs la list/dict literal trong MOT dong ([..] hoac {..})."""
    if rhs == '':
        return 0
    c0 = rhs[0]
    if c0 != '[' and c0 != '{':
        return 0
    if _sao_vi_tri_ngoac_dong(rhs, 0) != len(rhs) - 1:
        return 0
    return 1


# --- kiem tra nguon bien -----------------------------------------------------

def _sao_la_dung_sao(s: "str", ten: "str") -> "i32":
    """1 neu dong nay DUNG chinh ten do lam nguon '*ten' / '**ten'."""
    return 1 if ('*' + ten) in s else 0


def _sao_loi_nguon(ten: "str", is_list: "i32", func_name: "str",
                   phu: "str") -> "str":
    return ("il_codegen: nguon '*'/'**' phai la list/dict literal: '" + ten +
            "' trong ham '" + func_name + "' " + phu)


def _sao_an_nguon(ten: "str", is_list: "i32", lines: "list[str]",
                  func_name: "str") -> "str":
    """Kiem tra bien `ten` co phai nguon tinh khong.

    Tra 'L'+noi_dung / 'D'+noi_dung neu dat, 'E'+thong diep neu khong."""
    want_ll = 'L'
    want_txt = 'list'
    if is_list == 0:
        want_ll = 'D'
        want_txt = 'dict'
    noi = ''
    co_def = 0
    for dong in lines:
        s = dong.strip()
        if s == '' or s.startswith('#'):
            continue
        if _sao_ten_gan(s) != ten:
            continue
        rhs = _sao_ve_gan(s)
        if _sao_la_ll_mot_dong(rhs) == 0:
            return 'E' + _sao_loi_nguon(
                ten, is_list, func_name,
                "duoc gan bang '" + rhs + "' - chi 'ten = [a, b, c]' / " +
                "'ten = {\"a\": 1}' (literal MOT dong) moi cho thong tin " +
                "tinh khi bien dich")
        co_def += 1
        if co_def > 1:
            return 'E' + _sao_loi_nguon(
                ten, is_list, func_name, "bi gan LAI nhieu lan - chi gan 1 " +
                "literal duoc")
        if rhs.startswith('['):
            if want_ll != 'L':
                return 'E' + _sao_loi_nguon(
                    ten, is_list, func_name,
                    "nguon la list literal, sai dang (can dict)")
            noi = rhs[1:-1].strip()
        else:
            if want_ll != 'D':
                return 'E' + _sao_loi_nguon(
                    ten, is_list, func_name,
                    "nguon la dict literal, sai dang (can list)")
            noi = rhs[1:-1].strip()
    if co_def == 0:
        return 'E' + _sao_loi_nguon(
            ten, is_list, func_name,
            "khong duoc gan bang literal nao - so phan tu/khoa phai tinh " +
            "duoc luc bien dich")
    for dong in lines:
        s = dong.strip()
        if s == '' or s.startswith('#'):
            continue
        if _sao_ten_gan(s) == ten:
            continue
        if _sao_la_dung_sao(s, ten) == 1:
            continue
        if _sao_ten_xuat_hien(s, ten) == 1:
            return 'E' + _sao_loi_nguon(
                ten, is_list, func_name,
                "bi DUNG o cho khac - chi chu nhan 'ten = [...]'/" +
                "'ten = {...}' roi dung ngay trong 'f(*ten)'/'f(**ten)' " +
                "(truong hop nay do dai co the doi len giua khi bien dich)")
    if want_txt == 'list':
        return 'L' + noi
    return 'D' + noi


# --- mo rong nguon -----------------------------------------------------------

def _sao_mo_list(noi: "str", ten: "str") -> "list[str]":
    """Noi dung list literal -> ['xs[0]', 'xs[1]', ...] doc truc tiep tu bien."""
    ra: "list[str]" = []
    i = 0
    for e in _sao_tach_phay0(noi):
        if e == '':
            continue
        ra.append(ten + '[' + str(i) + ']')
        i += 1
    return ra


def _sao_mo_dict(noi: "str", ten: "str", func_name: "str") -> "list[str]":
    """Noi dung dict literal -> ['khoa=gia'] hoac ['khoa=ten["khoa"]']."""
    ra: "list[str]" = []
    doc = ten == ''
    for kv in _sao_tach_phay0(noi):
        if kv == '':
            continue
        vt = _sao_vi_tri_hai_cham(kv)
        if vt < 0:
            raise SyntaxError(
                "il_codegen: nguon '**' phai co khoa CHUOI tinh: '" + ten +
                "' trong ham '" + func_name + "' - '**' co khoa khong phai " +
                "chuoi literal, nen khong gan duoc vao tham so nao luc bien dich")
        khoa = kv[:vt].strip()
        gia = kv[vt + 1:].strip()
        if not (khoa.startswith('"') and khoa.endswith('"') and len(khoa) >= 2):
            raise SyntaxError(
                "il_codegen: nguon '**' phai co khoa CHUOI tinh: '" + ten +
                "' trong ham '" + func_name + "' - '**' co khoa khong phai " +
                "chuoi literal, nen khong gan duoc vao tham so nao luc bien dich")
        ten_khoa = khoa[1:-1]
        if doc == 1:
            ra.append(ten_khoa + '=' + gia)
        else:
            ra.append(ten_khoa + '=' + ten + '[' + khoa + ']')
    return ra


def _sao_loi_sai_dang(nguon: "str", is_list: "i32", func_name: "str") -> "str":
    dau = '*'
    want_txt = 'list'
    if is_list == 0:
        dau = '**'
        want_txt = 'dict'
    return ("il_codegen: nguon '" + dau + "' phai la " + want_txt +
            " literal: '" + nguon + "' trong ham '" + func_name +
            "' - nguon la " + ("dict" if is_list == 1 else "list") +
            " literal, sai dang")


def _sao_loi_chung(nguon: "str", is_list: "i32", func_name: "str") -> "str":
    dau = '*'
    want_txt = 'list'
    if is_list == 0:
        dau = '**'
        want_txt = 'dict'
    return ("il_codegen: nguon '" + dau + "' phai la " + want_txt +
            " literal: '" + nguon + "' trong ham '" + func_name +
            "' - chi nhan 'f(*" + want_txt + "literal)' hoac bien duoc gan 1 " +
            want_txt + " literal")


# --- quet ca than ham --------------------------------------------------------

def _sao_la_tham_so_sao(ra: "str") -> "i32":
    """`*` o vi tri nay co bat dau MOT tham so khong.

    Ky tu da emit gan nhat (bo qua khoang trang) phai la `(` hoac `,`.
    Cach nay tach duoc `f(*xs)` / `f(a, *xs)` khoi `a * b` / `x = a * b`
    / `xs[i] * n` - nhung truong hop sau KHONG phai truyen lap tham so."""
    kt = len(ra) - 1
    while kt >= 0:
        c = ra[kt]
        if c == ' ' or c == '\n' or c == '\t' or c == '\r':
            kt -= 1
            continue
        break
    if kt < 0:
        return 1
    c = ra[kt]
    if c == '(' or c == ',':
        return 1
    return 0


def _sao_het_bieu_thuc(s: "str", tu: "i32") -> "i32":
    """Vi tri ket thuc cua 1 bieu thuc trong danh sach tham so: gap dau
    phay HOAC ngoac dong o muc ngoac 0 va ngoai chuoi; len(s) neu het."""
    sau = 0
    nhay = ''
    i = tu
    n = len(s)
    while i < n:
        c = s[i]
        if nhay != '':
            if c == chr(92):
                i += 2
                continue
            if c == nhay:
                nhay = ''
            i += 1
            continue
        if c == '"' or c == "'":
            nhay = c
            i += 1
            continue
        if c == '(' or c == '[' or c == '{':
            sau += 1
        elif c == ')' or c == ']' or c == '}':
            if sau == 0:
                return i
            sau -= 1
        elif c == ',' and sau == 0:
            return i
        i += 1
    return n


def _sao_quet(trong: "str", lines: "list[str]", func_name: "str") -> "str":
    """Quet ca thanh ham 1 lan, tra ve VAN BAN da noi `*`/`**`."""
    ra = ''
    i = 0
    n = len(trong)
    nhay = ''
    ba = ''
    while i < n:
        c = trong[i]
        if ba != '':
            if trong[i:i + 3] == ba:
                ra += ba
                ba = ''
                i += 3
                continue
            ra += c
            i += 1
            continue
        if nhay != '':
            if c == chr(92):
                if i + 1 < n:
                    ra += trong[i:i + 2]
                    i += 2
                    continue
            if c == nhay:
                nhay = ''
            ra += c
            i += 1
            continue
        if trong[i:i + 3] == '"""' or trong[i:i + 3] == "'''":
            if trong[i:i + 3] == '"""':
                ba = '"""'
            else:
                ba = "'''"
            ra += ba
            i += 3
            continue
        if c == '"' or c == "'":
            nhay = c
            ra += c
            i += 1
            continue
        if c == '#':
            j = trong.find('\n', i)
            if j < 0:
                j = n
            ra += trong[i:j]
            i = j
            continue
        if c == '*' and i + 1 < n:
            if _sao_la_tham_so_sao(ra) == 0:
                ra += c
                i += 1
                continue
            la_hai = 0
            j = i + 1
            if trong[j] == '*':
                la_hai = 1
                j += 1
            is_list = 1
            if la_hai == 1:
                is_list = 0
            het = _sao_het_bieu_thuc(trong, j)
            nguon = trong[j:het].strip()
            if nguon == '':
                raise SyntaxError(_sao_loi_chung('', is_list, func_name))
            # Long nhau: `f(*g(*[..]))` - quet lai bieu thuc nguon truoc.
            if '*' in nguon:
                nguon = _sao_quet(nguon, lines, func_name).strip()
            phan: "list[str]" = []
            if nguon.startswith('[') and nguon.endswith(']'):
                if is_list == 0:
                    raise SyntaxError(_sao_loi_sai_dang(nguon, is_list, func_name))
                phan = _sao_tach_phay0(nguon[1:-1].strip())
            elif nguon.startswith('{') and nguon.endswith('}'):
                if is_list == 1:
                    raise SyntaxError(_sao_loi_sai_dang(nguon, is_list, func_name))
                phan = _sao_mo_dict(nguon[1:-1].strip(), '', func_name)
            elif _sao_la_ten_don(nguon) == 1:
                kq = _sao_an_nguon(nguon, is_list, lines, func_name)
                if kq.startswith('E'):
                    raise SyntaxError(kq[1:])
                noi = kq[1:]
                if is_list == 1:
                    phan = _sao_mo_list(noi, nguon)
                else:
                    phan = _sao_mo_dict(noi, nguon, func_name)
            else:
                raise SyntaxError(_sao_loi_chung(nguon, is_list, func_name))
            for t in range(len(phan)):
                if t > 0:
                    ra += ', '
                ra += phan[t]
            i = het
            continue
        ra += c
        i += 1
    return ra


def expand_star_args_in_lines(body_lines: "list[str]", func_name: "str") -> "list[str]":
    """Noi `*`/`**` trong ca than ham (danh sach DONG) thanh doi so tinh.

    Tra ve danh sach dong MOI. Nhanh thoat O(n): khong co '*' ngoai chuoi
    thi tra nguyen danh sach cu."""
    co = 0
    for dong in body_lines:
        if '*' in dong:
            co = 1
    if co == 0:
        return body_lines
    text = '\n'.join(body_lines)
    moi = _sao_quet(text, body_lines, func_name)
    return moi.split('\n')
