# -*- coding: utf-8 -*-
"""str()/fmt_float() (Phase "tach tkvc.exe thanh plugin", 2026-08-12) -
TACH RA khoi string_feature.py (file do GIU LAI compile_index_str/
compile_len_str/compile_binop_concat/compile_compare_str - ngu nghia
kieu 'str' CO BAN cua ngon ngu, khong tach duoc, xem docstring dau file
do). 2 ham nay la BUILTIN DANG HAM ('str(x)'/'fmt_float(x,n)'), thuoc
nhom "thu vien" tach duoc theo thiet ke o
docs/superpowers/specs/2026-08-12-tkvc-plugin-architecture-design.md
muc 3.2. Ke ca cac ham phu chi phuc vu rieng str() (_is_bool_shaped,
_str_of_slot, _temps_str_builtin) cung chuyen theo - chung KHONG duoc
dung boi 4 ham con lai o string_feature.py (da xac minh qua grep truoc
khi tach, xem task-8-report.md)."""
import re

from il_core import IL_SCALAR, nid
from il_dispatch import register_expr_builtin
from tkv_types import TypeAnn, BienChuaKhaiBao, bit_logic
from il_features.int_type import compile_str_of_int, ensure_class_int
from il_features.tkvstr import emit_to_str
from expr_row import ea_str, eb_ds, eb_nut, eb_str, ec_nut, ekind
import il_features.tkvstr as _tkvstr
import il_features.int_type as _int_type
import il_codegen as _ilc
from il_features.list_type import il_list_type, emit_list_sort


_BOOL_SHAPED_CALL_NAMES: "set[str]" = {'all', 'any'}
_BOOL_SHAPED_METHOD_NAMES: "set[str]" = {'startswith', 'endswith', 'isdigit', 'isalpha', 'isalnum', 'isspace', 'isnumeric', 'isdecimal', 'isupper', 'islower', 'isascii', 'istitle'}


__tkv_import__ = ["il_dispatch", "tkv_types"]

def _num_int_dtype_of_text(text: "str") -> "str":
    """Suy dtype cho 1 node 'num' la so nguyen decimal TU NO (CHUA den tu caller).
    Khong goi int(text) - tren TokenVector `int()` tra i32 va se tran ngu
    khong vua phai. Chi so-chu-so + so sanh dien la du: i32 max 10 chu so,
    i64 max 19 chu so.

    (Trc day trong str(...): FALLBACK
    `_d = 'i32'` cho node 'num' bat ke kich thuoc so chu so, dan den 'ldc.i4'
    nhan 1 chuoi vuot Int32.MaxValue va tran sang so am.)
    """
    t = text.strip()
    if t == "":
        return 'i32'
    neg = False
    if t[0] == '-':
        neg = True
        t = t[1:]
    i = 0
    while i + 1 < len(t) and t[i] == '0':
        i = i + 1
    t = t[i:]
    if len(t) < 10:
        return 'i32'
    if len(t) == 10:
        bound = "2147483648" if neg else "2147483647"
        if t <= bound:
            return 'i32'
    if len(t) < 19:
        return 'i64'
    if len(t) == 19:
        bound = "9223372036854775808" if neg else "9223372036854775807"
        if t <= bound:
            return 'i64'
    return 'int'


def _is_bool_shaped(node: "TkvNode", scope: "Scope"=None, func_table: "dict[str,TkvSig]"=None) -> "i32":
    """True neu bieu thuc 'node' co dtype='i32' nhung MANG NGHIA logic
    (Python se in "True"/"False", khong phai so). compare/boolop/not/in
    LUON tra ve i32 0/1 (xem _infer_dtype trong il_codegen.py - co tinh
    khai cung de tranh AccessViolationException voi TkvInt); all()/any()
    va .startswith()/.endswith()/.isdigit() cung tra i32 0/1 cung ly do
    (dang ky dtype='i32' trong stdlib_aggregates.py / string_methods_batch3.py).
    KHONG bao gom .find() - do la CHI SO that, khong phai co/khong."""
    tag = ekind(node)
    if tag == 'boolop':
        # 'a or b' / 'a and b' tra GIA TRI cua mot trong hai ve (Python), chi la bool khi CA HAI ve deu la bool
        # (2026-09-30: str(0 or 5) in 5, khong phai True)
        return _is_bool_shaped(eb_nut(node), scope, func_table) and _is_bool_shaped(ec_nut(node), scope, func_table)
    if tag in ('compare', 'not', 'in'):
        return True
    if tag == 'var' and scope is not None:
        try:
            ta_v = scope.tra(ea_str(node)).ta
        except (KeyError, SyntaxError):
            return False
        return ta_v is not None and ta_v.logic == 1 and ta_v.la_vo_huong()
    if tag == 'index' and scope is not None:
        try:
            ta_i = scope.tra(ea_str(node)).ta
        except (KeyError, SyntaxError):
            return False
        if ta_i is not None and ta_i.shape_ten == 'tuple' and ta_i.logic != 0:
            ix = eb_ds(node)
            if len(ix) == 1 and ekind(ix[0]) == 'num' and ea_str(ix[0]).isdigit():
                return bit_logic(ta_i.logic, int(ea_str(ix[0]))) == 1
            return False
        return ta_i is not None and ta_i.shape_ten in ('list', 'dict') and ta_i.logic == 1
    if tag == 'call' and func_table is not None and ea_str(node) in func_table:
        rt = func_table[ea_str(node)].return_type
        if rt is not None and rt.logic == 1 and rt.la_vo_huong():
            return True
    if tag == 'call' and ea_str(node) in _BOOL_SHAPED_CALL_NAMES:
        return True
    if tag in ('method_call', 'method_call_expr') and eb_str(node) in _BOOL_SHAPED_METHOD_NAMES:
        return True
    return False


def compile_str_builtin(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """Nhanh 'str(x)' cua _expr_call - chuyen 1 bien so (f32/f64/i32/i64)
    sang string. GIOI HAN THAT (chua ho tro bieu thuc phuc tap):
    ToString() la INSTANCE method tren value type - CIL can DIA CHI
    (managed pointer, ldarga/ldloca), khong the lay dia chi cua 1 gia
    tri TAM tren stack (ket qua 1 bieu thuc bat ky) - CHI bien don da co
    san 1 memory slot (arg/local) moi lay dia chi truc tiep duoc."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: str() chi nhan dung 1 tham so")
    arg = args[0]
    int_dtypes, float_dtypes = ctx.int_dtypes, ctx.float_dtypes
    _ta_li = None
    if ekind(arg) == 'var':
        try:
            _ta_li = scope.tra(ea_str(arg)).ta
        except KeyError:
            _ta_li = None
    else:
        _ta_li = _ilc._shaped_return_ta_of_call(ctx.reg, arg, ctx.func_table, scope,
                                                ctx.records, ctx.record_methods)
    if (_ta_li is not None and _ta_li.shape_ten == 'list' and _ta_li.dtype == 'int'
            and _ta_li.elem_ta is None):
        # str(<list[int]>): xet TRUOC nhanh 'int' (infer_dtype cua container tra dtype PHAN TU)
        _ensure_class_reprn(ctx)
        ctx.compile_expr(arg, scope, out, 'int', ctx)
        out.append(f'    call string {_REPRN_CLASS}::Ds({_DS_INT})')
        return
    if _ta_li is not None and _ta_li.shape_ten == 'set' and not _ta_li.la_vo_huong():
        _emit_set_repr(arg, _ta_li, scope, out, ctx)
        return
    if _ta_li is not None and _ta_li.shape_ten == 'tuple' and _ta_li.logic != 0:
        raise SyntaxError("il_codegen: str(<tuple>) - tuple chua phan tu bool chua ho tro in ca tuple (se in 1/0 thay True/False); "
                          "in tung phan tu 't[i]'")
    if _ta_li is not None and _ta_li.shape_ten == 'tuple':
        raise SyntaxError("il_codegen: str(<tuple>) khong ho tro bien tuple - in tung phan tu 't[i]' thay vi in ca tuple")
    if (_ta_li is not None and not _ta_li.la_vo_huong()
            and (_ta_li.shape_ten in ('dict', 'defaultdict', 'counter', 'tuple')
                 or (_ta_li.shape_ten == 'list' and _ta_li.elem_ta is not None))):
        # dict / tuple / list long nhau (2026-09-30): repr theo kieu luc chay. Xet TRUOC nhanh 'int'
        # ben duoi (infer_dtype cua container tra dtype PHAN TU, tung dua dict vao TkvInt.Str).
        _ensure_repr_any(ctx)
        ctx.compile_expr(arg, scope, out, _ta_li.dtype, ctx)
        out.append('    call string TkvReprAny::Any(object)')
        return
    if ctx.infer_dtype(arg, scope, ctx.func_table, None, None, None) == 'int':
        # Kieu 'int' (vo han chu so) - Str() la STATIC nhan gia tri nen
        # KHONG vuong han che "phai co dia chi" cua ToString() o duoi:
        # 'str(a * b)' chay duoc thang, khong can local an.
        compile_str_of_int(arg, scope, out, ctx)
        return
    if ekind(arg) != 'var':
        # moc 7 (2026-08-05): duong DUY NHAT, qua TkvStr::* - cac ham do
        # la STATIC va nhan GIA TRI nen 'str(a + b)' khong con can local
        # AN nao (xem docstring cua tkvstr.py). Nhanh __strtmp cu ben
        # duoi chi con giu cho dtype chua co trong bang cua TkvStr.
        # 'infer_literal_dtype' CHI co trong ctx cua pass 1 (first-pass suy
        # kieu, xem print_feature.py) - pass 2 (codegen that) KHONG co key
        # nay. Truoc day index truc tiep ('ctx[...]') gay KeyError CRASH
        # NOI BO khi 'infer_dtype' tra None o pass 2 (vd str(lst[-1:5]) -
        # ket qua slice co shape='list', khong phai scalar) - .get() voi
        # fallback None de roi xuong nhanh duoi, tu bao SyntaxError co
        # kiem soat ("khong suy duoc kieu") thay vi crash khong debug duoc.
        # Truoc day ca khoi nay di qua `ctx.get(...)` - vo DICT cu cua Ctx.
        # Ctx GIO LA RECORD, cac khoa do deu la TRUONG khai san, nen doc
        # thang. (`ctx.get('infer_literal_dtype', lambda n: None)(arg)` con
        # la mot dang khong trinh bien dich nao cua du an parse duoc: lay
        # kem mac dinh roi GOI ngay ket qua.)
        # 'str(<bieu thuc list>)' (2026-09-28), vd f"{sorted(d)}": PHAI xet
        # TRUOC infer_dtype - no tra dtype PHAN TU ('str') nen truoc day List
        # bi dua thang vao cho string (SAI AM THAM: rac/AccessViolation).
        # Python cho "['a', 'b']" - trung repr(list) nen dung TkvRepr::Ds.
        _ta_bt = _ilc._shaped_return_ta_of_call(ctx.reg, arg, ctx.func_table, scope,
                                                ctx.records, ctx.record_methods)
        if (_ta_bt is not None and _ta_bt.shape_ten == 'list' and _ta_bt.dtype == 'str'
                and _ta_bt.elem_ta is None):
            _ensure_class_repr(ctx)
            ctx.compile_expr(arg, scope, out, 'str', ctx)
            out.append(f'    call string {_REPR_HELPER_CLASS}::Ds({_DS_STR})')
            return
        if (_ta_bt is not None and _ta_bt.shape_ten == 'list' and _ta_bt.dtype == 'i32'
                and _ta_bt.elem_ta is None):
            # 'str(<bieu thuc list[i32]>)' (2026-09-29), vd str(type_ann.dims)
            _ensure_class_repr(ctx)
            ctx.compile_expr(arg, scope, out, 'i32', ctx)
            out.append(f'    call string {_REPR_HELPER_CLASS}::' + ('DsB' if _ta_bt.logic == 1 else 'DsI') + f'({_DS_I32})')
            return
        if _ta_bt is not None and _ta_bt.shape_ten in ('list', 'dict', 'defaultdict', 'counter'):
            _ensure_repr_any(ctx)
            ctx.compile_expr(arg, scope, out, _ta_bt.dtype, ctx)
            out.append('    call string TkvReprAny::Any(object)')
            return
        if _ta_bt is not None and _ta_bt.shape_ten in ('list', 'dict', 'set', 'tuple'):
            raise SyntaxError(
                f"il_codegen: str(<bieu thuc>) tren {_ta_bt.shape_repr()} chua ho tro - "
                f"chi list[str]/list[i32]; gan ra 1 bien roi xu ly rieng")
        _d = ctx.infer_dtype(arg, scope, ctx.func_table, ctx.records,
                             ctx.record_methods, None)
        if not _d:
            # 'infer_literal_dtype' CHI co trong ctx cua pass 1. Thay vi
            # voi sang no (dang ma TokenVector khong doc duoc, va Ctx cua
            # pass 2 khong co truong do), suy TAI CHO theo DUNG quy uoc
            # chung ma print_feature.py da dung: co dau '.' la f64.
            if ekind(arg) == 'num':
                _t = ea_str(arg)
                if '.' in _t or 'e' in _t.lower():
                    _d = 'f64'
                else:
                    # num la so nguyen decimal: chon dung i32/i64/'int' theo
                    # kich thuoc CHU SO (khong dung Fallbac 'i32' - bug Tile:
                    # str(0x80000002) ra '-2147483646' do ldc.i4 nhureick).
                    _d = _num_int_dtype_of_text(_t)
        if _d in ('i32', 'i64', 'int', 'f32', 'f64', 'str', 'complex', 'datetime', 'date', 'timedelta'):
            ctx.compile_expr(arg, scope, out, _d, ctx)
            if _d == 'i32' and _is_bool_shaped(arg, scope, ctx.func_table):
                emit_to_str('bool', out, ctx)
                return
            emit_to_str(_d, out, ctx)
            return
        # 2026-08-03: 'str(<bieu thuc>)' (vd str(i + 1), str(len(xs))) -
        # ToString() la instance method tren value type nen CIL can DIA
        # CHI; gia tri tam tren stack khong co dia chi. Cach lam: do ket
        # qua bieu thuc vao 1 local AN (khai bao san boi _temps_str_builtin
        # o first-pass) roi lay dia chi cua local do - dung 1 lan, khong
        # doi ngu nghia.
        tmp_name = f'__strtmp{nid(arg)}'
        try:
            _rb = scope.tra(tmp_name)
            tmp_kind = _rb.kind
            tmp_idx = _rb.idx
            tmp_ta = _rb.ta
        except BienChuaKhaiBao:
            # Bat THANG ten lop (2026-09-24): truoc day bat `SyntaxError`,
            # dua vao viec `BienChuaKhaiBao` ke thua ca SyntaxError lan
            # KeyError. Ke thua doi khong bieu dien duoc trong CIL nen da bo;
            # bat thang ten lop ro nghia hon ca cach cu.
            raise SyntaxError(
                "il_codegen: str(<bieu thuc>) khong suy duoc kieu cua bieu thuc "
                "- gan ra 1 bien truoc roi str() bien do")
        ctx.compile_expr(arg, scope, out, tmp_ta.dtype, ctx)
        out.append(f'    stloc.s {tmp_idx}')
        _str_of_slot('local', tmp_idx, tmp_ta, out, ctx, int_dtypes, float_dtypes)
        return
    _rb = scope.tra(ea_str(arg))
    var_kind = _rb.kind
    var_idx = _rb.idx
    var_const = _rb.const_value
    var_ta = _rb.ta
    if var_ta.dtype == 'str' and var_ta.la_vo_huong():
        # str(s) khi 's' DA LA string - Python that: str(mot_chuoi) tra
        # ve CHINH chuoi do (khong doi) - can THEM (Wave 2, 2026-07-29)
        # de f-string macro (xem fstring.py) co the BOC DONG LOAT moi
        # {var} bang str(var) ma khong can biet truoc dtype cua var luc
        # macro-expand (van ban, TRUOC first-pass suy kieu).
        ctx.load_var_ref(ea_str(arg), scope, out)
        return
    if var_ta.shape_ten == 'list' and var_ta.elem_ta is None and var_ta.dtype in ('str', 'i32'):
        # str(<bien list[str]/list[i32]>) (2026-09-29): "['a', 'b']" / "[1, 2]"
        # nhu Python (cung TkvRepr voi repr(); xem nhanh bieu thuc o tren).
        _ensure_class_repr(ctx)
        ctx.load_var_ref(ea_str(arg), scope, out)
        if var_ta.dtype == 'str':
            out.append(f'    call string {_REPR_HELPER_CLASS}::Ds({_DS_STR})')
        else:
            out.append(f'    call string {_REPR_HELPER_CLASS}::' + ('DsB' if var_ta.logic == 1 else 'DsI') + f'({_DS_I32})')
        return
    if var_kind == 'const' and var_ta.la_vo_huong() and (var_ta.dtype in int_dtypes or var_ta.dtype in float_dtypes):
        # HANG SO module ('LIMIT = 50' o dau file): scope giu THANG gia tri
        # o cho cua chi so local, nen duong ToString cu sinh 'ldloca.s 50'
        # = dia chi local so 50 (khong ton tai) -> InvalidProgramException
        # LUC CHAY (bug that, tim qua cong cu codestat 2026-08-03). Gia tri
        # da biet luc bien dich nen sinh thang chuoi, dinh dang theo Python
        # (float luon co phan thap phan).
        text = (str(int(var_const)) if var_ta.dtype in int_dtypes
                else str(float(var_const)))
        out.append(f'    ldstr "{text}"')
        return
    if (var_ta.dtype == 'datetime' or var_ta.dtype == 'timedelta' or var_ta.dtype == 'date') and var_ta.la_vo_huong():
        # str(d) (2026-10-02): dinh dang Python qua TkvDt::Str/TdStr
        ctx.load_var_ref(ea_str(arg), scope, out)
        emit_to_str(var_ta.dtype, out, ctx)
        return
    if var_ta.logic == 1 and var_ta.dtype == 'i32' and var_ta.la_vo_huong() and var_kind != 'const':
        # bien bool (2026-10-01): in True/False
        ctx.load_var_ref(ea_str(arg), scope, out)
        emit_to_str('bool', out, ctx)
        return
    if var_ta.dtype == 'Exception' or (ctx and var_ta.dtype in ctx.records and
                                        _ilc._la_lop_ngoai_le(var_ta.dtype, ctx.record_bases)):
        # str(e) voi 'e' la bien loi ('except ... as e:', xem control_flow.py's
        # fpw_try) - ca 'Exception' (BCL, chua ep record) lan record TU DINH
        # NGHIA ke thua Exception deu dung .Message (port tu cay .tkv tu-host,
        # Phase 6.3/6.9, 2026-08-12).
        ctx.load_var_ref(ea_str(arg), scope, out)
        out.append('    callvirt instance string [mscorlib]System.Exception::get_Message()')
        return
    if var_ta.dtype == 'object':
        ctx.load_var_ref(ea_str(arg), scope, out)
        out.append('    callvirt instance string [mscorlib]System.Object::ToString()')
        return
    if var_ta.dtype == 'complex':
        # Muc 6.8 (2/4, 2026-08-13): str(c) voi 'c' la 1 BIEN 'complex' -
        # di CHUNG duong voi record/object o tren (nap gia tri qua
        # load_var_ref roi uy quyen emit_to_str, TU do vao scratch local
        # de lay dia chi truoc khi goi ToString() - xem tkvstr.py).
        ctx.load_var_ref(ea_str(arg), scope, out)
        emit_to_str(var_ta.dtype, out, ctx)
        return
    if ctx and var_ta.dtype in ctx.records:
        # record co __str__ (6.5, 2026-08-13): di CHUNG duong voi cac dtype
        # khac qua emit_to_str (diem dispatch chung) - truoc day nhanh nay
        # goi thang ToString() mac dinh (chi in ten class, khong dung
        # __str__ nguoi dung dinh nghia). emit_to_str tu validate + raise
        # SyntaxError ro rang neu record khong co __str__.
        ctx.load_var_ref(ea_str(arg), scope, out)
        emit_to_str(var_ta.dtype, out, ctx)
        return
    if var_ta.shape_ten == 'set' and not var_ta.la_vo_huong():
        _emit_set_repr(arg, var_ta, scope, out, ctx)
        return
    if var_ta.shape_ten == 'tuple' and var_ta.logic != 0:
        raise SyntaxError(f"il_codegen: str('{ea_str(arg)}') - tuple chua phan tu bool chua ho tro in ca tuple (se in 1/0 thay True/False); "
                          f"in tung phan tu '{ea_str(arg)}[i]'")
    if var_ta.shape_ten in ('list', 'dict', 'tuple', 'defaultdict', 'counter') and not var_ta.la_vo_huong():
        # container bat ky (long nhau, dict, tuple, list[f64]...) - repr theo kieu luc chay (2026-09-30)
        _ensure_repr_any(ctx)
        ctx.load_var_ref(ea_str(arg), scope, out)
        out.append('    call string TkvReprAny::Any(object)')
        return
    if (var_ta.dtype not in int_dtypes and var_ta.dtype not in float_dtypes) or not var_ta.la_vo_huong():
        raise SyntaxError(
            f"il_codegen: str() chi nhan bien so vo huong (f32/f64/i32/i64), "
            f"'{ea_str(arg)}' khong hop le (dtype={var_ta.dtype}, shape={var_ta.shape_str()})")
    # moc 7: bien don cung di CHUNG duong voi bieu thuc - _str_of_slot cu
    # (ToString + va ".0" tai cho) da bi thay han, hai duong dinh dang so
    # thuc song song chac chan lech nhau.
    ctx.load_var_ref(ea_str(arg), scope, out)
    emit_to_str(var_ta.dtype, out, ctx)
    return


def _str_of_slot(var_kind: "str", var_idx: "i32", var_ta: "TypeAnn", out: "list[str]", ctx: "Ctx", int_dtypes: "set[str]", float_dtypes: "set[str]"):
    """Sinh ToString(InvariantCulture) cho 1 SLOT (arg/local) da co dia
    chi - dung chung cho ca 'str(bien)' va 'str(bieu thuc)' (bieu thuc da
    duoc do vao 1 local an truoc do).

    BUG THAT sua 2026-08-11 (phat hien khi verify .format(), xem
    string_format.py): dtype='int' (TkvInt, so nguyen vo han chu so cua
    DSL) truoc day RƠI vao nhanh chung ben duoi (gia dinh MOI dtype so co
    instance method 'ToString(IFormatProvider)') -> MissingMethodException
    THAT luc chay ('str(1)', 'str(i+1)' voi i la 'int' deu vo). TkvInt
    KHONG co ToString(IFormatProvider) - chi co ham STATIC rieng
    'TkvInt::Str(valuetype TkvInt)' (xem int_type.py's compile_str_of_int,
    duong DUY NHAT truoc day hoat dong dung la khi ca node la 1 BIEN da
    biet dtype='int' NGAY TU DAU, di qua nhanh rieng o string_feature.py's
    compile_str_builtin truoc khi toi ham nay - nhanh do KHONG bao phu
    truong hop bieu thuc/hang so can qua local an nhu o day)."""
    if var_ta.dtype == 'int':
        ensure_class_int(ctx)
        out.append(f'    {"ldarg.s" if var_kind == "arg" else "ldloc.s"} {var_idx}')
        out.append(f'    call string {_int_type.TKVINT_CLASS}::Str(valuetype {_int_type.TKVINT_CLASS})')
        return
    out.append(f'    {"ldarga.s" if var_kind == "arg" else "ldloca.s"} {var_idx}')
    if var_ta.dtype == 'f64':
        # Dinh dang "R" (round-trip) - Double.ToString() MAC DINH cua .NET
        # Framework chi in 15 chu so co nghia, nen str(0.1 + 0.2) ra "0.3"
        # trong khi Python in "0.30000000000000004" (repr ngan nhat DOC
        # LAI DUNG). Bug that tim qua tools/tkvcalc.tkv - "R" khop Python
        # o moi truong hop da thu.
        out.append('    ldstr "R"')
        out.append('    call class [mscorlib]System.Globalization.CultureInfo '
                    '[mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()')
        out.append('    call instance string [mscorlib]System.Double'
                    '::ToString(string, class [mscorlib]System.IFormatProvider)')
    else:
        out.append('    call class [mscorlib]System.Globalization.CultureInfo '
                    '[mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()')
        out.append(f'    call instance string {IL_SCALAR[var_ta.dtype]}'
                    '::ToString(class [mscorlib]System.IFormatProvider)')
    if var_ta.dtype in float_dtypes:
        # .NET Single/Double.ToString() bo dau cham thap phan cho so
        # tron (vd 0.0f -> "0"), nhung Python str(0.0) LUON co ".0" -
        # bug that phat hien qua test doi chieu CPython (celsius=0.0 ->
        # exe in "0C", CPython in "0.0C"). Them ".0" neu ket qua CHUA co
        # dau cham (chi can xet '.' vi khong dung ky hieu khoa hoc 'E' o
        # day - ToString mac dinh cho float32/64 thong thuong khong tu
        # chuyen sang dang E trong khoang gia tri thuong gap).
        ctx.label_counter[0] += 1
        n = ctx.label_counter[0]
        has_dot_lbl = f"{ctx.prefix}_strfix{n}_hasdot"
        end_lbl = f"{ctx.prefix}_strfix{n}_end"
        out.append('    dup')
        out.append('    ldstr "."')
        out.append('    callvirt instance bool [mscorlib]System.String::Contains(string)')
        out.append(f'    brtrue {has_dot_lbl}')
        out.append('    ldstr ".0"')
        out.append('    call string [mscorlib]System.String::Concat(string, string)')
        out.append(f'    br {end_lbl}')
        out.append(f'  {has_dot_lbl}:')
        out.append(f'  {end_lbl}:')


def _temps_str_builtin(node: "TkvNode", ctx: "WalkCtx"):
    """First-pass: 'str(<bieu thuc>)' can 1 local AN giu ket qua bieu thuc
    (xem compile_str_builtin). Khoa theo id(arg) - CHINH node doi so, on
    dinh giua 2 pass. Khong suy duoc dtype thi bo qua: pass 2 se bao loi
    RO RANG thay vi sinh ma sai."""
    args = eb_ds(node)
    if len(args) != 1 or ekind(args[0]) == 'var':
        return
    arg = args[0]
    d = (ctx.infer_dtype(arg, ctx.infer_scope, ctx.func_table, ctx.records,
                            ctx.record_methods, None)
         or ctx.infer_literal_dtype(arg))
    if d is None or d == 'str':
        return
    ctx.declare_named(f'__strtmp{nid(arg)}', TypeAnn(d, None))


# (2026-08-12) Truoc day 'str' co duong dispatch RIENG trong _expr_call
# (if name == 'str': ...), nen moc temps o first-pass phai dang ky THANG
# vao EXPR_BUILTIN_TEMPS (khong qua register_expr_builtin, ham do khong
# nhan temps_fn tu 1 lenh goi rieng cho 'str'). Gio 'str' DA chuyen sang
# register_expr_builtin(...) o cuoi file (dispatch chung EXPR_BUILTIN_CODEGEN),
# nhung temps_fn van dang ky THANG o day (khong truyen qua tham so
# temps_fn cua register_expr_builtin) - GIU NGUYEN cach cu vi hanh vi
# giong het nhau (ca 2 deu ghi vao cung dict EXPR_BUILTIN_TEMPS['str']),
# doi lai chi them rui ro khong can thiet.


def compile_fmt_float(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """Nhanh 'fmt_float(x, n)' cua _expr_call (Wave 3, 2026-07-29) - dung
    cho f-string format spec '{x:.2f}' (xem fstring.py's _fstring_to_concat_expr)
    VA dung truc tiep duoc trong code neu can. GIOI HAN GIONG str():
    'x' CHI 1 BIEN don (can dia chi de goi ToString - value type), 'n'
    CHI hang so nguyen KHONG AM tai compile-time (tro thanh literal
    "F{n}" ngay trong IL, khong dung duoc bien dong)."""
    if len(args) != 2:
        raise SyntaxError("il_codegen: fmt_float(x, n) can dung 2 tham so")
    arg, n_node = args
    if ekind(arg) != 'var':
        raise SyntaxError(
            "il_codegen: fmt_float() hien CHI ho tro 1 BIEN don (vd fmt_float(x, 2)), "
            "chua ho tro bieu thuc phuc tap")
    if ekind(n_node) != 'num' or '.' in ea_str(n_node):
        raise SyntaxError(
            "il_codegen: fmt_float(x, n) - 'n' phai la hang so nguyen KHONG AM tai "
            "compile-time (vd 2), khong ho tro bieu thuc dong")
    n = int(ea_str(n_node))
    _rb = scope.tra(ea_str(arg))
    var_kind = _rb.kind
    var_idx = _rb.idx
    var_ta = _rb.ta
    int_dtypes, float_dtypes = ctx.int_dtypes, ctx.float_dtypes
    if (var_ta.dtype not in int_dtypes and var_ta.dtype not in float_dtypes) or not var_ta.la_vo_huong():
        raise SyntaxError(
            f"il_codegen: fmt_float() chi nhan bien so vo huong (f32/f64/i32/i64), "
            f"'{ea_str(arg)}' khong hop le (dtype={var_ta.dtype}, shape={var_ta.shape_str()})")
    addr_op = 'ldarga.s' if var_kind == 'arg' else 'ldloca.s'
    out.append(f'    {addr_op} {var_idx}')
    out.append(f'    ldstr "F{n}"')
    out.append('    call class [mscorlib]System.Globalization.CultureInfo '
                '[mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()')
    out.append(f'    call instance string {IL_SCALAR[var_ta.dtype]}'
                '::ToString(string, class [mscorlib]System.IFormatProvider)')


_FMT_CLASS = 'TkvFmt'
_SPEC_RE = re.compile(r'^(?:(.)([<>^=])|([<>^=]))?([+ -])?(0)?(\d+)?(,)?(?:\.(\d+))?([a-zA-Z%])?$')


def _ensure_class_fmt(ctx: "Ctx"):
    """TkvFmt::F/Pad/Base/Sign - f-string format spec '{x:>8.2f}' '{n:05d}' '{n:x}' (2026-09-30).
    F dung TkvRound::R (lam tron chinh xac nhu Python) roi ToString("Fn")."""
    emitted = ctx.emitted_types
    if emitted is None or _FMT_CLASS in emitted:
        return
    emitted.add(_FMT_CLASS)
    _ilc._ensure_class_round(ctx)
    S = '[mscorlib]System.String'
    ctx.extra_classes.append([
        f'.class public auto ansi beforefieldinit {_FMT_CLASS} extends [mscorlib]System.Object',
        '{',
        '  .method public static string F(float64 x, int32 n) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldarg.0', '    ldarg.1', '    call float64 TkvRound::R(float64, int32)', '    starg.s x',
        '    ldarga.s x',
        '    ldstr "F"', '    ldarg.1', '    box [mscorlib]System.Int32',
        f'    call string {S}::Concat(object, object)',
        '    call class [mscorlib]System.Globalization.CultureInfo [mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()',
        '    call instance string [mscorlib]System.Double::ToString(string, class [mscorlib]System.IFormatProvider)',
        '    ret',
        '  }',
        '  .method public static string Comma(string s) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldarg.0',
        '    ldstr "(?<!\\\\.\\\\d*)(?<=\\\\d)(?=(\\\\d{3})+(?!\\\\d))"',
        '    ldstr ","',
        '    call string [System]System.Text.RegularExpressions.Regex::Replace(string, string, string)',
        '    ret',
        '  }',
        '  .method public static string Pre(string s, string pre) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldarg.0', '    ldc.i4.0', f'    callvirt instance char {S}::get_Chars(int32)', '    ldc.i4.s 45', '    bne.un PR_POS',
        '    ldstr "-"', '    ldarg.1', '    ldarg.0', '    ldc.i4.1', f'    callvirt instance string {S}::Substring(int32)',
        f'    call string {S}::Concat(string, string, string)', '    ret',
        '  PR_POS:', '    ldarg.1', '    ldarg.0', f'    call string {S}::Concat(string, string)', '    ret',
        '  }',
        '  .method public static string Sign(string s) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldarg.0', '    ldc.i4.0', f'    callvirt instance char {S}::get_Chars(int32)', '    ldc.i4.s 45', '    beq SG_NO',
        '    ldstr "+"', '    ldarg.0', f'    call string {S}::Concat(string, string)', '    ret',
        '  SG_NO:', '    ldarg.0', '    ret',
        '  }',
        '  .method public static string Base(int64 v, int32 b, int32 up) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (string r)',
        '    ldarg.0', '    ldc.i8 0', '    bge BS_POS',
        '    ldstr "-"', '    ldc.i8 0', '    ldarg.0', '    sub', '    ldarg.1',
        '    call string [mscorlib]System.Convert::ToString(int64, int32)',
        f'    call string {S}::Concat(string, string)', '    stloc.0', '    br BS_UP',
        '  BS_POS:', '    ldarg.0', '    ldarg.1', '    call string [mscorlib]System.Convert::ToString(int64, int32)', '    stloc.0',
        '  BS_UP:', '    ldarg.2', '    brfalse BS_END',
        '    ldloc.0', f'    callvirt instance string {S}::ToUpperInvariant()', '    stloc.0',
        '  BS_END:', '    ldloc.0', '    ret',
        '  }',
        '  .method public static string Pad(string s, int32 w, int32 fill, int32 al) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (int32 pad, int32 left, int32 c)',
        '    ldarg.1', '    ldarg.0', f'    callvirt instance int32 {S}::get_Length()', '    sub', '    stloc.0',
        '    ldloc.0', '    ldc.i4.0', '    bgt PD_GO',
        '    ldarg.0', '    ret',
        '  PD_GO:',
        '    ldarg.3', '    ldc.i4.1', '    beq PD_R',
        '    ldarg.3', '    ldc.i4.2', '    beq PD_C',
        '    ldarg.3', '    ldc.i4.3', '    beq PD_E',
        '    ldarg.0', '    ldarg.1', '    ldarg.2', '    conv.u2', f'    callvirt instance string {S}::PadRight(int32, char)', '    ret',
        '  PD_R:',
        '    ldarg.0', '    ldarg.1', '    ldarg.2', '    conv.u2', f'    callvirt instance string {S}::PadLeft(int32, char)', '    ret',
        '  PD_C:',
        '    ldloc.0', '    ldc.i4.2', '    div', '    stloc.1',
        '    ldarg.2', '    conv.u2', '    ldloc.1', f'    newobj instance void {S}::.ctor(char, int32)',
        '    ldarg.0',
        '    ldarg.2', '    conv.u2', '    ldloc.0', '    ldloc.1', '    sub', f'    newobj instance void {S}::.ctor(char, int32)',
        f'    call string {S}::Concat(string, string, string)', '    ret',
        '  PD_E:',
        '    ldarg.0', '    ldc.i4.0', f'    callvirt instance char {S}::get_Chars(int32)', '    stloc.2',
        '    ldloc.2', '    ldc.i4.s 45', '    beq PD_SG', '    ldloc.2', '    ldc.i4.s 43', '    beq PD_SG',
        '    ldarg.0', '    ldarg.1', '    ldarg.2', '    conv.u2', f'    callvirt instance string {S}::PadLeft(int32, char)', '    ret',
        '  PD_SG:',
        '    ldarg.0', '    ldc.i4.0', '    ldc.i4.1', f'    callvirt instance string {S}::Substring(int32, int32)',
        '    ldarg.0', '    ldc.i4.1', f'    callvirt instance string {S}::Substring(int32)',
        '    ldarg.1', '    ldc.i4.1', '    sub', '    ldarg.2', '    conv.u2', f'    callvirt instance string {S}::PadLeft(int32, char)',
        f'    call string {S}::Concat(string, string)', '    ret',
        '  }',
        '}',
    ])


def compile_hex_builtin(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """hex(n) = '0xff' / '-0xff' (2026-10-01)."""
    _compile_co_so(args, scope, out, ctx, 16, '0x', 'hex')


def compile_bin_builtin(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """bin(n) = '0b101' (2026-10-01)."""
    _compile_co_so(args, scope, out, ctx, 2, '0b', 'bin')


def compile_oct_builtin(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """oct(n) = '0o17' (2026-10-01)."""
    _compile_co_so(args, scope, out, ctx, 8, '0o', 'oct')


def _compile_co_so(args: "list[TkvNode]", scope: "Scope", out: "list[str]", ctx: "Ctx", co_so: "i32", tien_to: "str", ten: "str"):
    if len(args) != 1:
        raise SyntaxError("il_codegen: " + ten + "(n) can dung 1 tham so")
    _ensure_class_fmt(ctx)
    ctx.compile_expr(args[0], scope, out, 'i64', ctx)
    out.append(f'    ldc.i4 {co_so}')
    out.append('    ldc.i4.0')
    out.append(f'    call string {_FMT_CLASS}::Base(int64, int32, int32)')
    out.append(f'    ldstr "{tien_to}"')
    out.append(f'    call string {_FMT_CLASS}::Pre(string, string)')
    # Pre(s, pre) nhan (chuoi so, tien to): dao thu tu cho dung chu ky
    return


def compile_fmt_spec(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'fmt_spec(x, "spec")' - f-string '{x:spec}' voi spec ngoai '.Nf' (2026-09-30).
    Ho tro [[fill]align][sign][0][width][.prec][type], type trong d s f x X b o.
    Mac dinh can le: so -> phai, chuoi -> trai, co co '0' -> '=' (dau roi so 0)."""
    if len(args) != 2 or ekind(args[1]) != 'str_lit':
        raise SyntaxError("il_codegen: fmt_spec(x, spec) can 2 tham so, spec la chuoi hang")
    spec_tho = ea_str(args[1])
    spec = spec_tho[1:-1]
    m = _SPEC_RE.match(spec)
    if not m:
        raise SyntaxError("il_codegen: f-string format spec khong hieu: " + spec)
    fill_c, al_c, al_only, sign, zero, width, comma, prec, typ = m.groups()
    if comma and typ not in (None, '', 'd', 'f'):
        raise SyntaxError("il_codegen: f-string format spec ',' chi di voi type d hoac f: " + spec)
    if typ is None:
        typ = ''
    if typ == 'd' and width is not None and not zero:
        # Co 1 test CHOT chi dang 0-pad ('05d') cho type d; do rong khong
        # 0-pad ('5d') bi tu choi ro rang thay vi hieu kha ac.
        raise SyntaxError("il_codegen: f-string spec '" + spec +
                          "' chi ho tro dang 0-pad cho type d (vd '05d')")
    if typ not in ('', 'd', 's', 'f', 'x', 'X', 'b', 'o'):
        raise SyntaxError("il_codegen: f-string format type " + typ + " chua ho tro (chi d s f x X b o): " + spec)
    if sign == ' ':
        raise SyntaxError("il_codegen: f-string format sign khoang trang chua ho tro: " + spec)
    if prec is not None and typ != 'f':
        raise SyntaxError("il_codegen: f-string .N chi ho tro voi type f: " + spec)
    arg = args[0]
    x_dtype = ctx.infer_dtype(arg, scope, ctx.func_table, None, None, None)
    la_chuoi = (x_dtype == 'str' or typ == 's')
    if typ == 'f':
        n_prec = 6
        if prec is not None:
            n_prec = int(prec)
        _ensure_class_fmt(ctx)
        ctx.compile_expr(arg, scope, out, 'f64', ctx)
        out.append(f'    ldc.i4 {n_prec}')
        out.append(f'    call string {_FMT_CLASS}::F(float64, int32)')
    elif typ in ('x', 'X', 'b', 'o'):
        _ensure_class_fmt(ctx)
        so_co = 16
        if typ == 'b':
            so_co = 2
        if typ == 'o':
            so_co = 8
        hoa = 0
        if typ == 'X':
            hoa = 1
        ctx.compile_expr(arg, scope, out, 'i64', ctx)
        out.append(f'    ldc.i4 {so_co}')
        out.append(f'    ldc.i4 {hoa}')
        out.append(f'    call string {_FMT_CLASS}::Base(int64, int32, int32)')
    elif la_chuoi:
        ctx.compile_expr(arg, scope, out, 'str', ctx)
    else:
        compile_str_builtin([arg], scope, out, 'str', ctx)
    if comma and not la_chuoi:
        _ensure_class_fmt(ctx)
        out.append(f'    call string {_FMT_CLASS}::Comma(string)')
    if sign == '+' and not la_chuoi:
        _ensure_class_fmt(ctx)
        out.append(f'    call string {_FMT_CLASS}::Sign(string)')
    if width is not None:
        _ensure_class_fmt(ctx)
        fill = ' '
        if fill_c:
            fill = fill_c
        elif zero:
            fill = '0'
        al = al_c
        if al is None:
            al = al_only
        if al is None:
            if zero:
                al = '='
            elif la_chuoi:
                al = '<'
            else:
                al = '>'
        out.append(f'    ldc.i4 {int(width)}')
        out.append(f'    ldc.i4 {ord(fill)}')
        ma_al = '<>^='.find(al)
        out.append(f'    ldc.i4 {ma_al}')
        out.append(f'    call string {_FMT_CLASS}::Pad(string, int32, int32, int32)')


_REPR_HELPER_CLASS = 'TkvRepr'
_DS_STR = 'class [mscorlib]System.Collections.Generic.List`1<string>'
_DS_I32 = 'class [mscorlib]System.Collections.Generic.List`1<int32>'
_SB = '[mscorlib]System.Text.StringBuilder'
_SB_APPEND = 'callvirt instance class [mscorlib]System.Text.StringBuilder [mscorlib]System.Text.StringBuilder::Append(string)'


def _ensure_class_repr(ctx: "Ctx"):
    """TkvRepr::Str(string) - repr() cua chuoi DUNG nhu Python: nhay kep khi
    chuoi co ' ma khong co ", thoat gach cheo / xuong dong / tab va nhay dang dung; null ->
    None. Sinh 1 lan/chuong trinh (mau ensure_class_rand)."""
    emitted = ctx.emitted_types
    if emitted is None or _REPR_HELPER_CLASS in emitted:
        return
    emitted.add(_REPR_HELPER_CLASS)
    rep = 'callvirt instance string [mscorlib]System.String::Replace(string, string)'
    chua = 'callvirt instance bool [mscorlib]System.String::Contains(string)'
    noi = 'call string [mscorlib]System.String::Concat(string, string, string)'
    ctx.extra_classes.append([
        f'.class public auto ansi beforefieldinit {_REPR_HELPER_CLASS} extends [mscorlib]System.Object',
        '{',
        '  .method public static string Str(string s) cil managed',
        '  {',
        '    .maxstack 8',
        '    .locals init (string v)',
        '    ldarg.0',
        '    brtrue TKVREPR_CO',
        '    ldstr "None"',
        '    ret',
        '  TKVREPR_CO:',
        '    ldarg.0',
        '    ldstr "\\\\"', '    ldstr "\\\\\\\\"', '    ' + rep,
        '    ldstr "\\n"', '    ldstr "\\\\n"', '    ' + rep,
        '    ldstr "\\r"', '    ldstr "\\\\r"', '    ' + rep,
        '    ldstr "\\t"', '    ldstr "\\\\t"', '    ' + rep,
        '    stloc.0',
        '    ldarg.0', '    ldstr "\'"', '    ' + chua,
        '    brfalse TKVREPR_DON',
        '    ldarg.0', '    ldstr "\\""', '    ' + chua,
        '    brtrue TKVREPR_DON',
        '    ldstr "\\""', '    ldloc.0', '    ldstr "\\""', '    ' + noi,
        '    ret',
        '  TKVREPR_DON:',
        '    ldstr "\'"', '    ldloc.0', '    ldstr "\'"', '    ldstr "\\\\\'"', '    ' + rep,
        '    ldstr "\'"', '    ' + noi,
        '    ret',
        '  }',
        # Ds(List<string>) (2026-09-28): repr(list[str]) -> "['a', 'b']"
        f'  .method public static string Ds({_DS_STR} ds) cil managed',
        '  {',
        '    .maxstack 8',
        f'    .locals init (class {_SB} sb, int32 i)',
        '    ldarg.0',
        '    brtrue TKVREPR_DS_CO',
        '    ldstr "None"',
        '    ret',
        '  TKVREPR_DS_CO:',
        '    ldstr "["',
        f'    newobj instance void {_SB}::.ctor(string)',
        '    stloc.0',
        '    ldc.i4.0',
        '    stloc.1',
        '  TKVREPR_DS_LAP:',
        '    ldloc.1',
        '    ldarg.0',
        f'    callvirt instance int32 {_DS_STR}::get_Count()',
        '    bge TKVREPR_DS_HET',
        '    ldloc.1',
        '    brfalse TKVREPR_DS_DAU',
        '    ldloc.0',
        '    ldstr ", "',
        '    ' + _SB_APPEND,
        '    pop',
        '  TKVREPR_DS_DAU:',
        '    ldloc.0',
        '    ldarg.0',
        '    ldloc.1',
        f'    callvirt instance !0 {_DS_STR}::get_Item(int32)',
        f'    call string {_REPR_HELPER_CLASS}::Str(string)',
        '    ' + _SB_APPEND,
        '    pop',
        '    ldloc.1',
        '    ldc.i4.1',
        '    add',
        '    stloc.1',
        '    br TKVREPR_DS_LAP',
        '  TKVREPR_DS_HET:',
        '    ldloc.0',
        '    ldstr "]"',
        '    ' + _SB_APPEND,
        '    callvirt instance string [mscorlib]System.Object::ToString()',
        '    ret',
        '  }',
        # DsI(List<int32>) (2026-09-29): str/repr(list[i32]) -> "[1, 2]"
        f'  .method public static string DsI({_DS_I32} ds) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldarg.0',
        '    brtrue TKVREPR_DSI_CO',
        '    ldstr "None"',
        '    ret',
        '  TKVREPR_DSI_CO:',
        '    ldstr "["',
        '    ldstr ", "',
        '    ldarg.0',
        '    call string [mscorlib]System.String::Join<int32>(string, '
        'class [mscorlib]System.Collections.Generic.IEnumerable`1<!!0>)',
        '    ldstr "]"',
        '    call string [mscorlib]System.String::Concat(string, string, string)',
        '    ret',
        '  }',
        # DsB(List<int32>) (2026-10-02): str(list[bool]) -> "[True, False]"
        f'  .method public static string DsB({_DS_I32} ds) cil managed',
        '  {',
        '    .maxstack 8',
        f'    .locals init (class {_SB} sb, int32 i)',
        '    ldarg.0',
        '    brtrue TKVREPR_DSB_CO',
        '    ldstr "None"',
        '    ret',
        '  TKVREPR_DSB_CO:',
        '    ldstr "["',
        f'    newobj instance void {_SB}::.ctor(string)',
        '    stloc.0',
        '    ldc.i4.0',
        '    stloc.1',
        '  TKVREPR_DSB_LAP:',
        '    ldloc.1',
        '    ldarg.0',
        f'    callvirt instance int32 {_DS_I32}::get_Count()',
        '    bge TKVREPR_DSB_HET',
        '    ldloc.1',
        '    brfalse TKVREPR_DSB_1',
        '    ldloc.0',
        '    ldstr ", "',
        '    ' + _SB_APPEND,
        '    pop',
        '  TKVREPR_DSB_1:',
        '    ldloc.0',
        '    ldarg.0',
        '    ldloc.1',
        f'    callvirt instance !0 {_DS_I32}::get_Item(int32)',
        '    brtrue TKVREPR_DSB_T',
        '    ldstr "False"',
        '    br TKVREPR_DSB_A',
        '  TKVREPR_DSB_T:',
        '    ldstr "True"',
        '  TKVREPR_DSB_A:',
        '    ' + _SB_APPEND,
        '    pop',
        '    ldloc.1',
        '    ldc.i4.1',
        '    add',
        '    stloc.1',
        '    br TKVREPR_DSB_LAP',
        '  TKVREPR_DSB_HET:',
        '    ldloc.0',
        '    ldstr "]"',
        '    ' + _SB_APPEND,
        '    callvirt instance string [mscorlib]System.Object::ToString()',
        '    ret',
        '  }',
        '}',
    ])



def _emit_set_repr(arg: "TkvNode", ta: "TypeAnn", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """str(<set>): '{a, b}' voi phan tu DA SAP (CPython in set so nho theo hash ~ tang dan; .NET HashSet in
    theo thu tu chen) - sao ra List, sap, repr nhu list roi doi ngoac; rong -> 'set()' (2026-09-30)."""
    _ensure_repr_any(ctx)
    lt = il_list_type(ta.dtype, ctx.records)
    ctx.compile_expr(arg, scope, out, ta.dtype, ctx)
    out.append(f'    newobj instance void {lt}::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    out.append('    dup')
    emit_list_sort(out, lt, ta.dtype)
    out.append('    call string TkvReprAny::Any(object)')
    out.append('    call string TkvReprAny::Br(string)')


def _ensure_repr_any(ctx: "Ctx"):
    """TkvRepr::Any(object) - repr kieu Python cua BAT KY gia tri/container long nhau (2026-09-30):
    None/str/bool/int/float/TkvInt/list/dict/tuple/set theo kieu luc chay. Dung cho str()/print()/f-string
    cua container ma cac ham chuyen dung (Ds/DsI/ReprN) khong phu."""
    _ensure_class_repr(ctx)
    if _REPR_ANY_MARK in ctx.emitted_types:
        return
    ctx.emitted_types.add(_REPR_ANY_MARK)
    ensure_class_int(ctx)
    _tkvstr.ensure_class(ctx)
    OBJ = '[mscorlib]System.Object'
    IEN = '[mscorlib]System.Collections.IEnumerator'
    IENB = '[mscorlib]System.Collections.IEnumerable'
    STR = '[mscorlib]System.String'
    lines = [
        '  .method public static string Br(string s) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldarg.0', '    ldstr "[]"', f'    call bool {STR}::op_Equality(string, string)', '    brfalse BR_NE', '    ldstr "set()"', '    ret',
        '  BR_NE:',
        '    ldstr "{"', '    ldarg.0', '    ldc.i4.1', '    ldarg.0', f'    callvirt instance int32 {STR}::get_Length()', '    ldc.i4.2', '    sub',
        f'    callvirt instance string {STR}::Substring(int32, int32)', '    ldstr "}"', f'    call string {STR}::Concat(string, string, string)', '    ret',
        '  }',
        f'  .method public static string Any(object o) cil managed',
        '  {',
        '    .maxstack 8',
        f'    .locals init (class {_SB} sb, class {IEN} en, int32 n, object x, class [mscorlib]System.Collections.IDictionaryEnumerator de, class [mscorlib]System.Type t, int32 i, string k)',
        '    ldarg.0', '    brtrue AN_NN', '    ldstr "None"', '    ret',
        '  AN_NN:',
        f'    ldarg.0', f'    isinst {STR}', '    brfalse AN_NSTR',
        f'    ldarg.0', f'    castclass {STR}', f'    call string {_REPR_HELPER_CLASS}::Str(string)', '    ret',
        '  AN_NSTR:',
        '    ldarg.0', '    isinst [mscorlib]System.Boolean', '    brfalse AN_NBOOL',
        '    ldarg.0', '    unbox.any [mscorlib]System.Boolean', '    brtrue AN_TRUE', '    ldstr "False"', '    ret',
        '  AN_TRUE:', '    ldstr "True"', '    ret',
        '  AN_NBOOL:',
        '    ldarg.0', '    isinst [mscorlib]System.Double', '    brfalse AN_NDBL',
        '    ldarg.0', '    unbox.any [mscorlib]System.Double', f'    call string {_tkvstr.TKVSTR_CLASS}::F64(float64)', '    ret',
        '  AN_NDBL:',
        '    ldarg.0', '    isinst [mscorlib]System.Single', '    brfalse AN_NSGL',
        '    ldarg.0', '    unbox.any [mscorlib]System.Single', f'    call string {_tkvstr.TKVSTR_CLASS}::F32(float32)', '    ret',
        '  AN_NSGL:',
        '    ldarg.0', '    isinst valuetype TkvInt', '    brfalse AN_NINT',
        '    ldarg.0', '    unbox.any valuetype TkvInt', '    call string TkvInt::Str(valuetype TkvInt)', '    ret',
        '  AN_NINT:',
        # dict
        '    ldarg.0', '    isinst [mscorlib]System.Collections.IDictionary', '    brfalse AN_NDIC',
        '    ldstr "{"', f'    newobj instance void {_SB}::.ctor(string)', '    stloc.0',
        '    ldarg.0', '    castclass [mscorlib]System.Collections.IDictionary',
        '    callvirt instance class [mscorlib]System.Collections.IDictionaryEnumerator [mscorlib]System.Collections.IDictionary::GetEnumerator()', '    stloc.s de',
        '    ldc.i4.0', '    stloc.2',
        '  AN_DL:',
        '    ldloc.s de', '    callvirt instance bool [mscorlib]System.Collections.IEnumerator::MoveNext()', '    brfalse AN_DE',
        '    ldloc.2', '    brfalse AN_D1', '    ldloc.0', '    ldstr ", "', '    ' + _SB_APPEND, '    pop',
        '  AN_D1:',
        '    ldloc.0', '    ldloc.s de', '    callvirt instance object [mscorlib]System.Collections.IDictionaryEnumerator::get_Key()', '    call string TkvReprAny::Any(object)', '    ' + _SB_APPEND, '    pop',
        '    ldloc.0', '    ldstr ": "', '    ' + _SB_APPEND, '    pop',
        '    ldloc.0', '    ldloc.s de', '    callvirt instance object [mscorlib]System.Collections.IDictionaryEnumerator::get_Value()', '    call string TkvReprAny::Any(object)', '    ' + _SB_APPEND, '    pop',
        '    ldloc.2', '    ldc.i4.1', '    add', '    stloc.2', '    br AN_DL',
        '  AN_DE:',
        '    ldloc.0', '    ldstr "}"', '    ' + _SB_APPEND, f'    callvirt instance string {OBJ}::ToString()', '    ret',
        '  AN_NDIC:',
        # tuple System.Tuple`N
        '    ldarg.0', f'    callvirt instance class [mscorlib]System.Type {OBJ}::GetType()', '    stloc.s t',
        '    ldloc.s t', '    callvirt instance string [mscorlib]System.Type::get_Name()', '    ldstr "Tuple`"',
        f'    callvirt instance bool {STR}::StartsWith(string)', '    brfalse AN_NTUP',
        '    ldstr "("', f'    newobj instance void {_SB}::.ctor(string)', '    stloc.0',
        '    ldloc.s t', '    callvirt instance class [mscorlib]System.Type[] [mscorlib]System.Type::GetGenericArguments()', '    ldlen', '    conv.i4', '    stloc.2',
        '    ldc.i4.0', '    stloc.s i',
        '  AN_TL:',
        '    ldloc.s i', '    ldloc.2', '    bge AN_TE',
        '    ldloc.s i', '    brfalse AN_T1', '    ldloc.0', '    ldstr ", "', '    ' + _SB_APPEND, '    pop',
        '  AN_T1:',
        '    ldloc.0',
        '    ldloc.s t', '    ldstr "Item"', '    ldloc.s i', '    ldc.i4.1', '    add', '    box [mscorlib]System.Int32', f'    call string {STR}::Concat(object, object)',
        '    callvirt instance class [mscorlib]System.Reflection.PropertyInfo [mscorlib]System.Type::GetProperty(string)',
        '    ldarg.0', '    ldnull', '    callvirt instance object [mscorlib]System.Reflection.PropertyInfo::GetValue(object, object[])',
        '    call string TkvReprAny::Any(object)', '    ' + _SB_APPEND, '    pop',
        '    ldloc.s i', '    ldc.i4.1', '    add', '    stloc.s i', '    br AN_TL',
        '  AN_TE:',
        '    ldloc.2', '    ldc.i4.1', '    bne.un AN_TC', '    ldloc.0', '    ldstr ","', '    ' + _SB_APPEND, '    pop',
        '  AN_TC:',
        '    ldloc.0', '    ldstr ")"', '    ' + _SB_APPEND, f'    callvirt instance string {OBJ}::ToString()', '    ret',
        '  AN_NTUP:',
        # list / set (bat ky IEnumerable): '[...]' cho IList, '{...}' con lai
        f'    ldarg.0', f'    isinst {IENB}', '    brfalse AN_NENUM',
        '    ldarg.0', '    isinst [mscorlib]System.Collections.IList', '    brfalse AN_SET',
        '    ldstr "["', f'    newobj instance void {_SB}::.ctor(string)', '    stloc.0', '    ldstr "]"', '    stloc.s k', '    br AN_ITER',
        '  AN_SET:',
        '    ldstr "{"', f'    newobj instance void {_SB}::.ctor(string)', '    stloc.0', '    ldstr "}"', '    stloc.s k',
        '  AN_ITER:',
        f'    ldarg.0', f'    castclass {IENB}', f'    callvirt instance class {IEN} {IENB}::GetEnumerator()', '    stloc.1',
        '    ldc.i4.0', '    stloc.2',
        '  AN_LL:',
        '    ldloc.1', f'    callvirt instance bool {IEN}::MoveNext()', '    brfalse AN_LE',
        '    ldloc.2', '    brfalse AN_L1', '    ldloc.0', '    ldstr ", "', '    ' + _SB_APPEND, '    pop',
        '  AN_L1:',
        '    ldloc.0', '    ldloc.1', f'    callvirt instance object {IEN}::get_Current()', '    call string TkvReprAny::Any(object)', '    ' + _SB_APPEND, '    pop',
        '    ldloc.2', '    ldc.i4.1', '    add', '    stloc.2', '    br AN_LL',
        '  AN_LE:',
        '    ldloc.0', '    ldloc.s k', '    ' + _SB_APPEND, f'    callvirt instance string {OBJ}::ToString()', '    ret',
        '  AN_NENUM:',
        '    ldarg.0', f'    callvirt instance string {OBJ}::ToString()', '    ret',
        '  }',
    ]
    ctx.extra_classes.append([
        f'.class public auto ansi beforefieldinit TkvReprAny extends {OBJ}',
        '{',
    ] + lines + ['}'])


_REPR_ANY_MARK = 'TkvReprAny'
_REPRN_CLASS = 'TkvReprN'
_DS_INT = 'class [mscorlib]System.Collections.Generic.List`1<valuetype TkvInt>'


def _ensure_class_reprn(ctx: "Ctx"):
    """TkvReprN::Ds(List<TkvInt>) - str/repr(list[int]) -> "[-27, 3]" (2026-09-29).
    Danh sach so nguyen KHONG gioi han (vd list co phan tu am 'append(-27)') khong
    di qua DsI (List<int32>); truoc day str() cua no di nham sang TkvInt.Str -> InvalidCast."""
    emitted = ctx.emitted_types
    if emitted is None or _REPRN_CLASS in emitted:
        return
    emitted.add(_REPRN_CLASS)
    ctx.extra_classes.append([
        f'.class public auto ansi beforefieldinit {_REPRN_CLASS} extends [mscorlib]System.Object',
        '{',
        f'  .method public static string Ds({_DS_INT} ds) cil managed',
        '  {',
        '    .maxstack 8',
        f'    .locals init (class {_SB} sb, int32 i)',
        '    ldarg.0',
        '    brtrue TKVREPRN_CO',
        '    ldstr "None"',
        '    ret',
        '  TKVREPRN_CO:',
        '    ldstr "["',
        f'    newobj instance void {_SB}::.ctor(string)',
        '    stloc.0',
        '    ldc.i4.0',
        '    stloc.1',
        '  TKVREPRN_LAP:',
        '    ldloc.1',
        '    ldarg.0',
        f'    callvirt instance int32 {_DS_INT}::get_Count()',
        '    bge TKVREPRN_HET',
        '    ldloc.1',
        '    brfalse TKVREPRN_DAU',
        '    ldloc.0',
        '    ldstr ", "',
        '    ' + _SB_APPEND,
        '    pop',
        '  TKVREPRN_DAU:',
        '    ldloc.0',
        '    ldarg.0',
        '    ldloc.1',
        f'    callvirt instance !0 {_DS_INT}::get_Item(int32)',
        '    call string TkvInt::Str(valuetype TkvInt)',
        '    ' + _SB_APPEND,
        '    pop',
        '    ldloc.1',
        '    ldc.i4.1',
        '    add',
        '    stloc.1',
        '    br TKVREPRN_LAP',
        '  TKVREPRN_HET:',
        '    ldloc.0',
        '    ldstr "]"',
        '    ' + _SB_APPEND,
        '    callvirt instance string [mscorlib]System.Object::ToString()',
        '    ret',
        '  }',
        '}',
    ])


def compile_repr_builtin(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """repr(x) (2026-09-25): chuoi -> TkvRepr::Str (quy tac nhay/thoat cua
    Python, None -> None), khac -> str(x)."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: repr() chi nhan dung 1 tham so")
    arg = args[0]
    d = ctx.infer_dtype(arg, scope, ctx.func_table, ctx.records, ctx.record_methods, None)
    if ekind(arg) == 'var':
        # infer_dtype cua bien CONTAINER tra dtype PHAN TU ('list[str]' -> 'str')
        try:
            _ta_r = scope.tra(ea_str(arg)).ta
        except Exception:
            _ta_r = None
        if (_ta_r is not None and _ta_r.shape_ten == 'list' and _ta_r.dtype == 'str'
                and _ta_r.elem_ta is None):
            # repr(list[str]) (2026-09-28): "['a', 'b']" nhu Python
            _ensure_class_repr(ctx)
            ctx.load_var_ref(ea_str(arg), scope, out)
            out.append(f'    call string {_REPR_HELPER_CLASS}::Ds({_DS_STR})')
            return
        if _ta_r is not None and not _ta_r.la_vo_huong():
            d = None
    if d != 'str':
        compile_str_builtin(args, scope, out, dtype, ctx)
        return
    _ensure_class_repr(ctx)
    ctx.compile_expr(arg, scope, out, 'str', ctx)
    out.append(f'    call string {_REPR_HELPER_CLASS}::Str(string)')


def compile_chr_builtin(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """chr(n) (2026-09-26): ma Unicode -> chuoi 1 ky tu (ConvertFromUtf32 phu
    ca ngoai BMP nhu Python; ma ngoai [0, 0x10FFFF] nem loi luc chay)."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: chr() chi nhan dung 1 tham so")
    ctx.compile_expr(args[0], scope, out, 'i32', ctx)
    out.append('    call string [mscorlib]System.Char::ConvertFromUtf32(int32)')


def _ensure_class_ord(ctx: "Ctx"):
    """TkvOrd::Ord(string): 1 ky tu (ke ca cap surrogate) -> ma Unicode;
    do dai khac -> ArgumentException nhu TypeError cua Python (khong am
    tham lay ky tu dau)."""
    emitted = ctx.emitted_types
    if emitted is None or 'TkvOrd' in emitted:
        return
    emitted.add('TkvOrd')
    ctx.extra_classes.append([
        '.class public auto ansi beforefieldinit TkvOrd extends [mscorlib]System.Object',
        '{',
        '  .method public static int32 Ord(string s) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldarg.0',
        '    callvirt instance int32 [mscorlib]System.String::get_Length()',
        '    ldc.i4.1',
        '    bne.un TKVORD_HAI',
        '    ldarg.0',
        '    ldc.i4.0',
        '    callvirt instance char [mscorlib]System.String::get_Chars(int32)',
        '    ret',
        '  TKVORD_HAI:',
        '    ldarg.0',
        '    callvirt instance int32 [mscorlib]System.String::get_Length()',
        '    ldc.i4.2',
        '    bne.un TKVORD_LOI',
        '    ldarg.0',
        '    ldc.i4.0',
        '    call bool [mscorlib]System.Char::IsSurrogatePair(string, int32)',
        '    brfalse TKVORD_LOI',
        '    ldarg.0',
        '    ldc.i4.0',
        '    call int32 [mscorlib]System.Char::ConvertToUtf32(string, int32)',
        '    ret',
        '  TKVORD_LOI:',
        '    ldstr "ord() expected a character"',
        '    newobj instance void [mscorlib]System.ArgumentException::.ctor(string)',
        '    throw',
        '  }',
        '}',
    ])


def compile_ord_builtin(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """ord(c) (2026-09-26)."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: ord() chi nhan dung 1 tham so")
    _ensure_class_ord(ctx)
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    call int32 TkvOrd::Ord(string)')


def compile_bool_builtin(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """bool(x) (2026-09-25): chuoi rong/None -> False; so 0 -> False; tap/danh
    sach/tu dien rong hoac None -> False; match khong khop (null) -> False; con
    lai (record khac None) -> True."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: bool() chi nhan dung 1 tham so")
    arg = args[0]
    d = ctx.infer_dtype(arg, scope, ctx.func_table, ctx.records, ctx.record_methods, None)
    if d is None and ekind(arg) == 'num':
        d = 'f64' if '.' in ea_str(arg) else 'i32'
    ta = None
    if ekind(arg) == 'var':
        try:
            ta = scope.tra(ea_str(arg)).ta
        except Exception:
            ta = None
    if ta is not None and ta.shape_ten in ('list', 'dict', 'set'):
        kieu = ctx.il_type_str(ta, ctx.records)
        ctx.label_counter[0] += 1
        n = ctx.label_counter[0]
        rong = f'{ctx.prefix}_bool{n}_null'
        het = f'{ctx.prefix}_bool{n}_het'
        ctx.load_var_ref(ea_str(arg), scope, out)
        out.append('    dup')
        out.append(f'    brfalse {rong}')
        out.append(f'    callvirt instance int32 {kieu}::get_Count()')
        out.append('    ldc.i4.0')
        out.append('    cgt')
        out.append(f'    br {het}')
        out.append(f'  {rong}:')
        out.append('    pop')
        out.append('    ldc.i4.0')
        out.append(f'  {het}:')
        return
    if d in ('i32', 'bool'):
        ctx.compile_expr(arg, scope, out, 'i32', ctx)
        out.append('    ldc.i4.0')
        out.append('    cgt.un')
        return
    if d == 'i64':
        ctx.compile_expr(arg, scope, out, 'i64', ctx)
        out.append('    ldc.i8 0')
        out.append('    ceq')
        out.append('    ldc.i4.0')
        out.append('    ceq')
        return
    if d == 'int':
        # 'int' (TkvInt, so nguyen vo han chu so) - chuyen ve int64 roi lam nhu
        # i64. `ToI64()` nem khi gia tri khong vua int64 (that su lon hon),
        # con `bool(0)` binh thuong nen khong dinh loi.
        tkvint = _int_type.TKVINT_CLASS
        ctx.compile_expr(arg, scope, out, 'int', ctx)
        out.append(f'    call int64 {tkvint}::ToI64(valuetype {tkvint})')
        out.append('    ldc.i8 0')
        out.append('    ceq')
        out.append('    ldc.i4.0')
        out.append('    ceq')
        return
    if d == 'f64' or d == 'f32':
        ctx.compile_expr(arg, scope, out, d, ctx)
        out.append('    ldc.r8 0.0' if d == 'f64' else '    ldc.r4 0.0')
        out.append('    ceq')
        out.append('    ldc.i4.0')
        out.append('    ceq')
        return
    if d == 'str':
        ctx.compile_expr(arg, scope, out, 'str', ctx)
        out.append('    call bool [mscorlib]System.String::IsNullOrEmpty(string)')
        out.append('    ldc.i4.0')
        out.append('    ceq')
        return
    if d == 'match' or (d is not None and ctx.records and d in ctx.records):
        ctx.compile_expr(arg, scope, out, d, ctx)
        out.append('    ldnull')
        out.append('    cgt.un')
        return
    raise SyntaxError(f"il_codegen: bool() chua ho tro doi so kieu {d!r} - gan ra 1 bien truoc")


def compile_format_builtin(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """`format(value, spec)` (alias Python) - 1 tham so = `str(value)`, 2 tham so = `fmt_spec`."""
    if len(args) == 1:
        compile_str_builtin(args, scope, out, dtype, ctx)
        return
    if len(args) == 2:
        compile_fmt_spec(args, scope, out, dtype, ctx)
        return
    raise SyntaxError("il_codegen: format(x, spec) nhan 1 hoac 2 tham so")


def bootstrap_string_builtin(reg: "Registry"):
    # P6 chang 1c: truoc day la LENH CAP MODULE (xem ghi chu tren).
    reg.expr_builtin_temps['str'] = _temps_str_builtin
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_expr_builtin(reg, 'str', compile_str_builtin, 'str')
    register_expr_builtin(reg, 'repr', compile_repr_builtin, 'str')
    register_expr_builtin(reg, 'chr', compile_chr_builtin, 'str')
    register_expr_builtin(reg, 'ord', compile_ord_builtin, 'i32')
    register_expr_builtin(reg, 'bool', compile_bool_builtin, 'i32')
    register_expr_builtin(reg, 'fmt_float', compile_fmt_float, 'str')
    register_expr_builtin(reg, 'fmt_spec', compile_fmt_spec, 'str')
    # Alias hinh thi `format(value, spec)` cua Python, nhat quan voi `fmt_spec`.
    register_expr_builtin(reg, 'format', compile_format_builtin, 'str')
    register_expr_builtin(reg, 'hex', compile_hex_builtin, 'str')
    register_expr_builtin(reg, 'bin', compile_bin_builtin, 'str')
    register_expr_builtin(reg, 'oct', compile_oct_builtin, 'str')
