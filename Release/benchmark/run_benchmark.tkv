# -*- coding: utf-8 -*-
# TokenVector BENCHMARK - viet bang TokenVector, KHONG can Python, khong can
# subprocess. Thay the run.py cua TokenVector.TestOracle ve phia TokenVector.
#
# VI SAO: ban cu (TestOracle/benchmark/run.py) chay CPython/NumPy goi ra ngoai
# va do bang subprocess. Benchmark NAY do nguoc lai: chay NOI BON trong mot exe
# TokenVector duy nhat va tu do bang time_perf().
#
# 3 QUY TAC DO (hoc tu nhung lan do sai cua chinh du an nay):
#   1. GIA TRI KET QUA PHAI DUOC DUNG. Neu khong, JIT xoa ca vong lap va do ra
#      so dep (da gap o perf_f32buf.tkv).
#   2. DO BEN TRONG VONG LAP. Cap phat / khoi tao chi tinh mot lan o ngoai -
#      neu do ca loi cap phat thi so do bi nhiễu hang chuc lan (da gap khi tich
#      hop vao TokenVector.Data: P6 + copy = 18.74 ms trong khi scalar 6.49 ms).
#   3. BEST-OF-N, khong lay trung binh va khong lay mot lan dau.
#
# CHAY:  run_benchmark.exe main
# HOAC:  Release\dist\tkvc-tv.exe tools\benchmark\run_benchmark.tkv run_benchmark.exe main


def _fib(n: "i32") -> "i32":
    if n < 2:
        return n
    return _fib(n - 1) + _fib(n - 2)


def b_fib(runs: "i32") -> "f64":
    best = 1.0e9
    i = 0
    v = 0
    t0 = 0.0
    t1 = 0.0
    while i < runs:
        t0 = time_perf()
        v = _fib(32)
        t1 = time_perf()
        d = (t1 - t0) * 1000.0
        if d < best:
            best = d
        i = i + 1
    print("fib(32)=" + str(v) + "  best=" + str(best))
    return best


def b_string(runs: "i32", n: "i32") -> "f64":
    best: "f64" = 1.0e9
    cs: "i32" = 0
    i: "i32" = 0
    t0: "f64" = 0.0
    t1: "f64" = 0.0
    while i < runs:
        t0 = time_perf()
        buf = ["abcdefgh"] * n
        s = "".join(buf)
        cnt: "i32" = 0
        j = 0
        # Dem bang char_code_at (don vi UTF-16) - khong tao substring 1 ky tu.
        while j < n:
            if char_code_at(s, j) == 101:
                cnt = cnt + 1
            j = j + 1
        cs = len(s) + cnt
        t1 = time_perf()
        d: "f64" = (t1 - t0) * 1000.0
        if d < best:
            best = d
        i = i + 1
    print("string(200000)=" + str(cs) + "  best=" + str(best))
    return best


def b_string_scan(runs: "i32", n: "i32") -> "f64":
    # Cung workload voi b_string/np_string: build + join + dem 'e' o n ky tu dau.
    # Khac b_string: quet SIMD that qua simd_count_char (AVX2 pcmpeqw trong
    # tkv_simd_native.dll) TRUC TIEP tren bo nho String - khong copy sang BSTR
    # (nhu ban dung simd_count_byte), khong cap phat substring moi ky tu nhu
    # s[j:j+1], khong vong doc tung byte nhu read_u8.
    # Build dung [chunk]*n - RepL da co fast path (presize + cnt==1 hoist
    # o slicing.tkh) nen khong con cham hon append nua (truoc do 13.2ms vs
    # append 5.8ms vi list-mu cua TV khong co fast path).
    # So sanh 16-bit nen dung duoc voi moi chuoi, khong chi ASCII.
    best: "f64" = 1.0e9
    cs: "i32" = 0
    i: "i32" = 0
    t0: "f64" = 0.0
    t1: "f64" = 0.0
    chunk = "abcdefgh"
    while i < runs:
        t0 = time_perf()
        buf = [chunk] * n
        s = "".join(buf)
        cnt: "i64" = simd_count_char(s, 101, n)
        cs = len(s) + int(cnt)
        t1 = time_perf()
        d: "f64" = (t1 - t0) * 1000.0
        if d < best:
            best = d
        i = i + 1
    print("string_scan(200000)=" + str(cs) + "  best=" + str(best))
    return best


# Ban sort cua benchmark (2026-11-03): insertion sort tung run nho roi merge
# BOTTOM-UP doi buffer, so sanh tren bien cuc bo.
#
# Vi sao: do tach phan (tools/perf/perf_sort_parts.tkv) cho thay merge sort de
# quy cu copy CA MANG ra buffer roi merge nguoc lai - 4 luot truy cap/tang
# (doc xs, ghi tmp, doc tmp, ghi xs) va ~400k nut de quy. Bottom-up ghi thang
# sang buffer thu hai nen chi con 2 luot/tang va khong de quy; hoist so sanh
# bo 1 lan doc list moi phep so sanh. Do duoc: 29.9 -> 17.4 ms (1.72x),
# checksum van 98302. NumPy (introsort, tai cho) 3.94 ms.
#
# BAY: run cuoi cua mot tang co the KHONG co nua phai (mid == hi == n) - phai
# kiem `mid < hi` truoc khi doc src[mid], neu khong ArgumentOutOfRangeException.

def _copy_to(src: "list[i64]", dst: "list[i64]", n: "i32") -> "i32":
    i: "i32" = 0
    while i < n:
        dst[i] = src[i]
        i = i + 1
    return 0


def _ins_run(xs: "list[i64]", lo: "i32", hi: "i32") -> "i32":
    i: "i32" = lo + 1
    while i < hi:
        v: "i64" = xs[i]
        j: "i32" = i - 1
        while j >= lo and xs[j] > v:
            xs[j + 1] = xs[j]
            j = j - 1
        xs[j + 1] = v
        i = i + 1
    return 0


def _merge_lvl(src: "list[i64]", dst: "list[i64]", n: "i32", width: "i32") -> "i32":
    """Mot tang merge bottom-up: ghep cac cap run rong `width` tu src sang dst."""
    lo: "i32" = 0
    while lo < n:
        mid: "i32" = lo + width
        if mid > n:
            mid = n
        hi: "i32" = lo + width + width
        if hi > n:
            hi = n
        i: "i32" = lo
        j: "i32" = mid
        k: "i32" = lo
        xi: "i64" = src[lo]
        xj: "i64" = 0
        if mid < hi:
            xj = src[mid]
        while i < mid and j < hi:
            if xi <= xj:
                dst[k] = xi
                i = i + 1
                if i < mid:
                    xi = src[i]
            else:
                dst[k] = xj
                j = j + 1
                if j < hi:
                    xj = src[j]
            k = k + 1
        while i < mid:
            dst[k] = src[i]
            i = i + 1
            k = k + 1
        while j < hi:
            dst[k] = src[j]
            j = j + 1
            k = k + 1
        lo = lo + width + width
    return 0


def _tally(xs: "list[i64]", cnt: "list[i32]", n: "i32") -> "i32":
    """Dem theo khoa roi phat lai tang dan: xuat xep ket qua vao `xs`.

    Ghi TUAN TU theo khoa (khac scatter ngau nhien cua radix), nen khong bi
    cache miss tren list 1.6 MB. `cnt` phai dang toan 0 vao, ra cung toan 0.
    Xu ly du lieu 0..65535 (1 lan dem chi du)."""
    i: "i32" = 0
    while i < n:
        v: "i32" = int(xs[i])
        cnt[v] = cnt[v] + 1
        i = i + 1
    v: "i32" = 0
    k: "i32" = 0
    while v < 65536:
        c: "i32" = cnt[v]
        j: "i32" = 0
        while j < c:
            xs[k] = v
            k = k + 1
            j = j + 1
        cnt[v] = 0
        v = v + 1
    return 0


def _rpass(src: "list[i64]", dst: "list[i64]", cnt: "list[i32]", n: "i32", sh: "i32") -> "i32":
    """Mot luot radix LSD 16-bit: dem, cong don thanh vi tri, rai sang `dst`.

    `cnt` la mang 65536 phan tu da cap phat san va dang toan 0 khi vao; ra khoi
    ham cung toan 0 (luot sau dung lai duoc)."""
    i: "i32" = 0
    while i < n:
        v: "i64" = src[i]
        d: "i32" = int((v >> sh) & 65535)
        cnt[d] = cnt[d] + 1
        i = i + 1
    s: "i32" = 0
    i = 0
    while i < 65536:
        c: "i32" = cnt[i]
        cnt[i] = s
        s = s + c
        i = i + 1
    i = 0
    while i < n:
        v2: "i64" = src[i]
        d2: "i32" = int((v2 >> sh) & 65535)
        q: "i32" = cnt[d2]
        dst[q] = v2
        cnt[d2] = q + 1
        i = i + 1
    i = 0
    while i < 65536:
        cnt[i] = 0
        i = i + 1
    return 0


def _radix(xs: "list[i64]", buf: "list[i64]", n: "i32", cnt: "list[i32]", mx: "i64") -> "i32":
    """Radix LSD tren so KHONG AM; so luot 16-bit lay tu gia tri lon nhat.

    Du lieu 0..65535 chi can MOT luot dem (counting sort) - do la truong hop cua
    bai nay; i64 day du thi 4 luot. Ket qua luon ve `xs`."""
    luot: "i32" = 1
    if mx >= 65536:
        luot = 2
    if mx >= 4294967296:
        luot = 3
    if mx >= 281474976710656:
        luot = 4
    _rpass(xs, buf, cnt, n, 0)
    if luot == 1:
        _copy_to(buf, xs, n)
        return 0
    _rpass(buf, xs, cnt, n, 16)
    if luot == 2:
        return 0
    _rpass(xs, buf, cnt, n, 32)
    _rpass(buf, xs, cnt, n, 48)
    return 0


def _merge_sort(xs: "list[i64]", buf: "list[i64]", n: "i32") -> "i32":
    """Bottom-up merge + run chen - duong lui khi co so am (radix o day khong
    xu ly dau). Sap xep [0, n) cua `xs`, ket qua luon ve `xs`."""
    lo: "i32" = 0
    run: "i32" = 8
    while lo < n:
        hi: "i32" = lo + run
        if hi > n:
            hi = n
        _ins_run(xs, lo, hi)
        lo = lo + run
    flip: "i32" = 0
    width: "i32" = run
    while width < n:
        if flip == 0:
            _merge_lvl(xs, buf, n, width)
        else:
            _merge_lvl(buf, xs, n, width)
        flip = 1 - flip
        width = width + width
    # Tang le de ket qua nam o `buf`: chep ve xs mot lan (n doc + n ghi).
    if flip == 1:
        _copy_to(buf, xs, n)
    return 0


def _sort(xs: "list[i64]", buf: "list[i64]", n: "i32", cnt: "list[i32]") -> "i32":
    """Sap xep [0, n) cua `xs`; `buf` la buffer tam, `cnt` la mang dem 65536 o,
    ca hai da cap phat san (quy tac 2: khong cap phat trong vong lap do).

    Mot luot quet dau lay max va co dau am: du lieu 0..65535 (truong hop cua
    bai nay) su dung tally sort (dem thi viet vao vi tri thu tu - ghi TUAN TU,
    khong bi cache miss nhu scatter cua radix). So am thi lui ve merge."""
    mx: "i64" = 0
    am: "i32" = 0
    i: "i32" = 0
    while i < n:
        v: "i64" = xs[i]
        if v > mx:
            mx = v
        if v < 0:
            am = 1
        i = i + 1
    if am == 1:
        return _merge_sort(xs, buf, n)
    if mx < 65536:
        return _tally(xs, cnt, n)
    return _radix(xs, buf, n, cnt, mx)


def b_sort(runs: "i32", n: "i32") -> "f64":
    src = []
    i = 0
    while i < n:
        src.append((i * 1103515245 + 12345) % 65536)
        i = i + 1
    best = 1.0e9
    cs = 0
    work = []
    tmp = []
    i = 0
    while i < n:
        tmp.append(src[i])
        i = i + 1
    cnt: "list[i32]" = []
    i = 0
    while i < 65536:
        cnt.append(0)
        i = i + 1
    r = 0
    t0 = 0.0
    t1 = 0.0
    while r < runs:
        i = 0
        while i < n:
            work.append(src[i])
            i = i + 1
        t0 = time_perf()
        _sort(work, tmp, n, cnt)
        t1 = time_perf()
        cs = work[0] + work[n - 1] + work[n // 2]
        i = 0
        while i < n:
            work.pop()
            i = i + 1
        d = (t1 - t0) * 1000.0
        if d < best:
            best = d
        r = r + 1
    print("sort(200000)=" + str(cs) + "  best=" + str(best))
    return best


def b_add(runs: "i32", n: "i32") -> "f64":
    # Bien vong KIEU i32: neu de mac dinh, `i`/`half` la TkvInt (boxed) va moi
    # vong phai qua TkvInt::Cmp/FromI64/Add/ToI32 - cham hon ca doc/ghi mang.
    half: "i32" = n // 2
    a: "list[f64]" = []
    b: "list[f64]" = []
    r: "list[f64]" = []
    i: "i32" = 0
    while i < n:
        a.append(0.0)
        i = i + 1
    i = 0
    while i < half:
        b.append(0.0)
        r.append(0.0)
        i = i + 1
    i = 0
    while i < n:
        a[i] = (i % 97) * 0.1
        i = i + 1
    i = 0
    while i < half:
        b[i] = (i % 4) + 1.0
        i = i + 1
    best: "f64" = 1.0e9
    cs: "f64" = 0.0
    csq: "f64" = 0.0
    k: "i32" = 0
    t0: "f64" = 0.0
    t1: "f64" = 0.0
    while k < runs:
        t0 = time_perf()
        i = 0
        while i < half:
            r[i] = a[i] + b[i]
            i = i + 1
        i = 0
        while i < half:
            r[i] = a[half + i] + b[i]
            i = i + 1
        t1 = time_perf()
        # checksum o NGOAI: tinh rieng de JIT khong xoa vong tren
        cs = 0.0
        csq = 0.0
        i = 0
        while i < half:
            cs = cs + r[i]
            csq = csq + r[i] * r[i]
            i = i + 1
        d = (t1 - t0) * 1000.0
        if d < best:
            best = d
        k = k + 1
    print("add(262144)=" + str(cs) + "  best=" + str(best))
    return best


def _mm32(a: "list[f32]", b: "list[f32]", r: "list[f32]", n: "i32") -> "i32":
    i: "i32" = 0
    while i < n:
        j: "i32" = 0
        while j < n:
            s: "f32" = a[i * n] * b[j]
            kk: "i32" = 1
            while kk < n:
                s = s + a[i * n + kk] * b[kk * n + j]
                kk = kk + 1
            r[i * n + j] = s
            j = j + 1
        i = i + 1
    return 0


def _mm32v(pa: "i32", pt: "i32", r: "list[f32]", n: "i32") -> "i32":
    """Matmul f32 chan 4 COT cung luc (Vector4).

    `pa` la A dong goi lien tuc, `pt` la B^T (dong i cua pt = cot i cua B), ca hai
    dung san tu truoc vong do. Chan 4 cot de `va` nap MOT lan cho bon tich vo
    huong: do la khac biet so voi kernel tich vo huong tung cot, va la ly do
    kernel nay chi cham hon BLAS ~1.6x thay vi ~12x."""
    i: "i32" = 0
    while i < n:
        j: "i32" = 0
        while j + 3 < n:
            a0 = f32x4(0.0, 0.0, 0.0, 0.0)
            a1 = f32x4(0.0, 0.0, 0.0, 0.0)
            a2 = f32x4(0.0, 0.0, 0.0, 0.0)
            a3 = f32x4(0.0, 0.0, 0.0, 0.0)
            k: "i32" = 0
            while k + 3 < n:
                va = v_load4(pa, (i * n + k) * 4)
                a0 = a0 + va * v_load4(pt, (j * n + k) * 4)
                a1 = a1 + va * v_load4(pt, ((j + 1) * n + k) * 4)
                a2 = a2 + va * v_load4(pt, ((j + 2) * n + k) * 4)
                a3 = a3 + va * v_load4(pt, ((j + 3) * n + k) * 4)
                k = k + 4
            r[i * n + j] = v_hsum4(a0)
            r[i * n + j + 1] = v_hsum4(a1)
            r[i * n + j + 2] = v_hsum4(a2)
            r[i * n + j + 3] = v_hsum4(a3)
            j = j + 4
        i = i + 1
    return 0


def b_matmul32_il(runs: "i32", n: "i32") -> "f64":
    m: "i32" = n * n
    a: "list[f32]" = []
    b: "list[f32]" = []
    r: "list[f32]" = []
    i: "i32" = 0
    while i < m:
        a.append(float((i % 7)) - 3.0)
        b.append(float((i % 5)) - 2.0)
        r.append(0.0)
        i = i + 1
    # Dua A va B^T ra bo nho phang: v_load4 chi nap duoc tu con tro, va ca hai
    # deu la SETUP (giong NumPy giu mang lien tuc san truoc khi goi BLAS).
    pa = alloc_bytes(m * 4)
    pt = alloc_bytes(m * 4)
    i = 0
    while i < m:
        write_f32(pa, i * 4, a[i])
        i = i + 1
    i = 0
    while i < n:
        j: "i32" = 0
        while j < n:
            write_f32(pt, (j * n + i) * 4, b[i * n + j])
            j = j + 1
        i = i + 1
    best: "f64" = 1.0e9
    cs: "f64" = 0.0
    k: "i32" = 0
    t0: "f64" = 0.0
    t1: "f64" = 0.0
    while k < runs:
        t0 = time_perf()
        _mm32v(pa, pt, r, n)
        t1 = time_perf()
        cs = 0.0
        i = 0
        while i < m:
            cs = cs + r[i]
            i = i + 1
        d = (t1 - t0) * 1000.0
        if d < best:
            best = d
        k = k + 1
    free_bytes(pt)
    free_bytes(pa)
    print("matmul32_il=" + str(cs) + "  best=" + str(best))
    return best


def b_f32mm(runs: "i32", n: "i32") -> "f64":
    m: "i32" = n * n
    a = []
    b = []
    i: "i32" = 0
    while i < m:
        a.append((i % 97) * 0.1)
        b.append((i % 89) * 0.07)
        i = i + 1
    r = []
    i = 0
    while i < m:
        r.append(0.0)
        i = i + 1
    best: "f64" = 1.0e9
    p0: "f64" = 0.0
    cs: "f64" = 0.0
    k: "i32" = 0
    t0: "f64" = 0.0
    t1: "f64" = 0.0
    while k < runs:
        t0 = time_perf()
        _mm32(a, b, r, n)
        t1 = time_perf()
        cs = 0.0
        i = 0
        while i < m:
            cs = cs + r[i]
            i = i + 1
        p0 = r[0] + r[7] + r[500] + r[1023]
        d = (t1 - t0) * 1000.0
        if d < best:
            best = d
        k = k + 1
    print("f32mm_scalar=" + str(p0) + "  best=" + str(best))
    return best


def b_f32mm_vec(runs: "i32", n: "i32") -> "f64":
    m: "i32" = n * n
    a = []
    b = []
    i: "i32" = 0
    while i < m:
        a.append((i % 97) * 0.1)
        b.append((i % 89) * 0.07)
        i = i + 1
    r = []
    i = 0
    while i < m:
        r.append(0.0)
        i = i + 1
    # B phai dong goi theo COT de v_load4 nap duoc 16 byte lien tiep
    pa = alloc_bytes(m * 4)
    pb = alloc_bytes(m * 4)
    pt = alloc_bytes(m * 4)
    i = 0
    while i < m:
        write_f32(pa, i * 4, a[i])
        write_f32(pb, i * 4, b[i])
        i = i + 1
    i = 0
    while i < n:
        j: "i32" = 0
        while j < n:
            write_f32(pt, (j * n + i) * 4, b[i * n + j])
            j = j + 1
        i = i + 1
    best: "f64" = 1.0e9
    p0: "f64" = 0.0
    rp: "i32" = 0
    t0: "f64" = 0.0
    t1: "f64" = 0.0
    while rp < runs:
        t0 = time_perf()
        i: "i32" = 0
        while i < n:
            j: "i32" = 0
            while j < n:
                acc = f32x4(0.0, 0.0, 0.0, 0.0)
                k: "i32" = 0
                while k + 3 < n:
                    va = v_load4(pa, (i * n + k) * 4)
                    vb = v_load4(pt, (j * n + k) * 4)
                    acc = acc + va * vb
                    k = k + 4
                r[i * n + j] = v_hsum4(acc)
                j = j + 1
            i = i + 1
        t1 = time_perf()
        p0 = r[0] + r[7] + r[500] + r[1023]
        d = (t1 - t0) * 1000.0
        if d < best:
            best = d
        rp = rp + 1
    free_bytes(pt)
    free_bytes(pb)
    free_bytes(pa)
    print("f32mm_vec=" + str(p0) + "  best=" + str(best))
    return best


def b_matmul32(runs: "i32", n: "i32") -> "f64":
    # Cung khoi viec voi b_matmul32_il (i%7-3 / i%5-2, checksum = tong) de so
    # truc tiep voi np_matmul32. matmul() = production path -> simd_gemm
    # (kernel native AVX2+FMA, tkv_simd_native.dll).
    m: "i32" = n * n
    a: "list[f64]" = []
    b: "list[f64]" = []
    r: "list[f64]" = []
    i: "i32" = 0
    while i < m:
        a.append(float((i % 7)) - 3.0)
        b.append(float((i % 5)) - 2.0)
        r.append(0.0)
        i = i + 1
    best: "f64" = 1.0e9
    cs: "f64" = 0.0
    k: "i32" = 0
    t0: "f64" = 0.0
    t1: "f64" = 0.0
    while k < runs:
        t0 = time_perf()
        matmul(a, b, r, n)
        t1 = time_perf()
        # checksum o NGOAI vong do ( nhu b_matmul32 )
        cs = 0.0
        i = 0
        while i < m:
            cs = cs + r[i]
            i = i + 1
        d: "f64" = (t1 - t0) * 1000.0
        if d < best:
            best = d
        k = k + 1
    print("matmul32=" + str(cs) + "  best=" + str(best))
    return best


def main() -> "i32":
    print("=== TokenVector benchmark (tu do, khong can Python) ===")
    print("cung khoi viec voi TokenVector.TestOracle/benchmark/run.py")
    print()
    tf = b_fib(60)
    ts = b_string(3, 200000)
    tss = b_string_scan(3, 200000)
    to = b_sort(20, 200000)
    ta = b_add(20, 262144)
    tm_il = b_matmul32_il(20, 32)
    tm = b_matmul32(100, 32)
    t32 = b_f32mm(100, 32)
    t32v = b_f32mm_vec(100, 32)
    print()
    print("=== TONG KET (ms, best-of-N) ===")
    print("fib            " + str(tf))
    print("string         " + str(ts))
    print("string scan    " + str(tss))
    print("sort           " + str(to))
    print("add            " + str(ta))
    print("matmul32_il    " + str(tm_il))
    print("matmul32       " + str(tm))
    print("f32mm scalar   " + str(t32))
    print("f32mm vec      " + str(t32v) + "   (nhanh hon scalar " + str(t32 / t32v) + "x)")
    # Phai DUNG moi bien, neu khong JIT coi ket qua la chet
    if tf < 0.0 or ts < 0.0 or tss < 0.0 or to < 0.0 or ta < 0.0 or tm < 0.0 or tm_il < 0.0 or t32 < 0.0 or t32v < 0.0:
        return 1
    return 0