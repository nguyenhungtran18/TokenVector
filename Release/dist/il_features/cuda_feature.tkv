# -*- coding: utf-8 -*-
"""PROTOTYPE: CUDA kernel backend cho TokenVector (2026-11-21).

Cho phep viet kernel CUDA ngay trong file .tkv:

    # @tkv.cuda_kernel grid="(n + 255) // 256" block="256"
    def vec_add(a: "ptr[f32]", b: "ptr[f32]", c: "ptr[f32]", n: "i32") -> "void":
        i = tid()
        if i < n:
            c[i] = a[i] + b[i]

Luong bien dich:
  1. cuda_rewrite_source() (goi tu extract_program_file) quet marker, sinh
     <stem>.cuda.cu + wrapper, thay kernel bang __tkv_extern_pinvoke__.
  2. neu dat TKV_CUDA_NVCC thi goi nvcc qua proc_ra() de ra .so.
  3. phan con lai di vao pipeline binh thuong (pragma P/Invoke co san).

GIOI HAN CO Y: chi 1 cap if, bieu thuc dang C (khong goi ham Python),
khong struct/callback; day la bang chung kha thi cua backend, khong phai
san pham. Khong co marker -> ham tra nguyen chuoi, khong doi gi ca.
"""

CUDA_MARK = '# @tkv.cuda_kernel'


def _cuda_c_type(ann: "str") -> "str":
    """'ptr[f32]' -> 'float*' ; 'i32' -> 'int'."""
    if ann.startswith('ptr['):
        base = ann[4:len(ann) - 1]
        star = '*'
    else:
        base = ann
        star = ''
    if base == 'f32':
        return 'float' + star
    if base == 'f64':
        return 'double' + star
    if base == 'i32':
        return 'int' + star
    if base == 'i64':
        return 'long long' + star
    return base + star


def _cuda_is_ptr(ann: "str") -> "i32":
    if ann.startswith('ptr['):
        return 1
    return 0


def _cuda_expr(e: "str") -> "str":
    """Dich bieu thuc dang Python sang C (cac phep toan so hoc giong nhau)."""
    e = e.replace('tid()', '(blockIdx.x * blockDim.x + threadIdx.x)')
    e = e.replace('bid()', 'blockIdx.x')
    e = e.replace('bdim()', 'blockDim.x')
    e = e.replace('//', '/')
    e = e.replace('sqrt(', 'sqrtf(')
    e = e.replace('erf(', 'erff(')
    e = e.replace('exp(', 'expf(')
    return e


def _cuda_params(header: "str") -> "list[(str,str)]":
    out = []
    parts = header.split(',')
    for p in parts:
        p = p.strip()
        if p == '':
            continue
        k = p.find(':')
        if k < 0:
            continue
        ten = p[:k].strip()
        ann = p[k + 1:].strip()
        ann = ann.replace('"', '').replace("'", '')
        out.append((ten, ann))
    return out


def _cuda_body_c(body: "list[str]", params: "list[(str,str)]") -> "str":
    """Sinh thân kernel C tu thân ham Python (ho tro cac cap if long nhau)."""
    lines = []
    declared = []
    depth = 0
    for ln in body:
        st = ln.strip()
        if st == '':
            continue
        ind = len(ln) - len(ln.lstrip(' '))
        level = ind // 4          # 1 = than ham, 2 = ben trong if, ...
        while depth > level - 1:
            depth = depth - 1
            lines.append('  ' * depth + '}')
        if st.endswith(':'):
            cond = st[:len(st) - 1].strip()
            if cond.startswith('if '):
                cond = cond[3:]
            lines.append('  ' * (level - 1) + 'if (' + _cuda_expr(cond) + ') {')
            depth = level
        else:
            # khai bien cuc bo lan dau gan (vd `i = tid()` -> `int i = ...`)
            if '=' in st and '[' not in st.split('=')[0]:
                left = st.split('=')[0].strip()
                if left not in declared and left not in ('',):
                    rhs = st.split('=', 1)[1]
                    is_int = ('tid()' in rhs or 'bid()' in rhs or 'bdim()' in rhs
                              or '%' in rhs or '/' in rhs)
                    k = 0
                    while k < len(params):
                        nm = params[k][0]
                        if nm + '[' in rhs and 'i32' in params[k][1]:
                            is_int = 1
                        k = k + 1
                    k = 0
                    while k < len(declared):
                        if declared[k] + '[' in rhs:
                            is_int = 1
                        k = k + 1
                    ctype = 'int' if is_int else 'float'
                    declared.append(left)
                    st = ctype + ' ' + st
            lines.append('  ' * (level - 1) + _cuda_expr(st) + ';')
    while depth > 0:
        depth = depth - 1
        lines.append('  ' * depth + '}')
    return '\n'.join(lines) + '\n'


def _cuda_kernel_c(name: "str", params: "list[(str,str)]", body: "list[str]") -> "str":
    decls = []
    args = []
    for pn, ann in params:
        if _cuda_is_ptr(ann) == 1:
            decls.append(_cuda_c_type(ann) + ' __restrict__ ' + pn)
        else:
            decls.append(_cuda_c_type(ann) + ' ' + pn)
        args.append(pn)
    s = 'extern "C" __global__ void tkv_kernel_' + name + '(' + ', '.join(decls) + ') {\n'
    s = s + _cuda_body_c(body, params)
    s = s + '}\n\n'
    s = s + 'extern "C" int tkv_launch_' + name + '(' + ', '.join(decls) + ', int grid, int block) {\n'
    s = s + '  tkv_kernel_' + name + '<<<grid, block>>>(' + ', '.join(args) + ');\n'
    s = s + '  cudaError_t launch_err = cudaGetLastError();\n'
    s = s + '  cudaDeviceSynchronize();\n'
    s = s + '  cudaError_t sync_err = cudaGetLastError();\n'
    s = s + '  return (int)(launch_err != cudaSuccess ? launch_err : sync_err);\n'
    s = s + '}\n'
    return s


def _cuda_pragma(name: "str", params: "list[(str,str)]", so: "str") -> "str":
    ts = []
    for pn, ann in params:
        if _cuda_is_ptr(ann) == 1:
            ts.append('"i64"')
        elif ann == 'f32':
            ts.append('"f32"')
        elif ann == 'f64':
            ts.append('"f64"')
        elif ann == 'i64':
            ts.append('"i64"')
        else:
            ts.append('"i32"')
    ts.append('"i32"')
    ts.append('"i32"')
    sym = 'tkv_launch_' + name
    return ('    {"name": "' + sym + '", "dll": "' + so + '", "symbol": "' + sym + '",\n'
            '     "convention": "cdecl", "params": [' + ', '.join(ts) + '], "returns": "i32"},')


def _cuda_wrapper(name: "str", params: "list[(str,str)]") -> "str":
    sig = []
    args = []
    for pn, ann in params:
        if _cuda_is_ptr(ann) == 1:
            t = 'i64'
        else:
            t = ann
        sig.append(pn + ': "' + t + '"')
        args.append(pn)
    sig.append('grid: "i32"')
    sig.append('block: "i32"')
    args.append('grid')
    args.append('block')
    return ('def ' + name + '_launch(' + ', '.join(sig) + ') -> "i32":\n'
            '    return tkv_launch_' + name + '(' + ', '.join(args) + ')\n')


def cuda_rewrite_source(src: "str", path: "str") -> "str":
    """Di tim cackernel duoc danh dau, sinh .cu + glue, tra source moi."""
    lines = src.splitlines()
    if not any(ln.startswith(CUDA_MARK) for ln in lines):
        return src
    dirp = path_dirname(path)
    stem = path_stem(path)
    cu_path = dirp + '/' + stem + '.cuda.cu'
    sh_path = dirp + '/' + stem + '.cuda.build.sh'
    # Validator pragma yeu cau ten ket thuc '.dll'. Tren Linux day van la
    # ELF shared object (nvcc -shared), chi dat ten .dll de P/Invoke tim thay.
    so = stem + '_cuda.dll'
    out = []
    pragmas = []
    wrappers = []
    cu_parts = ['#include <cuda_runtime.h>\n']
    i = 0
    while i < len(lines):
        ln = lines[i]
        if ln.startswith(CUDA_MARK):
            j = i + 1
            while j < len(lines) and not lines[j].lstrip().startswith('def '):
                j = j + 1
            if j >= len(lines):
                raise TranspileError('CUDA kernel: thieu dinh nghia def sau marker')
            head = lines[j].strip()
            a = head.find('(')
            b = head.find(')')
            if a < 0 or b < 0:
                raise TranspileError('CUDA kernel: dong def khong hop le: ' + head)
            name = head[4:a].strip()
            params = _cuda_params(head[a + 1:b])
            k = j + 1
            body = []
            while k < len(lines) and (lines[k].strip() == '' or lines[k].startswith('    ')):
                body.append(lines[k])
                k = k + 1
            cu_parts.append(_cuda_kernel_c(name, params, body))
            pragmas.append(_cuda_pragma(name, params, so))
            wrappers.append(_cuda_wrapper(name, params))
            i = k
        else:
            out.append(ln)
            i = i + 1
    if len(pragmas) == 0:
        return src
    cu = '\n'.join(cu_parts)
    path_write_text(cu_path, cu)
    sh = ('#!/bin/sh\nset -e\nnvcc -O2 -shared -std=c++20 --expt-relaxed-constexpr -x cu '
          '-Xcompiler -std=c++20 -Xcompiler -fPIC ' + cu_path + ' -o ' + so + ' -lcudart\n')
    path_write_text(sh_path, sh)
    nvcc = os_getenv('TKV_CUDA_NVCC')
    if nvcc is not None and nvcc != '':
        rc = proc_ra(nvcc, '-O2 -shared -std=c++20 --expt-relaxed-constexpr -x cu ' + cu_path +
                     ' -o ' + so + ' -lcudart', dirp + '/' + stem + '.cuda.build.log')
        if rc != 0:
            raise TranspileError('nvcc that bai (xem ' + dirp + '/' + stem + '.cuda.build.log)')
    pragma = ('__tkv_extern_pinvoke__ = [\n' + '\n'.join(pragmas) + '\n]\n\n')
    glue = '\n'.join(wrappers) + '\n'
    res = pragma + glue + '\n'.join(out)
    return res
