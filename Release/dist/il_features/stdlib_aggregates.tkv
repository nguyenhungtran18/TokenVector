# -*- coding: utf-8 -*-
"""min(a,b)/max(a,b) (2 tham so vo huong) + sum/min/max/sorted/any/all
(1 tham so: list HOAC set) - Wave 3 quick-win (2026-07-29), nang cap
2026-08-03.

min(a,b)/max(a,b): macro TEXT-LEVEL (giong for_in_list/for_enumerate) -
viet lai THANH 1 ternary co san ('a < b ? a : b') NGAY TAI VI TRI xuat
hien trong dong (khong chi toan dong nhu cac macro khac - giong f-string's
subn), nen dung duoc o BAT KY vi tri bieu thuc nao (vd 'clip = min(max(x,
lo), hi)'). Quet ngoac CAN BANG THU CONG (tu viet _find_balanced_call,
khong regex thuan) de tach dung 2 tham so ke ca khi long nhau bieu thuc
phuc tap - CHAP NHAN nhan ban VAN BAN cua a/b vi bieu thuc trong DSL nay
KHONG co tac dung phu.

sum/min/max/sorted/any/all (1 tham so): TU 2026-08-03 dang ky qua
register_expr_builtin nen goi duoc o MOI vi tri bieu thuc ('return
sum(xs) + 1', 'if max(xs) > 10:', 'f(sorted(xs))') - truoc do CHI o RHS 1
phep gan don le. Duong ASSIGN_RHS_PARSERS/FIRST_PASS_WALK/STMT_CODEGEN cu
da BO HAN (cung nguyen tac voi Giai doan 0.2: xoa duong cu, khong them
duong moi).

Cung dip nay nhan them SET (truoc chi list): HashSet<T> khong co indexer
nen duoc chuyen sang List<T> 1 lan qua List`1::.ctor(IEnumerable`1<!0>)
roi lap nhu binh thuong - dung ky thuat cua set.to_list()/list.copy().
Nho vay 'sorted(mot_set)' chay duoc (truoc day khong co duong nao).

'sum' tra ve dtype cua PHAN TU (khong phai 1 chuoi co dinh) nen can co
che moi EXPR_BUILTIN_DTYPE_FN trong il_dispatch.py - doi xung voi
return_ta_fn cua method (nhom 5).

Tham so van phai la 1 BIEN don (khong phai bieu thuc long nhau) - giong
gioi han cua json_dumps: codegen doc TypeAnn tu scope de biet dtype phan
tu. min(lst)/max(lst) NEM ArgumentOutOfRangeException luc CHAY neu nguon
rong (list[0] tu nhien throw - KHONG gia lap ValueError cua Python)."""
import re

from il_dispatch import register_macro_expander, register_expr_builtin
from il_features.list_type import il_list_type, reject_if_handle_type_elem
from il_features.stdlib_functional import (_resolve_func_ta, emit_sort_by_key,
                                            sort_key_temp_names)
import il_features.int_type as _int_type

# ---------------------------------------------------------------------
# min(a,b) / max(a,b) - macro text-level, viet lai thanh ternary co san.
# ---------------------------------------------------------------------
_MINMAX_CALL_RE = re.compile(r'\b(min|max)\(')
# `ten = ` o DAU 1 tham so -> day la KWARG ('max(xs, key=neg)'), KHONG phai
# tham so positional thu 2. Macro text-level duoi ben KHONG phai biet phan
# biet giua 2 cai - no chi dem dau phay, nen `max(xs, key=neg)` bi viet lai
# thanh ternary `(xs > (key=neg) ? xs : (key=neg))` va parser bao loi khoe
# ("ky vong ')', gap '='"). Do la ly do `key=` bi ghi la "loi o TANG PARSER"
# trong khi parser (`_parse_one_call_arg` o il_core) da tra ('kwarg', ...)
# dung cach tu 2026-08-28 - CHINH MACRO nay lam hong.
#
# Regex phai khu duoc `a == b` / `a <= b`: CMPOP gop 2 dau '=' thanh 1 token
# nen TRONG TEXT van la `a == b` / `a <= b`, co 2 ky tu '=' lien nhau, nen
# `^\w+\s*=` (chi 1 dau '=') khong khop. Phan tu positional bat dau bang 1
# bieu thuc nen khong bao gio bat dau bang `ten=` - khong co nham lay.
_KWARG_PART_RE = re.compile(r'^\w+\s*=')


def _has_kwarg(parts):
    """True neu goi nay co it nhat 1 KWARG ('max(xs, key=neg)') - khi do
    macro text-level KHONG duoc phien noi (so 2 tham so), de builtin ben duoi
    xu ly."""
    return any(_KWARG_PART_RE.match(p) for p in parts)


def _find_balanced_call(text, open_paren_idx):
    """text[open_paren_idx] == '(' - quet toi ')' dong khop (dem do sau
    ngoac, bo qua dau ',' BEN TRONG chuoi "..." hoac ngoac long hon), tra
    ve (idx cua ')' dong khop, list cac tham so da strip())."""
    depth = 0
    parts = []
    part_start = open_paren_idx + 1
    in_str = False
    i = open_paren_idx
    while i < len(text):
        c = text[i]
        if in_str:
            if c == '"':
                in_str = False
        elif c == '"':
            in_str = True
        elif c == '(':
            depth += 1
        elif c == ')':
            depth -= 1
            if depth == 0:
                parts.append(text[part_start:i].strip())
                return i, parts
        elif c == ',' and depth == 1:
            parts.append(text[part_start:i].strip())
            part_start = i + 1
        i += 1
    raise SyntaxError(f"il_codegen: '(' o vi tri {open_paren_idx} khong co ')' dong khop trong: {text!r}")


def _expand_minmax_in(text, depth=0):
    """Mo rong MOI loi goi min/max 2+ tham so nam TRONG 'text' (de quy).

    2026-09-25: 'max(-128, min(127, v))' - 2 loi goi long nhau tren CUNG
    1 dong. Macro goc chi xu ly 1 loi goi moi dong (search lay 'min|max('
    DAU TIEN) va phai de _expand_macros lap toi diem co dinh moi xong;
    nhung vi lan sau bien do lai ra len moi co 'min(' ben trong, moi vong
    chi "di chuyen" loi goi do, chua bao gio bien mat het - het 10 vong
    (tran cua _expand_macros) thi con lai, va bien dich that bai loi
    "min() can 1 tham so DAU la 1 BIEN list/set". De quy giai quyet
    ngay trong 1 lan: moi tham so duoc mo rong HET truoc khi ghep."""
    if depth > 16:
        return text
    out = text
    pos = 0
    while True:
        m = _MINMAX_CALL_RE.search(out[pos:])
        if not m:
            return out
        start = pos + m.start()
        open_idx = pos + m.end() - 1
        close_idx, parts = _find_balanced_call(out, open_idx)
        if len(parts) < 2 or _has_kwarg(parts):
            # 1 tham so (aggregate), KHONG phai min/max, hoac co kwarg
            # ('max(xs, key=f)') - bo qua, tiep tuc tim sau do (de tranh sot
            # loi goi long nhau o phia sau).
            pos = open_idx + 1
            continue
        op = '<' if m.group(1) == 'min' else '>'
        expr = _expand_minmax_in(parts[0], depth + 1)
        for p in parts[1:]:
            p = _expand_minmax_in(p, depth + 1)
            expr = f'({expr} {op} {p} ? {expr} : {p})'
        out = out[:start] + expr + out[close_idx + 1:]
        pos = start + len(expr)


def try_expand_minmax_2arg(line):
    m = _MINMAX_CALL_RE.search(line)
    if not m:
        return None
    name = m.group(1)
    open_idx = m.end() - 1
    close_idx, parts = _find_balanced_call(line, open_idx)
    if len(parts) < 2 or _has_kwarg(parts):
        # min(lst)/max(lst) 1 tham so (aggregate) - KHONG phai viec cua macro
        # nay, de builtin ben duoi xu ly. `max(xs, key=f)` cung vay: co kwarg
        # nen KHONG phai goi variadic 2 tham so (xem _has_kwarg).
        return None
    op = '<' if name == 'min' else '>'
    # N-ary (2026-08-12, Phase 5 uu tien "sum/min/max variadic"): gap
    # trai qua tung cap theo thu tu TRAI->PHAI, giong min(a, min(b,c))
    # nhung viet phang thanh 1 ternary long nhau - van CHAP NHAN nhan
    # ban VAN BAN (khong tac dung phu, xem docstring dau file).
    # Moi tham so duoc mo rong DE QUY truoc (2026-09-25) de 'min/max'
    # long nhau tren cung 1 dong cung duoc giai het trong 1 vong.
    expr = _expand_minmax_in(parts[0])
    for p in parts[1:]:
        p = _expand_minmax_in(p)
        expr = f'({expr} {op} {p} ? {expr} : {p})'
    head = _expand_minmax_in(line[:m.start()])
    tail = _expand_minmax_in(line[close_idx + 1:])
    return head + expr + tail


# ---------------------------------------------------------------------
# sum/min/max/sorted/any/all (1 tham so: list HOAC set) - expr builtin.
# ---------------------------------------------------------------------
_NUMERIC_DTYPES = {'i32', 'i64', 'f32', 'f64', 'int'}


def _agg_arg_ta(args, scope, fname, max_args=1):
    """TypeAnn cua tham so + kiem tra no la 1 BIEN list/set. max_args>1
    cho phep them tham so phu (vd sum(xs, start)) - CHI args[0] duoc xet
    o day, cac tham so sau do caller tu xu ly rieng."""
    if not (1 <= len(args) <= max_args) or args[0][0] != 'var':
        extra = f" (toi da {max_args} tham so)" if max_args > 1 else ""
        raise SyntaxError(
            f"il_codegen: {fname}() can 1 tham so DAU la 1 BIEN list/set (vd {fname}(xs)){extra} "
            f"- bieu thuc long nhau chua ho tro, gan ra 1 bien truoc")
    name = args[0][1]
    try:
        ta = scope[name][2]
    except KeyError:
        raise SyntaxError(f"il_codegen: {fname}({name}) - '{name}' chua duoc khai bao")
    if ta.shape not in ('list', 'set', 'frozenset'):
        raise SyntaxError(
            f"il_codegen: {fname}({name}) can '{name}' la list, set hoac frozenset (dang co "
            f"shape={ta.shape!r})")
    return name, ta


def _split_kwargs(args, fname, allowed):
    """Tach `args` thanh (positional, {ten_kwarg: node}).

    `args` la danh sach node da parse, trong do node khoa co dang
    `('kwarg', ten, bieu_thuc)` (xem `il_core._parse_one_call_arg`). Ten
    kwarg la CHAINH: sai ten -> loi ro rang (khong im lang bo qua - bo qua
    chinh la loai sai am thanh nguy hiem nhat), trung ten -> loi ro rang."""
    positional = []
    kwargs = {}
    for a in args:
        if isinstance(a, tuple) and a and a[0] == 'kwarg':
            kname = a[1]
            if kname not in allowed:
                raise SyntaxError(
                    f"il_codegen: {fname}() khong co tham so keyword '{kname}' "
                    f"(chi chap nhan: {', '.join(sorted(allowed))})")
            if kname in kwargs:
                raise SyntaxError(
                    f"il_codegen: {fname}() nhan keyword '{kname}' 2 lan - "
                    f"chi duoc truyen 1 lan")
            kwargs[kname] = a[2]
        else:
            positional.append(a)
    return positional, kwargs


# Kieu cua KHOA so sanh duoc. KHONG duoc la `str` khi min/max/sum: do phat
# `cgt`/`clt` truc tiep tren 2 chuoi la IL sai (so sanh chuoi phai qua
# String::CompareOrdinal) - chay moi bao. `sorted` thi DUOC phep `str` vi no
# so sanh qua `List<ValueTuple<K,T>>.Sort()` cua .NET, noi ValueTuple co
# san IComparable theo K (da probe: `sorted(names, key=name)` chay dung).
_KEY_COMPARABLE = {'i32', 'i64', 'f32', 'f64', 'int', 'bool'}


def _key_func(kwargs, scope, ctx, fname, elem_dtype, allow_str=False):
    """(ten, TypeAnn kieu func) cua `key=f`, hoac None neu khong truyen key.

    Kiem tra chu ky ngay: `key` phai nhan DUNG 1 tham so co dtype bang dtype
    phan tu cua list - cung ly do voi `map(f, xs)`, xem `_resolve_func_ta`.
    Kieu TRA VE phai so sanh duoc (xem `_KEY_COMPARABLE`).
    """
    key_node = kwargs.get('key')
    if key_node is None:
        return None
    f_ta = _resolve_func_ta(key_node, scope, ctx['func_table'], fname)
    if list(f_ta.func_params) != [elem_dtype]:
        raise SyntaxError(
            f"il_codegen: {fname}(..., key={key_node[1]}) - chu ky key "
            f"(({', '.join(f_ta.func_params)}) -> {f_ta.dtype}) khong khop dtype phan tu "
            f"cua list ({elem_dtype!r})")
    if f_ta.dtype not in _KEY_COMPARABLE and not (allow_str and f_ta.dtype == 'str'):
        raise SyntaxError(
            f"il_codegen: {fname}(..., key={key_node[1]}) - kieu tra ve cua key "
            f"({f_ta.dtype!r}) khong so sanh duoc; chi nhan "
            f"{sorted(_KEY_COMPARABLE)}"
            + (" va 'str'" if allow_str else "") +
            " (so sanh truc tiep tren 2 gia tri kieu khac se ra IL sai)")
    return key_node[1], f_ta


def _agg_elem_dtype(args, scope, func_table=None):
    """EXPR_BUILTIN_DTYPE_FN: sum/min/max/sorted deu mang dtype PHAN TU cua
    nguon. Tra None khi chua suy duoc (caller tu fallback). sum(xs, start)
    (2026-08-12): args[1:] (start) khong anh huong dtype ket qua - VAN
    LAY tu args[0] (nguon list), chi noi long check do dai tu ==1 sang
    >=1 - BUG THAT tung phat hien: thieu nhanh nay khien infer_dtype tra
    None cho 'sum(xs, start)', keo theo compile_str_builtin() khai bao
    sai dtype cho local __strtmp (mismatch voi ket qua i32 THAT tren
    stack), gay NullReferenceException luc chay.

    `key=` KHONG doi quy tac nay: `max(xs, key=f)` tra ve **PHAN TU** cua xs
    (khong phai khoa) - dung nghia Python - nen dtype ket qua van la dtype
    phan tu, chi thay doi cach SO SANH ben trong. Rieng `sum(xs, key=f)`
    cong TONG KHOA nen dtype ket qua = dtype kieu cua `f`."""
    if len(args) < 1 or args[0][0] not in ('var', 'kwarg'):
        return None
    first = args[0]
    if first[0] == 'kwarg':
        first = first[2]
    try:
        return scope[first[1]][2].dtype
    except (KeyError, SyntaxError):
        return None


def _require_numeric(ta, fname):
    if ta.dtype not in _NUMERIC_DTYPES:
        raise SyntaxError(
            f"il_codegen: {fname}() chi ap dung cho list/set SO (i32/i64/f32/f64), "
            f"phan tu dang la {ta.dtype!r}")


def _temps_agg(node, ctx, prefix, res_dtype_fn, fname=None):
    """Bien an: nguon (List<T> - CAN ca khi tham so von la list, vi trong
    bieu thuc khong 'load lai' duoc 1 gia tri tam), chi so, va ket qua.

    Co `key=f` (2026-10-02) thi them 3 bien an nuaa: funcref `f`, khoa
    tot nhat, va khoa cua phan tu dang xet - xem `_push_minmax_key`.

    `fname` la ten HAM thật de thong bao loi ('max', khong phai 'agg' - tien
    toan trong ten bien an la noi luu state cua nhom min/max)."""
    args = node[2]
    if fname is None:
        fname = 'sum' if prefix == 'sum' else prefix
    positional, kwargs = _split_kwargs(args, fname, ('key',))
    if not positional or positional[0][0] != 'var':
        return
    try:
        ta = ctx['infer_scope'][positional[0][1]][2]
    except (KeyError, SyntaxError):
        return
    if ta.shape not in ('list', 'set', 'frozenset'):
        return
    TypeAnn = ctx['TypeAnn']
    keyf = None
    # KHONG nuot loi cua _key_func: nuot di se khong cap phat duoc bien an,
    # va pass 2 bao loi SAI KY DO ('bien __agg..._f chua duoc khai bao') che
    # loi that. Loi chu ky `key` la loi tinh tien BIEN DICH, khong phai loi
    # phu thuoc thu tu khai bao bien nen nem ra day la dung.
    keyf = _key_func(kwargs, ctx['infer_scope'], ctx, fname, ta.dtype)
    ctx['declare_named'](f'__{prefix}{id(args)}_src', TypeAnn(ta.dtype, 'list'))
    ctx['declare_named'](f'__{prefix}{id(args)}_idx', TypeAnn('i32', None))
    if keyf is None:
        ctx['declare_named'](f'__{prefix}{id(args)}_res', TypeAnn(res_dtype_fn(ta), None))
        return
    _, f_ta = keyf
    ctx['declare_named'](f'__{prefix}{id(args)}_f', f_ta)
    if prefix == 'sum':
        # sum(xs, key=f) cong TONG KHOA -> `res` la K, khong can `resk`/`curk`.
        ctx['declare_named'](f'__{prefix}{id(args)}_res', TypeAnn(f_ta.dtype, None))
        return
    # min/max(x, key=f): tra ve PHAN TU (T) nen `res` van la T; them khoa tot
    # nhat + khoa phan tu dang xet de so sanh.
    ctx['declare_named'](f'__{prefix}{id(args)}_res', TypeAnn(ta.dtype, None))
    ctx['declare_named'](f'__{prefix}{id(args)}_resk', TypeAnn(f_ta.dtype, None))
    ctx['declare_named'](f'__{prefix}{id(args)}_curk', TypeAnn(f_ta.dtype, None))


def _loop_prelude(args, scope, out, ctx, prefix, fname, max_args=1, id_args=None):
    """src = <list/set nguon> (set duoc chuyen sang List 1 lan), tra ve
    (list_type, ta, cac chi so local, 3 nhan) - dung chung cho
    sum/min/max/any/all.

    `args` o day la danh sach POSITIONAL da tach khoa roi (xem
    `_split_kwargs`). Bien an duoc khoa bang `id_args` - MAC dinh lay
    `id(args)` cua chinh danh sach truyen vao. Khi tach khoa thi danh sach
    positional la 1 list MOI nen `id` khac - phai truyen `id(args_goc)` de
    khoa bien an khop voi `temps_fn` (cung nhan id cua list goc)."""
    if id_args is None:
        id_args = id(args)
    name, ta = _agg_arg_ta(args, scope, fname, max_args=max_args)
    reject_if_handle_type_elem(ta, ctx.get('extern_class_defs'), fname)
    if ta.dtype == 'int':
        # Ham co the KHONG dung phep so hoc 'int' nao khac ngoai sum(xs)
        # - luc do khong ai khac goi ensure_class va .class TkvInt se
        # thieu han khoi file IL.
        _int_type.ensure_class(ctx)
    # reject o tren da chan handle type khi ctx co extern_class_defs; neu ctx
    # thieu key nay se roi ve message loi cu mo ho hon - xem
    # test/verify/list_handle_type_reject_test.py
    list_type = il_list_type(ta.dtype, ctx.get('records'))
    ctx['load_var_ref'](name, scope, out)
    if ta.shape in ('set', 'frozenset'):
        out.append(
            f'    newobj instance void {list_type}::.ctor(class '
            f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    _, src_idx, _ = scope[f'__{prefix}{id_args}_src']
    _, idx_idx, _ = scope[f'__{prefix}{id_args}_idx']
    _, res_idx, _ = scope[f'__{prefix}{id_args}_res']
    out.append(f'    stloc.s {src_idx}')
    ctx['label_counter'][0] += 1
    n = ctx['label_counter'][0]
    labels = (f"{ctx['prefix']}_{prefix}{n}_start", f"{ctx['prefix']}_{prefix}{n}_skip",
              f"{ctx['prefix']}_{prefix}{n}_end")
    return list_type, ta, src_idx, idx_idx, res_idx, labels


def _emit_loop_head(out, list_type, src_idx, idx_idx, start_lbl, end_lbl):
    out.append(f'  {start_lbl}:')
    out.append(f'    ldloc.s {idx_idx}')
    out.append(f'    ldloc.s {src_idx}')
    out.append(f'    callvirt instance int32 {list_type}::get_Count()')
    out.append(f'    bge {end_lbl}')


def _emit_loop_tail(out, idx_idx, start_lbl, end_lbl, res_idx):
    out.append(f'    ldloc.s {idx_idx}')
    out.append('    ldc.i4.1')
    out.append('    add')
    out.append(f'    stloc.s {idx_idx}')
    out.append(f'    br {start_lbl}')
    out.append(f'  {end_lbl}:')
    out.append(f'    ldloc.s {res_idx}')


def _emit_get_item(out, list_type, src_idx, idx_idx):
    out.append(f'    ldloc.s {src_idx}')
    out.append(f'    ldloc.s {idx_idx}')
    out.append(f'    callvirt instance !0 {list_type}::get_Item(int32)')


def _emit_call_key(out, func_il, f_idx, list_type, src_idx, idx_idx, n_params):
    """Day len stack `f(src[idx])`: `ldloc f; ldloc src; ldloc idx;
    get_Item; Func::Invoke`. Caller phai dung khuoi nay TRUOC khi
    `stloc.s <khoa>`."""
    out.append(f'    ldloc.s {f_idx}')
    _emit_get_item(out, list_type, src_idx, idx_idx)
    invoke_params = ', '.join(f'!{i}' for i in range(n_params))
    out.append(f'    callvirt instance !{n_params} {func_il}::Invoke({invoke_params})')


def _emit_cmp_k(out, ta, cmp_opcode):
    """So sanh 2 khoa (da day len stack) theo `cmp_opcode` ('clt'/'cgt').
    Kieu 'int' la struct nen phai qua TkvInt::Cmp - giong het nhanh khong
    co `key` o `_push_minmax` ben duoi."""
    if ta == 'int':
        _int_type.emit_cmp(out, cmp_opcode)
    else:
        out.append(f'    {cmp_opcode}')


def _push_minmax_key(positional, kwargs, scope, out, ctx, cmp_opcode, fname, id_args):
    """`min/max(xs, key=f)` - tra ve **PHAN TU** co khoa lon/nho nhat
    (dung nghia Python, KHONG phai tra ve khoa).

    `cmp_opcode` la 'cgt' cho max, 'clt' cho min; so sanh **TUYET DOI** nen
    khi trung khoa phan tu DAU tien duoc giu - giong Python (`max`/`min` giu
    phan tu dau tien khi trung khoa).
    """
    name, ta = _agg_arg_ta(positional, scope, fname)
    reject_if_handle_type_elem(ta, ctx.get('extern_class_defs'), fname)
    key_name, f_ta = _key_func(kwargs, scope, ctx, fname, ta.dtype)
    list_type = il_list_type(ta.dtype, ctx.get('records'))
    func_il = ctx['il_type_str'](f_ta, ctx.get('records'))
    n_params = len(f_ta.func_params)
    _, src_idx, _ = scope[f'__agg{id_args}_src']
    _, idx_idx, _ = scope[f'__agg{id_args}_idx']
    _, res_idx, _ = scope[f'__agg{id_args}_res']
    _, f_idx, _ = scope[f'__agg{id_args}_f']
    _, resk_idx, _ = scope[f'__agg{id_args}_resk']
    _, curk_idx, _ = scope[f'__agg{id_args}_curk']

    ctx['load_var_ref'](name, scope, out)
    out.append(f'    stloc.s {src_idx}')
    ctx['compile_funcref_arg'](('var', key_name), f_ta, scope, out, ctx)
    out.append(f'    stloc.s {f_idx}')
    # res = src[0]; resk = f(src[0]) - nguon rong thi get_Item(0) nem
    # ArgumentOutOfRangeException, giong het nhanh khong co `key`.
    #
    # KHONG dung `dup` de lay 2 ban cua phan tu dau: `dup` chi hop le voi
    # REFERENCE - kieu 'int' (TkvInt) la VALUE TYPE nen `dup` tao IL ma
    # ilasm van nuot nhung JIT bao InvalidProgramException luc chay
    # (da gap that, khong phai ly thuyet). Doc `get_Item` 2 lan thay cho.
    out.append('    ldc.i4.0')
    out.append(f'    stloc.s {idx_idx}')
    _emit_get_item(out, list_type, src_idx, idx_idx)
    out.append(f'    stloc.s {res_idx}')
    _emit_call_key(out, func_il, f_idx, list_type, src_idx, idx_idx, n_params)
    out.append(f'    stloc.s {resk_idx}')
    out.append('    ldc.i4.1')
    out.append(f'    stloc.s {idx_idx}')
    ctx['label_counter'][0] += 1
    n = ctx['label_counter'][0]
    start_lbl = f"{ctx['prefix']}_aggkey{n}_start"
    skip_lbl = f"{ctx['prefix']}_aggkey{n}_skip"
    end_lbl = f"{ctx['prefix']}_aggkey{n}_end"
    _emit_loop_head(out, list_type, src_idx, idx_idx, start_lbl, end_lbl)
    _emit_call_key(out, func_il, f_idx, list_type, src_idx, idx_idx, n_params)
    out.append(f'    stloc.s {curk_idx}')
    out.append(f'    ldloc.s {curk_idx}')
    out.append(f'    ldloc.s {resk_idx}')
    _emit_cmp_k(out, f_ta.dtype, cmp_opcode)
    out.append(f'    brfalse {skip_lbl}')
    _emit_get_item(out, list_type, src_idx, idx_idx)
    out.append(f'    stloc.s {res_idx}')
    out.append(f'    ldloc.s {curk_idx}')
    out.append(f'    stloc.s {resk_idx}')
    out.append(f'  {skip_lbl}:')
    _emit_loop_tail(out, idx_idx, start_lbl, end_lbl, res_idx)


def _push_sum_key(positional, kwargs, scope, out, ctx, id_args):
    """`sum(xs, key=f)` - cong TONG KHOA (khong phai tong phan tu)."""
    name, ta = _agg_arg_ta(positional, scope, 'sum', max_args=2)
    reject_if_handle_type_elem(ta, ctx.get('extern_class_defs'), 'sum')
    key_name, f_ta = _key_func(kwargs, scope, ctx, 'sum', ta.dtype)
    if f_ta.dtype == 'int':
        _int_type.ensure_class(ctx)
    list_type = il_list_type(ta.dtype, ctx.get('records'))
    func_il = ctx['il_type_str'](f_ta, ctx.get('records'))
    n_params = len(f_ta.func_params)
    _, src_idx, _ = scope[f'__sum{id_args}_src']
    _, idx_idx, _ = scope[f'__sum{id_args}_idx']
    _, res_idx, _ = scope[f'__sum{id_args}_res']
    _, f_idx, _ = scope[f'__sum{id_args}_f']

    ctx['load_var_ref'](name, scope, out)
    out.append(f'    stloc.s {src_idx}')
    ctx['compile_funcref_arg'](('var', key_name), f_ta, scope, out, ctx)
    out.append(f'    stloc.s {f_idx}')
    if len(positional) == 2:
        ctx['compile_expr'](positional[1], scope, out, f_ta.dtype, ctx)
    else:
        ctx['compile_expr'](('num', '0'), scope, out, f_ta.dtype, ctx)
    out.append(f'    stloc.s {res_idx}')
    out.append('    ldc.i4.0')
    out.append(f'    stloc.s {idx_idx}')
    ctx['label_counter'][0] += 1
    n = ctx['label_counter'][0]
    start_lbl = f"{ctx['prefix']}_sumkey{n}_start"
    end_lbl = f"{ctx['prefix']}_sumkey{n}_end"
    _emit_loop_head(out, list_type, src_idx, idx_idx, start_lbl, end_lbl)
    out.append(f'    ldloc.s {res_idx}')
    _emit_call_key(out, func_il, f_idx, list_type, src_idx, idx_idx, n_params)
    if f_ta.dtype == 'int':
        _int_type.emit_add(out)
    else:
        out.append('    add')
    out.append(f'    stloc.s {res_idx}')
    _emit_loop_tail(out, idx_idx, start_lbl, end_lbl, res_idx)


def push_sum(args, scope, out, dtype, ctx):
    """sum(xs) hoac sum(xs, start) (2026-08-12, Phase 5 uu tien "sum
    variadic") - tham so thu 2 la GIA TRI KHOI TAO (bieu thuc bat ky,
    khong bat buoc la bien), thay cho hang so 0 mac dinh - dung ngu
    nghia Python that. `sum(xs, key=f)` cong tong KHOA."""
    positional, kwargs = _split_kwargs(args, 'sum', ('key',))
    id_args = id(args)
    if 'key' in kwargs:
        return _push_sum_key(positional, kwargs, scope, out, ctx, id_args)
    args = positional
    list_type, ta, src_idx, idx_idx, res_idx, (start_lbl, _skip, end_lbl) = \
        _loop_prelude(args, scope, out, ctx, 'sum', 'sum', max_args=2, id_args=id_args)
    _require_numeric(ta, 'sum')
    if len(args) == 2:
        ctx['compile_expr'](args[1], scope, out, ta.dtype, ctx)
    else:
        ctx['compile_expr'](('num', '0'), scope, out, ta.dtype, ctx)
    out.append(f'    stloc.s {res_idx}')
    out.append('    ldc.i4.0')
    out.append(f'    stloc.s {idx_idx}')
    _emit_loop_head(out, list_type, src_idx, idx_idx, start_lbl, end_lbl)
    out.append(f'    ldloc.s {res_idx}')
    _emit_get_item(out, list_type, src_idx, idx_idx)
    if ta.dtype == 'int':
        # Kieu 'int': 'add' cua CIL khong cong duoc hai struct. Goi
        # TkvInt::Add (duong nhanh int64 + duong BigInteger khi tran).
        _int_type.emit_add(out)
    else:
        out.append('    add')
    out.append(f'    stloc.s {res_idx}')
    _emit_loop_tail(out, idx_idx, start_lbl, end_lbl, res_idx)


def _push_minmax(args, scope, out, ctx, cmp_opcode, fname, id_args=None):
    list_type, ta, src_idx, idx_idx, res_idx, (start_lbl, skip_lbl, end_lbl) = \
        _loop_prelude(args, scope, out, ctx, 'agg', fname, id_args=id_args)
    _require_numeric(ta, fname)
    # res = src[0] (nguon rong -> ArgumentOutOfRangeException luc chay)
    out.append(f'    ldloc.s {src_idx}')
    out.append('    ldc.i4.0')
    out.append(f'    callvirt instance !0 {list_type}::get_Item(int32)')
    out.append(f'    stloc.s {res_idx}')
    out.append('    ldc.i4.1')
    out.append(f'    stloc.s {idx_idx}')
    _emit_loop_head(out, list_type, src_idx, idx_idx, start_lbl, end_lbl)
    _emit_get_item(out, list_type, src_idx, idx_idx)
    out.append(f'    ldloc.s {res_idx}')
    if ta.dtype == 'int':
        # 'clt'/'cgt' khong so sanh duoc hai struct - qua TkvInt::Cmp.
        _int_type.emit_cmp(out, cmp_opcode)
    else:
        out.append(f'    {cmp_opcode}')
    out.append(f'    brfalse {skip_lbl}')
    _emit_get_item(out, list_type, src_idx, idx_idx)
    out.append(f'    stloc.s {res_idx}')
    out.append(f'  {skip_lbl}:')
    _emit_loop_tail(out, idx_idx, start_lbl, end_lbl, res_idx)


def push_min_list(args, scope, out, dtype, ctx):
    positional, kwargs = _split_kwargs(args, 'min', ('key',))
    if 'key' in kwargs:
        return _push_minmax_key(positional, kwargs, scope, out, ctx, 'clt', 'min', id(args))
    _push_minmax(positional, scope, out, ctx, 'clt', 'min', id(args))


def push_max_list(args, scope, out, dtype, ctx):
    positional, kwargs = _split_kwargs(args, 'max', ('key',))
    if 'key' in kwargs:
        return _push_minmax_key(positional, kwargs, scope, out, ctx, 'cgt', 'max', id(args))
    _push_minmax(positional, scope, out, ctx, 'cgt', 'max', id(args))


def _push_any_all(args, scope, out, ctx, init_val, flip_val, skip_when_zero, fname):
    list_type, ta, src_idx, idx_idx, res_idx, (start_lbl, skip_lbl, end_lbl) = \
        _loop_prelude(args, scope, out, ctx, 'anyall', fname)
    _require_numeric(ta, fname)
    out.append(f'    ldc.i4.{init_val}')
    out.append(f'    stloc.s {res_idx}')
    out.append('    ldc.i4.0')
    out.append(f'    stloc.s {idx_idx}')
    _emit_loop_head(out, list_type, src_idx, idx_idx, start_lbl, end_lbl)
    _emit_get_item(out, list_type, src_idx, idx_idx)
    if ta.dtype == 'int':
        # 'ceq' khong so sanh duoc struct - TkvInt::IsZero tra thang 0/1,
        # dung y nghia "phan tu nay co falsy khong".
        _int_type.emit_is_zero(out)
    else:
        ctx['compile_expr'](('num', '0'), scope, out, ta.dtype, ctx)
        out.append('    ceq')
    # 'ceq' = 1 khi phan tu BANG 0 (falsy). any(): bo qua khi falsy. all():
    # bo qua khi TRUTHY -> lat nguoc ket qua ceq.
    if not skip_when_zero:
        out.append('    ldc.i4.0')
        out.append('    ceq')
    out.append(f'    brtrue {skip_lbl}')
    out.append(f'    ldc.i4.{flip_val}')
    out.append(f'    stloc.s {res_idx}')
    out.append(f'  {skip_lbl}:')
    _emit_loop_tail(out, idx_idx, start_lbl, end_lbl, res_idx)


def push_any_list(args, scope, out, dtype, ctx):
    _push_any_all(args, scope, out, ctx, 0, 1, True, 'any')


def push_all_list(args, scope, out, dtype, ctx):
    _push_any_all(args, scope, out, ctx, 1, 0, False, 'all')


def push_sorted(args, scope, out, dtype, ctx):
    """KHONG can bien an nao: List moi nam san tren stack, 'dup' de goi
    Sort() (tra void) roi van con chinh no lam ket qua bieu thuc.

    `sorted(xs, key=f)` / `sorted(xs, reverse=True)` (2026-10-02) - ca hai
    deu can bien an (ban sao + 3 bien cua `emit_sort_by_key`), xem
    `_push_sorted_key`."""
    positional, kwargs = _split_kwargs(args, 'sorted', ('key', 'reverse'))
    if kwargs:
        return _push_sorted_key(positional, kwargs, scope, out, ctx, id(args))
    name, ta = _agg_arg_ta(positional, scope, 'sorted')
    reject_if_handle_type_elem(ta, ctx.get('extern_class_defs'), 'sorted')
    # reject o tren da chan handle type khi ctx co extern_class_defs; neu ctx
    # thieu key nay se roi ve message loi cu mo ho hon - xem
    # test/verify/list_handle_type_reject_test.py
    list_type = il_list_type(ta.dtype, ctx.get('records'))
    ctx['load_var_ref'](name, scope, out)
    out.append(
        f'    newobj instance void {list_type}::.ctor(class '
        f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    out.append('    dup')
    if 'reverse' in kwargs:
        out.append(f'    callvirt instance void {list_type}::Reverse()')
    else:
        out.append(f'    callvirt instance void {list_type}::Sort()')


def _reverse_node_check(kwargs, ctx):
    """Kiem tra `reverse=` la 1 BIEU THUC SO/BOOL va tra node do (hoac None
    neu khong truyen). Gia tri chua bi DANH GIA luc bien dich - phat
    nhanh `brfalse` luc chay, nên `reverse=flag` van dung y het Python."""
    node = kwargs.get('reverse')
    if node is None:
        return None
    if node[0] == 'num':
        # `_infer_dtype` tra None cho literals so (khong nam trong scope) -
        # nhung chung van la 'i32' thuc te tren stack.
        return node
    infer_dtype = (ctx or {}).get('infer_dtype')
    d = None
    if infer_dtype is not None:
        try:
            d = infer_dtype(node, ctx['infer_scope'], ctx['func_table'],
                            ctx['records'], ctx['record_methods'])
        except (KeyError, SyntaxError):
            d = None
    if d not in ('i32', 'i64', 'bool'):
        raise SyntaxError(
            f"il_codegen: sorted(..., reverse=...) chi nhan gia tri SO/BOOL "
            f"(dang la {d!r})")
    return node


def _push_sorted_key(positional, kwargs, scope, out, ctx, id_args):
    """`sorted(xs, key=f)` + `sorted(xs, reverse=True)` - tra ve LIST MOI
    da sap xep, khong sua `xs` (dung nghia Python).

    Bien an: `__sortkey<id>_src` (ban sao), `__sortkey<id>_rev` (gia tri
    `reverse`) va 3 bien cua `emit_sort_by_key` (dung chung voi
    `.sort(key=)`), khai bao o `_temps_sorted`."""
    name, ta = _agg_arg_ta(positional, scope, 'sorted')
    reject_if_handle_type_elem(ta, ctx.get('extern_class_defs'), 'sorted')
    reverse_node = _reverse_node_check(kwargs, ctx)
    list_type = il_list_type(ta.dtype, ctx.get('records'))
    src_name = f'__sortkey{id_args}_src'
    _, src_idx, _ = scope[src_name]
    ctx['load_var_ref'](name, scope, out)
    out.append(
        f'    newobj instance void {list_type}::.ctor(class '
        f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    out.append(f'    stloc.s {src_idx}')
    if 'key' in kwargs:
        key_name, f_ta = _key_func(kwargs, scope, ctx, 'sorted', ta.dtype, allow_str=True)
        emit_sort_by_key(scope, out, ctx, src_name, ta, key_name, f_ta, id_args)
    else:
        out.append(f'    ldloc.s {src_idx}')
        out.append(f'    callvirt instance void {list_type}::Sort()')
    if reverse_node is not None:
        # `reverse` chi DOI thu tu, khong doi dieu kien so sanh - giong Python.
        # Gia tri chua bi danh gia luc bien dich: `reverse=flag` chay dung o
        # runtime y het Python (neu danh gia luc bien dich thi chi nhan duoc
        # hang so va se im lang bo qua bien).
        _, rev_idx, _ = scope[f'__sortkey{id_args}_rev']
        ctx['compile_expr'](reverse_node, scope, out, 'i32', ctx)
        out.append(f'    stloc.s {rev_idx}')
        ctx['label_counter'][0] += 1
        n = ctx['label_counter'][0]
        skip_rev_lbl = f"{ctx['prefix']}_srtnorev{n}"
        out.append(f'    ldloc.s {rev_idx}')
        out.append(f'    brfalse {skip_rev_lbl}')
        out.append(f'    ldloc.s {src_idx}')
        out.append(f'    callvirt instance void {list_type}::Reverse()')
        out.append(f'  {skip_rev_lbl}:')
    out.append(f'    ldloc.s {src_idx}')


def _temps_sorted(node, ctx):
    """Bien an cho `sorted(xs, key=f)` / `sorted(xs, reverse=...)`."""
    args = node[2]
    positional, kwargs = _split_kwargs(args, 'sorted', ('key', 'reverse'))
    if not kwargs or not positional or positional[0][0] != 'var':
        return
    try:
        ta = ctx['infer_scope'][positional[0][1]][2]
    except (KeyError, SyntaxError):
        return
    if ta.shape != 'list':
        return
    TypeAnn = ctx['TypeAnn']
    ctx['declare_named'](f'__sortkey{id(args)}_src', TypeAnn(ta.dtype, 'list'))
    if 'reverse' in kwargs:
        _reverse_node_check(kwargs, ctx)
        ctx['declare_named'](f'__sortkey{id(args)}_rev', TypeAnn('i32', None))
    if 'key' not in kwargs:
        return
    # KHONG nuot loi cua _key_func (xem ghi chu o `_temps_agg`).
    _, f_ta = _key_func(kwargs, ctx['infer_scope'], ctx, 'sorted', ta.dtype,
                        allow_str=True)
    f_n, pairs_n, idx_n = sort_key_temp_names(id(args))
    ctx['declare_named'](f_n, f_ta)
    ctx['declare_named'](pairs_n, TypeAnn(
        f_ta.dtype, 'list',
        elem_ta=TypeAnn(ta.dtype, 'tuple', tuple_dtypes=[f_ta.dtype, ta.dtype])))
    ctx['declare_named'](idx_n, TypeAnn('i32', None))


def _make_temps(prefix, res_dtype_fn, fname=None):
    def temps_fn(node, ctx):
        _temps_agg(node, ctx, prefix, res_dtype_fn, fname=fname)
    return temps_fn


def _sum_result_dtype(args, scope, func_table=None, ctx=None):
    """`sum(xs, key=f)` cong tong KHOA nen dtype ket qua la dtype kieu cua
    `f` - KHONG phai dtype phan tu cua list (khac min/max/sorted, tra ve
    phan tu). Can `ctx` de tra cuu func_table cua chuong trinh."""
    positional, kwargs = _split_kwargs(args, 'sum', ('key',))
    if 'key' not in kwargs:
        return _agg_elem_dtype(args, scope, func_table)
    f_ta = _resolve_func_ta(kwargs['key'], scope, func_table or {}, 'sum')
    return f_ta.dtype


register_macro_expander('minmax_2arg', try_expand_minmax_2arg)

register_expr_builtin('sum', push_sum, None, temps_fn=_make_temps('sum', lambda ta: ta.dtype, 'sum'),
                       return_dtype_fn=_sum_result_dtype, dtype_fn_wants_ctx=True)
register_expr_builtin('min', push_min_list, None, temps_fn=_make_temps('agg', lambda ta: ta.dtype, 'min'),
                       return_dtype_fn=_agg_elem_dtype)
register_expr_builtin('max', push_max_list, None, temps_fn=_make_temps('agg', lambda ta: ta.dtype, 'max'),
                       return_dtype_fn=_agg_elem_dtype)
register_expr_builtin('any', push_any_list, 'i32', temps_fn=_make_temps('anyall', lambda ta: 'i32'))
register_expr_builtin('all', push_all_list, 'i32', temps_fn=_make_temps('anyall', lambda ta: 'i32'))
# sorted() tra ve 1 CONTAINER -> return_shape de bien nhan ket qua duoc
# khai bao dung hinh dang VA tang parser giu duoc kenh known_shapes.
register_expr_builtin('sorted', push_sorted, None, return_shape='list',
                       return_dtype_fn=_agg_elem_dtype, temps_fn=_temps_sorted)


def push_reversed(args, scope, out, dtype, ctx):
    """`reversed(xs)` - ban sao list DA DAO CHIEU (2026-09-30).

    Python tra ve 1 iterator; TokenVector khong co iterator, nen tra ve 1
    LIST copy theo thu tu nguoc. Dung duoc cho ca hai dang:
        for v in reversed(xs): ...     (fix biet 'for p in sorted(xs)' loi)
        ys = reversed(xs)               (nhu sorted)
    Khong sua list goc - giong Python.
    """
    if len(args) != 1:
        raise SyntaxError("il_codegen: reversed(xs) nhan dung 1 tham so")
    name, ta = _agg_arg_ta(args, scope, 'reversed')
    reject_if_handle_type_elem(ta, ctx.get('extern_class_defs'), 'reversed')
    list_type = il_list_type(ta.dtype, ctx.get('records'))
    # List<...> moi tren stack, sau do dao bang AsSpan().Reverse() roi
    # gan nguoc lai - tranh phai sinh vong lap thu cong.
    ctx['load_var_ref'](name, scope, out)
    out.append(f'    newobj instance void {list_type}::.ctor(class '
               f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    # List<T> co san instance method Reverse() - khong can AsSpan() (dong
    # `Span\`1<!0>` trong chu ky khai bao lam ilasm bao loi cu phap).
    out.append('    dup')
    out.append(f'    callvirt instance void {list_type}::Reverse()')


register_expr_builtin('reversed', push_reversed, None, return_shape='list',
                      return_dtype_fn=_agg_elem_dtype)
