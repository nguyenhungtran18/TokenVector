# -*- coding: utf-8 -*-
# getattr / setattr / hasattr va format() (2026-09-30)
#
# BA LOI AM THANH da duoc sua - ca ba deu BIEN DICH XANH roi ra gia tri sai
# hoac nem loi luc CHAY, khong bao gi o bien dich:
#
# 1. `getattr` duoc dang ky return_dtype CUNG la 'str'. Field `i32` thi bi
#    doc bang kieu chuoi -> IL lech kieu -> NullReferenceException luc chay.
#    Nay la ly do can `return_dtype_fn` (suy kieu tu ban ghi field that).
# 2. `setattr` phat `stfld` xong con them `pop`, nhung `stfld` da tieu ca
#    object lan value -> stack hu -> InvalidProgramException.
# 3. `_py_spec_to_net` tra ve NGUYEN VAN `.2f` cho `Double.ToString`, nen
#    `format(3.14159, ".2f")` ra "32f". Cham do ro rat dau: .NET doc chuoi
#    nhieu ky tu thanh CUSTOM format ('.' = dau thap phan, '2' = cho so chu
#    so, 'f' = ky tu thuong). .NET can `F2`.
__tkv_import__ = ["tkv_test_lib"]


class Pt:
    x: "i32"
    s: "str"


def run() -> "i32":
    total = 0
    tested = 0
    o = Pt(1, "a")

    # --- getattr doc field nhieu kieu, moi kieu mot lan ---
    v = getattr(o, "x")
    tested = tested + 1
    total = total + check("getattr_i32", str(v), "1")
    t = getattr(o, "s")
    tested = tested + 1
    total = total + check("getattr_str", str(t), "a")

    # --- setattr gan field (kieu i32) ---
    ok = setattr(o, "x", 42)
    tested = tested + 1
    total = total + check("setattr_then_read", str(o.x), "42")
    # doc lai bang getattr de chan dong duong doc moi
    w = getattr(o, "x")
    tested = tested + 1
    total = total + check("getattr_after_setattr", str(w), "42")

    # --- field khong ton tai: co default / khong co default ---
    d = getattr(o, "zz", 7)
    tested = tested + 1
    total = total + check("getattr_default_int", str(d), "7")
    ds = getattr(o, "zz", "fallback")
    tested = tested + 1
    total = total + check("getattr_default_str", str(ds), "fallback")

    # --- hasattr ---
    h1 = hasattr(o, "x")
    tested = tested + 1
    total = total + check("hasattr_true", str(h1), "1")
    h2 = hasattr(o, "zz")
    tested = tested + 1
    total = total + check("hasattr_false", str(h2), "0")

    # --- format(): so nguyen, bien va literal ---
    n = 42
    f1 = format(n, "05d")
    tested = tested + 1
    total = total + check("format_zero_pad", str(f1), "00042")
    f2 = format(3.14159, ".2f")
    tested = tested + 1
    total = total + check("format_float_literal", str(f2), "3.14")
    f3 = format(n, "x")
    tested = tested + 1
    total = total + check("format_hex", str(f3), "2a")
    f4 = format(n, ".3f")
    tested = tested + 1
    total = total + check("format_float_on_int", str(f4), "42.000")
    q = 7
    f5 = format(q)
    tested = tested + 1
    total = total + check("format_no_spec", str(f5), "7")

    return test_summary("meta_format_test", total, tested)