__tkv_import__ = ["tkv_test_lib"]


def inner() -> "str":
    raise ValueError("boom")


def outer_reraises() -> "str":
    result = "start"
    try:
        try:
            result = inner()
        except ValueError as e:
            result = "inner_caught:" + str(e)
            raise
    except ValueError as e2:
        result = result + "|outer_caught:" + str(e2)
    return result


def run() -> "i32":
    total = 0
    tested = 0

    tested = tested + 1
    total = total + check("bare_raise_rethrow", outer_reraises(), "inner_caught:boom|outer_caught:boom")

    return test_summary("bare_raise_py_tree_test", total, tested)
