"""GATE CHO P6 tren `for i in range(n)` (2026-10-14).

`_p6_vectorize_while` trong `control_flow.tkv` (2026-09-29) CHI bam duong
`while`. Do do vong `for i in range(n): r[i] = a[i] + b[i]` - dang vong lap
Python-idiomatic nhat, va dang TokenVector sinh ra nhieu - chay SCALAR. Do lai
2026-10-14 tren cung mot khoi viec `f32buf`:

    while i < n   (P6 co chay)   0.136 ms
    for i in range(n)  (scalar)   0.44 - 0.53 ms     -> cham hon 3.1 - 3.9x

`_p6_vectorize_for` bo sung duong nay. KHONG nhan bien dich rieng cho `for`:
ca hai duong phat IL bang CHUNG `_p6_vec_phat`, khac nhau chi o `tang_iv` -
`while` giu phep tang trong than, `for` thi `codegen_for` vua phat phep tang do
o sau khoi than nen P6 phat them.

**MOI ham deu tien VAO `r` bang -999.0 truoc khi chay vong lap.** Bo dem
`f32buf` sinh bang `Marshal.AllocHGlobal` nen vung nho CHUA khoi tao va
thuong tra lai dung khoi da dung truoc do. Neu tien -999.0, mot vong lap that
su bo SOOT phan tu thi gia tri do van la -999.0 - khong the nao la ket qua
dung cua phep cong/nhan - nen loi ra ngay. Bai test dau nay dung ve sai do
82/82. Chi mot lan do moi bat duoc loi thu nghiem.

Xem them `p6_vectorize_test.tkv` cho duong `while`.
"""

__tkv_import__ = ["tkv_test_lib"]


def for_add_case(n: "i32") -> "i32":
    """`for i in range(n): r[i] = a[i] + b[i]`."""
    a = f32buf(n)
    b = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 1.5
        r[i] = -999.0
        i = i + 1
    i = 0
    while i < n:
        b[i] = 2.25
        i = i + 1
    for i in range(n):
        r[i] = a[i] + b[i]
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    t = 0
    while t < n:
        w = w + str(3.75) + ";"
        t = t + 1
    return check("for_add n=" + str(n), s, w)


def for_scale_case(n: "i32") -> "i32":
    """Broadcast hang so tren `for`: `r[i] = a[i] * 1.5 + 1.0`."""
    a = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 2.0
        r[i] = -999.0
        i = i + 1
    for i in range(n):
        r[i] = a[i] * 1.5 + 1.0
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    t = 0
    while t < n:
        w = w + str(4.0) + ";"
        t = t + 1
    return check("for_scale n=" + str(n), s, w)


def for_copy_case(n: "i32") -> "i32":
    """Ve phai don `r[i] = a[i]` - va KHOI TAO bien dem `i` cua vong `for`.

    P6 phai tu phat `ldc.i4.0 + store_var` truoc vong vector. Neu bo qua,
    `i` la bien chua khoi tao va ket qua khong lap y."""
    a = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 3.0
        r[i] = -999.0
        i = i + 1
    for i in range(n):
        r[i] = a[i]
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    t = 0
    while t < n:
        w = w + str(3.0) + ";"
        t = t + 1
    return check("for_copy n=" + str(n), s, w)


def for_chain_case(n: "i32") -> "i32":
    """Nhieu toan tu: `r[i] = a[i] + b[i] - c[i]`."""
    a = f32buf(n)
    b = f32buf(n)
    c = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 1.0
        r[i] = -999.0
        i = i + 1
    i = 0
    while i < n:
        b[i] = 2.0
        i = i + 1
    i = 0
    while i < n:
        c[i] = 0.5
        i = i + 1
    for i in range(n):
        r[i] = a[i] + b[i] - c[i]
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    t = 0
    while t < n:
        w = w + str(2.5) + ";"
        t = t + 1
    return check("for_chain n=" + str(n), s, w)


def for_range_ab(n: "i32") -> "i32":
    """`range(1, n)` - P6 phai TU CHOI, van phai ra dung ket qua.

    r[0] giu -999.0; r[1..n-1] = 4.0."""
    a = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 2.0
        r[i] = -999.0
        i = i + 1
    for i in range(1, n):
        r[i] = a[i] * 2.0
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = "-999.0;"
    t = 1
    while t < n:
        w = w + str(4.0) + ";"
        t = t + 1
    return check("for_range_ab n=" + str(n), s, w)


def for_range_step(n: "i32") -> "i32":
    """`range(0, n, 2)` - buoc 2, P6 phai TU CHOI (chi nhan buoc 1)."""
    a = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 1.0
        r[i] = -999.0
        i = i + 1
    for i in range(0, n, 2):
        r[i] = a[i] + 5.0
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    t = 0
    while t < n:
        if t == 1 or (t % 2) == 1:
            w = w + str(-999.0) + ";"
        else:
            w = w + str(6.0) + ";"
        t = t + 1
    return check("for_range_step n=" + str(n), s, w)


def for_break_case(n: "i32") -> "i32":
    """`break` trong than `for` nhieu lenh - P6 phai TU CHOI."""
    xs: "list[i32]" = []
    for i in range(n):
        if i == 3:
            break
        xs.append(i)
    return check("for_break n=" + str(n), str(len(xs)), "3")


def for_continue_case(n: "i32") -> "i32":
    """`continue` trong than `for` nhieu lenh - P6 phai TU CHOI."""
    xs: "list[i32]" = []
    for i in range(n):
        if i == 2:
            continue
        xs.append(i)
    return check("for_continue n=" + str(n), str(len(xs)), str(n - 1))


def for_two_stmts_case(n: "i32") -> "i32":
    """Than `for` HAI lenh - P6 phai TU CHOI (chi nhan dung MOT lenh)."""
    r = f32buf(n)
    i = 0
    while i < n:
        r[i] = -999.0
        i = i + 1
    for i in range(n):
        r[i] = 1.0
        r[i] = 2.0
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    t = 0
    while t < n:
        w = w + str(2.0) + ";"
        t = t + 1
    return check("for_two_stmts n=" + str(n), s, w)


def run() -> "i32":
    total = 0
    # Chia het 4: het vong vector, khong con duoi scalar.
    total += for_add_case(4)
    total += for_add_case(8)
    total += for_add_case(16)
    # KHONG chia het 4 + rong: duoi scalar phai lam phan con lai dung.
    total += for_add_case(0)
    total += for_add_case(1)
    total += for_add_case(2)
    total += for_add_case(3)
    total += for_add_case(5)
    total += for_add_case(7)
    total += for_add_case(9)
    total += for_add_case(15)
    total += for_add_case(17)
    total += for_add_case(33)
    # Broadcast hang so va nhieu toan tu tren `for`.
    total += for_scale_case(0)
    total += for_scale_case(4)
    total += for_scale_case(9)
    total += for_scale_case(17)
    total += for_chain_case(9)
    total += for_chain_case(17)
    # Ve phai don + khoi tao bien dem cua vong `for`.
    total += for_copy_case(1)
    total += for_copy_case(5)
    total += for_copy_case(16)
    # Cac dang P6 phai TU CHOI, nhung van phai ra dung ket qua.
    total += for_range_ab(1)
    total += for_range_ab(9)
    total += for_range_step(9)
    total += for_break_case(10)
    total += for_continue_case(10)
    total += for_two_stmts_case(5)
    return test_summary("p6_for_vectorize_test", total, 28)