# -*- coding: utf-8 -*-
# Khoa loi "ghi bang chi so TINH TOAN" (2026-10-12).
#
# 'r[k * stride] = v' bien dich thanh List`1<float64>::set_Item(int32, !0).
# Bieu thuc chi so co bien dem la i64 nen compiler phat:
#     conv.i8 -> mul.ovf -> add.ovf     (ket qua la INT64 tren stack)
# Ma set_Item nhan int32. THIEU 'conv.ovf.i4' ngay truoc lenh goi thi
# day int64 vao tham so int32 -> IL SAI (kich thuoc stack lech).
#
# NOI doc 'a[i]' DA co conv.ovf.i4 (qua emit_index_scalar), nen chi ghi la
# hong - doc/ghi lech nhau trong cung mot file.
#
# Loi KHONG lo ra khi chay: CLR JIT khong verify IL, gia tri lai vua khop
# int32 nen ket qua van DUNG. `ilasm`/peverify moi bat. Do do test nay co
# MOT phan kiem HANH VI co gia tri that, va MOT phan kiem IL (dong 'Must'
# trong tools/testkit_gate.ps1 - buoc doc .il la cach phan biet duoc).
#
# DOC LAI LUON bang chi so HAN SO (r[0], r[2], r[4], r[6]) de trong .il chi
# con MOT cho 'conv.ovf.i4' - do cai do, va do luon do thuoc nhanh GHI.
__tkv_import__ = ["tkv_test_lib"]

def _new_list() -> "list[f64]":
    r = []
    i = 0
    while i < 8:
        r.append(0.0)
        i = i + 1
    return r


def _case_mul(r: "list[f64]") -> "i32":
    k = 0
    while k < 4:
        r[k * 2] = 1.0
        k = k + 1
    return 0


def _case_add(r: "list[f64]") -> "i32":
    k = 0
    while k < 4:
        r[k + k] = 2.0
        k = k + 1
    return 0


def _expect(r: "list[f64]", want: "f64", tag: "str", total: "i32", tested: "i32") -> "i32":
    tested = tested + 1
    total = total + check(tag + "_0", str(r[0]), str(want))
    tested = tested + 1
    total = total + check(tag + "_2", str(r[2]), str(want))
    tested = tested + 1
    total = total + check(tag + "_4", str(r[4]), str(want))
    tested = tested + 1
    total = total + check(tag + "_6", str(r[6]), str(want))
    return total


def run() -> "i32":
    total = 0
    tested = 0

    rm = _new_list()
    _case_mul(rm)
    total = tested = _expect(rm, 1.0, "mul", total, tested)

    ra = _new_list()
    _case_add(ra)
    total = tested = _expect(ra, 2.0, "add", total, tested)

    return test_summary("index_store_narrow_test", total, tested)