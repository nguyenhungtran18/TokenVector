# -*- coding: utf-8 -*-
"""GATE CHO: ten method cua RECORD trung ten method cua CONTAINER (2026-09-29).

Line parser cua container (`s.add(x)`, `d.update(o)`, `b.extend(o)`,
`x.clear()`...) chay TRUOC `method_call_stmt` tong quat, va khi kieu cua
bien CHUA BIET o tang parse (local gan tu constructor record) thi chung
biet `rec.add(1)` la `set.add(1)`. Hau qua KHONG phai loi so mau ma la
chay SAI hoac bao loi vong nhat:

- `rec.add(1)` -> `literal '1' khong dung voi dtype 'TenRecord'`;
- `rec.clear()` -> "'.clear()' chi ho tro list/dict";
- `rec.update(1)` -> macro viet lai thanh `for k, v in 1.items()`;
- `rec.extend(1)` -> "bien '1' chua duoc khai bao".

Da ton tai san khuon R4/D6 (guard o line parser + fallback o codegen cho
`list.append/remove/insert`, va tap `_known_record_vars` cho macro tang
van ban). Lan nay dong nhat cho `set.add`, `container_clear`,
`dict.update`, va `list.extend` - va dong ca kenh "kieu da biet" cho moi
line parser: `_expand_macros` da quet tap bien nao la record, nen dua
chung vao `known_shapes` de parser co thay ngay tu dong len.

Gia tri mong doi tinh tay (moi method deu cong `v` vao `self.n`, tru
`remove`/`discard` tru `v`).
"""

__tkv_import__ = ["tkv_test_lib"]


class Bag:
    n: "i32"

    def __init__(self, n: "i32") -> "i32":
        self.n = n
        return 0

    def add(self, v: "i32") -> "i32":
        self.n = self.n + v
        return 0

    def append(self, v: "i32") -> "i32":
        self.n = self.n + v
        return 0

    def remove(self, v: "i32") -> "i32":
        self.n = self.n - v
        return 0

    def discard(self, v: "i32") -> "i32":
        self.n = self.n - v
        return 0

    def insert(self, i: "i32", v: "i32") -> "i32":
        self.n = self.n + v
        return 0

    def extend(self, other: "i32") -> "i32":
        self.n = self.n + other
        return 0

    def clear(self) -> "i32":
        self.n = 0
        return 0

    def sort(self) -> "i32":
        self.n = self.n + 1
        return 0

    def reverse(self) -> "i32":
        self.n = self.n + 1
        return 0

    def update(self, v: "i32") -> "i32":
        self.n = self.n + v
        return 0

    def pop(self) -> "i32":
        self.n = self.n + 1
        return 0


def names_add() -> "i32":
    b = Bag(0)
    b.add(5)
    return check("add", str(b.n), "5")


def names_append() -> "i32":
    b = Bag(0)
    b.append(5)
    return check("append", str(b.n), "5")


def names_remove_discard() -> "i32":
    b = Bag(0)
    b.remove(2)
    c = Bag(0)
    c.discard(2)
    return check("remove", str(b.n), "-2") + check("discard", str(c.n), "-2")


def names_insert() -> "i32":
    b = Bag(0)
    b.insert(0, 3)
    return check("insert", str(b.n), "3")


def names_extend_literal() -> "i32":
    b = Bag(0)
    b.extend(4)
    return check("extend voi literal", str(b.n), "4")


def names_extend_var() -> "i32":
    b = Bag(0)
    other = 4
    b.extend(other)
    return check("extend voi bien", str(b.n), "4")


def names_clear() -> "i32":
    b = Bag(7)
    b.clear()
    return check("clear", str(b.n), "0")


def names_sort_reverse() -> "i32":
    b = Bag(0)
    b.sort()
    c = Bag(0)
    c.reverse()
    return check("sort", str(b.n), "1") + check("reverse", str(c.n), "1")


def names_update_literal() -> "i32":
    b = Bag(0)
    b.update(7)
    return check("update voi literal", str(b.n), "7")


def names_update_var() -> "i32":
    b = Bag(0)
    other = 7
    b.update(other)
    return check("update voi bien", str(b.n), "7")


def names_pop() -> "i32":
    b = Bag(0)
    b.pop()
    return check("pop", str(b.n), "1")


def container_still_works() -> "i32":
    """Container THAT su phai van chay - guard moi khong duoc lam hong chung."""
    total = 0
    xs = [1, 2, 3]
    xs.append(4)
    total += check("list.append", str(len(xs)), "4")
    more = [5]
    xs.extend(more)
    total += check("list.extend", str(len(xs)), "5")
    xs.clear()
    total += check("list.clear", str(len(xs)), "0")
    s = set()
    s.add(9)
    total += check("set.add", str(len(s)), "1")
    d = {"a": 1}
    extra = {"b": 2}
    d.update(extra)
    total += check("dict.update", str(len(d)), "2")
    return total


def run() -> "i32":
    total = 0
    total += names_add()
    total += names_append()
    total += names_remove_discard()
    total += names_insert()
    total += names_extend_literal()
    total += names_extend_var()
    total += names_clear()
    total += names_sort_reverse()
    total += names_update_literal()
    total += names_update_var()
    total += names_pop()
    total += container_still_works()
    # 1 + 1 + 2 + 1 + 1 + 1 + 1 + 2 + 1 + 1 + 1 + 5
    return test_summary("record_method_name_collision_test", total, 18)
