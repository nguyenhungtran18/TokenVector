# -*- coding: utf-8 -*-
"""GATE CHO builtin `f32(x)` (2026-10-26, YEU CAU 1.1 spec M4-M7).

`f32(x)` ep mot gia tri bat ki ve kieu `f32` - noi dung ma team Inference can
de viet `.tkv` bang f32 thay vi `list[f64]` boxing (xem
docs/COMPILER_TEAM_REQUEST.md - nguyen nhan wrapper 76-89% BUILD+ACC+ALLOC).

Doi xung voi `float(x)`/`int(x)` (xem float_builtin.tkv):

  f32 -> f32  : khong sinh lenh, NHUNG van phai compile doi so (gia tri phai
                len stack - ban nhap dau tien return rong lam stack rong,
                do la chinh bug ma test nay chan).
  f64 -> f32  : ldc.r8 + conv.r4.
  i32/i64     : conv.i4/conv.i8 + conv.r4.
  int (TkvInt): ToF64 + conv.r4 (conv truc tiep tren struct la SAI).
  str         : TkvStr::ParseF64 + conv.r4 (nhan 'inf'/'nan', khong nho locale).

Gia tri mong doi tinh tay: moi phep toan tren bien `f32` phai di het tren
float32 (ldc.r4/conv.r4), nen str() ket qua la G7 cua Single.
"""

__tkv_import__ = ["tkv_test_lib"]


def from_f64() -> "i32":
    total = 0
    tested = 0
    a: "f64" = 1.5
    v = f32(a)
    total += check("f64_to_f32", str(v), "1.5")
    tested += 1
    b: "f64" = 0.1 + 0.2
    w = f32(b)
    # 0.30000000000000004 (f64) -> 0.3 (f32): ep thuc su xay ra.
    total += check("f64_narrowing", str(w), "0.3")
    tested += 1
    return total


def identity_f32_to_f32() -> "i32":
    """f32(x) voi x da la f32 van PHAI push doi so len stack."""
    total = 0
    tested = 0
    x: "f32" = 2.5
    y = f32(x)
    total += check("f32_identity_value", str(y), "2.5")
    tested += 1
    # Neu identity return rong -> stack lech, phep toan sau do doc SAI gia tri
    # (khong phai loi bien dich ma la loi stack). Phep toan nay bat loi do.
    z: "f32" = f32(x) * 4.0
    # str() cua f32 dung repr Python-style -> so nguyen duoc in '10.0'.
    total += check("f32_identity_in_expr", str(z), "10.0")
    tested += 1
    return total


def from_integers() -> "i32":
    total = 0
    tested = 0
    v = f32(7)
    total += check("i32_literal", str(v), "7.0")
    tested += 1
    n: "i64" = 123456789
    w = f32(n)
    # 123456789 khong dai day tren float32 (lan gan gan nhat 123456784) va
    # str() in theo repr f32 -> chu ky ngan, khong phai so day cua i64.
    total += check("i64_variable", str(w), "1.2345679e+08")
    tested += 1
    return total


def from_string() -> "i32":
    total = 0
    tested = 0
    v = f32("3.5")
    total += check("str_to_f32", str(v), "3.5")
    tested += 1
    # ParseF64 (khong phai Single.Parse) - nhan 'inf' nhu float() da lam.
    inf = f32("inf")
    total += check("str_inf", str(inf), "inf")
    tested += 1
    return total


def locals_stay_f32() -> "i32":
    """Yeu cau 1.1: `.tkv` ghi duoc `x: "f32" = 1.0` va phep toan o lai f32."""
    total = 0
    tested = 0
    x: "f32" = 1.0
    y: "f32" = x * 2.0
    total += check("f32_local_mul", str(y), "2.0")
    tested += 1
    acc: "f32" = 0.0
    i = 0
    while i < 4:
        acc = acc + x
        i = i + 1
    total += check("f32_local_accum", str(acc), "4.0")
    tested += 1
    return total


def widen_to_f64() -> "i32":
    """f32 tra ve co the dung noi can f64 (auto-widen, khong mat kieu)."""
    total = 0
    tested = 0
    d: "f64" = f32(1.5)
    total += check("f32_widen_f64", str(d), "1.5")
    tested += 1
    return total


def run() -> "i32":
    total = 0
    tested = 0
    total += from_f64()
    total += identity_f32_to_f32()
    total += from_integers()
    total += from_string()
    total += locals_stay_f32()
    total += widen_to_f64()
    # 2 + 2 + 2 + 2 + 2 + 1 = 11
    return test_summary("f32_builtin_test", total, 11)
