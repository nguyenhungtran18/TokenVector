# -*- coding: utf-8 -*-
# `iter(xs)` + `next(it)` / `next(it, default)` (2026-10-02).
#
# `for` da duoc dich thang bang vong lap CIL nen 2 ham nay khong de ve vong
# lap - chung cho trang thai thu cong: doc 2 iterable song song, va Kiem TRA
# het du lieu bang `next(it, default)` thay vi loi.
#
# Moi gia tri ky vong deu da doi chieu voi CPython 3.14 (chay cung file .py
# ben canh de doi).
__tkv_import__ = ["tkv_test_lib"]


def read_all(a: "list[i32]") -> "str":
    """Duyet het bang iterator, ghep lai - kiem ca gia tri, ca THU TU.

    Coi `default` la 1 bien dich phai CUNG dtype voi phan tu cua list, nen
    o day phai la so (`-1`), khong phai `""` - xem docs/REFERENCE.md."""
    it = iter(a)
    out = ""
    v = next(it, -1)
    while v != -1:
        out = out + str(v)
        v = next(it, -1)
    return out


def sum_via_next(a: "list[i32]") -> "i32":
    it = iter(a)
    s = 0
    for i in range(len(a)):
        s = s + next(it)
    return s


def two_iterators(a: "list[i32]", b: "list[i32]") -> "i32":
    """2 iterator doc lap tren 2 list khac nhau - khong dung chung con tro."""
    ia = iter(a)
    ib = iter(b)
    s = 0
    for i in range(len(a)):
        s = s + next(ia) * 10 + next(ib)
    return s


def alias_same_list(a: "list[i32]") -> "i32":
    """`iter(xs)` 2 lan tren MOT list -> 2 con tro doc lap, ca hai deu bat
    dau tu dau. Python: iter(list) tra 1 object moi moi lan."""
    p = iter(a)
    q = iter(a)
    return next(p) + next(q)


def sees_mutation(a: "list[i32]") -> "i32":
    """Con tro doc CHUNG 1 List<T> nen `append` giua chung van duoc thay."""
    it = iter(a)
    a.append(40)
    s = next(it) + next(it) + next(it)
    tail = next(it, 0)
    return s * 100 + tail


def default_only_when_empty(a: "list[i32]") -> "i32":
    """`default` CHI duoc tinh o nhanh het du lieu (giong CPython)."""
    it = iter(a)
    hit = next(it, -1)
    miss = next(it, -2)
    return hit * 10 + miss


def catches_stop(a: "list[i32]") -> "i32":
    it = iter(a)
    for i in range(len(a)):
        next(it)
    try:
        next(it)
        return -1
    except StopIteration as err:
        if len(str(err)) > 0:
            return 1
        return 0


def strings(a: "list[str]") -> "str":
    it = iter(a)
    head = next(it, "")
    tail = next(it, "<none>")
    return head + "/" + tail


# --- nguon KHAC list (2026-10-02): str / set / dict ---
def str_iter(s: "str") -> "str":
    """`iter("abc")` cho 'a', 'b', 'c' - dung nghia Python."""
    it = iter(s)
    out = ""
    v = next(it, "")
    while v != "":
        out = out + v + "."
        v = next(it, "")
    return out


def str_iter_empty(s: "str") -> "i32":
    it = iter(s)
    a = next(it, "Z")
    return len(a)


def set_iter() -> "i32":
    """`iter(set)` - thu tu KHONG dinh, nen cong lai de so sanh duoc."""
    s = {5, 6, 7}
    it = iter(s)
    t = 0
    for i in range(3):
        t = t + next(it, 0)
    return t


def dict_iter() -> "str":
    """`iter(dict)` cho KHOA (khong phai gia tri) - dung nghia Python."""
    d = {"k1": 1, "k2": 2}
    it = iter(d)
    a = next(it, "")
    b = next(it, "")
    c = next(it, "")
    return a + "|" + b + "|" + c


def run() -> "i32":
    total = 0
    tested = 0

    tested = tested + 1
    total = total + check("read_all", read_all([10, 20, 30]), "102030")
    tested = tested + 1
    total = total + check("read_all_empty", read_all([]), "")
    tested = tested + 1
    total = total + check("sum_via_next", str(sum_via_next([4, 5, 6])), "15")
    tested = tested + 1
    total = total + check("sum_empty", str(sum_via_next([])), "0")
    tested = tested + 1
    total = total + check("two_iterators", str(two_iterators([1, 2, 3], [7, 8, 9])), "84")
    tested = tested + 1
    total = total + check("alias_same_list", str(alias_same_list([5, 6])), "10")
    tested = tested + 1
    total = total + check("sees_mutation", str(sees_mutation([1, 2, 3])), "640")
    tested = tested + 1
    total = total + check("default_shape", str(default_only_when_empty([7, 8])), "78")
    tested = tested + 1
    total = total + check("default_after_end", str(default_only_when_empty([7])), "68")
    tested = tested + 1
    total = total + check("catch_stop_iteration", str(catches_stop([1, 2])), "1")
    tested = tested + 1
    total = total + check("strings", strings(["k", "m", "z"]), "k/m")
    tested = tested + 1
    total = total + check("strings_default", strings([]), "/<none>")
    tested = tested + 1
    total = total + check("str_source", str_iter("abc"), "a.b.c.")
    tested = tested + 1
    total = total + check("str_source_empty", str(str_iter_empty("")), "1")
    tested = tested + 1
    total = total + check("set_source", str(set_iter()), "18")
    tested = tested + 1
    total = total + check("dict_source_keys", dict_iter(), "k1|k2|")

    return test_summary("iter_next_test", total, tested)