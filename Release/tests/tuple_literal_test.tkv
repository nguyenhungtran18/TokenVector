# -*- coding: utf-8 -*-
"""Tuple literal `(1, 2)` va `for a, b in ...` (2026-09-29).

GHI CHU CU trong docs/PLAN.md ("Tuple literal - thiet ke, DSL KHONG co kieu
tuple") DA CU: kieu tuple CO that, va da ho tro nhieu phan:
- `def f() -> "(i32, i32)": return 3, 4`            -> chay
- `a, b = f()` (pha huy ket qua tra ve)             -> chay
- `for_in_iter` dung `__next__() -> "(T, i32)"`     -> chay
- doc truc tiep phan tu: `ldfld !0 ...::Item1`      -> chay

Thieu 3 thu, va day la thu thuc su can lam:
1. LITERAL `(1, 2)` o vi tri bieu thuc. `il_core.tkv` bao
   "ky vong ')', gap ','" - `(` duoc xu ly nhu dau ngoac nhom, khong phai
   dau mo tuple.
2. KHAI BAO local kieu tuple khi gan literal.
3. `for a, b in <nguon>` - vong lap co 2 bien, thay the 1 bien.

Gia tri mong doi tinh tay, doi chieu CPython 3.11.
"""
__tkv_import__ = ["tkv_test_lib"]


def take_pair(p: "(i32, i32)") -> "i32":
    a = p[0]
    b = p[1]
    return a * 10 + b


# ---------------- literal + pha huy ----------------

def lit_destructure() -> "str":
    a, b = (3, 4)
    return str(a) + "/" + str(b)


def lit_three() -> "str":
    x, y, z = (1, 2, 3)
    return str(x) + "/" + str(y) + "/" + str(z)


def lit_swap() -> "str":
    a = 3
    b = 4
    a, b = b, a
    return str(a) + "/" + str(b)


# ---------------- literal trong bieu thuc ----------------

def lit_nested() -> "str":
    inner = (7, 8)
    x, y = inner
    return str(x) + "/" + str(y)


def lit_direct_call() -> "str":
    return str(take_pair((1, 2)))


# ---------------- for co 2 bien ----------------

def sum_pairs() -> "i32":
    total = 0
    for i, j in [(1, 2), (3, 4), (5, 6)]:
        total = total + i + j
    return total


def join_pairs() -> "str":
    out = ""
    for i, j in [(1, 2), (3, 4)]:
        out = out + str(i) + "-" + str(j) + ";"
    return out


def run() -> "i32":
    total = 0
    tested = 0

    tested = tested + 1
    total = total + check("literal_destructure", lit_destructure(), "3/4")

    tested = tested + 1
    total = total + check("literal_three_parts", lit_three(), "1/2/3")

    tested = tested + 1
    total = total + check("literal_in_local", lit_nested(), "7/8")

    tested = tested + 1
    total = total + check("literal_swap", lit_swap(), "4/3")

    tested = tested + 1
    total = total + check("literal_as_call_arg", lit_direct_call(), "12")

    tested = tested + 1
    total = total + check("for_two_vars_sum", str(sum_pairs()), "21")

    tested = tested + 1
    total = total + check("for_two_vars_join", join_pairs(), "1-2;3-4;")

    return test_summary("tuple_literal_test", total, tested)
