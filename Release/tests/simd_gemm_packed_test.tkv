# -*- coding: utf-8 -*-
"""GATE CHO `simd_gemm_packed_*` (M4, SPEC M4-M7 §2).

Prepack weight 1 lan / step thay vi dung lai moi call:
  h = simd_gemm_packed_create(src, rows, cols, stride, T, trans) -> i64
  simd_gemm_packed(hA, hB, C, T) -> i32 (0 = OK; loi thi throw ro)
  simd_gemm_packed_free(h) -> i64 (tra 0)

Bai nay kiem 7 dieu:
  1. packed square vs `simd_gemm` -> BIT-EXACT (cung kernel, cung thu tu tich lury).
  2. hinh chu nhat (m x k * k x n) vs reference scalar tinh tay.
  3. trans=1 (pack ban transpose) vs reference scalar.
  4. pad khi rows/cols KHONG boi T (zero-fill khong lam lech ket qua).
  5. loi RO (khong im lang): T khop handle, inner dim, C qua ngan, handle sai.
  6. 2 thread goi dong thoi PHAI thoat (khong hang) - fix re-entrancy §3.1.
  7. ABI f64 (SPEC §6 ask 1): src/C list[f64] - C f64 = duong f32 bit-exact
     (cung kernel) va khop reference scalar (gia tri nguyen duong -> chinh xac tuyet doi).

Gia tri reference tinh tay; doi chieu CPython/song song. Handle i64 gan o
top-level function (quy tac GĐ8).
"""

__tkv_import__ = ["tkv_test_lib"]


def _fill(a: "list[f32]", n: "i32", mo: "i32", buoc: "i32", tru: "i32") -> "i32":
    """i -> gia tri nguyen duong nho (mo + i%buoc - tru) de tranh tran f32."""
    i = 0
    while i < n:
        a.append(float((i % buoc) + mo - tru))
        i = i + 1
    return 0


def _ref_gemm(a: "list[f32]", b: "list[f32]", c: "list[f32]", m: "i32", n: "i32", k: "i32") -> "i32":
    """reference scalar: C(m x n) = A(m x k) * B(k x n), row-major, f32."""
    i = 0
    while i < m:
        j = 0
        while j < n:
            s: "f32" = 0.0
            p = 0
            while p < k:
                s = s + a[i * k + p] * b[p * n + j]
                p = p + 1
            c.append(s)
            j = j + 1
        i = i + 1
    return 0


def _maxdiff(x: "list[f32]", y: "list[f32]", n: "i32") -> "f64":
    md: "f64" = 0.0
    i = 0
    while i < n:
        d = float(x[i]) - float(y[i])
        if d < 0.0:
            d = -d
        if d > md:
            md = d
        i = i + 1
    return md


def _maxdiff_f64(x: "list[f64]", y: "list[f32]", n: "i32") -> "f64":
    """max |x - y| voi x list[f64], y list[f32] (so sanh C f64 vs duong f32)."""
    md: "f64" = 0.0
    i = 0
    while i < n:
        d = x[i] - float(y[i])
        if d < 0.0:
            d = -d
        if d > md:
            md = d
        i = i + 1
    return md


def packed_square_vs_simd() -> "i32":
    """1) packed square vs simd_gemm: phai BIT-EXACT (maxdiff 0)."""
    total = 0
    n: "i32" = 32
    m = n * n
    a: "list[f32]" = []
    b: "list[f32]" = []
    c_pack: "list[f32]" = []
    c_simd: "list[f32]" = []
    _fill(a, m, 3, 7, 3)
    _fill(b, m, 2, 5, 2)
    i = 0
    while i < m:
        c_pack.append(0.0)
        c_simd.append(0.0)
        i = i + 1
    hA: "i64" = simd_gemm_packed_create(a, n, n, n, n, 0)
    hB: "i64" = simd_gemm_packed_create(b, n, n, n, n, 0)
    total += check("square_handle_tao", str(int(hA > 0 and hB > 0)), "1")
    rc = simd_gemm_packed(hA, hB, c_pack, n)
    total += check("square_run_ok", str(rc), "0")
    simd_gemm(a, b, c_simd, n)
    total += check("square_vs_simd_bitexact", str(_maxdiff(c_pack, c_simd, m)), "0.0")
    simd_gemm_packed_free(hA)
    simd_gemm_packed_free(hB)
    return total


def packed_rect() -> "i32":
    """2) hinh chu nhat: m x k * k x n, T khong chia het cac canh."""
    total = 0
    m: "i32" = 5
    k: "i32" = 7
    n: "i32" = 3
    T: "i32" = 4
    a: "list[f32]" = []
    b: "list[f32]" = []
    c_pack: "list[f32]" = []
    c_ref: "list[f32]" = []
    _fill(a, m * k, 2, 6, 2)
    _fill(b, k * n, 1, 5, 1)
    _ref_gemm(a, b, c_ref, m, n, k)
    i = 0
    while i < m * n:
        c_pack.append(0.0)
        i = i + 1
    hA: "i64" = simd_gemm_packed_create(a, m, k, k, T, 0)
    hB: "i64" = simd_gemm_packed_create(b, k, n, n, T, 0)
    rc = simd_gemm_packed(hA, hB, c_pack, T)
    total += check("rect_run_ok", str(rc), "0")
    total += check("rect_vs_ref", str(_maxdiff(c_pack, c_ref, m * n)), "0.0")
    simd_gemm_packed_free(hA)
    simd_gemm_packed_free(hB)
    return total


def packed_trans() -> "i32":
    """3) trans=1: pack ban transpose cua src (rows x cols -> cols x rows)."""
    total = 0
    rows: "i32" = 4
    cols: "i32" = 6
    n: "i32" = 2
    T: "i32" = 4
    src: "list[f32]" = []
    b: "list[f32]" = []
    c_pack: "list[f32]" = []
    c_ref: "list[f32]" = []
    _fill(src, rows * cols, 1, 5, 1)
    # A_trans = src^T = cols x rows; can B2 rows x n de inner dim = rows
    _fill(b, rows * n, 1, 3, 1)
    # reference: A_trans(cols x rows) * B2(rows x n) -> cols x n
    at: "list[f32]" = []
    i = 0
    while i < cols:
        j = 0
        while j < rows:
            at.append(src[j * cols + i])
            j = j + 1
        i = i + 1
    _ref_gemm(at, b, c_ref, cols, n, rows)
    i = 0
    while i < cols * n:
        c_pack.append(0.0)
        i = i + 1
    hA: "i64" = simd_gemm_packed_create(src, rows, cols, cols, T, 1)
    hB: "i64" = simd_gemm_packed_create(b, rows, n, n, T, 0)
    rc = simd_gemm_packed(hA, hB, c_pack, T)
    total += check("trans_run_ok", str(rc), "0")
    total += check("trans_vs_ref", str(_maxdiff(c_pack, c_ref, cols * n)), "0.0")
    simd_gemm_packed_free(hA)
    simd_gemm_packed_free(hB)
    return total


def packed_error_cases() -> "i32":
    """5) loi RO: tung truong hop phai NEM, khong im lang."""
    total = 0
    a: "list[f32]" = []
    b: "list[f32]" = []
    _fill(a, 16, 1, 4, 1)
    _fill(b, 16, 1, 4, 1)
    hA: "i64" = simd_gemm_packed_create(a, 4, 4, 4, 4, 0)
    hB: "i64" = simd_gemm_packed_create(b, 4, 4, 4, 4, 0)

    # T khong khop handle (handle T=4, goi T=8) -> phai nem
    c: "list[f32]" = []
    i = 0
    while i < 16:
        c.append(0.0)
        i = i + 1
    ok_t = 0
    try:
        simd_gemm_packed(hA, hB, c, 8)
        ok_t = 0
    except Exception as e:
        ok_t = 1
    total += check("err_T_khong_khop_nem", str(ok_t), "1")

    # C qua ngan (list rong 3 phan tu, can 16) -> phai nem
    c2: "list[f32]" = []
    c2.append(0.0)
    c2.append(0.0)
    c2.append(0.0)
    ok_c = 0
    try:
        simd_gemm_packed(hA, hB, c2, 4)
        ok_c = 0
    except Exception as e:
        ok_c = 1
    total += check("err_C_qua_ngan_nem", str(ok_c), "1")

    # handle khong hop le (0) -> phai nem
    h0: "i64" = 0
    ok_h = 0
    try:
        simd_gemm_packed(h0, hB, c, 4)
        ok_h = 0
    except Exception as e:
        ok_h = 1
    total += check("err_handle_sai_nem", str(ok_h), "1")

    # inner dim khong khop: A 4x4 nhung B tao 2x4 -> A.n=4 != B.m=2
    b2: "list[f32]" = []
    _fill(b2, 8, 1, 4, 1)
    hB2: "i64" = simd_gemm_packed_create(b2, 2, 4, 4, 4, 0)
    ok_i = 0
    try:
        simd_gemm_packed(hA, hB2, c, 4)
        ok_i = 0
    except Exception as e:
        ok_i = 1
    total += check("err_inner_dim_nem", str(ok_i), "1")

    simd_gemm_packed_free(hA)
    simd_gemm_packed_free(hB)
    simd_gemm_packed_free(hB2)
    return total


def packed_free_idempotent() -> "i32":
    """free tra 0 va goi duoc dang cau lenh (khong gan bien)."""
    total = 0
    a: "list[f32]" = []
    _fill(a, 4, 1, 4, 1)
    h: "i64" = simd_gemm_packed_create(a, 2, 2, 2, 2, 0)
    total += check("free_handle_tao", str(int(h > 0)), "1")
    r = simd_gemm_packed_free(h)
    total += check("free_tra_0", str(r), "0")
    return total


def packed_f64() -> "i32":
    """7) ABI f64 (SPEC §6 ask 1): src/C list[f64] - pack convert double->float
    1 lan trong native; C f64 = ket qua f32 bit-exact (cung handle, cung kernel)."""
    total = 0
    n: "i32" = 32
    m = n * n
    a64: "list[f64]" = []
    b64: "list[f64]" = []
    a32: "list[f32]" = []
    b32: "list[f32]" = []
    c64: "list[f64]" = []
    c32: "list[f32]" = []
    c_ref: "list[f32]" = []
    i = 0
    while i < m:
        va = float((i % 7) + 3 - 3)
        vb = float((i % 5) + 2 - 2)
        a64.append(va)
        b64.append(vb)
        a32.append(va)
        b32.append(vb)
        c64.append(0.0)
        c32.append(0.0)
        i = i + 1
    _ref_gemm(a32, b32, c_ref, n, n, n)
    hA: "i64" = simd_gemm_packed_create(a64, n, n, n, n, 0)
    hB: "i64" = simd_gemm_packed_create(b64, n, n, n, n, 0)
    total += check("f64_handle_tao", str(int(hA > 0 and hB > 0)), "1")
    rc = simd_gemm_packed(hA, hB, c64, n)
    total += check("f64_run_ok", str(rc), "0")
    rc32 = simd_gemm_packed(hA, hB, c32, n)
    total += check("f64_run_f32_cung_handle", str(rc32), "0")
    total += check("f64_vs_f32_bitexact", str(_maxdiff_f64(c64, c32, m)), "0.0")
    total += check("f64_vs_ref", str(_maxdiff_f64(c64, c_ref, m)), "0.0")
    simd_gemm_packed_free(hA)
    simd_gemm_packed_free(hB)
    return total


def _worker_square() -> "i64":
    """Thread worker: chay nhieu lan simd_gemm de test re-entrancy."""
    n: "i32" = 128
    m = n * n
    a: "list[f32]" = []
    b: "list[f32]" = []
    c: "list[f32]" = []
    _fill(a, m, 1, 7, 3)
    _fill(b, m, 1, 5, 2)
    i = 0
    while i < m:
        c.append(0.0)
        i = i + 1
    r = 0
    t = 0
    while t < 5:
        simd_gemm(a, b, c, n)
        t = t + 1
    r = r + int(c[0])
    return r


def packed_reentrancy() -> "i32":
    """6) 2 thread goi simd_gemm dong thoi phai THOAT (khong hang §3.1)."""
    total = 0
    t1 = thread_spawn(_worker_square)
    t2 = thread_spawn(_worker_square)
    r1 = thread_join(t1)
    r2 = thread_join(t2)
    total += check("reentrancy_2thread_thoat", str(int(r1 != 0 and r2 != 0)), "1")
    return total


def run() -> "i32":
    total = 0
    total += packed_square_vs_simd()
    total += packed_rect()
    total += packed_trans()
    total += packed_error_cases()
    total += packed_free_idempotent()
    total += packed_reentrancy()
    total += packed_f64()
    # 3 + 2 + 2 + 4 + 2 + 1 + 5 = 19
    return test_summary("simd_gemm_packed_test", total, 19)
