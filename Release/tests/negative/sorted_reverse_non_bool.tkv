# EXPECT-SUBSTRING: chi nhan gia tri SO
# -*- coding: utf-8 -*-
# `sorted(..., reverse=...)` chi chap nhan gia tri SO/BOOL. Truyen chuoi se
# bien dich `brfalse` tren mot chuoi - IL sai, loi lo ra luc chay.
def f(xs: "list[i32]") -> "str":
    return sorted(xs, reverse="x")


def run() -> "i32":
    print("should_not_build")
    return len(f([1, 2]))