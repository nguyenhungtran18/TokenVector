# EXPECT-SUBSTRING: simd_axpy chi ho tro mang
# -*- coding: utf-8 -*-
# simd_axpy chi co ban MANG (AxpyF32(float32, float32[], float32[])).
# Truyen `list[f32]` se dua doi tuong List vao tham so float32[] - CLR nem
# InvalidProgram/AccessViolation luc CHAY. Nay phai bi tu choi som.

def run() -> "i32":
    x: "list[f32]" = []
    x.append(1.0)
    y: "list[f32]" = []
    y.append(0.0)
    simd_axpy(2.0, x, y)
    return 0
