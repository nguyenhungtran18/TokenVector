# EXPECT-SUBSTRING: chi ho tro f32
# -*- coding: utf-8 -*-
# `simd_gemm_packed_*` chi ho tro f32 (gate spec M4-M7 la fp32). Truyen list[f64]
# phai bi tu choi ngay luc bien dich voi ly do ro - khong duoc dich xong roi moi
# no (native chi pack f32, de im lang se doc nham 4 byte/phan tu -> sai so hoac AV).
def run() -> "i32":
    a: "list[f64]" = []
    a.append(1.0)
    a.append(2.0)
    a.append(3.0)
    a.append(4.0)
    h = simd_gemm_packed_create(a, 2, 2, 2, 2, 0)
    return int(h)
