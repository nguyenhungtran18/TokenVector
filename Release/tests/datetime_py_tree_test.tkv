__tkv_import__ = ["tkv_test_lib"]


def strftime_roundtrip() -> "str":
    d = datetime_strptime("2026-08-11", "%Y-%m-%d")
    return d.strftime("%Y-%m-%d")


def strftime_time_part() -> "str":
    d = datetime_strptime("2026-08-11 13:45:30", "%Y-%m-%d %H:%M:%S")
    return d.strftime("%H:%M:%S")


def add_days() -> "str":
    d = datetime_strptime("2026-08-11", "%Y-%m-%d")
    td = timedelta_days(5)
    d2 = datetime_add(d, td)
    return d2.strftime("%Y-%m-%d")


def sub_hours() -> "str":
    d = datetime_strptime("2026-08-11 10:00:00", "%Y-%m-%d %H:%M:%S")
    td = timedelta_hours(3)
    d2 = datetime_sub(d, td)
    return d2.strftime("%H:%M:%S")


def diff_roundtrip() -> "str":
    d1 = datetime_strptime("2026-08-20", "%Y-%m-%d")
    d2 = datetime_strptime("2026-08-11", "%Y-%m-%d")
    td = datetime_diff(d1, d2)
    d3 = datetime_add(d2, td)
    return d3.strftime("%Y-%m-%d")


def now_add_zero_noop() -> "i32":
    d = datetime()
    zero = timedelta_days(0)
    d2 = datetime_add(d, zero)
    if d == d2:
        return 1
    return 0


def ticks_of_now_plausible() -> "i32":
    d = datetime()
    t = datetime_ticks(d)
    if t > 600000000000000000:
        return 1
    return 0


def run() -> "i32":
    total = 0
    tested = 0

    tested = tested + 1
    total = total + check("strftime_roundtrip", strftime_roundtrip(), "2026-08-11")

    tested = tested + 1
    total = total + check("strftime_time_part", strftime_time_part(), "13:45:30")

    tested = tested + 1
    total = total + check("add_days", add_days(), "2026-08-16")

    tested = tested + 1
    total = total + check("sub_hours", sub_hours(), "07:00:00")

    tested = tested + 1
    total = total + check("diff_roundtrip", diff_roundtrip(), "2026-08-20")

    tested = tested + 1
    total = total + check("now_add_zero_noop", str(now_add_zero_noop()), "1")

    tested = tested + 1
    total = total + check("ticks_of_now_plausible", str(ticks_of_now_plausible()), "1")

    return test_summary("datetime_py_tree_test", total, tested)
