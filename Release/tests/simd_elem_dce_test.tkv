    i = 0
    while i < n:
        if c[i] != a[i] * b[i]:
            ok = 0
        i = i + 1
    total += check("f64_mul", str(ok), "1")

    # simd_scale/axpy chi co ban MANG - xem ghi chu o _test_f32.

    exp: "f64" = 0.0
    i = 0
    while i < n:
        exp = exp + a[i] * b[i]
        i = i + 1
    total += check("f64_dot", str(_gan(float(simd_dot(a, b)), exp, 1.0e-9)), "1")

    exp = 0.0
    i = 0
    while i < n:
        exp = exp + a[i]
        i = i + 1
    total += check("f64_sum", str(_gan(float(simd_sum(a)), exp, 1.0e-9)), "1")

    mx: "f64" = a[0]
    mn: "f64" = a[0]
    i = 0
    while i < n:
        if a[i] > mx:
            mx = a[i]
        if a[i] < mn:
            mn = a[i]
        i = i + 1
    total += check("f64_max", str(int(simd_max(a) == mx)), "1")
    total += check("f64_min", str(int(simd_min(a) == mn)), "1")
    return total


