def _test_isa() -> "i32":
    """native chunk: Isa() phai goi Kern -> Init, khong duoc thieu."""
    total = 0
    isa = simd_isa()
    total += check("isa_trong_0_2", str(int(isa >= 0 and isa <= 2)), "1")
    l32 = simd_lanes_f32()
    total += check("lanes_f32", str(int(l32 == 4 or l32 == 8)), "1")
    l64 = simd_lanes_f64()
    total += check("lanes_f64", str(int(l64 == 2 or l64 == 4)), "1")
    hw = str(simd_hw())
    total += check("hw_la_bool", str(int(hw == "True" or hw == "False")), "1")
    return total


def _test_count() -> "i32":
    """count chunk: simd_count_char khong copy BSTR, so sanh 16-bit."""
    total = 0
    s = "abcdeabcde"
    total += check("count_char_a", str(simd_count_char(s, 97, 10)), "2")
    total += check("count_char_e_4", str(simd_count_char(s, 101, 4)), "0")
    total += check("count_char_clamp", str(simd_count_char(s, 97, 99)), "2")
    total += check("count_char_n0", str(simd_count_char(s, 97, 0)), "0")
    total += check("count_char_n_am", str(simd_count_char(s, 97, -3)), "0")
    return total


def _test_gemm() -> "i32":
    """gemm chunk: matmul alias cua simd_gemm (native AVX2+FMA)."""
    total = 0
    a: "list[f32]" = []
    a.append(1.0)
    a.append(2.0)
    a.append(3.0)
    a.append(4.0)
    b: "list[f32]" = []
    b.append(5.0)
    b.append(6.0)
    b.append(7.0)
    b.append(8.0)
    c: "list[f32]" = []
    c.append(0.0)
    c.append(0.0)
    c.append(0.0)
    c.append(0.0)
    rc = matmul(a, b, c, 2)
    total += check("matmul_rc", str(rc), "0")
    # [[1,2],[3,4]] x [[5,6],[7,8]] = [[19,22],[43,50]]
    total += check("matmul_c0", str(c[0]), "19.0")
    total += check("matmul_c1", str(c[1]), "22.0")
    total += check("matmul_c2", str(c[2]), "43.0")
    total += check("matmul_c3", str(c[3]), "50.0")
    return total


def run() -> "i32":
    total = 0
    total += _test_f32()
    total += _test_f64()
    total += _test_i32()
    total += _test_i64()
    total += _test_isa()
    total += _test_count()
    total += _test_gemm()
    # f32 7 + f64 7 + i32 7 + i64 7 + isa 4 + count 5 + gemm 5 = 42
    return test_summary("simd_elem_dce_test", total, 42)
