# -*- coding: utf-8 -*-
"""GATE CHO DCE `TkvSimd` (2026-11-04).

Truoc day compiler emit CA class TkvSimd (~126 method, ~5200 dong IL) cho moi
chuong trinh, ke ca khi chi goi `matmul`. Nay class duoc sinh DAN theo nhom
tinh nang: `_can_simd(ctx, feat)` chi chen IL cua nhom THAT SU duoc dung.

Bai nay la luoi an toan cho thay doi do:
  1. Moi nhom `elem_*` (f32/f64/i32/i64) phai TU DU: ban mang T[] duoc wrapper
     List<T> goi toi, ban Vector<T> `...V` duoc ban mang goi toi, va `Kern`
     (native chunk) phai duoc keo theo - thieu mot manh la InvalidProgramException
     hoac Method not found luc CHAY, khong phai luc dich.
  2. `native` (simd_isa/simd_hw/simd_lanes) khong duoc keo ca class.
  3. `count` (simd_count_char) dung P/Invoke rieng.
  4. `gemm` (matmul) dung P/Invoke rieng.

Gia tri mong doi tinh bang vong scalar trong test. Voi dot/sum, thu tu cong
cua SIMD (cong theo lane roi moi giam) KHAC scalar nen so sanh bang sai so;
add/sub/mul/scale/axpy/max/min/min la tung phan tu nen phai BIT-EXACT.
"""

__tkv_import__ = ["tkv_test_lib"]


def _mk_f32(n: "i32", seed: "i32") -> "list[f32]":
    out: "list[f32]" = []
    i = 0
    while i < n:
        out.append(float(((i + seed) % 7) - 3) * 0.25)
        i = i + 1
    return out


def _mk_f64(n: "i32", seed: "i32") -> "list[f64]":
    out: "list[f64]" = []
    i = 0
    while i < n:
        out.append(float(((i + seed) % 7) - 3) * 0.5)
        i = i + 1
    return out


def _mk_i32(n: "i32", seed: "i32") -> "list[i32]":
    out: "list[i32]" = []
    i = 0
    while i < n:
        out.append(((i + seed) % 7) - 3)
        i = i + 1
    return out


def _mk_i64(n: "i32", seed: "i32") -> "list[i64]":
    out: "list[i64]" = []
    i = 0
    while i < n:
        out.append(((i + seed) % 9) - 4)
        i = i + 1
    return out


def _zero_f32(n: "i32") -> "list[f32]":
    out: "list[f32]" = []
    i = 0
    while i < n:
        out.append(0.0)
        i = i + 1
    return out


def _zero_f64(n: "i32") -> "list[f64]":
    out: "list[f64]" = []
    i = 0
    while i < n:
        out.append(0.0)
        i = i + 1
    return out


def _zero_i32(n: "i32") -> "list[i32]":
    out: "list[i32]" = []
    i = 0
    while i < n:
        out.append(0)
        i = i + 1
    return out


def _zero_i64(n: "i32") -> "list[i64]":
    out: "list[i64]" = []
    i = 0
    while i < n:
        out.append(0)
        i = i + 1
    return out


def _gan(got: "f64", exp: "f64", tol: "f64") -> "i32":
    """1 neu |got - exp| <= tol (SIMD doi thu tu cong voi dot/sum)."""
    d: "f64" = got - exp
    if d < 0.0:
        d = 0.0 - d
    if d <= tol:
        return 1
    return 0


def _test_f32() -> "i32":
    total = 0
    n: "i32" = 21
    a = _mk_f32(n, 1)
    b = _mk_f32(n, 2)
    c = _zero_f32(n)

    # add / sub / mul: tung phan tu -> bit-exact voi scalar
    simd_add(a, b, c)
    ok = 1
    i = 0
    while i < n:
        if c[i] != a[i] + b[i]:
            ok = 0
        i = i + 1
    total += check("f32_add", str(ok), "1")

    simd_sub(a, b, c)
    ok = 1
    i = 0
    while i < n:
        if c[i] != a[i] - b[i]:
            ok = 0
        i = i + 1
    total += check("f32_sub", str(ok), "1")

    simd_mul(a, b, c)
    ok = 1
    i = 0
    while i < n:
        if c[i] != a[i] * b[i]:
            ok = 0
        i = i + 1
    total += check("f32_mul", str(ok), "1")

    # simd_scale/simd_axpy CHI co ban MANG (khong co wrapper List<T> trong
    # compiler) nen khong goi duoc tu nguon TKV - bo qua o day.

    # dot / sum: doi thu tu cong -> sai so ~1e-7 voi f32, dung tol 1e-4
    exp: "f64" = 0.0
    i = 0
    while i < n:
        exp = exp + float(a[i]) * float(b[i])
        i = i + 1
    total += check("f32_dot", str(_gan(float(simd_dot(a, b)), exp, 1.0e-4)), "1")

    exp = 0.0
    i = 0
    while i < n:
        exp = exp + float(a[i])
        i = i + 1
    total += check("f32_sum", str(_gan(float(simd_sum(a)), exp, 1.0e-4)), "1")

    # max / min: chon phan tu -> bit-exact
    mx: "f32" = a[0]
    mn: "f32" = a[0]
    i = 0
    while i < n:
        if a[i] > mx:
            mx = a[i]
        if a[i] < mn:
            mn = a[i]
        i = i + 1
    total += check("f32_max", str(int(simd_max(a) == mx)), "1")
    total += check("f32_min", str(int(simd_min(a) == mn)), "1")
    return total


