"""GATE CHO P6 buoc 2: TU DONG VECTOR HOA vong lap tren `f32buf` (2026-09-29).

`_p6_vectorize_while` trong `control_flow.tkv` nhan dien MOT DANG vong lap
co dinh:

    n = <gia tri>
    i = 0
    while i < n:
        r[i] = a[i] + b[i]
        i = i + 1

va bien dich no thanh: vong lap buoc 4 (nap `v_load4`, ghi `v_store4`) roi den
duoi scalar cho `n % 4` phan tu con lai. Bien dem ket thuc o `n` y het ban goc
nen code sau vong lap khong nhin thay khac biet gi.

**Bien `n` phai la BIEN, khong phai hang so.** `while i < 8` co dieu kien lai
hang so nen khong khop mau va chay scalar - dung, nhung khong phai thu can
kiem chung. Vi vay moi truong hop du day nhan `n` qua tham so `i32`.

QUY TAC AN TOAN: khi co BAT KY nghi ngo nao thi KHONG vector hoa, chay scalar
binh thuong. Bien doi nay sua SO HOC cua code ma khong he nhac toi vector - mot
loi se khong co trieu chung gi.

Phan `a[i] + b[i]` la phan co THE vector hoa. `mul`/`div` co hang so
(`* 1.5`) **cung duoc vector hoa** (2026-10-14) — hang so duoc broadcast bang
`newobj Vector4::.ctor(f32 x4)`.

**MOI ham deu tien VAO `r` bang -999.0 truoc khi chay vong lap can vector hoa.**
Ly do: bo dem sinh bang `Marshal.AllocHGlobal` nen vung nho CHUA KHOI TAO, va
trinh phan bo thuong tra lai dung khoi da dung truoc do. Khi do mot vong lap
that su bo SOOT phan tu (vi du duoi scalar bi bo qua, hay so phan tu sai) thi
phan tu do van giu gia tri cua lan chay TRUOC - ma lan chay truoc lai la phep
tinh dung - nen ket qua van KHA DUNG va moi test van PASS. Gia tri -999.0 khong
the nao la ket qua dung cua phep cong/nhan, nen phan tu nao khong duoc transform
ghi thi loi ra ngay.

Dau do chinh la thu test do duoc ban "bo qua duoi scalar" ma van PASS 82/82.
Gia tri mong doi deu tinh tay, khong dua vao thu tu cap phat bo dem.

Luu y: ham co the nhan/tra `f32buf` CHUA duoc ho tro (P6 buoc 1 chi tao, chi
o local), nen moi truong hop du day noi thang vong lap thay vi goi ham.
"""

__tkv_import__ = ["tkv_test_lib"]


def add_case(n: "i32") -> "i32":
    """`r[i] = a[i] + b[i]` - dang duoc vector hoa."""
    a = f32buf(n)
    b = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 1.0
        i = i + 1
    i = 0
    while i < n:
        b[i] = 2.0
        i = i + 1
    i = 0
    while i < n:
        r[i] = -999.0
        i = i + 1
    i = 0
    while i < n:
        r[i] = a[i] + b[i]
        i = i + 1
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    k = 0
    while k < n:
        w = w + "3.0;"
        k = k + 1
    return check("add n=" + str(n), s, w)


def mul_case(n: "i32") -> "i32":
    """`r[i] = a[i] * 1.5 - 0.25` - MOI duoc vector hoa (2026-10-14).

    Truoc day case nay la bang chung cho "hang so bi tu choi, van ra dung ket
    qua". Bay hang so duoc broadcast (xem `scale_case`) nen no CHAY VECTOR.
    Bai nay giu lai de canh: ket qua phai BIT-EXACT nhu tinh tay (2.5*1.5-0.25
    = 3.5), va 3.5 khong phai -999.0 nen duoi scalar bi bo sot cung lo ra."""
    a = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 2.5
        i = i + 1
    i = 0
    while i < n:
        r[i] = -999.0
        i = i + 1
    i = 0
    while i < n:
        r[i] = a[i] * 1.5 - 0.25
        i = i + 1
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    k = 0
    while k < n:
        w = w + "3.5;"
        k = k + 1
    return check("mul-scalar n=" + str(n), s, w)


def div_case(n: "i32") -> "i32":
    """`r[i] = b[i] / 2.0` - hang so, cung bi tu choi."""
    b = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        b[i] = 1.5
        i = i + 1
    i = 0
    while i < n:
        r[i] = -999.0
        i = i + 1
    i = 0
    while i < n:
        r[i] = b[i] / 2.0
        i = i + 1
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    k = 0
    while k < n:
        w = w + "0.75;"
        k = k + 1
    return check("div-scalar n=" + str(n), s, w)


def chain_case(n: "i32") -> "i32":
    """Nhieu toan tu lien tiep tren 3 buffer: `(a[i]+b[i])*(a[i]-b[i])`."""
    a = f32buf(n)
    b = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 3.0
        i = i + 1
    i = 0
    while i < n:
        b[i] = 1.0
        i = i + 1
    i = 0
    while i < n:
        r[i] = -999.0
        i = i + 1
    i = 0
    while i < n:
        r[i] = (a[i] + b[i]) * (a[i] - b[i])
        i = i + 1
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    k = 0
    while k < n:
        w = w + "8.0;"
        k = k + 1
    return check("chain n=" + str(n), s, w)


def copy_case(n: "i32") -> "i32":
    """Ve phai chi la mot `v_load4`: `r[i] = a[i]`."""
    a = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 5.5
        i = i + 1
    i = 0
    while i < n:
        r[i] = -999.0
        i = i + 1
    i = 0
    while i < n:
        r[i] = a[i]
        i = i + 1
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    k = 0
    while k < n:
        w = w + "5.5;"
        k = k + 1
    return check("copy n=" + str(n), s, w)


def scale_case(n: "i32") -> "i32":
    """`r[i] = a[i] * 1.5 + b[i]` - HANG SO trong ve phai (2026-10-14).

    Truoc day P6 TU CHOI dang nay: `_expr_num` tu choi moi dtype tru 'f32x4'
    va CHUA co intrinsic de broadcast. Nay co `newobj Vector4::.ctor(f32 x4)`
    nen so 1.5 duoc broadcast thanh `Vector4(1.5, 1.5, 1.5, 1.5)`.

    Gia tri mong doi 2.0 * 1.5 + 1.0 = 4.0, BIT-EXACT nhu ban scalar."""
    a = f32buf(n)
    b = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 2.0
        b[i] = 1.0
        i = i + 1
    i = 0
    while i < n:
        r[i] = -999.0
        i = i + 1
    i = 0
    while i < n:
        r[i] = a[i] * 1.5 + b[i]
        i = i + 1
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    k = 0
    while k < n:
        w = w + "4.0;"
        k = k + 1
    return check("scale_add n=" + str(n), s, w)


def scale_var_case(n: "i32", k: "f32") -> "i32":
    """`r[i] = a[i] * k` - bien `f32` (khong phai hang so) cung duoc broadcast.

    Chung co che voi `scale_case`, nhung toan hang la BIEN nen `_p6_leaf_vec_ok`
    phai SUY KIEU bang `infer_dtype` chu khong chi kiem `ekind == 'num'`.
    """
    a = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 3.0
        i = i + 1
    i = 0
    while i < n:
        r[i] = -999.0
        i = i + 1
    i = 0
    while i < n:
        r[i] = a[i] * k
        i = i + 1
    s = ""
    j = 0
    while j < n:
        s = s + str(r[j]) + ";"
        j = j + 1
    w = ""
    t = 0
    while t < n:
        w = w + str(3.0 * k) + ";"
        t = t + 1
    return check("scale_var n=" + str(n) + " k=" + str(k), s, w)


def run() -> "i32":
    total = 0
    # Chia het 4: vong vector chay het, khong con duoi scalar.
    total += add_case(4)
    total += add_case(8)
    total += add_case(16)
    # KHONG chia het 4: duoi scalar phai lam phan con lai dung.
    total += add_case(0)
    total += add_case(1)
    total += add_case(2)
    total += add_case(3)
    total += add_case(5)
    total += add_case(7)
    total += add_case(9)
    total += add_case(15)
    total += add_case(17)
    total += add_case(33)
    # Cac dang van bi tu choi phai ra dung ket qua.
    total += mul_case(9)
    total += div_case(9)
    # Ve phai nhieu toan tu, va ve phai don.
    total += chain_case(9)
    total += copy_case(9)
    # 2026-10-14: hang so / bien `f32` trong ve phai - broadcast bang
    # `newobj Vector4::.ctor(f32 x4)`. Truoc day 2 dang nay chay scalar.
    total += scale_case(0)
    total += scale_case(1)
    total += scale_case(4)
    total += scale_case(9)
    total += scale_case(16)
    total += scale_case(17)
    total += scale_var_case(9, 2.0)
    total += scale_var_case(16, 2.5)
    total += scale_var_case(5, -1.5)
    return test_summary("p6_vectorize_test", total, 26)
