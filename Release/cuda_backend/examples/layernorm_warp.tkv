# -*- coding: utf-8 -*-
# LayerNorm warp-shuffle: moi warp reduce 32 phan tu; warp 0 gop 8 gia tri shared.
# @tkv.cuda_kernel grid="rows" block="256"
def layernorm_warp(x: "ptr[f32]", g: "ptr[f32]", b: "ptr[f32]", out: "ptr[f32]", rows: "i32", h: "i32", eps: "f32") -> "void":
    s = shared_array(32)
    r = bid()
    t = ltid()
    lane = laneid()
    wid = t / 32
    if r < rows:
        base = r * h
        v = 0.0
        if t < h:
            v = x[base + t]
        sm = wreduce(v)
        if lane == 0:
            s[wid] = sm
        syncthreads()
        # warp 0: lane<8 doc s[lane], lane>=8 gan 0 de wreduce an toan
        m8 = 0.0
        if wid == 0:
            sv = 0.0
            if lane < 8:
                sv = s[lane]
            m8 = wreduce(sv) / h
        if t == 0:
            s[0] = m8
        syncthreads()
        mean = s[0]
        v2 = 0.0
        if t < h:
            d2 = x[base + t] - mean
            v2 = d2 * d2
        sv2 = wreduce(v2)
        if lane == 0:
            s[wid] = sv2
        syncthreads()
        v8 = 0.0
        if wid == 0:
            svv = 0.0
            if lane < 8:
                svv = s[lane]
            v8 = wreduce(svv) / h
        if t == 0:
            s[0] = v8
        syncthreads()
        rstd = 1.0 / sqrt(s[0] + eps)
        if t < h:
            out[base + t] = (x[base + t] - mean) * rstd * g[t] + b[t]


def run() -> "i32":
    return 0