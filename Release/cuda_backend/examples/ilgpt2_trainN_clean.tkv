    if rc != 0:
        print("GELU FWD FN FAIL", rc)
        return 0
    fnh: "i64" = read_i64(fc, 0)
    return fnh

def gelu_bwd_init() -> "i64":
    PTX = b".version 8.0\n.target sm_75\n.address_size 64\n.entry gelu_bwd_kernel(.param .u64 px, .param .u64 pdy, .param .u64 pdx, .param .u32 pn)\n{\n.reg .f32 f1,f2,f3,f4,f5,f6,f7;\n.reg .u64 x,y,z,off;\n.reg .u32 i,n,base,nt;\n.reg .pred q;\nld.param.u64 x,[px];\nld.param.u64 y,[pdy];\nld.param.u64 z,[pdx];\nld.param.u32 n,[pn];\nmov.u32 nt,%ntid.x;\nmov.u32 base,%ctaid.x;\nmul.lo.u32 base,base,nt;\nmov.u32 i,%tid.x;\nadd.u32 i,i,base;\nsetp.ge.u32 q,i,n;\n@q bra LEND;\nmul.wide.u32 off,i,4;\ncvta.to.global.u64 x,x;\ncvta.to.global.u64 y,y;\ncvta.to.global.u64 z,z;\nadd.u64 x,x,off;\nadd.u64 y,y,off;\nadd.u64 z,z,off;\nld.global.f32 f1,[x];\nmul.f32 f3,f1,f1;\nmul.f32 f3,f3,f1;\nmov.f32 f4,0.044715;\nfma.rn.f32 f3,f3,f4,f1;\nmov.f32 f4,0.79788456;\nmul.f32 f2,f3,f4;\ntanh.approx.f32 f2,f2;\nmov.f32 f3,1.0;\nadd.f32 f5,f2,f3;\nmov.f32 f3,0.5;\nmul.f32 f5,f5,f3;\nmul.f32 f6,f2,f2;\nmov.f32 f3,1.0;\nsub.f32 f6,f3,f6;\nmul.f32 f6,f6,f1;\nmov.f32 f3,0.5;\nmul.f32 f6,f6,f3;\nmul.f32 f7,f1,f1;\nmov.f32 f4,0.134145;\nmov.f32 f3,1.0;\nfma.rn.f32 f7,f7,f4,f3;\nmul.f32 f6,f6,f7;\nmov.f32 f4,0.79788456;\nmul.f32 f6,f6,f4;\nadd.f32 f5,f5,f6;\nld.global.f32 f7,[y];\nmul.f32 f5,f5,f7;\nst.global.f32 [z],f5;\nLEND: ret;\n}\n"
    FNS = b"gelu_bwd_kernel\x00"
    pb = alloc_bytes(len(PTX) + 1)
    kk: "i32" = 0
    while kk < len(PTX):
        wh: "i64" = write_u8(pb, kk, PTX[kk])
        kk = kk + 1
    wh = write_u8(pb, kk, 0)
    mc = alloc_bytes(8)
    rc: "i32" = cu_module_load(mc, pb)
    if rc != 0:
        print("GELU BWD MOD FAIL", rc)
        return 0
    mod: "i64" = read_i64(mc, 0)
    nb = alloc_bytes(len(FNS))
    kk = 0
    while kk < len(FNS):
        wh = write_u8(nb, kk, FNS[kk])
        kk = kk + 1
    fc = alloc_bytes(8)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("GELU BWD FN FAIL", rc)
        return 0
    fnh: "i64" = read_i64(fc, 0)
    return fnh

def gelu_fwd(fnh: "i64", x: "i64", y: "i64", n: "i32") -> "i32":
    a0 = alloc_bytes(8)
    wh = write_i64(a0, 0, x)
    a1 = alloc_bytes(8)
    wh = write_i64(a1, 0, y)
    a2 = alloc_bytes(4)
    wh = write_i32(a2, 0, n)
    pl = alloc_bytes(24)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    g: "i32" = (n + 255) >> 8
    rc = cu_launch(fnh, g, 1, 1, 256, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("GELU FWD LAUNCH FAIL", rc)
        return 1
    return 0

def gelu_bwd(fnh: "i64", x: "i64", dy: "i64", dx: "i64", n: "i32") -> "i32":
    a0 = alloc_bytes(8)
    wh = write_i64(a0, 0, x)
    a1 = alloc_bytes(8)
    wh = write_i64(a1, 0, dy)
    a2 = alloc_bytes(8)
    wh = write_i64(a2, 0, dx)
    a3 = alloc_bytes(4)
    wh = write_i32(a3, 0, n)
    pl = alloc_bytes(32)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    wh = write_i64(pl, 24, a3)
    g: "i32" = (n + 255) >> 8
    rc = cu_launch(fnh, g, 1, 1, 256, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("GELU BWD LAUNCH FAIL", rc)
        return 1
    return 0

def gelu_selftest(gfn: "i64", bfn: "i64") -> "i32":
    n: "i32" = 1024
    nb: "i32" = n * 4
    hx = alloc_bytes(nb)
    hdy = alloc_bytes(nb)
    hy = alloc_bytes(nb)
    hdx = alloc_bytes(nb)
    ii: "i32" = 0
    while ii < n:
        xv: "f32" = (ii - 512) * 0.0078125
        wh: "i64" = write_f32(hx, ii * 4, xv)
        wh = write_f32(hdy, ii * 4, 1.0 + ii * 0.001)
        ii = ii + 1
    cell = alloc_bytes(8)
    rc: "i32" = cuda_malloc(cell, nb)
    dx = read_i64(cell, 0)
    rc = cuda_malloc(cell, nb)
    dy = read_i64(cell, 0)
    rc = cuda_malloc(cell, nb)
    dz = read_i64(cell, 0)
    wh = cuda_h2d(dx, hx, nb, 1)
    wh = cuda_h2d(dy, hdy, nb, 1)
    rc = gelu_fwd(gfn, dx, dz, n)
    wh = cuda_h2d(hy, dz, nb, 2)
    rc = gelu_bwd(bfn, dx, dy, dz, n)
    wh = cuda_h2d(hdx, dz, nb, 2)
    me: "f32" = 0.0
    ii = 0
    while ii < n:
        xv = read_f32(hx, ii * 4)
        zz: "f32" = 0.79788456 * (xv + 0.044715 * xv * xv * xv)
        thv: "f32" = 1.0
        if zz < -8.0:
            thv = -1.0
        else:
            if zz < 8.0:
                e2: "f32" = exp(2.0 * zz)
                thv = (e2 - 1.0) / (e2 + 1.0)
        gy: "f32" = 0.5 * xv * (1.0 + thv)
        dg: "f32" = 0.5 * (1.0 + thv) + 0.5 * xv * (1.0 - thv * thv) * 0.79788456 * (1.0 + 0.134145 * xv * xv)
        e1: "f32" = read_f32(hy, ii * 4) - gy
        if e1 < 0.0:
            e1 = 0.0 - e1
        eb: "f32" = read_f32(hdx, ii * 4) - read_f32(hdy, ii * 4) * dg
        if eb < 0.0:
            eb = 0.0 - eb
        if e1 > me:
            me = e1
        if eb > me:
            me = eb
        ii = ii + 1
    print("GELU SELFTEST MAXERR", me)
    if me > 0.0001:
        return 1
    return 0

def kern_init() -> "i64":
    PTX = b".version 8.0\n.target sm_75\n.address_size 64\n.entry lnf_kernel(.param .u64 px, .param .u64 pg, .param .u64 pb, .param .u64 py, .param .u64 pxh, .param .u64 pst, .param .u32 pT, .param .u32 pH, .param .f32 pinvH, .param .f32 peps)\n{\n.reg .f32 x,sum,sq,mean,var,rstd,g,b,xh,y,t,ss,eps,invh;\n.reg .u64 xb,gb,bb,yb,hb,stb,off,offg,xa,ga,ba,ya,ha,sta;\n.reg .u32 row,j,tn,hn,idx;\n.reg .pred q;\nld.param.u64 xb,[px];\nld.param.u64 gb,[pg];\nld.param.u64 bb,[pb];\nld.param.u64 yb,[py];\nld.param.u64 hb,[pxh];\nld.param.u64 stb,[pst];\nld.param.u32 tn,[pT];\nld.param.u32 hn,[pH];\nld.param.f32 invh,[pinvH];\nld.param.f32 eps,[peps];\ncvta.to.global.u64 xb,xb;\ncvta.to.global.u64 gb,gb;\ncvta.to.global.u64 bb,bb;\ncvta.to.global.u64 yb,yb;\ncvta.to.global.u64 hb,hb;\ncvta.to.global.u64 stb,stb;\nmov.u32 row,%tid.x;\nsetp.ge.u32 q,row,tn;\n@q bra LEND;\nmov.f32 sum,0.0;\nmov.u32 j,0;\nL1:\nsetp.ge.u32 q,j,hn;\n@q bra L1D;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nadd.f32 sum,sum,x;\nadd.u32 j,j,1;\nbra L1;\nL1D:\nmul.f32 mean,sum,invh;\nmov.f32 sq,0.0;\nmov.u32 j,0;\nL2:\nsetp.ge.u32 q,j,hn;\n@q bra L2D;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nsub.f32 t,x,mean;\nmul.f32 t,t,t;\nadd.f32 sq,sq,t;\nadd.u32 j,j,1;\nbra L2;\nL2D:\nmul.f32 var,sq,invh;\nadd.f32 var,var,eps;\nsqrt.rn.f32 rstd,var;\nrcp.approx.f32 rstd,rstd;\nmul.wide.u32 off,row,8;\nadd.u64 sta,stb,off;\nst.global.f32 [sta],mean;\nadd.u64 sta,sta,4;\nst.global.f32 [sta],rstd;\nmov.u32 j,0;\nL3:\nsetp.ge.u32 q,j,hn;\n@q bra LEND;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nsub.f32 xh,x,mean;\nmul.f32 xh,xh,rstd;\nmul.wide.u32 offg,j,4;\nadd.u64 ga,gb,offg;\nld.global.f32 g,[ga];\nadd.u64 ba,bb,offg;\nld.global.f32 b,[ba];\nmul.f32 y,xh,g;\nadd.f32 y,y,b;\nadd.u64 ya,yb,off;\nst.global.f32 [ya],y;\nadd.u64 ha,hb,off;\nst.global.f32 [ha],xh;\nadd.u32 j,j,1;\nbra L3;\nLEND:\nret;\n}\n.entry lnb_kernel(.param .u64 pxh, .param .u64 pdy, .param .u64 pg, .param .u64 pst, .param .u64 pdx, .param .u32 pT, .param .u32 pH, .param .f32 pinvH)\n{\n.reg .f32 xh,dy,g,rstd,mean,s1,s2,t,dx,invh;\n.reg .u64 xhb,dyb,gb,stb,dxb,off,offg,xa,da,ga,sta,dxa;\n.reg .u32 row,j,tn,hn,idx;\n.reg .pred q;\nld.param.u64 xhb,[pxh];\nld.param.u64 dyb,[pdy];\nld.param.u64 gb,[pg];\nld.param.u64 stb,[pst];\nld.param.u64 dxb,[pdx];\nld.param.u32 tn,[pT];\nld.param.u32 hn,[pH];\nld.param.f32 invh,[pinvH];\ncvta.to.global.u64 xhb,xhb;\ncvta.to.global.u64 dyb,dyb;\ncvta.to.global.u64 gb,gb;\ncvta.to.global.u64 stb,stb;\ncvta.to.global.u64 dxb,dxb;\nmov.u32 row,%tid.x;\nsetp.ge.u32 q,row,tn;\n@q bra LEND;\nmul.wide.u32 off,row,8;\nadd.u64 sta,stb,off;\nld.global.f32 mean,[sta];\nadd.u64 sta,sta,4;\nld.global.f32 rstd,[sta];\nmov.f32 s1,0.0;\nmov.f32 s2,0.0;\nmov.u32 j,0;\nL1:\nsetp.ge.u32 q,j,hn;\n@q bra L1D;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 da,dyb,off;\nld.global.f32 dy,[da];\nadd.u64 xa,xhb,off;\nld.global.f32 xh,[xa];\nmul.wide.u32 offg,j,4;\nadd.u64 ga,gb,offg;\nld.global.f32 g,[ga];\nmul.f32 t,dy,g;\nadd.f32 s1,s1,t;\nmul.f32 t,t,xh;\nadd.f32 s2,s2,t;\nadd.u32 j,j,1;\nbra L1;\nL1D:\nmul.f32 s1,s1,invh;\nmul.f32 s2,s2,invh;\nmov.u32 j,0;\nL2:\nsetp.ge.u32 q,j,hn;\n@q bra LEND;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 da,dyb,off;\nld.global.f32 dy,[da];\nadd.u64 xa,xhb,off;\nld.global.f32 xh,[xa];\nmul.wide.u32 offg,j,4;\nadd.u64 ga,gb,offg;\nld.global.f32 g,[ga];\nmul.f32 t,dy,g;\nsub.f32 t,t,s1;\nmul.f32 dx,xh,s2;\nsub.f32 dx,t,dx;\nmul.f32 dx,dx,rstd;\nadd.u64 dxa,dxb,off;\nst.global.f32 [dxa],dx;\nadd.u32 j,j,1;\nbra L2;\nLEND:\nret;\n}\n.entry sf_kernel(.param .u64 ps, .param .u64 pp, .param .u32 pT, .param .f32 pone)\n{\n.reg .f32 x,mx,sum,e,p,one;\n.reg .u64 sb,pb,off,xa,pa;\n.reg .u32 row,j,tn,idx;\n.reg .pred q;\nld.param.u64 sb,[ps];\nld.param.u64 pb,[pp];\nld.param.u32 tn,[pT];\nld.param.f32 one,[pone];\ncvta.to.global.u64 sb,sb;\ncvta.to.global.u64 pb,pb;\nmov.u32 row,%tid.x;\nsetp.ge.u32 q,row,tn;\n@q bra LEND;\nmov.f32 mx,-1000000000.0;\nmov.u32 j,0;\nL1:\nsetp.gt.u32 q,j,row;\n@q bra L1D;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,sb,off;\nld.global.f32 x,[xa];\nmax.f32 mx,mx,x;\nadd.u32 j,j,1;\nbra L1;\nL1D:\nmov.f32 sum,0.0;\nmov.u32 j,0;\nL2:\nsetp.gt.u32 q,j,row;\n@q bra L2D;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,sb,off;\nld.global.f32 x,[xa];\nsub.f32 x,x,mx;\nmul.f32 x,x,1.442695;\nex2.approx.f32 e,x;\nadd.f32 sum,sum,e;\nadd.u32 j,j,1;\nbra L2;\nL2D:\nmov.u32 j,0;\nL3:\nsetp.ge.u32 q,j,tn;\n@q bra LEND;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmov.f32 p,0.0;\nsetp.gt.u32 q,j,row;\n@q bra L3W;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,sb,off;\nld.global.f32 x,[xa];\nsub.f32 x,x,mx;\nmul.f32 x,x,1.442695;\nex2.approx.f32 e,x;\ndiv.rn.f32 p,e,sum;\nL3W:\nmul.wide.u32 off,idx,4;\nadd.u64 pa,pb,off;\nst.global.f32 [pa],p;\nadd.u32 j,j,1;\nbra L3;\nLEND:\nret;\n}\n.entry sbk_kernel(.param .u64 pdp, .param .u64 pp, .param .u64 pds, .param .u32 pT)\n{\n.reg .f32 dp,p,rs,t,scale;\n.reg .u64 db,pb,dsb,off,da,pa,dsa;\n.reg .u32 row,j,tn,idx;\n.reg .pred q;\nld.param.u64 db,[pdp];\nld.param.u64 pb,[pp];\nld.param.u64 dsb,[pds];\nld.param.u32 tn,[pT];\ncvta.to.global.u64 db,db;\ncvta.to.global.u64 pb,pb;\ncvta.to.global.u64 dsb,dsb;\nmov.u32 row,%tid.x;\nsetp.ge.u32 q,row,tn;\n@q bra LEND;\nmov.f32 rs,0.0;\nmov.u32 j,0;\nL1:\nsetp.ge.u32 q,j,tn;\n@q bra L1D;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 da,db,off;\nld.global.f32 dp,[da];\nadd.u64 pa,pb,off;\nld.global.f32 p,[pa];\nmul.f32 t,dp,p;\nadd.f32 rs,rs,t;\nadd.u32 j,j,1;\nbra L1;\nL1D:\nmov.u32 j,0;\nL2:\nsetp.ge.u32 q,j,tn;\n@q bra LEND;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmov.f32 t,0.0;\nsetp.gt.u32 q,j,row;\n@q bra L2W;\nmul.wide.u32 off,idx,4;\nadd.u64 da,db,off;\nld.global.f32 dp,[da];\nadd.u64 pa,pb,off;\nld.global.f32 p,[pa];\nsub.f32 t,dp,rs;\nmul.f32 t,t,p;\nL2W:\nmul.wide.u32 off,idx,4;\nadd.u64 dsa,dsb,off;\nst.global.f32 [dsa],t;\nadd.u32 j,j,1;\nbra L2;\nLEND:\nret;\n}\n.entry add_kernel(.param .u64 pa, .param .u64 pb, .param .u64 po, .param .u32 pn)\n{\n.reg .f32 x,y;\n.reg .u64 ab,bb,ob,off;\n.reg .u32 i,n,base,nt;\n.reg .pred q;\nld.param.u64 ab,[pa];\nld.param.u64 bb,[pb];\nld.param.u64 ob,[po];\nld.param.u32 n,[pn];\ncvta.to.global.u64 ab,ab;\ncvta.to.global.u64 bb,bb;\ncvta.to.global.u64 ob,ob;\nmov.u32 nt,%ntid.x;\nmov.u32 base,%ctaid.x;\nmul.lo.u32 base,base,nt;\nmov.u32 i,%tid.x;\nadd.u32 i,i,base;\nsetp.ge.u32 q,i,n;\n@q bra LEND;\nmul.wide.u32 off,i,4;\nadd.u64 ab,ab,off;\nadd.u64 bb,bb,off;\nadd.u64 ob,ob,off;\nld.global.f32 x,[ab];\nld.global.f32 y,[bb];\nadd.f32 x,x,y;\nst.global.f32 [ob],x;\nLEND:\nret;\n}\n.entry toh_kernel(.param .u64 px, .param .u64 py, .param .u32 pn)\n{\n.reg .f32 f;\n.reg .f16 h;\n.reg .b16 u;\n.reg .u64 x,y,off,o2;\n.reg .u32 i,n,base,nt;\n.reg .pred q;\nld.param.u64 x,[px];\nld.param.u64 y,[py];\nld.param.u32 n,[pn];\ncvta.to.global.u64 x,x;\ncvta.to.global.u64 y,y;\nmov.u32 nt,%ntid.x;\nmov.u32 base,%ctaid.x;\nmul.lo.u32 base,base,nt;\nmov.u32 i,%tid.x;\nadd.u32 i,i,base;\nsetp.ge.u32 q,i,n;\n@q bra LEND;\nmul.wide.u32 off,i,4;\nmul.wide.u32 o2,i,2;\nadd.u64 x,x,off;\nadd.u64 y,y,o2;\nld.global.f32 f,[x];\ncvt.rn.f16.f32 h,f;\nmov.b16 u,h;\nst.global.b16 [y],u;\nLEND:\nret;\n}\n"
    pb = alloc_bytes(len(PTX) + 1)
    kk: "i32" = 0
    while kk < len(PTX):
        wh: "i64" = write_u8(pb, kk, PTX[kk])
        kk = kk + 1
    wh = write_u8(pb, kk, 0)
    mc = alloc_bytes(8)
    rc: "i32" = cu_module_load(mc, pb)
    if rc != 0:
        print("KERN MOD FAIL", rc)
        return 0
    mod: "i64" = read_i64(mc, 0)
    hs = alloc_bytes(48)
    fc = alloc_bytes(8)
    N1 = b"lnf_kernel\x00"
    nb = alloc_bytes(len(N1))
    kk = 0
    while kk < len(N1):
        wh = write_u8(nb, kk, N1[kk])
        kk = kk + 1
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("KERN FN LNF FAIL", rc)
        return 0
    wh = write_i64(hs, 0, read_i64(fc, 0))
    N2 = b"lnb_kernel\x00"
    kk = 0
    while kk < len(N2):
        wh = write_u8(nb, kk, N2[kk])
        kk = kk + 1
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("KERN FN LNB FAIL", rc)
        return 0
    wh = write_i64(hs, 8, read_i64(fc, 0))
    N3 = b"sf_kernel\x00"
    kk = 0
    while kk < len(N3):
        wh = write_u8(nb, kk, N3[kk])
        kk = kk + 1
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("KERN FN SF FAIL", rc)
        return 0
    wh = write_i64(hs, 16, read_i64(fc, 0))
    N4 = b"sbk_kernel\x00"
    kk = 0
    while kk < len(N4):
        wh = write_u8(nb, kk, N4[kk])
        kk = kk + 1
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("KERN FN SBK FAIL", rc)
        return 0
    wh = write_i64(hs, 24, read_i64(fc, 0))
    N5 = b"add_kernel\x00"
    kk = 0
    while kk < len(N5):
        wh = write_u8(nb, kk, N5[kk])
        kk = kk + 1
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("KERN FN ADD FAIL", rc)
        return 0
    wh = write_i64(hs, 32, read_i64(fc, 0))
    N6 = b"toh_kernel\x00"
    kk = 0
    while kk < len(N6):
        wh = write_u8(nb, kk, N6[kk])
        kk = kk + 1
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("KERN FN TOH FAIL", rc)
        return 0
    wh = write_i64(hs, 40, read_i64(fc, 0))
    return hs

def ln_fwd(fnh: "i64", x: "i64", gam: "i64", bet: "i64", y: "i64", xh: "i64", st: "i64", tn: "i32", hn: "i32") -> "i32":
    a0 = alloc_bytes(8)
    wh: "i64" = write_i64(a0, 0, x)
    a1 = alloc_bytes(8)
    wh = write_i64(a1, 0, gam)
    a2 = alloc_bytes(8)
    wh = write_i64(a2, 0, bet)
    a3 = alloc_bytes(8)
    wh = write_i64(a3, 0, y)
    a4 = alloc_bytes(8)
    wh = write_i64(a4, 0, xh)
    a5 = alloc_bytes(8)
    wh = write_i64(a5, 0, st)
    a6 = alloc_bytes(4)
    wh = write_i32(a6, 0, tn)
    a7 = alloc_bytes(4)
    wh = write_i32(a7, 0, hn)
    a8 = alloc_bytes(4)
    wh = write_f32(a8, 0, 1.0 / hn)
    a9 = alloc_bytes(4)
    wh = write_f32(a9, 0, 0.000001)
    pl = alloc_bytes(80)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    wh = write_i64(pl, 24, a3)
    wh = write_i64(pl, 32, a4)
    wh = write_i64(pl, 40, a5)
    wh = write_i64(pl, 48, a6)
    wh = write_i64(pl, 56, a7)
    wh = write_i64(pl, 64, a8)
    wh = write_i64(pl, 72, a9)
    rc: "i32" = cu_launch(fnh, 1, 1, 1, tn, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("LN FWD LAUNCH FAIL", rc)
        return 1
    return 0

def ln_bwd(fnh: "i64", xh: "i64", dy: "i64", gam: "i64", st: "i64", dx: "i64", tn: "i32", hn: "i32") -> "i32":
