    a6 = alloc_bytes(4)
    wh = write_i32(a6, 0, hn)
    a7 = alloc_bytes(4)
    wh = write_f32(a7, 0, 1.0 / hn)
    pl = alloc_bytes(64)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    wh = write_i64(pl, 24, a3)
    wh = write_i64(pl, 32, a4)
    wh = write_i64(pl, 40, a5)
    wh = write_i64(pl, 48, a6)
    wh = write_i64(pl, 56, a7)
    rc: "i32" = cu_launch(fnh, 1, 1, 1, tn, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("LN BWD LAUNCH FAIL", rc)
