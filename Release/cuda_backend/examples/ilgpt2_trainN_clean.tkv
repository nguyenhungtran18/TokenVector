        print("GEMM16H FAIL", rc)
    return rc

def tof_init() -> "i64":
    PTX = b".version 8.0\n.target sm_75\n.address_size 64\n.entry tof_kernel(.param .u64 px, .param .u64 py, .param .u32 pn)\n{\n.reg .f32 f;\n.reg .f16 h;\n.reg .b16 hb;\n.reg .u64 x,y,off;\n.reg .u32 i,n,base,nt;\n.reg .pred q;\nld.param.u64 x,[px];\nld.param.u64 y,[py];\nld.param.u32 n,[pn];\ncvta.to.global.u64 x,x;\ncvta.to.global.u64 y,y;\nmov.u32 nt,%ntid.x;\nmov.u32 base,%ctaid.x;\nmul.lo.u32 base,base,nt;\nmov.u32 i,%tid.x;\nadd.u32 i,i,base;\nsetp.ge.u32 q,i,n;\n@q bra LEND;\nmul.wide.u32 off,i,2;\nadd.u64 x,x,off;\nmul.wide.u32 off,i,4;\nadd.u64 y,y,off;\nld.global.b16 hb,[x];\nmov.b16 h,hb;\ncvt.f32.f16 f,h;\nst.global.f32 [y],f;\nLEND:\nret;\n}\n"
    FNS = b"tof_kernel\x00"
    pb = alloc_bytes(len(PTX) + 1)
    kk: "i32" = 0
    while kk < len(PTX):
        wh: "i64" = write_u8(pb, kk, PTX[kk])
        kk = kk + 1
    wh = write_u8(pb, kk, 0)
    mc = alloc_bytes(8)
    rc: "i32" = cu_module_load(mc, pb)
    if rc != 0:
        print("TOF MOD FAIL", rc)
        return 0
    mod: "i64" = read_i64(mc, 0)
    nb = alloc_bytes(len(FNS))
    kk = 0
    while kk < len(FNS):
        wh = write_u8(nb, kk, FNS[kk])
        kk = kk + 1
    fc = alloc_bytes(8)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("TOF FN FAIL", rc)
        return 0
    fnh: "i64" = read_i64(fc, 0)
    return fnh

def tof(fnh: "i64", src: "i64", dst: "i64", n: "i32") -> "i32":
    a0 = alloc_bytes(8)
    wh: "i64" = write_i64(a0, 0, src)
    a1 = alloc_bytes(8)
    wh = write_i64(a1, 0, dst)
    a2 = alloc_bytes(4)
    wh = write_i32(a2, 0, n)
    pl = alloc_bytes(24)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    g: "i32" = (n + 255) >> 8
    rc: "i32" = cu_launch(fnh, g, 1, 1, 256, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("TOF LAUNCH FAIL", rc)
        return 1
    return 0

def loss_init() -> "i64":
    PTX = b".version 8.0\n.target sm_75\n.address_size 64\n.entry loss_kernel2(.param .u64 pLG, .param .u64 pPk, .param .u64 pDL, .param .u64 pLS)\n{\n.reg .f32 mx,x,t,e,sum,p,l,lsum,inv;\n.reg .u64 xb,pb,ob,yb,off,xa,ia,ya,la;\n.reg .u32 row,i,vn,tn,id,idx;\n.reg .pred q,pis;\nld.param.u64 xb,[pLG];\nld.param.u64 pb,[pPk];\nld.param.u64 ob,[pDL];\nld.param.u64 yb,[pLS];\ncvta.to.global.u64 xb,xb;\ncvta.to.global.u64 pb,pb;\ncvta.to.global.u64 ob,ob;\ncvta.to.global.u64 yb,yb;\nld.global.u32 tn,[pb];\nld.global.u32 vn,[pb+4];\nld.global.f32 inv,[pb+8];\nmov.u32 row,%tid.x;\nsetp.ge.u32 q,row,tn;\n@q bra LEND;\nmov.f32 mx,-1000000000.0;\nmov.u32 i,0;\nLMAX:\nsetp.ge.u32 q,i,vn;\n@q bra MAXDONE;\nmul.lo.u32 idx,i,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nmax.f32 mx,mx,x;\nadd.u32 i,i,1;\nbra LMAX;\nMAXDONE:\nmov.f32 sum,0.0;\nmov.u32 i,0;\nLSUM:\nsetp.ge.u32 q,i,vn;\n@q bra SUMDONE;\nmul.lo.u32 idx,i,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nsub.f32 t,x,mx;\nmul.f32 t,t,1.442695;\nex2.approx.f32 e,t;\nadd.f32 sum,sum,e;\nadd.u32 i,i,1;\nbra LSUM;\nSUMDONE:\nmul.wide.u32 off,row,4;\nadd.u64 ia,pb,off;\nld.global.u32 id,[ia+16];\nmul.lo.u32 idx,id,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nlg2.approx.f32 lsum,sum;\nmul.f32 lsum,lsum,0.69314718;\nadd.f32 l,mx,lsum;\nsub.f32 l,l,x;\nmul.f32 l,l,inv;\nmul.wide.u32 off,row,4;\nadd.u64 la,yb,off;\nst.global.f32 [la],l;\nmov.u32 i,0;\nLDL:\nsetp.ge.u32 q,i,vn;\n@q bra LEND;\nmul.lo.u32 idx,i,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nsub.f32 t,x,mx;\nmul.f32 t,t,1.442695;\nex2.approx.f32 e,t;\ndiv.rn.f32 p,e,sum;\nsetp.eq.u32 pis,i,id;\n@pis sub.f32 p,p,1.0;\nmul.f32 p,p,inv;\nadd.u64 ya,ob,off;\nst.global.f32 [ya],p;\nadd.u32 i,i,1;\nbra LDL;\nLEND:\nret;\n}\n"
    FNS = b"loss_kernel2\x00"
    pb = alloc_bytes(len(PTX) + 1)
    kk: "i32" = 0
    while kk < len(PTX):
        wh: "i64" = write_u8(pb, kk, PTX[kk])
        kk = kk + 1
    wh = write_u8(pb, kk, 0)
    mc = alloc_bytes(8)
    rc: "i32" = cu_module_load(mc, pb)
    if rc != 0:
        print("LOSS MOD FAIL", rc)
        return 0
    mod: "i64" = read_i64(mc, 0)
    nb = alloc_bytes(len(FNS))
    kk = 0
    while kk < len(FNS):
        wh = write_u8(nb, kk, FNS[kk])
        kk = kk + 1
    fc = alloc_bytes(8)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("LOSS FN FAIL", rc)
        return 0
    fnh: "i64" = read_i64(fc, 0)
    return fnh

def loss_fwd(fnh: "i64", lg: "i64", pk: "i64", dl: "i64", ls: "i64", tn: "i32") -> "i32":
    a0 = alloc_bytes(8)
    wh: "i64" = write_i64(a0, 0, lg)
    a1 = alloc_bytes(8)
    wh = write_i64(a1, 0, pk)
    a2 = alloc_bytes(8)
    wh = write_i64(a2, 0, dl)
    a3 = alloc_bytes(8)
    wh = write_i64(a3, 0, ls)
    pl = alloc_bytes(32)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    wh = write_i64(pl, 24, a3)
    rc: "i32" = cu_launch(fnh, 1, 1, 1, tn, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("LOSS LAUNCH FAIL", rc)
        return 1
    return 0

def wrand(i: "i32", j: "i32", s: "f32") -> "f32":
    h: "i32" = i * 374761393 + j * 668265263
    h = (h ^ (h >> 13)) * 1274126177
    h = h ^ (h >> 16)
    u: "i32" = h & 65535
    return s * (u / 65535.0 - 0.5)

def copy_buf(d: "i64", s: "i64", n: "i32") -> "i32":
    k: "i32" = 0
    while k < n:
        whc: "i64" = write_f32(d, k * 4, read_f32(s, k * 4))
        k = k + 1
    return 0

def zero_buf(p: "i64", n: "i32") -> "i32":
    k: "i32" = 0
    while k < n:
        whz: "i64" = write_f32(p, k * 4, 0.0)
        k = k + 1
    return 0

def scan(tag: "i32", p: "i64", n: "i32") -> "i32":
    mx: "f32" = 0.0
    nc: "i32" = 0
    ss: "f32" = 0.0
    k: "i32" = 0
    while k < n:
        v: "f32" = read_f32(p, k * 4)
        av: "f32" = v
        if v < 0.0:
            av = 0.0 - v
        if av > mx:
            mx = av
        if v * 0.0 != 0.0:
            nc = nc + 1
        ss = ss + v * v
        k = k + 1
    print("M SCAN", tag, mx, nc, ss / n)
    return nc

def run() -> "i32":
    rc: "i32" = cu_init(0)
    if rc != 0:
        return 1
    hcell = alloc_bytes(8)
    rc = cublas_create(hcell)
    ch: "i64" = read_i64(hcell, 0)
    NL: "i32" = 24
    T: "i32" = 512
    H: "i32" = 1024
    F: "i32" = 4 * H
    V: "i32" = 50257
    hb: "i32" = H * 4
    h4: "i32" = F * 4
    qb: "i32" = T * H * 4
    fb: "i32" = T * F * 4
    sb: "i32" = T * T * 4
    tvb: "i32" = T * V * 4
    stb: "i32" = T * 8
    whb: "i32" = hb * H
    w1b: "i32" = h4 * H
    w2b: "i32" = hb * F
    wh2: "i32" = V * hb
    msz: "i32" = NL * 8
    sQH: "i32" = T * H
    sHH: "i32" = H * H
    sTT: "i32" = T * T
    sTF: "i32" = T * F
    sFH: "i32" = F * H
    sTV: "i32" = T * V
    sHV: "i32" = H * V
    cell = alloc_bytes(8)
    # arrays cua device-pointer / host-pointer theo lop
    AWq = alloc_bytes(msz)
    AWk = alloc_bytes(msz)
    AWv = alloc_bytes(msz)
    AWo = alloc_bytes(msz)
    AW1 = alloc_bytes(msz)
    AW2 = alloc_bytes(msz)
    AGq = alloc_bytes(msz)
    AGk = alloc_bytes(msz)
    AGv = alloc_bytes(msz)
    AGo = alloc_bytes(msz)
    AG1 = alloc_bytes(msz)
    AG2 = alloc_bytes(msz)
    AX1 = alloc_bytes(msz)
    AY1 = alloc_bytes(msz)
    AS1 = alloc_bytes(msz)
    AY2 = alloc_bytes(msz)
    AX2 = alloc_bytes(msz)
    AS2 = alloc_bytes(msz)
    AP = alloc_bytes(msz)
    AZ = alloc_bytes(msz)
    AO = alloc_bytes(msz)
    # scalar
    one = alloc_bytes(4)
    wh: "i64" = write_f32(one, 0, 1.0)
    zero = alloc_bytes(4)
    wh = write_f32(zero, 0, 0.0)
    hal = alloc_bytes(4)
    wh = write_f32(hal, 0, 1.0 / sqrt(H))
    # input + ids
    hX = alloc_bytes(qb)
    hIN = alloc_bytes(qb)
    hIds = alloc_bytes(T * 4)
    ii: "i32" = 0
    jj: "i32" = 0
    while ii < T:
        jj = 0
        while jj < H:
            wh = write_f32(hIN, (ii + jj * T) * 4, wrand(ii, jj, 0.4))
            jj = jj + 1
        wh = write_i32(hIds, ii * 4, (ii + 1) % V)
        ii = ii + 1
    # shared temp device buffers (dung lai qua moi lop)
    dY1 = read_i64(cell, 0) if False else alloc_bytes(8)
    rc = cuda_malloc(cell, qb)
    dY1 = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    dS = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    dP = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dQ = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dK = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dV = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dA = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dO = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dX = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dX2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb)
    dgam = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb)
    dbet = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dY2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, fb)
    dZ = read_i64(cell, 0)
    rc = cuda_malloc(cell, fb >> 1)
    dZ16 = read_i64(cell, 0)
    rc = cuda_malloc(cell, fb)
    dHH = read_i64(cell, 0)
    rc = cuda_malloc(cell, fb)
    dO2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dOUT = read_i64(cell, 0)
    rc = cuda_malloc(cell, tvb)
    dLG = read_i64(cell, 0)
    rc = cuda_malloc(cell, tvb)
    dDL = read_i64(cell, 0)
    rc = cuda_malloc(cell, 4096)
    dPK = read_i64(cell, 0)
    rc = cuda_malloc(cell, stb)
    dLS = read_i64(cell, 0)
    rc = cuda_malloc(cell, wh2 >> 1)
    fpA = read_i64(cell, 0)
    rc = cuda_malloc(cell, wh2 >> 1)
    fpB = read_i64(cell, 0)
    gHH = read_i64(cell, 0)
    rc = cuda_malloc(cell, fb)
    gZ = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    gY2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    gDX2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    gA = read_i64(cell, 0)
    rc = cuda_malloc(cell, whb)
    gWo = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    gP = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    gV = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    gS = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    gQ = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    gK = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    gY1 = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    gOUT = read_i64(cell, 0)
    # host scratch (dung lai)
    hY1 = alloc_bytes(qb)
    hY2 = alloc_bytes(qb)
    hST = alloc_bytes(stb)
    hXH = alloc_bytes(qb)
    g1h = alloc_bytes(hb)
    b1h = alloc_bytes(hb)
    g2h = alloc_bytes(hb)
    b2h = alloc_bytes(hb)
    hS = alloc_bytes(sb)
    hP = alloc_bytes(sb)
    hO = alloc_bytes(qb)
    hX2 = alloc_bytes(qb)
    hO2 = alloc_bytes(qb)
    hOUT = alloc_bytes(qb)
    hZ = alloc_bytes(fb)
    hLG = alloc_bytes(tvb)
    hDL = alloc_bytes(tvb)
    hPK = alloc_bytes(16 + T * 4)
    hLS = alloc_bytes(stb)
    hGP = alloc_bytes(sb)
    hDS = alloc_bytes(sb)
    hGY2 = alloc_bytes(fb)
    hGDX2 = alloc_bytes(qb)
    # khoi tao moi lop
    ll: "i32" = 0
    while ll < NL:
        rc = cuda_malloc(cell, whb)
        wqd: "i64" = read_i64(cell, 0)
        wh = write_i64(AWq, ll * 8, wqd)
        rc = cuda_malloc(cell, whb)
        wkd: "i64" = read_i64(cell, 0)
        wh = write_i64(AWk, ll * 8, wkd)
        rc = cuda_malloc(cell, whb)
        wvd: "i64" = read_i64(cell, 0)
        wh = write_i64(AWv, ll * 8, wvd)
        rc = cuda_malloc(cell, whb)
        wod: "i64" = read_i64(cell, 0)
        wh = write_i64(AWo, ll * 8, wod)
        rc = cuda_malloc(cell, w1b)
        w1d: "i64" = read_i64(cell, 0)
        wh = write_i64(AW1, ll * 8, w1d)
        rc = cuda_malloc(cell, w2b)
        w2d: "i64" = read_i64(cell, 0)
        wh = write_i64(AW2, ll * 8, w2d)
        rc = cuda_malloc(cell, whb)
        wh = write_i64(AGq, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, whb)
        wh = write_i64(AGk, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, whb)
        wh = write_i64(AGv, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, whb)
        wh = write_i64(AGo, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, w1b)
        wh = write_i64(AG1, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, w2b)
        wh = write_i64(AG2, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, qb)
        wh = write_i64(AX1, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, qb)
        wh = write_i64(AY1, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, stb)
        wh = write_i64(AS1, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, qb)
        wh = write_i64(AY2, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, qb)
        wh = write_i64(AX2, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, stb)
        wh = write_i64(AS2, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, sb)
        wh = write_i64(AP, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, fb)
        wh = write_i64(AZ, ll * 8, read_i64(cell, 0))
        rc = cuda_malloc(cell, qb)
        wh = write_i64(AO, ll * 8, read_i64(cell, 0))
        hwq: "i64" = alloc_bytes(whb)
        hwk: "i64" = alloc_bytes(whb)
        hwv: "i64" = alloc_bytes(whb)
        hwo: "i64" = alloc_bytes(whb)
        hw1: "i64" = alloc_bytes(w1b)
        hw2: "i64" = alloc_bytes(w2b)
        ii = 0
        while ii < H:
            jj = 0
            while jj < H:
                wh = write_f32(hwq, (ii + jj * H) * 4, wrand(ii, jj, 0.04))
                wh = write_f32(hwk, (ii + jj * H) * 4, wrand(ii, jj, 0.04))
                wh = write_f32(hwv, (ii + jj * H) * 4, wrand(ii, jj, 0.04))
                wh = write_f32(hwo, (ii + jj * H) * 4, wrand(ii, jj, 0.04))
                jj = jj + 1
            jj = 0
            while jj < F:
                wh = write_f32(hw1, (ii + jj * H) * 4, wrand(ii, jj, 0.04))
                jj = jj + 1
            ii = ii + 1
        ii = 0
        while ii < F:
            jj = 0
            while jj < H:
                wh = write_f32(hw2, (ii + jj * F) * 4, wrand(ii, jj, 0.04))
                jj = jj + 1
            ii = ii + 1
        wh = cuda_h2d(wqd, hwq, whb, 1)
        wh = cuda_h2d(wkd, hwk, whb, 1)
        wh = cuda_h2d(wvd, hwv, whb, 1)
        wh = cuda_h2d(wod, hwo, whb, 1)
        wh = cuda_h2d(w1d, hw1, w1b, 1)
        wh = cuda_h2d(w2d, hw2, w2b, 1)
        ll = ll + 1
    # head weight
    hWh = alloc_bytes(wh2)
    ii = 0
    while ii < H:
        jj = 0
        while jj < V:
            wh = write_f32(hWh, (ii + jj * H) * 4, wrand(ii, jj, 0.023))
            jj = jj + 1
        ii = ii + 1
    rc = cuda_malloc(cell, wh2)
    dWh = read_i64(cell, 0)
    wh = cuda_h2d(dWh, hWh, wh2, 1)
    ii = 0
    while ii < H:
        wh = write_f32(g1h, ii * 4, 1.0)
        wh = write_f32(b1h, ii * 4, 0.0)
        wh = write_f32(g2h, ii * 4, 1.0)
        wh = write_f32(b2h, ii * 4, 0.0)
        ii = ii + 1
    lr: "f32" = 8.0
    sfn: "i64" = sgd_init()
    if sfn == 0:
        print("SGD INIT FAIL")
        return 1
    gfn: "i64" = gelu_fwd_init()
    bfn: "i64" = gelu_bwd_init()
    if gfn == 0:
        print("GELU FWD INIT FAIL")
        return 1
    if bfn == 0:
        print("GELU BWD INIT FAIL")
        return 1
    rc = gelu_selftest(gfn, bfn)
    if rc != 0:
        print("GELU SELFTEST FAIL")
        return 1
    kh: "i64" = kern_init()
    if kh == 0:
        print("KERN INIT FAIL")
        return 1
    lnf: "i64" = read_i64(kh, 0)
    lnb: "i64" = read_i64(kh, 8)
    sff: "i64" = read_i64(kh, 16)
    sbk: "i64" = read_i64(kh, 24)
    gadd: "i64" = read_i64(kh, 32)
    th: "i64" = read_i64(kh, 40)
    tfh: "i64" = tof_init()
    if tfh == 0:
        print("TOF INIT FAIL")
        return 1
    lfn: "i64" = loss_init()
    if lfn == 0:
        print("LOSS INIT FAIL")
        return 1
    wh = cuda_h2d(dgam, g1h, hb, 1)
    wh = cuda_h2d(dbet, b1h, hb, 1)
    rc = zero_buf(hP, T * T)
    xin: "i64" = dX
    t0 = time_perf()
    tf: "f64" = 0.0
    tb: "f64" = 0.0
    thd: "f64" = 0.0
    step: "i32" = 1
    while step <= 2:
        tA = time_perf()
        wh = cuda_h2d(dX, hIN, qb, 1)
        xin = dX
        # ---- forward layers ----
        ll = 0
        while ll < NL:
            wqd = read_i64(AWq, ll * 8)
            wkd = read_i64(AWk, ll * 8)
            wvd = read_i64(AWv, ll * 8)
            wod = read_i64(AWo, ll * 8)
            w1d = read_i64(AW1, ll * 8)
            w2d = read_i64(AW2, ll * 8)
            xh1d = read_i64(AX1, ll * 8)
            s1d = read_i64(AS1, ll * 8)
            y2d = read_i64(AY2, ll * 8)
            xh2d = read_i64(AX2, ll * 8)
            s2d = read_i64(AS2, ll * 8)
            pd = read_i64(AP, ll * 8)
            zd = read_i64(AZ, ll * 8)
            od = read_i64(AO, ll * 8)
            # LN1 tren device: xin -> Y1 / XH1 / ST1
            y1d: "i64" = read_i64(AY1, ll * 8)
            rc = ln_fwd(lnf, xin, dgam, dbet, y1d, xh1d, s1d, T, H)
            if rc != 0:
                print("LN1 FWD FAIL", ll)
                return 1
            wh = cuda_h2d(dY1, y1d, qb, 3)
            rc = toh(th, dY1, fpA, sQH)
            rc = toh(th, wqd, fpB, sHH)
            rc = gemm16(ch, 0, 0, T, H, H, one, fpA, T, fpB, H, zero, dQ, T)
            if rc != 0:
                print("Q GEMM FAIL", ll, rc)
                return 1
            rc = toh(th, dY1, fpA, sQH)
            rc = toh(th, wkd, fpB, sHH)
            rc = gemm16(ch, 0, 0, T, H, H, one, fpA, T, fpB, H, zero, dK, T)
            if rc != 0:
                print("K GEMM FAIL", ll, rc)
                return 1
            rc = toh(th, dY1, fpA, sQH)
            rc = toh(th, wvd, fpB, sHH)
            rc = gemm16(ch, 0, 0, T, H, H, one, fpA, T, fpB, H, zero, dV, T)
            if rc != 0:
                print("V GEMM FAIL", ll, rc)
                return 1
            rc = toh(th, dQ, fpA, sQH)
            rc = toh(th, dK, fpB, sQH)
            rc = gemm16(ch, 0, 1, T, T, H, hal, fpA, T, fpB, T, zero, dS, T)
            if rc != 0:
                print("S GEMM FAIL", ll, rc)
                return 1
            rc = sf_fwd(sff, dS, dP, T)
            if rc != 0:
                print("SF FWD FAIL", ll)
                return 1
            wh = cuda_h2d(pd, dP, sb, 3)
            rc = toh(th, dP, fpA, sTT)
            rc = toh(th, dV, fpB, sQH)
            rc = gemm16(ch, 0, 0, T, H, T, one, fpA, T, fpB, T, zero, dA, T)
            if rc != 0:
                print("A GEMM FAIL", ll, rc)
                return 1
            rc = toh(th, dA, fpA, sQH)
            rc = toh(th, wod, fpB, sHH)
            rc = gemm16(ch, 0, 0, T, H, H, one, fpA, T, fpB, H, zero, dO, T)
            if rc != 0:
                print("O GEMM FAIL", ll, rc)
                return 1
            rc = add_k(gadd, xin, dO, dX2, T * H)
            if rc != 0:
                print("ADD X2 FAIL", ll)
                return 1
            rc = ln_fwd(lnf, dX2, dgam, dbet, y2d, xh2d, s2d, T, H)
            if rc != 0:
                print("LN2 FWD FAIL", ll)
                return 1
            wh = cuda_h2d(dY2, y2d, qb, 3)
            rc = toh(th, dY2, fpA, sQH)
            rc = toh(th, w1d, fpB, H * F)
            rc = gemm16h(ch, 0, 0, T, F, H, one, fpA, T, fpB, H, zero, dZ16, T)
            rc = tof(tfh, dZ16, dZ, T * F)
            wh = cuda_h2d(zd, dZ, fb, 3)
            rc = gelu_fwd(gfn, dZ, dHH, T * F)
            rc = toh(th, dHH, fpA, sTF)
            rc = toh(th, w2d, fpB, sFH)
            rc = gemm16(ch, 0, 0, T, H, F, one, fpA, T, fpB, F, zero, dO2, T)
            rc = add_k(gadd, dX2, dO2, dOUT, T * H)
            if rc != 0:
                print("ADD OUT FAIL", ll)
                return 1
            wh = cuda_h2d(od, dOUT, qb, 3)
            xin = dOUT
            ll = ll + 1
        tH = time_perf()
        # logits + loss tu OUT cua lop cuoi
        rc = toh(th, dOUT, fpA, sQH)
        rc = toh(th, dWh, fpB, sHV)
        rc = gemm16(ch, 0, 0, T, V, H, one, fpA, T, fpB, H, zero, dLG, T)
        wh = write_i32(hPK, 0, T)
        wh = write_i32(hPK, 4, V)
        wh = write_f32(hPK, 8, 1.0 / T)
        ii = 0
        while ii < T:
            wh = write_i32(hPK, 16 + ii * 4, read_i32(hIds, ii * 4))
            ii = ii + 1
        wh = cuda_h2d(dPK, hPK, 16 + T * 4, 1)
        rc = loss_fwd(lfn, dLG, dPK, dDL, dLS, T)
        if rc != 0:
            print("LOSS KERNEL FAIL")
            return 1
        wh = cuda_h2d(hLS, dLS, T * 4, 2)
        lossv: "f32" = 0.0
        ii = 0
        while ii < T:
            lossv = lossv + read_f32(hLS, ii * 4)
            ii = ii + 1
        print("LOSS", lossv)
        lf: "f64" = lossv
        print("LOSSF", lf)
        tB = time_perf()
        thd = thd + (tB - tH)
        tf = tf + (tH - tA)
        print("MARK FWD", step)
        rc = toh(th, dDL, fpA, sTV)
        rc = toh(th, dWh, fpB, sHV)
        rc = gemm16(ch, 0, 1, T, H, V, one, fpA, T, fpB, H, zero, gOUT, T)
        # ---- backward layers (nguoc) ----
        ll = NL - 1
        while ll >= 0:
            wqd = read_i64(AWq, ll * 8)
            wkd = read_i64(AWk, ll * 8)
            wvd = read_i64(AWv, ll * 8)
            wod = read_i64(AWo, ll * 8)
            w1d = read_i64(AW1, ll * 8)
            w2d = read_i64(AW2, ll * 8)
            gqd = read_i64(AGq, ll * 8)
            gkd = read_i64(AGk, ll * 8)
            gvd = read_i64(AGv, ll * 8)
            god = read_i64(AGo, ll * 8)
            g1d = read_i64(AG1, ll * 8)
            g2d = read_i64(AG2, ll * 8)
            xh1d = read_i64(AX1, ll * 8)
            s1d = read_i64(AS1, ll * 8)
            y2d = read_i64(AY2, ll * 8)
            xh2d = read_i64(AX2, ll * 8)
            s2d = read_i64(AS2, ll * 8)
            pd = read_i64(AP, ll * 8)
            zd = read_i64(AZ, ll * 8)
            od = read_i64(AO, ll * 8)
            # reload THIS layer's forward activations (no stale shared buffers)
            rc = gelu_fwd(gfn, zd, dHH, T * F)
            wh = cuda_h2d(dY1, read_i64(AY1, ll * 8), qb, 3)
            rc = toh(th, dY1, fpA, sQH)
            rc = toh(th, wqd, fpB, sHH)
            rc = gemm16(ch, 0, 0, T, H, H, one, fpA, T, fpB, H, zero, dQ, T)
            rc = toh(th, dY1, fpA, sQH)
            rc = toh(th, wkd, fpB, sHH)
            rc = gemm16(ch, 0, 0, T, H, H, one, fpA, T, fpB, H, zero, dK, T)
            rc = toh(th, dY1, fpA, sQH)
            rc = toh(th, wvd, fpB, sHH)
            rc = gemm16(ch, 0, 0, T, H, H, one, fpA, T, fpB, H, zero, dV, T)
            wh = cuda_h2d(dP, pd, sb, 3)
            rc = toh(th, dP, fpA, sTT)
            rc = toh(th, dV, fpB, sQH)
            rc = gemm16(ch, 0, 0, T, H, T, one, fpA, T, fpB, T, zero, dA, T)
            rc = toh(th, dHH, fpA, sTF)
            rc = toh(th, gOUT, fpB, sQH)
            rc = gemm16(ch, 1, 0, F, H, T, one, fpA, T, fpB, T, zero, g2d, F)
            rc = toh(th, gOUT, fpA, sQH)
            rc = toh(th, w2d, fpB, sFH)
            rc = gemm16(ch, 0, 1, T, F, H, one, fpA, T, fpB, F, zero, gHH, T)
            print("B1 dW2", ll)
            rc = gelu_bwd(bfn, zd, gHH, gZ, T * F)
            wh = cuda_h2d(dY2, y2d, qb, 3)
            print("B2 dZ", ll)
            rc = toh(th, dY2, fpA, sQH)
            rc = toh(th, gZ, fpB, sTF)
            rc = gemm16(ch, 1, 0, H, F, T, one, fpA, T, fpB, T, zero, g1d, H)
            rc = toh(th, gZ, fpA, sTF)
            rc = toh(th, w1d, fpB, H * F)
            rc = gemm16(ch, 0, 1, T, H, F, one, fpA, T, fpB, H, zero, gY2, T)
            rc = ln_bwd(lnb, xh2d, gY2, dgam, s2d, gDX2, T, H)
            if rc != 0:
                print("LN2 BWD FAIL", ll)
                return 1
            rc = add_k(gadd, gDX2, gOUT, gDX2, T * H)
            if rc != 0:
                print("ADD DX2 FAIL", ll)
                return 1
            print("B3 ln2", ll)
            rc = toh(th, gDX2, fpA, sQH)
            rc = toh(th, wod, fpB, sHH)
            rc = gemm16(ch, 0, 1, T, H, H, one, fpA, T, fpB, H, zero, gA, T)
            rc = toh(th, dA, fpA, sQH)
            rc = toh(th, gDX2, fpB, sQH)
            rc = gemm16(ch, 1, 0, H, H, T, one, fpA, T, fpB, T, zero, gWo, H)
            rc = toh(th, gA, fpA, sQH)
            rc = toh(th, dV, fpB, sQH)
            rc = gemm16(ch, 0, 1, T, T, H, one, fpA, T, fpB, T, zero, gP, T)
            rc = toh(th, dP, fpA, sTT)
            rc = toh(th, gA, fpB, sQH)
            rc = gemm16(ch, 1, 0, T, H, T, one, fpA, T, fpB, T, zero, gV, T)
            print("B4 attn", ll)
            rc = sf_bwd(sbk, gP, dP, gS, T)
            if rc != 0:
                print("SF BWD FAIL", ll)
                return 1
            print("B5 dS", ll)
            rc = toh(th, gS, fpA, sTT)
            rc = toh(th, dK, fpB, sQH)
            rc = gemm16(ch, 0, 0, T, H, T, hal, fpA, T, fpB, T, zero, gQ, T)
            rc = toh(th, gS, fpA, sTT)
            rc = toh(th, dQ, fpB, sQH)
            rc = gemm16(ch, 1, 0, T, H, T, hal, fpA, T, fpB, T, zero, gK, T)
            rc = toh(th, dY1, fpA, sQH)
            rc = toh(th, gQ, fpB, sQH)
            rc = gemm16(ch, 1, 0, H, H, T, one, fpA, T, fpB, T, zero, gqd, H)
            rc = toh(th, dY1, fpA, sQH)
            rc = toh(th, gK, fpB, sQH)
            rc = gemm16(ch, 1, 0, H, H, T, one, fpA, T, fpB, T, zero, gkd, H)
            rc = toh(th, dY1, fpA, sQH)
            rc = toh(th, gV, fpB, sQH)
            rc = gemm16(ch, 1, 0, H, H, T, one, fpA, T, fpB, T, zero, gvd, H)
            rc = toh(th, gQ, fpA, sQH)
            rc = toh(th, wqd, fpB, sHH)
            rc = gemm16(ch, 0, 1, T, H, H, one, fpA, T, fpB, H, zero, gDX2, T)
            rc = toh(th, gK, fpA, sQH)
            rc = toh(th, wkd, fpB, sHH)
            rc = gemm16(ch, 0, 1, T, H, H, one, fpA, T, fpB, H, one, gDX2, T)
            rc = toh(th, gV, fpA, sQH)
            rc = toh(th, wvd, fpB, sHH)
            rc = gemm16(ch, 0, 1, T, H, H, one, fpA, T, fpB, H, one, gDX2, T)
            print("B6 qkv", ll)
            wh = cuda_h2d(gY1, gDX2, qb, 3)
            rc = ln_bwd(lnb, xh1d, gY1, dgam, s1d, gDX2, T, H)
            if rc != 0:
                print("LN1 BWD FAIL", ll)
                return 1
            rc = add_k(gadd, gDX2, gOUT, gOUT, T * H)
            if rc != 0:
                print("ADD DX1 FAIL", ll)
                return 1
            print("MARK B", ll)
            ll = ll - 1
        tC = time_perf()
        tb = tb + (tC - tB)
        print("MARK BWD", step)
        ll = 0
        while ll < NL:
            gqd = read_i64(AGq, ll * 8)
            gkd = read_i64(AGk, ll * 8)
            gvd = read_i64(AGv, ll * 8)
            god = read_i64(AGo, ll * 8)
            g1d = read_i64(AG1, ll * 8)
            g2d = read_i64(AG2, ll * 8)
            rc = sgd_update(sfn, read_i64(AWq, ll * 8), gqd, H * H, lr)
            rc = sgd_update(sfn, read_i64(AWk, ll * 8), gkd, H * H, lr)
            rc = sgd_update(sfn, read_i64(AWv, ll * 8), gvd, H * H, lr)
            rc = sgd_update(sfn, read_i64(AWo, ll * 8), god, H * H, lr)
            rc = sgd_update(sfn, read_i64(AW1, ll * 8), g1d, H * F, lr)
            rc = sgd_update(sfn, read_i64(AW2, ll * 8), g2d, F * H, lr)

            ll = ll + 1
        print("MARK UPD", step)
        step = step + 1
    syn: "i32" = cuda_sync()
    t1 = time_perf()
    dtm: "f64" = t1 - t0
    print("MS_LAYERS", tf * 1000.0)
    print("MS_HEAD", thd * 1000.0)
    print("MS_BWD", tb * 1000.0)
    print("MS_TOTAL", dtm * 1000.0)
    print("MS_STEP", (dtm * 1000.0) / 2.0)
    print("BATCH DONE")
    return 0