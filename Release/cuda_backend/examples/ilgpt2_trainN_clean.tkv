def add_k(fnh: "i64", a: "i64", b: "i64", o: "i64", n: "i32") -> "i32":
    a0 = alloc_bytes(8)
    wh: "i64" = write_i64(a0, 0, a)
    a1 = alloc_bytes(8)
    wh = write_i64(a1, 0, b)
    a2 = alloc_bytes(8)
    wh = write_i64(a2, 0, o)
    a3 = alloc_bytes(4)
    wh = write_i32(a3, 0, n)
    pl = alloc_bytes(32)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    wh = write_i64(pl, 24, a3)
    g: "i32" = (n + 255) >> 8
    rc: "i32" = cu_launch(fnh, g, 1, 1, 256, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("ADD LAUNCH FAIL", rc)
        return 1
    return 0

def toh(fnh: "i64", src: "i64", dst: "i64", n: "i32") -> "i32":
    a0 = alloc_bytes(8)
