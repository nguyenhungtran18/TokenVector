    wh = write_i32(a2, 0, n)
    pl = alloc_bytes(24)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    g: "i32" = (n + 255) >> 8
    rc: "i32" = cu_launch(fnh, g, 1, 1, 256, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("TOH LAUNCH FAIL", rc)
        return 1
    return 0

def gemm16(handle: "i64", ta: "i32", tb: "i32", m: "i32", n: "i32", k: "i32", alpha: "i64", a: "i64", lda: "i32", b: "i64", ldb: "i32", beta: "i64", c: "i64", ldc: "i32") -> "i32":
    rc: "i32" = cublas_gemm_ex(handle, ta, tb, m, n, k, alpha, a, 2, lda, b, 2, ldb, beta, c, 0, ldc, 74, -1)
    if rc != 0:
        print("GEMM16 FAIL", rc)
    return rc

def gemm16h(handle: "i64", ta: "i32", tb: "i32", m: "i32", n: "i32", k: "i32", alpha: "i64", a: "i64", lda: "i32", b: "i64", ldb: "i32", beta: "i64", c: "i64", ldc: "i32") -> "i32":
    rc: "i32" = cublas_gemm_ex(handle, ta, tb, m, n, k, alpha, a, 2, lda, b, 2, ldb, beta, c, 2, ldc, 68, -1)
