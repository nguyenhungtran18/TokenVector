# -*- coding: utf-8 -*-
# IL-only attention backward. Tinh tren host bang .tkv; GPU luu ket qua.
# Khong C++/torch.
__tkv_extern_pinvoke__ = [
    {"name": "cu_init", "dll": "cuda.dll", "symbol": "cuInit",
     "convention": "cdecl", "params": ["i32"], "returns": "i32"},
    {"name": "cuda_malloc", "dll": "cudart.dll", "symbol": "cudaMalloc",
     "convention": "cdecl", "params": ["i64", "i64"], "returns": "i32"},
    {"name": "cuda_h2d", "dll": "cudart.dll", "symbol": "cudaMemcpy",
     "convention": "cdecl", "params": ["i64", "i64", "i64", "i32"], "returns": "i32"},
    {"name": "cublas_create", "dll": "cublas.dll", "symbol": "cublasCreate_v2",
     "convention": "cdecl", "params": ["i64"], "returns": "i32"},
    {"name": "cublas_sgemm", "dll": "cublas.dll", "symbol": "cublasSgemm_v2",
     "convention": "cdecl",
     "params": ["i64", "i32", "i32", "i32", "i32", "i32", "i64", "i64", "i32",
                "i64", "i32", "i64", "i64", "i32"], "returns": "i32"},
]


def run() -> "i32":
    rc: "i32" = cu_init(0)
    if rc != 0:
        return 1
    hcell = alloc_bytes(8)
    rc = cublas_create(hcell)
    ch = read_i64(hcell, 0)
    T: "i32" = 4
    D: "i32" = 8
    qd: "i32" = T * D * 4
    sd: "i32" = T * T * 4
    hQ = alloc_bytes(qd)
    hK = alloc_bytes(qd)
    hV = alloc_bytes(qd)
    hdO = alloc_bytes(qd)
    hP = alloc_bytes(sd)
    hE = alloc_bytes(sd)
    hdP = alloc_bytes(sd)
    hdS = alloc_bytes(sd)
    hdQ = alloc_bytes(qd)
    hdK = alloc_bytes(qd)
    hdV = alloc_bytes(qd)
    ho = alloc_bytes(qd)
    i: "i32" = 0
    j: "i32" = 0
    while i < T:
        j = 0
        while j < D:
            wq: "i64" = write_f32(hQ, (i + j * T) * 4, 1.0 + 0.1 * (i + j))
            wk: "i64" = write_f32(hK, (i + j * T) * 4, 0.5 + 0.05 * (i - j))
            wv: "i64" = write_f32(hV, (i + j * T) * 4, 0.2 + 0.03 * (i + j))
            wg: "i64" = write_f32(hdO, (i + j * T) * 4, 0.1 + 0.02 * j)
            j = j + 1
        i = i + 1
    # forward: scores, causal mask, softmax -> P
    i = 0
    while i < T:
        j = 0
        while j < T:
            sum: "f32" = 0.0
            sum = 0.0
            k: "i32" = 0
            while k < D:
                aq: "f32" = read_f32(hQ, (i + k * T) * 4)
                bk: "f32" = read_f32(hK, (j + k * T) * 4)
                sum = sum + aq * bk
                k = k + 1
            e: "f32" = 0.0
            e = 0.0
            if j <= i:
                e = exp(sum * 0.35355339)
            we: "i64" = write_f32(hE, (i + j * T) * 4, e)
            j = j + 1
        i = i + 1
    i = 0
    while i < T:
        z: "f32" = 0.0
        z = 0.0
        j = 0
        while j < T:
            ee: "f32" = read_f32(hE, (i + j * T) * 4)
            z = z + ee
            j = j + 1
        j = 0
        while j < T:
            ee = read_f32(hE, (i + j * T) * 4)
            wp: "i64" = write_f32(hP, (i + j * T) * 4, ee / z)
            j = j + 1
        i = i + 1
    # dP = dO * V^T ; row dot = sum_j P*dP
    ip: "i32" = 0
    while ip < T * T:
        pv = read_f32(hP, ip * 4)
        print("P", ip, pv)
        ip = ip + 1
    i = 0
    while i < T:
        j = 0
        while j < T:
            s: "f32" = 0.0
            s = 0.0
            k = 0
            while k < D:
                g: "f32" = read_f32(hdO, (i + k * T) * 4)
                vv: "f32" = read_f32(hV, (j + k * T) * 4)
                s = s + g * vv
                k = k + 1
            wdp: "i64" = write_f32(hdP, (i + j * T) * 4, s)
            j = j + 1
        i = i + 1
    i = 0
    while i < T:
        z = 0.0
        j = 0
        while j < T:
            pp: "f32" = read_f32(hP, (i + j * T) * 4)
            dp: "f32" = read_f32(hdP, (i + j * T) * 4)
            z = z + pp * dp
            j = j + 1
        j = 0
        while j < T:
            pp = read_f32(hP, (i + j * T) * 4)
            dp = read_f32(hdP, (i + j * T) * 4)
            wds: "i64" = write_f32(hdS, (i + j * T) * 4, pp * (dp - z))
            j = j + 1
        i = i + 1
    cell1 = alloc_bytes(8)
    rc = cuda_malloc(cell1, qd)
    dQ0 = read_i64(cell1, 0)
    rc = cuda_malloc(cell1, qd)
    dK0 = read_i64(cell1, 0)
    rc = cuda_malloc(cell1, qd)
    dV0 = read_i64(cell1, 0)
    rc = cuda_malloc(cell1, qd)
    dOdev = read_i64(cell1, 0)
    wqd: "i64" = cuda_h2d(dQ0, hQ, qd, 1)
    wkd: "i64" = cuda_h2d(dK0, hK, qd, 1)
    wvd: "i64" = cuda_h2d(dV0, hV, qd, 1)
    wog: "i64" = cuda_h2d(dOdev, hdO, qd, 1)
    # GEMM grads: dQ = inv*dS*K ; dK = inv*dS^T*Q ; dV = P^T*dO
    isx: "i32" = 0
    while isx < T * T:
        sv2 = read_f32(hdS, isx * 4)
        print("DS", isx, sv2)
        isx = isx + 1
    cell2 = alloc_bytes(8)
    rc = cuda_malloc(cell2, qd)
    dQ = read_i64(cell2, 0)
    rc = cuda_malloc(cell2, qd)
    dK = read_i64(cell2, 0)
    rc = cuda_malloc(cell2, qd)
    dV = read_i64(cell2, 0)
    rc = cuda_malloc(cell2, sd)
    dPdev = read_i64(cell2, 0)
    rc = cuda_malloc(cell2, sd)
    dSdev = read_i64(cell2, 0)
    rc = cuda_malloc(cell2, sd)
    dPdev2 = read_i64(cell2, 0)
    wgd1: "i64" = cuda_h2d(dPdev, hdP, sd, 1)
    wgd2: "i64" = cuda_h2d(dSdev, hdS, sd, 1)
    wgd3: "i64" = cuda_h2d(dPdev2, hP, sd, 1)
    ac = alloc_bytes(4)
    wa1: "i64" = write_f32(ac, 0, 0.35355339)
    one = alloc_bytes(4)
    wo1: "i64" = write_f32(one, 0, 1.0)
    zero = alloc_bytes(4)
    wz1: "i64" = write_f32(zero, 0, 0.0)
    rc = cublas_sgemm(ch, 0, 0, T, D, T, ac, dSdev, T, dK0, T, zero, dQ, T)
    rc = cublas_sgemm(ch, 1, 0, T, D, T, ac, dSdev, T, dQ0, T, zero, dK, T)
    rc = cublas_sgemm(ch, 1, 0, T, D, T, one, dPdev2, T, dOdev, T, zero, dV, T)
    wgq: "i64" = cuda_h2d(ho, dQ, qd, 2)
    i = 0
    while i < T * D:
        vv2 = read_f32(ho, i * 4)
        print("DQ", i, vv2)
        i = i + 1
    wgk: "i64" = cuda_h2d(ho, dK, qd, 2)
    i = 0
    while i < T * D:
        vv2 = read_f32(ho, i * 4)
        print("DK", i, vv2)
        i = i + 1
    wgv: "i64" = cuda_h2d(ho, dV, qd, 2)
    i = 0
    while i < T * D:
        vv2 = read_f32(ho, i * 4)
        print("DV", i, vv2)
        i = i + 1
    print("BATCH DONE")
    return 0
