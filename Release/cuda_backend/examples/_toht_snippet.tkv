
def toht_init() -> "i64":
    PTX = b".version 8.0\n.target sm_75\n.address_size 64\n.entry toht_kernel(.param .u64 px, .param .u64 py, .param .u32 pn, .param .u32 pf)\n{\n.reg .f32 fv;\n.reg .f16 hv;\n.reg .b16 uv;\n.reg .u64 xb,yb,off,qoff;\n.reg .u32 i,n,f,hn,j,q0,i2,q1,q,base,nt;\n.reg .pred p;\nld.param.u64 xb,[px];\nld.param.u64 yb,[py];\nld.param.u32 n,[pn];\nld.param.u32 f,[pf];\ncvta.to.global.u64 xb,xb;\ncvta.to.global.u64 yb,yb;\nmov.u32 nt,%ntid.x;\nmov.u32 base,%ctaid.x;\nmul.lo.u32 base,base,nt;\nmov.u32 i,%tid.x;\nadd.u32 i,i,base;\nsetp.ge.u32 p,i,n;\n@p bra LEND;\ndiv.u32 hn,n,f;\nmul.wide.u32 off,i,4;\nadd.u64 xb,xb,off;\nld.global.f32 fv,[xb];\ncvt.rn.f16.f32 hv,fv;\nmov.b16 uv,hv;\ndiv.u32 j,i,f;\nmul.lo.u32 q0,j,f;\nsub.u32 i2,i,q0;\nmul.lo.u32 q1,i2,hn;\nadd.u32 q,q1,j;\nmul.wide.u32 qoff,q,2;\nadd.u64 yb,yb,qoff;\nst.global.b16 [yb],uv;\nLEND:\nret;\n}\n"
    FNS = b"toht_kernel\x00"
    pb = alloc_bytes(len(PTX) + 1)
    kk: "i32" = 0
    while kk < len(PTX):
        wh: "i64" = write_u8(pb, kk, PTX[kk])
        kk = kk + 1
    wh = write_u8(pb, kk, 0)
    mc = alloc_bytes(8)
    rc: "i32" = cu_module_load(mc, pb)
    if rc != 0:
        print("TOHT MOD FAIL", rc)
        return 0
    mod: "i64" = read_i64(mc, 0)
    nb = alloc_bytes(len(FNS))
    kk = 0
    while kk < len(FNS):
        wh = write_u8(nb, kk, FNS[kk])
        kk = kk + 1
    fc = alloc_bytes(8)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("TOHT FN FAIL", rc)
        return 0
    fnh: "i64" = read_i64(fc, 0)
    return fnh

def toht(fnh: "i64", src: "i64", dst: "i64", n: "i32", f: "i32") -> "i32":
    a0 = alloc_bytes(8)
    wh: "i64" = write_i64(a0, 0, src)
    a1 = alloc_bytes(8)
    wh = write_i64(a1, 0, dst)
    a2 = alloc_bytes(4)
    wh = write_i32(a2, 0, n)
    a3 = alloc_bytes(4)
    wh = write_i32(a3, 0, f)
    pl = alloc_bytes(32)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    wh = write_i64(pl, 24, a3)
    g: "i32" = (n + 255) >> 8
    rc: "i32" = cu_launch(fnh, g, 1, 1, 256, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("TOHT LAUNCH FAIL", rc)
    return rc
