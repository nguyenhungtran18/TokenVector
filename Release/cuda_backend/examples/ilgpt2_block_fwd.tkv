]


def run() -> "i32":
    print("MARK 0 start")
    rc: "i32" = cu_init(0)
    if rc != 0:
        print("CUINIT FAIL", rc)
        return 1
    print("MARK 1 cuinit")
    hc = alloc_bytes(8)
    rc = cublas_create(hc)
    ch: "i64" = read_i64(hc, 0)
    T: "i32" = 4
    H: "i32" = 8
    F: "i32" = 4 * H
    tb: "i32" = T * 4
    hb: "i32" = H * 4
    h4: "i32" = F * 4
    qb: "i32" = T * H * 4
    fb: "i32" = T * F * 4
    sb: "i32" = T * T * 4
    stb: "i32" = T * 8
    # ---- host data (column-major) ----
    hX = alloc_bytes(qb)
    hWq = alloc_bytes(hb * H)
    hWk = alloc_bytes(hb * H)
    hWv = alloc_bytes(hb * H)
    hWo = alloc_bytes(hb * H)
    hW1 = alloc_bytes(h4 * H)
    hW2 = alloc_bytes(hb * F)
    hG1 = alloc_bytes(hb)
    hB1 = alloc_bytes(hb)
    hG2 = alloc_bytes(hb)
    hB2 = alloc_bytes(hb)
    i: "i32" = 0
    j: "i32" = 0
    while i < T:
        j = 0
        while j < H:
            w0: "i64" = write_f32(hX, (i + j * T) * 4, 0.1 + 0.02 * (i + j))
            j = j + 1
        i = i + 1
    i = 0
    while i < H:
        j = 0
        while j < H:
            w1: "i64" = write_f32(hWq, (i + j * H) * 4, 0.20 + 0.01 * (i + j))
            w2: "i64" = write_f32(hWk, (i + j * H) * 4, 0.15 + 0.01 * (i + j))
            w3: "i64" = write_f32(hWv, (i + j * H) * 4, 0.10 + 0.01 * (i + j))
            w4: "i64" = write_f32(hWo, (i + j * H) * 4, 0.30 + 0.01 * (i + j))
            j = j + 1
        w5: "i64" = write_f32(hG1, i * 4, 1.0 + 0.05 * i)
        w6: "i64" = write_f32(hB1, i * 4, 0.01 * i)
        w7: "i64" = write_f32(hG2, i * 4, 1.1 + 0.04 * i)
        w8: "i64" = write_f32(hB2, i * 4, 0.02 * i)
        i = i + 1
    i = 0
    while i < H:
        j = 0
        while j < F:
            w9: "i64" = write_f32(hW1, (i + j * H) * 4, 0.2 + 0.005 * (i + j))
            j = j + 1
        i = i + 1
    i = 0
    while i < F:
        j = 0
        while j < H:
            w10: "i64" = write_f32(hW2, (i + j * F) * 4, 0.2 + 0.005 * (i + j))
            j = j + 1
        i = i + 1
    # ---- device allocation ----
    cell = alloc_bytes(8)
    rc = cuda_malloc(cell, qb)
    dX = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dY1 = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dXH1 = read_i64(cell, 0)
    rc = cuda_malloc(cell, stb)
    dST1 = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dQ = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dK = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dV = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    dS = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    dP = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dA = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dO = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dX2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dY2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dXH2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, stb)
    dST2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, fb)
    dZ = read_i64(cell, 0)
    rc = cuda_malloc(cell, fb)
    dHH = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dO2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dOUT = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb * H)
    dWq = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb * H)
    dWk = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb * H)
    dWv = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb * H)
    dWo = read_i64(cell, 0)
    rc = cuda_malloc(cell, h4 * H)
    dW1 = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb * F)
    dW2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb)
    dG1 = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb)
    dB1 = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb)
    dG2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb)
    dB2 = read_i64(cell, 0)
    hd0: "i64" = cuda_h2d(dX, hX, qb, 1)
    hd1: "i64" = cuda_h2d(dWq, hWq, hb * H, 1)
    hd2: "i64" = cuda_h2d(dWk, hWk, hb * H, 1)
    hd3: "i64" = cuda_h2d(dWv, hWv, hb * H, 1)
    hd4: "i64" = cuda_h2d(dWo, hWo, hb * H, 1)
    hd5: "i64" = cuda_h2d(dW1, hW1, h4 * H, 1)
    hd6: "i64" = cuda_h2d(dW2, hW2, hb * F, 1)
    hd7: "i64" = cuda_h2d(dG1, hG1, hb, 1)
    hd8: "i64" = cuda_h2d(dB1, hB1, hb, 1)
    hd9: "i64" = cuda_h2d(dG2, hG2, hb, 1)
    hd10: "i64" = cuda_h2d(dB2, hB2, hb, 1)
    invH: "f32" = 1.0 / H
    eps: "f32" = 0.000001
    one: "f32" = 1.0
    zero: "f32" = 0.0
    alpha: "f32" = 1.0 / sqrt(H)
    PTX = b".version 8.0\n.target sm_75\n.address_size 64\n.entry lnf_kernel(.param .u64 px, .param .u64 pg, .param .u64 pb, .param .u64 py, .param .u64 pxh, .param .u64 pst, .param .u32 pT, .param .u32 pH, .param .f32 pinvH, .param .f32 peps)\n{\n.reg .f32 x,sum,sq,mean,var,rstd,g,b,xh,y,t,ss,eps,invh;\n.reg .u64 xb,gb,bb,yb,hb,stb,off,offg,xa,ga,ba,ya,ha,sta;\n.reg .u32 row,j,tn,hn,idx;\n.reg .pred q;\nld.param.u64 xb,[px];\nld.param.u64 gb,[pg];\nld.param.u64 bb,[pb];\nld.param.u64 yb,[py];\nld.param.u64 hb,[pxh];\nld.param.u64 stb,[pst];\nld.param.u32 tn,[pT];\nld.param.u32 hn,[pH];\nld.param.f32 invh,[pinvH];\nld.param.f32 eps,[peps];\ncvta.to.global.u64 xb,xb;\ncvta.to.global.u64 gb,gb;\ncvta.to.global.u64 bb,bb;\ncvta.to.global.u64 yb,yb;\ncvta.to.global.u64 hb,hb;\ncvta.to.global.u64 stb,stb;\nmov.u32 row,%tid.x;\nsetp.ge.u32 q,row,tn;\n@q bra LEND;\nmov.f32 sum,0.0;\nmov.f32 sq,0.0;\nmov.u32 j,0;\nL1:\nsetp.ge.u32 q,j,hn;\n@q bra L1D;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nadd.f32 sum,sum,x;\nmul.f32 ss,x,x;\nadd.f32 sq,sq,ss;\nadd.u32 j,j,1;\nbra L1;\nL1D:\nmul.f32 mean,sum,invh;\nmul.f32 var,sq,invh;\nmul.f32 ss,mean,mean;\nsub.f32 var,var,ss;\nadd.f32 var,var,eps;\nsqrt.rn.f32 rstd,var;\nrcp.approx.f32 rstd,rstd;\nmul.wide.u32 off,row,8;\nadd.u64 sta,stb,off;\nst.global.f32 [sta],mean;\nadd.u64 sta,sta,4;\nst.global.f32 [sta],rstd;\nmov.u32 j,0;\nL2:\nsetp.ge.u32 q,j,hn;\n@q bra LEND;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nsub.f32 xh,x,mean;\nmul.f32 xh,xh,rstd;\nmul.wide.u32 offg,j,4;\nadd.u64 ga,gb,offg;\nld.global.f32 g,[ga];\nadd.u64 ba,bb,offg;\nld.global.f32 b,[ba];\nmul.f32 y,xh,g;\nadd.f32 y,y,b;\nadd.u64 ya,yb,off;\nst.global.f32 [ya],y;\nadd.u64 ha,hb,off;\nst.global.f32 [ha],xh;\nadd.u32 j,j,1;\nbra L2;\nLEND:\nret;\n}\n.entry sf_kernel(.param .u64 ps, .param .u64 pp, .param .u32 pT, .param .f32 pone)\n{\n.reg .f32 x,mx,sum,e,p,one;\n.reg .u64 sb,pb,off,xa,pa;\n.reg .u32 row,j,tn,idx;\n.reg .pred q;\nld.param.u64 sb,[ps];\nld.param.u64 pb,[pp];\nld.param.u32 tn,[pT];\nld.param.f32 one,[pone];\ncvta.to.global.u64 sb,sb;\ncvta.to.global.u64 pb,pb;\nmov.u32 row,%tid.x;\nsetp.ge.u32 q,row,tn;\n@q bra LEND;\nmov.f32 mx,-1000000000.0;\nmov.u32 j,0;\nL1:\nsetp.gt.u32 q,j,row;\n@q bra L1D;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,sb,off;\nld.global.f32 x,[xa];\nmax.f32 mx,mx,x;\nadd.u32 j,j,1;\nbra L1;\nL1D:\nmov.f32 sum,0.0;\nmov.u32 j,0;\nL2:\nsetp.gt.u32 q,j,row;\n@q bra L2D;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,sb,off;\nld.global.f32 x,[xa];\nsub.f32 x,x,mx;\nmul.f32 x,x,1.442695;\nex2.approx.f32 e,x;\nadd.f32 sum,sum,e;\nadd.u32 j,j,1;\nbra L2;\nL2D:\nmov.u32 j,0;\nL3:\nsetp.ge.u32 q,j,tn;\n@q bra LEND;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmov.f32 p,0.0;\nsetp.gt.u32 q,j,row;\n@q bra L3W;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,sb,off;\nld.global.f32 x,[xa];\nsub.f32 x,x,mx;\nmul.f32 x,x,1.442695;\nex2.approx.f32 e,x;\ndiv.rn.f32 p,e,sum;\nL3W:\nmul.wide.u32 off,idx,4;\nadd.u64 pa,pb,off;\nst.global.f32 [pa],p;\nadd.u32 j,j,1;\nbra L3;\nLEND:\nret;\n}\n.entry add_kernel(.param .u64 pa, .param .u64 pb, .param .u64 py, .param .u32 pn)\n{\n.reg .f32 a,b,c;\n.reg .u64 xa,xb,ya,off;\n.reg .u32 i,n;\n.reg .pred q;\nld.param.u64 xa,[pa];\nld.param.u64 xb,[pb];\nld.param.u64 ya,[py];\nld.param.u32 n,[pn];\ncvta.to.global.u64 xa,xa;\ncvta.to.global.u64 xb,xb;\ncvta.to.global.u64 ya,ya;\nmov.u32 i,%tid.x;\nsetp.ge.u32 q,i,n;\n@q bra LEND;\nmul.wide.u32 off,i,4;\nadd.u64 xa,xa,off;\nadd.u64 xb,xb,off;\nadd.u64 ya,ya,off;\nld.global.f32 a,[xa];\nld.global.f32 b,[xb];\nadd.f32 c,a,b;\nst.global.f32 [ya],c;\nLEND: ret;\n}\n.entry gelu_kernel(.param .u64 px, .param .u64 py, .param .u32 pn)\n{\n.reg .f32 f1,f2,f3,f4,f5;\n.reg .u64 x,y,off;\n.reg .u32 i,n;\n.reg .pred q;\nld.param.u64 x,[px];\nld.param.u64 y,[py];\nld.param.u32 n,[pn];\nmov.u32 i,%tid.x;\nsetp.ge.u32 q,i,n;\n@q bra LEND;\nmul.wide.u32 off,i,4;\ncvta.to.global.u64 x,x;\ncvta.to.global.u64 y,y;\nadd.u64 x,x,off;\nadd.u64 y,y,off;\nld.global.f32 f1,[x];\nmul.f32 f3,f1,f1;\nmul.f32 f3,f3,f1;\nmov.f32 f4,0.044715;\nfma.rn.f32 f3,f3,f4,f1;\nmov.f32 f4,0.79788456;\nmul.f32 f2,f3,f4;\ntanh.approx.f32 f2,f2;\nmov.f32 f3,1.0;\nadd.f32 f2,f2,f3;\nmov.f32 f3,0.5;\nmul.f32 f2,f2,f3;\nmul.f32 f5,f1,f2;\nst.global.f32 [y],f5;\nLEND: ret;\n}\n"
    FN1 = b"lnf_kernel\x00"
    FN2 = b"sf_kernel\x00"
    FN3 = b"add_kernel\x00"
    FN4 = b"gelu_kernel\x00"
    pbuf = alloc_bytes(len(PTX) + 1)
    kk: "i32" = 0
    while kk < len(PTX):
        wu: "i64" = write_u8(pbuf, kk, PTX[kk])
        kk = kk + 1
    wz: "i64" = write_u8(pbuf, kk, 0)
    mc = alloc_bytes(8)
    rc = cu_module_load(mc, pbuf)
    if rc != 0:
        print("MODULE FAIL", rc)
        return 1
    mod: "i64" = read_i64(mc, 0)
    print("MARK 2 module", mod)
    nb = alloc_bytes(32)
    r1: "i32" = 0
    while r1 < len(FN1):
        w1: "i64" = write_u8(nb, r1, FN1[r1])
        r1 = r1 + 1
    fc = alloc_bytes(8)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("FN LNF FAIL", rc)
        return 1
    k_lnf: "i64" = read_i64(fc, 0)
    r1 = 0
    while r1 < len(FN2):
        w2: "i64" = write_u8(nb, r1, FN2[r1])
        r1 = r1 + 1
    wz1: "i64" = write_u8(nb, r1, 0)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("FN SF FAIL", rc)
        return 1
    k_sf: "i64" = read_i64(fc, 0)
    r1 = 0
    while r1 < len(FN3):
        w3: "i64" = write_u8(nb, r1, FN3[r1])
        r1 = r1 + 1
    wz2: "i64" = write_u8(nb, r1, 0)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("FN ADD FAIL", rc)
        return 1
    k_add: "i64" = read_i64(fc, 0)
    r1 = 0
    while r1 < len(FN4):
        w4: "i64" = write_u8(nb, r1, FN4[r1])
        r1 = r1 + 1
    wz3: "i64" = write_u8(nb, r1, 0)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("FN GELU FAIL", rc)
        return 1
    k_gelu: "i64" = read_i64(fc, 0)
    print("MARK 3 functions", k_lnf, k_sf, k_add, k_gelu)
    # scalar buffers
    ha = alloc_bytes(4)
    wa: "i64" = write_f32(ha, 0, one)
    hb0 = alloc_bytes(4)
    wb: "i64" = write_f32(hb0, 0, zero)
    hal = alloc_bytes(4)
    wl: "i64" = write_f32(hal, 0, alpha)
    # 1) LN1
    a0 = alloc_bytes(8)
    qp0: "i64" = write_i64(a0, 0, dX)
    a1 = alloc_bytes(8)
    qp1: "i64" = write_i64(a1, 0, dG1)
    a2 = alloc_bytes(8)
    qp2: "i64" = write_i64(a2, 0, dB1)
    a3 = alloc_bytes(8)
    qp3: "i64" = write_i64(a3, 0, dY1)
    a4 = alloc_bytes(8)
    qp4: "i64" = write_i64(a4, 0, dXH1)
    a5 = alloc_bytes(8)
    qp5: "i64" = write_i64(a5, 0, dST1)
    a6 = alloc_bytes(4)
    qp6: "i64" = write_i32(a6, 0, T)
    a7 = alloc_bytes(4)
    qp7: "i64" = write_i32(a7, 0, H)
    a8 = alloc_bytes(4)
    qp8: "i64" = write_f32(a8, 0, invH)
    a9 = alloc_bytes(4)
    qp9: "i64" = write_f32(a9, 0, eps)
    pl = alloc_bytes(80)
    wzp0: "i64" = write_i64(pl, 0, a0)
    wzp1: "i64" = write_i64(pl, 8, a1)
    wzp2: "i64" = write_i64(pl, 16, a2)
    wzp3: "i64" = write_i64(pl, 24, a3)
    wzp4: "i64" = write_i64(pl, 32, a4)
    wzp5: "i64" = write_i64(pl, 40, a5)
    wzp6: "i64" = write_i64(pl, 48, a6)
    wzp7: "i64" = write_i64(pl, 56, a7)
    wzp8: "i64" = write_i64(pl, 64, a8)
    wzp9: "i64" = write_i64(pl, 72, a9)
    rc = cu_launch(k_lnf, 1, 1, 1, 64, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("LNF FAIL", rc)
        return 1
    print("MARK 4 lnf")
    # 2) Q,K,V
    rc = cublas_sgemm(ch, 0, 0, T, H, H, ha, dY1, T, dWq, H, hb0, dQ, T)
    if rc != 0:
        print("Q FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 0, 0, T, H, H, ha, dY1, T, dWk, H, hb0, dK, T)
    if rc != 0:
        print("K FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 0, 0, T, H, H, ha, dY1, T, dWv, H, hb0, dV, T)
    if rc != 0:
        print("V FAIL", rc)
        return 1
    # 3) S = Q K^T / sqrt(H)
    rc = cublas_sgemm(ch, 0, 1, T, T, H, hal, dQ, T, dK, T, hb0, dS, T)
    if rc != 0:
        print("S FAIL", rc)
        return 1
    print("MARK 5 qkv+s")
    # 4) causal softmax P
    s0 = alloc_bytes(8)
    ws0: "i64" = write_i64(s0, 0, dS)
    s1 = alloc_bytes(8)
    ws1: "i64" = write_i64(s1, 0, dP)
    s2 = alloc_bytes(4)
    ws2: "i64" = write_i32(s2, 0, T)
    s3 = alloc_bytes(4)
    ws3: "i64" = write_f32(s3, 0, one)
    ps = alloc_bytes(32)
    wp0: "i64" = write_i64(ps, 0, s0)
    wp1: "i64" = write_i64(ps, 8, s1)
    wp2: "i64" = write_i64(ps, 16, s2)
    wp3: "i64" = write_i64(ps, 24, s3)
    rc = cu_launch(k_sf, 1, 1, 1, 64, 1, 1, 0, 0, ps, 0)
    if rc != 0:
        print("SF FAIL", rc)
        return 1
    print("MARK 6 softmax")
    # 5) A = P V
    rc = cublas_sgemm(ch, 0, 0, T, H, T, ha, dP, T, dV, T, hb0, dA, T)
    if rc != 0:
        print("A FAIL", rc)
        return 1
    # 6) O = A Wo
    rc = cublas_sgemm(ch, 0, 0, T, H, H, ha, dA, T, dWo, H, hb0, dO, T)
    if rc != 0:
        print("O FAIL", rc)
        return 1
    # 7) X2 = X + O
    c0 = alloc_bytes(8)
    wc0: "i64" = write_i64(c0, 0, dX)
    c1 = alloc_bytes(8)
    wc1: "i64" = write_i64(c1, 0, dO)
    c2 = alloc_bytes(8)
    wc2: "i64" = write_i64(c2, 0, dX2)
    c3 = alloc_bytes(4)
    wc3: "i64" = write_i32(c3, 0, T * H)
    pa = alloc_bytes(32)
    wpa0: "i64" = write_i64(pa, 0, c0)
    wpa1: "i64" = write_i64(pa, 8, c1)
    wpa2: "i64" = write_i64(pa, 16, c2)
    wpa3: "i64" = write_i64(pa, 24, c3)
    rc = cu_launch(k_add, 1, 1, 1, 64, 1, 1, 0, 0, pa, 0)
    if rc != 0:
        print("ADD1 FAIL", rc)
        return 1
    print("MARK 7 attn+res")
    # 8) LN2 - buffer params RIENG (khong tai dung pl/wzp*)
    pl2 = alloc_bytes(80)
    lz0: "i64" = write_i64(pl2, 0, dX2)
    lz1: "i64" = write_i64(pl2, 8, dG2)
    lz2: "i64" = write_i64(pl2, 16, dB2)
    lz3: "i64" = write_i64(pl2, 24, dY2)
    lz4: "i64" = write_i64(pl2, 32, dXH2)
    lz5: "i64" = write_i64(pl2, 40, dST2)
    lz6: "i64" = write_i64(pl2, 48, a6)
    lz7: "i64" = write_i64(pl2, 56, a7)
    lz8: "i64" = write_i64(pl2, 64, a8)
    lz9: "i64" = write_i64(pl2, 72, a9)
    print("MARK 7w params")
    rc = cu_launch(k_lnf, 1, 1, 1, 64, 1, 1, 0, 0, pl2, 0)
    if rc != 0:
        print("LNF2 FAIL", rc)
        return 1
    print("MARK 7a lnf2")
    # 9) Z = Y2 W1
    rc = cublas_sgemm(ch, 0, 0, T, F, H, ha, dY2, T, dW1, H, hb0, dZ, T)
    if rc != 0:
        print("Z FAIL", rc)
        return 1
    print("MARK 7b z gemm")
    # 10) gelu
    g0 = alloc_bytes(8)
    wg0: "i64" = write_i64(g0, 0, dZ)
    g1 = alloc_bytes(8)
    wg1: "i64" = write_i64(g1, 0, dHH)
    g2 = alloc_bytes(4)
    wg2: "i64" = write_i32(g2, 0, T * F)
    pg = alloc_bytes(24)
    wpg0: "i64" = write_i64(pg, 0, g0)
    wpg1: "i64" = write_i64(pg, 8, g1)
    wpg2: "i64" = write_i64(pg, 16, g2)
    rc = cu_launch(k_gelu, 1, 1, 1, 128, 1, 1, 0, 0, pg, 0)
    if rc != 0:
        print("GELU FAIL", rc)
        return 1
    print("MARK 8 mlp")
    # 11) O2 = HH W2
    rc = cublas_sgemm(ch, 0, 0, T, H, F, ha, dHH, T, dW2, F, hb0, dO2, T)
    if rc != 0:
        print("O2 FAIL", rc)
        return 1
    print("MARK 8a o2 gemm")
    # 12) OUT = X2 + O2
    wzp0 = write_i64(c1, 0, dO2)
    wzp0 = write_i64(c2, 0, dOUT)
    rc = cu_launch(k_add, 1, 1, 1, 64, 1, 1, 0, 0, pa, 0)
    if rc != 0:
        print("ADD2 FAIL", rc)
        return 1
    print("MARK 9 done")
    # dump
    hout = alloc_bytes(fb)
    d1: "i64" = cuda_h2d(hout, dY1, qb, 2)
    i = 0
    while i < T:
        j = 0
        while j < H:
            vv: "f32" = read_f32(hout, (i + j * T) * 4)
            print("Y1", i, j, vv)
            j = j + 1
        i = i + 1
    d2: "i64" = cuda_h2d(hout, dP, sb, 2)
    i = 0
    while i < T:
        j = 0
        while j < T:
            vv = read_f32(hout, (i + j * T) * 4)
            print("P", i, j, vv)
            j = j + 1
        i = i + 1
    d3: "i64" = cuda_h2d(hout, dX2, qb, 2)
    i = 0
    while i < T:
        j = 0
        while j < H:
            vv = read_f32(hout, (i + j * T) * 4)
            print("X2", i, j, vv)
            j = j + 1
        i = i + 1
    d4: "i64" = cuda_h2d(hout, dY2, qb, 2)
    i = 0
    while i < T:
        j = 0
        while j < H:
            vv = read_f32(hout, (i + j * T) * 4)
            print("Y2", i, j, vv)
            j = j + 1
        i = i + 1
    d5: "i64" = cuda_h2d(hout, dHH, fb, 2)
    i = 0
    while i < T:
        j = 0
        while j < F:
            vv = read_f32(hout, (i + j * T) * 4)
            print("HH", i, j, vv)
            j = j + 1
        i = i + 1
    d6: "i64" = cuda_h2d(hout, dOUT, qb, 2)
    i = 0
    while i < T:
        j = 0
        while j < H:
            vv = read_f32(hout, (i + j * T) * 4)
            print("OUT", i, j, vv)
            j = j + 1
        i = i + 1
    print("BATCH DONE")
    return 0
