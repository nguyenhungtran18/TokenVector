# -*- coding: utf-8 -*-
# Tuong duong BIT-EXACT GeluErfFwd_impl: out[i-lo] = gelu_f(x[i])
# gelu_f -> tkv_gelu_f (helper C duoc notebook chen vao file sinh).
# Signature khop native: GeluErfFwd(x, x_len, out, out_len, lo, hi)
# @tkv.cpu_kernel target="avx2"
def GeluErfFwd(x: "ptr[f32]", x_len: "i32", out: "ptr[f32]", out_len: "i32", lo: "i64", hi: "i64") -> "i32":
    for i in range(hi):
        if i >= lo:
            out[i - lo] = gelu_f(x[i])
    return 0


def run() -> "i32":
    return 0