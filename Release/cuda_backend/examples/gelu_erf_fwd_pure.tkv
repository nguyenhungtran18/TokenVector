# -*- coding: utf-8 -*-
# GeluErfFwd THUAN TOKENVECTOR (thay auto-glue C).
# Native co 2 duong: AVX2 (tkv_exp_ps custom, f32) cho i+8<=hi, va scalar
# (exp double) cho tail. Replicate CA HAI de bit-exact moi loai/hi.
# @tkv.cpu_kernel target="avx2"
def GeluErfFwd(x: "ptr[f32]", x_len: "i32", out: "ptr[f32]", out_len: "i32", lo: "i64", hi: "i64") -> "i32":
    n8 = (hi - lo) // 8 % 1000000
    for k in range(n8):
        base = lo + k * 8
        for lane in range(8):
            f_v = x[base + lane]
            f_arg = f_v * 0.70710678118654752f
            f_sg = 1.0f
            if f_arg < 0.0f:
                f_sg = -1.0f
            f_ax = tkv_fabs(f_arg)
            f_ax = tkv_fmax(f_ax, 0.0f)
            f_t = 1.0f / fma(0.3275911f, f_ax, 1.0f)
            f_p = 1.061405429f
            f_p = fma(f_p, f_t, -1.453152027f)
            f_p = fma(f_p, f_t, 1.421413741f)
            f_p = fma(f_p, f_t, -0.284496736f)
            f_p = fma(f_p, f_t, 0.254829592f)
            f_p = fma(f_p, f_t, 0.0f)
            f_ax2 = f_ax * f_ax
            f_neg2 = f_ax2 * -1.0f
            f_neg2 = tkv_fmax(f_neg2, -90.0f)
            f_kf = tkv_rint(f_neg2 * 1.4426950408889634f)
            f_r = fma(-f_kf, 0.6931471805599453f, f_neg2)
            f_ep = 2.48015873e-05f
            f_ep = fma(f_ep, f_r, 1.98412698e-04f)
            f_ep = fma(f_ep, f_r, 1.38888889e-03f)
            f_ep = fma(f_ep, f_r, 8.33333333e-03f)
            f_ep = fma(f_ep, f_r, 4.16666667e-02f)
            f_ep = fma(f_ep, f_r, 1.66666667e-01f)
            f_ep = fma(f_ep, f_r, 5.00000000e-01f)
            f_ep = fma(f_ep, f_r, 1.00000000e+00f)
            f_ep = fma(f_ep, f_r, 1.00000000e+00f)
            f_pow = tkv_ldexp(1.0f, f_kf)
            f_e = f_ep * f_pow
            f_erf = fma(-f_e, f_p, 1.0f)
            f_erf = f_sg * f_erf
            f_op = 1.0f + f_erf
            out[base + lane - lo] = (0.5f * f_v) * f_op
    nt = (hi - lo - n8 * 8) % 1000000
    for j in range(nt):
        i = (lo + n8 * 8 + j) % 1000000000
        t_v = x[i]
        t_arg = t_v / 1.4142135623730951f
        d_sg = 1.0
        if t_arg < 0.0f:
            d_sg = -1.0
        t_ax = tkv_fabs(t_arg)
        d_t = 1.0 / (1.0 + 0.3275911 * t_ax)
        d_p = 1.061405429
        d_p = d_p * d_t + -1.453152027
        d_p = d_p * d_t + 1.421413741
        d_p = d_p * d_t + -0.284496736
        d_p = d_p * d_t + 0.254829592
        d_p = d_p * d_t
        t_nax2 = (-t_ax) * t_ax
        t_e = d_exp(t_nax2)
        d_r = d_sg * (1.0 - t_e * d_p)
        t_r = d_r
        t_op = 1.0f + t_r
        out[i - lo] = (0.5f * t_v) * t_op


def run() -> "i32":
    return 0