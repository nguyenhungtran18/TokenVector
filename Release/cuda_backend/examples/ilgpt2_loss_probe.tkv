# -*- coding: utf-8 -*-
# Probe toi thieu cho loss_kernel_packed (CE device, packed params, combined output). Khong C++/torch.
__tkv_extern_pinvoke__ = [
    {"name": "cu_init", "dll": "cuda.dll", "symbol": "cuInit",
     "convention": "cdecl", "params": ["i32"], "returns": "i32"},
    {"name": "cu_module_load", "dll": "cuda.dll", "symbol": "cuModuleLoadData",
     "convention": "cdecl", "params": ["i64", "i64"], "returns": "i32"},
    {"name": "cu_module_fn", "dll": "cuda.dll", "symbol": "cuModuleGetFunction",
     "convention": "cdecl", "params": ["i64", "i64", "i64"], "returns": "i32"},
    {"name": "cu_launch", "dll": "cuda.dll", "symbol": "cuLaunchKernel",
     "convention": "cdecl",
     "params": ["i64", "i32", "i32", "i32", "i32", "i32", "i32", "i32", "i64", "i64", "i64"],
     "returns": "i32"},
    {"name": "cuda_malloc", "dll": "cudart.dll", "symbol": "cudaMalloc",
     "convention": "cdecl", "params": ["i64", "i64"], "returns": "i32"},
    {"name": "cuda_h2d", "dll": "cudart.dll", "symbol": "cudaMemcpy",
     "convention": "cdecl", "params": ["i64", "i64", "i64", "i32"], "returns": "i32"},
]

def run() -> "i32":
    PTX = b".version 8.0\n.target sm_75\n.address_size 64\n.entry loss_kernel_packed(.param .u64 pLG, .param .u64 pPk, .param .u64 pOut)\n{\n.reg .f32 mx,x,t,e,sum,p,l,lsum,inv;\n.reg .u64 xb,pb,ob,yb,off,xa,ia,ya,la;\n.reg .u32 row,i,vn,tn,id,idx;\n.reg .pred q,pis;\nld.param.u64 xb,[pLG];\nld.param.u64 pb,[pPk];\nld.param.u64 ob,[pOut];\ncvta.to.global.u64 xb,xb;\ncvta.to.global.u64 pb,pb;\ncvta.to.global.u64 ob,ob;\nld.global.u32 tn,[pb];\nld.global.u32 vn,[pb+4];\nld.global.f32 inv,[pb+8];\nmov.u32 row,%tid.x;\nsetp.ge.u32 q,row,tn;\n@q bra LEND;\nmul.wide.u32 off,tn,4;\nadd.u64 yb,ob,off;\nmov.f32 mx,-1000000000.0;\nmov.u32 i,0;\nLMAX:\nsetp.ge.u32 q,i,vn;\n@q bra MAXDONE;\nmul.lo.u32 idx,i,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nmax.f32 mx,mx,x;\nadd.u32 i,i,1;\nbra LMAX;\nMAXDONE:\nmov.f32 sum,0.0;\nmov.u32 i,0;\nLSUM:\nsetp.ge.u32 q,i,vn;\n@q bra SUMDONE;\nmul.lo.u32 idx,i,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nsub.f32 t,x,mx;\nmul.f32 t,t,1.442695;\nex2.approx.f32 e,t;\nadd.f32 sum,sum,e;\nadd.u32 i,i,1;\nbra LSUM;\nSUMDONE:\nmul.wide.u32 off,row,4;\nadd.u64 ia,pb,off;\nld.global.u32 id,[ia+16];\nmul.lo.u32 idx,id,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nlg2.approx.f32 lsum,sum;\nmul.f32 lsum,lsum,0.69314718;\nadd.f32 l,mx,lsum;\nsub.f32 l,l,x;\nmul.f32 l,l,inv;\nmul.wide.u32 off,row,4;\nadd.u64 la,ob,off;\nst.global.f32 [la],l;\nmov.u32 i,0;\nLDL:\nsetp.ge.u32 q,i,vn;\n@q bra LEND;\nmul.lo.u32 idx,i,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 xa,xb,off;\nld.global.f32 x,[xa];\nsub.f32 t,x,mx;\nmul.f32 t,t,1.442695;\nex2.approx.f32 e,t;\ndiv.rn.f32 p,e,sum;\nsetp.eq.u32 pis,i,id;\n@pis sub.f32 p,p,1.0;\nmul.f32 p,p,inv;\nadd.u64 ya,yb,off;\nst.global.f32 [ya],p;\nadd.u32 i,i,1;\nbra LDL;\nLEND:\nret;\n}\n"
    FN = b"loss_kernel_packed\x00"
    rc: "i32" = cu_init(0)
    if rc != 0:
        return 1
    T: "i32" = 2
    V: "i32" = 3
    n: "i32" = T * V
    # logits col-major [V rows x T cols]: (row i, col j) at i + j*V
    hx = alloc_bytes(n * 4)
    # col0 (t=0): 1.0 2.0 3.0 ; col1 (t=1): 0.5 0.25 0.75
    wh: "i64" = write_f32(hx, 0, 1.0)
    wh = write_f32(hx, 4, 2.0)
    wh = write_f32(hx, 8, 3.0)
    wh = write_f32(hx, 12, 0.5)
    wh = write_f32(hx, 16, 0.25)
    wh = write_f32(hx, 20, 0.75)
    id0: "i32" = 2
    id1: "i32" = 0
    # packed params: u32 T, u32 V, f32 invT, pad, u32 ids[T]
    hp = alloc_bytes(16 + T * 4)
    wh = write_i32(hp, 0, T)
    wh = write_i32(hp, 4, V)
    wh = write_f32(hp, 8, 1.0 / (T * 1.0))
    wh = write_i32(hp, 12, 0)
    wh = write_i32(hp, 16, id0)
    wh = write_i32(hp, 20, id1)
    cell = alloc_bytes(8)
    rc = cuda_malloc(cell, n * 4)
    dx = read_i64(cell, 0)
    rc = cuda_malloc(cell, 16 + T * 4)
    dpk = read_i64(cell, 0)
    rc = cuda_malloc(cell, T * 4 + n * 4)
    dout = read_i64(cell, 0)
    wh = cuda_h2d(dx, hx, n * 4, 1)
    wh = cuda_h2d(dpk, hp, 16 + T * 4, 1)
    # CPU reference buffers
    refl = alloc_bytes(T * 4)
    refdl = alloc_bytes(n * 4)
    t0: "i32" = 0
    while t0 < T:
        mx: "f32" = -1000000000.0
        jj: "i32" = 0
        while jj < V:
            xv: "f32" = read_f32(hx, (t0 + jj * T) * 4)
            if xv > mx:
                mx = xv
            jj = jj + 1
        zs: "f32" = 0.0
        jj = 0
        while jj < V:
            zs = zs + exp(read_f32(hx, (t0 + jj * T) * 4) - mx)
            jj = jj + 1
        idv: "i32" = 0
        if t0 == 0:
            idv = id0
        else:
            idv = id1
        pc: "f32" = exp(read_f32(hx, (t0 + idv * T) * 4) - mx) / zs
        wh = write_f32(refl, t0 * 4, (0.0 - log(pc)) / T)
        jj = 0
        while jj < V:
            pv: "f32" = exp(read_f32(hx, (t0 + jj * T) * 4) - mx) / zs
            dv: "f32" = pv
            if jj == idv:
                dv = dv - 1.0
            wh = write_f32(refdl, (t0 + jj * T) * 4, dv / T)
            jj = jj + 1
        t0 = t0 + 1
    # module
    pbuf = alloc_bytes(len(PTX) + 1)
    kk: "i32" = 0
    while kk < len(PTX):
        wh = write_u8(pbuf, kk, PTX[kk])
        kk = kk + 1
    wh = write_u8(pbuf, kk, 0)
    mc = alloc_bytes(8)
    rc = cu_module_load(mc, pbuf)
    if rc != 0:
        print("MOD FAIL", rc)
        return 1
    mod: "i64" = read_i64(mc, 0)
    nb2 = alloc_bytes(len(FN))
    kk = 0
    while kk < len(FN):
        wh = write_u8(nb2, kk, FN[kk])
        kk = kk + 1
    fc = alloc_bytes(8)
    rc = cu_module_fn(fc, mod, nb2)
    if rc != 0:
        print("FN FAIL", rc)
        return 1
    fn: "i64" = read_i64(fc, 0)
    # launch
    a0 = alloc_bytes(8)
    wh = write_i64(a0, 0, dx)
    a1 = alloc_bytes(8)
    wh = write_i64(a1, 0, dpk)
    a2 = alloc_bytes(8)
    wh = write_i64(a2, 0, dout)
    pl = alloc_bytes(24)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    print("LAUNCH")
    rc = cu_launch(fn, 1, 1, 1, T, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("LAUNCH FAIL", rc)
        return 1
    print("LAUNCH ok")
    ho = alloc_bytes(T * 4 + n * 4)
    wh = cuda_h2d(ho, dout, T * 4 + n * 4, 2)
    maxerr: "f32" = 0.0
    # lossRow
    t0 = 0
    while t0 < T:
        d: "f32" = read_f32(ho, t0 * 4) - read_f32(refl, t0 * 4)
        if d < 0.0:
            d = 0.0 - d
        if d > maxerr:
            maxerr = d
        t0 = t0 + 1
    # dL
    jj = 0
    while jj < n:
        d = read_f32(ho, T * 4 + jj * 4) - read_f32(refdl, jj * 4)
        if d < 0.0:
            d = 0.0 - d
        if d > maxerr:
            maxerr = d
        jj = jj + 1
    print("MAXERR", maxerr)
    print("LOSSROW0", read_f32(ho, 0))
    print("LOSSROW1", read_f32(ho, 4))
    print("KET LUAN OK")
    return 0
