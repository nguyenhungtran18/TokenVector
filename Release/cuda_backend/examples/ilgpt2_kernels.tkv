    c5 = alloc_bytes(4)
    wc5: "i64" = write_i32(c5, 0, T)
    c6 = alloc_bytes(4)
    wc6: "i64" = write_i32(c6, 0, H)
    c7 = alloc_bytes(4)
    wc7: "i64" = write_f32(c7, 0, invH)
    pc = alloc_bytes(64)
    wpc0: "i64" = write_i64(pc, 0, c0)
    wpc1: "i64" = write_i64(pc, 8, c1)
    wpc2: "i64" = write_i64(pc, 16, c2)
    wpc3: "i64" = write_i64(pc, 24, c3)
    wpc4: "i64" = write_i64(pc, 32, c4)
    wpc5: "i64" = write_i64(pc, 40, c5)
    wpc6: "i64" = write_i64(pc, 48, c6)
    wpc7: "i64" = write_i64(pc, 56, c7)
    rc = cu_launch(k_lnb, 1, 1, 1, 64, 1, 1, 0, 0, pc, 0)
    if rc != 0:
        print("LNB FAIL", rc)
        return 1
    # dump ket qua de Python so sanh
    hy = alloc_bytes(qb)
    d1: "i64" = cuda_h2d(hy, dY, qb, 2)
    i = 0
    while i < T:
        j = 0
        while j < H:
            v: "f32" = read_f32(hy, (i + j * T) * 4)
            print("LY", i, j, v)
            j = j + 1
        i = i + 1
    d2: "i64" = cuda_h2d(hy, dDX, qb, 2)
    i = 0
    while i < T:
        j = 0
        while j < H:
            v = read_f32(hy, (i + j * T) * 4)
            print("LDX", i, j, v)
            j = j + 1
        i = i + 1
    hp = alloc_bytes(sb)
    d3: "i64" = cuda_h2d(hp, dP, sb, 2)
    i = 0
    while i < T:
        j = 0
        while j < T:
            v = read_f32(hp, (i + j * T) * 4)
            print("SP", i, j, v)
            j = j + 1
        i = i + 1
    d4: "i64" = cuda_h2d(hp, dDS, sb, 2)
    i = 0
    while i < T:
        j = 0
        while j < T:
            v = read_f32(hp, (i + j * T) * 4)
            print("DS", i, j, v)
            j = j + 1
        i = i + 1
    print("BATCH DONE")
    return 0
