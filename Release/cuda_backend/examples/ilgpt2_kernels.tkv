;\nmul.f32 t,t,p;\nL2W:\nmul.wide.u32 off,idx,4;\nadd.u64 dsa,dsb,off;\nst.global.f32 [dsa],t;\nadd.u32 j,j,1;\nbra L2;\nLEND:\nret;\n}\n"
