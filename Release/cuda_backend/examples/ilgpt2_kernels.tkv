 pst, .param .u64 pdx, .param .u32 pT, .param .u32 pH, .param .f32 pinvH)\n{\n.reg .f32 xh,dy,g,rstd,mean,s1,s2,t,dx,invh;\n.reg .u64 xhb,dyb,gb,stb,dxb,off,offg,xa,da,ga,sta,dxa;\n.reg .u32 row,j,tn,hn,idx;\n.reg .pred q;\nld.param.u64 xhb,[pxh];\nld.param.u64 dyb,[pdy];\nld.param.u64 gb,[pg];\nld.param.u64 stb,[pst];\nld.param.u64 dxb,[pdx];\nld.param.u32 tn,[pT];\nld.param.u32 hn,[pH];\nld.param.f32 invh,[pinvH];\ncvta.to.global.u64 xhb,xhb;\ncvta.to.global.u64 dyb,dyb;\ncvta.to.global.u64 gb,gb;\ncvta.to.global.u64 stb,stb;\ncvta.to.global.u64 dxb,dxb;\nmov.u32 row,%tid.x;\nsetp.ge.u32 q,row,tn;\n@q bra LEND;\nmul.wide.u32 off,row,8;\nadd.u64 sta,stb,off;\nld.global.f32 mean,[sta];\nadd.u64 sta,sta,4;\nld.global.f32 rstd,[sta];\nmov.f32 s1,0.0;\nmov.f32 s2,0.0;\nmov.u32 j,0;\nL1:\nsetp.ge.u32 q,j,hn;\n@q bra L1D;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 da,dyb,off;\nld.global.f32 dy,[da];\nadd.u64 xa,xhb,off;\nld.global.f32 xh,[xa];\nmul.wide.u32 offg,j,4;\nadd.u64 ga,gb,offg;\nld.global.f32 g,[ga];\nmul.f32 t,dy,g;\nadd.f32 s1,s1,t;\nmul.f32 t,t,xh;\nadd.f32 s2,s2,t;\nadd.u32 j,j,1;\nbra L1;\nL1D:\nmul.f32 s1,s1,invh;\nmul.f32 s2,s2,invh;\nmov.u32 j,0;\nL2:\nsetp.ge.u32 q,j,hn;\n@q bra LEND;\nmul.lo.u32 idx,j,tn;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nadd.u64 da,dyb,off;\nld.global.f32 dy,[da];\nadd.u64 xa,xhb,off;\nld.global.f32 xh,[xa];\nmul.wide.u32 offg,j,4;\nadd.u64 ga,gb,offg;\nld.global.f32 g,[ga];\nmul.f32 t,dy,g;\nsub.f32 t,t,s1;\nmul.f32 dx,xh,s2;\nsub.f32 dx,t,dx;\nmul.f32 dx,dx,rstd;\nadd.u64 dxa,dxb,off;\nst.global.f32 [dxa],dx;\nadd.u32 j,j,1;\nbra L2;\nLEND:\nret;\n}\n.entry sf_kernel(.param .u64 ps, .param .u64 pp, .param .u32 pT, .param .f32 pone)\n{\n.reg .f32 x,mx,sum,e,p,one;\n.reg .u64 sb,pb,off,xa,pa;\n.reg .u32 row,j,tn,idx;\n.reg .pred q;\nld.param.u64 sb,[ps];\nld.param.u64 pb,[pp];\nld.param.u32 tn,[pT];\nld.param.f32 one,[pone];\ncvta.to.global.u64 sb,sb;\ncvta.to.global.u64 pb,pb;\nmov.u3