        return 1
    k_ad = read_i64(fc, 0)
    # slots
    pa0 = alloc_bytes(8)
    pa1 = alloc_bytes(8)
    pa2 = alloc_bytes(8)
    pa3 = alloc_bytes(8)
    pan = alloc_bytes(4)
    plr = alloc_bytes(4)
    pb1s = alloc_bytes(4)
    pb2s = alloc_bytes(4)
    peps = alloc_bytes(4)
    pwd = alloc_bytes(4)
    pbc1 = alloc_bytes(4)
    pbc2 = alloc_bytes(4)
    wr0: "i64" = write_f32(plr, 0, 0.01)
    wr1: "i64" = write_f32(pb1s, 0, 0.9)
    wr2: "i64" = write_f32(pb2s, 0, 0.999)
    wr3: "i64" = write_f32(peps, 0, 1e-08)
    wr4: "i64" = write_f32(pwd, 0, 0.01)
    par = alloc_bytes(96)
    wp0: "i64" = write_i64(par, 0, pa0)
    wp1: "i64" = write_i64(par, 8, pa1)
    wp2: "i64" = write_i64(par, 16, pa2)
    wp3: "i64" = write_i64(par, 24, pa3)
    wp4: "i64" = write_i64(par, 32, pan)
    wp5: "i64" = write_i64(par, 40, plr)
    wp6: "i64" = write_i64(par, 48, pb1s)
    wp7: "i64" = write_i64(par, 56, pb2s)
    wp8: "i64" = write_i64(par, 64, peps)
    wp9: "i64" = write_i64(par, 72, pwd)
    wp10: "i64" = write_i64(par, 80, pbc1)
    wp11: "i64" = write_i64(par, 88, pbc2)
    # forward kernel args (biasgelu: x,b,y)
    f0 = alloc_bytes(8)
    f1 = alloc_bytes(8)
    f2 = alloc_bytes(8)
    p3 = alloc_bytes(24)
    q0: "i64" = write_i64(p3, 0, f0)
    q1: "i64" = write_i64(p3, 8, f1)
    q2: "i64" = write_i64(p3, 16, f2)
    # dgelu args (x, dy, n)
    g2 = alloc_bytes(4)
    p4 = alloc_bytes(24)
    g0: "i64" = write_i64(p4, 0, f0)
    g1: "i64" = write_i64(p4, 8, f1)
    g3: "i64" = write_i64(p4, 16, g2)
    wg2: "i64" = write_i32(g2, 0, T * D)
    p1: "f32" = 0.9
    p2: "f32" = 0.999
    step: "i32" = 1
    nsteps: "i32" = 5
    while step <= nsteps:
        # 1) Z = X @ W1
        rc = cublas_sgemm(ch, 0, 0, T, D, D, ha, dX, T, dW1, D, hb, dZ, T)
        if rc != 0:
            print("GEMM1 FAIL", rc)
            return 1
        # 2) H = gelu(Z + b1)
        wf0: "i64" = write_i64(f0, 0, dZ)
        wf1: "i64" = write_i64(f1, 0, db1)
        wf2: "i64" = write_i64(f2, 0, dH)
        rc = cu_launch(k_bg, D, 1, 1, T, 1, 1, 0, 0, p3, 0)
        if rc != 0:
            print("BIASGELU FAIL", rc)
            return 1
        # 3) LG = H @ W2
        rc = cublas_sgemm(ch, 0, 0, T, V, D, ha, dH, T, dW2, D, hb, dLG, T)
        if rc != 0:
            print("GEMM2 FAIL", rc)
            return 1
        # 4) LG += b2
        wf0 = write_i64(f0, 0, dLG)
        wf1 = write_i64(f1, 0, db2)
        wf2 = write_i64(f2, 0, dLG)
        rc = cu_launch(k_ba, V, 1, 1, T, 1, 1, 0, 0, p3, 0)
        if rc != 0:
            print("BIASADD FAIL", rc)
            return 1
        # 5) loss + softmax + dL tren host
        rd: "i64" = cuda_h2d(hLG, dLG, tvb, 2)
        loss: "f32" = 0.0
        i = 0
        while i < T:
            mx: "f32" = -1000000000.0
            j = 0
            while j < V:
                lv: "f32" = read_f32(hLG, (i + j * T) * 4)
                if lv > mx:
                    mx = lv
                j = j + 1
            zsum: "f32" = 0.0
            j = 0
            while j < V:
                lv = read_f32(hLG, (i + j * T) * 4)
                ev: "f32" = exp(lv - mx)
                zsum = zsum + ev
                j = j + 1
            j = 0
            while j < V:
                lv = read_f32(hLG, (i + j * T) * 4)
                ev = exp(lv - mx)
                wp: "i64" = write_f32(hP, (i + j * T) * 4, ev / zsum)
                j = j + 1
            idv2: "i32" = read_i32(hIds, i * 4)
            pv3: "f32" = read_f32(hP, (i + idv2 * T) * 4)
            loss = loss - log(pv3)
            j = 0
            while j < V:
                pv4: "f32" = read_f32(hP, (i + j * T) * 4)
                dv: "f32" = pv4
                if j == idv2:
                    dv = dv - 1.0
                dv = dv / 4.0
                wdl: "i64" = write_f32(hDL, (i + j * T) * 4, dv)
                j = j + 1
            i = i + 1
        loss = loss / 4.0
        print("LOSS", loss)
        wdl2: "i64" = cuda_h2d(dDL, hDL, tvb, 1)
        # 6) dW2 = dH^T @ dL
        rc = cublas_sgemm(ch, 1, 0, D, V, T, ha, dH, T, dDL, T, hb, dDW2, D)
        if rc != 0:
            print("GEM_DW2 FAIL", rc)
            return 1
        # 7) db2 = ones^T @ dL
        rc = cublas_sgemm(ch, 1, 0, 1, V, T, ha, dOnes, T, dDL, T, hb, dDB2, 1)
        if rc != 0:
            print("GEM_DB2 FAIL", rc)
            return 1
        # 8) dH = dL @ W2^T
        rc = cublas_sgemm(ch, 0, 1, T, D, V, ha, dDL, T, dW2, D, hb, dDH, T)
        if rc != 0:
            print("GEM_DH FAIL", rc)
            return 1
        # 9) dZ = dgelu(Z, dH)
        cp: "i64" = cuda_h2d(dDZ, dDH, tdb, 3)
        wg0: "i64" = write_i64(f0, 0, dZ)
        wg3: "i64" = write_i64(f1, 0, dDZ)
        rc = cu_launch(k_dg, 1, 1, 1, 64, 1, 1, 0, 0, p4, 0)
        if rc != 0:
            print("DGELU FAIL", rc)
            return 1
        # 10) dW1 = dX^T @ dZ
        rc = cublas_sgemm(ch, 1, 0, D, D, T, ha, dX, T, dDZ, T, hb, dDW1, D)
        if rc != 0:
            print("GEM_DW1 FAIL", rc)
            return 1
        # 11) db1 = ones^T @ dZ
        rc = cublas_sgemm(ch, 1, 0, 1, D, T, ha, dOnes, T, dDZ, T, hb, dDB1, 1)
        if rc != 0:
            print("GEM_DB1 FAIL", rc)
            return 1
        # 12) AdamW
        bc1v: "f32" = 1.0 - p1
        bc2v: "f32" = 1.0 - p2
        wbc1: "i64" = write_f32(pbc1, 0, bc1v)
        wbc2: "i64" = write_f32(pbc2, 0, bc2v)
        wa_0: "i64" = write_i64(pa0, 0, dW1)
        wa_1: "i64" = write_i64(pa1, 0, dM1)
        wa_2: "i64" = write_i64(pa2, 0, dV1)
        wa_3: "i64" = write_i64(pa3, 0, dDW1)
        wa_n: "i64" = write_i32(pan, 0, D * D)
        rc = cu_launch(k_ad, 1, 1, 1, 128, 1, 1, 0, 0, par, 0)
        if rc != 0:
            print("ADAMW W1 FAIL", rc)
            return 1
        wa_0 = write_i64(pa0, 0, dW2)
        wa_1 = write_i64(pa1, 0, dM2)
        wa_2 = write_i64(pa2, 0, dV2)
        wa_3 = write_i64(pa3, 0, dDW2)
        wa_n = write_i32(pan, 0, D * V)
        rc = cu_launch(k_ad, 1, 1, 1, 128, 1, 1, 0, 0, par, 0)
        if rc != 0:
            print("ADAMW W2 FAIL", rc)
            return 1
        wa_0 = write_i64(pa0, 0, db1)
        wa_1 = write_i64(pa1, 0, dMB1)
        wa_2 = write_i64(pa2, 0, dVB1)
        wa_3 = write_i64(pa3, 0, dDB1)
        wa_n = write_i32(pan, 0, D)
        rc = cu_launch(k_ad, 1, 1, 1, 128, 1, 1, 0, 0, par, 0)
        if rc != 0:
            print("ADAMW B1 FAIL", rc)
            return 1
        wa_0 = write_i64(pa0, 0, db2)
        wa_1 = write_i64(pa1, 0, dMB2)
        wa_2 = write_i64(pa2, 0, dVB2)
        wa_3 = write_i64(pa3, 0, dDB2)
        wa_n = write_i32(pan, 0, V)
        rc = cu_launch(k_ad, 1, 1, 1, 128, 1, 1, 0, 0, par, 0)
        if rc != 0:
            print("ADAMW B2 FAIL", rc)
            return 1
        p1 = p1 * 0.9
        p2 = p2 * 0.999
        # chan doan: thong ke |gradient| tren host (min, max, so phan tu < 1e-7)
        rg1: "i64" = cuda_h2d(hTmp, dDW1, w1b, 2)
        i = 0
        gmn: "f32" = 1000000000.0
        gmx: "f32" = 0.0
        ntiny: "i32" = 0
        while i < D * D:
            gv: "f32" = read_f32(hTmp, i * 4)
            print("DW1", step, i, gv)
            ga: "f32" = gv
            if ga < 0.0:
                ga = 0.0 - ga
            if ga < gmn:
                gmn = ga
            if ga > gmx:
                gmx = ga
            if ga < 1e-07:
                ntiny = ntiny + 1
            i = i + 1
        print("G1", step, gmn, gmx, ntiny)
        rg2: "i64" = cuda_h2d(hTmp, dDW2, w2b, 2)
        i = 0
        gmn2: "f32" = 1000000000.0
        gmx2: "f32" = 0.0
        ntiny2: "i32" = 0
        while i < D * V:
            gv2: "f32" = read_f32(hTmp, i * 4)
            print("DW2", step, i, gv2)
            ga2: "f32" = gv2
            if ga2 < 0.0:
                ga2 = 0.0 - ga2
            if ga2 < gmn2:
                gmn2 = ga2
            if ga2 > gmx2:
                gmx2 = ga2
            if ga2 < 1e-07:
                ntiny2 = ntiny2 + 1
            i = i + 1
        print("G2", step, gmn2, gmx2, ntiny2)
        # gradient cua bias (in ra de so truc tiep voi reference)
        rg3: "i64" = cuda_h2d(hTmp, dDB1, b1b, 2)
        i = 0
        while i < D:
            bg: "f32" = read_f32(hTmp, i * 4)
            print("DB1", step, i, bg)
            i = i + 1
        rg4: "i64" = cuda_h2d(hTmp, dDB2, b2b, 2)
        i = 0
        while i < V:
            bg2: "f32" = read_f32(hTmp, i * 4)
            print("DB2", step, i, bg2)
            i = i + 1
        # in tham so sau cap nhat o MOI step (doi chieu reference theo tung step)
        rw1: "i64" = cuda_h2d(hTmp, dW1, w1b, 2)
        i = 0
        while i < D * D:
            wv: "f32" = read_f32(hTmp, i * 4)
            print("W1NEW", step, i, wv)
            i = i + 1
        rw2: "i64" = cuda_h2d(hTmp, dW2, w2b, 2)
        i = 0
        while i < D * V:
            wv2: "f32" = read_f32(hTmp, i * 4)
            print("W2NEW", step, i, wv2)
            i = i + 1
        rb1: "i64" = cuda_h2d(hTmp, db1, b1b, 2)
        i = 0
        while i < D:
            bv: "f32" = read_f32(hTmp, i * 4)
            print("B1NEW", step, i, bv)
            i = i + 1
        rb2: "i64" = cuda_h2d(hTmp, db2, b2b, 2)
        i = 0
        while i < V:
            bv2: "f32" = read_f32(hTmp, i * 4)
            print("B2NEW", step, i, bv2)
            i = i + 1
        step = step + 1
    print("BATCH DONE")
    return 0
