    PTX = b".version 8.0\n.target sm_75\n.address_size 64\n.entry biasgelu_kernel(.param .u64 px, .param .u64 pb, .param .u64 py)\n{\n.reg .f32 f1,f2,f3,f4,f5,fb;\n.reg .u64 xp,bp,yp,off,offb;\n.reg .u32 col,row,idx,nt;\n.reg .pred q;\nld.param.u64 xp,[px];\nld.param.u64 bp,[pb];\nld.param.u64 yp,[py];\nmov.u32 col,%ctaid.x;\nmov.u32 row,%tid.x;\nmov.u32 nt,%ntid.x;\nsetp.ge.u32 q,row,nt;\n@q bra LEND;\nmul.lo.u32 idx,col,nt;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nmul.wide.u32 offb,col,4;\ncvta.to.global.u64 xp,xp;\ncvta.to.global.u64 bp,bp;\ncvta.to.global.u64 yp,yp;\nadd.u64 xp,xp,off;\nadd.u64 yp,yp,off;\nadd.u64 bp,bp,offb;\nld.global.f32 f1,[xp];\nld.global.f32 fb,[bp];\nadd.f32 f1,f1,fb;\nmul.f32 f3,f1,f1;\nmul.f32 f3,f3,f1;\nmov.f32 f4,0.044715;\nfma.rn.f32 f3,f3,f4,f1;\nmov.f32 f4,0.79788456;\nmul.f32 f2,f3,f4;\ntanh.approx.f32 f2,f2;\nmov.f32 f3,1.0;\nadd.f32 f2,f2,f3;\nmov.f32 f3,0.5;\nmul.f32 f2,f2,f3;\nmul.f32 f5,f1,f2;\nst.global.f32 [yp],f5;\nLEND: ret;\n}\n.entry biasadd_kernel(.param .u64 px, .param .u64 pb, .param .u64 py)\n{\n.reg .f32 f1,fb,f3;\n.reg .u64 xp,bp,yp,off,offb;\n.reg .u32 col,row,idx,nt;\n.reg .pred q;\nld.param.u64 xp,[px];\nld.param.u64 bp,[pb];\nld.param.u64 yp,[py];\nmov.u32 col,%ctaid.x;\nmov.u32 row,%tid.x;\nmov.u32 nt,%ntid.x;\nsetp.ge.u32 q,row,nt;\n@q bra LEND;\nmul.lo.u32 idx,col,nt;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nmul.wide.u32 offb,col,4;\ncvta.to.global.u64 xp,xp;\ncvta.to.global.u64 bp,bp;\ncvta.to.global.u64 yp,yp;\nadd.u64 xp,xp,off;\nadd.u64 yp,yp,off;\nadd.u64 bp,bp,offb;\nld.global.f32 f1,[xp];\nld.global.f32 fb,[bp];\nadd.f32 f3,f1,fb;\nst.global.f32 [yp],f3;\nLEND: ret;\n}\n.entry dgelu_kernel(.param .u64 px, .param .u64 pd, .param .u32 pn)\n{\n.reg .f32 x,z,th,a,b,t1,t2,t3,c,g,d,xx;\n.reg .u64 xb,db,off;\n.reg .u32 i,n;\n.reg .pred q;\nld.param.u64 xb,[px];\nld.param.u64 db,[pd];\nld.param.u32 n,[pn];\nmov.u32 i,%tid.x;\nsetp.ge.u32 q,i,n;\n@q bra LEND;\nmul.wide.u32 off,i,4;\ncvta.to.global.u64 xb,xb;\ncvta.to.global.u64 db,db;\nadd.u64 xb,xb,off;\nadd.u64 db,db,off;\nld.global.f32 x,[xb];\nld.global.f32 d,[db];\nmul.f32 xx,x,x;\nmov.f32 t2,0.134145;\nfma.rn.f32 t2,xx,t2,1.0;\nmul.f32 t3,x,xx;\nmov.f32 z,0.79788456;\nmul.f32 z,z,x;\nmov.f32 c,0.0356774;\nfma.rn.f32 z,c,t3,z;\ntanh.approx.f32 th,z;\nmov.f32 a,1.0;\nadd.f32 a,a,th;\nmov.f32 c,0.5;\nmul.f32 a,a,c;\nmov.f32 b,1.0;\nmul.f32 t1,th,th;\nsub.f32 b,b,t1;\nmul.f32 b,b,x;\nmov.f32 c,0.79788456;\nmul.f32 b,b,c;\nmul.f32 b,b,0.5;\nmov.f32 t2,0.134145;\nfma.rn.f32 t2,xx,t2,1.0;\nmul.f32 b,b,t2;\nadd.f32 g,a,b;\nmul.f32 d,d,g;\nst.global.f32 [db],d;\nLEND: ret;\n}\n.entry adamw_kernel(.param .u64 pp, .param .u64 pm, .param .u64 pv, .param .u64 pg, .param .u32 pn, .param .f32 plr, .param .f32 pb1, .param .f32 pb2, .param .f32 peps, .param .f32 pwd, .param .f32 pbc1, .param .f32 pbc2)\n{\n.reg .f32 p,m,v,g,lr,b1,b2,eps,wd,bc1,bc2,t1,t2,t3,t4,t5,t6;\n.reg .u64 pb_,pm_,pv_,pg_,off;\n.reg .u32 i,n;\n.reg .pred q;\nld.param.u64 pb_,[pp];\nld.param.u64 pm_,[pm];\nld.param.u64 pv_,[pv];\nld.param.u64 pg_,[pg];\nld.param.u32 n,[pn];\nld.param.f32 lr,[plr];\nld.param.f32 b1,[pb1];\nld.param.f32 b2,[pb2];\nld.param.f32 eps,[peps];\nld.param.f32 wd,[pwd];\nld.param.f32 bc1,[pbc1];\nld.param.f32 bc2,[pbc2];\nmov.u32 i,%tid.x;\nsetp.ge.u32 q,i,n;\n@q bra LEND;\nmul.wide.u32 off,i,4;\ncvta.to.global.u64 pb_,pb_;\ncvta.to.global.u64 pm_,pm_;\ncvta.to.global.u64 pv_,pv_;\ncvta.to.global.u64 pg_,pg_;\nadd.u64 pb_,pb_,off;\nadd.u64 pm_,pm_,off;\nadd.u64 pv_,pv_,off;\nadd.u64 pg_,pg_,off;\nld.global.f32 p,[pb_];\nld.global.f32 m,[pm_];\nld.global.f32 v,[pv_];\nld.global.f32 g,[pg_];\nmov.f32 t1,1.0;\nsub.f32 t1,t1,b1;\nmul.f32 t2,t1,g;\nfma.rn.f32 m,m,b1,t2;\nmov.f32 t1,1.0;\nsub.f32 t1,t1,b2;\nmul.f32 t2,g,g;\nmul.f32 t2,t1,t2;\nfma.rn.f32 v,v,b2,t2;\nst.global.f32 [pm_],m;\nst.global.f32 [pv_],v;\ndiv.rn.f32 t3,m,bc1;\ndiv.rn.f32 t4,v,bc2;\nsqrt.rn.f32 t5,t4;\nadd.f32 t5,t5,eps;\ndiv.rn.f32 t6,t3,t5;\nmul.f32 t6,lr,t6;\nmul.f32 t5,lr,wd;\nmul.f32 t5,t5,p;\nsub.f32 p,p,t6;\nsub.f32 p,p,t5;\nst.global.f32 [pb_],p;\nLEND: ret;\n}\n"
    FN1 = b"biasgelu_kernel\x00"
