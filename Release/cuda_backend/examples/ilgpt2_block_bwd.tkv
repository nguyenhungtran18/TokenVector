    hd1: "i64" = cuda_h2d(dWq, hWq, hb * H, 1)
    hd2: "i64" = cuda_h2d(dWk, hWk, hb * H, 1)
    hd3: "i64" = cuda_h2d(dWv, hWv, hb * H, 1)
    hd4: "i64" = cuda_h2d(dWo, hWo, hb * H, 1)
    hd5: "i64" = cuda_h2d(dW1, hW1, h4 * H, 1)
