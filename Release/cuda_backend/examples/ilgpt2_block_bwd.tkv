    mc = alloc_bytes(8)
    rc = cu_module_load(mc, pbuf)
    if rc != 0:
        print("MODULE FAIL", rc)
        return 1
    mod: "i64" = read_i64(mc, 0)
    nb = alloc_bytes(32)
    r1: "i32" = 0
    while r1 < len(FN1):
        w1: "i64" = write_u8(nb, r1, FN1[r1])
        r1 = r1 + 1
    fc = alloc_bytes(8)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("FN LNF FAIL", rc)
        return 1
    k_lnf: "i64" = read_i64(fc, 0)
    r1 = 0
    while r1 < len(FN2):
        w2: "i64" = write_u8(nb, r1, FN2[r1])
        r1 = r1 + 1
    wz1: "i64" = write_u8(nb, r1, 0)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("FN SF FAIL", rc)
        return 1
    k_sf: "i64" = read_i64(fc, 0)
    r1 = 0
    while r1 < len(FN3):
        w3: "i64" = write_u8(nb, r1, FN3[r1])
        r1 = r1 + 1
    wz2: "i64" = write_u8(nb, r1, 0)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("FN ADD FAIL", rc)
        return 1
    k_add: "i64" = read_i64(fc, 0)
    r1 = 0
    while r1 < len(FN4):
        w4: "i64" = write_u8(nb, r1, FN4[r1])
        r1 = r1 + 1
    wz3: "i64" = write_u8(nb, r1, 0)
    rc = cu_module_fn(fc, mod, nb)
    if rc != 0:
        print("FN GELU FAIL", rc)
        return 1
    k_gelu: "i64" = read_i64(fc, 0)
    # scalar buffers
    ha = alloc_bytes(4)
    wa: "i64" = write_f32(ha, 0, one)
    hb0 = alloc_bytes(4)
    wb: "i64" = write_f32(hb0, 0, zero)
    hal = alloc_bytes(4)
    wl: "i64" = write_f32(hal, 0, alpha)
    # 1) LN1
    a0 = alloc_bytes(8)
    qp0: "i64" = write_i64(a0, 0, dX)
    a1 = alloc_bytes(8)
    qp1: "i64" = write_i64(a1, 0, dG1)
    a2 = alloc_bytes(8)
    qp2: "i64" = write_i64(a2, 0, dB1)
    a3 = alloc_bytes(8)
    qp3: "i64" = write_i64(a3, 0, dY1)
    a4 = alloc_bytes(8)
    qp4: "i64" = write_i64(a4, 0, dXH1)
    a5 = alloc_bytes(8)
    qp5: "i64" = write_i64(a5, 0, dST1)
    a6 = alloc_bytes(4)
    qp6: "i64" = write_i32(a6, 0, T)
    a7 = alloc_bytes(4)
    qp7: "i64" = write_i32(a7, 0, H)
    a8 = alloc_bytes(4)
    qp8: "i64" = write_f32(a8, 0, invH)
    a9 = alloc_bytes(4)
    qp9: "i64" = write_f32(a9, 0, eps)
    pl = alloc_bytes(80)
    wzp0: "i64" = write_i64(pl, 0, a0)
    wzp1: "i64" = write_i64(pl, 8, a1)
    wzp2: "i64" = write_i64(pl, 16, a2)
    wzp3: "i64" = write_i64(pl, 24, a3)
    wzp4: "i64" = write_i64(pl, 32, a4)
    wzp5: "i64" = write_i64(pl, 40, a5)
    wzp6: "i64" = write_i64(pl, 48, a6)
    wzp7: "i64" = write_i64(pl, 56, a7)
    wzp8: "i64" = write_i64(pl, 64, a8)
    wzp9: "i64" = write_i64(pl, 72, a9)
    rc = cu_launch(k_lnf, 1, 1, 1, 64, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("LNF FAIL", rc)
        return 1
    # 2) Q,K,V
    rc = cublas_sgemm(ch, 0, 0, T, H, H, ha, dY1, T, dWq, H, hb0, dQ, T)
    if rc != 0:
        print("Q FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 0, 0, T, H, H, ha, dY1, T, dWk, H, hb0, dK, T)
    if rc != 0:
        print("K FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 0, 0, T, H, H, ha, dY1, T, dWv, H, hb0, dV, T)
    if rc != 0:
        print("V FAIL", rc)
        return 1
    # 3) S = Q K^T / sqrt(H)
    rc = cublas_sgemm(ch, 0, 1, T, T, H, hal, dQ, T, dK, T, hb0, dS, T)
    if rc != 0:
        print("S FAIL", rc)
        return 1
    # 4) causal softmax P
    s0 = alloc_bytes(8)
    ws0: "i64" = write_i64(s0, 0, dS)
    s1 = alloc_bytes(8)
    ws1: "i64" = write_i64(s1, 0, dP)
    s2 = alloc_bytes(4)
    ws2: "i64" = write_i32(s2, 0, T)
    s3 = alloc_bytes(4)
    ws3: "i64" = write_f32(s3, 0, one)
    ps = alloc_bytes(32)
    wp0: "i64" = write_i64(ps, 0, s0)
    wp1: "i64" = write_i64(ps, 8, s1)
    wp2: "i64" = write_i64(ps, 16, s2)
    wp3: "i64" = write_i64(ps, 24, s3)
    rc = cu_launch(k_sf, 1, 1, 1, 64, 1, 1, 0, 0, ps, 0)
    if rc != 0:
        print("SF FAIL", rc)
        return 1
    # 5) A = P V
    rc = cublas_sgemm(ch, 0, 0, T, H, T, ha, dP, T, dV, T, hb0, dA, T)
    if rc != 0:
        print("A FAIL", rc)
        return 1
    # 6) O = A Wo
    rc = cublas_sgemm(ch, 0, 0, T, H, H, ha, dA, T, dWo, H, hb0, dO, T)
    if rc != 0:
        print("O FAIL", rc)
        return 1
    # 7) X2 = X + O
    c0 = alloc_bytes(8)
    wc0: "i64" = write_i64(c0, 0, dX)
    c1 = alloc_bytes(8)
    wc1: "i64" = write_i64(c1, 0, dO)
    c2 = alloc_bytes(8)
    wc2: "i64" = write_i64(c2, 0, dX2)
    c3 = alloc_bytes(4)
    wc3: "i64" = write_i32(c3, 0, T * H)
    pa = alloc_bytes(32)
    wpa0: "i64" = write_i64(pa, 0, c0)
    wpa1: "i64" = write_i64(pa, 8, c1)
    wpa2: "i64" = write_i64(pa, 16, c2)
    wpa3: "i64" = write_i64(pa, 24, c3)
    rc = cu_launch(k_add, 1, 1, 1, 64, 1, 1, 0, 0, pa, 0)
    if rc != 0:
        print("ADD1 FAIL", rc)
        return 1
    print("MARK 7 attn+res")
    # 8) LN2 - tam thoi tren host (device kernel se thay lai sau)
    hr2 = alloc_bytes(qb)
    chk2: "i64" = cuda_h2d(hr2, dX2, qb, 2)
    hY2 = alloc_bytes(qb)
    hXH2 = alloc_bytes(qb)
    hST2 = alloc_bytes(stb)
    ii: "i32" = 0
    while ii < T:
        su: "f32" = 0.0
        sq: "f32" = 0.0
        jj: "i32" = 0
        while jj < H:
            xv: "f32" = read_f32(hr2, (ii + jj * T) * 4)
            su = su + xv
            sq = sq + xv * xv
            jj = jj + 1
        mn: "f32" = su / H
        vr: "f32" = sq / H - mn * mn
        vr = vr + eps
        rs: "f32" = 1.0 / sqrt(vr)
        wq0: "i64" = write_f32(hST2, ii * 8, mn)
        wq1: "i64" = write_f32(hST2, ii * 8 + 4, rs)
        jj = 0
        while jj < H:
            xv = read_f32(hr2, (ii + jj * T) * 4)
            xhv: "f32" = (xv - mn) * rs
            gv: "f32" = read_f32(hG2, jj * 4)
            bv: "f32" = read_f32(hB2, jj * 4)
            wq2: "i64" = write_f32(hXH2, (ii + jj * T) * 4, xhv)
            wq3: "i64" = write_f32(hY2, (ii + jj * T) * 4, xhv * gv + bv)
            jj = jj + 1
        ii = ii + 1
    up0: "i64" = cuda_h2d(dY2, hY2, qb, 1)
    up1: "i64" = cuda_h2d(dXH2, hXH2, qb, 1)
    up2: "i64" = cuda_h2d(dST2, hST2, stb, 1)
    print("MARK 7a lnf2 host")
    # 9) Z = Y2 W1
    rc = cublas_sgemm(ch, 0, 0, T, F, H, ha, dY2, T, dW1, H, hb0, dZ, T)
    if rc != 0:
        print("Z FAIL", rc)
        return 1
    print("MARK 7b z gemm")
    # 10) gelu
    g0 = alloc_bytes(8)
    wg0: "i64" = write_i64(g0, 0, dZ)
    g1 = alloc_bytes(8)
    wg1: "i64" = write_i64(g1, 0, dHH)
    g2 = alloc_bytes(4)
    wg2: "i64" = write_i32(g2, 0, T * F)
    pg = alloc_bytes(24)
    wpg0: "i64" = write_i64(pg, 0, g0)
    wpg1: "i64" = write_i64(pg, 8, g1)
    wpg2: "i64" = write_i64(pg, 16, g2)
    rc = cu_launch(k_gelu, 1, 1, 1, 128, 1, 1, 0, 0, pg, 0)
    if rc != 0:
        print("GELU FAIL", rc)
        return 1
    print("MARK 8 mlp")
    # 11) O2 = HH W2
    rc = cublas_sgemm(ch, 0, 0, T, H, F, ha, dHH, T, dW2, F, hb0, dO2, T)
    if rc != 0:
        print("O2 FAIL", rc)
        return 1
    print("MARK 8a o2 gemm")
    # 12) OUT = X2 + O2  (doi ca c0 tu dX sang dX2)
    wzp0 = write_i64(c0, 0, dX2)
    wzp0 = write_i64(c1, 0, dO2)
    wzp0 = write_i64(c2, 0, dOUT)
    rc = cu_launch(k_add, 1, 1, 1, 64, 1, 1, 0, 0, pa, 0)
    if rc != 0:
        print("ADD2 FAIL", rc)
        return 1
    print("MARK 9 done")
    # ==================== BACKWARD ====================
    rc = cuda_malloc(cell, qb)
    dW2g = read_i64(cell, 0)
    rc = cuda_malloc(cell, fb)
    dHHg = read_i64(cell, 0)
    rc = cuda_malloc(cell, fb)
    dZg = read_i64(cell, 0)
    rc = cuda_malloc(cell, h4 * H)
    dW1g = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dY2g = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dDX2L = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dDX2T = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dAg = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb * H)
    dWog = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    dPg = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dVg = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    dSg = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dQg = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dKg = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb * H)
    dWqg = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb * H)
    dWkg = read_i64(cell, 0)
    rc = cuda_malloc(cell, hb * H)
    dWvg = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dYq = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dYk = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dYv = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dY1g = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dDX = read_i64(cell, 0)
    # B1: dW2, dHH
    rc = cublas_sgemm(ch, 1, 0, F, H, T, ha, dHH, T, dDOUT, T, hb0, dW2g, F)
    if rc != 0:
        print("BW dW2 FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 0, 1, T, F, H, ha, dDOUT, T, dW2, F, hb0, dHHg, T)
    if rc != 0:
        print("BW dHH FAIL", rc)
        return 1
    # B2: dZ = dHH * dgelu(Z) (tren host, se thay bang PTX)
    hZb = alloc_bytes(fb)
    hHb = alloc_bytes(fb)
    hZg = alloc_bytes(fb)
    bk0: "i64" = cuda_h2d(hZb, dZ, fb, 2)
    bk1: "i64" = cuda_h2d(hHb, dHHg, fb, 2)
    kk: "i32" = 0
    while kk < T * F:
        xv: "f32" = read_f32(hZb, kk * 4)
        zz: "f32" = 0.79788456 * (xv + 0.044715 * xv * xv * xv)
        e2: "f32" = exp(2.0 * zz)
        thv: "f32" = (e2 - 1.0) / (e2 + 1.0)
        gv: "f32" = 0.5 * (1.0 + thv) + 0.5 * xv * (1.0 - thv * thv) * 0.79788456 * (1.0 + 0.134145 * xv * xv)
        dvv: "f32" = read_f32(hHb, kk * 4) * gv
        wk: "i64" = write_f32(hZg, kk * 4, dvv)
        kk = kk + 1
    bk2: "i64" = cuda_h2d(dZg, hZg, fb, 1)
    # B3: dW1, dY2
    rc = cublas_sgemm(ch, 1, 0, H, F, T, ha, dY2, T, dZg, T, hb0, dW1g, H)
    if rc != 0:
        print("BW dW1 FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 0, 1, T, H, F, ha, dZg, T, dW1, H, hb0, dY2g, T)
    if rc != 0:
        print("BW dY2 FAIL", rc)
        return 1
    # B4: LN2 backward (host), dX2 = dOUT + dx_ln
    hY2g = alloc_bytes(qb)
    hDX2L = alloc_bytes(qb)
    hDG2 = alloc_bytes(hb)
    hDB2 = alloc_bytes(hb)
    kk = 0
    while kk < H:
        wz: "i64" = write_f32(hDG2, kk * 4, 0.0)
        wz = write_f32(hDB2, kk * 4, 0.0)
        kk = kk + 1
    bk3: "i64" = cuda_h2d(hY2g, dY2g, qb, 2)
    ii = 0
    while ii < T:
        mnv: "f32" = read_f32(hST2, ii * 8)
        rsv: "f32" = read_f32(hST2, ii * 8 + 4)
        acc1: "f32" = 0.0
        acc2: "f32" = 0.0
        jj = 0
        while jj < H:
            dvv = read_f32(hY2g, (ii + jj * T) * 4)
            gvv: "f32" = read_f32(hG2, jj * 4)
            xhv: "f32" = read_f32(hXH2, (ii + jj * T) * 4)
            acc1 = acc1 + dvv * gvv
            acc2 = acc2 + dvv * gvv * xhv
            jj = jj + 1
        jj = 0
        while jj < H:
            dvv = read_f32(hY2g, (ii + jj * T) * 4)
            gvv = read_f32(hG2, jj * 4)
            xhv = read_f32(hXH2, (ii + jj * T) * 4)
            dxv: "f32" = (dvv * gvv - acc1 / H - xhv * acc2 / H) * rsv
            wz = write_f32(hDX2L, (ii + jj * T) * 4, dxv)
            gtmp: "f32" = read_f32(hDG2, jj * 4) + dvv * xhv
            wz = write_f32(hDG2, jj * 4, gtmp)
            btmp: "f32" = read_f32(hDB2, jj * 4) + dvv
            wz = write_f32(hDB2, jj * 4, btmp)
            jj = jj + 1
        ii = ii + 1
    bk4: "i64" = cuda_h2d(dDX2L, hDX2L, qb, 1)
    wzp0 = write_i64(c0, 0, dDOUT)
    wzp0 = write_i64(c1, 0, dDX2L)
    wzp0 = write_i64(c2, 0, dDX2T)
    rc = cu_launch(k_add, 1, 1, 1, 64, 1, 1, 0, 0, pa, 0)
    if rc != 0:
        print("BW ADD LN2 FAIL", rc)
        return 1
    # B5: attention backward
    rc = cublas_sgemm(ch, 0, 1, T, H, H, ha, dDX2T, T, dWo, H, hb0, dAg, T)
    if rc != 0:
        print("BW dA FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 1, 0, H, H, T, ha, dA, T, dDX2T, T, hb0, dWog, H)
    if rc != 0:
        print("BW dWo FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 0, 1, T, T, H, ha, dAg, T, dV, T, hb0, dPg, T)
    if rc != 0:
        print("BW dP FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 1, 0, H, T, T, ha, dP, T, dAg, T, hb0, dVg, H)
    if rc != 0:
        print("BW dV FAIL", rc)
        return 1
    # dS = P*(dP - rowsum(P*dP))
    hPb = alloc_bytes(sb)
    hDPb = alloc_bytes(sb)
    hDSb = alloc_bytes(sb)
    bk5: "i64" = cuda_h2d(hPb, dP, sb, 2)
    bk6: "i64" = cuda_h2d(hDPb, dPg, sb, 2)
    ii = 0
    while ii < T:
        rst: "f32" = 0.0
        jj = 0
        while jj < T:
            ppv: "f32" = read_f32(hPb, (ii + jj * T) * 4)
            ddv: "f32" = read_f32(hDPb, (ii + jj * T) * 4)
            rst = rst + ppv * ddv
            jj = jj + 1
        jj = 0
        while jj < T:
            ppv = read_f32(hPb, (ii + jj * T) * 4)
            ddv = read_f32(hDPb, (ii + jj * T) * 4)
            wz = write_f32(hDSb, (ii + jj * T) * 4, ppv * (ddv - rst))
            jj = jj + 1
        ii = ii + 1
    bk7: "i64" = cuda_h2d(dSg, hDSb, sb, 1)
    rc = cublas_sgemm(ch, 0, 0, T, H, T, hal, dSg, T, dK, T, hb0, dQg, T)
    if rc != 0:
        print("BW dQ FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 1, 0, H, H, T, hal, dSg, T, dQ, T, hb0, dKg, T)
    if rc != 0:
        print("BW dK FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 1, 0, H, H, T, ha, dY1, T, dQg, T, hb0, dWqg, H)
    if rc != 0:
        print("BW dWq FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 1, 0, H, H, T, ha, dY1, T, dKg, T, hb0, dWkg, H)
    if rc != 0:
        print("BW dWk FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 1, 0, H, H, T, ha, dY1, T, dVg, T, hb0, dWvg, H)
    if rc != 0:
        print("BW dWv FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 0, 1, T, H, H, ha, dQg, T, dWq, H, hb0, dYq, T)
    if rc != 0:
        print("BW dYq FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 0, 1, T, H, H, ha, dKg, T, dWk, H, hb0, dYk, T)
    if rc != 0:
        print("BW dYk FAIL", rc)
        return 1
    rc = cublas_sgemm(ch, 0, 1, T, H, H, ha, dVg, T, dWv, H, hb0, dYv, T)
    if rc != 0:
        print("BW dYv FAIL", rc)
        return 1
    wzp0 = write_i64(c0, 0, dYq)
    wzp0 = write_i64(c1, 0, dYk)
    wzp0 = write_i64(c2, 0, dY1g)
    rc = cu_launch(k_add, 1, 1, 1, 64, 1, 1, 0, 0, pa, 0)
    if rc != 0:
        print("BW ADD1 FAIL", rc)
        return 1
    wzp0 = write_i64(c1, 0, dYv)
    rc = cu_launch(k_add, 1, 1, 1, 64, 1, 1, 0, 0, pa, 0)
    if rc != 0:
        print("BW ADD2 FAIL", rc)
        return 1
    # B6: LN1 backward (host)
    hY1g = alloc_bytes(qb)
    hXH1b = alloc_bytes(qb)
    hST1b = alloc_bytes(stb)
    hDXb = alloc_bytes(qb)
    hDG1 = alloc_bytes(hb)
    hDB1 = alloc_bytes(hb)
    kk = 0
    while kk < H:
        wz = write_f32(hDG1, kk * 4, 0.0)
        wz = write_f32(hDB1, kk * 4, 0.0)
        kk = kk + 1
    bk8: "i64" = cuda_h2d(hY1g, dY1g, qb, 2)
    bk9: "i64" = cuda_h2d(hXH1b, dXH1, qb, 2)
    bk10: "i64" = cuda_h2d(hST1b, dST1, stb, 2)
    ii = 0
    while ii < T:
        mnv = read_f32(hST1b, ii * 8)
        rsv = read_f32(hST1b, ii * 8 + 4)
        acc1 = 0.0
        acc2 = 0.0
        jj = 0
        while jj < H:
            dvv = read_f32(hY1g, (ii + jj * T) * 4)
            gvv = read_f32(hG1, jj * 4)
            xhv = read_f32(hXH1b, (ii + jj * T) * 4)
            acc1 = acc1 + dvv * gvv
            acc2 = acc2 + dvv * gvv * xhv
            jj = jj + 1
        jj = 0
        while jj < H:
            dvv = read_f32(hY1g, (ii + jj * T) * 4)
            gvv = read_f32(hG1, jj * 4)
            xhv = read_f32(hXH1b, (ii + jj * T) * 4)
            dxv = (dvv * gvv - acc1 / H - xhv * acc2 / H) * rsv
            wz = write_f32(hDXb, (ii + jj * T) * 4, dxv)
            gtmp = read_f32(hDG1, jj * 4) + dvv * xhv
            wz = write_f32(hDG1, jj * 4, gtmp)
            btmp = read_f32(hDB1, jj * 4) + dvv
            wz = write_f32(hDB1, jj * 4, btmp)
            jj = jj + 1
        ii = ii + 1
    bk11: "i64" = cuda_h2d(dDX, hDXb, qb, 1)
    print("MARK B done")
    # ==================== DUMP GRADIENTS ====================
    hgr = alloc_bytes(h4 * H)
    bj0: "i64" = cuda_h2d(hgr, dW2g, hb * F, 2)
    ii = 0
    while ii < F:
        jj = 0
        while jj < H:
            gvv: "f32" = read_f32(hgr, (ii + jj * F) * 4)
            print("GW2", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj1: "i64" = cuda_h2d(hgr, dW1g, h4 * H, 2)
    ii = 0
    while ii < H:
        jj = 0
        while jj < F:
            gvv = read_f32(hgr, (ii + jj * H) * 4)
            print("GW1", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    ii = 0
    while ii < T:
        jj = 0
        while jj < H:
            gvv = read_f32(hY2g, (ii + jj * T) * 4)
            print("GY2", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj2: "i64" = cuda_h2d(hgr, dDX2T, qb, 2)
    ii = 0
    while ii < T:
        jj = 0
        while jj < H:
            gvv = read_f32(hgr, (ii + jj * T) * 4)
            print("GX2", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj3: "i64" = cuda_h2d(hgr, dAg, qb, 2)
    ii = 0
    while ii < T:
        jj = 0
        while jj < H:
            gvv = read_f32(hgr, (ii + jj * T) * 4)
            print("GA", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj4: "i64" = cuda_h2d(hgr, dWog, hb * H, 2)
    ii = 0
    while ii < H:
        jj = 0
        while jj < H:
            gvv = read_f32(hgr, (ii + jj * H) * 4)
            print("GWO", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj5: "i64" = cuda_h2d(hgr, dPg, sb, 2)
    ii = 0
    while ii < T:
        jj = 0
        while jj < T:
            gvv = read_f32(hgr, (ii + jj * T) * 4)
            print("GP", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj6: "i64" = cuda_h2d(hgr, dVg, qb, 2)
    ii = 0
    while ii < H:
        jj = 0
        while jj < T:
            gvv = read_f32(hgr, (ii + jj * H) * 4)
            print("GV", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj7: "i64" = cuda_h2d(hgr, dSg, sb, 2)
    ii = 0
    while ii < T:
        jj = 0
        while jj < T:
            gvv = read_f32(hgr, (ii + jj * T) * 4)
            print("GS", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj8: "i64" = cuda_h2d(hgr, dQg, qb, 2)
    ii = 0
    while ii < T:
        jj = 0
        while jj < H:
            gvv = read_f32(hgr, (ii + jj * T) * 4)
            print("GQ", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj9: "i64" = cuda_h2d(hgr, dKg, hb * H, 2)
    ii = 0
    while ii < H:
        jj = 0
        while jj < H:
            gvv = read_f32(hgr, (ii + jj * H) * 4)
            print("GK", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj10: "i64" = cuda_h2d(hgr, dWqg, hb * H, 2)
    ii = 0
    while ii < H:
        jj = 0
        while jj < H:
            gvv = read_f32(hgr, (ii + jj * H) * 4)
            print("GWQ", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj11: "i64" = cuda_h2d(hgr, dWkg, hb * H, 2)
    ii = 0
    while ii < H:
        jj = 0
        while jj < H:
            gvv = read_f32(hgr, (ii + jj * H) * 4)
            print("GWK", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj12: "i64" = cuda_h2d(hgr, dWvg, hb * H, 2)
    ii = 0
    while ii < H:
        jj = 0
        while jj < H:
            gvv = read_f32(hgr, (ii + jj * H) * 4)
            print("GWV", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj13: "i64" = cuda_h2d(hgr, dY1g, qb, 2)
    ii = 0
    while ii < T:
        jj = 0
        while jj < H:
            gvv = read_f32(hgr, (ii + jj * T) * 4)
            print("GY1", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    bj14: "i64" = cuda_h2d(hgr, dDX, qb, 2)
    ii = 0
    while ii < T:
        jj = 0
        while jj < H:
            gvv = read_f32(hgr, (ii + jj * T) * 4)
            print("GDX", ii, jj, gvv)
            jj = jj + 1
        ii = ii + 1
    ii = 0
    while ii < H:
        gvv = read_f32(hDG1, ii * 4)
        print("GG1", ii, gvv)
        gvv = read_f32(hDB1, ii * 4)
        print("GB1", ii, gvv)
        gvv = read_f32(hDG2, ii * 4)
        print("GG2", ii, gvv)
        gvv = read_f32(hDB2, ii * 4)
        print("GB2", ii, gvv)
        ii = ii + 1
    print("BATCH DONE")
    return 0
