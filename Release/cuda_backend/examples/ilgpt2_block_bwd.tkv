    hWk = alloc_bytes(hb * H)
    hWv = alloc_bytes(hb * H)
    hWo = alloc_bytes(hb * H)
    hW1 = alloc_bytes(h4 * H)
    hW2 = alloc_bytes(hb * F)
    hG1 = alloc_bytes(hb)
    hB1 = alloc_bytes(hb)
    hG2 = alloc_bytes(hb)
    hB2 = alloc_bytes(hb)
    i: "i32" = 0
    j: "i32" = 0
    while i < T:
        j = 0
        while j < H:
            w0: "i64" = write_f32(hX, (i + j * T) * 4, 0.1 + 0.02 * (i + j))
            wd0: "i64" = write_f32(hDOUT, (i + j * T) * 4, 0.01 * (i + j + 1))
            j = j + 1
        i = i + 1
    i = 0
    while i < H:
        j = 0
        while j < H:
            w1: "i64" = write_f32(hWq, (i + j * H) * 4, 0.20 + 0.01 * (i + j))
            w2: "i64" = write_f32(hWk, (i + j * H) * 4, 0.15 + 0.01 * (i + j))
            w3: "i64" = write_f32(hWv, (i + j * H) * 4, 0.10 + 0.01 * (i + j))
            w4: "i64" = write_f32(hWo, (i + j * H) * 4, 0.30 + 0.01 * (i + j))
            j = j + 1
        w5: "i64" = write_f32(hG1, i * 4, 1.0 + 0.05 * i)
        w6: "i64" = write_f32(hB1, i * 4, 0.01 * i)
        w7: "i64" = write_f32(hG2, i * 4, 1.1 + 0.04 * i)
