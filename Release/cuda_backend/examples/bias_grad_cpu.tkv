# -*- coding: utf-8 -*-
# Signature PHAI khop native export: BiasGrad(gy, gy_len, gflat, gflat_len, off, n, cols)
# @tkv.cpu_kernel target="avx2"
def BiasGrad(gy: "ptr[f32]", gy_len: "i32", gflat: "ptr[f32]", gflat_len: "i32", off: "i64", n: "i32", cols: "i32") -> "i32":
    for c in range(cols):
        acc = gflat[off + c]
        for i in range(n):
            acc = acc + gy[i * cols + c]
        gflat[off + c] = acc
    return 0


def run() -> "i32":
    return 0