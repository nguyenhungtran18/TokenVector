# -*- coding: utf-8 -*-
# Flash attention - TOAN BO 7 kernel export bang TokenVector thuann (khong chen C).
# 2 helper (fwd/bwd 1 head) duoc goi lai boi cac wrapper export.
# @tkv.cpu_kernel target="avx2"
def FlashFwdHead(qkv: "ptr[f32]", ctx_out: "ptr[f32]", lse_out: "ptr[f32]", n: "i32", h: "i32", head: "i32", inv: "f64") -> "i32":    stride3 = 3 * h % 1000000
    coff_q = head * 64 % 1000000
    f_inv = inv
    nb_m = (n + 63) // 64 % 1000000
    qk = f32buf(4096)
    dst = f32buf(4096)
    mx = f32buf(64)
    sm = f32buf(64)
    for im in range(nb_m):
        m0 = (im * 64) % 1000000
        qb = (n - m0) % 1000000
        if qb > 64:
            qb = 64
        num_keys = (m0 + qb) % 1000000
        if num_keys > n:
            num_keys = n
        nb_kv = (num_keys + 63) // 64 % 1000000
        for a in range(64):
            mx[a] = -3.4028234663852886e38
            sm[a] = 0.0
        for a in range(4096):
            dst[a] = 0.0
        for ik in range(nb_kv):
            n0 = (ik * 64) % 1000000
            kvb = (num_keys - n0) % 1000000
            if kvb > 64:
                kvb = 64
            nvec = (kvb // 8) * 8 % 1000000
            for i in range(qb):
                qbase = ((m0 + i) * stride3 + coff_q) % 1000000000
                for j in range(kvb):
                    f_s = 0.0
                    kbase = ((n0 + j) * stride3 + h + coff_q) % 1000000000
                    for d in range(64):
                        f_s = fma(qkv[qbase + d], qkv[kbase + d], f_s)
                    qk[i * 64 + j] = f_s * f_inv
                    if n0 + j > m0 + i:
                        qk[i * 64 + j] = -3.4028234663852886e38
                f_rmax = -3.4028234663852886e38
                for j in range(kvb):
                    if qk[i * 64 + j] > f_rmax:
                        f_rmax = qk[i * 64 + j]
                f_newmax = f_rmax
                if mx[i] > f_newmax:
                    f_newmax = mx[i]
                f_ok = 1.0
                if f_newmax == -3.4028234663852886e38:
                    f_ok = 0.0
                if f_ok == 1.0:
                    f_exptmp = 1.0
                    if n0 > 0:
                        f_exptmp = exp(mx[i] - f_newmax)
                    if mx[i] == -3.4028234663852886e38:
                        f_exptmp = 0.0
                    f_bsum = 0.0
                    for j in range(kvb):
                        f_x = qk[i * 64 + j] - f_newmax
                        f_e = 0.0
                        if j < nvec:
                            if f_x < -87.3:
                                f_x = -87.3
                            if f_x > 88.7:
                                f_x = 88.7
                            f_t = f_x * 1.4426950408889634f
                            f_n = tkv_rint(f_t)
                            f_f = f_t - f_n
                            f_f = f_f * 0.6931471805599453f
                            f_r = 1.388888654e-04f
                            f_r = fma(f_r, f_f, 8.333333e-03f)
                            f_r = fma(f_r, f_f, 4.1666665e-02f)
                            f_r = fma(f_r, f_f, 1.6666666e-01f)
                            f_r = fma(f_r, f_f, 5.0000000e-01f)
                            f_r = fma(f_r, f_f, 1.00000000e+00f)
                            f_r = fma(f_r, f_f, 1.00000000e+00f)
                            f_e = f_r * tkv_ldexp(1.0f, f_n)
                        if j >= nvec:
                            f_e = exp(f_x)
                        qk[i * 64 + j] = f_e
                        f_bsum = f_bsum + f_e
                    if n0 > 0:
                        for d in range(64):
                            dst[i * 64 + d] = dst[i * 64 + d] * f_exptmp
                    sm[i] = f_bsum + f_exptmp * sm[i]
                    mx[i] = f_newmax
                if f_ok == 0.0:
                    for j in range(kvb):
                        qk[i * 64 + j] = 0.0
                    for d in range(64):
                        dst[i * 64 + d] = 0.0
                    mx[i] = f_newmax
            for i in range(qb):
                vbase = (n0 * stride3 + 2 * h + coff_q) % 1000000000
                for d in range(64):
                    f_acc = dst[i * 64 + d]
                    for j in range(kvb):
                        f_acc = fma(qk[i * 64 + j], qkv[vbase + j * stride3 + d], f_acc)
                    dst[i * 64 + d] = f_acc
        for i in range(qb):
            f_sinv = 1.0 / sm[i]
            obase = ((m0 + i) * 64) % 1000000000
            for d in range(64):
                ctx_out[obase + d] = dst[i * 64 + d] * f_sinv
            lse[m0 + i] = mx[i] + log(sm[i])

# @tkv.cpu_kernel target="avx2"
def FlashBwdHead(qkv: "ptr[f32]", dctx: "ptr[f32]", ctx_in: "ptr[f32]", lse_in: "ptr[f32]", ctxo: "ptr[f32]", dqo: "ptr[f32]", n: "i32", h: "i32", head: "i32", inv: "f64") -> "i32":    stride3 = 3 * h % 1000000
    coff_q = head * 64 % 1000000
    f_inv = inv
    dsum = f32buf(1024)
    dq = f32buf(65536)
    dk = f32buf(65536)
    dv = f32buf(65536)
    attn = f32buf(4096)
    gA = f32buf(4096)
    ds = f32buf(4096)
    f_acc = 0.0
    for a in range(n):
        dsum[a] = 0.0
    for a in range(n * 64):
        dq[a] = 0.0
        dk[a] = 0.0
        dv[a] = 0.0
    for t in range(n):
        db = (t * 64) % 1000000000
        ob = (t * 64) % 1000000000
        f_a0 = 0.0
        f_a1 = 0.0
        f_a2 = 0.0
        f_a3 = 0.0
        f_a4 = 0.0
        f_a5 = 0.0
        f_a6 = 0.0
        f_a7 = 0.0
        bbase = (t * h + coff_q) % 1000000000
        for p in range(8):
            f_a0 = fma(dctx[bbase + p], ctx_in[ob + p], f_a0)
            f_a1 = fma(dctx[bbase + 8 + p], ctx_in[ob + 8 + p], f_a1)
            f_a2 = fma(dctx[bbase + 16 + p], ctx_in[ob + 16 + p], f_a2)
            f_a3 = fma(dctx[bbase + 24 + p], ctx_in[ob + 24 + p], f_a3)
            f_a4 = fma(dctx[bbase + 32 + p], ctx_in[ob + 32 + p], f_a4)
            f_a5 = fma(dctx[bbase + 40 + p], ctx_in[ob + 40 + p], f_a5)
            f_a6 = fma(dctx[bbase + 48 + p], ctx_in[ob + 48 + p], f_a6)
            f_a7 = fma(dctx[bbase + 56 + p], ctx_in[ob + 56 + p], f_a7)
        dsum[t] = ((f_a0 + f_a4) + (f_a1 + f_a5)) + ((f_a2 + f_a6) + (f_a3 + f_a7))
    nb_kv = (n + 63) // 64 % 1000000
    for ik in range(nb_kv):
        n0 = (ik * 64) % 1000000
        kvb = (n - n0) % 1000000
        if kvb > 64:
            kvb = 64
        nb_m = ((n - n0) + 63) // 64 % 1000000
        nvec = (kvb // 8) * 8 % 1000000
        for im in range(nb_m):
            m0 = (n0 + im * 64) % 1000000
            qb = (n - m0) % 1000000
            if qb > 64:
                qb = 64
            for i in range(qb):
                qbase = ((m0 + i) * stride3 + coff_q) % 1000000000
                dbase = ((m0 + i) * h + coff_q) % 1000000000
                for j in range(kvb):
                    kbase = ((n0 + j) * stride3 + h + coff_q) % 1000000000
                    f_s = 0.0
                    for d in range(64):
                        f_s = fma(qkv[qbase + d], qkv[kbase + d], f_s)
                    f_x = f_s * f_inv - lse_in[m0 + i]
                    f_e = 0.0
                    if j < nvec:
                        if f_x < -87.3:
                            f_x = -87.3
                        if f_x > 88.7:
                            f_x = 88.7
                        f_t = f_x * 1.4426950408889634f
                        f_n = tkv_rint(f_t)
                        f_f = f_t - f_n
                        f_f = f_f * 0.6931471805599453f
                        f_r = 1.388888654e-04f
                        f_r = fma(f_r, f_f, 8.333333e-03f)
                        f_r = fma(f_r, f_f, 4.1666665e-02f)
                        f_r = fma(f_r, f_f, 1.6666666e-01f)
                        f_r = fma(f_r, f_f, 5.0000000e-01f)
                        f_r = fma(f_r, f_f, 1.00000000e+00f)
                        f_r = fma(f_r, f_f, 1.00000000e+00f)
                        f_e = f_r * tkv_ldexp(1.0f, f_n)
                    if j >= nvec:
                        f_e = exp(f_x)
                    attn[i * 64 + j] = f_e
                    if n0 + j > m0 + i:
                        attn[i * 64 + j] = 0.0
                    f_g = 0.0
                    vbase = ((n0 + j) * stride3 + 2 * h + coff_q) % 1000000000
                    for d in range(64):
                        f_g = fma(dctx[dbase + d], qkv[vbase + d], f_g)
                    gA[i * 64 + j] = f_g
                    ds[i * 64 + j] = attn[i * 64 + j] * (gA[i * 64 + j] - dsum[m0 + i])
            for j in range(kvb):
                for d in range(64):
                    f_acc = dv[(n0 + j) * 64 + d]
                    dbase2 = (m0 * h + coff_q) % 1000000000
                    for i in range(qb):
                        f_acc = fma(attn[i * 64 + j], dctx[dbase2 + i * h + d], f_acc)
                    dv[(n0 + j) * 64 + d] = f_acc
            for i in range(qb):
                for d in range(64):
                    f_acc = dq[(m0 + i) * 64 + d]
                    kbase2 = ((n0) * stride3 + h + coff_q) % 1000000000
                    for j in range(kvb):
                        f_acc = fma(ds[i * 64 + j], qkv[kbase2 + j * stride3 + d], f_acc)
                    dq[(m0 + i) * 64 + d] = f_acc
            for j in range(kvb):
                for d in range(64):
                    f_acc = dk[(n0 + j) * 64 + d]
                    qbase2 = ((m0) * stride3 + coff_q) % 1000000000
                    for i in range(qb):
                        f_acc = fma(ds[i * 64 + j], qkv[qbase2 + i * stride3 + d], f_acc)
                    dk[(n0 + j) * 64 + d] = f_acc
    for t in range(n):
        wb = (t * 64) % 1000000000
        pb = (t * 192) % 1000000000
        for d in range(64):
            ctxo[wb + d] = ctx_in[wb + d]
            dqo[pb + d] = dq[wb + d] * f_inv
            dqo[pb + 64 + d] = dk[wb + d] * f_inv
            dqo[pb + 128 + d] = dv[wb + d]

# @tkv.cpu_kernel target="avx2"
def FlashAttentionFwdLse(qkv: "ptr[f32]", qkv_len: "i32", ctx_out: "ptr[f32]", ctx_len: "i32", lse: "ptr[f32]", lse_len: "i32", n: "i32", h: "i32", hd: "i32", head: "i32", inv: "f64") -> "i32":
    FlashFwdHead(qkv, ctx_out, lse, n, h, head, inv)


# @tkv.cpu_kernel target="avx2"
def FlashAttentionFwdFused(qkv: "ptr[f32]", qkv_len: "i32", ctx_out: "ptr[f32]", ctx_len: "i32", n: "i32", h: "i32", hd: "i32", head: "i32", inv: "f64") -> "i32":
    dummy_lse = f32buf(1024)
    FlashFwdHead(qkv, ctx_out, dummy_lse, n, h, head, inv)


# @tkv.cpu_kernel target="avx2"
def FlashAttentionBwdFusedLse(qkv: "ptr[f32]", qkv_len: "i32", dctx: "ptr[f32]", dctx_len: "i32", ctx_in: "ptr[f32]", ctx_in_len: "i32", lse_in: "ptr[f32]", lse_in_len: "i32", ctxo: "ptr[f32]", ctxo_len: "i32", dqo: "ptr[f32]", dqo_len: "i32", n: "i32", h: "i32", hd: "i32", head: "i32", inv: "f64") -> "i32":
    FlashBwdHead(qkv, dctx, ctx_in, lse_in, ctxo, dqo, n, h, head, inv)


# @tkv.cpu_kernel target="avx2"
def FlashAttentionBwdFused(qkv: "ptr[f32]", qkv_len: "i32", dctx: "ptr[f32]", dctx_len: "i32", ctxo: "ptr[f32]", ctxo_len: "i32", dqo: "ptr[f32]", dqo_len: "i32", n: "i32", h: "i32", hd: "i32", head: "i32", inv: "f64") -> "i32":
    fwd_ctx = f32buf(65536)
    fwd_lse = f32buf(1024)
    FlashFwdHead(qkv, fwd_ctx, fwd_lse, n, h, head, inv)
    FlashBwdHead(qkv, dctx, fwd_ctx, fwd_lse, ctxo, dqo, n, h, head, inv)

# @tkv.cpu_kernel target="avx2"
def FlashAttentionFwdLseMulti(qkv: "ptr[f32]", qkv_len: "i32", ctx_out: "ptr[f32]", ctx_len: "i32", lse: "ptr[f32]", lse_len: "i32", n: "i32", h: "i32", hd: "i32", inv: "f64", nthreads: "i32") -> "i32":
    nh = h // 64 % 1000000
    co = f32buf(65536)
    ls = f32buf(1024)
    for head in range(nh):
        FlashFwdHead(qkv, co, ls, n, h, head, inv)
        hb = (head * n * 64) % 1000000000
        for t in range(n):
            for d in range(64):
                ctx_out[hb + t * 64 + d] = co[t * 64 + d]
            lse[head * n + t] = ls[t]


# @tkv.cpu_kernel target="avx2"
def FlashAttentionBwdFusedLseMulti(qkv: "ptr[f32]", qkv_len: "i32", dctx: "ptr[f32]", dctx_len: "i32", ctx_in: "ptr[f32]", ctx_in_len: "i32", lse_in: "ptr[f32]", lse_in_len: "i32", ctxo: "ptr[f32]", ctxo_len: "i32", dqo: "ptr[f32]", dqo_len: "i32", n: "i32", h: "i32", hd: "i32", inv: "f64", nthreads: "i32") -> "i32":
    nh = h // 64 % 1000000
    ci = f32buf(65536)
    ls = f32buf(1024)
    co = f32buf(65536)
    dq = f32buf(196608)
    for head in range(nh):
        hb = (head * n * 64) % 1000000000
        qb = (head * n * 192) % 1000000000
        for t in range(n):
            for d in range(64):
                ci[t * 64 + d] = ctx_in[hb + t * 64 + d]
            ls[t] = lse_in[head * n + t]
        FlashBwdHead(qkv, dctx, ci, ls, co, dq, n, h, head, inv)
        for t in range(n):
            for d in range(64):
                ctxo[hb + t * 64 + d] = co[t * 64 + d]
                dqo[qb + t * 192 + d] = dq[t * 192 + d]
                dqo[qb + t * 192 + 64 + d] = dq[t * 192 + 64 + d]
                dqo[qb + t * 192 + 128 + d] = dq[t * 192 + 128 + d]


# @tkv.cpu_kernel target="avx2"
def FlashAttentionBwdMergeMulti(qkv: "ptr[f32]", qkv_len: "i32", dctx: "ptr[f32]", dctx_len: "i32", ctx_in: "ptr[f32]", ctx_in_len: "i32", lse_in: "ptr[f32]", lse_in_len: "i32", ctxT: "ptr[f32]", ctxT_len: "i32", dqkv: "ptr[f32]", dqkv_len: "i32", n: "i32", h: "i32", hd: "i32", inv: "f64", nthreads: "i32") -> "i32":
    nh = h // 64 % 1000000
    ci = f32buf(65536)
    ls = f32buf(1024)
    co = f32buf(65536)
    dq = f32buf(196608)
    for head in range(nh):
        hb = (head * n * 64) % 1000000000
        qb = (head * n * 192) % 1000000000
        ho = head * 64 % 1000000
        for t in range(n):
            for d in range(64):
                ci[t * 64 + d] = ctx_in[hb + t * 64 + d]
            ls[t] = lse_in[head * n + t]
        FlashBwdHead(qkv, dctx, ci, ls, co, dq, n, h, head, inv)
        for t in range(n):
            c0 = (t * h + ho) % 1000000000
            p0 = (t * 3 * h + ho) % 1000000000
            for d in range(64):
                ctxT[c0 + d] = co[t * 64 + d]
                dqkv[p0 + d] = dq[t * 192 + d]
                dqkv[p0 + h + d] = dq[t * 192 + 64 + d]
                dqkv[p0 + 2 * h + d] = dq[t * 192 + 128 + d]

def run() -> "i32":
    return 0
