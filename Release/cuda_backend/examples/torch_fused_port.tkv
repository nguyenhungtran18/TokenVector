# -*- coding: utf-8 -*-
# GPU bridge port - state + ids
g_adamw_path = 0
g_grad_buf = 0  # ptr[f32]
g_grad_len = 0  # i64
g_lr = 0.00005  # f32
g_b1 = 0.9  # f32
g_b2 = 0.999  # f32
g_eps = 0.00000001  # f32
g_wd = 0.0  # f32
g_total_steps = 0  # i64
g_cur_step = 0  # i64
g_ids = 0  # tensor
g_pos = 0  # tensor
g_tgt = 0  # tensor
g_p = 0  # tensor[]
g_p_src = 0  # ptr[]
g_p_numels = 0  # i64[]

# @tkv.torch_kernel target="cuda"
def TkvFullPing(x: "i64") -> "i64":
    return x + 42000


# @tkv.torch_kernel target="cuda"
def TkvFullAdamwPath() -> "i32":
    return g_adamw_path


# @tkv.torch_kernel target="cuda"
def TkvFullSetGrad(buf: "ptr[f32]", n: "i64") -> "i32":
    g_grad_buf = buf
    g_grad_len = n
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullSetOpt(p: "ptr[f32]", m: "ptr[f32]", v: "ptr[f32]", lr: "f32", b1: "f32", b2: "f32", eps: "f32", wd: "f32", total_steps: "i64", cur_step: "i64") -> "i32":
    g_lr = lr
    g_b1 = b1
    g_b2 = b2
    g_eps = eps
    g_wd = wd
    g_total_steps = total_steps
    g_cur_step = cur_step
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullSetIds(ids: "ptr[i32]", T: "i64") -> "i32":
    t = torch_blob_i32(ids, T)
    g_ids = torch_to_long(t)
    g_pos = torch_arange(T, tkv_opt_long())
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullSetTargets(ids: "ptr[i32]", T: "i64") -> "i32":
    t = torch_blob_i32(ids, T)
    g_tgt = torch_to_long(t)
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullSetTensor(idx: "i64", ptr: "ptr[f32]", numel: "i64") -> "i32":
    if idx < 0:
        return -2
    if idx >= vec_len(g_p):
        return -2
    if tkv_defined(g_p[idx]) and tkv_numel(g_p[idx]) == numel and g_p_src[idx] == ptr:
        return 0
    t = torch_blob_f32(ptr, numel)
    ht = torch_to_half(t)
    if tkv_defined(g_p[idx]) and tkv_numel(g_p[idx]) == numel:
        tkv_copy_(g_p[idx], ht)
    else:
        g_p[idx] = torch_to_dev(ht)
    g_p_src[idx] = ptr
    g_p_numels[idx] = numel
    return 0


def run() -> "i32":
    return 0