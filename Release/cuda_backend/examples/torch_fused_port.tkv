# -*- coding: utf-8 -*-
# GPU bridge port - state + ids
g_adamw_path = 0
g_grad_buf = 0  # ptr[f32]
g_grad_len = 0  # i64
g_lr = 0.00005  # f32
g_b1 = 0.9  # f32
g_b2 = 0.999  # f32
g_eps = 0.00000001  # f32
g_wd = 0.0  # f32
g_total_steps = 0  # i64
g_cur_step = 0  # i64
g_ids = 0  # tensor
g_pos = 0  # tensor
g_tgt = 0  # tensor
g_p = 0  # tensor[]
g_p_src = 0  # ptr[]
g_p_numels = 0  # i64[]
g_p_all = 0  # tensor
g_m_buf = 0  # ptr[f32]
g_v_buf = 0  # ptr[f32]
g_cfg0 = 0
g_cfg1 = 0
g_cfg2 = 0
g_cfg3 = 0
g_cfg4 = 0
g_cfg5 = 0
g_nlayers = 0
g_h = 0
g_nhd = 0
g_hd = 0
g_vocab = 0
g_grad_dev = 0  # tensor
g_m_dev = 0  # tensor
g_v_dev = 0  # tensor
g_dev_ready = 0

# @tkv.torch_kernel target="cuda"
def TkvFullPing(x: "i64") -> "i64":
    return x + 42000


# @tkv.torch_kernel target="cuda"
def TkvFullAdamwPath() -> "i32":
    return g_adamw_path


# @tkv.torch_kernel target="cuda"
def TkvFullSetGrad(buf: "ptr[f32]", n: "i64") -> "i32":
    g_grad_buf = buf
    g_grad_len = n
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullSetOpt(p: "ptr[f32]", m: "ptr[f32]", v: "ptr[f32]", lr: "f32", b1: "f32", b2: "f32", eps: "f32", wd: "f32", total_steps: "i64", cur_step: "i64") -> "i32":
    g_lr = lr
    g_b1 = b1
    g_b2 = b2
    g_eps = eps
    g_wd = wd
    g_total_steps = total_steps
    g_cur_step = cur_step
    g_m_buf = m
    g_v_buf = v
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullSetIds(ids: "ptr[i32]", T: "i64") -> "i32":
    t = torch_blob_i32(ids, T)
    g_ids = torch_to_long(t)
    g_pos = torch_arange(T, tkv_opt_long())
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullSetTargets(ids: "ptr[i32]", T: "i64") -> "i32":
    t = torch_blob_i32(ids, T)
    g_tgt = torch_to_long(t)
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullSetTensor(idx: "i64", ptr: "ptr[f32]", numel: "i64") -> "i32":
    if idx < 0:
        return -2
    if idx >= vec_len(g_p):
        return -2
    if tkv_defined(g_p[idx]) and tkv_numel(g_p[idx]) == numel and g_p_src[idx] == ptr:
        return 0
    t = torch_blob_f32(ptr, numel)
    ht = torch_to_half(t)
    if tkv_defined(g_p[idx]) and tkv_numel(g_p[idx]) == numel:
        tkv_copy_(g_p[idx], ht)
    else:
        g_p[idx] = torch_to_dev(ht)
    g_p_src[idx] = ptr
    g_p_numels[idx] = numel
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullBegin(n_tensors: "i64", NLayers: "i64", H: "i64", NHeads: "i64", Hd: "i64", Vocab: "i64") -> "i32":
    if n_tensors <= 4:
        return -2
    if NLayers <= 0:
        return -2
    changed = 0 % 1000000007
    if g_cfg0 != n_tensors:
        changed = 1
    if g_cfg1 != NLayers:
        changed = 1
    if g_cfg2 != H:
        changed = 1
    if g_cfg3 != NHeads:
        changed = 1
    if g_cfg4 != Hd:
        changed = 1
    if g_cfg5 != Vocab:
        changed = 1
    if changed == 1:
        g_cfg0 = n_tensors
        g_cfg1 = NLayers
        g_cfg2 = H
        g_cfg3 = NHeads
        g_cfg4 = Hd
        g_cfg5 = Vocab
        tkv_assign_tensor(g_p, n_tensors)
        tkv_assign_ptr(g_p_src, n_tensors)
        tkv_assign_i64(g_p_numels, n_tensors)
        tkv_reset(g_p_all)
        tkv_reset(g_ids)
        tkv_reset(g_pos)
        tkv_reset(g_tgt)
    g_grad_buf = 0
    g_grad_len = 0
    g_nlayers = NLayers
    g_h = H
    g_nhd = NHeads
    g_hd = Hd
    g_vocab = Vocab
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullGetParams(dst: "ptr[f32]", n: "i64") -> "i32":
    if n <= 0:
        return -1
    if tkv_defined(g_p_all) == 0:
        return -2
    if tkv_numel(g_p_all) != n:
        return -2
    tkv_copy_out(g_p_all, dst, n)
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullSetIdsGen(T: "i64") -> "i32":
    if T <= 0:
        return -1
    V = g_vocab % 1000000007
    if V <= 0:
        V = 50257
    cpu = tkv_empty_i64(T)
    p = tkv_data_i64(cpu)
    for i in range(T):
        p[i] = (i * 37 + 11) % V
    g_ids = torch_to_long(cpu)
    g_pos = torch_arange(T, tkv_opt_long())
    return 0


# @tkv.torch_kernel target="cuda"
def TkvFullStep124mFwd(run_mode: "i64") -> "f32":
    T = g_ids.numel() % 1000000007
    h = g_h % 1000000007
    nh = g_nhd % 1000000007
    hd = g_hd % 1000000007
    V = g_vocab % 1000000007
    L = g_nlayers % 1000000007
    wte = torch_view2(g_p[0], V, h)
    Pw = (g_p[1].numel() / h) % 1000000007
    wpe = torch_view2(g_p[1], Pw, h)
    x = torch_index_select(wte, 0, g_ids) + torch_index_select(wpe, 0, g_pos)
    for li in range(L):
        b0 = (4 + li * 12) % 1000000007
        a = torch_ln(x, g_p[b0], g_p[b0 + 1], 1e-6)
        wqkv = torch_view2(g_p[b0 + 2], h, 3 * h)
        qkv = torch_half_addmm(g_p[b0 + 3], a, wqkv)
        qkv3 = torch_view4(qkv, T, 3, nh, hd)
        q = torch_unsqueeze(torch_transpose(torch_select(qkv3, 1, 0), 0, 1), 0)
        k = torch_unsqueeze(torch_transpose(torch_select(qkv3, 1, 1), 0, 1), 0)
        v = torch_unsqueeze(torch_transpose(torch_select(qkv3, 1, 2), 0, 1), 0)
        attn = torch_sdpa_causal(q, k, v)
        ctx = torch_reshape2(torch_transpose(attn, 1, 2), T, h)
        wp = torch_view2(g_p[b0 + 4], h, h)
        proj = torch_half_addmm(g_p[b0 + 5], ctx, wp)
        x = x + proj
        m = torch_ln(x, g_p[b0 + 6], g_p[b0 + 7], 1e-6)
        w1 = torch_view2(g_p[b0 + 8], h, 4 * h)
        u = torch_half_addmm(g_p[b0 + 9], m, w1)
        g1 = torch_gelu(u)
        w2 = torch_view2(g_p[b0 + 10], 4 * h, h)
        x = x + torch_half_addmm(g_p[b0 + 11], g1, w2)
    xf = torch_ln(x, g_p[2], g_p[3], 1e-6)
    logits = torch_half_mm(xf, torch_transpose(wte, 0, 1))
    lp = torch_log_softmax(torch_to_f32(logits), -1)
    tgt = torch_unsqueeze(g_tgt, 1)
    loss_t = -torch_mean(torch_gather(lp, 1, tgt))
    return torch_item_f32(loss_t)


# @tkv.torch_kernel target="cuda"
def TkvFullStep124m(run_mode: "i64") -> "f32":
    T = g_ids.numel() % 1000000007
    h = g_h % 1000000007
    nh = g_nhd % 1000000007
    hd = g_hd % 1000000007
    V = g_vocab % 1000000007
    L = g_nlayers % 1000000007
    tkv_dbg(1, 0.0)
    if g_grad_len > 0:
        if g_dev_ready == 0:
            g_p_all = tkv_dev_flat_from(g_p)
            for i in range(g_p.size()):
                tkv_flat_copy_f32(g_p_all, tkv_flat_off(g_p, i), g_p[i])
            for i in range(g_p.size()):
                g_p[i] = tkv_flat_half(g_p_all, tkv_flat_off(g_p, i), g_p_numels[i])
            g_m_dev = tkv_dev_zeros_f32(g_p_all.numel())
            g_v_dev = tkv_dev_zeros_f32(g_p_all.numel())
            tkv_host_copy_f32(g_m_dev, g_m_buf, g_p_all.numel())
            tkv_host_copy_f32(g_v_dev, g_v_buf, g_p_all.numel())
            g_grad_dev = tkv_dev_empty_f32(g_p_all.numel())
            g_dev_ready = 1
    if g_dev_ready != 0:
        for i in range(g_p.size()):
            if g_p[i].requires_grad() == 0:
                g_p[i].set_requires_grad(1)
    tkv_dbg(2, 0.0)
    wte = torch_view2(g_p[0], V, h)
    Pw = (g_p[1].numel() / h) % 1000000007
    wpe = torch_view2(g_p[1], Pw, h)
    x = torch_index_select(wte, 0, g_ids) + torch_index_select(wpe, 0, g_pos)
    for li in range(L):
        b0 = (4 + li * 12) % 1000000007
        a = torch_ln(x, g_p[b0], g_p[b0 + 1], 1e-6)
        wqkv = torch_view2(g_p[b0 + 2], h, 3 * h)
        qkv = torch_half_addmm(g_p[b0 + 3], a, wqkv)
        qkv3 = torch_view4(qkv, T, 3, nh, hd)
        q = torch_unsqueeze(torch_transpose(torch_select(qkv3, 1, 0), 0, 1), 0)
        k = torch_unsqueeze(torch_transpose(torch_select(qkv3, 1, 1), 0, 1), 0)
        v = torch_unsqueeze(torch_transpose(torch_select(qkv3, 1, 2), 0, 1), 0)
        attn = torch_sdpa_causal(q, k, v)
        ctx = torch_reshape2(torch_transpose(attn, 1, 2), T, h)
        wp = torch_view2(g_p[b0 + 4], h, h)
        proj = torch_half_addmm(g_p[b0 + 5], ctx, wp)
        x = x + proj
        m = torch_ln(x, g_p[b0 + 6], g_p[b0 + 7], 1e-6)
        w1 = torch_view2(g_p[b0 + 8], h, 4 * h)
        u = torch_half_addmm(g_p[b0 + 9], m, w1)
        g1 = torch_gelu(u)
        w2 = torch_view2(g_p[b0 + 10], 4 * h, h)
        x = x + torch_half_addmm(g_p[b0 + 11], g1, w2)
    xf = torch_ln(x, g_p[2], g_p[3], 1e-6)
    logits = torch_half_mm(xf, torch_transpose(wte, 0, 1))
    lp = torch_log_softmax(torch_to_f32(logits), -1)
    tgt = torch_unsqueeze(g_tgt, 1)
    loss_t = -torch_mean(torch_gather(lp, 1, tgt))
    loss_val = torch_item_f32(loss_t)
    tkv_dbg(3, loss_val)
    if run_mode == 1:
        return loss_val
    if g_dev_ready == 0:
        return loss_val
    torch_backward(loss_t)
    for i in range(g_p.size()):
        gr = torch_grad(g_p[i])
        if tkv_defined(gr) != 0:
            torch_put_grad(i, gr)
        if tkv_defined(gr) == 0:
            torch_zero_grad(i)
        torch_clear_grad(g_p[i])
    tkv_dbg(4, 0.0)
    torch_adamw()
    torch_sync_fp16()
    tkv_dbg(5, 0.0)
    g_cur_step = g_cur_step + 1
    return loss_val


def run() -> "i32":
    return 0