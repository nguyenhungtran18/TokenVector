# -*- coding: utf-8 -*-
# probe: 2 kernels trong 1 file
# @tkv.cpu_kernel target="avx2"
def KernelA(a: "ptr[f32]", n: "i32") -> "i32":
    for i in range(n):
        a[i] = a[i] + 1.0


# @tkv.cpu_kernel target="avx2"
def KernelB(a: "ptr[f32]", n: "i32") -> "i32":
    for i in range(n):
        a[i] = a[i] * 2.0


def run() -> "i32":
    return 0