# -*- coding: utf-8 -*-
# IL-only SDPA/causal. Khong C++/torch.
# Chi dung kernel da xac nhan: PREP (scale+mask+exp) va NORM (tu batch LayerNorm).
__tkv_extern_pinvoke__ = [
    {"name": "cu_init", "dll": "cuda.dll", "symbol": "cuInit",
     "convention": "cdecl", "params": ["i32"], "returns": "i32"},
    {"name": "cu_module_load", "dll": "cuda.dll", "symbol": "cuModuleLoadData",
     "convention": "cdecl", "params": ["i64", "i64"], "returns": "i32"},
    {"name": "cu_module_fn", "dll": "cuda.dll", "symbol": "cuModuleGetFunction",
     "convention": "cdecl", "params": ["i64", "i64", "i64"], "returns": "i32"},
    {"name": "cu_launch", "dll": "cuda.dll", "symbol": "cuLaunchKernel",
     "convention": "cdecl",
     "params": ["i64", "i32", "i32", "i32", "i32", "i32", "i32", "i32", "i64", "i64", "i64"],
     "returns": "i32"},
    {"name": "cuda_malloc", "dll": "cudart.dll", "symbol": "cudaMalloc",
     "convention": "cdecl", "params": ["i64", "i64"], "returns": "i32"},
    {"name": "cuda_h2d", "dll": "cudart.dll", "symbol": "cudaMemcpy",
     "convention": "cdecl", "params": ["i64", "i64", "i64", "i32"], "returns": "i32"},
    {"name": "cublas_create", "dll": "cublas.dll", "symbol": "cublasCreate_v2",
     "convention": "cdecl", "params": ["i64"], "returns": "i32"},
    {"name": "cublas_sgemm", "dll": "cublas.dll", "symbol": "cublasSgemm_v2",
     "convention": "cdecl",
     "params": ["i64", "i32", "i32", "i32", "i32", "i32", "i64", "i64", "i32",
                "i64", "i32", "i64", "i64", "i32"], "returns": "i32"},
]


def run() -> "i32":
    rc: "i32" = cu_init(0)
    if rc != 0:
        return 1
    hcell = alloc_bytes(8)
    rc = cublas_create(hcell)
    ch = read_i64(hcell, 0)
    T: "i32" = 4
    D: "i32" = 8
    sn: "i32" = T * T
    qn: "i32" = T * D
    sb: "i32" = sn * 4
    qb: "i32" = qn * 4
    hq = alloc_bytes(qb)
    hk = alloc_bytes(qb)
    hv = alloc_bytes(qb)
    hone = alloc_bytes(T * 4)
    i: "i32" = 0
    j: "i32" = 0
    while i < T:
        j = 0
        while j < D:
            w0: "i64" = write_f32(hq, (i + j * T) * 4, 1.0 + 0.1 * (i + j))
            w1: "i64" = write_f32(hk, (i + j * T) * 4, 0.5 + 0.05 * (i - j))
            w2: "i64" = write_f32(hv, (i + j * T) * 4, 0.2 + 0.03 * (i + j))
            j = j + 1
        w3: "i64" = write_f32(hone, i * 4, 1.0)
        i = i + 1
    cell = alloc_bytes(8)
    rc = cuda_malloc(cell, qb)
    dq = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dk = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    dv = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    ds = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    de = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    dp = read_i64(cell, 0)
    rc = cuda_malloc(cell, qb)
    do = read_i64(cell, 0)
    rc = cuda_malloc(cell, T * 4)
    done = read_i64(cell, 0)
    rc = cuda_malloc(cell, T * 4)
    drow = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    dinv = read_i64(cell, 0)
    rc = cuda_malloc(cell, sb)
    dzero = read_i64(cell, 0)
    w4: "i64" = cuda_h2d(dq, hq, qb, 1)
    w5: "i64" = cuda_h2d(dk, hk, qb, 1)
    w6: "i64" = cuda_h2d(dv, hv, qb, 1)
    w7: "i64" = cuda_h2d(done, hone, T * 4, 1)
    acell = alloc_bytes(4)
    w8: "i64" = write_f32(acell, 0, 1.0)
    bcell = alloc_bytes(4)
    w9: "i64" = write_f32(bcell, 0, 0.0)
    rc = cublas_sgemm(ch, 0, 1, T, T, D, acell, dq, T, dk, T, bcell, ds, T)
    if rc != 0:
        print("QK fail", rc)
        return 1
    # PREP = scale * mask * exp (da chay o M3)
    # @tkv.ptx_kernel name="prep_kernel" kind="prep" var="PTX"
    pb = alloc_bytes(len(PTX) + 1)
    kk: "i32" = 0
    while kk < len(PTX):
        wu: "i64" = write_u8(pb, kk, PTX[kk])
        kk = kk + 1
    wv: "i64" = write_u8(pb, kk, 0)
    mc = alloc_bytes(8)
    rc = cu_module_load(mc, pb)
    if rc != 0:
        print("PREP load fail", rc)
        return 1
    mo = read_i64(mc, 0)
    fb = alloc_bytes(len(FN))
    rf: "i32" = 0
    while rf < len(FN):
        ww: "i64" = write_u8(fb, rf, FN[rf])
        rf = rf + 1
    fc = alloc_bytes(8)
    rc = cu_module_fn(fc, mo, fb)
    if rc != 0:
        print("PREP fn fail", rc)
        return 1
    fn = read_i64(fc, 0)
    a0 = alloc_bytes(8)
    wa0: "i64" = write_i64(a0, 0, ds)
    a1 = alloc_bytes(8)
    wa1: "i64" = write_i64(a1, 0, de)
    a2 = alloc_bytes(4)
    wa2: "i64" = write_i32(a2, 0, sn)
    a3 = alloc_bytes(4)
    wa3: "i64" = write_i32(a3, 0, T)
    a4 = alloc_bytes(4)
    wa4: "i64" = write_f32(a4, 0, 0.35355339)
    par = alloc_bytes(40)
    wp0: "i64" = write_i64(par, 0, a0)
    wp1: "i64" = write_i64(par, 8, a1)
    wp2: "i64" = write_i64(par, 16, a2)
    wp3: "i64" = write_i64(par, 24, a3)
    wp4: "i64" = write_i64(par, 32, a4)
    rc = cu_launch(fn, 1, 1, 1, 64, 1, 1, 0, 0, par, 0)
    if rc != 0:
        print("PREP launch fail", rc)
        return 1
    # row sum = de * ones
    rc = cublas_sgemm(ch, 0, 0, T, 1, T, acell, de, T, done, T, bcell, drow, T)
    if rc != 0:
        print("rowsum fail", rc)
        return 1
    hr = alloc_bytes(T * 4)
    wz: "i64" = cuda_h2d(hr, drow, T * 4, 2)
    hinv = alloc_bytes(sb)
    hzero = alloc_bytes(sb)
    ii: "i32" = 0
    jj: "i32" = 0
    while ii < T:
        rv: "f32" = read_f32(hr, ii * 4)
        iv: "f32" = 1.0 / rv
        jj = 0
        while jj < T:
            wq0: "i64" = write_f32(hinv, (ii + jj * T) * 4, iv)
            wq1: "i64" = write_f32(hzero, (ii + jj * T) * 4, 0.0)
            jj = jj + 1
        ii = ii + 1
    wq2: "i64" = cuda_h2d(dinv, hinv, sb, 1)
    wq3: "i64" = cuda_h2d(dzero, hzero, sb, 1)
    # NORM kernel ( verified ) : y = (x-mean)*rstd*g + b
    # @tkv.ptx_kernel name="norm_kernel" kind="norm" var="PTX2"
    pb2 = alloc_bytes(len(PTX2) + 1)
    kk = 0
    while kk < len(PTX2):
        wu2: "i64" = write_u8(pb2, kk, PTX2[kk])
        kk = kk + 1
    wv2: "i64" = write_u8(pb2, kk, 0)
    mc2 = alloc_bytes(8)
    rc = cu_module_load(mc2, pb2)
    if rc != 0:
        print("NORM load fail", rc)
        return 1
    mo2 = read_i64(mc2, 0)
    fb2 = alloc_bytes(len(FN2))
    rf = 0
    while rf < len(FN2):
        ww2: "i64" = write_u8(fb2, rf, FN2[rf])
        rf = rf + 1
    fc2 = alloc_bytes(8)
    rc = cu_module_fn(fc2, mo2, fb2)
    if rc != 0:
        print("NORM fn fail", rc)
        return 1
    fn2 = read_i64(fc2, 0)
    b0 = alloc_bytes(8)
    wb0: "i64" = write_i64(b0, 0, de)
    b1 = alloc_bytes(8)
    wb1: "i64" = write_i64(b1, 0, dinv)
    b2 = alloc_bytes(8)
    wb2: "i64" = write_i64(b2, 0, dzero)
    b3 = alloc_bytes(8)
    wb3: "i64" = write_i64(b3, 0, dp)
    b4 = alloc_bytes(4)
    wb4: "i64" = write_i32(b4, 0, sn)
    b5 = alloc_bytes(4)
    wb5: "i64" = write_f32(b5, 0, 0.0)
    b6 = alloc_bytes(4)
    wb6: "i64" = write_f32(b6, 0, 1.0)
    npar = alloc_bytes(56)
    wn0: "i64" = write_i64(npar, 0, b0)
    wn1: "i64" = write_i64(npar, 8, b1)
    wn2: "i64" = write_i64(npar, 16, b2)
    wn3: "i64" = write_i64(npar, 24, b3)
    wn4: "i64" = write_i64(npar, 32, b4)
    wn5: "i64" = write_i64(npar, 40, b5)
    wn6: "i64" = write_i64(npar, 48, b6)
    rc = cu_launch(fn2, 1, 1, 1, 64, 1, 1, 0, 0, npar, 0)
    if rc != 0:
        print("NORM launch fail", rc)
        return 1
    rc = cublas_sgemm(ch, 0, 0, T, D, T, acell, dp, T, dv, T, bcell, do, T)
    if rc != 0:
        print("PV fail", rc)
        return 1
    ho = alloc_bytes(qb)
    wz2: "i64" = cuda_h2d(ho, do, qb, 2)
    i = 0
    while i < T:
        j = 0
        while j < D:
            ov: "f32" = read_f32(ho, (i + j * T) * 4)
            print("OUT", i, j, ov)
            j = j + 1
        i = i + 1
    print("BATCH DONE")
    return 0
