# -*- coding: utf-8 -*-
# BIT-EXACT theo tkv_linear_dw.c: accumulator bat dau = 0 (nhu _mm256_setzero_ps),
# chuoi FMA tu 0, ROI cong gdw cu O CUOI (_mm256_add_ps(load(d), b)).
# @tkv.cpu_kernel target="avx2"
def linear_dw_cpu(x: "ptr[f32]", gy: "ptr[f32]", gdw: "ptr[f32]", n: "i32", in_d: "i32", out_d: "i32") -> "void":
    for i in range(in_d):
        for c in range(out_d):
            acc = 0.0
            for p in range(n):
                acc = fma(x[p * in_d + i], gy[p * out_d + c], acc)
            gdw[i * out_d + c] = gdw[i * out_d + c] + acc


def run() -> "i32":
    return 0