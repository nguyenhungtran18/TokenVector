# -*- coding: utf-8 -*-
# IL-only GPU forward 2 layer (GEMM + fused bias/GELU) + host loss. Khong C++/torch.
__tkv_extern_pinvoke__ = [
    {"name": "cu_init", "dll": "cuda.dll", "symbol": "cuInit",
     "convention": "cdecl", "params": ["i32"], "returns": "i32"},
    {"name": "cu_module_load", "dll": "cuda.dll", "symbol": "cuModuleLoadData",
     "convention": "cdecl", "params": ["i64", "i64"], "returns": "i32"},
    {"name": "cu_module_fn", "dll": "cuda.dll", "symbol": "cuModuleGetFunction",
     "convention": "cdecl", "params": ["i64", "i64", "i64"], "returns": "i32"},
    {"name": "cu_launch", "dll": "cuda.dll", "symbol": "cuLaunchKernel",
     "convention": "cdecl",
     "params": ["i64", "i32", "i32", "i32", "i32", "i32", "i32", "i32", "i64", "i64", "i64"],
     "returns": "i32"},
    {"name": "cuda_malloc", "dll": "cudart.dll", "symbol": "cudaMalloc",
     "convention": "cdecl", "params": ["i64", "i64"], "returns": "i32"},
    {"name": "cuda_h2d", "dll": "cudart.dll", "symbol": "cudaMemcpy",
     "convention": "cdecl", "params": ["i64", "i64", "i64", "i32"], "returns": "i32"},
    {"name": "cublas_create", "dll": "cublas.dll", "symbol": "cublasCreate_v2",
     "convention": "cdecl", "params": ["i64"], "returns": "i32"},
    {"name": "cublas_sgemm", "dll": "cublas.dll", "symbol": "cublasSgemm_v2",
     "convention": "cdecl",
     "params": ["i64", "i32", "i32", "i32", "i32", "i32", "i64", "i64", "i32",
                "i64", "i32", "i64", "i64", "i32"], "returns": "i32"},
]


def run() -> "i32":
    rc: "i32" = cu_init(0)
    if rc != 0:
        print("CUINIT FAIL", rc)
        return 1
    hc = alloc_bytes(8)
    rc = cublas_create(hc)
    ch = read_i64(hc, 0)
    T: "i32" = 4
    D: "i32" = 8
    V: "i32" = 8
    td: "i32" = T * D
    dv: "i32" = D * V
    tb: "i32" = td * 4
    vb: "i32" = dv * 4
    hX = alloc_bytes(tb)
    hW1 = alloc_bytes(D * D * 4)
    hW2 = alloc_bytes(vb)
    hb1 = alloc_bytes(D * 4)
    hb2 = alloc_bytes(V * 4)
    hIds = alloc_bytes(T * 4)
    hLG = alloc_bytes(vb)
    ha = alloc_bytes(4)
    wa1: "i64" = write_f32(ha, 0, 1.0)
    hb = alloc_bytes(4)
    wb0: "i64" = write_f32(hb, 0, 0.0)
    i: "i32" = 0
    j: "i32" = 0
    while i < D:
        wb1x: "i64" = write_f32(hb1, i * 4, 0.1)
        i = i + 1
    i = 0
    while i < V:
        wb2: "i64" = write_f32(hb2, i * 4, 0.05)
        i = i + 1
    print("HB1A", read_f32(hb1, 0), read_f32(hb1, 4))
    i = 0
    while i < T:
        j = 0
        while j < D:
            wx: "i64" = write_f32(hX, (i + j * T) * 4, 0.1 + 0.02 * (i + j))
            j = j + 1
        idv: "i32" = (i + 1) % V
        wids: "i64" = write_i32(hIds, i * 4, idv)
        i = i + 1
    i = 0
    while i < D:
        j = 0
        while j < D:
            ww1: "i64" = write_f32(hW1, (i + j * D) * 4, 0.2 + 0.01 * (i + j))
            j = j + 1
        i = i + 1
    i = 0
    while i < D:
        j = 0
        while j < V:
            ww2: "i64" = write_f32(hW2, (i + j * D) * 4, 0.3 + 0.01 * (i + j))
            j = j + 1
        i = i + 1
    print("HB1B", read_f32(hb1, 0), read_f32(hb1, 4))
    print("HB2", read_f32(hb2, 0), read_f32(hb2, 4))
    print("HW1", read_f32(hW1, 0), read_f32(hW1, 4), read_f32(hW1, 56), read_f32(hW1, 60))
    cell = alloc_bytes(8)
    rc = cuda_malloc(cell, tb)
    dX = read_i64(cell, 0)
    rc = cuda_malloc(cell, D * D * 4)
    dW1 = read_i64(cell, 0)
    rc = cuda_malloc(cell, tb)
    dZ = read_i64(cell, 0)
    rc = cuda_malloc(cell, tb)
    dH = read_i64(cell, 0)
    rc = cuda_malloc(cell, vb)
    dW2 = read_i64(cell, 0)
    rc = cuda_malloc(cell, vb)
    dLG = read_i64(cell, 0)
    rc = cuda_malloc(cell, D * 4)
    db1 = read_i64(cell, 0)
    rc = cuda_malloc(cell, V * 4)
    db2 = read_i64(cell, 0)
    wa: "i64" = cuda_h2d(dX, hX, tb, 1)
    wb: "i64" = cuda_h2d(dW1, hW1, D * D * 4, 1)
    wc: "i64" = cuda_h2d(dW2, hW2, vb, 1)
    wd: "i64" = cuda_h2d(db1, hb1, D * 4, 1)
    we: "i64" = cuda_h2d(db2, hb2, V * 4, 1)
    print("HB1", read_f32(hb1, 0), read_f32(hb1, 4))
    print("WD", wd, we)
    wd2: "i64" = cuda_h2d(hLG, db1, D * 4, 2)
    print("DB1", read_f32(hLG, 0), read_f32(hLG, 4), read_f32(hLG, 8))
    wd3: "i64" = cuda_h2d(hLG, dX, tb, 2)
    print("DX", read_f32(hLG, 0), read_f32(hLG, 4))
    # Z = X @ W1
    rc = cublas_sgemm(ch, 0, 0, T, D, D, ha, dX, T, dW1, D, hb, dZ, T)
    if rc != 0:
        print("GEMM1 FAIL", rc)
        return 1
    # fused kernel 1: H = gelu(Z + b1), bias doc theo cot
    PTXA = b".version 8.0\n.target sm_75\n.address_size 64\n.entry biasgelu_kernel(.param .u64 px, .param .u64 pb, .param .u64 py)\n{\n.reg .f32 f1,f2,f3,f4,f5,fb;\n.reg .u64 xp,bp,yp,off,offb;\n.reg .u32 col,row,idx,nt;\n.reg .pred q;\nld.param.u64 xp,[px];\nld.param.u64 bp,[pb];\nld.param.u64 yp,[py];\nmov.u32 col,%ctaid.x;\nmov.u32 row,%tid.x;\nmov.u32 nt,%ntid.x;\nsetp.ge.u32 q,row,nt;\n@q bra LEND;\nmul.lo.u32 idx,col,nt;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nmul.wide.u32 offb,col,4;\ncvta.to.global.u64 xp,xp;\ncvta.to.global.u64 bp,bp;\ncvta.to.global.u64 yp,yp;\nadd.u64 xp,xp,off;\nadd.u64 yp,yp,off;\nadd.u64 bp,bp,offb;\nld.global.f32 f1,[xp];\nld.global.f32 fb,[bp];\nadd.f32 f1,f1,fb;\nmul.f32 f3,f1,f1;\nmul.f32 f3,f3,f1;\nmov.f32 f4,0.044715;\nfma.rn.f32 f3,f3,f4,f1;\nmov.f32 f4,0.79788456;\nmul.f32 f2,f3,f4;\ntanh.approx.f32 f2,f2;\nmov.f32 f3,1.0;\nadd.f32 f2,f2,f3;\nmov.f32 f3,0.5;\nmul.f32 f2,f2,f3;\nmul.f32 f5,f1,f2;\nst.global.f32 [yp],f5;\nLEND: ret;\n}\n"
    FNA = b"biasgelu_kernel\x00"
    pa = alloc_bytes(len(PTXA) + 1)
    ka = 0
    while ka < len(PTXA):
        wua: "i64" = write_u8(pa, ka, PTXA[ka])
        ka = ka + 1
    wza: "i64" = write_u8(pa, ka, 0)
    ma = alloc_bytes(8)
    rc = cu_module_load(ma, pa)
    if rc != 0:
        print("BIASGELU LOAD FAIL", rc)
        return 1
    oa = read_i64(ma, 0)
    fa = alloc_bytes(len(FNA))
    ra = 0
    while ra < len(FNA):
        wfa: "i64" = write_u8(fa, ra, FNA[ra])
        ra = ra + 1
    ca = alloc_bytes(8)
    rc = cu_module_fn(ca, oa, fa)
    if rc != 0:
        print("BIASGELU FN FAIL", rc)
        return 1
    fna = read_i64(ca, 0)
    a0 = alloc_bytes(8)
    wa0: "i64" = write_i64(a0, 0, dZ)
    a1 = alloc_bytes(8)
    wa2: "i64" = write_i64(a1, 0, db1)
    a2 = alloc_bytes(8)
    wa3: "i64" = write_i64(a2, 0, dH)
    par = alloc_bytes(24)
    wa4: "i64" = write_i64(par, 0, a0)
    wa5: "i64" = write_i64(par, 8, a1)
    wa6: "i64" = write_i64(par, 16, a2)
    rc = cu_launch(fna, D, 1, 1, T, 1, 1, 0, 0, par, 0)
    if rc != 0:
        print("BIASGELU LAUNCH FAIL", rc)
        return 1
    # diag: Z truoc bias, H sau bias+gelu
    wzdiag: "i64" = cuda_h2d(hLG, dZ, tb, 2)
    dz: "i32" = 0
    while dz < 4:
        zv: "f32" = read_f32(hLG, dz * 4)
        print("Z", dz, zv)
        dz = dz + 1
    whdiag: "i64" = cuda_h2d(hLG, dH, tb, 2)
    dh2: "i32" = 0
    while dh2 < 4:
        hv2: "f32" = read_f32(hLG, dh2 * 4)
        print("H", dh2, hv2)
        dh2 = dh2 + 1
    # LG = H @ W2
    rc = cublas_sgemm(ch, 0, 0, T, V, D, ha, dH, T, dW2, D, hb, dLG, T)
    if rc != 0:
        print("GEMM2 FAIL", rc)
        return 1
    # fused kernel 2: LG = LG + b2, bias doc theo cot
    PTXB = b".version 8.0\n.target sm_75\n.address_size 64\n.entry biasadd_kernel(.param .u64 px, .param .u64 pb, .param .u64 py)\n{\n.reg .f32 f1,fb,f3;\n.reg .u64 xp,bp,yp,off,offb;\n.reg .u32 col,row,idx,nt;\n.reg .pred q;\nld.param.u64 xp,[px];\nld.param.u64 bp,[pb];\nld.param.u64 yp,[py];\nmov.u32 col,%ctaid.x;\nmov.u32 row,%tid.x;\nmov.u32 nt,%ntid.x;\nsetp.ge.u32 q,row,nt;\n@q bra LEND;\nmul.lo.u32 idx,col,nt;\nadd.u32 idx,idx,row;\nmul.wide.u32 off,idx,4;\nmul.wide.u32 offb,col,4;\ncvta.to.global.u64 xp,xp;\ncvta.to.global.u64 bp,bp;\ncvta.to.global.u64 yp,yp;\nadd.u64 xp,xp,off;\nadd.u64 yp,yp,off;\nadd.u64 bp,bp,offb;\nld.global.f32 f1,[xp];\nld.global.f32 fb,[bp];\nadd.f32 f3,f1,fb;\nst.global.f32 [yp],f3;\nLEND: ret;\n}\n"
    FNB = b"biasadd_kernel\x00"
    pb = alloc_bytes(len(PTXB) + 1)
    kb = 0
    while kb < len(PTXB):
        wub: "i64" = write_u8(pb, kb, PTXB[kb])
        kb = kb + 1
    wzb: "i64" = write_u8(pb, kb, 0)
    mb = alloc_bytes(8)
    rc = cu_module_load(mb, pb)
    if rc != 0:
        print("BIASADD LOAD FAIL", rc)
        return 1
    ob = read_i64(mb, 0)
    fb2 = alloc_bytes(len(FNB))
    rb = 0
    while rb < len(FNB):
        wfb: "i64" = write_u8(fb2, rb, FNB[rb])
        rb = rb + 1
    cb = alloc_bytes(8)
    rc = cu_module_fn(cb, ob, fb2)
    if rc != 0:
        print("BIASADD FN FAIL", rc)
        return 1
    fnb = read_i64(cb, 0)
    b0 = alloc_bytes(8)
    wb0b: "i64" = write_i64(b0, 0, dLG)
    b1p = alloc_bytes(8)
    wb1p: "i64" = write_i64(b1p, 0, db2)
    b2p = alloc_bytes(8)
    wb2p: "i64" = write_i64(b2p, 0, dLG)
    parb = alloc_bytes(24)
    wb3: "i64" = write_i64(parb, 0, b0)
    wb4: "i64" = write_i64(parb, 8, b1p)
    wb5: "i64" = write_i64(parb, 16, b2p)
    rc = cu_launch(fnb, V, 1, 1, T, 1, 1, 0, 0, parb, 0)
    if rc != 0:
        print("BIASADD LAUNCH FAIL", rc)
        return 1
    wr: "i64" = cuda_h2d(hLG, dLG, vb, 2)
    dl2: "i32" = 0
    while dl2 < 4:
        lgv: "f32" = read_f32(hLG, dl2 * 4)
        print("LG", dl2, lgv)
        dl2 = dl2 + 1
    # loss on host
    loss: "f32" = 0.0
    i = 0
    while i < T:
        mx: "f32" = -1000000000.0
        j = 0
        while j < V:
            lv: "f32" = read_f32(hLG, (i + j * T) * 4)
            if lv > mx:
                mx = lv
            j = j + 1
        zsum: "f32" = 0.0
        j = 0
        while j < V:
            lv = read_f32(hLG, (i + j * T) * 4)
            ev: "f32" = exp(lv - mx)
            zsum = zsum + ev
            j = j + 1
        idv2: "i32" = read_i32(hIds, i * 4)
        lv2: "f32" = read_f32(hLG, (i + idv2 * T) * 4)
        ev2: "f32" = exp(lv2 - mx)
        loss = loss - log(ev2 / zsum)
        i = i + 1
    loss = loss / 4.0
    print("LOSS", loss)
    print("BATCH DONE")
    return 0
