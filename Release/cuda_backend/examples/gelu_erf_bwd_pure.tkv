# -*- coding: utf-8 -*-
# GeluErfBwd THUAN TOKENVECTOR (thay auto-glue C).
# AVX2: gelu_bwd_one (erf f32 + custom exp) * gy NHAN F32.
# Tail: gelu_b_one (arg = f64 div -> f32, poly f64, exp double) * gy NHAN F64 -> f32.
# @tkv.cpu_kernel target="avx2"
def GeluErfBwd(x: "ptr[f32]", x_len: "i32", gy: "ptr[f32]", gy_len: "i32", out: "ptr[f32]", out_len: "i32", lo: "i64", hi: "i64") -> "i32":
    n8 = (hi - lo) // 8 % 1000000
    for k in range(n8):
        base = lo + k * 8
        for lane in range(8):
            f_v = x[base + lane]
            f_arg = f_v * 0.70710678118654752f
            f_sg = 1.0f
            if f_arg < 0.0f:
                f_sg = -1.0f
            f_ax = tkv_fabs(f_arg)
            f_ax = tkv_fmax(f_ax, 0.0f)
            f_t = 1.0f / fma(0.3275911f, f_ax, 1.0f)
            f_p = 1.061405429f
            f_p = fma(f_p, f_t, -1.453152027f)
            f_p = fma(f_p, f_t, 1.421413741f)
            f_p = fma(f_p, f_t, -0.284496736f)
            f_p = fma(f_p, f_t, 0.254829592f)
            f_p = fma(f_p, f_t, 0.0f)
            f_ax2 = f_ax * f_ax
            f_neg2 = f_ax2 * -1.0f
            f_neg2 = tkv_fmax(f_neg2, -90.0f)
            f_kf = tkv_rint(f_neg2 * 1.4426950408889634f)
            f_r = fma(-f_kf, 0.6931471805599453f, f_neg2)
            f_ep = 2.48015873e-05f
            f_ep = fma(f_ep, f_r, 1.98412698e-04f)
            f_ep = fma(f_ep, f_r, 1.38888889e-03f)
            f_ep = fma(f_ep, f_r, 8.33333333e-03f)
            f_ep = fma(f_ep, f_r, 4.16666667e-02f)
            f_ep = fma(f_ep, f_r, 1.66666667e-01f)
            f_ep = fma(f_ep, f_r, 5.00000000e-01f)
            f_ep = fma(f_ep, f_r, 1.00000000e+00f)
            f_ep = fma(f_ep, f_r, 1.00000000e+00f)
            f_pow = tkv_ldexp(1.0f, f_kf)
            f_e = f_ep * f_pow
            f_erf = fma(-f_e, f_p, 1.0f)
            f_erf = f_sg * f_erf
            f_d = (1.0f + f_erf) * 0.5f
            f_v2 = f_v * f_v
            f_neg = f_v2 * -0.5f
            f_neg = tkv_fmax(f_neg, -90.0f)
            f_k2 = tkv_rint(f_neg * 1.4426950408889634f)
            f_r2 = fma(-f_k2, 0.6931471805599453f, f_neg)
            f_e2p = 2.48015873e-05f
            f_e2p = fma(f_e2p, f_r2, 1.98412698e-04f)
            f_e2p = fma(f_e2p, f_r2, 1.38888889e-03f)
            f_e2p = fma(f_e2p, f_r2, 8.33333333e-03f)
            f_e2p = fma(f_e2p, f_r2, 4.16666667e-02f)
            f_e2p = fma(f_e2p, f_r2, 1.66666667e-01f)
            f_e2p = fma(f_e2p, f_r2, 5.00000000e-01f)
            f_e2p = fma(f_e2p, f_r2, 1.00000000e+00f)
            f_e2p = fma(f_e2p, f_r2, 1.00000000e+00f)
            f_pow2 = tkv_ldexp(1.0f, f_k2)
            f_e2 = f_e2p * f_pow2
            f_d = fma(f_v * 0.3989422804014327f, f_e2, f_d)
            f_gy = gy[base + lane]
            out[base + lane - lo] = f_d * f_gy
    nt = (hi - lo - n8 * 8) % 1000000
    for j in range(nt):
        i = (lo + n8 * 8 + j) % 1000000000
        t_v = x[i]
        d_arg = t_v / 1.4142135623730951
        t_arg = d_arg
        d_sg = 1.0
        if t_arg < 0.0:
            d_sg = -1.0
        t_ax = tkv_fabs(t_arg)
        d_t = 1.0 / (1.0 + 0.3275911 * t_ax)
        d_poly = 1.061405429
        d_poly = d_poly * d_t + -1.453152027
        d_poly = d_poly * d_t + 1.421413741
        d_poly = d_poly * d_t + -0.284496736
        d_poly = d_poly * d_t + 0.254829592
        d_poly = d_poly * d_t
        t_nax2 = (-t_ax) * t_ax
        t_e = d_exp(t_nax2)
        d_ef = d_sg * (1.0 - t_e * d_poly)
        t_ef = d_ef
        d_v = t_v
        d_vv = (-0.5) * d_v
        d_neg = d_vv * d_v
        d_e2 = d_exp(d_neg)
        d_res_d = 0.5 * (1.0 + t_ef) + (d_v * 0.3989422804014327) * d_e2
        t_res = d_res_d
        d_gy = gy[i]
        d_res = d_gy * t_res
        out[i - lo] = d_res


def run() -> "i32":
    return 0