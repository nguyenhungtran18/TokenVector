<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>TokenVector</id>
    <version>1.0.11</version>
    <title>TokenVector Compiler Platform</title>
    <authors>Nguyen Hung Tran, TokenVector Compiler Engineering Team</authors>
    <owners>nguyenhungtran18</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/nguyenhungtran18/TokenVector</projectUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <description>TokenVector Compiler Platform - High-performance ahead-of-time (AOT) compiler with Pythonic syntax and native .NET/CIL backend, zero Python runtime dependency, and no-GIL multithreading.</description>
    <summary>TokenVector AOT compiler tool for Pythonic syntax to native PE/CIL executables with full .NET interop.</summary>
    <releaseNotes>Release 1.0.11 - Self-hosted TokenVector AOT compiler (tkvc-tv.exe) with f32x4 Vector4 SIMD, P6 auto-vectorization over f32buf, and simd_gemm (AVX2+FMA native kernel) for f32/f64 matrix multiplication, no CPython dependency.</releaseNotes>
    <copyright>Copyright (c) 2026 Nguyen Hung Tran</copyright>
    <tags>tokenvector compiler python dotnet cil aot no-gil high-performance native roslyn msbuild cli</tags>
    <repository type="git" url="https://github.com/nguyenhungtran18/TokenVector" />
  </metadata>
  <files>
    <file src="..\README.md" target="README.md" />
    <file src="..\LICENSE" target="LICENSE" />
    <!-- Icon = logo TokenVector, ban 128x128 (khuyen nghi cua NuGet). Ban goc
         512x512 nam o assets\preview.png - giu nguyen, khong doi. -->
    <file src="..\assets\icon.png" target="icon.png" />
    <file src="..\dist\tkvc-tv.exe" target="tools\tkvc-tv.exe" />
    <!-- Ban DLL cua chinh compiler (bien dich tu nguon tự-host). Cho .NET project
         tham chieu nhu thu vien; nguoi dung cu van dung tkvc-tv.exe. -->
    <file src="..\build\tkvc-tv.dll" target="tools\tkvc-tv.dll" />
    <!-- Runtime DLLs the compiler copies next to the generated .exe
         (_sao_mot_dll looks at <compiler dir>\runtime\<name>). Without these,
         programs using f32x4 / simd_gemm compile but fail at run time. -->
    <file src="..\runtime\System.Numerics.Vectors.dll" target="tools\runtime\" />
    <file src="..\runtime\tkv_simd_native.dll" target="tools\runtime\" />
    <file src="..\dist\il_features\*.tkv" target="tools\il_features\" />
    <file src="build\**\*" target="build\" />
  </files>
</package>
