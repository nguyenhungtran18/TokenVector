# Diem vao cua trinh bien dich TU-HOST (2026-09-25): `tkvc <nguon.tkv> <ra.exe>
# [ten_ham_vao]` hoac `tkvc @ds.txt` (hang loat). Gop SAU ban gop 117 file (xem _scratch/dung_tv.py) - khong
# nam trong cay .py vi CPython da co tkv.py (argparse/pathlib) lam CLI.


def dich_mot(nguon: "str", ra: "str", vao: "str", verify_all: "i32" = 0) -> "i32":
    """Dich mot nguon; in ket qua. Tra 0 neu dich duoc, 1 neu loi (khong nem ngoai le ra ngoai)."""
    try:
        ra_exe = compile_tkv_cli(nguon, ra, vao, verify_all=verify_all)
        print("[tkvc] da dich: " + ra_exe)
        return 0
    except CliError as e:
        print("[tkvc] loi: " + nguon + ": " + str(e))
        return 1
    except TranspileError as e:
        print("[tkvc] loi dich: " + nguon + ": " + str(e))
        return 1
    except Exception as e:
        print("[tkvc] loi: " + nguon + ": " + str(e))
        return 1


def dich_lo(duong_ds: "str") -> "i32":
    """Che do HANG LOAT: `tkvc @ds.txt` - moi dong 'nguon<TAB>ra.exe<TAB>ten_ham_vao' (cot 3 co the vang).
    Dich lan luot trong MOT tien trinh (khoi dong trinh bien dich chi tra 1 lan). Tra so nguon loi."""
    loi = 0
    for dong in read_file(duong_ds).replace(chr(13), "").split(chr(10)):
        if dong.strip() == "":
            continue
        f = dong.split(chr(9))
        if len(f) < 2:
            print("[tkvc] dong sai dinh dang: " + dong)
            loi = loi + 1
            continue
        vao = None
        if len(f) >= 3 and f[2] != "":
            vao = f[2]
        loi = loi + dich_mot(f[0], f[1], vao)
    return loi


def main() -> "i32":
    ds = sys_argv()
    verify_all = 0
    i = 1
    while i < len(ds):
        if ds[i] == "--verify-all":
            verify_all = 1
        elif ds[i].startswith("@"):
            arg1 = ds[i]
            so_loi = dich_lo(arg1[1:])
            if so_loi > 0:
                return 1
            return 0
        i = i + 1
    if len(ds) < 3:
        print("dung: tkvc <nguon.tkv> <ra.exe> [ten_ham_vao]  [--verify-all]  |  tkvc @ds.txt")
        return 2
    vao = None
    for a in ds:
        if not a.startswith("--") and not a.startswith("@"):
            if vao is None:
                vao = a
            elif isinstance(vao, str) and vao != a:
                pass
    # Lay 2 tham so dau tien khong co dau --
    pos = [a for a in ds[1:] if not a.startswith("--")]
    if len(pos) < 2:
        print("dung: tkvc <nguon.tkv> <ra.exe> [ten_ham_vao]  [--verify-all]  |  tkvc @ds.txt")
        return 2
    ten_vao = pos[2] if len(pos) >= 3 else None
    return dich_mot(pos[0], pos[1], ten_vao, verify_all=verify_all)
