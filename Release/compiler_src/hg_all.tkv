        ra("    bge TDI" + str(i) + "E")
        ra("    ldarg.0")
        ra("    ldloc.1")
        ra("    callvirt instance !0 " + dsc + "::get_Item(int32)")
        ra("    stloc.2")
        ra("    ldloc.0")
        ra("    ldloc.2")
        ra("    ldfld " + il_kieu(kk) + " " + lop + "::I0")
        ra("    ldloc.2")
        ra("    ldfld " + il_kieu(vv) + " " + lop + "::I1")
        ra("    callvirt instance void " + d + "::set_Item(!0, !1)")
        ra("    ldloc.1")
        ra("    ldc.i4.1")
        ra("    add")
        ra("    stloc.1")
        ra("    br TDI" + str(i) + "L")
        ra("  TDI" + str(i) + "E:")
        ra("    ldloc.0")
        ra("    ret")
        ra("  }")
        ra("")
        i = i + 1
    return TDI_N


