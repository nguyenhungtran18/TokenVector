IN_DS: "list[str]" = []
IN_N: "i32" = 0


def in_ky(t: "str") -> "str":
    """Dang ky mot kieu CHUA cho phep `x in ...`, tra ve ten method se phat.

    Truoc day `in` goi bon helper VIET CUNG (`__in_dict` chi nhan
    `dict[str,str]`, `__in_ds_i32` chi nhan `list[i32]`...), nen `x in d`
    voi mot tu dien kieu khac DICH SACH roi nem MissingMethodException luc
    chay. Phat MOT method cho MOI kieu that su dung, giong `__dget`."""
    global IN_DS
    global IN_N
    i = 0
    while i < IN_N:
        if IN_DS[i] == t:
            return "__in" + str(i)
        i = i + 1
    if IN_N == len(IN_DS):
        IN_DS.append(t)
    else:
        IN_DS[IN_N] = t
    IN_N = IN_N + 1
    return "__in" + str(IN_N - 1)


# Kieu phan tu dung de so thanh vien voi mot LOP (2026-09-25): lop tuple ->
# kieu truong I0; lop co __contains__ -> kieu tham so cua no; "" neu khong.
def kieu_in_lop(t: "str") -> "str":
    if tim_lop(t) < 0:
        return ""
    if bat_dau_bang(t, "Tup") == 1:
        ti = tim_truong(t, "I0")
        if ti >= 0:
            return CF_KIEU[ti]
        return ""
    mi = tim_met(t, "__contains__")
    if mi >= 0 and CM_PSO[mi] >= 1:
        return PAR_KIEU[CM_PDAU[mi]]
    return ""


def phat_cac_in() -> "i32":
    global IN_DS
    global IN_N
    i = 0
    while i < IN_N:
        t = IN_DS[i]
        d = il_kieu(t)
        if tim_lop(t) >= 0:
            kpt = kieu_in_lop(t)
        else:
            kpt = kieu_pt(t)
            if la_dict(t) == 1:
                kpt = cat_hai(ruot(t), 1)
        ra("  .method public static int32 __in" + str(i) + "(" + il_kieu(kpt) + " a, " + d + " b) cil managed")
        ra("  {")
        ra("    .maxstack 64")
        if tim_lop(t) >= 0 and bat_dau_bang(t, "Tup") == 1:
            # Tuple: so voi TUNG truong I<j>.
            j = 0
            while tim_truong(t, "I" + str(j)) >= 0:
                kj = CF_KIEU[tim_truong(t, "I" + str(j))]
                ra("    ldarg.1")
                ra("    ldfld " + il_kieu(kj) + " " + t + "::I" + str(j))
                ra("    ldarg.0")
                if kj == "str":
                    ra("    call bool [mscorlib]System.String::op_Equality(string, string)")
                else:
                    ra("    ceq")
                ra("    brtrue INT" + str(i))
                j = j + 1
            ra("    ldc.i4.0")
            ra("    ret")
            ra("  INT" + str(i) + ":")
            ra("    ldc.i4.1")
            ra("    ret")
            ra("  }")
            ra("")
            i = i + 1
            continue
        if la_dict(t) == 1 and la_so_hoac_bool(kpt) == 0 and kpt != "i64" and kpt != "f64":
            # 'None in d' la False trong Python; ContainsKey(null) cua .NET NEM
            # ArgumentNullException (2026-09-25).
            ra("    ldarg.0")
            ra("    brtrue INK" + str(i))
            ra("    ldc.i4.0")
            ra("    ret")
            ra("  INK" + str(i) + ":")
        ra("    ldarg.1")
        ra("    ldarg.0")
        if tim_lop(t) >= 0:
            ra("    callvirt instance int32 " + t + "::__contains__(" + il_kieu(kpt) + ")")
        elif la_dict(t) == 1:
            ra("    callvirt instance bool " + d + "::ContainsKey(!0)")
        else:
            ra("    callvirt instance bool " + d + "::Contains(!0)")
        ra("    ret")
        ra("  }")
        ra("")
        i = i + 1
    return IN_N


