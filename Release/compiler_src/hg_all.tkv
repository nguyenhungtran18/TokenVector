def phat_cac_zip() -> "i32":
    global ZIP_DS
    global ZIP_N
    global CF_KIEU
    i = 0
    while i < ZIP_N:
        t = ZIP_DS[i]
        lop = kieu_pt(t)
        ka = CF_KIEU[tim_truong(lop, "I0")]
        kb = CF_KIEU[tim_truong(lop, "I1")]
        dra = il_kieu("list[" + ka + "]")
        drb = il_kieu("list[" + kb + "]")
        dr = il_kieu(t)
        ra("  .method public static " + dr + " __zip" + str(i) + "(" + dra + " a, " + drb + " b) cil managed")
        ra("  {")
        ra("    .maxstack 64")
        ra("    .locals init (" + dr + " r, int32 j, int32 n)")
        ra("    newobj instance void " + dr + "::.ctor()")
        ra("    stloc.0")
        ra("    ldarg.0")
        ra("    callvirt instance int32 " + dra + "::get_Count()")
        ra("    stloc.2")
        ra("    ldarg.1")
        ra("    callvirt instance int32 " + drb + "::get_Count()")
        ra("    ldloc.2")
        ra("    bge ZIP" + str(i) + "K")
        ra("    ldarg.1")
        ra("    callvirt instance int32 " + drb + "::get_Count()")
        ra("    stloc.2")
        ra("  ZIP" + str(i) + "K:")
        ra("    ldc.i4.0")
        ra("    stloc.1")
        ra("  ZIP" + str(i) + "L:")
        ra("    ldloc.1")
        ra("    ldloc.2")
        ra("    bge ZIP" + str(i) + "E")
        ra("    ldloc.0")
        ra("    ldarg.0")
        ra("    ldloc.1")
        ra("    callvirt instance !0 " + dra + "::get_Item(int32)")
        ra("    ldarg.1")
        ra("    ldloc.1")
        ra("    callvirt instance !0 " + drb + "::get_Item(int32)")
        ra("    newobj instance void " + lop + "::.ctor(" + il_kieu(ka) + ", " + il_kieu(kb) + ")")
        ra("    callvirt instance void " + dr + "::Add(!0)")
        ra("    ldloc.1")
        ra("    ldc.i4.1")
        ra("    add")
        ra("    stloc.1")
        ra("    br ZIP" + str(i) + "L")
        ra("  ZIP" + str(i) + "E:")
        ra("    ldloc.0")
        ra("    ret")
        ra("  }")
        ra("")
        i = i + 1
    return ZIP_N


