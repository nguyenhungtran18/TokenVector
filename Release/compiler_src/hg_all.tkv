# f64 -> chuoi theo LUAT PYTHON: luon co phan thap phan. Convert.ToString
# cho 3.0 ra "3", ma Python (va trinh bien dich THAT) cho '3.0' - mot cho
# hai ben BAT DONG, dong lai o day. Neu chuoi da co '.'/'E'/chu (Infinity,
# NaN) thi giu nguyen.
def phat_ho_tro_f64_str() -> "i32":
    ra("  .method public static string __f64_str(float64 x) cil managed")
    ra("  {")
    ra("    .maxstack 64")
    ra("    .locals init (string s, int32 i)")
    ra("    ldarga.s 0")
    ra("    ldstr \"R\"")
    ra("    call class [mscorlib]System.Globalization.CultureInfo [mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()")
    ra("    call instance string [mscorlib]System.Double::ToString(string, class [mscorlib]System.IFormatProvider)")
    ra("    stloc.s 0")
    ra("    ldc.i4.0")
    ra("    stloc.s 1")
    # Tim DAU HIEU da co phan thap phan: '.' hoac 'E'/'e' (dang mu) hoac
    # 'N'/'I' (NaN/Infinity). Quet theo dau hieu chu khong theo chu so, vi
    # '-' cua so am KHONG phai chu so ma van phai duoc them ".0".
    ra("  FS_L:")
    ra("    ldloc.s 1")
    ra("    ldloc.s 0")
    ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
    ra("    clt")
    ra("    brfalse FS_ADD")
    ra("    ldloc.s 0")
    ra("    ldloc.s 1")
    ra("    callvirt instance char [mscorlib]System.String::get_Chars(int32)")
    ra("    ldc.i4 46")
    ra("    beq FS_RET")
    ra("    ldloc.s 0")
    ra("    ldloc.s 1")
    ra("    callvirt instance char [mscorlib]System.String::get_Chars(int32)")
    ra("    ldc.i4 69")
    ra("    beq FS_RET")
    ra("    ldloc.s 0")
    ra("    ldloc.s 1")
    ra("    callvirt instance char [mscorlib]System.String::get_Chars(int32)")
    ra("    ldc.i4 101")
    ra("    beq FS_RET")
    ra("    ldloc.s 0")
    ra("    ldloc.s 1")
    ra("    callvirt instance char [mscorlib]System.String::get_Chars(int32)")
    ra("    ldc.i4 78")
    ra("    beq FS_RET")
    ra("    ldloc.s 0")
    ra("    ldloc.s 1")
    ra("    callvirt instance char [mscorlib]System.String::get_Chars(int32)")
    ra("    ldc.i4 73")
    ra("    beq FS_RET")
    ra("    ldloc.s 1")
    ra("    ldc.i4.1")
    ra("    add")
    ra("    stloc.s 1")
    ra("    br FS_L")
    ra("  FS_ADD:")
    ra("    ldloc.s 0")
    ra("    ldstr \".0\"")
    ra("    call string [mscorlib]System.String::Concat(string, string)")
    ra("    ret")
    ra("  FS_RET:")
    ra("    ldloc.s 0")
    ra("    ret")
    ra("  }")
    ra("")
    return 1


