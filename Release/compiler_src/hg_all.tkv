# s.count(sub) cho CHUOI - dem KHONG CHONG LAP, giong Python that va
# giong trinh bien dich THAT (stdlib_string_count.py): vong IndexOf, moi
# lan tim thay thi nhay qua CA DO DAI sub truoc khi tim tiep.
#
# KHAC trinh bien dich that MOT diem, CO Y: `sub` RONG. Ben do ghi ro la
# se LAP VO HAN (IndexOf tra lai chinh vi tri cu, khong tien len) va chap
# nhan gioi han do. Treo may khong bao gio la hanh vi dung, nen o day tra
# len(s) + 1 - dung dap an cua Python. Mot chuong trinh dua vao dieu nay
# se TREO khi dich bang trinh bien dich that; do la khuyet tat CUA BEN DO,
# da ghi lai de va sau.
def phat_ho_tro_str_count() -> "i32":
    # CHU Y: KHONG dat ten tham so la `sub` - do la TU KHOA IL (opcode tru),
    # ilasm bao "syntax error at token 'sub'". Da dinh dung mot lan.
    ra("  .method public static int32 __str_count(string s, string t) cil managed")
    ra("  {")
    ra("    .maxstack 64")
    ra("    .locals init (int32 cnt, int32 idx, int32 f, int32 n)")
    ra("    ldarg.1")
    ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
    ra("    stloc.s 3")
    ra("    ldloc.s 3")
    ra("    brtrue SC_BD")
    ra("    ldarg.0")
    ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
    ra("    ldc.i4.1")
    ra("    add")
    ra("    ret")
    ra("  SC_BD:")
    ra("    ldc.i4.0")
    ra("    stloc.s 0")
    ra("    ldc.i4.0")
    ra("    stloc.s 1")
    ra("  SC_L:")
    ra("    ldloc.s 1")
    ra("    ldarg.0")
    ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
    ra("    cgt")
    ra("    brtrue SC_RET")
    ra("    ldarg.0")
    ra("    ldarg.1")
    ra("    ldloc.s 1")
    ra("    callvirt instance int32 [mscorlib]System.String::IndexOf(string, int32)")
    ra("    stloc.s 2")
    ra("    ldloc.s 2")
    ra("    ldc.i4.0")
    ra("    clt")
    ra("    brtrue SC_RET")
    ra("    ldloc.s 0")
    ra("    ldc.i4.1")
    ra("    add")
    ra("    stloc.s 0")
    ra("    ldloc.s 2")
    ra("    ldloc.s 3")
    ra("    add")
    ra("    stloc.s 1")
    ra("    br SC_L")
    ra("  SC_RET:")
    ra("    ldloc.s 0")
    ra("    ret")
    ra("  }")
    ra("")
    return 1


def phat_ho_tro_that() -> "i32":
    """__that(o): chan ly Python cua mot THAM CHIEU - None sai, chuoi rong sai,
    tap/danh sach/tu dien RONG sai (qua IEnumerable.MoveNext: HashSet<T> khong
    co ICollection khong generic), con lai dung."""
    ra("  .method public static bool __that(object o) cil managed")
    ra("  {")
    ra("    .maxstack 64")
    ra("    ldarg.0")
    ra("    brfalse THF")
    ra("    ldarg.0")
    ra("    isinst [mscorlib]System.String")
    ra("    brfalse THE")
    ra("    ldarg.0")
    ra("    castclass [mscorlib]System.String")
    ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
    ra("    ldc.i4.0")
    ra("    cgt")
    ra("    ret")
    ra("  THE:")
    ra("    ldarg.0")
    ra("    isinst [mscorlib]System.Collections.IEnumerable")
    ra("    brfalse THT")
    ra("    ldarg.0")
    ra("    castclass [mscorlib]System.Collections.IEnumerable")
    ra("    callvirt instance class [mscorlib]System.Collections.IEnumerator [mscorlib]System.Collections.IEnumerable::GetEnumerator()")
    ra("    callvirt instance bool [mscorlib]System.Collections.IEnumerator::MoveNext()")
    ra("    ret")
    ra("  THT:")
    ra("    ldc.i4.1")
    ra("    ret")
    ra("  THF:")
    ra("    ldc.i4.0")
    ra("    ret")
    ra("  }")
    ra("")
    return 1


def phat_ho_tro() -> "i32":
    phat_ho_tro_that()
