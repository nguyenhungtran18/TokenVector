# a[i] hoac a[i:j]. Con tro dang o ngay sau '['; 'goc' la kieu cua a (da nap).
# Dau ':' o do sau 1 trong khoang (tu, ket) - dau hieu cua mot lat cat.
def tim_hai_cham_trong(tu: "i32", ket: "i32") -> "i32":
    sau = 0
    i = tu
    while i < ket:
        if tok_kind(i) == "OP":
            o = tok_val(i)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
            if o == ":" and sau == 1:
                return i
        i = i + 1
    return -1


# Vi tri token bat dau cau lenh chua 'i'.
def dau_lenh(i: "i32") -> "i32":
    j = i
    while j > 0:
        kt = tok_kind(j - 1)
        if kt == "NL" or kt == "IND" or kt == "DED":
            return j
        j = j - 1
    return 0


def ten_ix(vt: "i32", hau: "str") -> "str":
    return "__ix" + hau + "_" + str(vt)


def ten_lat(vt: "i32", hau: "str") -> "str":
    return "__sl" + hau + "_" + str(vt)


# x[a:b], x[a:], x[:b]. Dung ba bien an i32 (dat ten theo chi so token cua
# '[') vi khong the voi toi 'a' khi no nam duoi doi tuong tren ngan xep.
# 'co_a' = 1 nghia la <a> DA nam tren dinh ngan xep.
def hau_to_lat_cat(goc: "str", vt_lb: "i32", co_a: "i32") -> "str":
    na = ten_lat(vt_lb, "a")
    nb = ten_lat(vt_lb, "b")
    nl = ten_lat(vt_lb, "n")
    if tim_loc(na) < 0:
        em_loi("tien quet khong khai duoc bien an cho lat cat")
        return goc
    if co_a == 0:
        ra("    ldc.i4.0")
    luu_ten(na)
    can_op(":")
    ra("    dup")
    if goc == "str":
        ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
    else:
        ra("    callvirt instance int32 " + il_kieu(goc) + "::get_Count()")
    # `nl` giu TONG DO DAI cho toi khi chuan hoa xong hai dau, roi moi bi
    # dung lai lam DO DAI lat cat. Chuan hoa la bat buoc: `s[-3:]` truoc day
    # dua thang -3 vao Substring va nem ArgumentOutOfRange LUC CHAY, du dich
    # sach - Python thi dem tu cuoi len.
    luu_ten(nl)
    nap_ten(na)
    nap_ten(nl)
    ra("    call int32 Tkv::__cat_chi(int32, int32)")
    luu_ten(na)
    if la_op("]") == 1:
        nap_ten(nl)
    else:
        bt()
    nap_ten(nl)
    ra("    call int32 Tkv::__cat_chi(int32, int32)")
    luu_ten(nb)
    nap_ten(nb)
    nap_ten(na)
    ra("    sub")
    ra("    ldc.i4.0")
    ra("    call int32 [mscorlib]System.Math::Max(int32, int32)")
    luu_ten(nl)
    can_op("]")
    nap_ten(na)
    nap_ten(nl)
    if goc == "str":
        ra("    callvirt instance string [mscorlib]System.String::Substring(int32, int32)")
        return "str"
    if la_list(goc) == 0:
        em_loi("lat cat chi dung cho chuoi / danh sach")
        return goc
    ra("    callvirt instance class [mscorlib]System.Collections.Generic.List`1<!0> " + il_kieu(goc) + "::GetRange(int32, int32)")
    return goc


def hau_to_chi_so(goc: "str", vt_lb: "i32") -> "str":
    global VT
    global CF_KIEU
    if tim_lop(goc) >= 0:
        # `rec['ten_truong']` -> DOC TRUONG. Doi xung voi phep GHI
        # `rec['ten'] = v` va voi `rec.get('ten')` da co. Cay con 109 cho
        # DOC `ctx['x']` tu thoi `ctx` la dict that (va chi 7 cho ghi),
        # dang chuyen dan sang `ctx.x`.
        if k() == "STR":
            _tt_d = v()
            _ti_d = tim_truong(goc, _tt_d)
            if _ti_d >= 0:
                an()
                can_op("]")
                ra("    ldfld " + il_kieu(CF_KIEU[_ti_d]) + " " + goc + "::" + ten_il(_tt_d))
                return CF_KIEU[_ti_d]
        if k() != "NUM":
            em_loi("chi so tren tuple phai la hang so")
            return "i32"
        idx = v()
        an()
        can_op("]")
        ti = tim_truong(goc, "I" + idx)
        if ti < 0:
            em_loi("tuple " + goc + " khong co phan tu " + idx)
            return "i32"
        ra("    ldfld " + il_kieu(CF_KIEU[ti]) + " " + goc + "::I" + idx)
        return CF_KIEU[ti]
    if la_op(":") == 1:
        return hau_to_lat_cat(goc, vt_lb, 0)
    # Chi so AM voi hang so: x[-1] -> x[Count-1]. Chi lam duoc khi hang so
    # viet thang, vi khong the voi toi doi tuong nam duoi chi so tren ngan xep.
    if la_op("-") == 1 and tok_kind(VT + 1) == "NUM" and tok_kind(VT + 2) == "OP" and tok_val(VT + 2) == "]":
        an()
        so = v()
        an()
        can_op("]")
        ra("    dup")
        if goc == "str":
            ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
        else:
            ra("    callvirt instance int32 " + il_kieu(goc) + "::get_Count()")
        ra("    ldc.i4 " + so)
        ra("    sub")
        if goc == "str":
            ra("    ldc.i4.1")
            ra("    callvirt instance string [mscorlib]System.String::Substring(int32, int32)")
            return "str"
        if la_dict(goc) == 1:
            em_loi("chi so am khong dung cho tu dien")
            return kieu_pt(goc)
        ra("    callvirt instance !0 " + il_kieu(goc) + "::get_Item(int32)")
        return kieu_pt(goc)
    bt()
    if la_op(":") == 1:
        return hau_to_lat_cat(goc, vt_lb, 1)
    can_op("]")
    if goc == "str":
        ra("    ldc.i4.1")
        ra("    callvirt instance string [mscorlib]System.String::Substring(int32, int32)")
        return "str"
    if la_dict(goc) == 1:
        ra("    callvirt instance !1 " + il_kieu(goc) + "::get_Item(!0)")
        return kieu_pt(goc)
    if tim_lop(goc) >= 0:
        em_loi("lay chi so tren doi tuong: dung t[0] voi hang so tren tuple")
        return "i32"
    if la_list(goc) == 0:
        em_loi("lay chi so tren kieu khong phai chuoi/danh sach/tu dien")
        return "i32"
    ra("    callvirt instance !0 " + il_kieu(goc) + "::get_Item(int32)")
    return kieu_pt(goc)


# Hau to .ten(...) trong bieu thuc. Con tro dang o ngay sau dau '.'.
# .ten khong theo sau boi '(' la TRUONG (hoac property 0 tham so).
def hau_to_truong(goc: "str", ten: "str") -> "str":
    global CF_KIEU
    global CM_RET
    ti = tim_truong(goc, ten)
    if ti >= 0:
        ra("    ldfld " + il_kieu(CF_KIEU[ti]) + " " + goc + "::" + ten_il(ten))
        return CF_KIEU[ti]
    mi = tim_met(goc, ten)
    if mi >= 0:
        ra("    callvirt instance " + il_kieu(CM_RET[mi]) + " " + goc + "::" + ten_il(ten) + "()")
        return CM_RET[mi]
    em_loi("lop " + goc + " khong co truong/thuoc tinh '" + ten + "'")
    return "i32"


# .ten(...) tren mot doi tuong: goi method thuc the.
def hau_to_goi_met(goc: "str", ten: "str") -> "str":
    global VT
    global KW_N
    global CM_RET
    global CM_PSO
    global CM_PDAU
    global PAR_KIEU
    mi = tim_met(goc, ten)
    if mi < 0:
        em_loi("lop " + goc + " khong co method '" + ten + "'")
        can_op(")")
        return "i32"
    dem = 0
    ky = ""
    if la_op(")") == 0:
        con = 1
        while con == 1:
            if k() == "NAME" and tok_kind(VT + 1) == "OP" and tok_val(VT + 1) == "=":
                con = 0
                continue
            bt()
            if dem > 0:
                ky = ky + ", "
            ky = ky + il_kieu(PAR_KIEU[CM_PDAU[mi] + dem])
            dem = dem + 1
            if khop_op(",") == 0:
                con = 0
    goc_kw = KW_N
    quet_khoa()
    can_op(")")
    while dem < CM_PSO[mi]:
        phat_doi_so(CM_PDAU[mi] + dem, goc_kw)
        if dem > 0:
            ky = ky + ", "
        ky = ky + il_kieu(PAR_KIEU[CM_PDAU[mi] + dem])
        dem = dem + 1
    ra("    callvirt instance " + il_kieu(CM_RET[mi]) + " " + goc + "::" + ten_il(ten) + "(" + ky + ")")
    return CM_RET[mi]


# d.keys()/d.values(): dung mot List moi tu bo suu tap, de duyet theo chi so.
# d.items() chi hop le trong 'for a, b in ...' (BO_ITEMS): vong lap do tu lay
# gia tri theo khoa nen khong can dung danh sach cap.
def hau_to_dict_bo(goc: "str", ten: "str") -> "str":
    global BO_ITEMS
    trong = ruot(goc)
    kk = cat_hai(trong, 1)
    kv = cat_hai(trong, 0)
    if ten == "items":
        if BO_ITEMS == 0:
            em_loi(".items() chi dung duoc trong 'for a, b in ...'")
        return goc
    if ten == "keys":
        pt = kk
        bo = "get_Keys()"
        lop_bo = "KeyCollection"
    else:
        pt = kv
        bo = "get_Values()"
        lop_bo = "ValueCollection"
    kds = "list[" + pt + "]"
    ra("    callvirt instance class [mscorlib]System.Collections.Generic.Dictionary`2/" + lop_bo + "<!0, !1> " + il_kieu(goc) + "::" + bo)
    ra("    newobj instance void " + il_kieu(kds) + "::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
    return kds


def hau_to_method(goc: "str") -> "str":
    global VT
    global MONG
    ten = v()
    an()
    if goc == "module":
        # 'mod.ten' -> 'ten': khong co gi tren ngan xep de bo di.
        if khop_op("(") == 1:
            if la_builtin(ten) == 1:
                return bt_builtin(ten)
            return bt_goi(ten)
        return nap_ten(ten)
    if tim_lop(goc) >= 0:
        # `rec.get("ten_truong")` -> DOC TRUONG. Cay trinh bien dich con
        # hang tram cho viet kieu tu dien (`ctx.get('emitted_types')`) tu
        # thoi `ctx` con la dict that; chung dang chuyen dan sang `ctx.x`.
        # Doc truong la NGHIA DUNG o day: trong TokenVector mot truong da
        # khai ma chua gan thi la null - dung bang thu `.get` tra ve.
        # CHI nhan dang MOT doi so va khoa la HANG CHUOI khop ten truong;
        # moi dang khac roi xuong duong cu (bao "khong co method 'get'").
        if ten == "get" and la_op("(") == 1 and tok_kind(VT + 1) == "STR"                 and tok_kind(VT + 2) == "OP"                 and (tok_val(VT + 2) == ")" or tok_val(VT + 2) == ",")                 and tim_met(goc, "get") < 0                 and tim_truong(goc, tok_val(VT + 1)) >= 0:
            _tt = tok_val(VT + 1)
            _co_md = 0
            if tok_val(VT + 2) == ",":
                _co_md = 1
            an()
            an()
            an()
            _nhan = "GETMD" + str(VT)
            _kt = hau_to_truong(goc, _tt)
            if _co_md == 1:
                # Dang HAI doi so `.get("truong", mac_dinh)`.
                # Bieu thuc mac dinh LUON duoc dich (Python cung tinh no
                # ngay, khong lazy) roi moi bo di neu khong dung.
                MONG = _kt
                if la_chua(_kt) == 1 or _kt == "str":
                    # Truong kieu THAM CHIEU: thu null that.
                    ra("    dup")
                    ra("    brtrue " + _nhan)
                    ra("    pop")
                    bt()
                    ra("  " + _nhan + ":")
                else:
                    # Truong KIEU GIA TRI khong bao gio null - record moi
                    # tao co no bang 0, dung bang cai `.get` tra ve. Van
                    # dich mac dinh roi `pop` de giu ngu nghia va de nuot
                    # het token.
                    bt()
                    ra("    pop")
                can_op(")")
            return _kt
        # Truong kieu ham goi thang: nap truong roi Invoke, khong phai method.
        if la_op("(") == 1 and tim_met(goc, ten) < 0 and tim_truong(goc, ten) >= 0:
            tf = hau_to_truong(goc, ten)
            an()
            return hau_to_invoke(tf)
        if khop_op("(") == 1:
            return hau_to_goi_met(goc, ten)
        return hau_to_truong(goc, ten)
    if goc == "match" and ten == "lastgroup":
        ra("    call string Tkv::__re_nhom_cuoi(" + il_kieu("match") + ")")
        return "str"
    if goc == "match" and (ten == "lastindex" or ten == "pos" or ten == "endpos"):
        em_loi("match." + ten + " chua ho tro")
        return "str"
    if goc == "regex" or goc == "match":
        can_op("(")
        return hau_to_re(goc, ten)
    if la_dict(goc) == 1 and (ten == "keys" or ten == "values" or ten == "items"):
        can_op("(")
        can_op(")")
        return hau_to_dict_bo(goc, ten)
    can_op("(")
    if ten == "join":
        t_j = bt_hoac_sinh(VT - 1)
        # join(dict) = noi cac KHOA (2026-09-25) - Dictionary tu no duyet ra
        # KeyValuePair: EntryPointNotFoundException luc chay.
        if la_dict(t_j) == 1:
            ra("    callvirt instance class [mscorlib]System.Collections.Generic.Dictionary`2/KeyCollection<!0, !1> " + il_kieu(t_j) + "::get_Keys()")
        elif t_j != "str" and t_j != "list[str]" and t_j != "set[str]" and la_chua(t_j) == 1:
            em_loi("join can danh sach CHUOI, gap " + t_j)
        ra("    call string [mscorlib]System.String::Join(string, class [mscorlib]System.Collections.Generic.IEnumerable`1<string>)")
        return "str"
    if ten == "replace":
        bt()
        can_op(",")
        bt()
        if khop_op(",") == 1:
            bt()
            can_op(")")
            ra("    call string Tkv::__thay_n(string, string, string, int32)")
            return "str"
        can_op(")")
        ra("    callvirt instance string [mscorlib]System.String::Replace(string, string)")
        return "str"
    if ten == "startswith":
        # Doi so PHAI la chuoi (2026-09-25): tuple '(a, b)' tung vao thang
        # StartsWith(string). So sanh ORDINAL (4) nhu Python, khong theo van hoa.
        t_sw = bt()
        if t_sw != "str":
            em_loi(".startswith() chi nhan chuoi, gap " + t_sw + " - viet 'a or b'")
        if khop_op(",") == 1:
            bt()
            can_op(")")
            ra("    call bool Tkv::__startswith_n(string, string, int32)")
            return "bool"
        can_op(")")
        ra("    ldc.i4.4")
        ra("    callvirt instance bool [mscorlib]System.String::StartsWith(string, valuetype [mscorlib]System.StringComparison)")
        return "bool"
    if ten == "endswith":
        t_ew = bt()
        if t_ew != "str":
            em_loi(".endswith() chi nhan chuoi, gap " + t_ew + " - viet 'a or b'")
        can_op(")")
        ra("    ldc.i4.4")
        ra("    callvirt instance bool [mscorlib]System.String::EndsWith(string, valuetype [mscorlib]System.StringComparison)")
        return "bool"
    if ten == "find":
        bt()
        if khop_op(",") == 1:
            bt()
            can_op(")")
            ra("    call int32 Tkv::__find_n(string, string, int32)")
            return "i32"
        can_op(")")
        ra("    callvirt instance int32 [mscorlib]System.String::IndexOf(string)")
        return "i32"
    if ten == "rfind":
        # `s.rfind(x)` (2026-09-24) - MOT doi so. So sanh ORDINAL (4) nhu
        # Python, KHONG theo van hoa. Lech biet truoc: x rong thi .NET tra
        # len-1 con Python tra len - trong cay khong cho nao goi voi chuoi rong.
        bt()
        if khop_op(",") == 1:
            em_loi(".rfind() hien chi nhan MOT doi so")
        can_op(")")
        ra("    ldc.i4.4")
        ra("    callvirt instance int32 [mscorlib]System.String::LastIndexOf(string, valuetype [mscorlib]System.StringComparison)")
        return "i32"
    if ten == "strip" or ten == "lstrip" or ten == "rstrip":
        ben = "0"
        if ten == "lstrip":
            ben = "1"
        if ten == "rstrip":
            ben = "2"
        if la_op(")") == 1:
            can_op(")")
            ra("    ldstr \" \\t\\r\\n\"")
        else:
            bt()
            can_op(")")
        ra("    ldc.i4." + ben)
        ra("    call string Tkv::__cat_dau(string, string, int32)")
        return "str"
    if ten == "isalpha":
        can_op(")")
        ra("    call int32 Tkv::__isalpha(string)")
        return "bool"
    if ten == "lower":
        can_op(")")
        ra("    callvirt instance string [mscorlib]System.String::ToLowerInvariant()")
        return "str"
    if ten == "upper":
        can_op(")")
        ra("    callvirt instance string [mscorlib]System.String::ToUpperInvariant()")
        return "str"
    if ten == "get":
        if la_dict(goc) == 0:
            em_loi(".get() chi dung cho tu dien")
            can_op(")")
            return "i32"
        kk = cat_hai(ruot(goc), 1)
        kv = cat_hai(ruot(goc), 0)
        if kieu_biet(kv) == 0:
            # Bang khai bang handle mo: kieu gia tri khong ai dang ky. Giu
            # 'str' de KHOP voi kieu_hau_to - hai ben lech nhau thi kieu
            # khai bao mot dang ma IL day len mot dang khac.
            kv = "str"
        MONG = kk
        bt()
        if khop_op(",") == 1:
            MONG = kv
            bt()
        else:
            # '.get(k)' KHONG mac dinh tra None (2026-09-25): voi kieu THAM
            # CHIEU (str/container/lop) phai la null - truoc day chuoi rong,
            # nen 'x = d.get(k); if x is not None' LUON dung (kind_of_stmt tra
            # "" -> khong cau lenh nao duoc sinh ma). Kieu gia tri giu 0.
            if la_so_hoac_bool(kv) == 0 and kv != "i64" and kv != "f64":
                ra("    ldnull")
            else:
                ra_mac_dinh(kv)
        can_op(")")
        ra("    call " + il_kieu(kv) + " Tkv::" + dget_ky(goc) + "(" + il_kieu(goc) + ", " + il_kieu(kk) + ", " + il_kieu(kv) + ")")
        return kv
    if ten == "setdefault":
        if la_dict(goc) == 0:
            em_loi(".setdefault() chi dung cho tu dien")
            can_op(")")
            return "i32"
        sk = cat_hai(ruot(goc), 1)
        sv = cat_hai(ruot(goc), 0)
        if kieu_biet(sv) == 0:
            sv = "str"
        MONG = sk
        bt()
        if khop_op(",") == 0:
            em_loi("setdefault() can dung 2 tham so")
            can_op(")")
            return sv
        MONG = sv
        bt()
        can_op(")")
        ra("    call " + il_kieu(sv) + " Tkv::" + dsd_ky(goc) + "(" + il_kieu(goc) + ", " + il_kieu(sk) + ", " + il_kieu(sv) + ")")
        return sv
    if ten == "extend":
        if la_list(goc) == 0:
            em_loi(".extend() chi dung cho danh sach")
            can_op(")")
            return "void"
        MONG = goc
        bt()
        can_op(")")
        ra("    callvirt instance void " + il_kieu(goc) + "::AddRange(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
        return "void"
    if ten == "pop" and la_dict(goc) == 1:
        pk = cat_hai(ruot(goc), 1)
        pv = cat_hai(ruot(goc), 0)
        if kieu_biet(pv) == 0:
            pv = "str"
        MONG = pk
        bt()
        if khop_op(",") == 0:
            # Python nem KeyError khi thieu khoa - chua co, bao loi thay vi doan.
            em_loi("dict.pop(k) khong mac dinh chua ho tro - dung dict.pop(k, md)")
            can_op(")")
            return pv
        MONG = pv
        bt()
        can_op(")")
        ra("    call " + il_kieu(pv) + " Tkv::" + dpop_ky(goc) + "(" + il_kieu(goc) + ", " + il_kieu(pk) + ", " + il_kieu(pv) + ")")
        return pv
    if ten == "discard":
        MONG = kieu_pt(goc)
        bt()
        can_op(")")
        if la_set(goc) == 0:
            em_loi(".discard() chi dung cho tap hop")
            return "void"
        ra("    callvirt instance bool " + il_kieu(goc) + "::Remove(!0)")
        ra("    pop")
        return "void"
    if ten == "pop":
        if la_list(goc) == 0:
            em_loi(".pop() chi dung cho danh sach")
            can_op(")")
            return "i32"
        if la_op(")") == 1:
            ra("    ldc.i4.m1")
        else:
            MONG = "i32"
            bt()
        can_op(")")
        pt_pop = ruot(goc)
        ra("    call " + il_kieu(pt_pop) + " Tkv::" + lpop_ky(goc) + "(" + il_kieu(goc) + ", int32)")
        return pt_pop
    if ten == "append":
        MONG = kieu_pt(goc)
        t_pt = bt()
        can_op(")")
        # Phan tu SAI kieu (2026-09-25): '_BODIES: list[str]' nhan list[i32] -
        # dich sach, ArrayTypeMismatchException luc chay.
        if la_list(goc) == 1 and (doi_so_sai_kieu(t_pt, kieu_pt(goc)) == 1 or chua_khac(t_pt, kieu_pt(goc)) == 1):
            em_loi(".append(): phan tu kieu " + t_pt + " vao danh sach " + goc)
        if la_list(goc) == 0:
            em_loi(".append() chi dung cho danh sach")
            return "void"
        ra("    callvirt instance void " + il_kieu(goc) + "::Add(!0)")
        return "void"
    if ten == "add":
        MONG = kieu_pt(goc)
        t_pt = bt()
        can_op(")")
        if la_set(goc) == 1 and doi_so_sai_kieu(t_pt, kieu_pt(goc)) == 1:
            em_loi(".add(): phan tu kieu " + t_pt + " vao tap " + goc)
        if la_set(goc) == 0:
            em_loi(".add() chi dung cho tap hop")
            return "void"
        ra("    callvirt instance bool " + il_kieu(goc) + "::Add(!0)")
        ra("    pop")
        return "void"
    if ten == "split":
        bt()
        if khop_op(",") == 1:
            bt()
            can_op(")")
            ra("    call class [mscorlib]System.Collections.Generic.List`1<string> Tkv::__split_n(string, string, int32)")
            return "list[str]"
        can_op(")")
        ra("    call class [mscorlib]System.Collections.Generic.List`1<string> Tkv::__split(string, string)")
        return "list[str]"
    if ten == "clear":
        can_op(")")
        ra("    callvirt instance void " + il_kieu(goc) + "::Clear()")
        return "void"
    if ten == "index":
        bt()
        can_op(")")
        if goc == "str":
            ra("    callvirt instance int32 [mscorlib]System.String::IndexOf(string)")
        else:
            ra("    callvirt instance int32 " + il_kieu(goc) + "::IndexOf(!0)")
        return "i32"
    if ten == "count":
        bt()
        can_op(")")
        if goc == "str":
            ra("    call int32 Tkv::__str_count(string, string)")
            return "i32"
        # DANH SACH: truoc day cho nay phat `IndexOf(!0)` - tra CHI SO chu
        # khong phai SO LAN. `["a","b","a","a"].count("a")` ra 0 thay vi 3,
        # va -1 khi khong tim thay: SAI AM THAM. Trinh bien dich THAT khong
        # co list.count(), nen bao loi de hai ben khop nhau.
        em_loi("list.count() chua ho tro (trinh bien dich that cung khong co)")
        return "i32"
    if ten == "update" and la_dict(goc) == 1:
        tb = bt()
        can_op(")")
        if tb != goc:
            em_loi(".update() can tu dien CUNG kieu, gap " + tb)
        ra("    call int32 Tkv::" + upd_ky(goc) + "(" + il_kieu(goc) + ", " + il_kieu(goc) + ")")
        ra("    pop")
        return "void"
    em_loi("method chua ho tro trong bieu thuc: ." + ten)
    can_op(")")
    return "i32"


# { } : tu dien hoac tap hop. Kieu lay tu MONG (kieu da khai cua dich den),
# vi ban than literal khong tu noi duoc kieu phan tu.
def bt_mo_ngoac_nhon() -> "str":
    global MONG
    global VT
    kieu = MONG
    if la_dict(kieu) == 0 and la_set(kieu) == 0:
        # Khong co kieu MONG thi phai nhin CHINH van ban: co ':' o do sau 1
        # la TU DIEN. Doan bua ra 'set' se bo mat toan bo phan gia tri va
        # chi lo ra luc chay - dung dang sai am tham.
        kieu = kieu_ve_phai(VT)
    if la_dict(kieu) == 0 and la_set(kieu) == 0:
        kieu = "set[str]"
    an()
    ra("    newobj instance void " + il_kieu(kieu) + "::.ctor()")
    if la_op("}") == 1:
        an()
        return kieu
    # Kieu MONG cho tung phan tu. Thieu buoc nay thi mot tu dien LONG
    # (`{"p": {"q": 5}}`) thay MONG cua tu dien NGOAI va tu dung minh bang
    # chinh kieu do - sinh IL sai am tham.
    k_khoa = cat_hai(ruot(kieu), 1)
    k_gtri = cat_hai(ruot(kieu), 0)
    if la_dict(kieu) == 0:
        k_khoa = ruot(kieu)
    con = 1
    while con == 1:
        ra("    dup")
        MONG = k_khoa
        bt()
        if la_dict(kieu) == 1:
            can_op(":")
            MONG = k_gtri
            bt()
            ra("    callvirt instance void " + il_kieu(kieu) + "::set_Item(!0, !1)")
        else:
            ra("    callvirt instance bool " + il_kieu(kieu) + "::Add(!0)")
            ra("    pop")
        if khop_op(",") == 0:
            con = 0
        else:
            # Dau phay CUOI truoc '}' la hop le trong Python.
            if la_op("}") == 1:
                con = 0
    can_op("}")
    return kieu


def bt_tao_tup(lop: "str") -> "str":
    global CF_LOP
    global CF_KIEU
    global CF_N
    ky = ""
    dem = 0
    i = 0
    while i < CF_N:
        if CF_LOP[i] == lop:
            if dem > 0:
                ky = ky + ", "
            ky = ky + il_kieu(CF_KIEU[i])
            dem = dem + 1
        i = i + 1
    ra("    newobj instance void " + lop + "::.ctor(" + ky + ")")
    return lop


# Tim tu khoa 'for' o DO SAU 1 trong [tu, ket) - dau hieu cua rut gon danh sach.
def tim_for_trong(tu: "i32", ket: "i32") -> "i32":
    sau = 0
    i = tu
    while i < ket:
        if tok_kind(i) == "OP":
            o = tok_val(i)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
        if sau == 1 and tok_kind(i) == "NAME" and tok_val(i) == "for":
            return i
        i = i + 1
    return -1


# PHAM VI RIENG cho bien rut gon (2026-09-25): Python cho bien cua mot rut
# gon/bieu thuc sinh pham vi RIENG, con hat giong chot kieu bien theo TEN
# trong ca ham - '[str(x) for x in a]' canh '[int(x) for x in b]' tung cat
# chuoi vao o int32. Doi ten ngay tren TOKEN: moi bien lap cua rut gon o vi
# tri vt thanh 'ten__r<vt>' trong ngoac cua no. BO QUA nguon lap cua 'for'
# dau (Python tinh no o pham vi NGOAI), ten sau '.', va ten doi so tu khoa.
def doi_ten_rut_gon() -> "i32":
    i = 0
    n = tok_so_luong()
    # '_' la bien BO DI: moi lan xuat hien la mot bien RIENG (2026-09-25) -
    # 'k, v, _ = peek()' (_ la i32) canh 'for _, ta in ...' (_ la TypeAnn) tung
    # cat nham kieu vao cung mot o nho.
    while i < n:
        if tok_kind(i) == "NAME" and tok_val(i) == "_":
            dat_tok_val(i, "__bo" + str(i))
        i = i + 1
    i = 0
    while i < n:
        if tok_kind(i) == "OP" and (tok_val(i) == "[" or tok_val(i) == "(" or tok_val(i) == "{"):
            ket = qua_ngoac(i)
            vt_for = tim_for_trong(i, ket)
            if vt_for > 0:
                doi_ten_mot_rut_gon(i, ket, vt_for)
        i = i + 1
    return 1


def doi_ten_mot_rut_gon(vt_lb: "i32", ket: "i32", vt_for: "i32") -> "i32":
    ds_bien = rg_ten(vt_for)
    vt_in = rg_vt_in(vt_for)
    # het nguon lap: 'if'/'for' o do sau 1, hoac dau dong ngoac
    het_nguon = vt_in + 1
    sau = 0
    while het_nguon < ket:
        if tok_kind(het_nguon) == "OP":
            o = tok_val(het_nguon)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
        if sau == 0 and tok_kind(het_nguon) == "NAME" and (tok_val(het_nguon) == "if" or tok_val(het_nguon) == "for"):
            break
        het_nguon = het_nguon + 1
    j = vt_lb + 1
    while j < ket:
        if j > vt_in and j < het_nguon:
            j = het_nguon
            continue
        if tok_kind(j) == "NAME" and tok_val(j) in ds_bien:
            sau_cham = 0
            if tok_kind(j - 1) == "OP" and tok_val(j - 1) == ".":
                sau_cham = 1
            doi_so_kw = 0
            if tok_kind(j + 1) == "OP" and tok_val(j + 1) == "=":
                doi_so_kw = 1
            if sau_cham == 0 and doi_so_kw == 0:
                dat_tok_val(j, tok_val(j) + "__r" + str(vt_lb))
        j = j + 1
    return 1


# Dau 'if' BO LOC cua rut gon: o do sau 1, SAU dau 'for'.
# Ve phai cua phep gan co chua 'for' long trong ngoac khong (rut gon hoac
# bieu thuc sinh).
def co_sinh_ve_phai(tu: "i32") -> "i32":
    sau = 0
    i = tu
    while tok_kind(i) != "NL" and tok_kind(i) != "EOF":
        if tok_kind(i) == "OP":
            o = tok_val(i)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
        if sau > 0 and tok_kind(i) == "NAME" and tok_val(i) == "for":
            return 1
        i = i + 1
    return 0


def tim_if_trong(tu: "i32", ket: "i32") -> "i32":
    sau = 1
    i = tu
    while i < ket:
        if tok_kind(i) == "OP":
            o = tok_val(i)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
        if sau == 1 and tok_kind(i) == "NAME" and tok_val(i) == "if":
            return i
        i = i + 1
    return -1


def ten_an_lc(vt: "i32") -> "str":
    return "__lc_" + str(vt)


# [E for V in IT] - khong co bo loc 'if'. Ba bien an deu dat ten theo CHI SO
# TOKEN cua dau '[', nen tien quet va luc phat sinh ra cung mot ten.
# Rut gon co the THAO TUPLE: `[s.name for s, _, n in ps]`. Bien lap la moi
# ten tu sau 'for' toi 'in' (2026-09-24; truoc day chi doc MOT token ngay
# sau 'for' va nhay co dinh +3 - bien thu hai lot vao bieu thuc nguon).
def rg_vt_in(vt_for: "i32") -> "i32":
    i = vt_for + 1
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "NAME" and tok_val(i) == "in":
            return i
        i = i + 1
    return vt_for + 2


def rg_ten(vt_for: "i32") -> "list[str]":
    r = []
    i = vt_for + 1
    het = rg_vt_in(vt_for)
    while i < het:
        if tok_kind(i) == "NAME":
            r.append(tok_val(i))
        i = i + 1
    return r


def bt_rut_gon(vt_lb: "i32") -> "str":
    global VT
    global LOC_KIEU
    global CAM_BA_NGOI
    global CF_KIEU
    ket = qua_ngoac(vt_lb)
    vt_for = tim_for_trong(vt_lb, ket)
    vt_expr = vt_lb + 1
    ten_ds = ten_an_lc(vt_lb)
    j = tim_loc(ten_ds)
    if j < 0:
        em_loi("tien quet khong khai duoc bien an cho rut gon danh sach")
        VT = ket
        return "i32"
    kieu_ds = LOC_KIEU[j]
    ds_bien = rg_ten(vt_for)
    ten_nguon = ten_an_ds(vt_lb)
    ten_dem = ten_an_i(vt_lb)
    ra("    newobj instance void " + il_kieu(kieu_ds) + "::.ctor()")
    luu_ten(ten_ds)
    VT = rg_vt_in(vt_for) + 1
    CAM_BA_NGOI = 1
    goc = bt()
    if la_dict(goc) == 1:
        k_rg = cat_hai(ruot(goc), 1)
        ra("    callvirt instance class [mscorlib]System.Collections.Generic.Dictionary`2/KeyCollection<!0, !1> " + il_kieu(goc) + "::get_Keys()")
        goc = "list[" + k_rg + "]"
        ra("    newobj instance void " + il_kieu(goc) + "::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
    elif la_set(goc) == 1:
        goc = "list[" + ruot(goc) + "]"
        ra("    newobj instance void " + il_kieu(goc) + "::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
    luu_ten(ten_nguon)
    ra("    ldc.i4.0")
    luu_ten(ten_dem)
    n_dau = nhan_moi()
    n_ket = nhan_moi()
    ra("  L" + str(n_dau) + ":")
    nap_ten(ten_dem)
    nap_ten(ten_nguon)
    # Nguon la CHUOI (2026-09-25): duyet tung ky tu - khop lenh_cho.
    if goc == "str":
        ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
    else:
        ra("    callvirt instance int32 " + il_kieu(goc) + "::get_Count()")
    ra("    clt")
    ra("    brfalse L" + str(n_ket))
    nap_ten(ten_nguon)
    nap_ten(ten_dem)
    if goc == "str":
        ra("    callvirt instance char [mscorlib]System.String::get_Chars(int32)")
        ra("    call string [mscorlib]System.Char::ToString(char)")
    else:
        ra("    callvirt instance !0 " + il_kieu(goc) + "::get_Item(int32)")
    if len(ds_bien) == 1:
        luu_ten(ds_bien[0])
    else:
        # Thao tuple: moi truong I<j> ra mot bien; `dup` giu doi tuong
        # tuple cho truong ke tiep, truong cuoi thi khong.
        lop_t = kieu_pt(goc)
        jt = 0
        while jt < len(ds_bien):
            ti = tim_truong(lop_t, "I" + str(jt))
            if ti < 0:
                em_loi("rut gon thao tuple can danh sach tuple, gap " + goc)
                VT = ket
                return kieu_ds
            if jt < len(ds_bien) - 1:
                ra("    dup")
            ra("    ldfld " + il_kieu(CF_KIEU[ti]) + " " + lop_t + "::I" + str(jt))
            luu_ten(ds_bien[jt])
            jt = jt + 1
    n_tiep = nhan_moi()
    vt_if = tim_if_trong(vt_for, ket)
    if vt_if > 0:
        VT = vt_if + 1
        bt_logic()
        ra("    brfalse L" + str(n_tiep))
    nap_ten(ten_ds)
    VT = vt_expr
    bt()
    if la_dict(kieu_ds) == 1:
        can_op(":")
        bt()
        ra("    callvirt instance void " + il_kieu(kieu_ds) + "::set_Item(!0, !1)")
    else:
        if la_set(kieu_ds) == 1:
            ra("    callvirt instance bool " + il_kieu(kieu_ds) + "::Add(!0)")
            ra("    pop")
        else:
            ra("    callvirt instance void " + il_kieu(kieu_ds) + "::Add(!0)")
    ra("  L" + str(n_tiep) + ":")
    nap_ten(ten_dem)
    ra("    ldc.i4.1")
    ra("    add")
    luu_ten(ten_dem)
    ra("    br L" + str(n_dau))
    ra("  L" + str(n_ket) + ":")
    nap_ten(ten_ds)
    VT = ket
    return kieu_ds


# Danh sach viet thang [a, b, c]: newobj roi 'dup + Add' tung phan tu. Add
# tra void nen ngan xep tu can bang - khong can bien tam.
def la_tuple_hien(tu: "i32") -> "i32":
    """Token tai `tu` la '(' mo mot TUPLE DISPLAY (co dau phay o muc ngoai
    cung) chu khong phai mot bieu thuc boc ngoac hay generator."""
    het = qua_ngoac(tu)
    sau = 0
    # Dau phay trong DANH SACH THAM SO lambda ('lambda a, b: ...') KHONG phai
    # dau phay tuple (2026-09-25): '(lambda a0, a1: f(a0, a1))' truoc day
    # thanh tuple 1 phan tu boc delegate - IL sai. Chi bo qua tu 'lambda'
    # toi ':' cung muc; '(lambda x: x, 1)' van la tuple nhu Python.
    trong_lambda = 0
    i = tu
    while i < het:
        if tok_kind(i) == "NAME" and tok_val(i) == "lambda" and sau == 1:
            trong_lambda = 1
        if tok_kind(i) == "OP":
            o = tok_val(i)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
            if o == ":" and sau == 1:
                trong_lambda = 0
            if o == "," and sau == 1 and trong_lambda == 0:
                return 1
        i = i + 1
    return 0


def bt_ds_ngoac() -> "str":
    """Y HET `bt_ds` nhung dau dong la '(' / ')'. Dung cho `for ... in
    ((a, b), (c, d))`: Python coi day la mot day duyet duoc, con hat giong
    truoc day dung no thanh MOT lop tuple long - roi vong lap nhieu bien
    khong go ra duoc."""
    global MONG
    global VT
    an()
    kpt = kieu_ve_phai(VT)
    kieu = "list[" + kpt + "]"
    ra("    newobj instance void " + il_kieu(kieu) + "::.ctor()")
    while la_op(")") == 0:
        ra("    dup")
        MONG = kpt
        bt()
        ra("    callvirt instance void " + il_kieu(kieu) + "::Add(!0)")
        if khop_op(",") == 0:
            break
    can_op(")")
    return kieu


def bt_ds() -> "str":
    global MONG
    global VT
    an()
    kpt = kieu_ve_phai(VT)
    if la_op("*") == 1:
        # Phan tu dau la `*xs`: kieu phan tu la kieu PHAN TU cua xs.
        # PHAI khop y het nhanh tuong ung trong `kieu_ve_phai`.
        kpt = kieu_pt(kieu_ve_phai(VT + 1))
    kieu = "list[" + kpt + "]"
    ra("    newobj instance void " + il_kieu(kieu) + "::.ctor()")
    while la_op("]") == 0:
        ra("    dup")
        if la_op("*") == 1:
            # `[a, *xs, b]` - TRAI mot day vao giua. `AddRange` lam dung viec
            # do; khong can vong lap.
            an()
            MONG = kieu
            tx = bt()
            if tx != kieu:
                em_loi("'*' trong danh sach can " + kieu + ", gap " + tx)
            ra("    callvirt instance void " + il_kieu(kieu) + "::AddRange(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
        else:
            MONG = kpt
            bt()
            ra("    callvirt instance void " + il_kieu(kieu) + "::Add(!0)")
        if khop_op(",") == 0:
            break
    can_op("]")
    return kieu


# Ten mot ham dung nhu GIA TRI: dung delegate tro toi no.
# Kieu cua mot ten dang thay duoc (cuc bo / cap module); "" neu khong biet.
def kieu_ten(ten: "str") -> "str":
    global LOC_KIEU
    global GV_KIEU
    j = tim_loc(ten)
    if j >= 0:
        return LOC_KIEU[j]
    gi = tim_gv(ten)
    if gi >= 0:
        return GV_KIEU[gi]
    gi = tim_gv(go_bi_danh(ten))
    if gi >= 0:
        return GV_KIEU[gi]
    return ""


def cuoi_than_lam(tu: "i32") -> "i32":
    """Cuoi than lambda: dung o dau phay hoac dau dong o DO SAU 0."""
    sau = 0
    i = tu
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "NL":
            return i
        if tok_kind(i) == "OP":
            o = tok_val(i)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                if sau == 0:
                    return i
                sau = sau - 1
            if o == "," and sau == 0:
                return i
        i = i + 1
    return i


def bt_lambda() -> "str":
    """`lambda a, b: <bt>` o vi tri GIA TRI."""
    global VT
    global LAM_VT
    global LAM_BAT
    global LAM_KBAT
    global LAM_THAM
    global LAM_KTHAM
    global LAM_RET
    global LAM_TH
    global LAM_KET
    global LAM_LG
    global LAM_N
    global MONG
    mong_lam = MONG
    an()
    tham = ""
    ktham = ""
    while k() == "NAME":
        if tham != "":
            tham = tham + "|"
        tham = tham + v()
        an()
        if khop_op(",") == 0:
            break
    can_op(":")
    vt_than = VT
    ket_than = cuoi_than_lam(vt_than)
    # Kieu tham so KHONG suy duoc tu chinh lambda - phai lay tu kieu DANG
    # CHO (y het trinh bien dich that: "TRA VE cua lambda suy HOAN TOAN tu
    # target_ta"). Lambda khong tham so thi khong can.
    if tham != "":
        if bat_dau_bang(mong_lam, "func(") == 0:
            em_loi("lambda co tham so can mot kieu 'func(...)' dang cho, gap " + mong_lam)
            VT = ket_than
            return "i32"
        ktham = func_vao(mong_lam)
        # SO THAM SO phai khop. Thieu phep kiem nay thi `f = lambda x: x + 1`
        # (khong khai kieu) di lot: tien quet chot `f` la 'func()->i32', chuoi
        # do VAN bat dau bang 'func(' nen qua cua tren, roi cho goi phat
        # `Invoke()` THIEU tham so - ilasm nhan, CLR nem InvalidProgramException.
        if dem_phan(ktham) != dem_phan(tham):
            em_loi("lambda co " + str(dem_phan(tham)) + " tham so nhung kieu dang cho la " + mong_lam)
            VT = ket_than
            return "i32"
    # Bien BAT DUOC: ten trong than la bien cuc bo cua ham cha, khong phai
    # tham so cua chinh lambda.
    bat = ""
    kbat = ""
    i = vt_than
    while i < ket_than:
        if tok_kind(i) == "NAME" and tu_khoa(tok_val(i)) == 0:
            tn = tok_val(i)
            if tok_kind(i - 1) != "OP" or tok_val(i - 1) != ".":
                if co_trong_ds(tham, tn) == 0 and co_trong_ds(bat, tn) == 0:
                    jb = tim_loc(tn)
                    if jb >= 0:
                        if bat != "":
                            bat = bat + "|"
                            kbat = kbat + "|"
                        bat = bat + tn
                        kbat = kbat + LOC_KIEU[jb]
                # Goi mot HAM LONG (2026-09-24): lambda phai bat CA nhung bien
                # ma ham long do bat - no nap chung (nap_bat_lg) ngay trong than
                # lambda. Thieu thi 'walk_ctx.walk_fn = lambda a: walk(reg, a)'
                # bao "ten chua biet: walk_ctx".
                lg_goi = chi_so_lg_moi(doi_ten_lg(tn))
                if lg_goi >= 0 and LG_BAT[lg_goi] != "":
                    cac_b = LG_BAT[lg_goi].split("|")
                    ib2 = 0
                    while ib2 < len(cac_b):
                        tb = cac_b[ib2]
                        if co_trong_ds(tham, tb) == 0 and co_trong_ds(bat, tb) == 0:
                            jb2 = tim_loc(tb)
                            if jb2 >= 0:
                                if bat != "":
                                    bat = bat + "|"
                                    kbat = kbat + "|"
                                bat = bat + tb
                                kbat = kbat + LOC_KIEU[jb2]
                        ib2 = ib2 + 1
        i = i + 1
    ret_lam = kieu_ve_phai(vt_than)
    # Kieu dang cho la callback VOID (2026-09-24): lambda PHAI tra void. Truoc
    # day kieu tra ve chi suy tu than (loi goi ham void -> mac dinh i32), sinh
    # `Dg_func__ti32` o cho can `Dg_func__tvoid` - truyen qua tham so thi CLR
    # khong kiem (xanh mu), cho vao List thi nem ArrayTypeMismatchException.
    if bat_dau_bang(mong_lam, "func(") == 1:
        if func_ra(mong_lam) == "void":
            ret_lam = "void"
    lop = "Lam" + str(LAM_N)
    if LAM_N == len(LAM_VT):
        LAM_VT.append(vt_than)
        LAM_BAT.append(bat)
        LAM_KBAT.append(kbat)
        LAM_THAM.append(tham)
        LAM_KTHAM.append(ktham)
        LAM_RET.append(ret_lam)
        LAM_TH.append(vt_than)
        LAM_KET.append(ket_than)
        LAM_LG.append(LG_HIEN)
    else:
        LAM_VT[LAM_N] = vt_than
        LAM_BAT[LAM_N] = bat
        LAM_KBAT[LAM_N] = kbat
        LAM_THAM[LAM_N] = tham
        LAM_KTHAM[LAM_N] = ktham
        LAM_RET[LAM_N] = ret_lam
        LAM_TH[LAM_N] = vt_than
        LAM_KET[LAM_N] = ket_than
        LAM_LG[LAM_N] = LG_HIEN
    LAM_N = LAM_N + 1
    them_lop(lop)
    # Dung doi tuong dong goi, roi buoc delegate vao method the hien.
    kyc = ""
    if bat != "":
        pb = bat.split("|")
        pk = kbat.split("|")
        ib = 0
        while ib < len(pb):
            nap_ten(pb[ib])
            if ib > 0:
                kyc = kyc + ", "
            kyc = kyc + il_kieu(pk[ib])
            ib = ib + 1
    ra("    newobj instance void " + lop + "::.ctor(" + kyc + ")")
    kyt = ""
    t_lam = "func("
    if tham != "":
        pt = ktham.split("|")
        it = 0
        while it < len(pt):
            if it > 0:
                kyt = kyt + ", "
                t_lam = t_lam + ","
            kyt = kyt + il_kieu(pt[it])
            t_lam = t_lam + pt[it]
            it = it + 1
    t_lam = t_lam + ")->" + ret_lam
    ra("    ldftn instance " + il_kieu(ret_lam) + " " + lop + "::__goi(" + kyt + ")")
    ra("    newobj instance void " + dang_ky_dg(t_lam) + "::.ctor(object, native int)")
    VT = ket_than
    return t_lam


# Ham long dung LAM GIA TRI (2026-09-24): `return _codegen`, `ctx.f = _load`.
# Ham long da duoc NANG thanh ham tinh voi bien bat la tham so DAU; o vi tri
# gia tri, dung mot LOP CHUYEN TIEP giu gia tri bien bat, method `__goi(tham
# so that)` goi ham tinh do. Cung co che voi lop lambda (Lam<N>).
# Truoc day ham long kieu nay KHONG duoc nang, va moi loi goi toi no dich
# thanh `call` toi method khong ton tai (G0).
AD_LOP: "list[str]" = []
AD_FN: "list[str]" = []
AD_KBAT: "list[str]" = []
AD_KTHAM: "list[str]" = []
AD_RET: "list[str]" = []
AD_N: "i32" = 0


def bt_tro_ham_long(lg: "i32") -> "str":
    global AD_LOP
    global AD_FN
    global AD_KBAT
    global AD_KTHAM
    global AD_RET
    global AD_N
    ten = LG_MOI[lg]
    fi = tim_ham(ten)
    nb = so_bat_lg(lg)
    if nb == 0:
        return bt_tro_ham(fi, ten)
    ky = ""
    kyil = ""
    ktham = ""
    i = nb
    while i < FN_PSO[fi]:
        pk = PAR_KIEU[FN_PDAU[fi] + i]
        if i > nb:
            ky = ky + ","
            kyil = kyil + ", "
            ktham = ktham + "|"
        ky = ky + pk
        kyil = kyil + il_kieu(pk)
        ktham = ktham + pk
        i = i + 1
    lop = "LgAd" + str(AD_N)
    if AD_N == len(AD_LOP):
        AD_LOP.append(lop)
        AD_FN.append(ten)
        AD_KBAT.append(LG_KBAT[lg])
        AD_KTHAM.append(ktham)
        AD_RET.append(FN_RET[fi])
    else:
        AD_LOP[AD_N] = lop
        AD_FN[AD_N] = ten
        AD_KBAT[AD_N] = LG_KBAT[lg]
        AD_KTHAM[AD_N] = ktham
        AD_RET[AD_N] = FN_RET[fi]
    AD_N = AD_N + 1
    them_lop(lop)
    kyc = nap_bat_lg(lg)
    ra("    newobj instance void " + lop + "::.ctor(" + kyc + ")")
    t = "func(" + ky + ")->" + FN_RET[fi]
    ra("    ldftn instance " + il_kieu(FN_RET[fi]) + " " + lop + "::__goi(" + kyil + ")")
    ra("    newobj instance void " + dang_ky_dg(t) + "::.ctor(object, native int)")
    return t


def phat_cac_ad() -> "i32":
    i = 0
    while i < AD_N:
        lop = AD_LOP[i]
        kb = AD_KBAT[i].split("|")
        kt = []
        if AD_KTHAM[i] != "":
            kt = AD_KTHAM[i].split("|")
        ret = AD_RET[i]
        ra(".class public auto ansi beforefieldinit " + lop + " extends [mscorlib]System.Object")
        ra("{")
        j = 0
        while j < len(kb):
            ra("  .field public " + il_kieu(kb[j]) + " c" + str(j))
            j = j + 1
        kyc = ""
        j = 0
        while j < len(kb):
            if j > 0:
                kyc = kyc + ", "
            kyc = kyc + il_kieu(kb[j]) + " p" + str(j)
            j = j + 1
        ra("  .method public specialname rtspecialname instance void .ctor(" + kyc + ") cil managed")
        ra("  {")
        ra("    .maxstack 64")
        ra("    ldarg.0")
        ra("    call instance void [mscorlib]System.Object::.ctor()")
        j = 0
        while j < len(kb):
            ra("    ldarg.0")
            ra("    ldarg.s " + str(j + 1))
            ra("    stfld " + il_kieu(kb[j]) + " " + lop + "::c" + str(j))
            j = j + 1
        ra("    ret")
        ra("  }")
        kyt = ""
        kyg = ""
        j = 0
        while j < len(kb):
            if j > 0:
                kyg = kyg + ", "
            kyg = kyg + il_kieu(kb[j])
            j = j + 1
        j = 0
        while j < len(kt):
            if j > 0:
                kyt = kyt + ", "
            kyt = kyt + il_kieu(kt[j]) + " a" + str(j)
            kyg = kyg + ", " + il_kieu(kt[j])
            j = j + 1
        ra("  .method public instance " + il_kieu(ret) + " __goi(" + kyt + ") cil managed")
        ra("  {")
        ra("    .maxstack 64")
        j = 0
        while j < len(kb):
            ra("    ldarg.0")
            ra("    ldfld " + il_kieu(kb[j]) + " " + lop + "::c" + str(j))
            j = j + 1
        j = 0
        while j < len(kt):
            ra("    ldarg.s " + str(j + 1))
            j = j + 1
        ra("    call " + il_kieu(ret) + " Tkv::" + ten_il(AD_FN[i]) + "(" + kyg + ")")
        ra("    ret")
        ra("  }")
        ra("}")
        ra("")
        i = i + 1
    return AD_N


def bt_tro_ham(f: "i32", ten: "str") -> "str":
    global FN_PDAU
    global FN_PSO
    global FN_RET
    global PAR_KIEU
    ky = ""
    kyil = ""
    i = 0
    while i < FN_PSO[f]:
        if i > 0:
            ky = ky + ","
            kyil = kyil + ", "
        ky = ky + PAR_KIEU[FN_PDAU[f] + i]
        kyil = kyil + il_kieu(PAR_KIEU[FN_PDAU[f] + i])
        i = i + 1
    t = "func(" + ky + ")->" + FN_RET[f]
    dg = dang_ky_dg(t)
    ra("    ldnull")
    ra("    ldftn " + il_kieu(FN_RET[f]) + " Tkv::" + ten + "(" + kyil + ")")
    ra("    newobj instance void " + dg + "::.ctor(object, native int)")
    return t


# 're.<ham>(...)'. Con tro dang o ten ham ngay sau dau cham.
def bt_re() -> "str":
    ten = v()
    an()
    if ten == "VERBOSE" or ten == "X":
        ra("    ldc.i4 32")
        return "i32"
    if ten == "M" or ten == "MULTILINE":
        ra("    ldc.i4 2")
        return "i32"
    if ten == "S" or ten == "DOTALL":
        ra("    ldc.i4 16")
        return "i32"
    if ten == "I" or ten == "IGNORECASE":
        ra("    ldc.i4 1")
        return "i32"
    can_op("(")
    if ten == "compile":
        bt()
        # `(?P<ten>...)` cua Python -> `(?<ten>...)` cua .NET. Doi LUC
        # CHAY nen dung duoc ca voi pattern dung luc chay, khong chi
        # chuoi hang. Xem ghi chu cung ten o tkv_compile.
        ra("    ldstr \"(?P<\"")
        ra("    ldstr \"(?<\"")
        ra("    callvirt instance string [mscorlib]System.String::Replace(string, string)")
        if khop_op(",") == 1:
            bt()
        else:
            ra("    ldc.i4.0")
        can_op(")")
        ra("    newobj instance void " + il_kieu("regex") + "::.ctor(string, valuetype " + re_ns() + "RegexOptions)")
        return "regex"
    if ten == "escape":
        bt()
        can_op(")")
        ra("    call string " + il_kieu("regex") + "::Escape(string)")
        return "str"
    if ten == "match" or ten == "search" or ten == "fullmatch":
        bt()
        can_op(",")
        bt()
        can_op(")")
        ra("    call class " + re_ns() + "Match Tkv::__re_" + re_kieu_goi(ten) + "_mau(string, string)")
        return "match"
    if ten == "sub":
        bt()
        can_op(",")
        bt()
        can_op(",")
        bt()
        can_op(")")
        ra("    call string Tkv::__re_thay(string, string, string)")
        return "str"
    em_loi("re." + ten + "() chua ho tro")
    can_op(")")
    return "i32"


def re_kieu_goi(ten: "str") -> "str":
    if ten == "search":
        return "tim"
    return "khop"


# Hau to tren doi tuong regex / match.
def hau_to_re(goc: "str", ten: "str") -> "str":
    if goc == "regex":
        if ten == "match" or ten == "fullmatch":
            bt()
            if khop_op(",") == 1:
                bt()
            else:
                ra("    ldc.i4.0")
            can_op(")")
            ra("    call class " + re_ns() + "Match Tkv::__re_khop(" + il_kieu("regex") + ", string, int32)")
            return "match"
        if ten == "search":
            bt()
            can_op(")")
            ra("    call class " + re_ns() + "Match Tkv::__re_tim(" + il_kieu("regex") + ", string)")
            return "match"
        if ten == "sub":
            bt()
            can_op(",")
            bt()
            can_op(")")
            # THU TU doi so (2026-09-25): Python 'rx.sub(thay, chuoi)', .NET
            # 'rx.Replace(chuoi, thay)' - goi thang tung DOI CHO hai doi so: ket
            # qua la chinh chuoi thay the ('x is None' -> '== None').
            ra("    call string Tkv::__rx_thay(" + il_kieu("regex") + ", string, string)")
            return "str"
        if ten == "split":
            # KHONG duoc anh xa sang `Regex.Split`. DA DO tren chinh mau
            # `\{(\w*)(:\.(\d+)f)?\}` ma cay nguon dung:
            #   CPython -> 9 phan tu, `None` cho nhom KHONG tham gia
            #   .NET    -> 7 phan tu, BO HAN nhom khong tham gia
            # So phan tu khac nhau, ma cho dung doc `pieces[i+1..i+3]` theo
            # chi so - anh xa thang se doc lech han, va `precision is not
            # None` khong con phan biet duoc gi. Bao loi con hon sai am tham.
            em_loi("re.split() chua ho tro: Regex.Split cua .NET BO nhom khong tham gia con Python giu None - so phan tu khac nhau")
            can_op(")")
            return "list[str]"
        if ten == "finditer":
            bt()
            can_op(")")
            ra("    call class [mscorlib]System.Collections.Generic.List`1<" + il_kieu("match") + "> Tkv::__re_moi(" + il_kieu("regex") + ", string)")
            return "list[match]"
        em_loi("regex." + ten + "() chua ho tro")
        return "i32"
    if ten == "group":
        if la_op(")") == 1:
            can_op(")")
            ra("    callvirt instance string " + re_ns() + "Capture::get_Value()")
            return "str"
        ra("    callvirt instance class " + re_ns() + "GroupCollection " + il_kieu("match") + "::get_Groups()")
        tg = bt()
        can_op(")")
        if tg == "str":
            ra("    callvirt instance class " + re_ns() + "Group " + re_ns() + "GroupCollection::get_Item(string)")
        else:
            ra("    callvirt instance class " + re_ns() + "Group " + re_ns() + "GroupCollection::get_Item(int32)")
        # Nhom KHONG tham gia khop: Python tra None, .NET Group.Value tra ""
        # (2026-09-25) - 'raise X(...)' khong 'from' tung ra from_name = "".
        ra("    call string Tkv::__nhom_gt(class " + re_ns() + "Group)")
        return "str"
    if ten == "groups":
        can_op(")")
        ra("    call class [mscorlib]System.Collections.Generic.List`1<string> Tkv::__re_nhom(" + il_kieu("match") + ")")
        return "list[str]"
    if ten == "start":
        can_op(")")
        ra("    callvirt instance int32 " + re_ns() + "Capture::get_Index()")
        return "i32"
    if ten == "end":
        can_op(")")
        ra("    call int32 Tkv::__re_het(" + il_kieu("match") + ")")
        return "i32"
    em_loi("match." + ten + "() chua ho tro")
    return "i32"


def sang_chuoi(t: "str") -> "i32":
    """Doi gia tri tren dinh ngan xep thanh chuoi. CUNG luat voi builtin
    `str()` - neu doi mot ben ma quen ben kia thi hai duong lech nhau."""
    if t == "str":
        return 1
    if t == "bool":
        ra("    call string Tkv::__bool_str(int32)")
        return 1
    if tim_lop(t) >= 0 or la_chua(t) == 1:
        ra("    callvirt instance string [mscorlib]System.Object::ToString()")
        return 1
    if t == "f64":
        ra("    call string Tkv::__f64_str(float64)")
        return 1
    if t == "i64":
        ra("    call string [mscorlib]System.Convert::ToString(int64)")
        return 1
    ra("    call string [mscorlib]System.Convert::ToString(int32)")
    return 1


def so_cho_dinh_dang(f: "str") -> "i32":
    """So o thay the trong chuoi khuon, hoac -1 neu co o KHONG ho tro.

    CHEP dung gioi han cua trinh bien dich that (il_features/percent_format,
    Phase 1.2): chi '%s', '%d', '%%'. KHONG ho tro '%r' - ban that cung
    khong, va no co ly do: dong khong khop thi de parser bao loi RO RANG
    chu khong am tham sinh sai."""
    n = 0
    i = 0
    while i < len(f):
        if f[i] == "%":
            if i + 1 >= len(f):
                return -1
            c = f[i + 1]
            if c == "%":
                i = i + 1
            else:
                if c == "s" or c == "d":
                    n = n + 1
                    i = i + 1
                else:
                    return -1
        i = i + 1
    return n


def mieng_dinh_dang(f: "str", k: "i32") -> "str":
    """Doan van BAN THUONG thu k (giua cac o thay the). '%%' thanh '%'."""
    r = ""
    dem = 0
    i = 0
    while i < len(f):
        if f[i] == "%" and i + 1 < len(f):
            c = f[i + 1]
            if c == "%":
                if dem == k:
                    r = r + "%"
                i = i + 2
            else:
                if c == "s" or c == "d":
                    dem = dem + 1
                    i = i + 2
                    if dem > k:
                        return r
                else:
                    if dem == k:
                        r = r + f[i]
                    i = i + 1
        else:
            if dem == k:
                r = r + f[i]
            i = i + 1
    return r


def bt_dinh_dang() -> "str":
    """`"khuon" % (a, b)` hoac `"khuon" % x` -> noi chuoi.

    Con tro dang o token STR. Ve phai nhan DUNG hai dang giong ban that:
    mot tuple trong ngoac, hoac MOT bieu thuc don."""
    global VT
    f = v()
    so = so_cho_dinh_dang(f)
    an()
    an()
    ra(ldstr_il(mieng_dinh_dang(f, 0)))
    co_ngoac = 0
    if la_op("(") == 1:
        co_ngoac = 1
        an()
    j = 0
    while j < so:
        ta = bt()
        sang_chuoi(ta)
        ra("    call string [mscorlib]System.String::Concat(string, string)")
        ra(ldstr_il(mieng_dinh_dang(f, j + 1)))
        ra("    call string [mscorlib]System.String::Concat(string, string)")
        j = j + 1
        if co_ngoac == 1:
            if khop_op(",") == 0:
                j = so
    if co_ngoac == 1:
        can_op(")")
    return "str"


def bt_atom() -> "str":
    global CF_KIEU
    global VT
    global MONG
    global RET_HIEN
    if k() == "NUM":
        if la_so_thuc(v()) == 1:
            ra("    ldc.r8 " + v())
            an()
            return "f64"
        ra("    ldc.i4 " + v())
        an()
        return "i32"
    if k() == "STR":
        if tok_kind(VT + 1) == "OP" and tok_val(VT + 1) == "%"                 and tok_kind(VT - 1) != "STR"                 and so_cho_dinh_dang(v()) > 0:
            return bt_dinh_dang()
        ra(ldstr_il(v()))
        an()
        return "str"
    if la_op("[") == 1:
        if tim_for_trong(VT, qua_ngoac(VT)) > 0:
            return bt_rut_gon(VT)
    if la_op("[") == 1 and tok_kind(VT + 1) == "OP" and tok_val(VT + 1) == "]":
        # [] rong: kieu lay tu kieu tra ve cua ham dang dich
        # '[]' rong khong tu noi kieu: uu tien kieu DANG CHO (ve trai cua
        # phep gan), chi khi khong co moi lay kieu tra ve cua ham.
        an()
        an()
        kr = RET_HIEN
        if la_chua(MONG) == 1:
            kr = MONG
        ra("    newobj instance void " + il_kieu(kr) + "::.ctor()")
        return kr
    if la_op("[") == 1:
        return bt_ds()
    if la_op("{") == 1:
        if tim_for_trong(VT, qua_ngoac(VT)) > 0:
            return bt_rut_gon(VT)
        return bt_mo_ngoac_nhon()
    if la_ten("lambda") == 1:
        return bt_lambda()
    # BIEU THUC SINH trong ngoac TRON. Dang lam DOI SO cua mot ham von da
    # chay (xem `bt_noi`), nhung o vi tri bieu thuc doc lap thi '(' roi
    # thang xuong nhanh tuple ben duoi. `bt_rut_gon`/`khai_rut_gon` khong
    # phu thuoc loai ngoac - chung chi dung `qua_ngoac`/`tim_for_trong`.
    if la_op("(") == 1:
        if tim_for_trong(VT, qua_ngoac(VT)) > 0:
            return bt_rut_gon(VT)
    # Tuple hien voi kieu DANG CHO la mot lop tuple (2026-09-24): moi phan tu
    # lay kieu tu truong I<j> cua lop do. Truoc day `(Sig("a"), [], 3)` vao
    # `list[(Sig,list[str],i32)]` suy `[]` thanh i32 -> chon nham lop
    # Tup3_Sig_i32_i32 va phat `newobj int32::.ctor()` - DICH SACH, NO LUC CHAY.
    if la_op("(") == 1 and la_tuple_hien(VT) == 1:
        # CHUAN HOA (2026-09-25): MONG tu '.append' la VAN BAN '(str,str,i32)',
        # khong phai ten lop - truoc day bi bo qua, va '("EOF", None, pos)' suy
        # None -> i32, chon nham lop: ArrayTypeMismatchException luc chay.
        mong_tup = MONG
        if bat_dau_bang(mong_tup, "(") == 1:
            mong_tup = chuan_tup(mong_tup)
        dung_mong = 0
        if bat_dau_bang(mong_tup, "Tup") == 1 and tim_lop(mong_tup) >= 0:
            dung_mong = 1
        an()
        mo_ta = ""
        jt = 0
        while la_op(")") == 0:
            if dung_mong == 1:
                ti = tim_truong(mong_tup, "I" + str(jt))
                if ti >= 0:
                    MONG = CF_KIEU[ti]
            else:
                # Khong co lop tuple mong doi: phan tu KHONG ke thua MONG cua ca
                # bieu thuc (2026-09-25) - 'None' trong '(a, b, None if c else s)'
                # tung lay kieu DANH SACH chua tuple -> sai lop Tup, Add nem
                # ArrayTypeMismatchException.
                MONG = ""
            if jt > 0:
                mo_ta = mo_ta + "|"
            mo_ta = mo_ta + bt()
            jt = jt + 1
            if khop_op(",") == 0:
                break
        can_op(")")
        # Dung LOP MONG DOI khi dung so phan tu: gia tri 'None'/'[]' khong mang
        # kieu nen kieu suy tu chung la sai.
        if dung_mong == 1 and tim_truong(mong_tup, "I" + str(jt)) < 0 and tim_truong(mong_tup, "I" + str(jt - 1)) >= 0:
            return bt_tao_tup(mong_tup)
        return bt_tao_tup(dang_ky_tup(mo_ta))
    if khop_op("(") == 1:
        t = bt()
        if la_op(",") == 1:
            # Tuple: cac phan tu da nam san tren ngan xep theo dung thu tu
            # tham so cua .ctor, nen chi can newobj sau cung.
            mo_ta = t
            while khop_op(",") == 1:
                if la_op(")") == 1:
                    break
                mo_ta = mo_ta + "|" + bt()
            can_op(")")
            lop = dang_ky_tup(mo_ta)
            return bt_tao_tup(lop)
        can_op(")")
        return t
    if khop_op("-") == 1:
        # Dau tru MOT NGOI long hon hau to va '**' (2026-09-25): '-a.b', '-x[i]',
        # '-2 ** 2' tung phu dinh NGUYEN TO roi moi ap hau to/luy thua.
        t = bt_luy_thua()
        if la_so_hoc(t) == 0:
            em_loi("dau tru mot ngoi tren " + t)
        ra("    neg")
        return t
    if la_ten("True") == 1:
        an()
        ra("    ldc.i4.1")
        return "bool"
    if la_ten("False") == 1:
        an()
        ra("    ldc.i4.0")
        return "bool"
    if la_ten("None") == 1:
        an()
        # THEO KIEU DANG CHO (2026-09-25): truoc day lay kieu tra ve cua HAM
        # dang dich - 'actual = None' (actual: str) trong ham tra i32 phat
        # ldc.i4.0 cat vao o string (17 cho trong ban tu-host).
        if MONG == "i32" or MONG == "bool":
            ra("    ldc.i4.0")
            return MONG
        if MONG != "":
            ra("    ldnull")
            return MONG
        # KHONG co kieu dang cho: 'null' (tham chieu rong), KHONG doan theo kieu
        # tra ve cua ham - 'x = None if c else s' tung thanh i32 ca bieu thuc.
        ra("    ldnull")
        return "null"
    if k() == "NAME":
        ten = v()
        an()
        if khop_op("(") == 1:
            if tim_lop(ten) >= 0 and la_ngoai_le(ten) == 1:
                return bt_tao_ngoai_le(ten)
            if tim_lop(ten) >= 0:
                return bt_tao(ten)
            # LOP qua BI DANH ('from m import TypeAnn as _TypeAnn' roi goi
            # '_TypeAnn(...)'). Phai go bi danh NGAY O DAY: neu de roi
            # xuong bt_goi thi no chi tra cuu bang HAM va bao "goi ham
            # chua khai".
            if tim_lop(go_bi_danh(ten)) >= 0:
                return bt_tao(go_bi_danh(ten))
            # Bien / tham so kieu ham: nap roi Invoke, khong phai goi ham tinh.
            kb = kieu_ten(ten)
            if bat_dau_bang(kb, "func(") == 1:
                nap_ten(ten)
                return hau_to_invoke(kb)
            if la_builtin(ten) == 1:
                return bt_builtin(ten)
            return bt_goi(ten)
        if ten == "re" and la_op(".") == 1 and tim_loc(ten) < 0 and tim_gv(ten) < 0:
            an()
            return bt_re()
        lg_v = chi_so_lg_moi(doi_ten_lg(ten))
        if tim_loc(ten) < 0 and lg_v >= 0:
            return bt_tro_ham_long(lg_v)
        if tim_loc(ten) < 0 and tim_gv(ten) < 0 and tim_ham(ten) >= 0:
            return bt_tro_ham(tim_ham(ten), ten)
        # Ham qua BI DANH nhap khau dung LAM GIA TRI (2026-09-25):
        # 'compile_binop_concat=_string_compile_binop_concat'. Truoc day chi
        # "chay" vi mot bien cap module GIA mang ten do (xem thu_thap_toan_cuc)
        # - ldsfld mot truong null, SAI AM THAM.
        if tim_loc(ten) < 0 and tim_gv(ten) < 0 and tim_ham(go_bi_danh(ten)) >= 0:
            return bt_tro_ham(tim_ham(go_bi_danh(ten)), go_bi_danh(ten))
        return nap_ten(ten)
    em_loi("bieu thuc khong hop le tai '" + v() + "'")
    an()
    return "i32"


# Goi mot gia tri kieu ham (truong khai 'func(A,B)->R'): delegate::Invoke.
# Doi so goi GIA TRI kieu ham (2026-09-25): delegate khong qua kiem cua bt_goi -
# 'List<int32>' vao tham so 'list[(str,str)]', tuple vao tham so i32 ... dich sach.
def kiem_ds_invoke(t: "str", thu: "i32", t_ds: "str") -> "i32":
    k_ts = func_tham(t, thu)
    if k_ts == "":
        return 0
    k_ts = chuan_tup(k_ts.replace(" ", ""))
    if chua_khac(t_ds, k_ts) == 1 or doi_so_sai_kieu(t_ds, k_ts) == 1:
        em_loi("doi so " + str(thu + 1) + " cua ham kieu " + t + ": kieu " + t_ds + " khac kieu tham so " + k_ts)
        return 1
    return 0


def hau_to_invoke(t: "str") -> "str":
    global MONG
    dg = dang_ky_dg(t)
    so_ds = 0
    if la_op(")") == 0:
        so_ds = 1
        thu = 0
        MONG = func_tham(t, thu)
        kiem_ds_invoke(t, thu, bt())
        while khop_op(",") == 1:
            thu = thu + 1
            # SO DOI SO (2026-09-25): goi gia tri kieu ham voi NHIEU doi so hon
            # kieu khai tung DICH SACH - Invoke nhan thua mot gia tri tren ngan
            # xep: InvalidProgramException luc chay (Registry khai
            # expr_builtin_dtype_fn 2 tham so, noi goi truyen 3).
            if func_tham(t, thu) == "":
                em_loi("goi ham kieu " + t + " voi qua nhieu doi so")
            MONG = func_tham(t, thu)
            kiem_ds_invoke(t, thu, bt())
            so_ds = thu + 1
    can_op(")")
    # THIEU doi so (2026-09-25): delegate .NET khong co gia tri mac dinh -
    # 'il_type_str(ta)' voi kieu func(TypeAnn, Table) Invoke thieu mot gia tri
    # tren ngan xep: InvalidProgramException luc chay.
    if func_tham(t, so_ds) != "":
        em_loi("goi ham kieu " + t + " thieu doi so (" + str(so_ds) + ")")
    ra("    callvirt instance " + il_kieu(func_ra(t)) + " " + dg + "::Invoke(" + dg_ky(t) + ")")
    return chuan_tup(func_ra(t))


def bt_nguyen_to() -> "str":
    global VT
    t = bt_atom()
    con = 1
    while con == 1:
        if la_op("[") == 1:
            an()
            t = hau_to_chi_so(t, VT - 1)
        else:
            if la_op(".") == 1:
                an()
                t = hau_to_method(t)
            else:
                if la_op("(") == 1 and bat_dau_bang(t, "func(") == 1:
                    an()
                    t = hau_to_invoke(t)
                else:
                    con = 0
    return t


# Tang LUY THUA: chat hon '*' va PHAI-ket hop (2 ** 3 ** 2 == 2 ** 9),
# nen de quy sang CHINH no cho ve phai chu khong lap vong.
def bt_luy_thua() -> "str":
    t = bt_nguyen_to()
    if k() == "OP" and v() == "**":
        if t == "f64":
            an()
            p = bt_luy_thua()
            if p != "f64":
                em_loi("luy thua tron kieu: so mu phai la f64 khi co so la f64")
            ra("    call float64 [mscorlib]System.Math::Pow(float64, float64)")
            return "f64"
        # So nguyen: NANG ca hai ve int64 truoc khi goi. Co so dang o dinh
        # ngan xep NGAY bay gio, nen phai nang TRUOC khi doc so mu.
        if t == "i32" or t == "bool":
            ra("    conv.i8")
        an()
        p = bt_luy_thua()
        if p == "f64":
            em_loi("luy thua tron kieu: co so nguyen ma so mu la f64")
            return "i64"
        if p == "i32" or p == "bool":
            ra("    conv.i8")
        ra("    call int64 Tkv::__ipow(int64, int64)")
        return "i64"
    return t


def bt_nhan() -> "str":
    t = bt_luy_thua()
    while k() == "OP":
        o = v()
        if o == "*" or o == "/" or o == "//" or o == "%":
            an()
            bt_luy_thua()
            # Python: phep so hoc tren bool cho ra SO, khong con la bool.
            if t == "bool":
                t = "i32"
            if o == "*":
                # 'list * n' (2026-09-25): truoc day mul.ovf len tham chieu - so
                # rac cat vao o danh sach. Chua ho tro: bao loi.
                if la_chua(t) == 1 or tim_lop(t) >= 0:
                    em_loi("phep '*' tren " + t + " chua ho tro (lap danh sach) - dung vong lap")
                if t == "str":
                    ra("    call string Tkv::__lap_chuoi(string, int32)")
                else:
                    # `.ovf`: TRAN SO PHAI BAO, KHONG DUOC IM LANG. Trinh
                    # bien dich THAT da lam vay tu 2026-08-04 (operators.py)
                    # voi ly do: 13! la phep tinh het suc binh thuong ma
                    # `mul` tran lang le tra ra 1932053504. Hat giong van
                    # con dung `mul`/`add`/`sub` tran - day la mot cho HAI
                    # BEN BAT DONG, nay dong lai.
                    if t == "f64":
                        # `.ovf` KHONG ton tai cho so thuc trong CIL - tran
                        # so thuc la +inf theo IEEE, khong phai ngoai le.
                        ra("    mul")
                    else:
                        ra("    mul.ovf")
            else:
                if t == "str":
                    # `"%s" % (...)` la DINH DANG KIEU printf, khong phai
                    # phep chia du. Truoc day o day phat `rem` len (string,
                    # tuple): IL vo nghia ma ilasm khong kiem, chay ra dung
                    # chuoi khuon chua thay the gi. Bao loi con hon sai am tham.
                    em_loi("dinh dang '%' tren chuoi chua ho tro - dung f-string")
                else:
                    if o == "%":
                        if t == "f64":
                            ra("    rem")
                        else:
                            ra("    call int32 Tkv::__fmod(int32, int32)")
                    else:
                        if o == "//":
                            if t == "f64":
                                ra("    div")
                                ra("    call float64 [mscorlib]System.Math::Floor(float64)")
                            else:
                                ra("    call int32 Tkv::__fdiv(int32, int32)")
                        else:
                            ra("    div")
        else:
            break
    return t


def bt_cong() -> "str":
    global MONG
    t = bt_nhan()
    while k() == "OP":
        o = v()
        # NOI DANH SACH 'a + b' (2026-09-25): list MOI = ban sao a roi AddRange
        # b. Truoc day phat `add.ovf` len hai tham chieu - AccessViolation.
        if o == "+" and la_list(t) == 1:
            an()
            ra("    newobj instance void " + il_kieu(t) + "::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
            ra("    dup")
            MONG = t
            p_ds = bt_nhan()
            if la_chua(p_ds) == 0:
                em_loi("noi danh sach can hai danh sach, gap " + t + " + " + p_ds)
            ra("    callvirt instance void " + il_kieu(t) + "::AddRange(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
            continue
        # HIEU TAP HOP 'a - b' (2026-09-25): tap MOI = ban sao a roi ExceptWith
        # b. Truoc day phat `sub.ovf` len hai tham chieu - IL vo nghia.
        if o == "-" and la_set(t) == 1:
            an()
            ra("    newobj instance void " + il_kieu(t) + "::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
            ra("    dup")
            MONG = t
            p_tap = bt_nhan()
            if la_chua(p_tap) == 0:
                em_loi("hieu tap hop can hai tap/danh sach, gap " + t + " - " + p_tap)
            ra("    callvirt instance void " + il_kieu(t) + "::ExceptWith(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
            continue
        if o == "+" or o == "-":
            an()
            p = bt_nhan()
            # So hoc CHI tren so/chuoi: moi kieu khac (tap, tu dien, lop) ma
            # roi xuong day la IL vo nghia DICH SACH.
            if (la_chua(t) == 1 or tim_lop(t) >= 0 or la_chua(p) == 1 or tim_lop(p) >= 0):
                em_loi("phep '" + o + "' khong ho tro giua " + t + " va " + p)
            if t == "bool":
                t = "i32"
            if p == "bool":
                p = "i32"
            if o == "-":
                if t == "f64" or p == "f64":
                    ra("    sub")
                    t = "f64"
                else:
                    ra("    sub.ovf")
            else:
                if t == "str" or p == "str":
                    ra("    call string [mscorlib]System.String::Concat(string, string)")
                    t = "str"
                else:
                    if t == "f64" or p == "f64":
                        ra("    add")
                        t = "f64"
                    else:
                        ra("    add.ovf")
        else:
            break
    return t


def bt_hop() -> "str":
    """Tang `|`. Trong Python `|` chat hon so sanh nhung long hon `+`, nen
    no phai la MOT TANG RIENG - khong gop vao bt_cong duoc."""
    t = bt_cong()
    while k() == "OP":
        if v() != "|":
            break
        an()
        p = bt_cong()
        if la_set(t) == 1:
            if p != t:
                em_loi("'|' can hai tap hop CUNG kieu, gap " + t + " va " + p)
            ra("    call " + il_kieu(t) + " Tkv::" + hop_ky(t) + "(" + il_kieu(t) + ", " + il_kieu(t) + ")")
        else:
            ra("    or")
    return t


def bt_thuoc(phu_dinh: "i32") -> "str":
    # 'x in ("a", "b")' - TUPLE viet thang: doc nhu mot DANH SACH (2026-09-25).
    # Truoc day thanh doi tuong TupN roi dua vao __in_str(string, string) nhu
    # mot chuoi - SAI AM THAM (so sanh xau con), nen `kind in (...)` doi moi
    # token thanh 'OP'.
    if la_op("(") == 1 and la_tuple_hien(VT) == 1:
        p = bt_ds_ngoac()
    else:
        p = bt_cong()
    if kieu_in_lop(p) != "":
        ra("    call int32 Tkv::" + in_ky(p) + "(" + il_kieu(kieu_in_lop(p)) + ", " + il_kieu(p) + ")")
        if phu_dinh == 1:
            ra("    ldc.i4.0")
            ra("    ceq")
        return "bool"
    if p != "str" and la_chua(p) == 0:
        em_loi("'in' can chuoi/danh sach/tap/tu dien ben phai, gap " + p)
    if la_dict(p) == 1 or la_set(p) == 1 or la_list(p) == 1:
        kpt = kieu_pt(p)
        if la_dict(p) == 1:
            kpt = cat_hai(ruot(p), 1)
        ra("    call int32 Tkv::" + in_ky(p) + "(" + il_kieu(kpt) + ", " + il_kieu(p) + ")")
        if phu_dinh == 1:
            ra("    ldc.i4.0")
            ra("    ceq")
        return "bool"
    if p == "list[str]":
        ra("    call int32 Tkv::__in_ds_str(string, " + il_kieu(p) + ")")
    else:
        if p == "list[i32]":
            ra("    call int32 Tkv::__in_ds_i32(int32, " + il_kieu(p) + ")")
        else:
            ra("    call int32 Tkv::__in_str(string, string)")
    if phu_dinh == 1:
        ra("    ldc.i4.0")
        ra("    ceq")
    return "i32"


def la_op_so_sanh(o: "str") -> "i32":
    if o == "<":
        return 1
    if o == ">":
        return 1
    if o == "==":
        return 1
    if o == "!=":
        return 1
    if o == "<=":
        return 1
    if o == ">=":
        return 1
    return 0


# Hai toan hang da nam san tren ngan xep; phat phep so sanh 'o'.
def phat_so_sanh(o: "str", t: "str", p: "str") -> "str":
    if t == "str" or p == "str":
        if o == "==":
            ra("    call bool [mscorlib]System.String::op_Equality(string, string)")
            return "i32"
        if o == "!=":
            ra("    call bool [mscorlib]System.String::op_Equality(string, string)")
            ra("    ldc.i4.0")
            ra("    ceq")
            return "i32"
        ra("    call int32 [mscorlib]System.String::CompareOrdinal(string, string)")
        ra("    ldc.i4.0")
    if o == "<":
        ra("    clt")
    if o == ">":
        ra("    cgt")
    if o == "==":
        ra("    ceq")
    if o == "!=":
        ra("    ceq")
        ra("    ldc.i4.0")
        ra("    ceq")
    if o == "<=":
        ra("    cgt")
        ra("    ldc.i4.0")
        ra("    ceq")
    if o == ">=":
        ra("    clt")
        ra("    ldc.i4.0")
        ra("    ceq")
    return "i32"


def bt_so_sanh() -> "str":
    global VT
    t = bt_hop()
    if la_ten("is") == 1:
        an()
        phu = 0
        if la_ten("not") == 1:
            an()
            phu = 1
        if la_ten("None") == 1:
            an()
            ra("    ldnull")
        else:
            bt_hop()
        ra("    ceq")
        if phu == 1:
            ra("    ldc.i4.0")
            ra("    ceq")
        return "bool"
    if la_ten("in") == 1:
        an()
        return bt_thuoc(0)
    if la_ten("not") == 1:
        an()
        if la_ten("in") == 0:
            em_loi("cho doi 'in' sau 'not'")
            return "i32"
        an()
        return bt_thuoc(1)
    if k() != "OP":
        return t
    if la_op_so_sanh(v()) == 0:
        return t
    o = v()
    an()
    vt_giua = VT
    p = bt_hop()
    phat_so_sanh(o, t, p)
    # SO SANH XAU CHUOI: 'a <= b <= c' la '(a<=b) and (b<=c)'. Toan hang
    # giua da bi tieu thu, nen PHAT LAI no bang cach nhay con tro ve dau
    # bieu thuc do - cung cach da dung cho tham so mac dinh.
    while k() == "OP":
        if la_op_so_sanh(v()) == 0:
            return "bool"
        o2 = v()
        an()
        luu = VT
        VT = vt_giua
        p2 = bt_hop()
        VT = luu
        vt_giua = VT
        p3 = bt_hop()
        phat_so_sanh(o2, p2, p3)
        ra("    and")
    return "bool"


# 'not' phai nhan duoc o CA hai phia cua and/or, khong chi dau bieu thuc.
def bt_khong() -> "str":
    if la_ten("not") == 1:
        an()
        phat_chan_ly(bt_khong())
        ra("    ldc.i4.0")
        ra("    ceq")
        return "bool"
    return bt_so_sanh()


# and / or NGAN MACH va TRA VE GIA TRI, khong tra 1/0: Python dung
# 'x or mac_dinh' nhu mot PHEP CHON chu khong phai phep logic.
# LECH CO Y THUC: .NET coi moi tham chieu khac null la dung, nen chuoi rong
# "" o day la DUNG trong khi Python coi la SAI.
# Tang 'and'/'or' RIENG: dieu kien cua bieu thuc ba ngoi cung phai qua tang
# nay, neu khong 'A if x or y else B' bao thieu 'else'.
def la_so_hoac_bool(t: "str") -> "i32":
    if t == "i32" or t == "bool":
        return 1
    return 0


# Chuyen gia tri tren dinh ngan xep (kieu t) thanh GIA TRI CHAN LY (int32 0/1).
def phat_chan_ly(t: "str") -> "i32":
    if t == "str":
        ra("    call bool [mscorlib]System.String::IsNullOrEmpty(string)")
        ra("    ldc.i4.0")
        ra("    ceq")
        return 1
    # CONTAINER RONG la SAI (2026-09-25): truoc day 'if ds:' chi thu khac null
    # nen list RONG la DUNG - `if _ar_decorator(...)` bao co decorator o moi
    # ham. Dem phan tu.
    if la_chua(t) == 1:
        # None (tham so mac dinh 'x=None') la SAI: thu null TRUOC Count, neu
        # khong get_Count len null -> NullReferenceException (2026-09-25).
        n_rong = nhan_moi()
        n_xong = nhan_moi()
        ra("    dup")
        ra("    brfalse L" + str(n_rong))
        ra("    callvirt instance int32 " + il_kieu(t) + "::get_Count()")
        ra("    ldc.i4.0")
        ra("    cgt")
        ra("    br L" + str(n_xong))
        ra("  L" + str(n_rong) + ":")
        ra("    pop")
        ra("    ldc.i4.0")
        ra("  L" + str(n_xong) + ":")
        return 1
    if la_so_hoac_bool(t) == 0:
        ra("    ldnull")
        ra("    cgt.un")
    return 1


# Viet lai doan OUT[dau:dau+bo] bang `moi` (cac dong phia sau don theo).
def thay_doan(dau: "i32", bo: "i32", moi: "list[str]") -> "i32":
    global OUT_N
    duoi = []
    i = dau + bo
    while i < OUT_N:
        duoi.append(OUT[i])
        i = i + 1
    OUT_N = dau
    for d in moi:
        ra(d)
    for d in duoi:
        ra(d)
    return OUT_N


def bt_logic() -> "str":
    global MONG
    t = bt_khong()
    while k() == "NAME":
        o = v()
        if o == "and" or o == "or":
            an()
            n_ket = nhan_moi()
            dau_thu = OUT_N
            ra("    dup")
            if t == "str":
                # Chuoi RONG la SAI trong Python nhung .NET coi moi tham
                # chieu khac null la dung - phai hoi IsNullOrEmpty, neu
                # khong 'x or mac_dinh' tra ve chuoi rong.
                ra("    call bool [mscorlib]System.String::IsNullOrEmpty(string)")
                if o == "and":
                    ra("    brtrue L" + str(n_ket))
                else:
                    ra("    brfalse L" + str(n_ket))
            else:
                # Container/tham chieu: chan ly THAT (rong la sai), khong chi null.
                if la_so_hoac_bool(t) == 0:
                    ra("    call bool Tkv::__that(object)")
                if o == "and":
                    ra("    brfalse L" + str(n_ket))
                else:
                    ra("    brtrue L" + str(n_ket))
            ra("    pop")
            # Ve phai lay KIEU ve trai lam kieu mong doi (2026-09-25): 'f() or
            # []' truoc day dung `[]` khong kieu -> newobj int32::.ctor(), CLR
            # nem MissingMethodException LUC CHAY.
            if la_so_hoac_bool(t) == 0:
                MONG = t
            p = bt_khong()
            # HAI VE KHAC KIEU (2026-09-25): 't and t != "*"' - nhanh ngan mach
            # de CHUOI tren ngan xep, nhanh kia de BOOL; toan tu 'and' ke tiep
            # goi IsNullOrEmpty len gia tri bool -> NullReferenceException luc
            # chay. Khi kieu lech, ca chuoi la phep thu CHAN LY: doi CA HAI ve
            # sang bool (dung ngu nghia khi dung lam dieu kien - cach dung
            # that duy nhat cua dang tron kieu trong cay).
            # CHI khi DUNG MOT ve la so/bool (phep so sanh): hai THAM CHIEU khac
            # kieu ('ctx or {}' roi '.get(...)') la phep CHON GIA TRI, giu nhu cu.
            if t != p and la_so_hoac_bool(t) + la_so_hoac_bool(p) == 1:
                if la_so_hoac_bool(p) == 0:
                    phat_chan_ly(p)
                if la_so_hoac_bool(t) == 0:
                    # Ve trai da phat 'dup; [IsNullOrEmpty]; br L; pop' tai
                    # dau_thu - chen phep doi chan ly TRUOC do, bo IsNullOrEmpty
                    # va dao huong nhanh cho gia tri bool.
                    moi = []
                    if t == "str":
                        moi.append("    call bool [mscorlib]System.String::IsNullOrEmpty(string)")
                        moi.append("    ldc.i4.0")
                        moi.append("    ceq")
                    else:
                        moi.append("    call bool Tkv::__that(object)")
                    moi.append("    dup")
                    if o == "and":
                        moi.append("    brfalse L" + str(n_ket))
                    else:
                        moi.append("    brtrue L" + str(n_ket))
                    moi.append("    pop")
                    so_cu = 4
                    thay_doan(dau_thu, so_cu, moi)
                t = "bool"
            elif la_so_hoac_bool(t) == 1:
                t = p
            ra("  L" + str(n_ket) + ":")
        else:
            break
    return t


# Trong '[E for V in IT if C]', dau 'if' la BO LOC chu khong phai bieu thuc
# ba ngoi. Co chi cam o DUNG mot lan goi bt() (lan phan tich IT); moi loi goi
# long ben trong van hieu 'if' theo nghia ba ngoi nhu thuong.
CAM_BA_NGOI: "i32" = 0


def bt() -> "str":
    global MONG
    global CAM_BA_NGOI
    global OUT_N
    cam = CAM_BA_NGOI
    CAM_BA_NGOI = 0
    # Kieu mong doi cua CA bieu thuc - dieu kien va nhanh A co the ghi de MONG
    # (2026-09-25: 'x = f(s) if s else []' -> [] lay kieu tra ve cua ham).
    mong_bt = MONG
    dau_a = OUT_N
    t = bt_logic()
    if la_ten("if") == 1 and cam == 0:
        # A if C else B - ngoai cung, sau ca and/or (dung nhu Python).
        # THU TU (2026-09-25): Python tinh C TRUOC roi CHI MOT nhanh. Truoc
        # day A duoc tinh TRUOC va LUON - 'con[0] if con else -1' nem
        # ArgumentOutOfRange voi list rong. Cat ma cua A ra, phat C, roi dat
        # lai A sau phep re nhanh.
        ma_a = []
        i_a = dau_a
        while i_a < OUT_N:
            ma_a.append(OUT[i_a])
            i_a = i_a + 1
        OUT_N = dau_a
        an()
        n_ket = nhan_moi()
        n_khac = nhan_moi()
        phat_chan_ly(bt_logic())
        ra("    brfalse L" + str(n_khac))
        for d_a in ma_a:
            ra(d_a)
        ra("    br L" + str(n_ket))
        ra("  L" + str(n_khac) + ":")
        if la_ten("else") == 0:
            em_loi("cho doi 'else' trong bieu thuc ba ngoi")
            return t
        an()
        # Nhanh B cho CUNG kieu voi nhanh A (2026-09-25): 'x.f if x is not
        # None else None' lam doi so - None cua nhanh B tung ra ldc.i4.0 trong
        # khi A day mot dict.
        MONG = mong_bt
        if t != "" and t != "null":
            MONG = t
        t_b = bt()
        ra("  L" + str(n_ket) + ":")
        # Nhanh A la None: kieu ca bieu thuc = kieu nhanh B.
        if t == "null" or t == "":
            t = t_b
    return t


def lenh_in() -> "i32":
    can_op("(")
    t = bt()
    can_op(")")
    if t == "bool":
        ra("    call string Tkv::__bool_str(int32)")
        t = "str"
    ra("    call void [mscorlib]System.Console::WriteLine(" + il_kieu(t) + ")")
    return 1


def lenh_tra_ve() -> "i32":
    global MONG
    global RET_HIEN
    global CO_TRY
    global NHAN_RA
    MONG = RET_HIEN
    if k() == "NL":
        if CO_TRY == 0:
            # 'return' tran trong ham KHONG void (2026-09-25: ham khong khai
            # kieu tra ve mac dinh i32) - phai day gia tri roi, 'ret' voi
            # ngan xep rong la IL KHONG HOP LE (InvalidProgramException).
            if RET_HIEN != "void":
                ra_mac_dinh(RET_HIEN)
            ra("    ret")
            return 1
        ra_mac_dinh(RET_HIEN)
        luu_ten("__ret")
        ra("    leave L" + str(NHAN_RA))
        return 1
    if co_phay_ngoai(VT, cuoi_dong(VT)) == 1:
        # 'return a, b' - tuple khong ngoac. Moi phan tu lay kieu DANG CHO tu
        # truong I<j> cua lop tuple tra ve (2026-09-25): 'return [], {}' tung
        # dung MONG = chinh lop tuple cho '[]' -> newobj Tup2::.ctor() khong
        # ton tai (MissingMethodException luc chay).
        lop_rt = chuan_tup(RET_HIEN)
        dung_rt = 0
        if bat_dau_bang(lop_rt, "Tup") == 1 and tim_lop(lop_rt) >= 0:
            dung_rt = 1
        jr = 0
        mo_ta = ""
        con_rt = 1
        while con_rt == 1:
            MONG = ""
            if dung_rt == 1:
                ti_rt = tim_truong(lop_rt, "I" + str(jr))
                if ti_rt >= 0:
                    MONG = CF_KIEU[ti_rt]
            if jr > 0:
                mo_ta = mo_ta + "|"
            mo_ta = mo_ta + bt()
            jr = jr + 1
            if khop_op(",") == 0:
                con_rt = 0
        if dung_rt == 1 and so_truong_tup(lop_rt) == str(jr):
            bt_tao_tup(lop_rt)
        else:
            bt_tao_tup(dang_ky_tup(mo_ta))
    else:
        bt()
    if CO_TRY == 0:
        ra("    ret")
        return 1
    luu_ten("__ret")
    ra("    leave L" + str(NHAN_RA))
    return 1


# Gia tri roi cua mot kieu, dung cho 'return' khong gia tri va duong roi.
def ra_mac_dinh(kieu: "str") -> "i32":
    if kieu == "str":
        ra("    ldstr \"\"")
        return 1
    if kieu == "i32" or kieu == "bool":
        ra("    ldc.i4.0")
        return 1
    # i64/f64 la kieu GIA TRI: `ldnull` o day day mot tham chieu vao cho doi
    # int64/float64. Chung nam trong `kieu_biet` nen duong `.get` KHONG co
    # doi so mac dinh se di qua day - mot cho sinh ma sai am tham co san.
    if kieu == "i64":
        ra("    ldc.i8 0")
        return 1
    if kieu == "f64":
        ra("    ldc.r8 0.0")
        return 1
    ra("    ldnull")
    return 1


# try / except: .try { } catch { }. Chi bat System.Exception - hat giong
# khong phan biet lop ngoai le, va thong bao loi lay qua get_Message().
# Co nhanh `ten` (except/else/finally) thuoc CHINH lenh `try` dang bat dau
# tai `vt` khong. PHAI biet TRUOC khi phat mot dong IL nao: `finally` trong
# CIL doi mot `.try` LONG ben ngoai, ma dong mo cua no di ra truoc than.
def nhanh_try_co(vt: "i32", ten: "str") -> "i32":
    sau = 0
    i = vt
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
        if tok_kind(i) == "DED":
            sau = sau - 1
            if sau < 0:
                return 0
        if sau == 0 and tok_kind(i) == "NAME" and dau_dong_tok(i) == 1:
            v_i = tok_val(i)
            if v_i == ten:
                return 1
            if v_i != "except" and v_i != "else" and v_i != "finally":
                return 0
        i = i + 1
    return 0


def phat_than_finally(n_done: "i32") -> "i32":
    global TRY_SAU
    an()
    can_op(":")
    ra("    finally")
    ra("    {")
    TRY_SAU = TRY_SAU + 1
    khoi()
    TRY_SAU = TRY_SAU - 1
    ra("    endfinally")
    ra("    }")
    ra("  L" + str(n_done) + ":")
    return 1


def lenh_thu() -> "i32":
    global TRY_SAU
    global VT
    co_ex = nhanh_try_co(VT, "except")
    co_el = nhanh_try_co(VT, "else")
    co_fin = nhanh_try_co(VT, "finally")
    n_ket = nhan_moi()
    n_el = n_ket
    if co_el == 1:
        n_el = nhan_moi()
    n_done = n_ket
    if co_fin == 1:
        n_done = nhan_moi()
    can_op(":")
    # `try/finally` KHONG co `except`: mot `.try` DUY NHAT. Tuyet doi khong
    # phat `catch` mac dinh o day - no se NUOT ngoai le, trong khi Python
    # thi `finally` chay xong roi ngoai le BAY TIEP.
    if co_fin == 1 and co_ex == 0:
        ra("    .try")
        ra("    {")
        TRY_SAU = TRY_SAU + 1
        khoi()
        TRY_SAU = TRY_SAU - 1
        ra("    leave L" + str(n_done))
        ra("    }")
        phat_than_finally(n_done)
        return 1
    # Co `except`. Kem `finally` thi phai LONG: CIL khong cho mot `.try`
    # vua co catch vua co finally.
    if co_fin == 1:
        ra("    .try")
        ra("    {")
    ra("    .try")
    ra("    {")
    TRY_SAU = TRY_SAU + 1
    khoi()
    TRY_SAU = TRY_SAU - 1
    # `else` cua `try` chay khi KHONG co ngoai le. Cho than `try` nhay toi
    # mot nhan RIENG dat SAU cac khoi catch: nho vay than `else` nam NGOAI
    # khoi bao ve, dung ngu nghia Python (ngoai le tu `else` KHONG bi cac
    # `except` cua chinh lenh nay bat). Don than `else` vao cuoi khoi `try`
    # thi sai, va sai am tham - hat giong bat `System.Exception` nen no se
    # nuot ngoai le cua `else`.
    ra("    leave L" + str(n_el))
    ra("    }")
    co_nhanh = 0
    # MOT khoi catch cho MOI nhanh except (2026-09-25): ngoai le vao bien tam
    # `__ngoai_le`, tung nhanh thu loai bang isinst; khong nhanh nao khop thi
    # `rethrow`. Truoc day moi nhanh la `catch System.Exception` - bat MOI
    # thu, nen `except KeyError` nuot ca SyntaxError (SAI AM THAM).
    if la_ten("except") == 1:
        co_nhanh = 1
        ra("    catch [mscorlib]System.Exception")
        ra("    {")
        luu_ten("__ngoai_le")
    while la_ten("except") == 1:
        an()
        n_than = nhan_moi()
        n_sau = nhan_moi()
        ten_e = doc_nhanh_except(n_than, n_sau)
        can_op(":")
        ra("  L" + str(n_than) + ":")
        if len(ten_e) > 0:
            nap_ten("__ngoai_le")
            ke = kieu_ten(ten_e)
            # '__exc' (bat o nhieu lop): giu nguyen doi tuong System.Exception.
            if ke != "__exc":
                if tim_lop(ke) >= 0:
                    ra("    castclass " + ke)
                else:
                    ra("    callvirt instance string [mscorlib]System.Exception::get_Message()")
            luu_ten(ten_e)
        TRY_SAU = TRY_SAU + 1
        khoi()
        TRY_SAU = TRY_SAU - 1
        ra("    leave L" + str(n_ket))
        ra("  L" + str(n_sau) + ":")
    if co_nhanh == 1:
        ra("    rethrow")
        ra("    }")
    if co_nhanh == 0:
        ra("    catch [mscorlib]System.Exception")
        ra("    {")
        ra("    pop")
        ra("    leave L" + str(n_ket))
        ra("    }")
    if co_el == 1:
        ra("  L" + str(n_el) + ":")
        an()
        can_op(":")
        TRY_SAU = TRY_SAU + 1
        khoi()
        TRY_SAU = TRY_SAU - 1
    ra("  L" + str(n_ket) + ":")
    if co_fin == 1:
        ra("    leave L" + str(n_done))
        ra("    }")
        phat_than_finally(n_done)
    return 1


def lenh_neu() -> "i32":
    phat_chan_ly(bt())
    n_khac = nhan_moi()
    ra("    brfalse L" + str(n_khac))
    can_op(":")
    khoi()
    if la_ten("elif") == 1:
        # 'elif' = 'else' chua dung mot 'if' - khong can may moc rieng.
        n_ket = nhan_moi()
        ra("    br L" + str(n_ket))
        ra("  L" + str(n_khac) + ":")
        an()
        lenh_neu()
        ra("  L" + str(n_ket) + ":")
        return 1
    if la_ten("else") == 1:
        n_ket = nhan_moi()
        ra("    br L" + str(n_ket))
        ra("  L" + str(n_khac) + ":")
        an()
        can_op(":")
        khoi()
        ra("  L" + str(n_ket) + ":")
        return 1
    ra("  L" + str(n_khac) + ":")
    return 1


def thoat_day(n: "i32", n_dau: "i32") -> "i32":
    global THOAT
    global TIEP
    global THOAT_N
    global THOAT_TRY
    global TRY_SAU
    if THOAT_N == len(THOAT):
        THOAT.append(n)
        TIEP.append(n_dau)
        THOAT_TRY.append(TRY_SAU)
    else:
        THOAT[THOAT_N] = n
        TIEP[THOAT_N] = n_dau
        THOAT_TRY[THOAT_N] = TRY_SAU
    THOAT_N = THOAT_N + 1
    return THOAT_N


# for <ten> in <ds hoac range(..)>:
# Hai bien an duoc dat ten theo CHI SO TOKEN cua tu khoa 'for', nen tien quet
# va luc phat sinh ra cung mot ten - khong can bang phu tro nao.
def ten_an_ds(vt: "i32") -> "str":
    return "__ds_" + str(vt)


def ten_an_i(vt: "i32") -> "str":
    return "__i_" + str(vt)


def ten_an_ds2(vt: "i32") -> "str":
    return "__ds2_" + str(vt)


# Vi tri dau phay o DO SAU 0 trong [tu, ket); -1 neu khong co.
def tim_phay_ngoai(tu: "i32", ket: "i32") -> "i32":
    sau = 0
    i = tu
    while i < ket:
        if tok_kind(i) == "OP":
            o = tok_val(i)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
            if o == "," and sau == 0:
                return i
        i = i + 1
    return -1


# Dang cua ve phai mot vong lap NHIEU BIEN, tinh tu tu khoa 'in' tai vt_in:
# 1 = enumerate(E), 3 = zip(A, B), 0 = danh sach cac tuple.
def dang_lap(vt_in: "i32") -> "i32":
    j = vt_in + 1
    sau = 0
    while tok_kind(j) != "NL" and tok_kind(j) != "EOF":
        if tok_kind(j) == "OP":
            o = tok_val(j)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
            if o == ":" and sau == 0:
                if tok_val(j - 1) == ")" and tok_val(j - 2) == "(" and tok_val(j - 3) == "items" and tok_val(j - 4) == ".":
                    return 2
                j = vt_in
                break
        j = j + 1
    if tok_kind(vt_in + 1) == "NAME" and tok_kind(vt_in + 2) == "OP":
        if tok_val(vt_in + 2) == "(":
            if tok_val(vt_in + 1) == "enumerate":
                return 1
            if tok_val(vt_in + 1) == "zip":
                return 3
    return 0


def lenh_cho(vt_for: "i32") -> "i32":
    global THOAT_N
    global LOC_KIEU
    global VT
    bien = v()
    an()
    if la_op(",") == 1:
        ds_b = bien
        while khop_op(",") == 1:
            if la_op("(") == 1:
                # O LONG: `for i, (a, b) in ...`. Gom cac ten con lai, ngan
                # cach '~' - xem `co_nhom`/`luu_nhom`.
                an()
                nhom = v()
                an()
                while khop_op(",") == 1:
                    nhom = nhom + "~" + v()
                    an()
                can_op(")")
                ds_b = ds_b + "|" + nhom
            else:
                ds_b = ds_b + "|" + v()
                an()
        return lenh_cho_tup(vt_for, ds_b)
    if la_ten("in") == 0:
        em_loi("cho doi 'in' trong 'for'")
        return 0
    an()
    n_dau = nhan_moi()
    n_tiep = nhan_moi()
    n_ket = nhan_moi()
    ten_i = ten_an_i(vt_for)
    la_range = 0
    if la_ten("range") == 1:
        la_range = 1
        an()
        can_op("(")
        # 'bien' la BIEN DEM, 'ten_i' la GIOI HAN. Khong duoc lan hai vai tro nay.
        bt()
        luu_ten(bien)
        if khop_op(",") == 1:
            bt()
            luu_ten(ten_i)
        else:
            nap_ten(bien)
            luu_ten(ten_i)
            ra("    ldc.i4.0")
            luu_ten(bien)
        can_op(")")
    else:
        ten_ds = ten_an_ds(vt_for)
        if la_op("(") == 1 and la_tuple_hien(VT) == 1:
            bt_ds_ngoac()
        else:
            k_ng = bt()
            if la_dict(k_ng) == 1:
                # PHAI khop y het nhanh tuong ung trong `khai_cho_don`.
                k_khoa = cat_hai(ruot(k_ng), 1)
                ra("    callvirt instance class [mscorlib]System.Collections.Generic.Dictionary`2/KeyCollection<!0, !1> " + il_kieu(k_ng) + "::get_Keys()")
                ra("    newobj instance void " + il_kieu("list[" + k_khoa + "]") + "::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
            if la_set(k_ng) == 1:
                ra("    newobj instance void " + il_kieu("list[" + ruot(k_ng) + "]") + "::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
        luu_ten(ten_ds)
        ra("    ldc.i4.0")
        luu_ten(ten_i)
    can_op(":")
    ra("  L" + str(n_dau) + ":")
    if la_range == 1:
        nap_ten(bien)
        nap_ten(ten_i)
        ra("    clt")
    else:
        ten_ds = ten_an_ds(vt_for)
        nap_ten(ten_i)
        goc = nap_ten(ten_ds)
        # DUYET CHUOI (2026-09-25): 'for c in s' tung phat get_Count/get_Item
        # cua List len mot string - MissingMethodException luc chay.
        if goc == "str":
            ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
        else:
            ra("    callvirt instance int32 " + il_kieu(goc) + "::get_Count()")
        ra("    clt")
    ra("    brfalse L" + str(n_ket))
    if la_range == 0:
        ten_ds = ten_an_ds(vt_for)
        goc = nap_ten(ten_ds)
        nap_ten(ten_i)
        if goc == "str":
            ra("    callvirt instance char [mscorlib]System.String::get_Chars(int32)")
            ra("    call string [mscorlib]System.Char::ToString(char)")
        else:
            ra("    callvirt instance !0 " + il_kieu(goc) + "::get_Item(int32)")
        luu_ten(bien)
    thoat_day(n_ket, n_tiep)
    khoi()
    THOAT_N = THOAT_N - 1
    ra("  L" + str(n_tiep) + ":")
    if la_range == 1:
        nap_ten(bien)
        ra("    ldc.i4.1")
        ra("    add")
        luu_ten(bien)
    else:
        nap_ten(ten_i)
        ra("    ldc.i4.1")
        ra("    add")
        luu_ten(ten_i)
    ra("    br L" + str(n_dau))
    ra("  L" + str(n_ket) + ":")
    return 1


# 'for a, b in ...': ba dang - enumerate(E), zip(A, B), va danh sach tuple.
# Tat ca deu chay bang CHI SO nen khong can iterator.
# Nap nguon lap len bien an. Tach RIENG khoi lenh_cho_tup: chuoi if/else long
# sau + ghi bien toan cuc tung lam trinh bien dich chu sinh ma sai am tham.
# Nguon lap la CHUOI: doi thanh List<string> tung ky tu (2026-09-25) - vong
# enumerate/zip duyet bang get_Count/get_Item, len string thi MissingMethod.
def nguon_ky_tu(t: "str") -> "i32":
    if t == "str":
        ra("    call class [mscorlib]System.Collections.Generic.List`1<string> Tkv::__ds_ky_tu(string)")
    return 1


def lap_nap_nguon(dang: "i32", ten_ds: "str", ten_ds2: "str") -> "i32":
    global BO_ITEMS
    global VT
    if dang == 1:
        an()
        can_op("(")
        nguon_ky_tu(bt())
        luu_ten(ten_ds)
        can_op(")")
        return 1
    if dang == 3:
        an()
        can_op("(")
        nguon_ky_tu(bt())
        luu_ten(ten_ds)
        can_op(",")
        nguon_ky_tu(bt())
        luu_ten(ten_ds2)
        can_op(")")
        return 1
    if dang == 2:
        BO_ITEMS = 1
        kd = bt()
        BO_ITEMS = 0
        luu_ten(ten_ds2)
        nap_ten(ten_ds2)
        kkey = cat_hai(ruot(kd), 1)
        ra("    callvirt instance class [mscorlib]System.Collections.Generic.Dictionary`2/KeyCollection<!0, !1> " + il_kieu(kd) + "::get_Keys()")
        ra("    newobj instance void " + il_kieu("list[" + kkey + "]") + "::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
        luu_ten(ten_ds)
        return 1
    if la_op("(") == 1 and la_tuple_hien(VT) == 1:
        bt_ds_ngoac()
    else:
        bt()
    luu_ten(ten_ds)
    return 1


# Vi tri token cua `for` dang duoc dich - chi de dat ten bien tam cho o
# long. Vong lap long nhau van dung vi moi cap for/khoi() chay tuan tu.
vt_for_hien: "i32" = 0


def ten_an_nhom(vt: "i32") -> "str":
    return "__nhom_" + str(vt)


def co_nhom(o: "str") -> "i32":
    """O nay co phai mot NHOM long (`(a, b)`) khong."""
    i = 0
    while i < len(o):
        if o[i] == "~":
            return 1
        i = i + 1
    return 0


def khai_nhom(o: "str", lop: "str", vt_for: "i32") -> "i32":
    """Khai cac ten con cua mot o long, kieu lay tu truong I0..In cua lop
    tuple. Kem mot bien tam giu chinh gia tri tuple."""
    global CF_KIEU
    them_loc(ten_an_nhom(vt_for), lop)
    con = o.split("~")
    j = 0
    while j < len(con):
        ti = tim_truong(lop, "I" + str(j))
        if ti >= 0:
            them_loc(con[j], CF_KIEU[ti])
        else:
            them_loc(con[j], "str")
        j = j + 1
    return 1


def luu_nhom(o: "str", lop: "str", vt_for: "i32") -> "i32":
    """Gia tri tuple dang o tren stack: cat vao bien tam roi rai ra cac
    ten con."""
    global CF_KIEU
    tam = ten_an_nhom(vt_for)
    luu_ten(tam)
    con = o.split("~")
    j = 0
    while j < len(con):
        ti = tim_truong(lop, "I" + str(j))
        if ti < 0:
            em_loi("tuple " + lop + " khong co phan tu " + str(j))
            return 0
        nap_ten(tam)
        ra("    ldfld " + il_kieu(CF_KIEU[ti]) + " " + lop + "::I" + str(j))
        luu_ten(con[j])
        j = j + 1
    return 1


# Lay phan tu thu ten_i ra cac bien vong lap.
def lap_lay_pt(dang: "i32", ds_b: "str", ten_ds: "str", ten_ds2: "str", ten_i: "str", goc: "str") -> "i32":
    global CF_KIEU
    global vt_for_hien
    ten = ds_b.split("|")
    if dang == 1:
        nap_ten(ten_i)
        luu_ten(ten[0])
        if len(ten) > 1:
            nap_ten(ten_ds)
            nap_ten(ten_i)
            ra("    callvirt instance !0 " + il_kieu(goc) + "::get_Item(int32)")
            if co_nhom(ten[1]) == 1:
                luu_nhom(ten[1], kieu_pt(goc), vt_for_hien)
            else:
                luu_ten(ten[1])
        return 1
    if dang == 2:
        nap_ten(ten_ds)
        nap_ten(ten_i)
        ra("    callvirt instance !0 " + il_kieu(goc) + "::get_Item(int32)")
        luu_ten(ten[0])
        if len(ten) > 1:
            gd = nap_ten(ten_ds2)
            nap_ten(ten[0])
            ra("    callvirt instance !1 " + il_kieu(gd) + "::get_Item(!0)")
            luu_ten(ten[1])
        return 1
    if dang == 3:
        nap_ten(ten_ds)
        nap_ten(ten_i)
        ra("    callvirt instance !0 " + il_kieu(goc) + "::get_Item(int32)")
        luu_ten(ten[0])
        if len(ten) > 1:
            g2 = nap_ten(ten_ds2)
            nap_ten(ten_i)
            ra("    callvirt instance !0 " + il_kieu(g2) + "::get_Item(int32)")
            luu_ten(ten[1])
        return 1
    lop = kieu_pt(goc)
    if tim_lop(lop) < 0:
        em_loi("vong lap nhieu bien can danh sach tuple, gap " + goc)
        return 0
    j = 0
    while j < len(ten):
        ti = tim_truong(lop, "I" + str(j))
        if ti < 0:
            em_loi("tuple " + lop + " khong co phan tu " + str(j))
            return 0
        nap_ten(ten_ds)
        nap_ten(ten_i)
        ra("    callvirt instance !0 " + il_kieu(goc) + "::get_Item(int32)")
        ra("    ldfld " + il_kieu(CF_KIEU[ti]) + " " + lop + "::I" + str(j))
        if co_nhom(ten[j]) == 1:
            luu_nhom(ten[j], CF_KIEU[ti], vt_for_hien)
        else:
            luu_ten(ten[j])
        j = j + 1
    return 1


# 'for a, b in ...': enumerate(E), zip(A, B), d.items(), hoac danh sach tuple.
# Tat ca deu chay bang CHI SO nen khong can iterator.
def lenh_cho_tup(vt_for: "i32", ds_b: "str") -> "i32":
    global THOAT_N
    global VT
    global vt_for_hien
    vt_for_hien = vt_for
    vt_in = VT
    if la_ten("in") == 0:
        em_loi("cho doi 'in' trong 'for'")
        return 0
    an()
    dang = dang_lap(vt_in)
    ten_ds = ten_an_ds(vt_for)
    ten_ds2 = ten_an_ds2(vt_for)
    ten_i = ten_an_i(vt_for)
    lap_nap_nguon(dang, ten_ds, ten_ds2)
    ra("    ldc.i4.0")
    luu_ten(ten_i)
    can_op(":")
    n_dau = nhan_moi()
    n_tiep = nhan_moi()
    n_ket = nhan_moi()
    ra("  L" + str(n_dau) + ":")
    nap_ten(ten_i)
    goc = nap_ten(ten_ds)
    ra("    callvirt instance int32 " + il_kieu(goc) + "::get_Count()")
    ra("    clt")
    ra("    brfalse L" + str(n_ket))
    # `zip(a, b)` dung theo ben NGAN hon, dung nhu Python. Truoc day vong
    # lap chi so voi Count cua danh sach THU NHAT, nen `zip` tren hai danh
    # sach lech do dai nem ArgumentOutOfRangeException LUC CHAY - khong
    # mot loi dich nao bao. Probe doi chieu CPython moi lo ra.
    if dang == 3:
        nap_ten(ten_i)
        goc2 = nap_ten(ten_ds2)
        ra("    callvirt instance int32 " + il_kieu(goc2) + "::get_Count()")
        ra("    clt")
        ra("    brfalse L" + str(n_ket))
    lap_lay_pt(dang, ds_b, ten_ds, ten_ds2, ten_i, goc)
    thoat_day(n_ket, n_tiep)
    khoi()
    THOAT_N = THOAT_N - 1
    ra("  L" + str(n_tiep) + ":")
    nap_ten(ten_i)
    ra("    ldc.i4.1")
    ra("    add")
    luu_ten(ten_i)
    ra("    br L" + str(n_dau))
    ra("  L" + str(n_ket) + ":")
    return 1


def lenh_lap() -> "i32":
    global THOAT_N
    n_dau = nhan_moi()
    n_ket = nhan_moi()
    ra("  L" + str(n_dau) + ":")
    phat_chan_ly(bt())
    ra("    brfalse L" + str(n_ket))
    can_op(":")
    thoat_day(n_ket, n_dau)
    khoi()
    THOAT_N = THOAT_N - 1
    ra("    br L" + str(n_dau))
    ra("  L" + str(n_ket) + ":")
    return 1


def lenh_gan(ten: "str") -> "i32":
    global MONG
    global SO_THAM
    global GV_KIEU
    global LOC_KIEU
    global VT
    j = tim_loc(ten)
    if j < 0:
        gi = tim_gv(ten)
        if gi < 0:
            em_loi("gan cho ten chua khai: " + ten)
            return 0
        bt()
        ra("    stsfld " + il_kieu(GV_KIEU[gi]) + " Tkv::" + ten_il(ten))
        return 1
    MONG = LOC_KIEU[j]
    if la_op("[") == 1 and tok_kind(VT + 1) == "OP" and tok_val(VT + 1) == "]":
        an()
        an()
        ra("    newobj instance void " + il_kieu(LOC_KIEU[j]) + "::.ctor()")
    else:
        t_gan = bt()
        # LUOI AN TOAN (2026-09-25): container KHAC kieu da khai cua bien la
        # SAI AM THAM (List<string> cat vao o List<int32> -> AccessViolation
        # luc chay, `kw_names` o tkv_expr). Bao loi thay vi phat stloc.
        if la_chua(t_gan) == 1 and la_chua(LOC_KIEU[j]) == 1 and chuan_tup(t_gan) != chuan_tup(LOC_KIEU[j]):
            em_loi("gan kieu " + t_gan + " vao bien '" + ten + "' da khai kieu " + LOC_KIEU[j])
    if j < SO_THAM:
        ra("    starg.s " + str(j))
    else:
        ra("    stloc.s " + str(j - SO_THAM))
    return 1


# a, b = <bt> : cat tuple vao mot bien an roi lay tung truong ra.
# 'a, b = x, y' - GAN SONG SONG, khong co tuple nao ca. Phai tinh HET ve
# phai roi moi cat, neu khong 'a, b = b, a' se sai.
def lenh_gan_song_song(vt_dau: "i32") -> "i32":
    global VT
    ds = ""
    dem = 0
    while k() == "NAME":
        if dem > 0:
            ds = ds + "|"
        ds = ds + v()
        dem = dem + 1
        an()
        if khop_op(",") == 0:
            break
    if khop_op("=") == 0:
        em_loi("cho doi '=' trong phep gan song song")
        return 0
    # MONG theo TUNG bien dich (2026-09-25): 'a, b = None, None' (a: str) tung
    # phat ldc.i4.0; 'x, d = d, []' tao [] sai kieu - cat nham kieu vao o nho.
    ten = ds.split("|")
    so = 0
    dat_mong_song_song(ten, so)
    bt()
    while khop_op(",") == 1:
        so = so + 1
        dat_mong_song_song(ten, so)
        bt()
    i = len(ten) - 1
    while i >= 0:
        luu_ten(ten[i])
        i = i - 1
    return 1


def dat_mong_song_song(ten: "list[str]", so: "i32") -> "i32":
    global MONG
    MONG = ""
    if so < len(ten):
        j = tim_loc(ten[so])
        if j >= 0:
            MONG = LOC_KIEU[j]
    return 1


def lenh_thao_tup(vt_dau: "i32") -> "i32":
    global LOC_KIEU
    global CF_KIEU
    global VT
    vt_b = tim_bang(vt_dau)
    if vt_b > 0:
        if co_phay_ngoai(vt_b + 1, cuoi_dong(vt_b)) == 1:
            return lenh_gan_song_song(vt_dau)
    an_ten = ten_an_tup(vt_dau)
    j = tim_loc(an_ten)
    if j < 0:
        em_loi("tien quet khong khai duoc bien an cho phep thao tuple")
        return 0
    lop = LOC_KIEU[j]
    ds_ten = ""
    dem = 0
    while k() == "NAME":
        if dem > 0:
            ds_ten = ds_ten + "|"
        ds_ten = ds_ten + v()
        dem = dem + 1
        an()
        if khop_op(",") == 0:
            break
    if khop_op("=") == 0:
        em_loi("cho doi '=' trong phep thao tuple")
        return 0
    bt()
    luu_ten(an_ten)
    phan = ds_ten.split("|")
    i = 0
    while i < len(phan):
        if la_list(lop) == 1:
            nap_ten(an_ten)
            ra("    ldc.i4 " + str(i))
            ra("    callvirt instance !0 " + il_kieu(lop) + "::get_Item(int32)")
            luu_ten(phan[i])
        else:
            ti = tim_truong(lop, "I" + str(i))
            if ti < 0:
                em_loi("tuple " + lop + " khong co phan tu " + str(i))
                return 0
            nap_ten(an_ten)
            ra("    ldfld " + il_kieu(CF_KIEU[ti]) + " " + lop + "::I" + str(i))
            luu_ten(phan[i])
        i = i + 1
    return 1


# Cat gia tri dang o dinh ngan xep vao 'ten'.
def luu_ten(ten: "str") -> "i32":
    global SO_THAM
    global GV_KIEU
    j = tim_loc(ten)
    if j < 0:
        gi = tim_gv(ten)
        if gi < 0:
            em_loi("gan cho ten chua khai: " + ten)
            return 0
        ra("    stsfld " + il_kieu(GV_KIEU[gi]) + " Tkv::" + ten_il(ten))
        return 1
    if j < SO_THAM:
        ra("    starg.s " + str(j))
    else:
        ra("    stloc.s " + str(j - SO_THAM))
    return 1


# VE TRAI cua phep gan co the la mot CHUOI hau to: self.vars[name] = ...
# Di doc tung hau to; hau to NAO co dau '=' ngay sau thi do la dich den,
# moi thu truoc no chi la phep DOC.
def lenh_chuoi(ten: "str") -> "i32":
    global MONG
    global CF_KIEU
    global VT
    goc = nap_ten(ten)
    con = 1
    while con == 1:
        if la_op(".") == 1:
            if tok_kind(VT + 2) == "OP" and (tok_val(VT + 2) == "+=" or tok_val(VT + 2) == "-="):
                truong = tok_val(VT + 1)
                o = tok_val(VT + 2)
                ti = tim_truong(goc, truong)
                if ti < 0:
                    em_loi("lop " + goc + " khong co truong '" + truong + "'")
                    return 0
                an()
                an()
                an()
                ra("    dup")
                ra("    ldfld " + il_kieu(CF_KIEU[ti]) + " " + goc + "::" + ten_il(truong))
                bt()
                if o == "+=":
                    if CF_KIEU[ti] == "str":
                        ra("    call string [mscorlib]System.String::Concat(string, string)")
                    else:
                        ra("    add")
                else:
                    ra("    sub")
                ra("    stfld " + il_kieu(CF_KIEU[ti]) + " " + goc + "::" + ten_il(truong))
                return 1
            if tok_kind(VT + 2) == "OP" and tok_val(VT + 2) == "=":
                truong = tok_val(VT + 1)
                an()
                an()
                an()
                ti = tim_truong(goc, truong)
                if ti < 0:
                    em_loi("lop " + goc + " khong co truong '" + truong + "'")
                    return 0
                MONG = CF_KIEU[ti]
                kiem_gan_truong(bt(), CF_KIEU[ti], goc, truong)
                ra("    stfld " + il_kieu(CF_KIEU[ti]) + " " + goc + "::" + ten_il(truong))
                return 1
            an()
            goc = hau_to_method(goc)
        else:
            if la_op("(") == 1 and bat_dau_bang(goc, "func(") == 1:
                an()
                goc = hau_to_invoke(goc)
            else:
                if la_op("[") == 1:
                    ket = qua_ngoac(VT)
                    if tok_kind(ket) == "OP" and (tok_val(ket) == "+=" or tok_val(ket) == "-="):
                        return gan_cong_chi_so(goc, VT)
                    if tok_kind(ket) == "OP" and tok_val(ket) == "=":
                        # `rec['ten_truong'] = v` -> GHI TRUONG. Doi xung
                        # voi phep DOC `rec.get('ten_truong')` da co: cay
                        # con hang tram cho viet `ctx` theo kieu tu dien tu
                        # thoi no con la dict that, va dang chuyen dan sang
                        # `ctx.x`. Cung DIEU KIEN chat nhu ben doc: MOT khoa
                        # la HANG CHUOI khop dung ten mot truong; moi dang
                        # khac roi xuong duong cu.
                        if tim_lop(goc) >= 0 and tok_kind(VT + 1) == "STR" and tok_kind(VT + 2) == "OP" and tok_val(VT + 2) == "]":
                            _tt_g = tok_val(VT + 1)
                            _ti_g = tim_truong(goc, _tt_g)
                            if _ti_g >= 0:
                                an()
                                an()
                                can_op("]")
                                can_op("=")
                                MONG = CF_KIEU[_ti_g]
                                bt()
                                ra("    stfld " + il_kieu(CF_KIEU[_ti_g]) + " " + goc + "::" + ten_il(_tt_g))
                                return 1
                        an()
                        # MONG cho khoa va ve phai - xem lenh_gan_chi_so.
                        if la_dict(goc) == 1:
                            MONG = cat_hai(ruot(goc), 1)
                        else:
                            MONG = "i32"
                        bt()
                        can_op("]")
                        can_op("=")
                        MONG = kieu_pt(goc)
                        bt()
                        if la_dict(goc) == 1:
                            ra("    callvirt instance void " + il_kieu(goc) + "::set_Item(!0, !1)")
                            return 1
                        if la_list(goc) == 0:
                            em_loi("chi gan duoc qua chi so tren danh sach/tu dien")
                            return 0
                        ra("    callvirt instance void " + il_kieu(goc) + "::set_Item(int32, !0)")
                        return 1
                    an()
                    goc = hau_to_chi_so(goc, VT - 1)
                else:
                    con = 0
    # Chuoi ket thuc ma khong co phep gan: la mot cau lenh bieu thuc.
    if goc != "void":
        ra("    pop")
    return 1


# a[i] += <bt>. Doi tuong dang o tren ngan xep; dung hai bien an vi khong
# the nhan doi CA doi tuong lan chi so bang dup.
def gan_cong_chi_so(goc: "str", vt_lb: "i32") -> "i32":
    global VT
    ni = ten_ix(vt_lb, "i")
    nv = ten_ix(vt_lb, "v")
    if tim_loc(ni) < 0:
        em_loi("tien quet khong khai duoc bien an cho '+=' qua chi so")
        return 0
    an()
    bt()
    luu_ten(ni)
    can_op("]")
    o = v()
    an()
    ra("    dup")
    nap_ten(ni)
    if la_dict(goc) == 1:
        ra("    callvirt instance !1 " + il_kieu(goc) + "::get_Item(!0)")
    else:
        ra("    callvirt instance !0 " + il_kieu(goc) + "::get_Item(int32)")
    kpt = kieu_pt(goc)
    bt()
    if o == "+=":
        if kpt == "str":
            ra("    call string [mscorlib]System.String::Concat(string, string)")
        else:
            ra("    add")
    else:
        ra("    sub")
    jv = tim_loc(nv)
    if jv >= 0 and chuan_tup(LOC_KIEU[jv]) != chuan_tup(kpt):
        em_loi("'" + o + "' qua chi so: bien an kieu " + LOC_KIEU[jv] + " nhung phan tu kieu " + kpt)
    luu_ten(nv)
    nap_ten(ni)
    nap_ten(nv)
    if la_dict(goc) == 1:
        ra("    callvirt instance void " + il_kieu(goc) + "::set_Item(!0, !1)")
    else:
        ra("    callvirt instance void " + il_kieu(goc) + "::set_Item(int32, !0)")
    return 1


# a[i] = <bt>  (a phai la danh sach; chuoi bat bien nen bi tu choi)
def lenh_gan_chi_so(ten: "str") -> "i32":
    global MONG
    goc = nap_ten(ten)
    # Kieu MONG DOI cho khoa va ve phai (2026-09-25): truoc day khong dat, nen
    # 'd[k] = []' lay MONG CON SOT (vd kieu tra ve cua ham, 'ChuongTrinh') va
    # sinh newobj ChuongTrinh::.ctor() - MissingMethodException LUC CHAY.
    if la_dict(goc) == 1:
        MONG = cat_hai(ruot(goc), 1)
    else:
        MONG = "i32"
    bt()
    can_op("]")
    can_op("=")
    MONG = kieu_pt(goc)
    bt()
    if la_dict(goc) == 1:
        ra("    callvirt instance void " + il_kieu(goc) + "::set_Item(!0, !1)")
        return 1
    if la_list(goc) == 0:
        em_loi("chi gan duoc qua chi so tren danh sach/tu dien")
        return 0
    ra("    callvirt instance void " + il_kieu(goc) + "::set_Item(int32, !0)")
    return 1


# a.append(<bt>)
def lenh_them(ten: "str") -> "i32":
    global MONG
    global CF_KIEU
    goc = nap_ten(ten)
    ten_pt = v()
    an()
    if tim_lop(goc) >= 0:
        if la_op("(") == 1:
            an()
            t = hau_to_goi_met(goc, ten_pt)
            if t != "void":
                ra("    pop")
            return 1
        ti = tim_truong(goc, ten_pt)
        if ti < 0:
            em_loi("lop " + goc + " khong co truong '" + ten_pt + "'")
            return 0
        if khop_op("=") == 0:
            em_loi("cho doi '=' sau truong '" + ten_pt + "'")
            return 0
        MONG = CF_KIEU[ti]
        kiem_gan_truong(bt(), CF_KIEU[ti], goc, ten_pt)
        ra("    stfld " + il_kieu(CF_KIEU[ti]) + " " + goc + "::" + ten_il(ten_pt))
        return 1
    if ten_pt != "append" and ten_pt != "add":
        em_loi("chi ho tro .append() / .add(), gap ." + ten_pt)
        return 0
    can_op("(")
    # Kieu DANG CHO = kieu phan tu (2026-09-24): lambda them vao
    # `list[func()->void]` phai dung delegate void, khong phai i32.
    MONG = kieu_pt(goc)
    bt()
    can_op(")")
    if la_set(goc) == 1:
        ra("    callvirt instance bool " + il_kieu(goc) + "::Add(!0)")
        ra("    pop")
        return 1
    if la_list(goc) == 0:
        em_loi(".append() chi dung cho danh sach")
        return 0
    ra("    callvirt instance void " + il_kieu(goc) + "::Add(!0)")
    return 1


def lenh_ghi_tep() -> "i32":
    can_op("(")
    bt()
    can_op(",")
    bt()
    can_op(")")
    ra("    call void [mscorlib]System.IO.File::WriteAllText(string, string)")
    return 1


def lenh_toan_cuc() -> "i32":
    while k() != "NL" and k() != "EOF":
        an()
    return 1


# `del x[:]` (xoa sach mot danh sach) va `del d[k]` (xoa mot khoa cua tu
# dien). Ben nhan la mot TEN hoac `ten.truong` (vd `del self.vars[k]`).
def lenh_xoa() -> "i32":
    global MONG
    ten = v()
    an()
    goc = nap_ten(ten)
    while la_op(".") == 1:
        an()
        truong = v()
        an()
        goc = hau_to_truong(goc, truong)
    if khop_op("[") == 0:
        em_loi("chi ho tro 'del x[:]' hoac 'del d[k]'")
        return 0
    if la_dict(goc) == 1:
        MONG = cat_hai(ruot(goc), 1)
        bt()
        can_op("]")
        ra("    callvirt instance bool " + il_kieu(goc) + "::Remove(!0)")
        ra("    pop")
        return 1
    if khop_op(":") == 0:
        em_loi("chi ho tro 'del x[:]' (xoa sach)")
        return 0
    can_op("]")
    if la_list(goc) == 0:
        em_loi("del x[:] chi dung cho danh sach")
        return 0
    ra("    callvirt instance void " + il_kieu(goc) + "::Clear()")
    return 1


# raise Loai("thong diep") - hat giong nem Exception tron, khong phan loai.
def lenh_nem() -> "i32":
    global MONG
    # `raise` tran: nem lai ngoai le dang xu ly (chi hop le trong except).
    if k() == "NL" or k() == "EOF" or k() == "DED":
        ra("    rethrow")
        return 1
    # `raise TenDungSan(msg)`: kieu CLR cua bang exc_dung_san.
    if k() == "NAME" and tim_lop(v()) < 0 and tok_kind(VT + 1) == "OP" and tok_val(VT + 1) == "(":
        il = exc_dung_san(v())
        if il == "":
            em_loi("raise " + v() + ": khong phai loai ngoai le da biet")
            il = "[mscorlib]System.Exception"
        an()
        an()
        if la_op(")") == 1:
            ra("    ldstr \"\"")
        else:
            MONG = "str"
            t = bt()
            if t != "str":
                em_loi("thong diep ngoai le phai la chuoi, gap " + t)
        can_op(")")
        ra("    newobj instance void " + il + "::.ctor(string)")
        ra("    throw")
        return 1
    # Con lai: lop tu dinh nghia `LoiX(...)` hoac mot BIEN giu ngoai le.
    t = bt()
    if la_ngoai_le(t) == 0:
        em_loi("raise can mot ngoai le, gap " + t)
    ra("    throw")
    return 1


# Nhay ra khoi vong lap: neu dang o TRONG mot .try sau hon luc vao vong lap
# thi phai dung 'leave', 'br' la IL khong hop le.
def lenh_nhay(muc: "i32") -> "str":
    global THOAT_TRY
    global TRY_SAU
    if TRY_SAU > THOAT_TRY[muc]:
        return "leave"
    return "br"


def lenh_tiep() -> "i32":
    global TIEP
    global THOAT_N
    if THOAT_N <= 0:
        em_loi("continue nam ngoai vong lap")
        return 0
    ra("    " + lenh_nhay(THOAT_N - 1) + " L" + str(TIEP[THOAT_N - 1]))
    return 1


def lenh_thoat() -> "i32":
    global THOAT
    global THOAT_N
    if THOAT_N <= 0:
        em_loi("break nam ngoai vong lap")
        return 0
    ra("    " + lenh_nhay(THOAT_N - 1) + " L" + str(THOAT[THOAT_N - 1]))
    return 1


def mot_lenh() -> "i32":
    global VT
    global MONG
    global GEN_KIEU
    global GEN_DS
    if k() == "STR":
        # Cau lenh chi gom mot chuoi = docstring: bo qua.
        an()
        return 1
    if la_ten("yield") == 1:
        an()
        if GEN_KIEU == "":
            em_loi("'yield' chi dung duoc trong ham co khai kieu phan tu")
            return 0
        nap_ten("__gen")
        MONG = GEN_KIEU
        mo_ta = bt()
        if la_op(",") == 1:
            # `yield a, b` - tuple khong ngoac, dung y het `return a, b`.
            while khop_op(",") == 1:
                mo_ta = mo_ta + "|" + bt()
            bt_tao_tup(dang_ky_tup(mo_ta))
        ra("    callvirt instance void " + il_kieu(GEN_DS) + "::Add(!0)")
        return 1
    if k() == "NAME":
        ten = v()
        if ten == "return":
            an()
            lenh_tra_ve()
            return 1
        if ten == "if":
            an()
            lenh_neu()
            return 1
        if ten == "while":
            an()
            lenh_lap()
            return 1
        if ten == "for":
            vt_for = VT
            an()
            lenh_cho(vt_for)
            return 1
        if ten == "def":
            VT = cuoi_khoi_def(VT)
            return 1
        if ten == "pass":
            an()
            return 1
        if ten == "print":
            an()
            lenh_in()
            return 1
        if ten == "global":
            an()
            lenh_toan_cuc()
            return 1
        if ten == "nonlocal":
            # Chi con gap trong def long DA NANG (nonlocal CHI DOC - xem
            # nonlocal_bi_gan): bien bat da la tham so, khai bao vo nghia.
            while tok_kind(VT) != "NL" and tok_kind(VT) != "EOF":
                an()
            return 1
        if ten == "break":
            an()
            lenh_thoat()
            return 1
        if ten == "continue":
            an()
            lenh_tiep()
            return 1
        if ten == "del":
            an()
            return lenh_xoa()
        if ten == "raise":
            an()
            return lenh_nem()
        if ten == "try":
            an()
            return lenh_thu()
        if ten == "write_file":
            an()
            lenh_ghi_tep()
            return 1
        # Khai bao cuc bo CO CHU THICH: 'x: "T" = <bt>'. Chu thich la cach
        # DUY NHAT noi duoc kieu ma suy dien khong doan ra (vd '{}' rong).
        if tok_kind(VT + 1) == "OP" and tok_val(VT + 1) == ":" and tok_kind(VT + 2) == "STR":
            if tok_kind(VT + 3) == "OP" and tok_val(VT + 3) == "=":
                an()
                an()
                an()
                an()
                lenh_gan(ten)
                return 1
        if tok_kind(VT + 1) == "OP" and tok_val(VT + 1) == ",":
            if tim_bang(VT) > 0:
                return lenh_thao_tup(VT)
        an()
        if khop_op("=") == 1:
            lenh_gan(ten)
            return 1
        if la_op("+=") == 1 or la_op("-=") == 1:
            o = v()
            an()
            kt = nap_ten(ten)
            # 'ds += <list>' (2026-09-25) = MO RONG TAI CHO (list.extend) - truoc
            # day phat `add` so nguyen len hai tham chieu: AccessViolation luc
            # chay. AddRange nhan IEnumerable nen ve phai list/set deu dung.
            if o == "+=" and la_list(kt) == 1:
                MONG = kt
                t_them = bt()
                if la_chua(t_them) == 0:
                    em_loi("'" + ten + " += ...' can mot danh sach, gap " + t_them)
                ra("    callvirt instance void " + il_kieu(kt) + "::AddRange(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
                return 1
            bt()
            if o == "+=":
                if kt == "str":
                    ra("    call string [mscorlib]System.String::Concat(string, string)")
                else:
                    ra("    add")
            else:
                ra("    sub")
            return luu_ten(ten)
        if la_op("[") == 1 or la_op(".") == 1:
            return lenh_chuoi(ten)
        if khop_op("(") == 1:
            kb = kieu_ten(ten)
            if bat_dau_bang(kb, "func(") == 1:
                nap_ten(ten)
                if hau_to_invoke(kb) != "void":
                    ra("    pop")
                return 1
            if la_builtin(ten) == 1:
                if bt_builtin(ten) != "void":
                    ra("    pop")
                return 1
            t = bt_goi(ten)
            if t != "void":
                ra("    pop")
            return 1
        em_loi("lenh khong hieu bat dau bang '" + ten + "'")
        return 0
    em_loi("lenh khong hieu bat dau bang '" + v() + "'")
    return 0


# Mot khoi = NL IND {lenh} DED, HOAC mot lenh don ngay sau ':' cung dong.
def khoi() -> "i32":
    if k() != "NL":
        # Suite MOT DONG (`if x: raise ...`). Python cho phep chuoi lenh
        # cach nhau ';', nhung ca cay nguon khong dung dang do lan nao, nen
        # o day chi nhan DUNG mot lenh - lam dung cai dang thuc su gap.
        if mot_lenh() == 0:
            while k() != "NL" and k() != "EOF":
                an()
        if k() == "NL":
            an()
        return 1
    an()
    if k() != "IND":
        em_loi("cho doi khoi thut vao")
        return 0
    an()
    while k() != "DED" and k() != "EOF":
        if mot_lenh() == 0:
            # Phuc hoi: nhay den cuoi dong. Khong bao gio duoc dung yen tai cho,
            # neu khong trinh bien dich se treo tren dau vao sai.
            while k() != "NL" and k() != "EOF" and k() != "DED":
                an()
        if k() == "NL":
            an()
    if k() == "DED":
        an()
    return 1


def tu_khoa(x: "str") -> "i32":
    if x == "elif":
        return 1
    if x == "if":
        return 1
    if x == "while":
        return 1
    if x == "for":
        return 1
    if x == "class":
        return 1
    if x == "self":
        return 1
    if x == "range":
        return 1
    if x == "return":
        return 1
    if x == "def":
        return 1
    if x == "pass":
        return 1
    if x == "print":
        return 1
    if x == "global":
        return 1
    if x == "break":
        return 1
    if x == "else":
        return 1
    if x == "len":
        return 1
    if x == "str":
        return 1
    if x == "chr":
        return 1
    if x == "ord":
        return 1
    if x == "read_file":
        return 1
    if x == "write_file":
        return 1
    if x == "sys_argv":
        return 1
    if x == "not":
        return 1
    if x == "in":
        return 1
    if x == "int":
        return 1
    if x == "continue":
        return 1
    if x == "isinstance":
        return 1
    if x == "None":
        return 1
    if x == "True":
        return 1
    if x == "False":
        return 1
    if x == "raise":
        return 1
    if x == "del":
        return 1
    if x == "and":
        return 1
    if x == "or":
        return 1
    return 0


# Luot 0: khai bao cap module 'TEN: "kieu" = ...' (chi o muc thut 0).
# Nhay toi 'def' cap dau tien ke tiep. Khong co no thi MOT ham hong lam
# hong toan bo phan con lai cua file va con so do duoc tro nen vo nghia.
def nhay_den_def() -> "i32":
    global VT
    while k() != "EOF":
        if la_ten("def") == 1:
            if tok_kind(VT - 1) == "NL":
                return 1
            if tok_kind(VT - 1) == "DED":
                return 1
        an()
    return 0


def thu_thap_toan_cuc() -> "i32":
    global GV_N
    i = 0
    sau = 0
    # Muc NGOAC (2026-09-25): trong ngoac lexer KHONG phat IND/DED, nen tham
    # so co mac dinh cua mot def cap module viet nhieu dong ('x: "set[str]"
    # =None,') truoc day bi coi la BIEN CAP MODULE - roi moi bien cuc bo
    # cung ten o ham khac bi dich thanh stsfld vao bien do (SAI AM THAM).
    ngoac = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
        if tok_kind(i) == "DED":
            sau = sau - 1
        if tok_kind(i) == "OP":
            if tok_val(i) == "(" or tok_val(i) == "[" or tok_val(i) == "{":
                ngoac = ngoac + 1
            if tok_val(i) == ")" or tok_val(i) == "]" or tok_val(i) == "}":
                ngoac = ngoac - 1
        if sau == 0 and ngoac == 0 and tok_kind(i) == "NAME":
            dau_dong = 0
            if tok_kind(i - 1) == "NL" or tok_kind(i - 1) == "DED" or i == 0:
                dau_dong = 1
            if dau_dong == 1 and tok_kind(i + 1) == "OP" and tok_val(i + 1) == ":":
                if tok_kind(i + 2) == "STR":
                    if tok_kind(i + 3) == "OP" and tok_val(i + 3) == "=":
                        them_gv(tok_val(i), tok_val(i + 2), i + 4)
            # 'X = <bt>' khong chu kieu: suy tu ve phai. Nhieu hang cap module
            # trong trinh bien dich that khong co annotation.
            if tok_kind(i + 1) == "OP" and tok_val(i + 1) == "=" and tu_khoa(tok_val(i)) == 0:
                truoc = tok_kind(i - 1)
                if truoc == "NL" or truoc == "DED" or i == 0:
                    them_gv(tok_val(i), kieu_ve_phai(i + 2), i + 2)
        i = i + 1
    return GV_N


def phat_truong_tinh() -> "i32":
    global GV_TEN
    global GV_KIEU
    global GV_VT
    global GV_N
    global VT
    global MONG
    global RET_HIEN
    i = 0
    while i < GV_N:
        ra("  .field public static " + il_kieu(GV_KIEU[i]) + " " + ten_il(GV_TEN[i]))
        i = i + 1
    ra("  .method private static specialname rtspecialname void .cctor() cil managed")
    ra("  {")
    # 64 (2026-09-25): gia tri cap module LONG NHAU (dict cua list cua tuple...)
    # xay bang chuoi `dup` - sau hon 8 thi CLR tu choi ca .cctor
    # (InvalidProgramException ngay luc nap lop Tkv).
    ra("    .maxstack 64")
    i = 0
    while i < GV_N:
        kieu = GV_KIEU[i]
        if GV_VT[i] > 0:
            # Gia tri khoi tao THAT, phat dung thu tu khai bao nhu Python.
            VT = GV_VT[i]
            MONG = kieu
            RET_HIEN = kieu
            bt()
            ra("    stsfld " + il_kieu(kieu) + " Tkv::" + ten_il(GV_TEN[i]))
            i = i + 1
            continue
        if la_chua(kieu) == 1:
            ra("    newobj instance void " + il_kieu(kieu) + "::.ctor()")
        else:
            if kieu == "str":
                ra("    ldstr \"\"")
            else:
                if kieu == "i32" or kieu == "bool":
                    ra("    ldc.i4.0")
                else:
                    ra("    ldnull")
        ra("    stsfld " + il_kieu(kieu) + " Tkv::" + ten_il(GV_TEN[i]))
        i = i + 1
    ra("    ret")
    ra("  }")
    ra("")
    return GV_N


# Luot 0b: quet 'class NAME:' - chu ky method va TEN truong.
# Kieu truong suy tu '__init__' sau khi da dang ky tham so cua ctor lam
# bien cuc bo, nen 'self.x = a' lay dung kieu cua tham so 'a'.
def quet_mot_lop(tu: "i32") -> "i32":
    global PAR_KIEU
    global PAR_N
    global LOC_N
    lop = tok_val(tu + 1)
    them_lop(lop)
    if tok_kind(tu + 2) == "OP" and tok_val(tu + 2) == "(" and tok_kind(tu + 3) == "NAME":
        dat_cha(lop, tok_val(tu + 3))
    i = tu
    sau = 0
    mo = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
            mo = 1
        if tok_kind(i) == "DED":
            sau = sau - 1
            if mo == 1 and sau <= 0:
                return i
        if sau == 1 and tok_kind(i) == "NAME" and tok_val(i) == ":":
            i = i + 1
        if sau == 1 and tok_kind(i) == "NAME":
            # Truong khai THANG trong than lop: 'ten: "kieu"' (khong co '=').
            # Dang nay dang tin hon suy tu __init__ nen ghi de len no.
            if tok_kind(i + 1) == "OP" and tok_val(i + 1) == ":":
                if tok_kind(i + 2) == "STR" and tok_kind(i + 3) == "NL":
                    them_truong(lop, tok_val(i), tok_val(i + 2))
        if tok_kind(i) == "NAME" and tok_val(i) == "def":
            # Method mang `@__tkv_cpython_only__` KHONG duoc dang ky: voi
            # TokenVector no khong ton tai (pha phat IL da bo qua no san).
            # Truoc day pha QUET van ghi no vao bang method, nen `tim_met`
            # tra ve "co" cho mot thu khong he duoc phat - vd `Ctx.get` che
            # mat duong doc truong cua `rec.get("ten_truong")`.
            # Chuoi token: '@' NAME NL 'def' - nen lui BA buoc, khong phai hai.
            if tok_kind(i - 3) == "OP" and tok_val(i - 3) == "@"                     and tok_val(i - 2) == "__tkv_cpython_only__":
                i = i + 1
                continue
            met = tok_val(i + 1)
            j = i + 3
            if tok_kind(i + 2) != "OP" or tok_val(i + 2) != "(":
                j = i + 2
            dau = PAR_N
            so = 0
            LOC_N = 0
            them_loc("self", lop)
            while tok_kind(j) == "NAME":
                pten = tok_val(j)
                pkieu = "i32"
                if tok_kind(j + 1) == "OP" and tok_val(j + 1) == ":":
                    pkieu = tok_val(j + 2)
                    j = j + 2
                vt_def = -1
                if tok_kind(j + 1) == "OP" and tok_val(j + 1) == "=":
                    vt_def = j + 2
                if pten != "self":
                    them_tham2(pten, pkieu, vt_def)
                    so = so + 1
                    them_loc(pten, pkieu)
                while tok_kind(j) != "EOF":
                    if tok_kind(j) == "OP" and tok_val(j) == ",":
                        j = j + 1
                        break
                    if tok_kind(j) == "OP" and tok_val(j) == ")":
                        break
                    j = j + 1
            ret = "i32"
            if tok_kind(j) == "OP" and tok_val(j) == ")":
                if tok_kind(j + 1) == "OP" and tok_val(j + 1) == "->":
                    ret = chuan_tup(tok_val(j + 2))
            them_met(lop, met, ret, so, dau)
            if met == "__init__":
                quet_truong(lop, j)
        i = i + 1
    return i


# Trong than __init__: moi 'self.X = ...' la mot truong.
def quet_truong(lop: "str", tu: "i32") -> "i32":
    i = tu
    sau = 0
    mo = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
            mo = 1
        if tok_kind(i) == "DED":
            sau = sau - 1
            if mo == 1 and sau <= 0:
                return i
        if tok_kind(i) == "NAME" and tok_val(i) == "self":
            if tok_kind(i + 1) == "OP" and tok_val(i + 1) == ".":
                if tok_kind(i + 3) == "OP" and tok_val(i + 3) == "=":
                    them_truong(lop, tok_val(i + 2), kieu_ve_phai(i + 4))
        i = i + 1
    return i


def thu_thap_lop() -> "i32":
    global CL_N
    i = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "NAME" and tok_val(i) == "class":
            i = quet_mot_lop(i)
        else:
            i = i + 1
    return CL_N


# Luot 1: doc moi chu ky 'def ten(a: "k", ...) -> "k":' vao bang ham.
GEN_KIEU: "str" = ""
GEN_DS: "str" = ""


def la_ham_sinh(dau: "i32", ket: "i32") -> "i32":
    """Than ham co cau lenh nao BAT DAU bang `yield` khong.

    HAT GIONG DUNG GENERATOR KIEU 'GOM TRUOC': ham sinh tra ve mot DANH SACH
    da dung xong, khong phai day luoi. Trinh bien dich THAT co generator
    luoi that (il_features/generator_lazy) - day la mot PHAN KY CO Y THUC
    cua rieng hat giong.
    An toan cho CAY NAY vi da do: ca 6 ham sinh deu la bo duyet CAY huu han
    va THUAN (khong tac dung phu), va deu duoc tieu thu bang `for ... in`.
    Mot cho co `return` som (`_body_is_safe`) - gom truoc chi ton them cong
    duyet, KET QUA y het. Voi generator VO HAN thi cach nay se TREO, nen
    neu cay sau nay co generator vo han thi PHAI bo cach nay di."""
    i = dau
    while i < ket:
        if tok_kind(i) == "NAME" and tok_val(i) == "yield" and dau_dong_tok(i) == 1:
            return 1
        i = i + 1
    return 0


def thu_thap_bi_danh() -> "i32":
    """Quet MOI lenh `from ... import ... as ...` / `import ... as ...`.

    KHONG gioi han muc thut 0: cay nay co rat nhieu import NAM TRONG than
    ham. Chi nhan lenh bat dau bang 'from'/'import' de khong nham voi
    `except E as e` (cung dung tu khoa 'as'). Ngoac mo lam lexer NOI dong
    logic nen khong co NL o giua - vong dung o NL la du cho import nhieu dong.
    """
    i = 0
    while tok_kind(i) != "EOF":
        la_nk = 0
        if tok_kind(i) == "NAME" and dau_dong_tok(i) == 1:
            if tok_val(i) == "from" or tok_val(i) == "import":
                la_nk = 1
        if la_nk == 1:
            j = i + 1
            while tok_kind(j) != "NL" and tok_kind(j) != "EOF":
                if tok_kind(j) == "NAME" and tok_val(j) == "as":
                    if tok_kind(j - 1) == "NAME" and tok_kind(j + 1) == "NAME":
                        them_bi_danh(tok_val(j + 1), tok_val(j - 1))
                j = j + 1
            i = j
        else:
            i = i + 1
    return BD_N


def thu_thap_ham() -> "i32":
    global FN_TEN
    global FN_RET
    global FN_PSO
    global FN_PDAU
    global FN_N
    global PAR_KIEU
    global PAR_N
    global VT
    VT = 0
    # Do sau khoi + "dang o trong mot def" theo tung muc (2026-09-24). Truoc
    # day MOI 'def' - ke ca def LONG KHONG duoc nang (vd co `nonlocal`) - deu
    # duoc ghi thanh ham cap 0; than cua no khong bao gio phat ra, nen loi goi
    # `trong(x)` dich SACH thanh `call Tkv::trong` toi method KHONG TON TAI ->
    # MissingMethodException luc chay (G0). Nay def long khong nang bi BO QUA:
    # goi toi no bao "goi ham chua khai" - loi that, dung cho.
    sau_k = 0
    trong_def: "list[i32]" = [0]
    cho_mo_k = 0 - 1
    while tok_kind(VT) != "EOF":
        if tok_kind(VT) == "IND":
            sau_k = sau_k + 1
            gia_tri_k = trong_def[sau_k - 1]
            if cho_mo_k == 1:
                gia_tri_k = 1
            if sau_k == len(trong_def):
                trong_def.append(gia_tri_k)
            else:
                trong_def[sau_k] = gia_tri_k
            cho_mo_k = 0 - 1
            an()
            continue
        if tok_kind(VT) == "DED":
            sau_k = sau_k - 1
            an()
            continue
        if tok_kind(VT) == "NAME" and tok_val(VT) == "class" and dau_dong_tok(VT) == 1:
            # THAN LOP khong phai cap module (2026-09-25): method ghi vao bang
            # HAM cap 0 thi CHE ham top-level cung ten - `parse_expr(s)` bi
            # goi theo chu ky cua method `_ExprParser.parse_expr()` ->
            # MissingMethodException luc chay. Method tra qua tim_met.
            cho_mo_k = 1
        # Khoi `if` CAP MODULE (vd `if __tkv_chi_cpython__:`) la phan CHI
        # CPython - trinh that bo qua lenh thut vao, hat giong cung phai bo
        # qua moi `def` ben trong (vd shim path_* dinh nghia lai cho CPython).
        if tok_kind(VT) == "NAME" and tok_val(VT) == "if" and dau_dong_tok(VT) == 1 and sau_k == 0:
            cho_mo_k = 1
        if tok_kind(VT) == "NAME" and tok_val(VT) == "def":
            if chi_so_lg_vt(VT) >= 0:
                # 'def' long da duoc dang ky rieng (co them tham so BAT DUOC)
                # nen KHONG ghi ban thieu tham so nay de khoi che ham that
                # cung ten o cap ngoai.
                VT = cuoi_khoi_def(VT)
                continue
            if trong_def[sau_k] == 1:
                VT = cuoi_khoi_def(VT)
                continue
            cho_mo_k = 1
            # TEN RIENG: `vt_def` da bi dung ben trong vong lap tham so cho
            # vi tri gia tri mac dinh, va bi ghi de truoc khi toi doc.
            vt_def_sinh = VT
            an()
            ten = v()
            an()
            if khop_op("(") == 0:
                nhay_den_def()
                continue
            dau = PAR_N
            so = 0
            if la_op(")") == 0:
                con = 1
                while con == 1:
                    pten = v()
                    an()
                    pk = "i32"
                    if la_op(":") == 1:
                        an()
                        pk = v()
                        an()
                    vt_def = -1
                    if la_op("=") == 1:
                        an()
                        vt_def = VT
                        qua_mac_dinh()
                    them_tham2(pten, pk, vt_def)
                    so = so + 1
                    if khop_op(",") == 0:
                        con = 0
            if khop_op(")") == 0:
                nhay_den_def()
                continue
            ret = "i32"
            if khop_op("->") == 1:
                ret = chuan_tup(v())
                an()
            if FN_N == len(FN_TEN):
                FN_TEN.append(ten)
                FN_RET.append(ret)
                FN_PSO.append(so)
                FN_PDAU.append(dau)
            else:
                FN_TEN[FN_N] = ten
                FN_RET[FN_N] = ret
                FN_PSO[FN_N] = so
                FN_PDAU[FN_N] = dau
            FN_N = FN_N + 1
        else:
            an()
    return FN_N


# Suy kieu ve phai cua phep gan theo TOAN HANG DAU TIEN - cung luat ma
# bt_cong() dung luc chay. Luat cu ("co token chuoi nao thi la chuoi") SAI:
# no bien 'n = len(src)' thanh str vi nhin thay 'src', roi 'i <= n' phat
# CompareOrdinal tren mot string null. Khong cong nao bat duoc, chi chay moi bat.
def kieu_builtin(ten: "str") -> "str":
    if ten == "float":
        return "f64"
    if ten == "vars":
        return "dict[str,str]"
    if ten == "getattr":
        return "str"
    if ten == "str":
        return "str"
    if ten == "chr":
        return "str"
    if ten == "read_file":
        return "str"
    if ten == "path_join":
        return "str"
    if ten == "path_dirname":
        return "str"
    if ten == "path_basename":
        return "str"
    if ten == "path_abspath":
        return "str"
    if ten == "sys_argv":
        return "list[str]"
    return "i32"


# Kieu tra ve cua 're.<ham>(...)'.
def kieu_re_mo(ten: "str") -> "str":
    if ten == "split":
        return "list[str]"
    if ten == "finditer":
        return "list[match]"
    if ten == "compile":
        return "regex"
    if ten == "match" or ten == "search" or ten == "fullmatch":
        return "match"
    if ten == "escape" or ten == "sub":
        return "str"
    return "i32"


# Kieu tra ve cua hau to tren regex / match.
def kieu_re(goc: "str", ten: "str") -> "str":
    if goc == "regex":
        if ten == "sub":
            return "str"
        if ten == "finditer":
            return "list[match]"
        if ten == "split":
            return "list[str]"
        return "match"
    if ten == "groups":
        return "list[str]"
    if ten == "start" or ten == "end":
        return "i32"
    return "str"


# Kieu tra ve cua method THEO kieu nguoi nhan (2026-09-25): 'queue.pop(0)'
# tren list[str] tung suy ra i32 (kieu_method khong biet nguoi nhan) - chuoi
# cat vao o int32, GC lan theo con tro cut.
def kieu_method_tren(goc: "str", ten: "str") -> "str":
    if la_list(goc) == 1 and ten == "pop":
        return kieu_pt(goc)
    if la_dict(goc) == 1 and (ten == "pop" or ten == "setdefault"):
        return cat_hai(ruot(goc), 0)
    if la_chua(goc) == 1 and ten == "copy":
        return goc
    if goc == "str" and (ten == "zfill" or ten == "ljust" or ten == "rjust" or ten == "title" or ten == "capitalize" or ten == "center" or ten == "format"):
        return "str"
    if goc == "str" and (ten == "find" or ten == "rfind" or ten == "count"):
        return "i32"
    if goc == "str" and (ten == "isdigit" or ten == "isspace" or ten == "isalnum" or ten == "isupper" or ten == "islower" or ten == "isidentifier"):
        return "bool"
    return kieu_method(ten)


def kieu_method(ten: "str") -> "str":
    if ten == "get":
        return "str"
    if ten == "split":
        return "list[str]"
    if ten == "clear":
        return "void"
    if ten == "index":
        return "i32"
    if ten == "join":
        return "str"
    if ten == "replace":
        return "str"
    if ten == "strip" or ten == "lstrip" or ten == "rstrip":
        return "str"
    if ten == "isalpha" or ten == "startswith" or ten == "endswith":
        return "bool"
    if ten == "any" or ten == "all":
        return "bool"
    if ten == "repr":
        return "str"
    if ten == "lower":
        return "str"
    if ten == "upper":
        return "str"
    return "i32"


# Bo qua mot cap ngoac can bang bat dau tai 'tu' (tu tro vao dau mo).
def qua_ngoac(tu: "i32") -> "i32":
    mo = tok_val(tu)
    dong_lai = ")"
    if mo == "[":
        dong_lai = "]"
    if mo == "{":
        dong_lai = "}"
    sau = 0
    i = tu
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "OP":
            if tok_val(i) == mo:
                sau = sau + 1
            else:
                if tok_val(i) == dong_lai:
                    sau = sau - 1
                    if sau == 0:
                        return i + 1
        i = i + 1
    return i


# Di theo cac hau to [..] va .ten(..) de ra kieu CUOI CUNG.
# Token tai `i` mo mot PHEP SO SANH o muc ngoai cung (2026-09-24). Chuoi hau
# to dung o day thi ca bieu thuc la `bool`, KHONG phai kieu ve trai: truoc day
# `[p.t == "x" for p in ps]` khai list[str] ma phat bool vao -> DICH SACH,
# SEGFAULT luc chay. `and`/`or` co y KHONG tinh: `a or b` la phep CHON gia tri.
def la_so_sanh_tai(i: "i32") -> "i32":
    if tok_kind(i) == "OP":
        o = tok_val(i)
        if o == "==" or o == "!=" or o == "<" or o == ">" or o == "<=" or o == ">=":
            return 1
        return 0
    if tok_kind(i) == "NAME":
        o = tok_val(i)
        if o == "is" or o == "in":
            return 1
        if o == "not" and tok_kind(i + 1) == "NAME" and tok_val(i + 1) == "in":
            return 1
    return 0


def kieu_hau_to(goc: "str", tu: "i32") -> "str":
    global CF_KIEU
    global CM_RET
    t = goc
    i = tu
    while tok_kind(i) == "OP":
        # GOI mot funcref nam GIUA chuoi hau to, vd `ctx.reg.bang["k"](a)`.
        # `kieu_ve_phai` chi phu duoc khi funcref la MOT TEN (`f(...)`);
        # giua chuoi thi '(' roi xuong `else: return t` va tra ve chinh
        # kieu `func(...)`, nen bien nhan ket qua mang kieu HAM thay vi
        # kieu TRA VE - roi moi phep doc truong sau do hong.
        if tok_val(i) == "(" and bat_dau_bang(t, "func(") == 1:
            t = chuan_tup(func_ra(t))
            i = qua_ngoac(i)
            continue
        if tok_val(i) == "[":
            ket_ng = qua_ngoac(i)
            if tim_hai_cham_trong(i, ket_ng) > 0:
                # LAT CAT: giu nguyen kieu (danh sach van la danh sach,
                # chuoi van la chuoi) - xem `hau_to_lat_cat`.
                t = t
            else:
                if tim_lop(t) >= 0:
                    # Record: khoa HANG CHUOI -> ten truong; hang SO ->
                    # phan tu tuple `I<n>`. Phai lap lai o day chu khong
                    # chi o cho phat IL - suy kieu di duong RIENG, thieu
                    # nhanh nay thi IL dung ma bien bi ghi kieu "str".
                    _tn_h = ""
                    if tok_kind(i + 1) == "STR":
                        _tn_h = tok_val(i + 1)
                    if tok_kind(i + 1) == "NUM":
                        _tn_h = "I" + tok_val(i + 1)
                    _tj_h = 0 - 1
                    if _tn_h != "":
                        _tj_h = tim_truong(t, _tn_h)
                    if _tj_h >= 0:
                        t = CF_KIEU[_tj_h]
                    else:
                        t = kieu_pt(t)
                else:
                    if t == "str":
                        t = "str"
                    else:
                        t = kieu_pt(t)
            i = ket_ng
        else:
            if tok_val(i) == "." and tok_kind(i + 1) == "NAME":
                if tim_lop(t) >= 0:
                    ten_tt = tok_val(i + 1)
                    # `rec.get("ten_truong")` -> kieu cua TRUONG. Phai lap
                    # lai o day chu khong chi o cho phat IL: suy kieu luc
                    # gan di duong RIENG, thieu nhanh nay thi `e = c.get(
                    # "emitted_types")` van phat dung IL nhung `e` bi ghi
                    # kieu "i32" va moi thao tac sau do hong.
                    if ten_tt == "get" and tok_kind(i + 2) == "OP"                             and tok_val(i + 2) == "("                             and tok_kind(i + 3) == "STR"                             and tok_kind(i + 4) == "OP"                             and (tok_val(i + 4) == ")" or tok_val(i + 4) == ",")                             and tim_met(t, "get") < 0:
                        _ti2 = tim_truong(t, tok_val(i + 3))
                        if _ti2 >= 0:
                            # '.get("truong", mac_dinh)' cung la doc truong
                            # (2026-09-25) - truoc day chi nhan dang 1 doi so,
                            # dang 2 doi so roi xuong kieu_method -> i32.
                            t = CF_KIEU[_ti2]
                            i = qua_ngoac(i + 2)
                            continue
                    ti = tim_truong(t, ten_tt)
                    if ti >= 0:
                        t = CF_KIEU[ti]
                        i = i + 2
                    else:
                        mi = tim_met(t, ten_tt)
                        if mi < 0:
                            return "i32"
                        t = CM_RET[mi]
                        i = qua_ngoac(i + 2)
                else:
                    if t == "regex" or t == "match":
                        t = kieu_re(t, tok_val(i + 1))
                    else:
                      if la_dict(t) == 1 and tok_val(i + 1) == "keys":
                          t = "list[" + cat_hai(ruot(t), 1) + "]"
                      else:
                          if la_dict(t) == 1 and tok_val(i + 1) == "values":
                              t = "list[" + cat_hai(ruot(t), 0) + "]"
                          else:
                              if la_dict(t) == 1 and tok_val(i + 1) == "items":
                                  t = "list[" + dang_ky_tup(cat_hai(ruot(t), 1) + "|" + cat_hai(ruot(t), 0)) + "]"
                              else:
                                  if la_dict(t) == 1 and tok_val(i + 1) == "get" and kieu_biet(cat_hai(ruot(t), 0)) == 1:
                                      t = cat_hai(ruot(t), 0)
                                  else:
                                      t = kieu_method_tren(t, tok_val(i + 1))
                    i = qua_ngoac(i + 2)
            else:
                if la_so_sanh_tai(i) == 1:
                    return "bool"
                return t
    if la_so_sanh_tai(i) == 1:
        return "bool"
    return t


# Vi tri 'else' cua bieu thuc ba ngoi o DO SAU 0 tu 'tu' toi het dong; -1.
def tim_else_ngoai(tu: "i32") -> "i32":
    sau = 0
    i = tu
    co_if = 0
    while tok_kind(i) != "NL" and tok_kind(i) != "EOF":
        if tok_kind(i) == "OP":
            o = tok_val(i)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
                if sau < 0:
                    return -1
            if o == "," and sau == 0:
                return -1
        if sau == 0 and tok_kind(i) == "NAME":
            if tok_val(i) == "if":
                co_if = 1
            if tok_val(i) == "else" and co_if == 1:
                return i
        i = i + 1
    return -1


# Co dau phay o DO SAU 0 trong khoang [tu, ket) khong.
def co_phay_ngoai(tu: "i32", ket: "i32") -> "i32":
    sau = 0
    i = tu
    while i < ket:
        if tok_kind(i) == "OP":
            o = tok_val(i)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
            if o == "," and sau == 0:
                return 1
        i = i + 1
    return 0


# Mo ta kieu cua tung phan tu, noi bang '|'.
def mo_ta_tup(tu: "i32", ket: "i32") -> "str":
    r = kieu_ve_phai(tu)
    sau = 0
    i = tu
    while i < ket:
        if tok_kind(i) == "OP":
            o = tok_val(i)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
            if o == "," and sau == 0:
                r = r + "|" + kieu_ve_phai(i + 1)
        i = i + 1
    return r


def kieu_ve_phai(tu: "i32") -> "str":
    global FN_RET
    global LOC_KIEU
    global GV_KIEU
    if tok_kind(tu) == "OP" and tok_val(tu) == "[":
        ket_lc = qua_ngoac(tu)
        if tim_for_trong(tu, ket_lc) > 0:
            khai_rut_gon(tu)
            j_lc = tim_loc(ten_an_lc(tu))
            if j_lc >= 0:
                return LOC_KIEU[j_lc]
            return "list[str]"
        # DANH SACH VIET THANG. Thieu nhanh nay thi ham roi xuong duoi va
        # tra ve "i32": `for z in [7, 8]` khai bien an la i32 roi goi
        # `Int32::get_Count()` - DICH SACH nhung NEM luc chay.
        if tok_kind(tu + 1) == "OP" and tok_val(tu + 1) == "]":
            return "list[str]"
        if tok_kind(tu + 1) == "OP" and tok_val(tu + 1) == "*":
            # `[*xs, ...]`: kieu phan tu lay tu PHAN TU cua xs, khong phai
            # tu chinh xs. Thieu nhanh nay thi tien quet ra "i32" con phat
            # IL ra list[str] - hai ben lech nhau.
            return "list[" + kieu_pt(kieu_ve_phai(tu + 2)) + "]"
        return "list[" + kieu_ve_phai(tu + 1) + "]"
    if tok_kind(tu) == "OP" and tok_val(tu) == "(":
        ket = qua_ngoac(tu)
        if tim_for_trong(tu, ket) > 0:
            khai_rut_gon(tu)
            j_gx = tim_loc(ten_an_lc(tu))
            if j_gx >= 0:
                return LOC_KIEU[j_gx]
            return "list[str]"
        # HAU TO sau dau dong: truoc day hai dong duoi tra thang kieu BEN
        # TRONG ngoac roi bo sach chuoi hau to phia sau, nen
        # `ra = (h).get('truong')` suy ra kieu cua `h` chu khong phai kieu
        # cua TRUONG. Duong phat ma van dung, nen `ra` duoc KHAI mot dang
        # ma IL day len mot dang khac - va loi chi hien o dong SAU do.
        if co_phay_ngoai(tu + 1, ket) == 1:
            return kieu_hau_to(dang_ky_tup(mo_ta_tup(tu + 1, ket)), ket)
        return kieu_hau_to(kieu_ve_phai(tu + 1), ket)
    if tok_kind(tu) == "OP" and tok_val(tu) == "{":
        ket = qua_ngoac(tu)
        # Truoc day cho nay doan CUNG: khoa luon 'str', va moi tap hop la
        # 'set[str]'. Nen `{1, 2}` khai la set[str] roi NEM NullReference
        # luc chay - lai mot dang dich sach nhung chay hong. Lay kieu THAT
        # cua phan tu dau; `{}` rong giu nguyen net cu.
        vt_hc = tim_hai_cham_trong(tu, ket)
        if vt_hc > 0:
            return "dict[" + kieu_ve_phai(tu + 1) + "," + kieu_ve_phai(vt_hc + 1) + "]"
        if tok_kind(tu + 1) == "OP" and tok_val(tu + 1) == "}":
            return "set[str]"
        return "set[" + kieu_ve_phai(tu + 1) + "]"
    if tok_kind(tu) == "STR":
        return kieu_hau_to("str", tu + 1)
    if tok_kind(tu) == "NUM":
        if la_so_sanh_tai(tu + 1) == 1:
            return "bool"
        if la_so_thuc(tok_val(tu)) == 1:
            return "f64"
        return "i32"
    if tok_kind(tu) != "NAME":
        return "i32"
    ten = tok_val(tu)
    # 'None if c else y' (2026-09-25): kieu = kieu nhanh else - truoc day ca
    # bieu thuc suy ra i32 va bien cat chuoi vao o int32.
    if ten == "None":
        vt_else = tim_else_ngoai(tu)
        if vt_else > 0:
            return kieu_ve_phai(vt_else + 1)
    if ten == "lambda":
        # Kieu cua mot lambda chi biet duoc khi da phan tich xong than;
        # o duong suy kieu ta chua muon lam viec do, va moi cho dung
        # lambda trong cay deu la DOI SO co kieu dang cho. Tra kieu ham
        # rong de khong ai ghi nham bien la 'i32'.
        return "func()->i32"
    if ten == "True" or ten == "False":
        return "bool"
    if ten == "re" and tok_kind(tu + 1) == "OP" and tok_val(tu + 1) == "." and tim_loc(ten) < 0:
        return kieu_re_mo(tok_val(tu + 2))
    # TEN MODULE tren duong SUY KIEU. `nap_ten` (duong phat ma) da co luat
    # nay tu truoc: phep gop lam phang moi module vao MOT namespace nen
    # 'mod.x' chinh la 'x'. Duong suy kieu thi khong, nen
    # `obj_ta = _ilc.ham(...)` mat sach kieu va MOI phep doc truong sau do
    # bao "method chua ho tro trong bieu thuc: .shape_ten". Dau hieu module
    # dung y het ben kia: khong phai bien, bien toan cuc, ham, hay lop.
    if tok_kind(tu + 1) == "OP" and tok_val(tu + 1) == ".":
        if tim_loc(ten) < 0 and tim_gv(ten) < 0:
            if tim_ham(ten) < 0 and tim_lop(ten) < 0:
                return kieu_ve_phai(tu + 2)
    if tok_kind(tu + 1) == "OP" and tok_val(tu + 1) == "(":
        goc = "i32"
        kb = kieu_ten(ten)
        if bat_dau_bang(kb, "func(") == 1:
            return kieu_hau_to(chuan_tup(func_ra(kb)), qua_ngoac(tu + 1))
        if tim_lop(ten) >= 0:
            goc = ten
        elif tim_lop(go_bi_danh(ten)) >= 0:
            goc = go_bi_danh(ten)
        else:
            if la_builtin(ten) == 1:
                goc = kieu_builtin(ten)
                if ten == "sorted" or ten == "reversed" or ten == "list":
                    # tu dien -> danh sach KHOA (khop kieu_ds_tu_nguon)
                    nguon_sd = kieu_ve_phai(tu + 2)
                    if la_dict(nguon_sd) == 1:
                        goc = "list[" + cat_hai(ruot(nguon_sd), 1) + "]"
                    else:
                        goc = "list[" + kieu_pt(nguon_sd) + "]"
                if ten == "next":
                    goc = "i32"
                    if khai_rut_gon(tu + 2) == 1:
                        jn = tim_loc(ten_an_lc(tu + 2))
                        if jn >= 0:
                            goc = kieu_pt(LOC_KIEU[jn])
                    else:
                        goc = kieu_pt(kieu_ve_phai(tu + 2))
                if ten == "zip":
                    _vt_p = tim_phay_ngoai(tu + 2, qua_ngoac(tu + 1))
                    goc = "list[str]"
                    if _vt_p > 0:
                        _kz = kieu_zip(kieu_ve_phai(tu + 2), kieu_ve_phai(_vt_p + 1))
                        if _kz != "":
                            goc = _kz
                if ten == "dict":
                    goc = kieu_dict_tu_cap(kieu_ve_phai(tu + 2))
                    if goc == "":
                        goc = "dict[str,str]"
                if ten == "set" or ten == "frozenset":
                    goc = "set[str]"
                    if tok_kind(tu + 2) == "OP" and tok_val(tu + 2) == ")":
                        goc = "set[str]"
                    else:
                        # KHOP duong phat ma (2026-09-25): set(dict) = tap KHOA;
                        # kieu_pt(dict) la kieu GIA TRI - bien khai HashSet<int32>
                        # trong khi gia tri la HashSet<string>.
                        if tok_kind(tu + 2) == "OP" and tok_val(tu + 2) == "(" and la_tuple_hien(tu + 2) == 1:
                            # Tuple viet thang: kieu phan tu = kieu phan tu DAU
                            # (khop bt_ds_ngoac o duong phat ma).
                            goc = "set[" + kieu_ve_phai(tu + 3) + "]"
                        else:
                            kv_s = kieu_ve_phai(tu + 2)
                            if la_dict(kv_s) == 1:
                                goc = "set[" + cat_hai(ruot(kv_s), 1) + "]"
                            else:
                                goc = "set[" + kieu_pt(kv_s) + "]"
            else:
                f = tim_ham(doi_ten_lg(ten))
                if f < 0:
                    f = tim_ham(go_bi_danh(ten))
                if f >= 0:
                    goc = FN_RET[f]
        return kieu_hau_to(goc, qua_ngoac(tu + 1))
    goc = "i32"
    j = tim_loc(ten)
    if j >= 0:
        goc = LOC_KIEU[j]
    else:
        gi = tim_gv(ten)
        if gi < 0:
            gi = tim_gv(go_bi_danh(ten))
        if gi >= 0:
            goc = GV_KIEU[gi]
        else:
            if tok_kind(tu + 1) == "OP" and tok_val(tu + 1) == ".":
                goc = "module"
    return kieu_hau_to(goc, tu + 1)


# 'ten = {}' trong Python LUON la TU DIEN rong (tap hop rong la 'set()'),
# nhung no khong noi kieu khoa/gia tri. Lay tu phep GHI dau tien 'ten[k] = v'.
# Ve phai cua mot phep gan co nhac lai chinh `ten` khong (tu `tu` den het
# dong). `b[t] = b[t] + 1` la TU THAM CHIEU: luc tien quet `b` chua co kieu
# nen kieu_ve_phai doc `b[t]` ra 'str' roi chot `b` la dict[str,str] - IL
# khai local mot dang ma chu ky ham mot dang, ilasm VAN NHAN, chay moi no.
def tu_nhac_ten(ten: "str", tu: "i32") -> "i32":
    i = tu
    while tok_kind(i) != "EOF" and tok_kind(i) != "NL":
        if tok_kind(i) == "NAME" and tok_val(i) == ten:
            return 1
        i = i + 1
    return 0


# `bo_tu_tham_chieu`: 1 = BO QUA cho gan co ve phai nhac lai chinh no.
# Quet HAI luot - luot dau bo qua chung, luot sau moi nhan, de mot cho gan
# KHONG tu tham chieu (`b[t] = 1`) luon thang.
def kieu_bang_tu_dung_luot(ten: "str", tu: "i32", bo_tu_tham_chieu: "i32") -> "str":
    i = tu
    sau = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
        if tok_kind(i) == "DED":
            sau = sau - 1
            if sau < 0:
                return ""
        if tok_kind(i) == "NAME" and tok_val(i) == ten:
            if tok_kind(i + 1) == "OP" and tok_val(i + 1) == "[":
                ket = qua_ngoac(i + 1)
                if tok_kind(ket) == "OP" and tok_val(ket) == "=":
                    if bo_tu_tham_chieu == 0 or tu_nhac_ten(ten, ket + 1) == 0:
                        return "dict[" + kieu_ve_phai(i + 2) + "," + kieu_ve_phai(ket + 1) + "]"
            if tok_kind(i + 1) == "OP" and tok_val(i + 1) == ".":
                if tok_val(i + 2) == "add":
                    return "set[" + kieu_ve_phai(i + 4) + "]"
        i = i + 1
    return ""


# `ten` co duoc `return` trong than nay khong (de biet kieu tra ve cua ham
# co noi gi ve no khong).
def co_return_ten(ten: "str", tu: "i32") -> "i32":
    i = tu
    sau = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
        if tok_kind(i) == "DED":
            sau = sau - 1
            if sau < 0:
                return 0
        if tok_kind(i) == "NAME" and tok_val(i) == "return":
            if tok_kind(i + 1) == "NAME" and tok_val(i + 1) == ten:
                if tok_kind(i + 2) == "NL":
                    return 1
        i = i + 1
    return 0


# Kieu cua MOT phep gan KHAC 'ten = <bt>' trong cung than ham, ve phai KHONG
# phai container rong / None (2026-09-25) - "" neu khong co. Dung khi bien
# duoc khoi tao bang '{}'/'[]' ma khong co phep ghi/append nao noi kieu.
# Kieu container cua `ten` suy tu cho no duoc TRUYEN LAM DOI SO cho mot ham
# da khai kieu tham so (2026-09-25) - "" neu khong co. 'hoisted = []' roi
# 'f(..., hoisted)' voi f(..., hoisted: "list[(str,list[str],i32)]"): truoc
# day roi ve list[str] mac dinh, truyen sai kieu -> AddRange nem luc chay.
# Kieu tham so TEN `kw` cua loi goi chua token `vt_kw` (vt_kw la ten tu khoa).
def kieu_tham_kw(vt_kw: "i32", kw: "str") -> "str":
    j = vt_kw - 1
    muc = 0
    while j > 0:
        if tok_kind(j) == "OP":
            if tok_val(j) == ")" or tok_val(j) == "]" or tok_val(j) == "}":
                muc = muc + 1
            elif tok_val(j) == "(" or tok_val(j) == "[" or tok_val(j) == "{":
                if muc == 0:
                    break
                muc = muc - 1
        j = j - 1
    if tok_kind(j) == "OP" and tok_val(j) == "(" and tok_kind(j - 1) == "NAME":
        fi = tim_ham(tok_val(j - 1))
        if fi < 0:
            fi = tim_ham(go_bi_danh(tok_val(j - 1)))
        if fi >= 0:
            k = 0
            while k < FN_PSO[fi]:
                if PAR_TEN[FN_PDAU[fi] + k] == kw:
                    return PAR_KIEU[FN_PDAU[fi] + k]
                k = k + 1
    return ""


def kieu_tu_doi_so(ten: "str", tu: "i32") -> "str":
    i = tu + 1
    sau = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
        if tok_kind(i) == "DED":
            sau = sau - 1
            if sau < 0:
                return ""
        if tok_kind(i) == "NAME" and tok_val(i) == ten:
            truoc_la = tok_kind(i - 1) == "OP" and (tok_val(i - 1) == "(" or tok_val(i - 1) == ",")
            sau_la = tok_kind(i + 1) == "OP" and (tok_val(i + 1) == ")" or tok_val(i + 1) == ",")
            # Doi so TU KHOA 'f(..., kw=ten)' (2026-09-25): 'hoisted=hoisted'.
            if sau_la and tok_kind(i - 1) == "OP" and tok_val(i - 1) == "=" and tok_kind(i - 2) == "NAME":
                kt_kw = kieu_tham_kw(i - 2, tok_val(i - 2))
                if la_chua(kt_kw) == 1:
                    return chuan_tup(kt_kw)
            if truoc_la and sau_la:
                # lui tim '(' mo cua loi goi, dem dau phay cung muc
                j = i - 1
                muc = 0
                phay = 0
                while j > 0:
                    if tok_kind(j) == "OP":
                        if tok_val(j) == ")" or tok_val(j) == "]" or tok_val(j) == "}":
                            muc = muc + 1
                        elif tok_val(j) == "(" or tok_val(j) == "[" or tok_val(j) == "{":
                            if muc == 0:
                                break
                            muc = muc - 1
                        elif tok_val(j) == "," and muc == 0:
                            phay = phay + 1
                    j = j - 1
                if tok_kind(j) == "OP" and tok_val(j) == "(" and tok_kind(j - 1) == "NAME":
                    fi = tim_ham(tok_val(j - 1))
                    if fi < 0:
                        fi = tim_ham(go_bi_danh(tok_val(j - 1)))
                    if fi >= 0 and phay < FN_PSO[fi]:
                        kt = PAR_KIEU[FN_PDAU[fi] + phay]
                        if la_chua(kt) == 1:
                            return chuan_tup(kt)
        i = i + 1
    return ""


def kieu_gan_khac(ten: "str", tu: "i32") -> "str":
    i = tu + 1
    sau = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
        if tok_kind(i) == "DED":
            sau = sau - 1
            if sau < 0:
                return ""
        if tok_kind(i) == "NAME" and tok_val(i) == ten:
            tr = tok_kind(i - 1)
            if (tr == "NL" or tr == "IND" or tr == "DED") and tok_kind(i + 1) == "OP" and tok_val(i + 1) == "=":
                rong = 0
                if tok_kind(i + 2) == "OP" and (tok_val(i + 2) == "{" or tok_val(i + 2) == "["):
                    if tok_kind(i + 3) == "OP" and (tok_val(i + 3) == "}" or tok_val(i + 3) == "]"):
                        rong = 1
                if tok_kind(i + 2) == "NAME" and tok_val(i + 2) == "None":
                    rong = 1
                if rong == 0:
                    kq = kieu_ve_phai(i + 2)
                    if la_chua(kq) == 1:
                        return kq
        i = i + 1
    return ""


def kieu_bang_tu_dung(ten: "str", tu: "i32") -> "str":
    r = kieu_bang_tu_dung_luot(ten, tu, 1)
    if r != "":
        return r
    # Chi con cho gan TU THAM CHIEU. Neu bien nay duoc tra ve thang thi
    # kieu tra ve cua ham la nguon tin DUNG hon - giong het cach `[]` rong
    # lay RET_HIEN (xem bt_atom).
    if la_dict(RET_HIEN) == 1:
        if co_return_ten(ten, tu) == 1:
            return RET_HIEN
    r = kieu_bang_tu_dung_luot(ten, tu, 0)
    if r != "":
        return r
    r = kieu_gan_khac(ten, tu)
    if r != "":
        return r
    r = kieu_tu_doi_so(ten, tu)
    if r != "":
        return r
    return "dict[str,str]"


# 'ten = []' khong noi kieu phan tu. Tim '.append(' dau tien cua chinh 'ten'
# ve sau trong cung than ham va lay kieu cua doi so do.
# Kieu cua 'x = set()' rong: '.add(v)' dau tien, roi doi so / phep gan khac.
def kieu_tap_rong(ten: "str", tu: "i32") -> "str":
    r_t = kieu_tu_doi_so(ten, tu)
    if la_set(r_t) == 1:
        return r_t
    i = tu
    sau = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
        if tok_kind(i) == "DED":
            sau = sau - 1
            if sau < 0:
                break
        if tok_kind(i) == "NAME" and tok_val(i) == ten:
            if tok_kind(i + 1) == "OP" and tok_val(i + 1) == "." and tok_val(i + 2) == "add":
                return "set[" + kieu_ve_phai(i + 4) + "]"
        i = i + 1
    r_t = kieu_gan_khac(ten, tu)
    if la_set(r_t) == 1:
        return r_t
    return "set[str]"


def kieu_ds_tu_append(ten: "str", tu: "i32") -> "str":
    # Kieu THAM SO da khai (khi bien duoc truyen vao ham) dang tin HON kieu suy
    # tu '.append(<bo gia tri>)' - vd '(ten, ta, None, "direct")': None suy ra
    # i32 trong khi tham so khai (str,TypeAnn,str,str).
    r_ds = kieu_tu_doi_so(ten, tu)
    if la_list(r_ds) == 1:
        return r_ds
    i = tu
    sau = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
        if tok_kind(i) == "DED":
            sau = sau - 1
            if sau < 0:
                break
        if tok_kind(i) == "NAME" and tok_val(i) == ten:
            if tok_kind(i + 1) == "OP" and tok_val(i + 1) == ".":
                # '.append(None)' KHONG noi kieu (2026-09-25): bo qua, lay lan
                # append ke tiep - truoc day 'parts.append(None)' dung dau
                # khoa danh sach thanh list[i32] roi nhan chuoi.
                if tok_val(i + 2) == "append" and not (tok_kind(i + 4) == "NAME" and tok_val(i + 4) == "None" and tok_kind(i + 5) == "OP" and tok_val(i + 5) == ")"):
                    return "list[" + kieu_ve_phai(i + 4) + "]"
        i = i + 1
    r_k = kieu_gan_khac(ten, tu)
    if r_k != "":
        return r_k
    r_k = kieu_tu_doi_so(ten, tu)
    if r_k != "":
        return r_k
    return "list[str]"


# Vi tri token NL ket thuc dong chua vi tri 'tu'.
def cuoi_dong(tu: "i32") -> "i32":
    i = tu
    while tok_kind(i) != "NL" and tok_kind(i) != "EOF":
        i = i + 1
    return i


# Tim dau '=' o do sau 0 truoc khi het dong; -1 neu khong co.
def tim_bang(tu: "i32") -> "i32":
    sau = 0
    i = tu
    while tok_kind(i) != "NL" and tok_kind(i) != "EOF":
        if tok_kind(i) == "OP":
            o = tok_val(i)
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                sau = sau - 1
            if o == "=" and sau == 0:
                return i
        i = i + 1
    return -1


# 'a, b = <bt>': khai a, b theo tung truong cua tuple ve phai.
# Khai bien cho 'a, b = x, y': tung ten lay kieu cua bieu thuc tuong ung.
def khai_gan_song_song(tu: "i32", vt_bang: "i32") -> "i32":
    ket = cuoi_dong(vt_bang)
    vt_gt = vt_bang + 1
    i = tu
    while i < vt_bang:
        if tok_kind(i) == "NAME":
            if vt_gt > 0 and vt_gt < ket:
                them_loc(tok_val(i), kieu_ve_phai(vt_gt))
                vt_gt = tim_phay_ngoai(vt_gt, ket) + 1
                if vt_gt == 0:
                    vt_gt = ket
            else:
                them_loc(tok_val(i), "str")
        i = i + 2
    return 1


def khai_thao_tup(tu: "i32", vt_bang: "i32") -> "i32":
    global CF_KIEU
    if co_phay_ngoai(vt_bang + 1, cuoi_dong(vt_bang)) == 1:
        return khai_gan_song_song(tu, vt_bang)
    lop = kieu_ve_phai(vt_bang + 1)
    if la_list(lop) == 1:
        # Python cho thao ca DANH SACH, khong chi tuple: 'a, b = m.groups()'.
        them_loc(ten_an_tup(tu), lop)
        i = tu
        while i < vt_bang:
            if tok_kind(i) == "NAME":
                them_loc(tok_val(i), kieu_pt(lop))
            i = i + 1
        return 1
    if tim_lop(lop) < 0:
        return 0
    them_loc(ten_an_tup(tu), lop)
    j = 0
    i = tu
    while i < vt_bang:
        if tok_kind(i) == "NAME":
            ti = tim_truong(lop, "I" + str(j))
            if ti >= 0:
                them_loc(tok_val(i), CF_KIEU[ti])
            j = j + 1
        i = i + 1
    return j


def ten_an_tup(vt: "i32") -> "str":
    return "__tup_" + str(vt)


# Khai ba bien an + bien lap cua mot rut gon danh sach tai '[' o vi tri vt_lb.
# PHAI goi duoc tu HAI cho: khi duyet toi dau '[', va khi suy kieu ve phai
# cua 'd = [...]' - vi bien 'd' duoc duyet TRUOC dau '[' cua chinh no.
KRG_CHU: "i32" = 0 - 1


# CHU SO HUU = CHINH RUT GON (0 - 2 - vt_lb), khong phai muc hoan dang goi
# (2026-09-25): khai_rut_gon con duoc goi qua kieu_ve_phai tu phep gan chua no
# - chu khac nhau thi vong sau khong ghi de duoc kieu SAI cua vong dau (bien
# lap chua biet kieu nguon -> phan tu i32 vinh vien). Ten bien rut gon nay la
# DUY NHAT (doi_ten_rut_gon) nen ghi de theo rut gon la an toan.
def khai_rg(ten: "str", kieu: "str", vt_lb: "i32") -> "i32":
    return dat_loc(ten, kieu, 0 - 2 - vt_lb)


def khai_rut_gon(vt_lb: "i32") -> "i32":
    global CF_KIEU
    # Goi tu vong HOAN (KRG_CHU >= 0): TINH LAI moi vong va GHI DE bang dat_loc -
    # vong dau nguon co the chua co kieu (vd 'handlers' chi biet sau), khoa
    # them_loc o vong dau thi `[e or '' for e, _ in handlers]` thanh list[i32]
    # vinh vien (2026-09-25).
    vt_for_lc = tim_for_trong(vt_lb, qua_ngoac(vt_lb))
    if vt_for_lc <= 0:
        return 0
    kieu_ng = kieu_ve_phai(rg_vt_in(vt_for_lc) + 1)
    # Nguon la TU DIEN/TAP: duyet KHOA/phan tu qua mot List (2026-09-25) -
    # KHOP bt_rut_gon; truoc day get_Item(int32) len Dictionary luc chay.
    if la_dict(kieu_ng) == 1:
        kieu_ng = "list[" + cat_hai(ruot(kieu_ng), 1) + "]"
    elif la_set(kieu_ng) == 1:
        kieu_ng = "list[" + ruot(kieu_ng) + "]"
    khai_rg(ten_an_ds(vt_lb), kieu_ng, vt_lb)
    khai_rg(ten_an_i(vt_lb), "i32", vt_lb)
    ds_bien = rg_ten(vt_for_lc)
    if len(ds_bien) == 1:
        khai_rg(ds_bien[0], kieu_pt(kieu_ng), vt_lb)
    else:
        lop_t = kieu_pt(kieu_ng)
        jt = 0
        while jt < len(ds_bien):
            ti = tim_truong(lop_t, "I" + str(jt))
            if ti >= 0:
                khai_rg(ds_bien[jt], CF_KIEU[ti], vt_lb)
            jt = jt + 1
    kpt = kieu_ve_phai(vt_lb + 1)
    # '{...for...}' la rut gon TAP HOP (hoac TU DIEN neu co ':' o do sau 1).
    if tok_val(vt_lb) == "{":
        if tim_hai_cham_trong(vt_lb, vt_for_lc) > 0:
            kv = kieu_ve_phai(tim_hai_cham_trong(vt_lb, vt_for_lc) + 1)
            khai_rg(ten_an_lc(vt_lb), "dict[" + kpt + "," + kv + "]", vt_lb)
        else:
            khai_rg(ten_an_lc(vt_lb), "set[" + kpt + "]", vt_lb)
        return 1
    khai_rg(ten_an_lc(vt_lb), "list[" + kpt + "]", vt_lb)
    return 1


# Tien quet than ham de khai bien cuc bo truoc khi phat .locals init.
HOAN_TEN: "list[str]" = []
HOAN_VT: "list[i32]" = []
HOAN_LOAI: "list[i32]" = []
HOAN_BANG: "list[i32]" = []
HOAN_N: "i32" = 0


def hoan_them(ten: "str", vt: "i32", loai: "i32", vt_bang: "i32") -> "i32":
    global HOAN_TEN
    global HOAN_VT
    global HOAN_LOAI
    global HOAN_BANG
    global HOAN_N
    if HOAN_N == len(HOAN_TEN):
        HOAN_TEN.append(ten)
        HOAN_VT.append(vt)
        HOAN_LOAI.append(loai)
        HOAN_BANG.append(vt_bang)
    else:
        HOAN_TEN[HOAN_N] = ten
        HOAN_VT[HOAN_N] = vt
        HOAN_LOAI[HOAN_N] = loai
        HOAN_BANG[HOAN_N] = vt_bang
    HOAN_N = HOAN_N + 1
    return HOAN_N


def hoan_giai_quyet() -> "i32":
    global KRG_CHU
    global HOAN_TEN
    global HOAN_VT
    global HOAN_LOAI
    global HOAN_BANG
    global HOAN_N
    vong = 0
    while vong < 3:
        i = 0
        while i < HOAN_N:
            if HOAN_LOAI[i] == 8:
                i = i + 1
                continue
            if HOAN_LOAI[i] == 9:
                dat_loc(HOAN_TEN[i], kieu_tap_rong(HOAN_TEN[i], HOAN_VT[i]), i)
            elif HOAN_LOAI[i] == 1:
                dat_loc(HOAN_TEN[i], kieu_ds_tu_append(HOAN_TEN[i], HOAN_VT[i]), i)
            else:
                if HOAN_LOAI[i] == 2:
                    if tim_loc(ten_an_tup(HOAN_VT[i])) < 0:
                        khai_thao_tup(HOAN_VT[i], HOAN_BANG[i])
                else:
                    if HOAN_LOAI[i] == 4:
                        KRG_CHU = i
                        khai_rut_gon(HOAN_VT[i])
                        KRG_CHU = 0 - 1
                    else:
                        # CHUOI PHAI LOAI TRU NHAU. Ban truoc viet ba `if`
                        # roi mot `else` cuoi, nen LOAI 6 va 7 vua chay
                        # nhanh cua minh VUA roi vao `else` - tuc goi
                        # `khai_cho_don` len mot token khong phai 'for'.
                        if HOAN_LOAI[i] == 7:
                            dat_loc(HOAN_TEN[i], kieu_bang_tu_dung(HOAN_TEN[i], HOAN_VT[i]), i)
                        else:
                            if HOAN_LOAI[i] == 6:
                                khai_cho_tup(HOAN_VT[i])
                            else:
                                if HOAN_LOAI[i] == 5:
                                    dat_loc(HOAN_TEN[i], kieu_ve_phai(HOAN_VT[i]), i)
                                else:
                                    khai_cho_don(HOAN_VT[i], i)
            i = i + 1
        # Loai 8 (`x = None`) CHI sau khi moi muc khac da chay het vong nay:
        # neu mot phep gan that da cho 'x' mot kieu thi khong dong vao nua.
        i = 0
        while i < HOAN_N:
            if HOAN_LOAI[i] == 8:
                if tim_loc(HOAN_TEN[i]) < 0:
                    them_loc(HOAN_TEN[i], "i32")
            i = i + 1
        vong = vong + 1
    HOAN_N = 0
    return 0


def quet_bien_cuc_bo(dau: "i32") -> "i32":
    global LOC_KIEU
    global HOAN_N
    HOAN_N = 0
    sau = 0
    i = dau
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
        if tok_kind(i) == "DED":
            sau = sau - 1
            if sau <= 0:
                hoan_giai_quyet()
                return i
        if tok_kind(i) == "NAME" and tok_val(i) == "def" and dau_dong_tok(i) == 1:
            i = cuoi_khoi_def(i)
            continue
        if tok_kind(i) == "OP" and tok_val(i) == "[":
            hoan_them("", i, 4, 0)
            ket_ng = qua_ngoac(i)
            if tok_kind(ket_ng) == "OP" and (tok_val(ket_ng) == "+=" or tok_val(ket_ng) == "-="):
                them_loc(ten_ix(i, "i"), "i32")
                # Kieu bien an GIA TRI = kieu VE PHAI cua '+=' (2026-09-25):
                # truoc day suy tu goc chi so qua dau_lenh - 'ctx.x[0] += 1'
                # (goc la chuoi truong) ra 'str', cat int32 vao o string.
                them_loc(ten_ix(i, "v"), kieu_ve_phai(ket_ng + 1))
            if tim_hai_cham_trong(i, qua_ngoac(i)) > 0:
                them_loc(ten_lat(i, "a"), "i32")
                them_loc(ten_lat(i, "b"), "i32")
                them_loc(ten_lat(i, "n"), "i32")
        # HOAN ca bien cua RUT GON: 'for i, p in enumerate(params)' trong mot
        # rut gon tung duoc khai NGAY, nen no gianh cho truoc vong lap 'for p
        # in params' (von da hoan) va them_loc giu ban DAU TIEN -> p mang kieu
        # sai trong CA than ham, khong mot loi nao chi ra nguyen nhan.
        if tok_kind(i) == "OP" and tok_val(i) == "(":
            hoan_them("", i, 4, 0)
        if tok_kind(i) == "OP" and tok_val(i) == "{":
            hoan_them("", i, 4, 0)
        # 'except ... as e': lop ngoai le TU DINH NGHIA -> doi tuong cua lop do
        # (doc duoc truong, vd e.ten); dung san -> CHUOI (Message) nhu cu.
        if tok_kind(i) == "NAME" and tok_val(i) == "except":
            them_loc("__ngoai_le", "__exc")
        if tok_kind(i) == "NAME" and tok_val(i) == "as" and tok_kind(i + 1) == "NAME":
            if tok_kind(i - 1) == "NAME" and tim_lop(tok_val(i - 1)) >= 0 and la_ngoai_le(tok_val(i - 1)) == 1:
                j_e = tim_loc(tok_val(i + 1))
                if j_e >= 0 and LOC_KIEU[j_e] != tok_val(i - 1) and la_ngoai_le(LOC_KIEU[j_e]) == 1:
                    # CUNG ten bat o HAI lop ngoai le khac nhau (2026-09-25):
                    # 'except CliError as e' + 'except TranspileError as e'.
                    # Khai theo lop DAU thi nhanh sau castclass sai lop ->
                    # InvalidCastException luc chay. Dung kieu goc chung.
                    LOC_KIEU[j_e] = "__exc"
                else:
                    them_loc(tok_val(i + 1), tok_val(i - 1))
            else:
                them_loc(tok_val(i + 1), "str")
        if tok_kind(i) == "NAME" and tok_val(i) == "for" and tok_kind(i + 2) == "OP" and tok_val(i + 2) == ",":
            hoan_them("", i, 6, 0)
        if tok_kind(i) == "NAME" and tok_val(i) == "for" and (tok_kind(i + 2) != "OP" or tok_val(i + 2) != ","):
            hoan_them("", i, 3, 0)
        if tok_kind(i) == "NAME" and tu_khoa(tok_val(i)) == 0:
            truoc_ok = 0
            if tok_kind(i - 1) == "IND":
                truoc_ok = 1
            if tok_kind(i - 1) == "NL":
                truoc_ok = 1
            if tok_kind(i - 1) == "DED":
                truoc_ok = 1
            if truoc_ok == 1 and tok_kind(i + 1) == "OP" and tok_val(i + 1) == ",":
                vt_bang = tim_bang(i)
                if vt_bang > 0:
                    hoan_them("", i, 2, vt_bang)
            if truoc_ok == 1 and tok_kind(i + 1) == "OP" and tok_val(i + 1) == ":":
                if tok_kind(i + 2) == "STR" and tok_kind(i + 3) == "OP" and tok_val(i + 3) == "=":
                    them_loc(tok_val(i), chuan_tup(tok_val(i + 2)))
            if truoc_ok == 1 and tok_kind(i + 1) == "OP" and tok_val(i + 1) == "=":
                if tim_gv(tok_val(i)) < 0:
                    la_bang_rong = 0
                    if tok_kind(i + 2) == "OP" and tok_val(i + 2) == "{":
                        if tok_kind(i + 3) == "OP" and tok_val(i + 3) == "}":
                            # '{}' trong Python la TU DIEN rong, khong phai tap
                            # hop. Kieu khoa/gia tri lay tu phep ghi dau tien.
                            la_bang_rong = 1
                            hoan_them(tok_val(i), i, 7, 0)
                    if la_bang_rong == 1:
                        i = i + 1
                        continue
                    if tok_kind(i + 2) == "OP" and tok_val(i + 2) == "[":
                        # PHAN BIET '[]' rong voi RUT GON DANH SACH: ca hai
                        # deu bat dau bang '[' nhung kieu suy ra khac han.
                        if tim_for_trong(i + 2, qua_ngoac(i + 2)) > 0:
                            # kieu_ve_phai goi khai_rut_gon NGAY, khai bien lap
                            # cua rut gon truoc cac vong 'for' da hoan o tren -
                            # ban dau tien thang, nen phai hoan ca cho nay.
                            hoan_them(tok_val(i), i + 2, 5, 0)
                        else:
                            if tok_kind(i + 3) == "OP" and tok_val(i + 3) == "]":
                                # HOAN lai: kieu cua 'x = []' lay tu doi so
                                # cua '.append(' dau tien, ma doi so do co the
                                # la mot bien khai SAU day. Suy ngay thi no
                                # thanh 'i32' -> List<int32> chua chuoi ->
                                # AccessViolation luc chay, KHONG bao loi.
                                hoan_them(tok_val(i), i, 1, 0)
                            else:
                                # HOAN (2026-09-25): 'kw_names = [kw_name0]' suy
                                # NGAY khi kw_name0 chua co kieu -> list[i32].
                                hoan_them(tok_val(i), i + 2, 5, 0)
                    else:
                        # `x = None` KHONG mang mot chut thong tin kieu nao,
                        # nhung no van GIANH o (dat_loc chi cho muc hoan DA
                        # TAO ra o duoc ghi de) va khoa 'x' o 'i32'. Khuon
                        # `x = None` roi moi `x = <gia tri that>` la rat
                        # thuong trong cay nay, va hau qua khong hien o dong
                        # gan ma o dong DOC TRUONG sau do. Cho no mot muc
                        # hoan RIENG, giai SAU cung va CHI khi ten van chua
                        # co kieu.
                        if tok_kind(i + 2) == "NAME" and tok_val(i + 2) == "None" and tok_kind(i + 3) == "NL":
                            hoan_them(tok_val(i), i + 2, 8, 0)
                        elif tok_kind(i + 2) == "NAME" and tok_val(i + 2) == "set" and tok_kind(i + 3) == "OP" and tok_val(i + 3) == "(" and tok_kind(i + 4) == "OP" and tok_val(i + 4) == ")":
                            # 'x = set()' RONG (2026-09-25): kieu tu .add / doi so
                            # / phep gan khac - khong khoa ngay set[str].
                            hoan_them(tok_val(i), i, 9, 0)
                        else:
                            # CHI hoan khi ve phai co RUT GON/BIEU THUC SINH:
                            # no khai bien lap ngay va gianh cho truoc vong
                            # 'for' cung ten. Hoan HET moi phep gan thi hong
                            # theo huong khac: 'x = []' (loai 1) lay kieu tu
                            # doi so cua '.append(' - doi so do phai duoc
                            # khai TRUOC.
                            hoan_them(tok_val(i), i + 2, 5, 0)
        i = i + 1
    hoan_giai_quyet()
    return i


# Khai bien cua 'for a, b in ...' - PHAI khop tung dang voi lenh_cho_tup.
# 'for x in <bt>:' - mot bien. PHAI hoan nhu cac khai bao khac: kieu cua x
# lay tu kieu cua ve phai, ma ve phai co the la bien khai SAU.
def kieu_nguon_lap(vt: "i32") -> "str":
    """Kieu cua NGUON duyet trong 'for ... in <vt>'. Tach rieng vi phep suy
    kieu luc TIEN QUET va phep phat IL di HAI duong khac nhau: sua mot ben
    thi bien duoc khai mot kieu con IL sinh ra mot kieu khac."""
    if tok_kind(vt) == "OP" and tok_val(vt) == "(" and la_tuple_hien(vt) == 1:
        return "list[" + kieu_ve_phai(vt + 1) + "]"
    return kieu_ve_phai(vt)


def khai_cho_don(vt_for: "i32", chu: "i32") -> "i32":
    """`chu` = chi so muc HOAN da sinh ra o nay, truyen cho `dat_loc`.

    PHAI dung `dat_loc` chu khong `them_loc`: bo giai quyet chay BA VONG, va
    o vong dau nguon duyet co the chua biet kieu (vd `ks = []` chi duoc dien
    bang `.append()` BEN TRONG mot vong lap khac). `them_loc` khong ghi de
    nen kieu SAI cua vong dau bi khoa vinh vien, con `ks` thi vong sau sua
    dung - hai ben lech nhau va sinh IL sai AM THAM."""
    kieu_lap = "i32"
    vt_in = vt_for + 2
    if tok_kind(vt_in) == "NAME" and tok_val(vt_in) == "in":
        if tok_val(vt_in + 1) == "range":
            dat_loc(ten_an_i(vt_for), "i32", chu)
        else:
            kieu_ds = kieu_nguon_lap(vt_in + 1)
            # `for k in <tu dien>` duyet KHOA (dung nhu Python). Truoc day
            # hat giong giu nguyen kieu dict roi goi `get_Item(int32)` len
            # mot Dictionary - DICH SACH nhung nem MissingMethodException.
            if la_dict(kieu_ds) == 1:
                kieu_ds = "list[" + cat_hai(ruot(kieu_ds), 1) + "]"
            # `for x in <tap hop>`: HashSet khong co chi so, phai boc thanh
            # List truoc. Thu tu duyet cua HashSet KHAC Python, nhung Python
            # cung KHONG bao dam thu tu cua set - nen day khong phai phan ky.
            if la_set(kieu_ds) == 1:
                kieu_ds = "list[" + ruot(kieu_ds) + "]"
            dat_loc(ten_an_ds(vt_for), kieu_ds, chu)
            dat_loc(ten_an_i(vt_for), "i32", chu)
            kieu_lap = kieu_pt(kieu_ds)
    dat_loc(tok_val(vt_for + 1), kieu_lap, chu)
    return 1


def khai_cho_tup(vt_for: "i32") -> "i32":
    global CF_KIEU
    ds_b = ""
    dem = 0
    i = vt_for + 1
    while tok_kind(i) == "NAME" or (tok_kind(i) == "OP" and tok_val(i) == "("):
        if tok_kind(i) == "NAME" and tok_val(i) == "in":
            break
        if dem > 0:
            ds_b = ds_b + "|"
        if tok_kind(i) == "OP":
            # O LONG '(a, b)': gom ten con, ngan cach '~'.
            i = i + 1
            nhom = ""
            while tok_kind(i) == "NAME":
                if len(nhom) > 0:
                    nhom = nhom + "~"
                nhom = nhom + tok_val(i)
                i = i + 1
                if tok_kind(i) == "OP" and tok_val(i) == ",":
                    i = i + 1
            if tok_kind(i) == "OP" and tok_val(i) == ")":
                i = i + 1
            ds_b = ds_b + nhom
        else:
            ds_b = ds_b + tok_val(i)
            i = i + 1
        dem = dem + 1
        if tok_kind(i) == "OP" and tok_val(i) == ",":
            i = i + 1
    if tok_kind(i) != "NAME" or tok_val(i) != "in":
        return 0
    vt_in = i
    ten = ds_b.split("|")
    dang = dang_lap(vt_in)
    them_loc(ten_an_i(vt_for), "i32")
    if dang == 1:
        kds = kieu_ve_phai(vt_in + 3)
        # Nguon CHUOI -> list ky tu (2026-09-25), khop lap_nap_nguon.
        if kds == "str":
            kds = "list[str]"
        them_loc(ten_an_ds(vt_for), kds)
        them_loc(ten[0], "i32")
        if len(ten) > 1:
            if co_nhom(ten[1]) == 1:
                khai_nhom(ten[1], kieu_pt(kds), vt_for)
            else:
                them_loc(ten[1], kieu_pt(kds))
        return 1
    if dang == 3:
        ket = qua_ngoac(vt_in + 2)
        ka = kieu_ve_phai(vt_in + 3)
        if ka == "str":
            ka = "list[str]"
        them_loc(ten_an_ds(vt_for), ka)
        them_loc(ten[0], kieu_pt(ka))
        vt_phay = tim_phay_ngoai(vt_in + 3, ket)
        if vt_phay > 0 and len(ten) > 1:
            kb = kieu_ve_phai(vt_phay + 1)
            if kb == "str":
                kb = "list[str]"
            them_loc(ten_an_ds2(vt_for), kb)
            them_loc(ten[1], kieu_pt(kb))
        return 1
    if dang == 2:
        kd = kieu_ve_phai(vt_in + 1)
        lop_t = kieu_pt(kd)
        kk = "str"
        kv = "str"
        t0 = tim_truong(lop_t, "I0")
        t1 = tim_truong(lop_t, "I1")
        if t0 >= 0:
            kk = CF_KIEU[t0]
        if t1 >= 0:
            kv = CF_KIEU[t1]
        them_loc(ten_an_ds2(vt_for), "dict[" + kk + "," + kv + "]")
        them_loc(ten_an_ds(vt_for), "list[" + kk + "]")
        them_loc(ten[0], kk)
        if len(ten) > 1:
            them_loc(ten[1], kv)
        return 1
    kds = kieu_nguon_lap(vt_in + 1)
    them_loc(ten_an_ds(vt_for), kds)
    lop = kieu_pt(kds)
    j = 0
    while j < len(ten):
        ti = tim_truong(lop, "I" + str(j))
        if ti >= 0:
            if co_nhom(ten[j]) == 1:
                khai_nhom(ten[j], CF_KIEU[ti], vt_for)
            else:
                them_loc(ten[j], CF_KIEU[ti])
        else:
            them_loc(ten[j], "str")
        j = j + 1
    return 1


# Than ham [tu, ket) co tu khoa 'try' khong.
def co_try(tu: "i32", ket: "i32") -> "i32":
    i = tu
    while i < ket:
        if tok_kind(i) == "NAME" and tok_val(i) == "try":
            return 1
        i = i + 1
    return 0


# .maxstack: mot hang so co dinh la SAI. Khai thieu thi CLR khong bao gi ca
# - no ghi tran o nhung cho khac han va sinh AccessViolationException phu
# thuoc CACH BO TRI BO NHO (da do: cung mot dau vao, chi doi DO DAI DUONG
# DAN tep nguon tu 56 sang 57 ky tu la doi tu chay duoc sang do vo). Chan
# tren AN TOAN: moi token trong than ham day nhieu nhat mot gia tri, nen so
# token la du.
def maxstack_cho(vt: "i32", ket: "i32") -> "str":
    n = ket - vt
    if n < 64:
        n = 64
    return "    .maxstack " + str(n)


def phat_locals() -> "i32":
    global LOC_KIEU
    global LOC_N
    global SO_THAM
    if LOC_N <= SO_THAM:
        return 0
    s = "    .locals init ("
    i = SO_THAM
    while i < LOC_N:
        if i > SO_THAM:
            s = s + ", "
        s = s + il_kieu(LOC_KIEU[i]) + " V_" + str(i - SO_THAM)
        i = i + 1
    ra(s + ")")
    # TEN bien theo thu tu o nho - cho kiem_kieu.py bao loi bang ten that.
    ten_bien = "    // bien:"
    i = SO_THAM
    while i < LOC_N:
        ten_bien = ten_bien + " " + LOC_TEN[i]
        i = i + 1
    ra(ten_bien)
    return LOC_N - SO_THAM


# ---- 'def' LONG khong co 'nonlocal': NANG LEN thanh ham tinh rieng -------
# Bien cua ham bao ma ham long chi DOC tro thanh THAM SO DAU TIEN. Nho vay
# ban nang len khong con phu thuoc khung cua ham bao, khong can lop o nho.
# CO 'nonlocal' thi KHONG lam duoc kieu nay (phai co o nho dung chung de ghi
# nguoc) - nhung ham do khong duoc ghi vao bang nay, van bao loi nhu cu.
LG_VT: "list[i32]" = []
LG_CHU: "list[i32]" = []
LG_TEN: "list[str]" = []
LG_MOI: "list[str]" = []
LG_BAT: "list[str]" = []
LG_KBAT: "list[str]" = []
LG_N: "i32" = 0
# Ham dang duoc PHAT (token 'def' cua no), de doi ten loi goi cho dung pham vi.
LG_HIEN: "i32" = 0 - 1


def them_lg(vt: "i32", chu: "i32") -> "i32":
    global LG_VT
    global LG_CHU
    global LG_TEN
    global LG_MOI
    global LG_BAT
    global LG_KBAT
    global LG_N
    if LG_N == len(LG_VT):
        LG_VT.append(vt)
        LG_CHU.append(chu)
        LG_TEN.append("")
        LG_MOI.append("")
        LG_BAT.append("")
        LG_KBAT.append("")
    else:
        LG_VT[LG_N] = vt
        LG_CHU[LG_N] = chu
        LG_TEN[LG_N] = ""
        LG_MOI[LG_N] = ""
        LG_BAT[LG_N] = ""
        LG_KBAT[LG_N] = ""
    LG_N = LG_N + 1
    return LG_N - 1


def chi_so_lg_vt(vt: "i32") -> "i32":
    i = 0
    while i < LG_N:
        if LG_VT[i] == vt:
            return i
        i = i + 1
    return 0 - 1


def chi_so_lg_moi(ten: "str") -> "i32":
    i = 0
    while i < LG_N:
        if LG_MOI[i] == ten:
            return i
        i = i + 1
    return 0 - 1


# Token ngay SAU dau DED dong khoi cua mot 'def'.
def cuoi_khoi_def(vt_def: "i32") -> "i32":
    i = vt_def
    while tok_kind(i) != "IND" and tok_kind(i) != "EOF":
        i = i + 1
    if tok_kind(i) != "IND":
        return i
    sau = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
        if tok_kind(i) == "DED":
            sau = sau - 1
            if sau == 0:
                return i + 1
        i = i + 1
    return i


def dau_dong_tok(i: "i32") -> "i32":
    if i == 0:
        return 1
    if tok_kind(i - 1) == "NL":
        return 1
    if tok_kind(i - 1) == "IND":
        return 1
    if tok_kind(i - 1) == "DED":
        return 1
    return 0


# Mot bien `nonlocal` co bi GAN LAI trong than def khong (2026-09-24). Phan
# lon ham long trong cay khai `nonlocal` CHI de thoa luat cua trinh that
# ("dong dau phai la nonlocal") ma chi DOC bien bat - nang len va truyen theo
# GIA TRI la dung nghia. Gan lai (`x = ...`, `x += ...`, `a, x = ...`) thi
# khong: can o nho dung chung, giu nguyen duong cu (khong nang).
# `x.f = ...` / `x[i] = ...` KHONG la gan lai ten x.
def nonlocal_bi_gan(vt_def: "i32") -> "i32":
    ket = cuoi_khoi_def(vt_def)
    ten_nl = ""
    i = vt_def
    while i < ket:
        if tok_kind(i) == "NAME" and tok_val(i) == "nonlocal":
            j = i + 1
            while j < ket and (tok_kind(j) == "NAME" or (tok_kind(j) == "OP" and tok_val(j) == ",")):
                if tok_kind(j) == "NAME":
                    ten_nl = ten_nl + "|" + tok_val(j) + "|"
                j = j + 1
        i = i + 1
    if ten_nl == "":
        return 0
    i = vt_def
    while i < ket:
        if tok_kind(i) == "NAME" and dau_dong_tok(i) == 1:
            j = i
            co_ten = 0
            while j < ket and (tok_kind(j) == "NAME" or (tok_kind(j) == "OP" and tok_val(j) == ",")):
                if tok_kind(j) == "NAME" and ("|" + tok_val(j) + "|") in ten_nl:
                    co_ten = 1
                j = j + 1
            if co_ten == 1 and tok_kind(j) == "OP":
                o = tok_val(j)
                if o == "=" or o == "+=" or o == "-=" or o == "*=" or o == "/=" or o == "//=" or o == "%=" or o == "|=" or o == "&=":
                    return 1
        i = i + 1
    return 0


def than_co_nonlocal(vt_def: "i32") -> "i32":
    ket = cuoi_khoi_def(vt_def)
    i = vt_def
    while i < ket:
        if tok_kind(i) == "NAME" and tok_val(i) == "nonlocal":
            return 1
        i = i + 1
    return 0


# Do sau KHOI khong bang do sau DEF ('if' cung tang mot bac), nen phai theo
# doi RIENG chu cua tung muc thut vao.
def quet_vt_ham_long() -> "i32":
    chu_vt = []
    chu_la = []
    chu_vt.append(0 - 1)
    chu_la.append(0)
    cho_mo = 0 - 1
    cho_la = 0
    sau = 0
    i = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "IND":
            sau = sau + 1
            while len(chu_vt) <= sau:
                chu_vt.append(0 - 1)
                chu_la.append(0)
            if cho_mo >= 0:
                chu_vt[sau] = cho_mo
                chu_la[sau] = cho_la
            else:
                chu_vt[sau] = chu_vt[sau - 1]
                chu_la[sau] = chu_la[sau - 1]
            cho_mo = 0 - 1
        if tok_kind(i) == "DED":
            sau = sau - 1
        if tok_kind(i) == "NAME" and dau_dong_tok(i) == 1:
            t = tok_val(i)
            if t == "def" or t == "class":
                cho_mo = i
                cho_la = 0
                if t == "def":
                    cho_la = 1
                if t == "def" and sau > 0 and chu_la[sau] == 1:
                    lam = 1
                    if than_co_nonlocal(i) == 1 and nonlocal_bi_gan(i) == 1:
                        lam = 0
                    if tok_val(chu_vt[sau] + 3) == "self":
                        lam = 0
                    # Dung ten ham long LAM GIA TRI: tu 2026-09-24 van NANG -
                    # o vi tri gia tri, bt_tro_ham_long dung lop chuyen tiep
                    # giu bien bat (xem AD_*).
                    if lam == 1:
                        them_lg(i, chu_vt[sau])
        i = i + 1
    return LG_N


# Dung LOC bang cua mot 'def' bat ky: tham so + bien than (bo qua def long).
# Ten 'ten' co xuat hien trong khoi cua 'chu' ma KHONG phai la loi goi khong.
def dung_lam_gia_tri(chu: "i32", ten: "str") -> "i32":
    ket = cuoi_khoi_def(chu)
    i = chu
    while i < ket:
        if tok_kind(i) == "NAME" and tok_val(i) == ten:
            if tok_kind(i - 1) == "NAME" and tok_val(i - 1) == "def":
                i = i + 1
                continue
            if tok_kind(i - 1) == "OP" and tok_val(i - 1) == ".":
                i = i + 1
                continue
            if tok_kind(i + 1) != "OP" or tok_val(i + 1) != "(":
                return 1
        i = i + 1
    return 0


def nap_loc_ham(vt_def: "i32") -> "i32":
    global LOC_N
    global VT
    global LG_HIEN
    vt_cu = VT
    lg_cu = LG_HIEN
    LG_HIEN = vt_def
    LOC_N = 0
    VT = vt_def
    an()
    an()
    can_op("(")
    if la_op(")") == 0:
        con = 1
        while con == 1:
            pten = v()
            an()
            pkieu = "i32"
            if la_op(":") == 1:
                an()
                pkieu = v()
                an()
            if la_op("=") == 1:
                an()
                qua_mac_dinh()
            them_loc(pten, pkieu)
            if khop_op(",") == 0:
                con = 0
    can_op(")")
    if khop_op("->") == 1:
        an()
    can_op(":")
    quet_bien_cuc_bo(VT)
    VT = vt_cu
    LG_HIEN = lg_cu
    return 0


def tim_trong_ds(ds: "list[str]", t: "str") -> "i32":
    i = 0
    while i < len(ds):
        if ds[i] == t:
            return i
        i = i + 1
    return 0 - 1


# Bien BAT DUOC: ten xuat hien trong than ham long, CO trong khung ham bao,
# va KHONG phai bien/tham so cua chinh ham long (bi che thi khong bat).
def tinh_bat_lg(idx: "i32") -> "i32":
    global LG_TEN
    global LG_BAT
    global LG_KBAT
    global LOC_TEN
    global LOC_KIEU
    global LOC_N
    vt = LG_VT[idx]
    LG_TEN[idx] = tok_val(vt + 1)
    nap_loc_ham(LG_CHU[idx])
    ow_ten = []
    ow_kieu = []
    i = 0
    while i < LOC_N:
        ow_ten.append(LOC_TEN[i])
        ow_kieu.append(LOC_KIEU[i])
        i = i + 1
    nap_loc_ham(vt)
    ket = cuoi_khoi_def(vt)
    bten = []
    bkieu = []
    i = vt
    while i < ket:
        if tok_kind(i) == "NAME":
            t = tok_val(i)
            sau_cham = 0
            if tok_kind(i - 1) == "OP" and tok_val(i - 1) == ".":
                sau_cham = 1
            if sau_cham == 0 and tu_khoa(t) == 0 and tim_loc(t) < 0:
                j = tim_trong_ds(ow_ten, t)
                if j >= 0 and tim_trong_ds(bten, t) < 0:
                    bten.append(t)
                    bkieu.append(ow_kieu[j])
        i = i + 1
    LG_BAT[idx] = "|".join(bten)
    LG_KBAT[idx] = "|".join(bkieu)
    return len(bten)


def so_bat_lg(idx: "i32") -> "i32":
    if LG_BAT[idx] == "":
        return 0
    return len(LG_BAT[idx].split("|"))


def dang_ky_lg(idx: "i32") -> "i32":
    global FN_TEN
    global FN_RET
    global FN_PSO
    global FN_PDAU
    global FN_N
    global PAR_N
    global LG_TEN
    global LG_MOI
    global VT
    vt = LG_VT[idx]
    LG_MOI[idx] = tok_val(vt + 1) + "_lg" + str(vt)
    dau = PAR_N
    so = 0
    if LG_BAT[idx] != "":
        bten = LG_BAT[idx].split("|")
        bkieu = LG_KBAT[idx].split("|")
        i = 0
        while i < len(bten):
            them_tham2(bten[i], bkieu[i], 0 - 1)
            so = so + 1
            i = i + 1
    vt_cu = VT
    VT = vt
    an()
    an()
    can_op("(")
    if la_op(")") == 0:
        con = 1
        while con == 1:
            pten = v()
            an()
            pk = "i32"
            if la_op(":") == 1:
                an()
                pk = v()
                an()
            vt_md = 0 - 1
            if la_op("=") == 1:
                an()
                vt_md = VT
                qua_mac_dinh()
            them_tham2(pten, pk, vt_md)
            so = so + 1
            if khop_op(",") == 0:
                con = 0
    can_op(")")
    ret = "i32"
    if khop_op("->") == 1:
        ret = chuan_tup(v())
        an()
    VT = vt_cu
    if FN_N == len(FN_TEN):
        FN_TEN.append(LG_MOI[idx])
        FN_RET.append(ret)
        FN_PSO.append(so)
        FN_PDAU.append(dau)
    else:
        FN_TEN[FN_N] = LG_MOI[idx]
        FN_RET[FN_N] = ret
        FN_PSO[FN_N] = so
        FN_PDAU[FN_N] = dau
    FN_N = FN_N + 1
    return FN_N - 1


# Mot ham long GOI mot ham long khac thi phai mang ho ca bien bat cua ban
# kia - neu khong, cho goi se nap mot ten khong co trong khung cua no.
def them_bat_tu_goi(idx: "i32") -> "i32":
    global LG_BAT
    global LG_KBAT
    nap_loc_ham(LG_VT[idx])
    bten = []
    bkieu = []
    if LG_BAT[idx] != "":
        bten = LG_BAT[idx].split("|")
        bkieu = LG_KBAT[idx].split("|")
    ket = cuoi_khoi_def(LG_VT[idx])
    i = LG_VT[idx]
    while i < ket:
        if tok_kind(i) == "NAME":
            j = 0
            while j < LG_N:
                if j != idx and LG_TEN[j] == tok_val(i) and LG_CHU[j] == LG_CHU[idx]:
                    gop_bat(j, bten, bkieu)
                j = j + 1
        i = i + 1
    LG_BAT[idx] = "|".join(bten)
    LG_KBAT[idx] = "|".join(bkieu)
    return len(bten)


def gop_bat(j: "i32", bten: "list[str]", bkieu: "list[str]") -> "i32":
    if LG_BAT[j] == "":
        return 0
    t2 = LG_BAT[j].split("|")
    k2 = LG_KBAT[j].split("|")
    i = 0
    while i < len(t2):
        if tim_trong_ds(bten, t2[i]) < 0:
            if tim_loc(t2[i]) >= 0:
                em_loi("ham long che mat bien bat duoc: " + t2[i])
            else:
                bten.append(t2[i])
                bkieu.append(k2[i])
        i = i + 1
    return 1


def thu_thap_ham_long() -> "i32":
    i = 0
    while i < LG_N:
        tinh_bat_lg(i)
        i = i + 1
    vong = 0
    while vong < 4:
        i = 0
        while i < LG_N:
            them_bat_tu_goi(i)
            i = i + 1
        vong = vong + 1
    i = 0
    while i < LG_N:
        dang_ky_lg(i)
        i = i + 1
    return LG_N


# 'chu' co nam tren duong tu ham dang phat nguoc len goc khong.
def thuoc_pham_vi_lg(chu: "i32") -> "i32":
    h = LG_HIEN
    while h >= 0:
        if h == chu:
            return 1
        j = chi_so_lg_vt(h)
        if j < 0:
            return 0
        h = LG_CHU[j]
    return 0


def doi_ten_lg(ten: "str") -> "str":
    i = 0
    while i < LG_N:
        if LG_TEN[i] == ten:
            if thuoc_pham_vi_lg(LG_CHU[i]) == 1:
                return LG_MOI[i]
        i = i + 1
    return ten


def nap_bat_lg(idx: "i32") -> "str":
    ky = ""
    if LG_BAT[idx] == "":
        return ky
    bten = LG_BAT[idx].split("|")
    i = 0
    while i < len(bten):
        kk = nap_ten(bten[i])
        if i > 0:
            ky = ky + ", "
        ky = ky + il_kieu(kk)
        i = i + 1
    return ky


def phat_ham_long(idx: "i32") -> "i32":
    global CO_TRY
    global NHAN_RA
    global RET_HIEN
    global LOC_N
    global SO_THAM
    global VT
    global LG_HIEN
    LOC_N = 0
    VT = LG_VT[idx]
    an()
    an()
    can_op("(")
    ky = ""
    dem = 0
    if LG_BAT[idx] != "":
        bten = LG_BAT[idx].split("|")
        bkieu = LG_KBAT[idx].split("|")
        i = 0
        while i < len(bten):
            them_loc(bten[i], bkieu[i])
            if dem > 0:
                ky = ky + ", "
            ky = ky + il_kieu(bkieu[i]) + " " + ten_il(bten[i])
            dem = dem + 1
            i = i + 1
    if la_op(")") == 0:
        con = 1
        while con == 1:
            pten = v()
            an()
            pkieu = "i32"
            if la_op(":") == 1:
                an()
                pkieu = v()
                an()
            if la_op("=") == 1:
                an()
                qua_mac_dinh()
            them_loc(pten, pkieu)
            if dem > 0:
                ky = ky + ", "
            ky = ky + il_kieu(pkieu) + " " + ten_il(pten)
            dem = dem + 1
            if khop_op(",") == 0:
                con = 0
    can_op(")")
    SO_THAM = dem
    ret = "i32"
    if khop_op("->") == 1:
        ret = chuan_tup(v())
        an()
    RET_HIEN = ret
    can_op(":")
    lg_cu = LG_HIEN
    LG_HIEN = LG_VT[idx]
    ket = quet_bien_cuc_bo(VT)
    CO_TRY = co_try(VT, ket)
    NHAN_RA = nhan_moi()
    if CO_TRY == 1:
        them_loc("__ret", ret)
    ra("  .method public static " + il_kieu(ret) + " " + LG_MOI[idx] + "(" + ky + ") cil managed")
    ra("  {")
    ra(maxstack_cho(LG_VT[idx], ket))
    phat_locals()
    khoi()
    if CO_TRY == 1:
        ra("  L" + str(NHAN_RA) + ":")
        nap_ten("__ret")
        ra("    ret")
        CO_TRY = 0
    else:
        ra_mac_dinh(ret)
        ra("    ret")
    ra("  }")
    ra("")
    phat_lg_cua(LG_VT[idx])
    LG_HIEN = lg_cu
    return ket


def phat_lg_cua(chu: "i32") -> "i32":
    global VT
    global CO_TRY
    global NHAN_RA
    global RET_HIEN
    global SO_THAM
    i = 0
    while i < LG_N:
        if LG_CHU[i] == chu:
            vt_cu = VT
            co_cu = CO_TRY
            nh_cu = NHAN_RA
            ret_cu = RET_HIEN
            st_cu = SO_THAM
            phat_ham_long(i)
            VT = vt_cu
            CO_TRY = co_cu
            NHAN_RA = nh_cu
            RET_HIEN = ret_cu
            SO_THAM = st_cu
        i = i + 1
    return 0


# Dich mot 'def' bat dau tai VT (dang tro vao tu khoa 'def').
def phat_mot_ham() -> "i32":
    global GEN_KIEU
    global GEN_DS
    global CO_TRY
    global NHAN_RA
    global RET_HIEN
    global LOC_N
    global SO_THAM
    global VT
    global PAR_KIEU
    global FN_PDAU
    global FN_PSO
    global FN_RET
    global LG_HIEN
    LOC_N = 0
    LG_HIEN = VT
    vt_def_nay = VT
    an()
    ten = v()
    fi = tim_ham(ten)
    an()
    can_op("(")
    ky = ""
    dem = 0
    if la_op(")") == 0:
        con = 1
        while con == 1:
            pten = v()
            an()
            pkieu = "i32"
            if la_op(":") == 1:
                an()
                pkieu = v()
                an()
            if la_op("=") == 1:
                an()
                qua_mac_dinh()
            them_loc(pten, pkieu)
            if dem > 0:
                ky = ky + ", "
            ky = ky + il_kieu(pkieu) + " " + ten_il(pten)
            dem = dem + 1
            if khop_op(",") == 0:
                con = 0
    can_op(")")
    SO_THAM = dem
    ret = "i32"
    if khop_op("->") == 1:
        ret = v()
        an()
    can_op(":")
    # PHAI dat RET_HIEN TRUOC khi tien quet chay: tien quet dung no de suy
    # kieu cho container rong (`x = []` / `x = {}`). Truoc day no chi duoc
    # dat SAU tien quet, nen trong suot tien quet no con mang kieu tra ve
    # cua ham TRUOC do - mot cho sinh ma sai am tham. (Dong `RET_HIEN = ret`
    # ben duoi giu nguyen: nhanh ham sinh khong doi `ret`.)
    RET_HIEN = ret
    ket = quet_bien_cuc_bo(VT)
    # HAM SINH: kieu khai bao la kieu PHAN TU, kieu tra ve that la danh sach.
    sinh = la_ham_sinh(VT, ket)
    if sinh == 1:
        # QUY UOC CUA DU AN (il_codegen.py:6164): ham sinh PHAI khai
        # `-> "list[dtype]"`, va dtype do la kieu PHAN TU yield ra.
        # Ban dau toi lam nguoc lai (coi khai bao la kieu phan tu) - nhu the
        # hat giong va trinh bien dich that BAT DONG voi nhau tren cung mot
        # file nguon, dung cai vua mat cong dong lai.
        if la_list(ret) == 0:
            em_loi("ham sinh '" + ten + "' phai khai `-> \"list[dtype]\"`, gap " + ret)
        GEN_KIEU = kieu_pt(ret)
        GEN_DS = ret
        them_loc("__gen", ret)
    RET_HIEN = ret
    CO_TRY = co_try(VT, ket)
    NHAN_RA = nhan_moi()
    if CO_TRY == 1:
        them_loc("__ret", ret)
    ra("  .method public static " + il_kieu(ret) + " " + ten_il(ten) + "(" + ky + ") cil managed")
    ra("  {")
    if ten == "main":
        ra("    .entrypoint")
    ra(maxstack_cho(vt_def_nay, ket))
    phat_locals()
    if sinh == 1:
        ra("    newobj instance void " + il_kieu(ret) + "::.ctor()")
        luu_ten("__gen")
    khoi()
    # Duong roi: ham nao cung ket thuc bang mot 'ret' hop le.
    if CO_TRY == 1:
        ra("  L" + str(NHAN_RA) + ":")
        nap_ten("__ret")
        ra("    ret")
        CO_TRY = 0
    else:
        if sinh == 1:
            # Ham sinh roi het than: tra ve danh sach da gom.
            nap_ten("__gen")
        else:
            ra_mac_dinh(ret)
        ra("    ret")
    GEN_KIEU = ""
    GEN_DS = ""
    ra("  }")
    ra("")
    phat_lg_cua(vt_def_nay)
    LG_HIEN = 0 - 1
    return ket


# .maxstack: hat giong KHONG tinh do sau ngan xep that, nen phai khai DU
# LON. Khai thieu thi .NET khong bao loi - no ghi tran va sinh
# AccessViolationException KHONG TAT DINH o cho khac han.
# Mot method thuc the: arg0 la 'self'. '__init__' thanh .ctor.
def phat_mot_met(lop: "str") -> "i32":
    global LG_HIEN
    global CO_TRY
    global NHAN_RA
    global LOC_N
    global SO_THAM
    global RET_HIEN
    global VT
    LOC_N = 0
    LG_HIEN = 0 - 1
    vt_met = VT
    an()
    met = v()
    an()
    can_op("(")
    them_loc("self", lop)
    ky = ""
    dem = 1
    con = 1
    if la_op(")") == 0:
        while con == 1:
            pten = v()
            an()
            pkieu = "i32"
            if khop_op(":") == 1:
                pkieu = v()
                an()
            if la_op("=") == 1:
                an()
                qua_mac_dinh()
            if pten != "self":
                them_loc(pten, pkieu)
                if dem > 1:
                    ky = ky + ", "
                ky = ky + il_kieu(pkieu) + " " + ten_il(pten)
                dem = dem + 1
            if khop_op(",") == 0:
                con = 0
    can_op(")")
    SO_THAM = dem
    ret = "i32"
    if khop_op("->") == 1:
        ret = v()
        an()
    RET_HIEN = ret
    can_op(":")
    ket_m = quet_bien_cuc_bo(VT)
    CO_TRY = co_try(VT, ket_m)
    NHAN_RA = nhan_moi()
    if CO_TRY == 1:
        them_loc("__ret", ret)
    if met == "__init__":
        ra("  .method public specialname rtspecialname instance void .ctor(" + ky + ") cil managed")
        ra("  {")
        ra(maxstack_cho(vt_met, ket_m))
        phat_locals()
        ra("    ldarg.0")
        ra("    call instance void [mscorlib]System.Object::.ctor()")
        phat_khoi_tao_truong_chua(lop)
        khoi()
        ra("    ret")
        ra("  }")
        ra("")
        return 1
    ra("  .method public instance " + il_kieu(ret) + " " + ten_il(met) + "(" + ky + ") cil managed")
    ra("  {")
    ra(maxstack_cho(vt_met, ket_m))
    phat_locals()
    khoi()
    if CO_TRY == 1:
        ra("  L" + str(NHAN_RA) + ":")
        nap_ten("__ret")
        ra("    ret")
        ra("  }")
        ra("")
        CO_TRY = 0
        return 1
    if ret == "str":
        ra("    ldstr \"\"")
    else:
        if la_chua(ret) == 1 or tim_lop(ret) >= 0:
            ra("    ldnull")
        else:
            ra("    ldc.i4.0")
    ra("    ret")
    ra("  }")
    ra("")
    return 1


# Truong kieu CHUA (list/dict/set) cua mot lop duoc khoi tao RONG ngay trong
# .ctor - dung nhu trinh bien dich that lam. Thieu buoc nay thi truong la
# null va moi phep ghi vao no nem NullReferenceException LUC CHAY, khong mot
# loi dich nao bao truoc.
def phat_khoi_tao_truong_chua(lop: "str") -> "i32":
    i = 0
    while i < CF_N:
        if CF_LOP[i] == lop and la_chua(CF_KIEU[i]) == 1:
            ra("    ldarg.0")
            ra("    newobj instance void " + il_kieu(CF_KIEU[i]) + "::.ctor()")
            ra("    stfld " + il_kieu(CF_KIEU[i]) + " " + lop + "::" + ten_il(CF_TEN[i]))
        i = i + 1
    return 0


def phat_mot_lop() -> "i32":
    global LOP_HIEN
    global CF_LOP
    global CF_TEN
    global CF_KIEU
    global CF_N
    an()
    lop = v()
    LOP_HIEN = lop
    an()
    if khop_op("(") == 1:
        # Hat giong KHONG co ke thua: doc lop cha roi bo qua. Chi dung duoc
        # vi cac lop co lop cha tren duong dich deu la lop ngoai le.
        while la_op(")") == 0 and k() != "EOF":
            an()
        can_op(")")
    can_op(":")
    cha_il = "[mscorlib]System.Object"
    if la_ngoai_le(lop) == 1:
        cha_il = exc_il(cha_cua(lop))
    ra(".class public auto ansi beforefieldinit " + lop + " extends " + cha_il)
    ra("{")
    i = 0
    while i < CF_N:
        if CF_LOP[i] == lop:
            ra("  .field public " + il_kieu(CF_KIEU[i]) + " " + ten_il(CF_TEN[i]))
        i = i + 1
    if tim_met(lop, "__init__") < 0:
        if la_ngoai_le(lop) == 1:
            phat_ctor_ngoai_le(lop, cha_il)
        else:
            phat_ctor_mac_dinh(lop)
    elif la_ngoai_le(lop) == 1:
        em_loi("lop ngoai le co __init__ rieng chua ho tro: " + lop)
    if k() != "NL":
        em_loi("cho doi xuong dong sau 'class'")
        return 0
    an()
    if k() != "IND":
        em_loi("cho doi than lop")
        return 0
    an()
    while k() != "DED" and k() != "EOF":
        if la_op("@") == 1:
            an()
            bo_met = 0
            if v() == "__tkv_cpython_only__":
                bo_met = 1
            while k() != "NL" and k() != "EOF":
                an()
            if k() == "NL":
                an()
            if bo_met == 1:
                bo_qua_mot_met()
            continue
        if la_ten("def") == 1:
            phat_mot_met(lop)
        else:
            if k() == "STR":
                an()
            else:
                while k() != "NL" and k() != "EOF":
                    an()
        if k() == "NL":
            an()
    if k() == "DED":
        an()
    ra("}")
    ra("")
    LOP_HIEN = ""
    return 1


# LOP KHONG khai `__init__`: trinh bien dich THAT tu sinh mot .ctor nhan
# cac truong VO HUONG theo dung thu tu khai bao, con truong CONTAINER thi
# khoi tao rong ngay trong .ctor (xem gen_record_types). Hat giong truoc
# day khong sinh gi ca, ma cho goi VAN day doi so len ngan xep roi phat
# `newobj <Lop>::.ctor()` - lech ngan xep + MissingMethodException luc
# chay, trong khi van bao "OK ... dong IL".
def so_truong_ctor(lop: "str") -> "i32":
    global CF_LOP
    global CF_KIEU
    global CF_N
    n = 0
    i = 0
    while i < CF_N:
        if CF_LOP[i] == lop and la_chua(CF_KIEU[i]) == 0:
            n = n + 1
        i = i + 1
    return n


def ky_ctor_mac_dinh(lop: "str") -> "str":
    global CF_LOP
    global CF_KIEU
    global CF_N
    ky = ""
    dem = 0
    i = 0
    while i < CF_N:
        if CF_LOP[i] == lop and la_chua(CF_KIEU[i]) == 0:
            if dem > 0:
                ky = ky + ", "
            ky = ky + il_kieu(CF_KIEU[i])
            dem = dem + 1
        i = i + 1
    return ky


def phat_ctor_mac_dinh(lop: "str") -> "i32":
    global CF_LOP
    global CF_TEN
    global CF_KIEU
    global CF_N
    ky = ""
    dem = 0
    i = 0
    while i < CF_N:
        if CF_LOP[i] == lop and la_chua(CF_KIEU[i]) == 0:
            if dem > 0:
                ky = ky + ", "
            ky = ky + il_kieu(CF_KIEU[i]) + " p" + str(dem)
            dem = dem + 1
        i = i + 1
    ra("  .method public specialname rtspecialname instance void .ctor(" + ky + ") cil managed")
    ra("  {")
    ra("    .maxstack 64")
    ra("    ldarg.0")
    ra("    call instance void [mscorlib]System.Object::.ctor()")
    dem = 0
    i = 0
    while i < CF_N:
        if CF_LOP[i] == lop and la_chua(CF_KIEU[i]) == 0:
            ra("    ldarg.0")
            ra("    ldarg.s " + str(dem + 1))
            ra("    stfld " + il_kieu(CF_KIEU[i]) + " " + lop + "::" + ten_il(CF_TEN[i]))
            dem = dem + 1
        i = i + 1
    i = 0
    while i < CF_N:
        if CF_LOP[i] == lop and la_chua(CF_KIEU[i]) == 1:
            ra("    ldarg.0")
            ra("    newobj instance void " + il_kieu(CF_KIEU[i]) + "::.ctor()")
            ra("    stfld " + il_kieu(CF_KIEU[i]) + " " + lop + "::" + ten_il(CF_TEN[i]))
        i = i + 1
    ra("    ret")
    ra("  }")
    return 1


def phat_dau_chuong_trinh() -> "i32":
    ra(".assembly extern mscorlib {}")
    ra(".assembly extern System.Core { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }")
    ra(".assembly extern System { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }")
    ra(".assembly TkvSeed {}")
    ra(".module TkvSeed.exe")
    ra("")
    return 1


def phat_mo_tkv() -> "i32":
    ra(".class public auto ansi beforefieldinit Tkv extends [mscorlib]System.Object")
    ra("{")
    return 1


# Bo qua tron mot khoi 'class' o luot phat ham.
def bo_qua_mot_met() -> "i32":
    """Bo qua TRON VEN mot method (dong `def` + than thut vao) - dung cho
    method mang `@__tkv_cpython_only__`. Cung khuon dem IND/DED nhu
    `nhay_qua_lop`, chi khac la dung lai o muc than lop."""
    global VT
    while k() != "NL" and k() != "EOF":
        an()
    if k() == "NL":
        an()
    if k() != "IND":
        return 1
    sau = 0
    while k() != "EOF":
        if k() == "IND":
            sau = sau + 1
        if k() == "DED":
            sau = sau - 1
            an()
            if sau <= 0:
                return 1
            continue
        an()
    return 0


def nhay_qua_lop() -> "i32":
    global VT
    sau = 0
    mo = 0
    while k() != "EOF":
        if k() == "IND":
            sau = sau + 1
            mo = 1
        if k() == "DED":
            sau = sau - 1
            an()
            if mo == 1 and sau <= 0:
                return 1
            continue
        an()
    return 0


# 'a in b' day a TRUOC b, nhung Contains la method cua b. Thay vi bia bien tam,
# phat ba ham tro giup nhan tham so dung thu tu da day.
# __repr_str: repr() cua chuoi THEO CPython. Nhay mac dinh la ' ; doi sang "
# khi chuoi chua ' ma KHONG chua ". Thoat: dau \ , nhay dang dung, \n \r \t;
# ky tu dieu khien (<32 hoac 127) -> \xNN (hex thuong, 2 chu so). Ky tu khac
# - ke ca ngoai ASCII - giu nguyen (CPython chi thoat ky tu KHONG in duoc).
def phat_repr_str() -> "i32":
    ra("  .method public static string __repr_str(string s) cil managed")
    ra("  {")
    ra("    .maxstack 64")
    ra("    .locals init (class [mscorlib]System.Text.StringBuilder sb, char q, int32 i, char c, int32 k)")
    ra("    ldc.i4.s 39")
    ra("    stloc.1")
    ra("    ldarg.0")
    ra("    ldc.i4.s 39")
    ra("    callvirt instance int32 [mscorlib]System.String::IndexOf(char)")
    ra("    ldc.i4.0")
    ra("    blt __rp_q")
    ra("    ldarg.0")
    ra("    ldc.i4.s 34")
    ra("    callvirt instance int32 [mscorlib]System.String::IndexOf(char)")
    ra("    ldc.i4.0")
    ra("    bge __rp_q")
    ra("    ldc.i4.s 34")
    ra("    stloc.1")
    ra("  __rp_q:")
    ra("    newobj instance void [mscorlib]System.Text.StringBuilder::.ctor()")
    ra("    stloc.0")
    ra("    ldloc.0")
    ra("    ldloc.1")
    ra("    callvirt instance class [mscorlib]System.Text.StringBuilder [mscorlib]System.Text.StringBuilder::Append(char)")
    ra("    pop")
    ra("    ldc.i4.0")
    ra("    stloc.2")
    ra("  __rp_lap:")
    ra("    ldloc.2")
    ra("    ldarg.0")
    ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
    ra("    bge __rp_het")
    ra("    ldarg.0")
    ra("    ldloc.2")
    ra("    callvirt instance char [mscorlib]System.String::get_Chars(int32)")
    ra("    stloc.3")
    ra("    ldloc.3")
    ra("    ldloc.1")
    ra("    beq __rp_thoat")
    ra("    ldloc.3")
    ra("    ldc.i4.s 92")
    ra("    beq __rp_thoat")
    ra("    ldloc.3")
    ra("    ldc.i4.s 10")
