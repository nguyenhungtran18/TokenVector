def ten_il(x: "str") -> "str":
    if tu_khoa_il(x) == 1:
        return "'" + x + "'"
    return x


def bat_dau_bang(x: "str", tien_to: "str") -> "i32":
    if len(x) < len(tien_to):
        return 0
    if x[0:len(tien_to)] == tien_to:
        return 1
    return 0


# Phan trong cua 'list[...]' / 'set[...]' / 'dict[...]' / '(...)'.
def ruot(kieu: "str") -> "str":
    d = 0
    i = 0
    while i < len(kieu):
        if kieu[i] == "[" or kieu[i] == "(":
            d = d + 1
            if d == 1:
                return kieu[i + 1:len(kieu) - 1]
        i = i + 1
    return kieu


# Cat 'K,V' thanh hai o DAU PHAY NGOAI CUNG. tra ve phan dau neu lay_dau=1.
def cat_hai(x: "str", lay_dau: "i32") -> "str":
    d = 0
    i = 0
    while i < len(x):
        c = x[i]
        if c == "[" or c == "(":
            d = d + 1
        if c == "]" or c == ")":
            d = d - 1
        if c == "," and d == 0:
            if lay_dau == 1:
                return x[0:i].strip()
            # `.strip()`: chu kieu viet co khoang trang sau dau phay
            # ('dict[str, func(...)->X]') thi nua sau bat dau bang MOT DAU
            # CACH, va moi phep `bat_dau_bang(t, "func(")` sau do deu truot.
            return x[i + 1:len(x)].strip()
        i = i + 1
    if lay_dau == 1:
        return x.strip()
    return "str"


# Kieu tuple viet trong chu kieu: '(str,str,i32)' -> dang ky mot lop.
def tup_tu_chu(kieu: "str") -> "str":
    trong = ruot(kieu)
    mo_ta = ""
    d = 0
    dau = 0
    i = 0
    while i <= len(trong):
        het = 0
        if i == len(trong):
            het = 1
        else:
            c = trong[i]
            if c == "[" or c == "(":
                d = d + 1
            if c == "]" or c == ")":
                d = d - 1
            if c == "," and d == 0:
                het = 1
        if het == 1:
            if len(mo_ta) > 0:
                mo_ta = mo_ta + "|"
            # CHUAN HOA tung phan nhu chuan_tup (2026-09-25): truoc day phan
            # la VAN BAN THO, nen '(Signature,list[str])' long trong mot kieu
            # co HAI ten lop (tho vs Tup2_...) tuy duong di - dinh nghia ham va
            # cho goi lech chu ky, CLR nem MissingMethodException LUC CHAY.
            mo_ta = mo_ta + chuan_tup(trong[dau:i].strip())
            dau = i + 1
        i = i + 1
    return dang_ky_tup(mo_ta)


# Dich chu kieu sang kieu IL. PHAN TICH DE QUY chu khong tra bang cung:
# 'list[(str,str,i32)]' phai ra duoc, va do la kieu THAT trong nguon.
# Khong dung bien cap module: tranh phai khai 'global' o moi cho doc.
def re_ns() -> "str":
    return "[System]System.Text.RegularExpressions."


# Mot the NUM la SO THUC khi no chua dau cham hoac phan mu. Bo tach tu chi
# gop '.'/'e' vao the khi NGAY SAU la chu so, nen kiem o day la du.
def la_so_thuc(vb: "str") -> "i32":
    i = 0
    while i < len(vb):
        c = vb[i]
        if c == "." or c == "e" or c == "E":
            return 1
        i = i + 1
    return 0


def il_kieu(kieu: "str") -> "str":
    # CHUAN HOA truoc (2026-09-25): bi danh handle (TkvSig -> Signature...) va
    # tuple long. Truoc day chi duong GOI chuan hoa, duong KHAI dau ham thi
    # khong - 'sig: "TkvSig"' ra 'int32 sig' o dinh nghia nhung 'class
    # Signature' o cho goi: MissingMethodException LUC CHAY.
    if len(kieu) > 2 and kieu[0] != "(":
        kieu = chuan_tup(kieu)
    if kieu == "str":
        return "string"
    if kieu == "f64":
        return "float64"
    if kieu == "i64":
        return "int64"
    if kieu == "bool":
        # `bool` la KIEU RIENG o tang kieu (de `str()`/`print()` in ra
        # True/False), nhung BIEU DIEN van la int32 - khong doi mot byte IL
        # nao so voi truoc, nen khong the gay hoi quy o tang sinh ma.
        return "int32"
    if kieu == "regex":
        return "class " + re_ns() + "Regex"
    if kieu == "match":
        return "class " + re_ns() + "Match"
    if kieu == "__exc":
        return "class [mscorlib]System.Exception"
    if kieu == "void":
        return "void"
    if bat_dau_bang(kieu, "list[") == 1:
        return "class [mscorlib]System.Collections.Generic.List`1<" + il_kieu(ruot(kieu)) + ">"
    if bat_dau_bang(kieu, "set[") == 1:
        return "class [System.Core]System.Collections.Generic.HashSet`1<" + il_kieu(ruot(kieu)) + ">"
    if bat_dau_bang(kieu, "dict[") == 1:
        trong = ruot(kieu)
        return "class [mscorlib]System.Collections.Generic.Dictionary`2<" + il_kieu(cat_hai(trong, 1)) + ", " + il_kieu(cat_hai(trong, 0)) + ">"
    if bat_dau_bang(kieu, "func(") == 1:
        return "class " + dang_ky_dg(kieu)
    if bat_dau_bang(kieu, "(") == 1:
        return "class " + tup_tu_chu(kieu)
    if tim_lop(kieu) >= 0:
        return "class " + kieu
    if la_handle_mo(kieu) == 1:
        return "object"
    if kieu != "i32" and kieu != "int" and kieu != "":
        em_loi("il_kieu: kieu khong biet '" + kieu + "' (truoc day ngam thanh int32)")
    return "int32"


# HANDLE TYPE MO cua trinh that (il_dispatch.__tkv_extern_class__ khai la
# System.Object): gia tri THAT la tham chieu nhieu loai - KHONG phai int32.
# Cat vao o int32 = GC lan theo con tro cut (xem hat-giong-khong-tat-dinh).
def la_handle_mo(t: "str") -> "i32":
    if t == "TkvFn" or t == "TkvTable" or t == "TkvScope" or t == "TkvCtx":
        return 1
    return 0


# Kieu phan tu khi lay chi so.
def so_truong_tup(tt: "str") -> "str":
    """'Tup3_i32_i32_i32' -> '3'."""
    i = 3
    so = ""
    while i < len(tt) and tt[i] >= "0" and tt[i] <= "9":
        so = so + tt[i]
        i = i + 1
    return so


def kieu_pt(kieu: "str") -> "str":
    # Lap tren TUPLE (2026-09-25): lop Tup khong lap duoc - truoc day roi
    # xuong 'str' im lang, sinh get_Count/get_Item khong ton tai.
    if bat_dau_bang(chuan_tup(kieu), "Tup") == 1:
        em_loi("khong lap duoc tren tuple " + kieu + " - dung list")
        return "str"
    if bat_dau_bang(kieu, "list[") == 1:
        return ruot(kieu)
    if bat_dau_bang(kieu, "set[") == 1:
        return ruot(kieu)
    if bat_dau_bang(kieu, "dict[") == 1:
        return cat_hai(ruot(kieu), 0)
    return "str"


# Kieu tu dien suy ra tu `dict(ds_cap)`. Tra "" neu khong phai
# danh sach tuple 2 phan tu. DUNG CHUNG cho duong phat ma va duong suy
# kieu - hai duong nay doc lap nhau va da nhieu lan lech nhau trong cay
# nay, nen chung phai goi cung MOT ham.
# Kieu ket qua cua `zip(a, b)`. DUNG CHUNG cho duong phat ma va duong
# suy kieu - hai duong doc lap va da nhieu lan lech nhau trong cay nay.
def kieu_zip(ta: "str", tb: "str") -> "str":
    if la_list(ta) == 0 or la_list(tb) == 0:
        return ""
    return "list[" + dang_ky_tup(kieu_pt(ta) + "|" + kieu_pt(tb)) + "]"


def kieu_dict_tu_cap(t: "str") -> "str":
    global CF_KIEU
    if la_list(t) == 0:
        return ""
    # Toi day tuple DA duoc dang ky thanh mot LOP ('Tup2_str_i32'), chu
    # khong con la chu kieu '(str,i32)' - nen phai doc kieu tu TRUONG I0/I1
    # cua lop, khong cat chuoi.
    pt = kieu_pt(t)
    i0 = tim_truong(pt, "I0")
    i1 = tim_truong(pt, "I1")
    if i0 < 0 or i1 < 0:
        return ""
    if tim_truong(pt, "I2") >= 0:
        return ""
    return "dict[" + CF_KIEU[i0] + "," + CF_KIEU[i1] + "]"


def la_list(kieu: "str") -> "i32":
    return bat_dau_bang(kieu, "list[")


def la_dict(kieu: "str") -> "i32":
    return bat_dau_bang(kieu, "dict[")


def la_set(kieu: "str") -> "i32":
    return bat_dau_bang(kieu, "set[")


# Kieu co the CHUA phan tu (list/dict/set).
# Kieu ma hat giong THUC SU biet sinh ma cho. Cac bang khai bang handle mo
# ('dict[str,TkvTable]') co kieu gia tri la mot ten khong ai dang ky - lay
# no ra dung lam kieu chi de day loi sang cho khac.
def kieu_biet(t: "str") -> "i32":
    if t == "i32" or t == "str" or t == "i64" or t == "f64" or t == "bool":
        return 1
    if la_handle_mo(t) == 1:
        return 1
    if la_list(t) == 1 or la_dict(t) == 1 or la_set(t) == 1:
        return 1
    # `func(...)`: il_kieu sinh `class <delegate>` - cung la kieu tham chieu
    # nhu lop da dang ky, nen `ldnull` lam mac dinh la hop le. Thieu dong nay
    # thi `reg.bang_funcref.get(khoa)` roi ve 'str' va loi goi sau do bao
    # "goi ham chua khai".
    if bat_dau_bang(t, "func(") == 1:
        return 1
    # Lop DA DANG KY: `il_kieu` sinh `class <Ten>` (kieu tham chieu)
    # nen `ldnull` lam mac dinh la hop le. Chi lop da dang ky - bang
    # khai bang handle mo co kieu gia tri khong ai dang ky van roi ve 0.
    if tim_lop(t) >= 0:
        return 1
    return 0


def la_chua(kieu: "str") -> "i32":
    if la_list(kieu) == 1:
        return 1
    if la_dict(kieu) == 1:
        return 1
    if la_set(kieu) == 1:
        return 1
    return 0


# Ghi kieu + vi tri token cua bieu thuc mac dinh (-1 neu khong co).
def them_tham(kieu: "str", vt_def: "i32") -> "i32":
    return them_tham2("", kieu, vt_def)


def them_tham2(ten: "str", kieu: "str", vt_def: "i32") -> "i32":
    global PAR_KIEU
    global PAR_DEF
    global PAR_TEN
    global PAR_N
    kieu = chuan_tup(kieu)
    if PAR_N == len(PAR_KIEU):
        PAR_KIEU.append(kieu)
        PAR_DEF.append(vt_def)
        PAR_TEN.append(ten)
    else:
        PAR_KIEU[PAR_N] = kieu
        PAR_DEF[PAR_N] = vt_def
        PAR_TEN[PAR_N] = ten
    PAR_N = PAR_N + 1
    return PAR_N - 1


# Quet cac doi so DANG TEN 'ten=<bt>' con lai cua mot loi goi, ghi VI TRI
# TOKEN cua tung gia tri. Con tro dung tai ')' cua loi goi.
def quet_khoa() -> "i32":
    global KW_TEN
    global KW_VT
    global KW_N
    global VT
    dem = 0
    sau = 0
    while k() != "EOF":
        if k() == "OP":
            o = v()
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                if sau == 0:
                    return dem
                sau = sau - 1
        if sau == 0 and k() == "NAME":
            if tok_kind(VT + 1) == "OP" and tok_val(VT + 1) == "=":
                if KW_N == len(KW_TEN):
                    KW_TEN.append(v())
                    KW_VT.append(VT + 2)
                else:
                    KW_TEN[KW_N] = v()
                    KW_VT[KW_N] = VT + 2
                KW_N = KW_N + 1
                dem = dem + 1
        an()
    return dem


def tim_khoa(goc: "i32", ten: "str") -> "i32":
    global KW_TEN
    global KW_VT
    global KW_N
    i = goc
    while i < KW_N:
        if KW_TEN[i] == ten:
            return KW_VT[i]
        i = i + 1
    return -1


# Doi so cua tham so thu 'pi': theo TEN neu co, khong thi gia tri mac dinh.
def phat_doi_so(pi: "i32", goc_kw: "i32") -> "str":
    global PAR_TEN
    global VT
    global MONG
    vt_gt = tim_khoa(goc_kw, PAR_TEN[pi])
    if vt_gt < 0:
        return phat_mac_dinh(pi)
    luu = VT
    VT = vt_gt
    MONG = PAR_KIEU[pi]
    t = bt()
    # Doi so TU KHOA cung phai dung kieu (2026-09-25): 'tern_temp_of_id=d'
    # (dict[i32,i32]) vao tham so khai dict[str,...] tung lot qua.
    k_kw = chuan_tup(PAR_KIEU[pi].replace(" ", ""))
    if chua_khac(t, k_kw) == 1 or doi_so_sai_kieu(t, k_kw) == 1:
        em_loi("doi so tu khoa '" + PAR_TEN[pi] + "': kieu " + t + " khac kieu tham so " + PAR_KIEU[pi])
    VT = luu
    return t


# Bo qua bieu thuc mac dinh: tien toi ',' hoac ')' o do sau 0.
def qua_mac_dinh() -> "i32":
    global VT
    sau = 0
    while k() != "EOF":
        if k() == "OP":
            o = v()
            if o == "(" or o == "[" or o == "{":
                sau = sau + 1
            if o == ")" or o == "]" or o == "}":
                if sau == 0:
                    return 1
                sau = sau - 1
            if o == "," and sau == 0:
                return 1
        an()
    return 0


# Phat lai bieu thuc mac dinh cua tham so thu 'pi' tai DIEM GOI.
def phat_mac_dinh(pi: "i32") -> "str":
    global PAR_DEF
    global VT
    global MONG
    if PAR_DEF[pi] < 0:
        em_loi("thieu doi so va tham so khong co gia tri mac dinh")
        ra("    ldnull")
        return "i32"
    luu = VT
    VT = PAR_DEF[pi]
    # MONG = kieu tham so (2026-09-25): mac dinh 'None' cua tham so tham chieu
    # tung ra ldc.i4.0 theo MONG con sot.
    MONG = PAR_KIEU[pi]
    t = bt()
    VT = luu
    return t


def tim_lop(ten: "str") -> "i32":
    global CL_TEN
    global CL_N
    i = 0
    while i < CL_N:
        if CL_TEN[i] == ten:
            return i
        i = i + 1
    return -1


def them_lop(ten: "str") -> "i32":
    global CL_TEN
    global CL_N
    if tim_lop(ten) >= 0:
        return 0
    if CL_N == len(CL_TEN):
        CL_TEN.append(ten)
    else:
        CL_TEN[CL_N] = ten
    CL_N = CL_N + 1
    return CL_N


def tim_truong(lop: "str", ten: "str") -> "i32":
    global CF_LOP
    global CF_TEN
    global CF_N
    i = 0
    while i < CF_N:
        if CF_LOP[i] == lop and CF_TEN[i] == ten:
            return i
        i = i + 1
    return -1


def them_truong(lop: "str", ten: "str", kieu: "str") -> "i32":
    global CF_LOP
    kieu = chuan_tup(kieu)
    global CF_TEN
    global CF_KIEU
    global CF_N
    if tim_truong(lop, ten) >= 0:
        return 0
    if CF_N == len(CF_LOP):
        CF_LOP.append(lop)
        CF_TEN.append(ten)
        CF_KIEU.append(kieu)
    else:
        CF_LOP[CF_N] = lop
        CF_TEN[CF_N] = ten
        CF_KIEU[CF_N] = kieu
    CF_N = CF_N + 1
    return CF_N


def tim_met(lop: "str", ten: "str") -> "i32":
    global CM_LOP
    global CM_TEN
    global CM_N
    i = 0
    while i < CM_N:
        if CM_LOP[i] == lop and CM_TEN[i] == ten:
            return i
        i = i + 1
    return -1


def them_met(lop: "str", ten: "str", ret: "str", pso: "i32", pdau: "i32") -> "i32":
    global CM_LOP
    global CM_TEN
    global CM_RET
    global CM_PSO
    global CM_PDAU
    global CM_N
    if CM_N == len(CM_LOP):
        CM_LOP.append(lop)
        CM_TEN.append(ten)
        CM_RET.append(ret)
        CM_PSO.append(pso)
        CM_PDAU.append(pdau)
    else:
        CM_LOP[CM_N] = lop
        CM_TEN[CM_N] = ten
        CM_RET[CM_N] = ret
        CM_PSO[CM_N] = pso
        CM_PDAU[CM_N] = pdau
    CM_N = CM_N + 1
    return CM_N


# TUPLE = MOT LOP TU SINH. Khong co co che rieng: dang ky vao dung bang
# CL_/CF_ nen ldfld, il_kieu, suy kieu... dung lai nguyen ven may 'class'.
# 'func(A,B)->R' -> phan doi so "A,B" (rong neu khong co).
def func_doi(t: "str") -> "str":
    i = 5
    sau = 1
    r = ""
    while i < len(t):
        c = t[i]
        if c == "(" or c == "[":
            sau = sau + 1
        if c == ")" or c == "]":
            sau = sau - 1
            if sau == 0:
                return r
        r = r + c
        i = i + 1
    return r


# 'func(A,B)->R' -> "R"; khong co '->' thi la void.
def func_ra(t: "str") -> "str":
    i = len(t) - 2
    while i > 0:
        if t[i] == "-" and t[i + 1] == ">":
            return t[i + 2:len(t)].strip()
        i = i - 1
    return "void"


# Kieu ham CHUAN HOA (2026-09-25): tung tham so va kieu tra ve qua chuan_tup
# (bi danh TkvSig -> Signature, tuple long -> lop). Hai cach viet cung mot kieu
# ham phai ra CUNG mot lop delegate - neu khong, List<A>.Add(b) nem
# ArrayTypeMismatchException luc chay.
def chuan_func(t: "str") -> "str":
    d = func_doi(t)
    r = ""
    mot = ""
    dem = 0
    sau = 0
    i = 0
    while i < len(d):
        c = d[i]
        if c == "(" or c == "[":
            sau = sau + 1
        if c == ")" or c == "]":
            sau = sau - 1
        if c == "," and sau == 0:
            if dem > 0:
                r = r + ","
            r = r + chuan_tup(mot.strip())
            dem = dem + 1
            mot = ""
        else:
            mot = mot + c
        i = i + 1
    if len(mot.strip()) > 0:
        if dem > 0:
            r = r + ","
        r = r + chuan_tup(mot.strip())
    return "func(" + r + ")->" + chuan_tup(func_ra(t))


# Danh sach kieu THAM SO cua 'func(A,B)->R', noi bang '|' (rong neu khong co).
def func_vao(t: "str") -> "str":
    i = 0
    while i < len(t):
        if t[i] == "(":
            sau = 0
            j = i + 1
            r = ""
            dau = j
            while j < len(t):
                c = t[j]
                if c == "(" or c == "[":
                    sau = sau + 1
                if c == "]":
                    sau = sau - 1
                if c == ")":
                    if sau == 0:
                        if j > dau:
                            if r != "":
                                r = r + "|"
                            r = r + t[dau:j].strip()
                        return r
                    sau = sau - 1
                if c == "," and sau == 0:
                    if r != "":
                        r = r + "|"
                    r = r + t[dau:j].strip()
                    dau = j + 1
                j = j + 1
            return r
        i = i + 1
    return ""


# `ten` co nam trong danh sach noi bang '|' khong.
# So phan tu trong mot chuoi ngan cach bang '|' (rong = 0).
def dem_phan(ds: "str") -> "i32":
    if ds == "":
        return 0
    return len(ds.split("|"))


def co_trong_ds(ds: "str", ten: "str") -> "i32":
    if ds == "":
        return 0
    p = ds.split("|")
    i = 0
    while i < len(p):
        if p[i] == ten:
            return 1
        i = i + 1
    return 0


# Tien quet BIEN AN trong than lambda. Than la MOT bieu thuc (khong co
# phep gan), nen chi can cac bien an cua rut gon.
def quet_bien_cuc_bo_lam(tu: "i32", ket: "i32") -> "i32":
    i = tu
    while i < ket:
        if tok_kind(i) == "OP":
            if tok_val(i) == "[" or tok_val(i) == "(" or tok_val(i) == "{":
                if tim_for_trong(i, qua_ngoac(i)) > 0:
                    khai_rut_gon(i)
        i = i + 1
    return 0


def dang_ky_dg(t: "str") -> "str":
    global DG_DS
    global DG_N
    # BO KHOANG TRANG (2026-09-25): 'func(str, str, dict[str,str])' va
    # 'func(str,str,dict[str,str])' la MOT kieu - truoc day ra HAI lop delegate,
    # List<A>.Add(b) nem ArrayTypeMismatchException LUC CHAY.
    t = chuan_tup(t.replace(" ", ""))
    ten = "Dg_" + ten_an_toan(t.replace("(", "_").replace(")", "_").replace("-", "").replace(">", "t").replace("*", ""))
    i = 0
    while i < DG_N:
        if DG_DS[i] == t:
            return ten
        i = i + 1
    if DG_N == len(DG_DS):
        DG_DS.append(t)
    else:
        DG_DS[DG_N] = t
    DG_N = DG_N + 1
    return ten


# Chu ky IL cua cac doi so: "string, int32".
# Kieu tham so THU i cua kieu ham t (cung cach tach voi dg_ky); "" neu thieu.
def func_tham(t: "str", thu: "i32") -> "str":
    d = func_doi(t)
    mot = ""
    dem = 0
    sau = 0
    i = 0
    while i < len(d):
        c = d[i]
        if c == "(" or c == "[":
            sau = sau + 1
        if c == ")" or c == "]":
            sau = sau - 1
        if c == "," and sau == 0:
            if dem == thu:
                return mot.strip()
            dem = dem + 1
            mot = ""
        else:
            mot = mot + c
        i = i + 1
    if dem == thu:
        return mot.strip()
    return ""


def dg_ky(t: "str") -> "str":
    d = func_doi(t)
    r = ""
    mot = ""
    dem = 0
    sau = 0
    i = 0
    while i < len(d):
        c = d[i]
        if c == "(" or c == "[":
            sau = sau + 1
        if c == ")" or c == "]":
            sau = sau - 1
        if c == "," and sau == 0:
            if dem > 0:
                r = r + ", "
            r = r + il_kieu(mot.strip())
            dem = dem + 1
            mot = ""
        else:
            mot = mot + c
        i = i + 1
    if len(mot.strip()) > 0:
        if dem > 0:
            r = r + ", "
        r = r + il_kieu(mot.strip())
    return r


# Goi tien trinh ngoai. Chep khuon process_feature.py cua trinh bien dich
# that. CANH BAO da ghi o do: args truyen NGUYEN VAN cho ProcessStartInfo,
# Windows tach theo DAU CACH - duong dan co dau cach phai TU boc dau nhay.
def phat_lop_proc() -> "i32":
    psi = "class [System]System.Diagnostics.ProcessStartInfo"
    prc = "class [System]System.Diagnostics.Process"
    ra(".class public abstract sealed auto ansi TkvProc extends [mscorlib]System.Object")
    ra("{")
    ra("  .method public static int32 Chay(string exe, string args) cil managed")
    ra("  {")
    ra("    .maxstack 64")
    ra("    .locals init (" + psi + " psi, " + prc + " p)")
    ra("    ldarg.0")
    ra("    ldarg.1")
    ra("    newobj instance void [System]System.Diagnostics.ProcessStartInfo::.ctor(string, string)")
    ra("    stloc.0")
    ra("    ldloc.0")
    ra("    ldc.i4.0")
    ra("    callvirt instance void [System]System.Diagnostics.ProcessStartInfo::set_UseShellExecute(bool)")
    ra("    ldloc.0")
    ra("    call " + prc + " [System]System.Diagnostics.Process::Start(" + psi + ")")
    ra("    stloc.1")
    ra("    ldloc.1")
    ra("    callvirt instance void [System]System.Diagnostics.Process::WaitForExit()")
    ra("    ldloc.1")
    ra("    callvirt instance int32 [System]System.Diagnostics.Process::get_ExitCode()")
    ra("    ret")
    ra("  }")
    ra("  .method public static int32 ChayRa(string exe, string args, string ra_f) cil managed")
    ra("  {")
    ra("    .maxstack 64")
    ra("    .locals init (" + psi + " psi, " + prc + " p, string s)")
    ra("    ldarg.0")
    ra("    ldarg.1")
    ra("    newobj instance void [System]System.Diagnostics.ProcessStartInfo::.ctor(string, string)")
    ra("    stloc.0")
    ra("    ldloc.0")
    ra("    ldc.i4.0")
    ra("    callvirt instance void [System]System.Diagnostics.ProcessStartInfo::set_UseShellExecute(bool)")
    ra("    ldloc.0")
    ra("    ldc.i4.1")
    ra("    callvirt instance void [System]System.Diagnostics.ProcessStartInfo::set_RedirectStandardOutput(bool)")
    ra("    ldloc.0")
    ra("    call " + prc + " [System]System.Diagnostics.Process::Start(" + psi + ")")
    ra("    stloc.1")
    ra("    ldloc.1")
    ra("    callvirt instance class [mscorlib]System.IO.StreamReader " + prc + "::get_StandardOutput()")
    ra("    callvirt instance string [mscorlib]System.IO.TextReader::ReadToEnd()")
    ra("    stloc.2")
    ra("    ldloc.1")
    ra("    callvirt instance void [System]System.Diagnostics.Process::WaitForExit()")
    ra("    ldarg.2")
    ra("    ldloc.2")
    ra("    call void [mscorlib]System.IO.File::WriteAllText(string, string)")
    ra("    ldloc.1")
    ra("    callvirt instance int32 " + prc + "::get_ExitCode()")
    ra("    ret")
    ra("  }")
    ra("}")
    ra("")
    return 1


# '.get()' truoc day di qua MOT helper co dinh Dictionary<string,string>,
# nen chi dung duoc cho dict[?,str]. Nay sinh mot helper cho TUNG kieu tu
# dien that su duoc dung - ke ca tu dien long nhau (gia tri la dict khac).
