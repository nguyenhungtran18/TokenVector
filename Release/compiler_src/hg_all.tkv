    ra("    ret")
    ra("  IA0:")
    ra("    ldc.i4.0")
    ra("    stloc.0")
    ra("  IA1:")
    ra("    ldloc.0")
    ra("    ldarg.0")
    ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
    ra("    bge IA3")
