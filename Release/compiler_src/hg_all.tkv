def phat_ho_tro_chia_san() -> "i32":
    """`//` va `%` theo dung luat PYTHON, khong phai luat .NET.

    .NET cat ve 0: -7/2 = -3, -7%3 = -1.
    Python lam tron XUONG: -7//2 = -4, -7%3 = 2 (dau theo SO CHIA).
    Khac nhau chi khi dau hai toan hang khac nhau, nen sai nay nam im rat
    lau trong ma chi dung chi so khong am."""
    ra("  .method public static int32 __fdiv(int32 a, int32 b) cil managed")
    ra("  {")
    ra("    .maxstack 64")
    ra("    .locals init (int32 q, int32 r)")
    ra("    ldarg.0")
    ra("    ldarg.1")
    ra("    div")
    ra("    stloc.0")
    ra("    ldarg.0")
    ra("    ldarg.1")
    ra("    rem")
    ra("    stloc.1")
    ra("    ldloc.1")
    ra("    brfalse FDV0")
    ra("    ldarg.0")
    ra("    ldarg.1")
    ra("    xor")
    ra("    ldc.i4.0")
    ra("    bge FDV0")
    ra("    ldloc.0")
    ra("    ldc.i4.1")
    ra("    sub")
    ra("    ret")
    ra("  FDV0:")
    ra("    ldloc.0")
    ra("    ret")
    ra("  }")
    ra("")
    ra("  .method public static int32 __fmod(int32 a, int32 b) cil managed")
    ra("  {")
    ra("    .maxstack 64")
    ra("    .locals init (int32 r)")
    ra("    ldarg.0")
    ra("    ldarg.1")
    ra("    rem")
    ra("    stloc.0")
    ra("    ldloc.0")
    ra("    brfalse FMD0")
    ra("    ldloc.0")
    ra("    ldarg.1")
    ra("    xor")
    ra("    ldc.i4.0")
    ra("    bge FMD0")
    ra("    ldloc.0")
    ra("    ldarg.1")
    ra("    add")
    ra("    ret")
    ra("  FMD0:")
    ra("    ldloc.0")
    ra("    ret")
    ra("  }")
    ra("")
    return 1


