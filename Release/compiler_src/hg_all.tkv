def phat_cac_lpop() -> "i32":
    """`__lpopN(List<T> l, int32 i) -> T`: tra phan tu thu i roi xoa no.

    Chi so AM dem tu cuoi (nhu Python), va `.pop()` khong doi so goi voi
    i = -1."""
    global LPOP_DS
    global LPOP_N
    i = 0
    while i < LPOP_N:
        t = LPOP_DS[i]
        pt = ruot(t)
        d = il_kieu(t)
        ra("  .method public static " + il_kieu(pt) + " __lpop" + str(i) + "(" + d + " l, int32 k) cil managed")
        ra("  {")
        ra("    .maxstack 64")
        ra("    .locals init (int32 j)")
        ra("    ldarg.1")
        ra("    ldc.i4.0")
        ra("    bge LPOS" + str(i))
        ra("    ldarg.0")
        ra("    callvirt instance int32 " + d + "::get_Count()")
        ra("    ldarg.1")
        ra("    add")
        ra("    stloc.0")
        ra("    br LPGO" + str(i))
        ra("  LPOS" + str(i) + ":")
        ra("    ldarg.1")
        ra("    stloc.0")
        ra("  LPGO" + str(i) + ":")
        ra("    ldarg.0")
        ra("    ldloc.0")
        ra("    callvirt instance !0 " + d + "::get_Item(int32)")
        ra("    ldarg.0")
        ra("    ldloc.0")
        ra("    callvirt instance void " + d + "::RemoveAt(int32)")
        ra("    ret")
        ra("  }")
        ra("")
        i = i + 1
    return 1


def phat_cac_dget() -> "i32":
    global DGET_DS
    global DGET_N
    i = 0
    while i < DGET_N:
        t = DGET_DS[i]
        kk = cat_hai(ruot(t), 1)
        kv = cat_hai(ruot(t), 0)
        d = il_kieu(t)
        ra("  .method public static " + il_kieu(kv) + " __dget" + str(i) + "(" + d + " d, " + il_kieu(kk) + " k, " + il_kieu(kv) + " md) cil managed")
        ra("  {")
        ra("    .maxstack 64")
        # Khoa None (2026-09-25): Python 'd.get(None)' tra mac dinh, .NET
        # ContainsKey(null) nem ArgumentNullException.
        if la_so_hoc(kk) == 0:
            ra("    ldarg.1")
            ra("    brfalse DGX" + str(i))
        ra("    ldarg.0")
        ra("    ldarg.1")
        ra("    callvirt instance bool " + d + "::ContainsKey(!0)")
        ra("    brfalse DGX" + str(i))
        ra("    ldarg.0")
        ra("    ldarg.1")
        ra("    callvirt instance !1 " + d + "::get_Item(!0)")
        ra("    ret")
        ra("  DGX" + str(i) + ":")
        ra("    ldarg.2")
        ra("    ret")
        ra("  }")
        ra("")
        i = i + 1
    return DGET_N


def phat_cac_dpop() -> "i32":
    """__dpop<i>(d, k, md): co khoa thi LAY gia tri, XOA khoa, tra gia tri;
    khong co thi tra md - dung nghia dict.pop(k, md) cua Python."""
    i = 0
    while i < DPOP_N:
        t = DPOP_DS[i]
        kk = cat_hai(ruot(t), 1)
        kv = cat_hai(ruot(t), 0)
        d = il_kieu(t)
        ra("  .method public static " + il_kieu(kv) + " __dpop" + str(i) + "(" + d + " d, " + il_kieu(kk) + " k, " + il_kieu(kv) + " md) cil managed")
        ra("  {")
        ra("    .maxstack 64")
        ra("    .locals init (" + il_kieu(kv) + " v)")
        ra("    ldarg.0")
        ra("    ldarg.1")
        ra("    callvirt instance bool " + d + "::ContainsKey(!0)")
        ra("    brfalse DPOPX" + str(i))
        ra("    ldarg.0")
        ra("    ldarg.1")
        ra("    callvirt instance !1 " + d + "::get_Item(!0)")
        ra("    stloc.0")
        ra("    ldarg.0")
        ra("    ldarg.1")
        ra("    callvirt instance bool " + d + "::Remove(!0)")
        ra("    pop")
        ra("    ldloc.0")
        ra("    ret")
        ra("  DPOPX" + str(i) + ":")
        ra("    ldarg.2")
        ra("    ret")
        ra("  }")
        ra("")
        i = i + 1
    return DPOP_N


def phat_cac_dsd() -> "i32":
    """d.setdefault(k, md): co k thi tra d[k] va KHONG ghi; khong co thi
    ghi d[k] = md roi tra md. Cung ngu nghia voi il_features/
    dict_setdefault.py cua trinh bien dich that (da doi chieu truoc khi
    viet, khong suy doan)."""
    global DSD_DS
    global DSD_N
    i = 0
    while i < DSD_N:
        t = DSD_DS[i]
        kk = cat_hai(ruot(t), 1)
        kv = cat_hai(ruot(t), 0)
        d = il_kieu(t)
        ra("  .method public static " + il_kieu(kv) + " __dsd" + str(i) + "(" + d + " d, " + il_kieu(kk) + " k, " + il_kieu(kv) + " md) cil managed")
        ra("  {")
        ra("    .maxstack 64")
        ra("    ldarg.0")
        ra("    ldarg.1")
        ra("    callvirt instance bool " + d + "::ContainsKey(!0)")
        ra("    brfalse DSDX" + str(i))
        ra("    ldarg.0")
        ra("    ldarg.1")
        ra("    callvirt instance !1 " + d + "::get_Item(!0)")
        ra("    ret")
        ra("  DSDX" + str(i) + ":")
        ra("    ldarg.0")
        ra("    ldarg.1")
        ra("    ldarg.2")
        ra("    callvirt instance void " + d + "::set_Item(!0, !1)")
        ra("    ldarg.2")
        ra("    ret")
        ra("  }")
        ra("")
        i = i + 1
    return DSD_N


def phat_cac_dg() -> "i32":
    global DG_DS
    global DG_N
    i = 0
    while i < DG_N:
        t = DG_DS[i]
        ten = dang_ky_dg(t)
        ra(".class public auto ansi sealed " + ten + " extends [mscorlib]System.MulticastDelegate")
        ra("{")
        ra("  .method public specialname rtspecialname instance void .ctor(object A, native int B) runtime managed {}")
        ra("  .method public virtual instance " + il_kieu(func_ra(t)) + " Invoke(" + dg_ky(t) + ") runtime managed {}")
        ra("}")
        ra("")
        i = i + 1
    return DG_N


def ten_an_toan(kieu: "str") -> "str":
    r = ""
    i = 0
    while i < len(kieu):
        c = kieu[i]
        # Bo sot NGOAC TRON truoc 2026-09-23: mot tuple LONG trong tuple
        # (vd '(str,(str,str,i32),i32)') sinh ten lop 'Tup3_str_(str_str_i32)_i32'
        # - ilasm bao "syntax error at token 'str_str_i32'". Chi lo ra khi hat
        # giong THAT SU ghi IL ra (che do --du), vi truoc do mot loi bat ky lam
        # no khong ghi dong nao.
        if c == "[" or c == "]" or c == "," or c == " " or c == "(" or c == ")":
            r = r + "_"
        else:
            r = r + c
        i = i + 1
    return r


# 'mo_ta' la cac kieu phan tu noi bang '|'.
def ten_tup(mo_ta: "str") -> "str":
    phan = mo_ta.split("|")
    r = "Tup" + str(len(phan))
    i = 0
    while i < len(phan):
        r = r + "_" + ten_an_toan(phan[i])
        i = i + 1
    return r


def dang_ky_tup(mo_ta: "str") -> "str":
    global TUP_DS
    global TUP_N
    # 'bool' -> 'i32' trong MOI duong dang ky tuple (xem phan_tup_chuan).
    phan_bool = mo_ta.split("|")
    mo_ta = ""
    ib = 0
    while ib < len(phan_bool):
        if ib > 0:
            mo_ta = mo_ta + "|"
        if phan_bool[ib] == "bool":
            mo_ta = mo_ta + "i32"
        else:
            mo_ta = mo_ta + phan_bool[ib]
        ib = ib + 1
    lop = ten_tup(mo_ta)
    if tim_lop(lop) >= 0:
        return lop
    them_lop(lop)
    phan = mo_ta.split("|")
    i = 0
    while i < len(phan):
        them_truong(lop, "I" + str(i), phan[i])
        i = i + 1
    if TUP_N == len(TUP_DS):
        TUP_DS.append(lop)
    else:
        TUP_DS[TUP_N] = lop
    TUP_N = TUP_N + 1
    return lop


# Kieu khai bang '(a,b,c)' LA mot tuple: dang ky thanh lop ngay tai cho ghi
# nhan kieu tra ve, de thao tuple / ldfld / il_kieu dung lai may moc lop.
# Mot PHAN TU cua kieu tuple, chuan hoa (2026-09-25): 'bool' -> 'i32'. Trinh
# that khong nhan bool trong tuple, va bieu dien bool LA int32 - nhung ten lop
# tuple khac nhau ('Tup2_str_bool' vs 'Tup2_str_i32') lam 'ds += [(x, True)]'
# goi AddRange voi IEnumerable sai kieu: EntryPointNotFoundException luc chay.
def phan_tup_chuan(p: "str") -> "str":
    q = chuan_tup(p)
    if q == "bool":
        return "i32"
    return q


def chuan_tup(t: "str") -> "str":
    # HANDLE TYPE cua trinh bien dich that: khai la System.Object doi voi
    # chinh no, nhung hat giong BIET gia tri that la gi nen doc duoc truong.
    # Chi anh xa nhung cai CHAC CHAN mot kieu; TkvScope/TkvCtx/TkvTable/TkvFn
    # la nhieu kieu khac nhau nen de nguyen mo.
    if t == "TkvSig":
        return "Signature"
    if t == "TkvTypeAnn":
        return "TypeAnn"
    if t == "TkvNode":
        return "i32"
    if len(t) < 3:
        return t
    if bat_dau_bang(t, "func(") == 1:
        return chuan_func(t)
    if bat_dau_bang(t, "list[") == 1:
        return "list[" + chuan_tup(ruot(t)) + "]"
    if bat_dau_bang(t, "set[") == 1:
        return "set[" + chuan_tup(ruot(t)) + "]"
    # frozenset BIEU DIEN bang HashSet nhu set (2026-09-25) - truoc day
    # 'frozenset[str]' roi xuong nhanh cuoi cua il_kieu thanh int32 AM THAM.
    if bat_dau_bang(t, "frozenset[") == 1:
        return "set[" + chuan_tup(ruot(t)) + "]"
    if bat_dau_bang(t, "dict[") == 1:
        trong = ruot(t)
        return "dict[" + chuan_tup(cat_hai(trong, 1)) + "," + chuan_tup(cat_hai(trong, 0)) + "]"
    if t[0] != "(":
        return t
    if t[len(t) - 1] != ")":
        return t
    mo_ta = ""
    phan = ""
    dem = 0
    sau = 0
    i = 1
    while i < len(t) - 1:
        c = t[i]
        if c == "(" or c == "[":
            sau = sau + 1
        if c == ")" or c == "]":
            sau = sau - 1
        if c == "," and sau == 0:
            if dem > 0:
                mo_ta = mo_ta + "|"
            mo_ta = mo_ta + phan_tup_chuan(phan.strip())
            dem = dem + 1
            phan = ""
        else:
            phan = phan + c
        i = i + 1
    if dem > 0:
        mo_ta = mo_ta + "|"
    mo_ta = mo_ta + phan_tup_chuan(phan.strip())
    dem = dem + 1
    if dem < 2:
        return t
    return dang_ky_tup(mo_ta)


# Phat cac lop tuple o CUOI file - IL khong quan tam thu tu khai bao, nen
# khong can biet truoc moi hinh dang.
def phat_cac_lam() -> "i32":
    global LAM_LG
    """Mot `.class` cho moi lambda: truong = bien bat duoc, `__goi` = than.

    Bien bat duoc duoc CHEP tu truong ra BIEN CUC BO ngay dau `__goi`. Nho
    vay than lambda dung `nap_ten` y het moi cho khac, khong phai them mot
    che do "doc truong qua this". Chep duoc vi lambda o cay nay khong ghi
    lai bien bat duoc.
    """
    global LAM_N
    global LOC_N
    global SO_THAM
    global RET_HIEN
    global VT
    global LG_HIEN
    global MONG
    i = 0
    while i < LAM_N:
        lop = "Lam" + str(i)
        bat = LAM_BAT[i]
        kbat = LAM_KBAT[i]
        tham = LAM_THAM[i]
        ktham = LAM_KTHAM[i]
        ret_l = LAM_RET[i]
        pb = []
        pk = []
        if bat != "":
            pb = bat.split("|")
            pk = kbat.split("|")
        pt = []
        ptk = []
        if tham != "":
            pt = tham.split("|")
            ptk = ktham.split("|")
        ra(".class public auto ansi beforefieldinit " + lop + " extends [mscorlib]System.Object")
        ra("{")
        j = 0
        while j < len(pb):
            ra("  .field public " + il_kieu(pk[j]) + " c" + str(j))
            j = j + 1
        kyc = ""
        j = 0
        while j < len(pb):
            if j > 0:
                kyc = kyc + ", "
            kyc = kyc + il_kieu(pk[j]) + " p" + str(j)
            j = j + 1
        ra("  .method public specialname rtspecialname instance void .ctor(" + kyc + ") cil managed")
        ra("  {")
        ra("    .maxstack 64")
        ra("    ldarg.0")
        ra("    call instance void [mscorlib]System.Object::.ctor()")
        j = 0
        while j < len(pb):
            ra("    ldarg.0")
            ra("    ldarg.s " + str(j + 1))
            ra("    stfld " + il_kieu(pk[j]) + " " + lop + "::c" + str(j))
            j = j + 1
        ra("    ret")
        ra("  }")
        ra("")
        kyt = ""
        j = 0
        while j < len(pt):
            if j > 0:
                kyt = kyt + ", "
            kyt = kyt + il_kieu(ptk[j]) + " " + ten_il(pt[j])
            j = j + 1
        ra("  .method public instance " + il_kieu(ret_l) + " __goi(" + kyt + ") cil managed")
        ra("  {")
        ra("    .maxstack 64")
        LOC_N = 0
        LG_HIEN = LAM_LG[i]
        RET_HIEN = ret_l
        MONG = ret_l
        them_loc("__self_lam", lop)
        j = 0
        while j < len(pt):
            them_loc(pt[j], ptk[j])
            j = j + 1
        SO_THAM = LOC_N
        j = 0
        while j < len(pb):
            them_loc(pb[j], pk[j])
            j = j + 1
        quet_bien_cuc_bo_lam(LAM_TH[i], LAM_KET[i])
        phat_locals()
        j = 0
        while j < len(pb):
            ra("    ldarg.0")
            ra("    ldfld " + il_kieu(pk[j]) + " " + lop + "::c" + str(j))
            luu_ten(pb[j])
            j = j + 1
        VT = LAM_TH[i]
        t_than = bt()
        if ret_l == "void" and t_than != "void":
            ra("    pop")
        ra("    ret")
        ra("  }")
        ra("}")
        ra("")
        i = i + 1
    # Khong de rò pham vi ham long cua lambda cuoi sang phan phat sau.
    LG_HIEN = 0 - 1
    return LAM_N


def phat_cac_tup() -> "i32":
    global TUP_DS
    global TUP_N
    global CF_LOP
    global CF_TEN
    global CF_KIEU
    global CF_N
    i = 0
    while i < TUP_N:
        lop = TUP_DS[i]
        ra(".class public auto ansi beforefieldinit " + lop + " extends [mscorlib]System.Object")
        ra("{")
        ky = ""
        dem = 0
        j = 0
        while j < CF_N:
            if CF_LOP[j] == lop:
                ra("  .field public " + il_kieu(CF_KIEU[j]) + " " + ten_il(CF_TEN[j]))
                if dem > 0:
                    ky = ky + ", "
                ky = ky + il_kieu(CF_KIEU[j]) + " p" + str(dem)
                dem = dem + 1
            j = j + 1
        ra("  .method public specialname rtspecialname instance void .ctor(" + ky + ") cil managed")
        ra("  {")
        ra("    .maxstack 64")
        ra("    ldarg.0")
        ra("    call instance void [mscorlib]System.Object::.ctor()")
        j = 0
        dem = 0
        while j < CF_N:
            if CF_LOP[j] == lop:
                ra("    ldarg.0")
                ra("    ldarg.s " + str(dem + 1))
                ra("    stfld " + il_kieu(CF_KIEU[j]) + " " + lop + "::" + ten_il(CF_TEN[j]))
                dem = dem + 1
            j = j + 1
        ra("    ret")
        ra("  }")
        ra("}")
        ra("")
        i = i + 1
    return TUP_N


def tim_gv(ten: "str") -> "i32":
    global GV_TEN
    global GV_N
    i = 0
    while i < GV_N:
        if GV_TEN[i] == ten:
            return i
        i = i + 1
    return -1


def them_gv(ten: "str", kieu: "str", vt_gt: "i32") -> "i32":
    global GV_TEN
    global GV_KIEU
    global GV_VT
    global GV_N
    kieu = chuan_tup(kieu)
    if tim_gv(ten) >= 0:
        return 0
    if GV_N == len(GV_TEN):
        GV_TEN.append(ten)
        GV_KIEU.append(kieu)
        GV_VT.append(vt_gt)
    else:
        GV_TEN[GV_N] = ten
        GV_KIEU[GV_N] = kieu
        GV_VT[GV_N] = vt_gt
    GV_N = GV_N + 1
    return GV_N


# Nap gia tri mot ten: tham so dung ldarg, bien cuc bo dung ldloc.
def nap_ten(ten: "str") -> "str":
    global LOP_HIEN
    global VT
    global LOC_KIEU
    global SO_THAM
    global GV_KIEU
    # `__file__`: duoi CPython la duong dan FILE NGUON dang chay; o ban
    # bien dich, cai tuong duong la duong dan cua chinh .exe - dung cho
    # muc dich that su duy nhat cua no trong cay nay (dinh vi thu muc
    # 'compiler/' nam CANH chuong trinh). Khong phai bien nen chan TRUOC
    # tim_loc/tim_gv de khong ai dat de len duoc.
    if ten == "__file__":
        ra("    call class [mscorlib]System.Reflection.Assembly [mscorlib]System.Reflection.Assembly::GetEntryAssembly()")
        ra("    callvirt instance string [mscorlib]System.Reflection.Assembly::get_Location()")
        return "str"
    j = tim_loc(ten)
    if j < 0:
        gi = tim_gv(ten)
        if gi < 0:
            # BI DANH nhap khau cho mot BIEN cap module
            # (`from M import X as _X`). Phai doi HAN `ten` chu khong chi
            # tra ra chi so: dong `ldsfld` duoi day dung chinh `ten` de
            # dat ten truong, lay ten bi danh thi tro toi mot truong
            # khong ton tai.
            _tb_g = go_bi_danh(ten)
            if _tb_g != ten:
                gi = tim_gv(_tb_g)
                if gi >= 0:
                    ten = _tb_g
        if gi < 0:
            # Co the la TEN MODULE: phep gop lam phang moi module vao MOT
            # namespace, nen 'mod.x' chinh la 'x'. Bao hieu cho cho goi
            # bang kieu dac biet, khong phat gi ca.
            if tok_kind(VT) == "OP" and tok_val(VT) == ".":
                return "module"
            em_loi("ten chua biet: " + ten)
            return "i32"
        ra("    ldsfld " + il_kieu(GV_KIEU[gi]) + " Tkv::" + ten_il(ten))
        return GV_KIEU[gi]
    if j < SO_THAM:
        ra("    ldarg.s " + str(j))
    else:
        ra("    ldloc.s " + str(j - SO_THAM))
    return LOC_KIEU[j]


# Doi so RO RANG sai kieu tham so (2026-09-25): chuoi vao tham so so, so vao
# tham so chuoi/container/lop. 'TypeAnn(dtype, "list")' voi tham so 'shape'
# khong khai kieu (i32) tung cat CHUOI vao o int32 - mat thong tin, khong loi.
def la_so_hoc(t: "str") -> "i32":
    if t == "i32" or t == "bool" or t == "i64" or t == "f64" or t == "f32":
        return 1
    return 0


def doi_so_sai_kieu(t_ds: "str", k_ts: "str") -> "i32":
    if t_ds == "" or k_ts == "" or t_ds == "null":
        return 0
    if t_ds == "str" and la_so_hoc(k_ts) == 1:
        return 1
    if la_so_hoc(t_ds) == 1 and (k_ts == "str" or la_chua(k_ts) == 1 or tim_lop(chuan_tup(k_ts)) >= 0):
        return 1
    if (la_chua(t_ds) == 1 or tim_lop(chuan_tup(t_ds)) >= 0) and la_so_hoc(k_ts) == 1:
        return 1
    # LOP vs LOP / chuoi (2026-09-25): 'WalkCtx' vao tham so 'Ctx' doc truong
    # SAI LOP (AccessViolation); tuple vao tham so chuoi. Lop nguoi dung khong
    # ke thua nhau trong IL hat giong (tru ngoai le).
    lt = chuan_tup(t_ds)
    lk = chuan_tup(k_ts)
    if tim_lop(lt) >= 0 and (lk == "str" or la_chua(lk) == 1):
        return 1
    if (t_ds == "str" or la_chua(t_ds) == 1) and tim_lop(lk) >= 0:
        return 1
    if tim_lop(lt) >= 0 and tim_lop(lk) >= 0 and lt != lk:
        if la_ngoai_le(lt) == 1 and la_ngoai_le(lk) == 1:
            return 0
        return 1
    return 0


# Nguon cua sorted()/reversed()/list(): danh sach, tap, hoac tu dien (duyet
# KHOA nhu Python - day .Keys len ngan xep). Tra kieu danh sach ket qua
# (2026-09-25): 'sorted(bang)' tung dua thang Dictionary vao List(IEnumerable
# <string>) - EntryPointNotFoundException luc chay.
def kieu_ds_tu_nguon(t: "str", ten: "str") -> "str":
    if la_dict(t) == 1:
        ra("    callvirt instance class [mscorlib]System.Collections.Generic.Dictionary`2/KeyCollection<!0, !1> " + il_kieu(t) + "::get_Keys()")
        return "list[" + cat_hai(ruot(t), 1) + "]"
    if la_list(t) == 1 or la_set(t) == 1:
        return "list[" + kieu_pt(t) + "]"
    em_loi(ten + "(x) chi nhan danh sach/tap/tu dien, gap " + t)
    return "list[str]"


# Gia tri SAI kieu truong (2026-09-25): 'wc.tern_temp_of_id = d' voi d la
# dict[str,str] vao truong dict[i32,i32] - dich sach, Dictionary.Insert nem
# EntryPointNotFoundException luc chay.
def kiem_gan_truong(t: "str", k: "str", lop: "str", truong: "str") -> "i32":
    kk = chuan_tup(k.replace(" ", ""))
    if chua_khac(t, kk) == 1 or doi_so_sai_kieu(t, kk) == 1:
        em_loi("gan kieu " + t + " vao truong " + lop + "." + truong + " kieu " + k)
        return 1
    return 0


# Hai kieu CONTAINER khac nhau THAT (so bang kieu IL: list[bool] va list[i32]
# cung la List<int32>).
def chua_khac(t: "str", k: "str") -> "i32":
    if la_chua(t) == 0 or la_chua(k) == 0:
        return 0
    if il_kieu(chuan_tup(t.replace(" ", ""))) != il_kieu(chuan_tup(k.replace(" ", ""))):
        return 1
    return 0


def bt_tao(lop: "str") -> "str":
    global MONG
    global KW_N
    global VT
    global CM_PSO
    global PAR_KIEU
    global CM_PDAU
    mi = tim_met(lop, "__init__")
    dem = 0
    ky = ""
    if la_op(")") == 0:
        con = 1
        while con == 1:
            if k() == "NAME" and tok_kind(VT + 1) == "OP" and tok_val(VT + 1) == "=":
                con = 0
                continue
            # MONG theo kieu THAM SO ctor (2026-09-25): 'ChuongTrinh(..., [], ...)'
            # truoc day dung `[]` voi MONG con sot -> newobj ChuongTrinh::.ctor().
            if mi >= 0:
                MONG = PAR_KIEU[CM_PDAU[mi] + dem]
            t_ds = bt()
            if mi >= 0 and dem < CM_PSO[mi]:
                if doi_so_sai_kieu(t_ds, PAR_KIEU[CM_PDAU[mi] + dem]) == 1:
                    em_loi("doi so " + str(dem + 1) + " cua " + lop + "(): kieu " + t_ds + " khac kieu tham so " + PAR_KIEU[CM_PDAU[mi] + dem])
            if mi >= 0:
                if dem > 0:
                    ky = ky + ", "
                ky = ky + il_kieu(PAR_KIEU[CM_PDAU[mi] + dem])
            dem = dem + 1
            if khop_op(",") == 0:
                con = 0
    goc_kw = KW_N
    quet_khoa()
    can_op(")")
    if mi >= 0:
        while dem < CM_PSO[mi]:
            phat_doi_so(CM_PDAU[mi] + dem, goc_kw)
            if dem > 0:
                ky = ky + ", "
            ky = ky + il_kieu(PAR_KIEU[CM_PDAU[mi] + dem])
            dem = dem + 1
    else:
        # Khong co `__init__`: dung .ctor TU SINH (xem phat_ctor_mac_dinh).
        so_can = so_truong_ctor(lop)
        if dem != so_can:
            em_loi("lop " + lop + " can " + str(so_can) + " doi so khoi tao, nhan " + str(dem))
        ky = ky_ctor_mac_dinh(lop)
    ra("    newobj instance void " + lop + "::.ctor(" + ky + ")")
    KW_N = goc_kw
    return lop


def bt_goi(ten: "str") -> "str":
    global MONG
    global KW_N
    global VT
    global FN_RET
    global FN_PSO
    global FN_PDAU
    global PAR_KIEU
    ten = doi_ten_lg(ten)
    if tim_ham(ten) < 0:
        ten = go_bi_danh(ten)
    fi = tim_ham(ten)
    if fi < 0:
        em_loi("goi ham chua khai: " + ten)
        return "i32"
    dem = 0
    ky = ""
    lg = chi_so_lg_moi(ten)
    if lg >= 0:
        ky = nap_bat_lg(lg)
        dem = so_bat_lg(lg)
    if la_op(")") == 0:
        con = 1
        while con == 1:
            if k() == "NAME" and tok_kind(VT + 1) == "OP" and tok_val(VT + 1) == "=":
                con = 0
            else:
                # Kieu DANG CHO = kieu tham so (2026-09-24): lambda lam doi
                # so lay kieu tham so cua no tu day, giong trinh that.
                if dem < FN_PSO[fi]:
                    MONG = PAR_KIEU[FN_PDAU[fi] + dem]
                t_ds = bt()
                # LUOI AN TOAN (2026-09-25): container KHAC kieu tham so la SAI
                # AM THAM ('hoisted = []' suy list[str] roi truyen vao tham so
                # list[(str,list[str],i32)] -> AddRange nem luc chay).
                if dem < FN_PSO[fi]:
                    k_ts = PAR_KIEU[FN_PDAU[fi] + dem]
                    if chua_khac(t_ds, k_ts) == 1 or doi_so_sai_kieu(t_ds, k_ts) == 1:
                        em_loi("doi so " + str(dem + 1) + " cua " + ten + ": kieu " + t_ds + " khac kieu tham so " + k_ts)
                # THUA doi so (vd dau phay du truoc ')'): truoc day cho nay
                # doc thang PAR_KIEU[...] roi NEM ArgumentOutOfRange - hat
                # giong SAP chu khong bao loi. Nay dem tiep de bao dung so.
                if dem < FN_PSO[fi]:
                    if dem > 0:
                        ky = ky + ", "
                    ky = ky + il_kieu(PAR_KIEU[FN_PDAU[fi] + dem])
                dem = dem + 1
                if khop_op(",") == 0:
                    con = 0
    goc_kw = KW_N
    quet_khoa()
    can_op(")")
    # Thieu doi so: lay theo TEN neu co, khong thi phat lai bieu thuc mac
    # dinh - ca hai deu bang cach nhay con tro ve vi tri token da ghi.
    while dem < FN_PSO[fi]:
        phat_doi_so(FN_PDAU[fi] + dem, goc_kw)
        if dem > 0:
            ky = ky + ", "
        ky = ky + il_kieu(PAR_KIEU[FN_PDAU[fi] + dem])
        dem = dem + 1
    KW_N = goc_kw
    if dem != FN_PSO[fi]:
        em_loi("ham " + ten + " can " + str(FN_PSO[fi]) + " tham so, nhan " + str(dem))
    ra("    call " + il_kieu(FN_RET[fi]) + " Tkv::" + ten_il(ten) + "(" + ky + ")")
    return FN_RET[fi]


# Lenh `ldstr` cho chuoi `x` (2026-09-24). ilasm CAT chuoi tai ky tu NUL -
# ca `"a\0b"` lan `"a\000b"` deu cho do dai 1 (da do that). Chuoi co NUL phai
# di dang `ldstr bytearray (...)` - UTF-16LE, hai byte moi ky tu.
def hex2(n: "i32") -> "str":
    so = "0123456789ABCDEF"
    return so[n // 16] + so[n % 16]


def ldstr_il(x: "str") -> "str":
    if chr(0) not in x:
        return "    ldstr \"" + thoat_il(x) + "\""
    r = "    ldstr bytearray ("
    i = 0
    while i < len(x):
        m = ord(x[i])
        if i > 0:
            r = r + " "
        r = r + hex2(m % 256) + " " + hex2(m // 256)
        i = i + 1
    return r + ")"


def thoat_il(x: "str") -> "str":
    r = ""
    i = 0
    while i < len(x):
        c = x[i]
        if c == "\\":
            r = r + "\\\\"
        else:
            if c == "\"":
                r = r + "\\\""
            else:
                if c == "\n":
                    r = r + "\\n"
                else:
                    if c == "\t":
                        r = r + "\\t"
                    else:
                        r = r + c
        i = i + 1
    return r


# Mot doi so co the la BIEU THUC SINH 'x for y in z': xu ly y het rut gon
# danh sach, chi khac o cho dau mo la '(' cua chinh loi goi.
# LUU Y: bt_rut_gon de VT o NGAY SAU dau dong, nen ham nay tu nuot ')' cho
# ca hai nhanh - cho goi KHONG duoc goi can_op(")") them lan nua.
# next(<sinh>, <mac dinh>): dung CA danh sach roi lay phan tu dau, khong
# phai bo lap luoi. Khac Python o cho no duyet het nguon - dung duoc vi moi
# cho goi trong cay deu duyet mot danh sach huu han khong co tac dung phu.
# BAT BUOC co gia tri mac dinh: Python nem StopIteration khi rong, sinh bua
# mot gia tri o day la sai am tham.
def bt_next() -> "str":
    global MONG
    global VT
    vt_g = VT
    t = "list[str]"
    if la_op("(") == 1 and tim_for_trong(vt_g, qua_ngoac(vt_g)) > 0:
        t = bt_rut_gon(vt_g)
    else:
        t = bt()
    kpt = kieu_pt(t)
    n_md = nhan_moi()
    n_het = nhan_moi()
    ra("    dup")
    ra("    callvirt instance int32 " + il_kieu(t) + "::get_Count()")
    ra("    brfalse L" + str(n_md))
    ra("    ldc.i4.0")
    ra("    callvirt instance !0 " + il_kieu(t) + "::get_Item(int32)")
    ra("    br L" + str(n_het))
    ra("  L" + str(n_md) + ":")
    ra("    pop")
    if khop_op(",") == 0:
        em_loi("next(...) phai co gia tri mac dinh")
        ra_mac_dinh(kpt)
    else:
        if la_ten("None") == 1:
            an()
            ra_mac_dinh(kpt)
        else:
            MONG = kpt
            bt()
    ra("  L" + str(n_het) + ":")
    can_op(")")
    return kpt


def bt_hoac_sinh(vt_mo: "i32") -> "str":
    if vt_mo > 0:
        if tim_for_trong(vt_mo, qua_ngoac(vt_mo)) > 0:
            return bt_rut_gon(vt_mo)
    t = bt()
    can_op(")")
    return t


def bt_builtin(ten: "str") -> "str":
    global MONG
    global VT
    vt_mo0 = VT - 1
    if ten == "next":
        return bt_next()
    if ten == "len":
        t = bt()
        can_op(")")
        tt = chuan_tup(t)
        if t == "str":
            ra("    callvirt instance int32 [mscorlib]System.String::get_Length()")
        elif bat_dau_bang(tt, "Tup") == 1 and tim_lop(tt) >= 0:
            # len(tuple) = SO PHAN TU, hang so (2026-09-25): lop Tup khong co
            # get_Count - truoc day DICH SACH, MissingMethodException luc chay.
            ra("    pop")
            ra("    ldc.i4 " + so_truong_tup(tt))
        else:
            ra("    callvirt instance int32 " + il_kieu(t) + "::get_Count()")
        return "i32"
    if ten == "dict_rong":
        can_op(")")
        ra("    newobj instance void " + il_kieu(MONG) + "::.ctor()")
        return MONG
    if ten == "str":
        t = bt()
        can_op(")")
        if t == "str":
            # Da la chuoi: khong duoc goi ToString(int32) len mot tham chieu -
            # no in ra dia chi duoi dang so.
            return "str"
        if t == "bool":
            ra("    call string Tkv::__bool_str(int32)")
            return "str"
        if la_ngoai_le(t) == 1:
            ra("    callvirt instance string [mscorlib]System.Exception::get_Message()")
            return "str"
        if tim_lop(t) >= 0 or la_chua(t) == 1:
            ra("    callvirt instance string [mscorlib]System.Object::ToString()")
            return "str"
        if t == "f64":
            ra("    call string Tkv::__f64_str(float64)")
            return "str"
        if t == "i64":
            ra("    call string [mscorlib]System.Convert::ToString(int64)")
            return "str"
        ra("    call string [mscorlib]System.Convert::ToString(int32)")
        return "str"
    if ten == "repr":
        # repr() (2026-09-24) - truoc day `!r` trong f-string bi thay bang
        # str() AM THAM. Chuoi: luat trich dan cua CPython (__repr_str).
        # So / bool: repr == str. Container/record: CHUA ho tro - BAO LOI
        # thay vi in sai (str() cua no in TEN KIEU .NET, khong phai Python).
        t = bt()
        can_op(")")
        if t == "str":
            ra("    call string Tkv::__repr_str(string)")
            return "str"
        if t == "bool":
            ra("    call string Tkv::__bool_str(int32)")
            return "str"
        if t == "f64":
            ra("    call string Tkv::__f64_str(float64)")
            return "str"
        if t == "i64":
            ra("    call string [mscorlib]System.Convert::ToString(int64)")
            return "str"
        if t == "i32":
            ra("    call string [mscorlib]System.Convert::ToString(int32)")
            return "str"
        if t == "list[str]":
            ra("    call string Tkv::__repr_ds_str(class [mscorlib]System.Collections.Generic.List`1<string>)")
            return "str"
        em_loi("repr() chua ho tro kieu " + t)
        return "str"
    if ten == "ord":
        bt()
        can_op(")")
        ra("    ldc.i4.0")
        ra("    callvirt instance char [mscorlib]System.String::get_Chars(int32)")
        return "i32"
    if ten == "chr":
        bt()
        can_op(")")
        ra("    conv.u2")
        ra("    call string [mscorlib]System.Char::ToString(char)")
        return "str"
    if ten == "isinstance":
        # Hat giong co kieu TINH: tra loi ngay luc dich, khong co kiem tra luc chay.
        t = bt()
        can_op(",")
        mong = v()
        if khop_op("(") == 1:
            # isinstance(x, (list, tuple)): lay ten dau, bo qua phan con lai.
            mong = v()
            while la_op(")") == 0 and k() != "EOF":
                an()
            can_op(")")
        else:
            an()
        can_op(")")
        # Kieu TINH khop -> voi kieu THAM CHIEU con phai khac None (2026-09-25):
        # 'isinstance(x, str)' voi x = d.get(k) = None la False trong Python;
        # truoc day hang 1, roi 'x.startswith' nem NullReference.
        khop_tc = 0
        if t == "str" and mong == "str":
            khop_tc = 1
        if la_list(t) == 1 and mong == "list":
            khop_tc = 1
        if la_dict(t) == 1 and mong == "dict":
            khop_tc = 1
        if la_set(t) == 1 and (mong == "set" or mong == "frozenset"):
            khop_tc = 1
        if bat_dau_bang(chuan_tup(t), "Tup") == 1 and mong == "tuple":
            khop_tc = 1
        if tim_lop(t) >= 0 and t == mong:
            khop_tc = 1
        if khop_tc == 1:
            ra("    ldnull")
            ra("    cgt.un")
        else:
            ra("    pop")
            if (t == "i32" and mong == "int") or (t == "bool" and mong == "bool") or (t == "f64" and mong == "float"):
                ra("    ldc.i4.1")
            else:
                ra("    ldc.i4.0")
        return "bool"
    if ten == "bool":
        t = bt_hoac_sinh(vt_mo0)
        if t == "str":
            ra("    call bool [mscorlib]System.String::IsNullOrEmpty(string)")
            ra("    ldc.i4.0")
            ra("    ceq")
            return "i32"
        # bool(container) = 0/1, an toan voi None (2026-09-25): truoc day tra
        # THANG so phan tu (bool([a, b]) == 2) va nem NullReference voi None.
        if la_chua(t) == 1:
            phat_chan_ly(t)
        return "i32"
    if ten == "abs":
        bt()
        can_op(")")
        ra("    call int32 [mscorlib]System.Math::Abs(int32)")
        return "i32"
    if ten == "min" or ten == "max":
        # CHI dang HAI doi so nguyen - dang duy nhat ca cay nguon dung tren
        # duong dich. `min(danh_sach)` va dang ba doi so tro len bao loi ro
        # rang thay vi sinh ma sai am tham.
        ta = bt()
        if ta != "i32":
            em_loi(ten + "() chi nhan so nguyen i32, gap " + ta)
        can_op(",")
        tb = bt()
        if tb != "i32":
            em_loi(ten + "() chi nhan so nguyen i32, gap " + tb)
        if la_op(",") == 1:
            em_loi(ten + "() moi chi ho tro DUNG hai doi so")
        can_op(")")
        if ten == "min":
            ra("    call int32 [mscorlib]System.Math::Min(int32, int32)")
        else:
            ra("    call int32 [mscorlib]System.Math::Max(int32, int32)")
        return "i32"
    if ten == "sorted" or ten == "reversed":
        t = bt_hoac_sinh(vt_mo0)
        kds = kieu_ds_tu_nguon(t, ten)
        ra("    newobj instance void " + il_kieu(kds) + "::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
        ra("    dup")
        if ten == "sorted":
            ra("    callvirt instance void " + il_kieu(kds) + "::Sort()")
        else:
            ra("    callvirt instance void " + il_kieu(kds) + "::Reverse()")
        return kds
    if ten == "sum":
        t = bt_hoac_sinh(vt_mo0)
        if t != "list[i32]":
            em_loi("sum() can danh sach so, gap " + t)
        ra("    call int32 Tkv::__tong_ds(class [mscorlib]System.Collections.Generic.List`1<int32>)")
        return "i32"
    if ten == "any" or ten == "all":
        t = bt_hoac_sinh(vt_mo0)
        if ten == "any":
            ra("    call int32 Tkv::__co_mot(class [mscorlib]System.Collections.Generic.List`1<int32>)")
        else:
            ra("    call int32 Tkv::__ca_thay(class [mscorlib]System.Collections.Generic.List`1<int32>)")
        # `list[bool]` cung BIEU DIEN la List<int32> (xem il_kieu) - tu khi
        # phep so sanh duoc suy dung la bool (2026-09-24) thi day la dang
        # thuong gap; truoc do no chi lot qua vi bi suy NHAM thanh i32.
        if t != "list[i32]" and t != "list[bool]":
            em_loi(ten + "() can danh sach dieu kien, gap " + t)
        # `bool` (2026-09-24): IL van la int32, nhung o tang kieu phai la bool
        # de `print(any(...))` in True/False nhu Python, khong in 1/0.
        return "bool"
    if ten == "proc_run":
        bt()
        if khop_op(",") == 1:
            bt()
        else:
            ra("    ldstr \"\"")
        can_op(")")
        ra("    call int32 class TkvProc::Chay(string, string)")
        return "i32"
    if ten == "proc_ra":
        # Nhu proc_run nhung GHI stdout+stderr vao mot file. proc_run khong
        # bat duoc dau ra, ma di vong qua 'cmd /c ... > file' thi quoting
        # khong on dinh (da thu, cmd bao sai cu phap duong dan).
        bt()
        can_op(",")
        bt()
        can_op(",")
        bt()
        can_op(")")
        ra("    call int32 class TkvProc::ChayRa(string, string, string)")
        return "i32"
    if ten == "vars":
        bt()
        can_op(")")
        ra("    call class [mscorlib]System.Collections.Generic.Dictionary`2<string, string> Tkv::__bang_truong(object)")
        return "dict[str,str]"
    if ten == "getattr" or ten == "hasattr" or ten == "setattr":
        bt()
        can_op(",")
        bt()
        if ten == "setattr":
            can_op(",")
            bt()
            can_op(")")
            ra("    call void Tkv::__dat_truong(object, string, string)")
            return "void"
        if khop_op(",") == 1:
            bt()
        else:
            ra("    ldstr \"\"")
        can_op(")")
        if ten == "hasattr":
            ra("    call int32 Tkv::__co_truong(object, string, string)")
            return "i32"
        ra("    call string Tkv::__lay_truong(object, string, string)")
        return "str"
    if ten == "frozenset" or ten == "set":
        kieu = "set[str]"
        if la_op(")") == 0:
            # Doi so la TUPLE VIET THANG 'frozenset(("a", "b"))': doc nhu mot
            # day (2026-09-25) - truoc day thanh mot doi tuong TupN roi dua vao
            # HashSet(IEnumerable): EntryPointNotFoundException luc chay.
            if la_op("(") == 1 and la_tuple_hien(VT) == 1:
                t = bt_ds_ngoac()
            else:
                t = bt()
            if la_set(t) == 1 or la_list(t) == 1:
                kieu = "set[" + kieu_pt(t) + "]"
            elif la_dict(t) == 1:
                # set(dict) = tap KHOA (nhu Python). Dictionary tu no duyet ra
                # KeyValuePair - dua thang vao la sai kieu.
                kk = cat_hai(ruot(t), 1)
                ra("    callvirt instance class [mscorlib]System.Collections.Generic.Dictionary`2/KeyCollection<!0, !1> " + il_kieu(t) + "::get_Keys()")
                kieu = "set[" + kk + "]"
            else:
                em_loi(ten + "(x) chi nhan list/set/dict/tuple viet thang, gap " + t)
            can_op(")")
            ra("    newobj instance void " + il_kieu(kieu) + "::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
            return kieu
        can_op(")")
        # 'set()' RONG: dung kieu MONG DOI (bien da khai / tham so) neu la tap -
        # truoc day luon set[str] (2026-09-25).
        if la_set(MONG) == 1:
            kieu = chuan_tup(MONG)
        ra("    newobj instance void " + il_kieu(kieu) + "::.ctor()")
        return kieu
    if ten == "zip":
        ta_z = bt()
        can_op(",")
        tb_z = bt()
        can_op(")")
        kz = kieu_zip(ta_z, tb_z)
        if kz == "":
            em_loi("zip(a, b) can hai danh sach, gap " + ta_z + " va " + tb_z)
            return "list[str]"
        ra("    call " + il_kieu(kz) + " Tkv::" + zip_ky(kz) + "(" + il_kieu(ta_z) + ", " + il_kieu(tb_z) + ")")
        return kz
    if ten == "dict":
        if la_op(")") == 1:
            em_loi("dict() rong chua ho tro - dung '{}' de suy duoc kieu")
            can_op(")")
            return "dict[str,str]"
        t = bt()
        can_op(")")
        kieu = kieu_dict_tu_cap(t)
        if kieu == "":
            em_loi("dict(x) can mot danh sach cap 2 phan tu, gap " + t)
            return "dict[str,str]"
        ra("    call " + il_kieu(kieu) + " Tkv::" + tdi_ky(kieu) + "(" + il_kieu(t) + ")")
        return kieu
    if ten == "list":
        t = bt()
        can_op(")")
        kds = kieu_ds_tu_nguon(t, ten)
        ra("    newobj instance void " + il_kieu(kds) + "::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
        return kds
    if ten == "float":
        ki = bt()
        can_op(")")
        if ki == "f64":
            return "f64"
        if ki == "str":
            # BAT BUOC InvariantCulture: may nay locale vi-VN nen Parse
            # thuong coi '.' la dau phan NHOM - float("2.75") ra 275.0,
            # dich sach ma chay sai. Da do that bang probe.
            ra("    call class [mscorlib]System.Globalization.CultureInfo [mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()")
            ra("    call float64 [mscorlib]System.Double::Parse(string, class [mscorlib]System.IFormatProvider)")
            return "f64"
        ra("    conv.r8")
        return "f64"
    if ten == "int":
        ki = bt()
        if khop_op(",") == 1:
            bt()
            can_op(")")
            ra("    call int32 [mscorlib]System.Convert::ToInt32(string, int32)")
            return "i32"
        can_op(")")
        if ki == "i32" or ki == "bool":
            return "i32"
        # int(so thuc) = cat phan le ve 0 (2026-09-25) - truoc day day float64
        # vao Int32.Parse(string).
        if ki == "f64":
            ra("    conv.ovf.i4")
            return "i32"
        if ki != "str":
            em_loi("int() chua ho tro doi so kieu " + ki)
        ra("    call int32 [mscorlib]System.Int32::Parse(string)")
        return "i32"
    # os.path co ban - anh xa THANG sang System.IO.Path, cung ky thuat voi
    # read_file/write_file (System.IO.File). Ten khong co tien to 'os.' vi
    # cu phap 'module.ham()' chua ho tro; xem il_features/stdlib_path.
    if ten == "path_join":
        bt()
        can_op(",")
        bt()
        can_op(")")
        ra("    call string [mscorlib]System.IO.Path::Combine(string, string)")
        return "str"
    if ten == "path_dirname":
        bt()
        can_op(")")
        ra("    call string [mscorlib]System.IO.Path::GetDirectoryName(string)")
        return "str"
    if ten == "path_basename":
        bt()
        can_op(")")
        ra("    call string [mscorlib]System.IO.Path::GetFileName(string)")
        return "str"
    if ten == "path_abspath":
        bt()
        can_op(")")
        ra("    call string [mscorlib]System.IO.Path::GetFullPath(string)")
        return "str"
    if ten == "path_isfile":
        bt()
        can_op(")")
        ra("    call bool [mscorlib]System.IO.File::Exists(string)")
        return "i32"
    if ten == "path_isdir":
        bt()
        can_op(")")
        ra("    call bool [mscorlib]System.IO.Directory::Exists(string)")
        return "i32"
    if ten == "read_file":
        bt()
        can_op(")")
        ra("    call string [mscorlib]System.IO.File::ReadAllText(string)")
        return "str"
    if ten == "sys_argv":
        can_op(")")
        ra("    call string[] [mscorlib]System.Environment::GetCommandLineArgs()")
        ra("    newobj instance void class [mscorlib]System.Collections.Generic.List`1<string>::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)")
        return "list[str]"
    em_loi("builtin chua ho tro: " + ten)
    return "i32"


