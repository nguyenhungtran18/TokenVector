EMLOI_N: "i32" = 0


def em_loi(thong_diep: "str") -> "i32":
    global EM_LOI
    global EMLOI_N
    global VT
    s = "dong " + str(tok_dong(VT)) + ": " + thong_diep
    if EMLOI_N == len(EM_LOI):
        EM_LOI.append(s)
    else:
        EM_LOI[EMLOI_N] = s
    EMLOI_N = EMLOI_N + 1
    return 0


def em_so_loi() -> "i32":
    global EMLOI_N
    return EMLOI_N


def em_loi_thu(i: "i32") -> "str":
    global EM_LOI
    return EM_LOI[i]


def ra(dong: "str") -> "i32":
    global OUT
    global OUT_N
    if OUT_N == len(OUT):
        OUT.append(dong)
    else:
        OUT[OUT_N] = dong
    OUT_N = OUT_N + 1
    return OUT_N


def ra_so_dong() -> "i32":
    global OUT_N
    return OUT_N


def ra_dong(i: "i32") -> "str":
    global OUT
    return OUT[i]


def nhan_moi() -> "i32":
    global NHAN
    NHAN = NHAN + 1
    return NHAN


def k() -> "str":
    global VT
    return tok_kind(VT)


def v() -> "str":
    global VT
    return tok_val(VT)


def an() -> "i32":
    global VT
    VT = VT + 1
    return VT


def la_op(x: "str") -> "i32":
    if k() == "OP" and v() == x:
        return 1
    return 0


def la_ten(x: "str") -> "i32":
    if k() == "NAME" and v() == x:
        return 1
    return 0


def khop_op(x: "str") -> "i32":
    if la_op(x) == 1:
        an()
        return 1
    return 0


def can_op(x: "str") -> "i32":
    if khop_op(x) == 1:
        return 1
    em_loi("cho doi '" + x + "' nhung gap '" + v() + "'")
    return 0


def tim_loc(ten: "str") -> "i32":
    global LOC_TEN
    global LOC_N
    i = 0
    while i < LOC_N:
        if LOC_TEN[i] == ten:
            return i
        i = i + 1
    return -1


# Ghi DE kieu cua mot bien da khai. CHI dung trong cac vong hoan giai
# quyet: kieu suy ra lan dau co the con phu thuoc mot bien chua biet, vong
# sau moi du du lieu. Ngoai giai doan do, them_loc (giu ban DAU TIEN) moi
# la dung.
def dat_loc(ten: "str", kieu: "str", chu: "i32") -> "i32":
    global LOC_KIEU
    global LOC_CHU
    j = tim_loc(ten)
    if j < 0:
        j = them_loc(ten, kieu)
        LOC_CHU[j] = chu
        return j
    # CHI muc hoan DA TAO ra o nay moi duoc ghi de. Cho ai cung ghi de thi
    # phep gan CUOI trong ham thang - sai voi moi bien duoc gan lai bang
    # mot kieu khac, va do la chuyen rat thuong.
    if LOC_CHU[j] != chu:
        return j
    LOC_KIEU[j] = chuan_tup(kieu)
    return j


def them_loc(ten: "str", kieu: "str") -> "i32":
    global LOC_TEN
    global LOC_KIEU
    global LOC_CHU
    global LOC_N
    kieu = chuan_tup(kieu)
    cu = tim_loc(ten)
    if cu >= 0:
        return cu
    if LOC_N == len(LOC_TEN):
        LOC_TEN.append(ten)
        LOC_KIEU.append(kieu)
        LOC_CHU.append(0 - 1)
    else:
        LOC_TEN[LOC_N] = ten
        LOC_KIEU[LOC_N] = kieu
        LOC_CHU[LOC_N] = 0 - 1
    LOC_N = LOC_N + 1
    return LOC_N - 1


def tim_ham(ten: "str") -> "i32":
    global FN_TEN
    global FN_N
    i = 0
    while i < FN_N:
        if FN_TEN[i] == ten:
            return i
        i = i + 1
    return -1


# Dinh danh trung TU KHOA IL phai duoc trich dan, neu khong ilasm bao
# "syntax error at token". Da co tien le trong du an (xem il_core.py).
def them_bi_danh(tu: "str", toi: "str") -> "i32":
    global BD_TU
    global BD_TOI
    global BD_N
    if tu == toi:
        return 0
    i = 0
    while i < BD_N:
        if BD_TU[i] == tu:
            return 0
        i = i + 1
    if BD_N == len(BD_TU):
        BD_TU.append(tu)
        BD_TOI.append(toi)
    else:
        BD_TU[BD_N] = tu
        BD_TOI[BD_N] = toi
    BD_N = BD_N + 1
    return BD_N


def go_bi_danh(ten: "str") -> "str":
    global BD_TU
    global BD_TOI
    global BD_N
    i = 0
    while i < BD_N:
        if BD_TU[i] == ten:
            return BD_TOI[i]
        i = i + 1
    return ten


