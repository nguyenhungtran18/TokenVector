# PHAI dat lai: goi bien_dich hai lan lien tiep ma khong dat lai thi bang ham,
# bang toan cuc va bo dem IL cua lan truoc con nguyen -> ket qua rac.
def em_dat_lai() -> "i32":
    global LAM_N
    global ZIP_N
    global BD_N
    global DG_N
    global IN_N
    global UPD_N
    global HOP_N
    global OUT_N
    global FN_N
    global PAR_N
    global GV_N
    global LOC_N
    global THOAT_N
    global EMLOI_N
    global NHAN
    global VT
    global SO_THAM
    OUT_N = 0
    FN_N = 0
    PAR_N = 0
    GV_N = 0
    LOC_N = 0
    THOAT_N = 0
    EMLOI_N = 0
    NHAN = 0
    VT = 0
    SO_THAM = 0
    DG_N = 0
    IN_N = 0
    UPD_N = 0
    HOP_N = 0
    BD_N = 0
    ZIP_N = 0
    LAM_N = 0
    return 0


def bien_dich(src: "str") -> "i32":
    global VT
    em_dat_lai()
    if tokenize_nguon(src) == 0:
        return 0
    doi_ten_rut_gon()
    thu_thap_lop()
    quet_vt_ham_long()
    thu_thap_bi_danh()
    thu_thap_ham()
    thu_thap_toan_cuc()
    thu_thap_ham_long()
    phat_dau_chuong_trinh()
    # Luot phat 1: cac lop, NGOAI lop Tkv (neu long vao trong thi moi tham
    # chieu phai viet 'Tkv/Ten').
    VT = 0
    while k() != "EOF":
        if la_ten("class") == 1:
            phat_mot_lop()
        else:
            an()
    phat_mo_tkv()
    phat_truong_tinh()
    phat_ho_tro()
    VT = 0
    while k() != "EOF":
        if la_op("@") == 1:
            an()
            bo = 0
            if v() == "__tkv_cpython_only__":
                bo = 1
            while k() != "NL" and k() != "EOF":
                an()
            if bo == 1:
                nhay_den_def()
                an()
                nhay_den_def()
        else:
            if la_ten("def") == 1:
                phat_mot_ham()
            else:
                if la_ten("class") == 1:
                    nhay_qua_lop()
                else:
                    if la_ten("if") == 1 and dau_dong_tok(VT) == 1:
                        # Khoi `if` CAP MODULE la phan CHI CPython (2026-09-24,
                        # xem thu_thap_ham) - khong phat `def` nao ben trong.
                        VT = cuoi_khoi_def(VT)
                    else:
                        an()

    phat_cac_dget()
    phat_cac_dsd()
    phat_cac_dpop()
    phat_cac_lpop()
    phat_cac_in()
    phat_cac_upd()
    phat_cac_hop()
    phat_cac_tdi()
    phat_cac_zip()
    ra("}")
    ra("")
    phat_cac_tup()
    phat_cac_lam()
    phat_cac_ad()
    phat_cac_dg()
    phat_lop_proc()
    if em_so_loi() > 0:
        return 0
    return 1


# PHAI dung join, KHONG duoc 's = s + ...' trong vong lap: .NET cap phat
# chuoi moi moi phep cong nen 22 000 dong thanh BAC HAI (~5,5 GB sao chep).
# CPython co toi uu noi tai cho nen loi nay VO HINH khi chay bang CPython -
# chi lo ra khi so gio chay cua ban .exe voi ban CPython.
def ghep_ra() -> "str":
    global OUT
    global OUT_N
    if OUT_N == 0:
        return ""
    return "\n".join(OUT[0:OUT_N]) + "\n"

# seed_main.tkv - diem vao cua trinh bien dich hat giong.
#   seed_main.exe <nguon.tkv> <ra.il>


def bao_loi_ra() -> "i32":
    i = 0
    while i < lex_so_loi():
        print("LOI TACH TU: " + lex_loi(i))
        i = i + 1
    i = 0
    while i < em_so_loi():
        print("LOI DICH: " + em_loi_thu(i))
        i = i + 1
    return 0


# CHE DO DO (cho vong lap "cho hat giong an"): dem so HAM DICH SACH tren
# mot nguon gop. Hat giong da biet CA HAI thu can: ranh gioi tung 'def'
# (qua IND/DED) va so dong cua tung loi. Do bang chinh no thi khong con
# phai chay hat giong bang CPython nua (22 s -> duoi 1 s).
#
# BAY DA DINH 3 LAN: bien_dich THOAT SOM khi tach tu con loi, luc do so
# "loi dich" va "ham sach" deu la SO RAC. Phai bao loi tach tu ra rieng va
# nguoi doc phai coi ket qua la vo nghia khi no khac 0.
# Danh sach SO DONG cua moi loi - tinh MOT LAN. Truoc day ham nay phan
# tich lai chuoi loi cho tung dong cua tung ham: 953 ham x ~30 dong x 400
# loi = hang chuc trieu lan cat chuoi, do 25.8 s cho mot lan do.
def ds_dong_loi() -> "list[i32]":
    r = []
    i = 0
    while i < em_so_loi():
        r.append(so_dong_loi(em_loi_thu(i)))
        i = i + 1
    return r


# "dong 123: ..." -> 123; -1 neu khong doc duoc.
def so_dong_loi(m: "str") -> "i32":
    if not m.startswith("dong "):
        return -1
    j = 5
    s = ""
    while j < len(m):
        c = m[j]
        if c == ":":
            break
        s = s + c
        j = j + 1
    if len(s) == 0:
        return -1
    return int(s)


def do_ham_sach() -> "str":
    dsl = ds_dong_loi()
    tong = 0
    sach = 0
    i = 0
    while tok_kind(i) != "EOF":
        if tok_kind(i) == "NAME" and tok_val(i) == "def":
            tong = tong + 1
            d_dau = tok_dong(i)
            d_cuoi = d_dau
            sau = 0
            j = i
            vao = 0
            while tok_kind(j) != "EOF":
                if tok_kind(j) == "IND":
                    sau = sau + 1
                    vao = 1
                if tok_kind(j) == "DED":
                    sau = sau - 1
                    if vao == 1 and sau <= 0:
                        break
                d_cuoi = tok_dong(j)
                j = j + 1
            ban = 0
            q = 0
            while q < len(dsl):
                if dsl[q] >= d_dau and dsl[q] <= d_cuoi:
                    ban = 1
                    break
                q = q + 1
            if ban == 0:
                sach = sach + 1
        i = i + 1
    return "ham_sach " + str(sach) + "\nham_tong " + str(tong) + "\nloi_dich " + str(em_so_loi()) + "\nloi_tach_tu " + str(lex_so_loi()) + "\n"


def main() -> "i32":
    tham = sys_argv()
    if len(tham) < 3:
        print("dung: seed_main.exe [--du] <nguon.tkv> <ra.il>  |  --do <nguon.tkv> [bao_cao.txt]")
        return 2
    if tham[1] == "--do":
        src = read_file(tham[2])
        bien_dich(src)
        bc = do_ham_sach()
        if len(tham) > 3:
            write_file(tham[3], bc)
        print(bc)
        return 0
    # CHE DO --du ("du loi van ghi"). Vi sao can: truoc day mot loi o BAT KY
    # dau lam ca lan dich khong ghi ra mot dong IL nao, nen thuoc do "so ham
    # co than IL" ket o 0/1281 cho toi khi sua xong loi CUOI CUNG - mot cong
    # duoc-an-ca-nga-ve-khong, khong cho tin hieu nao doc duong. Do 2026-09-23:
    # 1223/1281 ham khong co dong loi nao ma van KHONG duoc sinh IL.
    # Ma thoat VAN la 1 khi co loi - che do nay chi them phep GHI, khong bien
    # mot lan dich hong thanh thanh cong.
    du = 0
    vt = 1
    if tham[1] == "--du":
        du = 1
        vt = 2
    if len(tham) < vt + 2:
        print("dung: seed_main.exe [--du] <nguon.tkv> <ra.il>")
        return 2
    src = read_file(tham[vt])
    ok = bien_dich(src)
    if ok == 0:
        bao_loi_ra()
        if du == 0:
            return 1
    write_file(tham[vt + 1], ghep_ra())
    print("OK " + str(ra_so_dong()) + " dong IL")
    if ok == 0:
        return 1
    return 0

