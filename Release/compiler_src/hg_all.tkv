def dat_cha(lop: "str", cha: "str") -> "i32":
    global LCHA_TEN
    global LCHA_CHA
    global LCHA_N
    if LCHA_N == len(LCHA_TEN):
        LCHA_TEN.append(lop)
        LCHA_CHA.append(cha)
    else:
        LCHA_TEN[LCHA_N] = lop
        LCHA_CHA[LCHA_N] = cha
    LCHA_N = LCHA_N + 1
    return LCHA_N


def cha_cua(lop: "str") -> "str":
    i = 0
    while i < LCHA_N:
        if LCHA_TEN[i] == lop:
            return LCHA_CHA[i]
        i = i + 1
    return ""


# Ngoai le DUNG SAN -> kieu CLR. 7 muc dau CHEP NGUYEN tkv_types.EXC_CLR cua
# trinh that; 5 muc sau la ten cay nguon co nem/bat ma bang cu thieu - moi
# cai mot kieu CLR RIENG, KHONG nam duoi kieu nao khac trong bang (vd
# TypeError khong duoc la ArgumentException: IndexError = ArgumentOutOf-
# RangeException la con cua no, `except TypeError` se bat nham).
def exc_dung_san(ten: "str") -> "str":
    if ten == "Exception":
        return "[mscorlib]System.Exception"
    if ten == "ZeroDivisionError":
        return "[mscorlib]System.DivideByZeroException"
    if ten == "KeyError":
        return "[mscorlib]System.Collections.Generic.KeyNotFoundException"
    if ten == "IndexError":
        return "[mscorlib]System.ArgumentOutOfRangeException"
    if ten == "ValueError":
        return "[mscorlib]System.FormatException"
    if ten == "OverflowError":
        return "[mscorlib]System.OverflowException"
    if ten == "SyntaxError":
        return "[mscorlib]System.InvalidOperationException"
    if ten == "TypeError":
        return "[mscorlib]System.InvalidCastException"
    if ten == "AttributeError":
        return "[mscorlib]System.MissingMemberException"
    if ten == "RuntimeError":
        return "[mscorlib]System.ApplicationException"
    if ten == "AssertionError":
        return "[mscorlib]System.NotSupportedException"
    if ten == "OSError":
        return "[mscorlib]System.IO.IOException"
    return ""


def la_ngoai_le(ten: "str") -> "i32":
    if ten == "__exc":
        return 1
    if tim_lop(ten) < 0:
        if exc_dung_san(ten) != "":
            return 1
        return 0
    c = ten
    d = 0
    while d < 30:
        cha = cha_cua(c)
        if cha == "":
            return 0
        if tim_lop(cha) < 0:
            if exc_dung_san(cha) != "":
                return 1
            return 0
        c = cha
        d = d + 1
    return 0


# Ten kieu IL dung cho isinst/newobj/extends: lop tu dinh nghia = ten no;
# dung san = kieu CLR; khong phai ngoai le = "".
def exc_il(ten: "str") -> "str":
    if tim_lop(ten) >= 0:
        if la_ngoai_le(ten) == 1:
            return ten
        return ""
    return exc_dung_san(ten)


def bt_tao_ngoai_le(lop: "str") -> "str":
    global MONG
    if la_op(")") == 1:
        ra("    ldstr \"\"")
    else:
        MONG = "str"
        t = bt()
        if t != "str":
            em_loi("thong diep ngoai le phai la chuoi, gap " + t)
    can_op(")")
    ra("    newobj instance void " + lop + "::.ctor(string)")
    return lop


def phat_ctor_ngoai_le(lop: "str", cha_il: "str") -> "i32":
    ra("  .method public specialname rtspecialname instance void .ctor(string m) cil managed")
    ra("  {")
    ra("    .maxstack 64")
    ra("    ldarg.0")
    ra("    ldarg.1")
    ra("    call instance void " + cha_il + "::.ctor(string)")
    i = 0
    while i < CF_N:
        if CF_LOP[i] == lop and la_chua(CF_KIEU[i]) == 1:
            ra("    ldarg.0")
            ra("    newobj instance void " + il_kieu(CF_KIEU[i]) + "::.ctor()")
            ra("    stfld " + il_kieu(CF_KIEU[i]) + " " + lop + "::" + ten_il(CF_TEN[i]))
        i = i + 1
    ra("    ret")
    ra("  }")
    return 1


# Mot phep thu loai trong mot nhanh except: khop thi nhay vao than nhanh.
def phat_thu_loai(ten: "str", n_than: "i32") -> "i32":
    il = exc_il(ten)
    if il == "":
        em_loi("except " + ten + ": khong phai loai ngoai le da biet")
        return 0
    nap_ten("__ngoai_le")
    ra("    isinst " + il)
    ra("    brtrue L" + str(n_than))
    return 1


# Doc phan loai cua MOT nhanh except, phat cac phep thu; tra ten bien sau
# 'as' (rong neu khong co). Khong khop loai nao -> nhay sang nhanh sau.
def doc_nhanh_except(n_than: "i32", n_sau: "i32") -> "str":
    global VT
    if la_op("(") == 1:
        an()
        while la_op(")") == 0 and k() != "EOF":
            if k() == "NAME":
                phat_thu_loai(v(), n_than)
            an()
        can_op(")")
        ra("    br L" + str(n_sau))
    elif k() == "NAME" and la_ten("as") == 0:
        phat_thu_loai(v(), n_than)
        an()
        ra("    br L" + str(n_sau))
    else:
        ra("    br L" + str(n_than))
    if la_ten("as") == 1:
        an()
        ten_e = v()
        an()
        return ten_e
    return ""


