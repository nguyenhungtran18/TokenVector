# -*- coding: utf-8 -*-
"""Test am: goi key KHONG ton tai trong dict funcref phai loi RO RANG luc
chay (KeyNotFoundException that cua .NET Dictionary), khong tra ket qua
sai am tham."""


def add_one(x: "i32") -> "i32":
    return x + 1


def run_missing_key() -> "i32":
    registry: "dict[str, func(i32)->i32]" = {}
    registry["add_one"] = add_one
    return registry["khong_ton_tai"](5)
