# -*- coding: utf-8 -*-
"""HOI KIEU luc chay tren record ke thua (`isinstance` qua tham so kieu BASE).

VI SAO CO FILE NAY (2026-09-10): TRUOC khi co no, KHONG MOT file .tkv nao
trong ca repo dung `isinstance` - nen moi luoi deu MU voi tinh nang do.

PHAN BIET CHO RO: goi METHOD da hinh thi DA CHAY DUNG (xem
sample_inheritance.tkv - `speak()` override dispatch qua callvirt, da xac
minh bang probe_inheritance.il). Cai CHUA chay dung la HOI KIEU: `isinstance`
duoc giai TINH luc compile (thiet ke Phase 4, xem
compiler/il_features/typecheck.py), nen mot `Name` di qua tham so khai kieu
`Node` thi `isinstance(n, Name)` gap thanh FALSE - tra loi SAI ma khong bao gi.

CPython that tra 10; exe hien tra 0. File nay PHAI DO cho toi khi lo A xong."""


class Node:
    kind: "i32"

    def __init__(self, kind):
        self.kind = kind


class Name(Node):
    ten_code: "i32"

    def __init__(self, kind, ten_code):
        super().__init__(kind)
        self.ten_code = ten_code


class Num(Node):
    gia_tri: "i32"

    def __init__(self, kind, gia_tri):
        super().__init__(kind)
        self.gia_tri = gia_tri


def la_ten(n: "Node") -> "i32":
    """Tham so khai kieu BASE - day la cho then chot: kieu TINH cua `n` la
    Node, nen phep gap luc compile tra FALSE bat ke `n` that su la gi."""
    if isinstance(n, Name):
        return 1
    return 0


def demo_isinstance() -> "i32":
    a = Name(1, 100)
    b = Num(2, 7)
    return la_ten(a) * 10 + la_ten(b)
