# Mau cho math_misc_test: ho toan hoc + divmod + fmt_float.
#
# Chon gia tri co bieu dien CHINH XAC (cos(0), log(1), gcd...) de so chuoi
# duoc chu khong phai so xap xi.
#
# GIOI HAN DA GAP: fmt_float() chi nhan MOT BIEN DON, khong nhan bieu
# thuc - nen moi cho deu gan ra bien truoc. Va so chu so thap phan
# PHAI la hang so luc bien dich, khong nhan tham so dong.


def co_sin(x: "f64") -> "str":
    a = cos(x)
    b = sin(x)
    return fmt_float(a, 4) + "|" + fmt_float(b, 4)


def mu_loga(x: "f64") -> "str":
    a = exp(x)
    b = log(x)
    return fmt_float(a, 4) + "|" + fmt_float(b, 4)


def hang_so() -> "str":
    a = math_pi()
    b = math_e()
    return fmt_float(a, 5) + "|" + fmt_float(b, 5)


def uoc_chung(a: "i32", b: "i32") -> "i32":
    return math_gcd(a, b)


def chia_du(a: "i32", b: "i32") -> "str":
    q, r = divmod(a, b)
    return str(q) + "|" + str(r)


def lam_tron(x: "f64") -> "str":
    return fmt_float(x, 2)
