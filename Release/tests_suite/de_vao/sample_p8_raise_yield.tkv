# Bao phu cho lo 5 cua P8 Task 3/4.
#
# 'raise' TRAN va 'raise ... from ...' deu co 0 mau tren 169 file - dung hai
# nhanh vua doi cach ma hoa truong vang mat (None, khong phai ''). Khong co
# file nay thi cong IL xanh ma khong he di qua chung.

def raise_tran(n: "i32") -> "str":
    try:
        if n < 0:
            raise ValueError("am")
        return "ok"
    except ValueError:
        # 'raise' TRAN - nem lai chinh ngoai le dang xu ly.
        raise


def raise_from(n: "i32") -> "str":
    try:
        if n < 0:
            raise ValueError("am")
        return "ok"
    except ValueError as e:
        raise KeyError("boc lai") from e


def dung_bytes_literal(n: "i32") -> "str":
    # assign_bytes_literal: 0 mau tren 170 file - va la kind co bo giai ma
    # RIENG phuc tap nhat cua _KHOA_DS (parse_bytes_literal tren node bytes_lit).
    # KHONG dung escape o day: parser native CHUA dien giai escape trong
    # bytes literal, CPython thi cho byte that -> ast_compat_test.py bao
    # lech. Loi CO SAN cua parser, khong lien quan P8; da ghi vao
    # docs/BUGS_TODO.md. Mau nay chi can phu codegen cua assign_bytes_literal.
    b = b"ABC"
    return str(len(b)) + "," + str(n)
