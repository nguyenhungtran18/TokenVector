# Mau cho pickle_roundtrip_test: CA BON pickle_load_* (i32/i64/f64/str).
#
# Ma tran phu cho thay ca 4 builtin nay chua co LAY MOT test nao chay
# exe - tuc la chua ai biet chung co chay dung khong. Kiem tra bang
# round-trip: dump ra file roi load lai NGAY, in ra gia tri doc duoc.
#
# GIOI HAN CO Y: dinh dang la BinaryWriter/BinaryReader tu dinh nghia,
# KHONG phai pickle protocol cua CPython - hai runtime khong doc duoc
# file cua nhau (xem docstring pickle_feature.py). Nen ky vong VIET TAY
# chi rang buoc round-trip trong CHINH mot runtime.

def vong_i32(duong: "str", v: "str") -> "str":
    x = int(v)
    pickle_dump_i32(x, duong)
    y = pickle_load_i32(duong)
    return str(y)


def doc_i64(v: "str") -> "i64":
    # Khong co builtin i64(); ngu canh i64 phai den tu KIEU TRA VE
    # cua ham (khai bao local co kieu tuong minh chua ho tro i64).
    return int(v)


def vong_i64(duong: "str", v: "str") -> "str":
    x = doc_i64(v)
    pickle_dump_i64(x, duong)
    y = pickle_load_i64(duong)
    return str(y)


def vong_f64(duong: "str", v: "str") -> "str":
    x = float(v)
    pickle_dump_f64(x, duong)
    y = pickle_load_f64(duong)
    return fmt_float(y, 4)


def vong_str(duong: "str", v: "str") -> "str":
    pickle_dump_str(v, duong)
    y = pickle_load_str(duong)
    return y


def ghi_de(duong: "str", a: "str", b: "str") -> "str":
    # Ghi lan hai PHAI de len file cu (FileMode.Create), khong noi them.
    x = int(a)
    pickle_dump_i32(x, duong)
    y = int(b)
    pickle_dump_i32(y, duong)
    z = pickle_load_i32(duong)
    return str(z)
