# Kiem chung THAT: object/type tren __tkv_extern_method__ (Phase 9k,
# 2026-08-31) - phat hien qua tkv-bind chay tren NuGet Newtonsoft.Json,
# JsonConvert.SerializeObject(object)->string va
# JsonConvert.DeserializeObject(string)->object bi tu choi vi gioi han cu.
__tkv_extern_assembly__ = ("Newtonsoft.Json", "30 AD 4F E6 B2 A6 AE ED", "13:0:0:0")

__tkv_extern_method__ = [
    {"name": "json_serialize", "assembly": "Newtonsoft.Json", "class": "Newtonsoft.Json.JsonConvert",
     "method": "SerializeObject", "params": ["object"], "returns": "str"},
    {"name": "json_deserialize", "assembly": "Newtonsoft.Json", "class": "Newtonsoft.Json.JsonConvert",
     "method": "DeserializeObject", "params": ["str"], "returns": "object"},
]

def run_serialize(s: "str") -> "str":
    return json_serialize(s)

def run_roundtrip(s: "str") -> "str":
    o = json_deserialize(s)
    return json_serialize(o)
