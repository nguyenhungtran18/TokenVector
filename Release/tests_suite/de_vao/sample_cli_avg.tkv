"""Sinh boi AlphaAI (Groq, generate_and_verify - qua ai_connect), da bien
dich THAT xac nhan cu phap dung; chu ky duoc chuyen sang dang annotation-
string that (.tkv) boi con nguoi/Claude, than ham GIU NGUYEN tung dong AI
sinh ra."""


def avg_of_range(n: "i32") -> "f32":
    total = 0.0
    if n <= 0:
        return 0.0
    else:
        for i in range(n):
            total = total + i
        return total / n
