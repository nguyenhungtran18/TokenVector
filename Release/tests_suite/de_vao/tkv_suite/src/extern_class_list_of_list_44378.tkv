
def s2(m: "list[list[i32]]") -> "i32":
    total = 0
    for row in m:
        for v in row:
            total = total + v
    return total

def mk() -> "list[list[i32]]":
    return [[1, 2], [3, 4]]

def main() -> "i32":
    n = s2([[1, 2], [3, 4]])
    print(str(n))
    m2 = mk()
    print(str(m2[0][0]))
    print(str(m2[1][1]))
    return 0
