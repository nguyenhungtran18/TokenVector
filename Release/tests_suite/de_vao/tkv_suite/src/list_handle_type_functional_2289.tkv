
__tkv_extern_class__ = [
    {
        "name": "Sb", "assembly": "mscorlib", "class": "System.Text.StringBuilder",
        "ctor": ["str"],
        "methods": [{"name": "ToString", "params": [], "returns": "str"}],
    },
]

def is_hello(s: "Sb") -> "i32":
    if s.ToString() == "hello":
        return 1
    return 0

def main() -> "i32":
    a = Sb("hello")
    b = Sb("world")
    xs = [a, b]
    ys = filter(is_hello, xs)
    for y in ys:
        print(y.ToString())
    return 0
