        "ctor": ["str"],
        "methods": [
            {"name": "ToString", "params": [], "returns": "str"},
        ],
        "properties": [{"name": "Length", "dtype": "i32", "readonly": True}],
    },
]

def make_list() -> "list[Sb]":
    a = Sb("alpha")
    b = Sb("beta")
    items = [a]
    items.append(b)
    return items

def main() -> "i32":
    for item in make_list():
        print(item.ToString())
        print(item.Length)
