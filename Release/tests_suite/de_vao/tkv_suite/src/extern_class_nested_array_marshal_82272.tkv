
__tkv_extern_assembly__ = [("NestedArrayFixture", None, None)]
__tkv_extern_class__ = [
    {
        "name": "NestedArrayFixture", "assembly": "NestedArrayFixture",
        "class": "NestedArrayFixture",
        "ctor": [],
        "methods": [
            {"name": "SumNested", "params": ["array[array[i32]]"], "returns": "i32"},
            {"name": "MakeTriangle", "params": ["i32"], "returns": "array[array[i32]]"},
            {"name": "SumTwoNested", "params": ["array[array[i32]]", "array[array[i32]]"], "returns": "i32"},
            {"name": "ConcatNested", "params": ["array[array[str]]"], "returns": "str"},
        ],
    },
]


def main() -> "i32":
    obj = NestedArrayFixture()
    # Check 1: marshal DOI SO List<List<i32>> -> int32[][] - tong dung, ke
    # ca hang KHONG DEU do dai (jagged that su). List-literal TRUYEN THANG
    # (inline) tai vi tri doi so (giong idiom extern_class_array_marshal_
    # test.py's Check 1) - dtype ngu canh 'array[array[i32]]' buoc phan tu
    # la i32 THAT qua _compile_expr's want_dtype ngu canh, va _infer_dtype
    # tra None cho tag 'list_literal' boi hinh (AN TOAN bo qua guard check
    # actual!=want_list_dtype - xem docstring _compile_extern_object_arg).
    total = obj.SumNested([[1, 2], [3, 4, 5], [6]])
    print(total)
    # Check 2: marshal KET QUA int32[][] -> List<List<i32>> - kich thuoc
    # tam giac dung VA gia tri tung o dung cong thuc i*10+j (xac nhan thu
    # tu phan tu KHONG bi dao/lech chi so qua vong lap marshal).
    tri = obj.MakeTriangle(4)
    print(len(tri))
    row0 = tri[0]
    row3 = tri[3]
    print(len(row0))
    print(len(row3))
    print(row0[0])
    print(row3[0])
    print(row3[3])

    # Important 1a: 2 tham so 'array[array[i32]]' KHAC NHAU trong CUNG 1
    # loi goi - khoa hanh vi cac scratch-local marshal doi so KHONG bi
    # lan/de len nhau giua 2 vi tri doi so cung dtype 2 cap.
    two = obj.SumTwoNested([[1, 2], [3]], [[10], [20, 30]])
    print(two)

    # Important 1b: 2 loi goi LIEN TIEP nhan 'array[array[i32]]' trong
    # cung ham main - khoa hanh vi scratch-local tai su dung AN TOAN giua
    # 2 lan goi rieng biet (khong con gia tri cu ton du).
    call_a = obj.SumNested([[7, 7]])
    call_b = obj.SumNested([[1], [2], [3]])
    print(call_a)
    print(call_b)

    # Important 1c: 2 lan marshal KET QUA 'array[array[i32]]' LIEN TIEP -
    # khoa hanh vi vong lap marshal return tai su dung nhan/scratch-local
    # AN TOAN giua 2 lan goi return lien tiep.
    tri_a = obj.MakeTriangle(2)
    tri_b = obj.MakeTriangle(3)
    print(len(tri_a))
    print(len(tri_b))

    # Important 1d: 1 lan goi method nhan 'array[array[i32]]' BEN TRONG 1
    # vong lap while TokenVector - khoa hanh vi nhan/scratch-local marshal
    # AN TOAN qua nhieu lan lap (khong bi trung nhan IL hoac de gia tri).
    idx = 0
    loop_total = 0
    while idx < 3:
        loop_total = loop_total + obj.SumNested([[idx, idx + 1]])
        idx = idx + 1
    print(loop_total)

    # Important 2: 'array[array[str]]' - phan tu la reference-type (newarr
    # string[] khac newarr int32[]) di dung qua CUNG vong lap marshal.
    joined = obj.ConcatNested([["a", "bb"], ["c"]])
    print(joined)

    return 0
