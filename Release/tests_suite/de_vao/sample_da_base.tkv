"""Record DA BASE (Phase 3.1): class C(A, B) - base[0] la record that."""


class A:
    x: "i32"

    def __init__(self, x: "i32"):
        self.x = x

    def ta(self) -> "str":
        return "A" + str(self.x)


class B:
    y: "i32"

    def __init__(self, y: "i32"):
        self.y = y


class C(A, B):
    z: "i32"

    def __init__(self, x: "i32", y: "i32", z: "i32"):
        self.x = x
        self.y = y
        self.z = z


class D(C):
    w: "i32"

    def __init__(self, x: "i32", y: "i32", z: "i32", w: "i32"):
        self.x = x
        self.y = y
        self.z = z
        self.w = w


def demo_da_base() -> "i32":
    c = C(1, 2, 3)
    print(c.x + c.y + c.z)
    print(c.ta())
    d = D(4, 5, 6, 7)
    print(d.x + d.w)
    print(d.ta())
    return 0
