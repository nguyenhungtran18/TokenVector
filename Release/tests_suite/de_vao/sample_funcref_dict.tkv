# -*- coding: utf-8 -*-
"""Kiem chung dict[K, func(...)->...] - luu funcref vao dict roi goi qua
tra cuu key (BUGS_TODO.md muc bootstrap, Phase 3a / P5 self-host)."""


def add_one(x: "i32") -> "i32":
    return x + 1


def double(x: "i32") -> "i32":
    return x * 2


def run_dict_call() -> "str":
    registry: "dict[str, func(i32)->i32]" = {}
    registry["add_one"] = add_one
    registry["double"] = double
    a = registry["add_one"](5)
    b = registry["double"](5)
    return str(a) + "," + str(b)
