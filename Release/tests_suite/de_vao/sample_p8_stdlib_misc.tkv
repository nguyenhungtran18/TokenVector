def dung_datetime() -> "str":
    d = datetime()
    return str(datetime_ticks(d))


def dung_rmtree(duong_dan: "str") -> "str":
    # THAM SO, khong phai hang so: khong the vo tinh xoa mot duong dan that
    # neu ai do bien dich va chay file nay.
    ok = shutil_rmtree(duong_dan)
    return str(ok)


def dung_win_gui(tieu_de: "str") -> "str":
    w = show_native_winforms_gui(tieu_de)
    return str(w)
