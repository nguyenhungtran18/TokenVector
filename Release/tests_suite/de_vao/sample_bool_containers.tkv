def dict_vals() -> "str":
    d: "dict[str, bool]" = {}
    d["x"] = True
    d["y"] = 1 < 0
    return str(d["x"]) + str(d["y"]) + str(len(d))


def list_repr() -> "str":
    xs: "list[bool]" = [True, False, True]
    return str(xs)


def flag_tuple(n: "i32") -> "str":
    d: "dict[str, bool]" = {}
    d["a"] = n > 2
    flag = d["a"]
    t = (flag, n)
    a, b = t
    return str(t[0]) + str(t[1]) + str(a) + str(b)


def typed_local_in_tuple() -> "str":
    k: "i32" = 7
    t = (k, 1)
    return str(t[0]) + str(t[1])
