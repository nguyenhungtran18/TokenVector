# Mau cho path_builtins_test: MOI builtin path_* duoc goi that.
#
# Ket qua mong doi VIET TAY trong file test, KHONG lay tu CPython: hai ben
# co phan ky DA GHI NHAN (vd path_splitext('.bashrc') - .NET coi ca cum la
# duoi, Python coi la khong co duoi), nen lay CPython lam trong tai o day
# se che mat chinh cai can khoa.


def noi(a: "str", b: "str") -> "str":
    return path_join(a, b)


def ten_tep(p: "str") -> "str":
    return path_basename(p)


def thu_muc(p: "str") -> "str":
    return path_dirname(p)


def tach_duoi(p: "str") -> "str":
    g, e = path_splitext(p)
    return g + "|" + e


def chuan_hoa(p: "str") -> "str":
    return path_normpath(p)


def tuyet_doi(p: "str") -> "str":
    a = path_abspath(p)
    if len(a) > len(p):
        return "dai-hon"
    return "khong-dai-hon"


def kiem_ton_tai(p: "str") -> "str":
    r = ""
    if path_exists(p):
        r = r + "E"
    if path_isfile(p):
        r = r + "F"
    if path_isdir(p):
        r = r + "D"
    if r == "":
        return "khong"
    return r
