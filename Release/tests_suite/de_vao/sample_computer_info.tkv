def run_ram_info(a: "str") -> "str":
    info = SysInfo()
    free = info.AvailablePhysicalMemory
    total = info.TotalPhysicalMemory
    if free > 0 and total > 0 and total > free:
        return "ok"
    return "bad:" + str(free) + "/" + str(total)
