# Bao phu cho lo 1 cua P8 Task 3/4 (list_* sang arena).
#
# Vi sao can file nay: dem bao phu tren 166 file mau cho thay
# list.insert / list.sort / list.extend co DUNG 0 mau - cong IL se bao
# "giong het" ma khong he chay qua ba producer vua doi. Do dung la loi
# cong GIA-XANH da tai dien nam lan trong hai phien truoc.

def khoa_sap_xep(x: "i32") -> "i32":
    return 0 - x


def dung_list_methods(n: "i32") -> "str":
    xs = []
    xs.append(n)
    xs.append(n + 1)
    xs.append(n + 2)

    # insert: hai bieu thuc (index_node + value_node) trong cung mot cau lenh
    xs.insert(0, n + 9)
    xs.insert(1, n)

    ys = []
    ys.append(n + 5)
    ys.append(n + 4)

    # extend: tham so PHAI la mot ten bien don
    xs.extend(ys)

    # remove + reverse
    xs.remove(n)
    xs.reverse()

    # sort ba dang: tran, reverse=True, va key=<ham>
    xs.sort()
    zs = []
    zs.append(n + 3)
    zs.append(n)
    zs.sort(reverse=True)
    ws = []
    ws.append(n + 7)
    ws.append(n + 6)
    ws.sort(key=khoa_sap_xep)

    out = ""
    for v in xs:
        out = out + str(v) + ","
    out = out + "|"
    for v in zs:
        out = out + str(v) + ","
    out = out + "|"
    for v in ws:
        out = out + str(v) + ","
    return out
