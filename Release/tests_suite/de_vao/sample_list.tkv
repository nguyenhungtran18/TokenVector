"""Vi du THAT kiem chung List dong (System.Collections.Generic.List<T>)
vua them vao il_codegen.py: [], .append(), [i] doc, len()."""


def sum_scaled(n: "i32") -> "f32":
    lst = []
    i = 0.0
    while i < n:
        lst.append(i * 1.5)
        i = i + 1.0
    total = 0.0
    for j in range(len(lst)):
        total = total + lst[j]
    return total
