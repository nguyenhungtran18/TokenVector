def walrus_in_if(n: "i32") -> "i32":
    if (x := n * 2) > 10:
        return x
    return -1


def walrus_reassign(n: "i32") -> "i32":
    total = 0
    i = 0
    while (i := i + 1) <= n:
        total = total + i
    return total


def walrus_new_var(n: "i32") -> "i32":
    y = (z := n + 1) * (z + 1)
    return y
