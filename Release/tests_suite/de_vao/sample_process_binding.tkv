def run_find_and_sleep(a: "str") -> "str":
    procs = Process.GetProcesses()
    count = len(procs)
    win_sleep(50)
    if count > 0:
        p = procs[0]
        name = p.ProcessName
        ws = p.WorkingSet64
        pid = p.Id
        return "ok:" + str(count)
    return "empty"
