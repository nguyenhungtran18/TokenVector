# -*- coding: utf-8 -*-
"""Bo dieu phoi hoi quy SONG SONG, viet bang TokenVector.

Khac `run_tests.tkv` (tuan tu) o DUNG mot diem: chia bai ra nhieu luong.
Moi thu khac giu y nguyen de hai ban doi chieu duoc voi nhau.

VI SAO AN TOAN (da do, khong phong doan): quet TOAN BO 265 bai tim cac
duong dan GHI CO DINH (dan tu ROOT/HERE, khong nam trong thu muc tam).
Ket qua: 382 bieu thuc duong dan co dinh, chi 5 cai bi DUNG CHUNG boi hon
mot bai, gom thanh 4 NHOM / 12 bai:

    tkvcalc.exe          <- tkvcalc_test, tkvcalc_ast_test
    sample_json_*.exe    <- json_test, json_dumps_test
    sample_set_*.exe     <- set_test, set_annotation_test
    <tmv_name>.exe       <- 6 bai extern_class_* / list_handle_type_* /
                            toplevel_callback_typeinfer

Cac bai KHAC deu ghi vao `tempfile.TemporaryDirectory()` rieng - da kiem
tung bai, khong phai suy doan. (Lan do TRUOC day ket luan "17 bai va cham"
la SAI: no khop TEN TEP ma khong xem THU MUC, nen `program.exe` - von nam
trong thu muc tam rieng cua tung bai - bi dem nham la va cham.)

Nen phep chia lo chi can: **moi NHOM va cham nam tron trong MOT lo**.

VAN KHONG PHAI CONG. Khong chung minh duoc la khong con va cham nao khac
(duong dan dung dong, bien moi truong...). Dung ban nay de DO NHANH trong
luc lam; truoc khi commit van chay `run_tests.exe` tuan tu.

Cach dung:  run_tests_ss.exe            # SO_LO luong
"""

SO_LO = 8
THU_MUC = "test\\verify"
THU_MUC_TAM = "_scratch\\ra_test_ss"
TEP_KQ = "test\\verify\\_results_ss.json"


def la_bai_test(ten: "str") -> "i32":
    if not ten.endswith("_test.py"):
        return 0
    if ten.startswith("_"):
        return 0
    return 1


def ten_ngan(duong: "str") -> "str":
    vi = duong.rfind("\\")
    if vi >= 0:
        return duong[vi + 1:]
    return duong


def nhom_va_cham(ten: "str") -> "str":
    """Ten NHOM de chia lo. Cac bai ghi de len cung mot duong dan co dinh
    phai tra ve CUNG mot ten nhom -> chung roi vao cung mot lo -> chay noi
    tiep nhau, khong dam nhau. Bai khong va cham thi nhom la chinh no."""
    if ten.startswith("tkvcalc"):
        return "g_tkvcalc"
    if ten == "json_test.py" or ten == "json_dumps_test.py":
        return "g_json"
    if ten == "set_test.py" or ten == "set_annotation_test.py":
        return "g_set"
    if ten == "extern_class_dict_iteration_test.py":
        return "g_tmv"
    if ten == "extern_class_dict_negative_test.py":
        return "g_tmv"
    if ten == "extern_class_list_of_list_test.py":
        return "g_tmv"
    if ten == "list_handle_type_functional_test.py":
        return "g_tmv"
    if ten == "list_handle_type_reject_test.py":
        return "g_tmv"
    if ten == "toplevel_callback_typeinfer_test.py":
        return "g_tmv"
    return ten


def lo_cua_nhom(g: "str") -> "i32":
    """Lo CO DINH cho tung nhom va cham; -1 neu khong thuoc nhom nao.

    Khong bam chuoi (`ord` chua co o trinh bien dich), va cung khong can:
    chi co 4 nhom, gan cung lo la du va DE KIEM hon."""
    if g == "g_tkvcalc":
        return 0
    if g == "g_json":
        return 1
    if g == "g_set":
        return 2
    if g == "g_tmv":
        return 3
    return -1


def chay_lo(lo: "i32") -> "i64":
    """Chay moi bai thuoc lo nay. Ghi ket qua ra tep rieng cua lo (khong co
    trang thai dung chung giua cac luong), tra ve so bai TRUOT."""
    ds = os_list_files(THU_MUC)
    ra = ""
    truot = 0
    thu_tu = 0
    i = 0
    while i < len(ds):
        duong = ds[i]
        ten = ten_ngan(duong)
        if la_bai_test(ten) == 1:
            # Chia lo TAT DINH: moi luong duyet CUNG mot danh sach da sap
            # xep va tinh ra cung ket qua, nen khong can trang thai chung.
            lo_g = lo_cua_nhom(nhom_va_cham(ten))
            lo_cua_bai = lo_g
            if lo_g < 0:
                lo_cua_bai = thu_tu % SO_LO
                thu_tu = thu_tu + 1
            if lo_cua_bai == lo:
                out_f = THU_MUC_TAM + "\\" + ten + ".out"
                ma = proc_ra("python", "\"" + duong + "\"", out_f)
                if ma == 0:
                    print("  DAT   " + ten)
                else:
                    print("  TRUOT " + ten)
                    truot = truot + 1
                ra = ra + ten + "|" + str(ma) + "\n"
        i = i + 1
    write_file(THU_MUC_TAM + "\\lo" + str(lo) + ".txt", ra)
    return truot


def lo0() -> "i64":
    return chay_lo(0)


def lo1() -> "i64":
    return chay_lo(1)


def lo2() -> "i64":
    return chay_lo(2)


def lo3() -> "i64":
    return chay_lo(3)


def lo4() -> "i64":
    return chay_lo(4)


def lo5() -> "i64":
    return chay_lo(5)


def lo6() -> "i64":
    return chay_lo(6)


def lo7() -> "i64":
    return chay_lo(7)


def main() -> "i32":
    _bo = os_mkdir(THU_MUC_TAM)
    t0 = datetime_ticks(datetime())
    a0 = thread_spawn(lo0)
    a1 = thread_spawn(lo1)
    a2 = thread_spawn(lo2)
    a3 = thread_spawn(lo3)
    a4 = thread_spawn(lo4)
    a5 = thread_spawn(lo5)
    a6 = thread_spawn(lo6)
    a7 = thread_spawn(lo7)
    truot = thread_join(a0)
    truot = truot + thread_join(a1)
    truot = truot + thread_join(a2)
    truot = truot + thread_join(a3)
    truot = truot + thread_join(a4)
    truot = truot + thread_join(a5)
    truot = truot + thread_join(a6)
    truot = truot + thread_join(a7)
    t1 = datetime_ticks(datetime())
    ms = (t1 - t0) // 10000
    # Gop ket qua tung lo lai thanh mot bao cao
    dong = []
    k = 0
    while k < SO_LO:
        noi = read_file(THU_MUC_TAM + "\\lo" + str(k) + ".txt")
        for d in noi.split("\n"):
            if d != "":
                dong.append(d)
        k = k + 1
    print("")
    print("=== TRUOT " + str(truot) + " / " + str(len(dong))
          + " bai  (" + str(ms // 1000) + "s) ===")
    if truot > 0:
        print("")
        print("TRUOT:")
        k = 0
        while k < len(dong):
            d = dong[k]
            vi = d.rfind("|")
            if vi > 0:
                if d[vi + 1:] != "0":
                    print("  " + d[0:vi])
            k = k + 1
    js = ""
    k = 0
    while k < len(dong):
        d = dong[k]
        vi = d.rfind("|")
        if vi > 0:
            tt = "fail"
            if d[vi + 1:] == "0":
                tt = "pass"
            if js != "":
                js = js + ",\n"
            js = js + "  {\"name\": \"" + d[0:vi] + "\", \"status\": \"" + tt + "\"}"
        k = k + 1
    write_file(TEP_KQ, "{\n \"tests\": [\n" + js + "\n ]\n}\n")
    print("")
    print("Chi tiet: " + TEP_KQ)
    print("CANH BAO: ban SONG SONG - dung de do nhanh, KHONG thay cong.")
    if truot > 0:
        sys_exit(1)
    sys_exit(0)
    return 0
