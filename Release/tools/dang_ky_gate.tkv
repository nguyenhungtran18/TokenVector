# -*- coding: utf-8 -*-
"""Cong do "da dang ky day du" cua nguon compiler TokenVector.

Chuyen tu `dang_ky_gate.py` sang TokenVector (2026-10-12). Ban Python dung
`ast.parse` + `ast.walk`; ban nay phan tich VAN BAN theo LE THUT. TokenVector
khong co module `ast` va dung `ast` thi phai chay CPython - trai yeu cau repo
nay sach hoan toan khi TokenVector da tu host.

Tieu chi - do bang PROBE TRUC TIEP vao `dist/tkvc-tv.exe`, khong tin tai lieu:

  A. def co `-> "kieu"`                      -> dang ky day du
  B. def thieu chu ky nhung CHI `return`     -> hop le (ham void)
  C. def thieu chu ky MA co `return <giatri>`-> VI PHAM

Compiler BO QUA hoan toan hai co che CPython (gia tri True hay False deu bi
bo qua - da kiem chung bang probe):
  * `if __tkv_chi_cpython__:` ... - bo qua ca khoi
  * `@__tkv_cpython_only__`       - bo qua ham co decorator nay

Cach dung (tu goc repo):
    dist\\tkvc-tv.exe tools\\dang_ky_gate.tkv <out.exe> run
    dist\\tkvc-tv.exe tools\\dang_ky_gate.tkv <out.exe> run --quiet

Exit 0 = khong con ham nao thieu dang ky day du.
"""


def _bcat_comment(s: "str") -> "str":
    """Cat phan comment `#...` o CUOI dong (bo qua `#` nam trong chuoi).

    Bat buoc: `return   # ghi chu` la `return` TRONG, nhung cat thoi co `s[7:]`
    khac rong -> quet nham no la `return <bieu thuc>` va bao sai vi pham."""
    q = 0
    i = 0
    while i < len(s):
        c = s[i]
        if q == 1:
            if c == chr(34):
                q = 0
        elif c == chr(34):
            q = 1
        elif c == "#":
            return s[0:i]
        i = i + 1
    return s


def _dem(s: "str", sub: "str") -> "i32":
    n = 0
    k = 0
    while k >= 0 and k < len(s):
        k = s.find(sub, k)
        if k < 0:
            break
        n = n + 1
        k = k + 1
    return n


def _danh_dau_docstring(lines: "list[str]") -> "list[str]":
    """Danh dau dong nao nam TRONG chuoi ba dau (3 dau trich dan). Mot LAN QUET.

    Can cho cac dong prose trong docstring - vi du dong
    `def long long nhau (nested-nested);` trong mo ta cua closures.tkv KHONG
    phai dinh nghia ham nhung van khop tien to `def `.

    Luu y: dong MO va dong DONG deu duoc danh dau (no cung la noi dung chuoi,
    chi khac la chua co noi dung nghia). Chi chuoi ba dau tren cung mot dong
    (docstring mot dong) thi KHONG danh dau."""
    ra: "list[str]" = []
    q = chr(34) + chr(34) + chr(34)
    trong = 0
    for ln in lines:
        c = _dem(ln, q)
        if trong == 1:
            ra.append("1")
            if c >= 1:
                trong = 0
            continue
        if c == 1:
            ra.append("1")
            trong = 1
            continue
        ra.append("0")
    return ra


def _indent(ln: "str") -> "i32":
    n = 0
    while n < len(ln):
        if ln[n] != " " and ln[n] != chr(9):
            break
        n = n + 1
    return n


def _dong_def(ln: "str") -> "bool":
    s = _bcat_comment(ln).strip()
    if not s.startswith("def "):
        return 0
    r = s[4:]
    if r == "":
        return 0
    c = r[0]
    if c == "(" or c == chr(34):
        return 0
    return 1


def _ten_ham(s: "str") -> "str":
    r = s[4:]
    k = r.find("(")
    if k < 0:
        return ""
    return r[0:k].strip()


def _sau_khoi_if_cp(lines: "list[str]", i: "i32") -> "i32":
    """So dong cua khoi `if __tkv_chi_cpython__:` bat dau tai dong `i`.

    Tra -1 neu dong `i` khong phai dong mo khoi do. Do dai xac dinh bang
    THUT LEN: moi dong tiep theo thuoc khoi neu indent > indent dong `i`;
    dong nao co indent <= thi khoi ket thuc."""
    s = lines[i].strip()
    if not s.startswith("if "):
        return -1
    if s.find("__tkv_chi_cpython__") < 0:
        return -1
    ind = _indent(lines[i])
    n = i + 1
    while n < len(lines):
        ln = lines[n]
        if ln.strip() != "" and _indent(ln) <= ind:
            break
        n = n + 1
    return n


def _chu_ky(lines: "list[str]", i: "i32") -> "str":
    """Chu ky `def ...(...)` gon lai 1 dong (chu ky co the xuong dong).

    Gom cac dong toi khi so ngoac tron bang 0 VA dong do ket thuc bang `:`."""
    buf = ""
    depth = 0
    j = i
    while j < len(lines):
        p = _bcat_comment(lines[j]).strip()
        buf = buf + p + " "
        k = p.find("(")
        if k >= 0:
            depth = depth + p[k:].count("(") - p[k:].count(")")
        if depth <= 0 and buf.strip().endswith(":"):
            break
        j = j + 1
        if j - i > 12:
            break
    return buf


def _tra_ve_gia_tri(lines: "list[str]", i: "i32", ind_def: "i32") -> "bool":
    """True neu co `return <bieu thuc>` o than ham, BO QUA moi ham long.

    Ham long duoc bo qua bang thut len: gap dong `def ` thuoc than thi nhay
    toi khi indent quay lai <= indent dong do. Day thay the `ast.walk` co
    loai tru `FunctionDef` trong ban Python - `ast.walk` KHONG lam duoc, no
    van descend vao cay con cua nested FunctionDef."""
    j = i + 1
    n = len(lines)
    while j < n:
        ln = lines[j]
        s = _bcat_comment(ln).strip()
        if s != "" and _indent(ln) <= ind_def:
            break
        if s.startswith("def "):
            ind_n = _indent(ln)
            j = j + 1
            while j < n:
                l2 = lines[j]
                if l2.strip() != "" and _indent(l2) <= ind_n:
                    break
                j = j + 1
            continue
        if s.startswith("return "):
            r = s[7:].strip()
            if r != "":
                return 1
        j = j + 1
    return 0


def _thieu_tham_so(chu_ky: "str") -> "list[str]":
    """Tham so trong `chu_ky` thieu chu ky kieu (tru `self`/`cls` dau tien)."""
    ra: "list[str]" = []
    a = chu_ky.find("(")
    if a < 0:
        return ra
    b = chu_ky.find(")", a)
    if b < 0:
        return ra
    inner = chu_ky[a + 1:b]
    # tach theo dau phay cap 0
    depth = 0
    cur = ""
    i = 0
    parts: "list[str]" = []
    q = 0
    while i < len(inner):
        c = inner[i]
        if q == 1:
            if c == chr(34):
                q = 0
        elif c == chr(34):
            q = 1
        elif c == "(" or c == "[" or c == "{":
            depth = depth + 1
        elif c == ")" or c == "]" or c == "}":
            depth = depth - 1
        elif c == "," and depth == 0:
            parts.append(cur)
            cur = ""
            i = i + 1
            continue
        cur = cur + c
        i = i + 1
    parts.append(cur)
    first = 1
    for p in parts:
        t = p.strip()
        if t == "":
            continue
        c2 = t.find(":")
        ten = ""
        if c2 >= 0:
            ten = t[0:c2].strip()
        else:
            ten = t
        if first == 1 and (ten == "self" or ten == "cls"):
            first = 0
            continue
        first = 0
        if c2 < 0:
            ra.append(ten)
    return ra


def quet_file(rel: "str", p: "str") -> "list[str]":
    """Dong ket qua 'R|n_ok|n_void|n_dec|n_blk|rel|dong|ten|thieu' cho 1 file."""
    ra: "list[str]" = []
    src = path_read_text(p)
    lines = src.split(chr(10))
    n = len(lines)
    trong_doc = _danh_dau_docstring(lines)
    # 1) danh dau khoi `if __tkv_chi_cpython__:`
    trong_khoi: "list[str]" = []
    i = 0
    while i < n:
        x = _sau_khoi_if_cp(lines, i)
        if x < 0:
            i = i + 1
            continue
        j = i + 1
        while j < x:
            trong_khoi.append(str(j + 1))
            j = j + 1
        i = x
    n_ok = 0
    n_void = 0
    n_dec = 0
    n_blk = 0
    n_def = 0
    i = 0
    while i < n:
        if trong_doc[i] == "1":
            i = i + 1
            continue
        if _dong_def(lines[i]) == 1:
            n_def = n_def + 1
            ind = _indent(lines[i])
            chu_ky = _chu_ky(lines, i)
            dong = str(i + 1)
            if chu_ky.find("->") >= 0:
                n_ok = n_ok + 1
                i = i + 1
                continue
            # decorator @__tkv_cpython_only__ o dong truoc `def`
            co_dec = 0
            if i > 0 and lines[i - 1].strip().find("__tkv_cpython_only__") >= 0:
                co_dec = 1
            if co_dec == 1:
                n_dec = n_dec + 1
                i = i + 1
                continue
            if _trong(dong, trong_khoi) == 1:
                n_blk = n_blk + 1
                i = i + 1
                continue
            if _tra_ve_gia_tri(lines, i, ind) == 1:
                ra.append("C|" + rel + "|" + dong + "|" + _ten_ham(lines[i].strip()))
            else:
                n_void = n_void + 1
            thieu = _thieu_tham_so(chu_ky)
            if len(thieu) > 0:
                ss = ""
                k = 0
                while k < len(thieu):
                    if k > 0:
                        ss = ss + ","
                    ss = ss + thieu[k]
                    k = k + 1
                ra.append("A|" + rel + "|" + dong + "|" + _ten_ham(lines[i].strip()) + "|" + ss)
        i = i + 1
    # dong tong hop de run() cong di - ham con lai day la bien cuc bo
    ra.append("S|" + rel + "|" + str(n_def) + "|" + str(n_ok) + "|" + str(n_void) + "|" + str(n_dec) + "|" + str(n_blk))
    return ra


def _trong(dong: "str", ds: "list[str]") -> "i32":
    i = 0
    while i < len(ds):
        if ds[i] == dong:
            return 1
        i = i + 1
    return 0


def run() -> "i32":
    ds_txt = "compiler_src/ds_gop.txt"
    argv = sys_argv()
    quiet = 0
    ai = 1
    while ai < len(argv):
        if argv[ai] == "--quiet":
            quiet = 1
        ai = ai + 1
    ds = path_read_text(ds_txt).split(chr(10))
    n_def = 0
    n_ok = 0
    n_void = 0
    n_dec = 0
    n_blk = 0
    n_ds = 0
    vi_pham: "list[str]" = []
    thieu: "list[str]" = []
    loi_parse: "list[str]" = []
    for rel in ds:
        r = rel.strip()
        if r == "":
            continue
        n_ds = n_ds + 1
        if not path_exists(r):
            loi_parse.append(r + ": KHONG TON TAI")
            continue
        for x in quet_file(r, r):
            a = x.split("|")
            if a[0] == "C":
                vi_pham.append(x)
            elif a[0] == "A":
                thieu.append(x)
            else:
                n_def = n_def + int(a[2])
                n_ok = n_ok + int(a[3])
                n_void = n_void + int(a[4])
                n_dec = n_dec + int(a[5])
                n_blk = n_blk + int(a[6])
    if quiet == 0:
        print("=== " + str(n_ds) + " file / " + str(n_def) + " ham tren duong TokenVector ===")
        print("  A. co `-> \"kieu\"`                   : " + str(n_ok))
        print("  B. void (thieu chu ky, chi return)  : " + str(n_void) + "  HOP LE")
        print("     bo qua " + str(n_dec) + " ham @__tkv_cpython_only__ + " + str(n_blk) + " ham trong khoi `if`")
        gach = ""
        gi = 0
        while gi < 56:
            gach = gach + "-"
            gi = gi + 1
        print("  " + gach)
        print("  A + B  DA DANG KY DAY DU            : " + str(n_ok + n_void))
        print("")
        print("  VI PHAM (thieu chu ky + tra ve gia tri): " + str(len(vi_pham)))
        for x in vi_pham:
            a = x.split("|")
            print("     " + a[1] + " :" + a[2] + " " + a[3])
        print("  thieu chu ky tham so (tru self)        : " + str(len(thieu)))
        for x in thieu:
            a = x.split("|")
            print("     " + a[1] + " :" + a[2] + " " + a[3] + "(" + a[4] + ")")
        if len(loi_parse) > 0:
            print("")
            print("  FILE LOI:")
            for x in loi_parse:
                print("     " + x)
        print("")
    sai = len(vi_pham) + len(thieu) + len(loi_parse)
    if quiet == 0:
        print("GATE: " + ("PASS" if sai == 0 else "FAIL"))
    return 0 if sai == 0 else 1


def _dem_def(p: "str") -> "i32":
    n = 0
    for ln in path_read_text(p).split(chr(10)):
        if _dong_def(ln) == 1:
            n = n + 1
    return n