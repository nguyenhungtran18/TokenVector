# -*- coding: utf-8 -*-
# Kernel do hieu nang cho perf_gate.ps1 - f64 matmul 32^3.
# CHINH XAC kieu du lieu nhu benchmark/benchmark: list[f64], chi so tinh.
def _zeros(n: "i32") -> "list[f64]":
    out = []
    i = 0
    while i < n:
        out.append(0.0)
        i = i + 1
    return out


def _mm(a: "list[f64]", b: "list[f64]", r: "list[f64]", n: "i32") -> "i32":
    i = 0
    while i < n:
        j = 0
        while j < n:
            s = 0.0
            kk = 0
            while kk < n:
                s = s + a[i * n + kk] * b[kk * n + j]
                kk = kk + 1
            r[i * n + j] = s
            j = j + 1
        i = i + 1
    return 0


def main() -> "i32":
    reps = 20
    n = 32
    m = n * n
    a = _zeros(m)
    b = _zeros(m)
    r = _zeros(m)
    i = 0
    while i < m:
        a[i] = ((i % 7) - 3.0)
        i = i + 1
    i = 0
    while i < m:
        b[i] = ((i % 5) - 2.0)
        i = i + 1
    k = 0
    cs = 0.0
    while k < reps:
        _mm(a, b, r, n)
        cs = 0.0
        i = 0
        while i < m:
            cs = cs + r[i]
            i = i + 1
        k = k + 1
    print("sum=" + str(cs))
    return 0