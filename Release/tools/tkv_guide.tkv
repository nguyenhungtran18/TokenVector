# -*- coding: utf-8 -*-
# tkv_guide - CONG CU DE HARNESS (agent) viet code TokenVector nhanh va DUNG.
# Day la NGUON DUY NHAT (truoc day con ban Python tools/tkv_guide.py - da
# xoa 2026-10-02 vi hai ban troi lech nhau: ban Python con luat "str() chi
# nhan bien" trong khi probe chung minh str() nhan moi bieu thuc).
#
# ## VAO TRO
# "Nhac" agent: luat nao THAT su gay loi, cu phap cua tung ham, va bat loi
# ma bien dich BO QUA. Khong de agent doan.
#
# ## CACH XAY DUNG
#   powershell -NoProfile -File tools\build_tkv_guide.ps1
# (roi goi dist\tkv_guide.exe). File .tkv nen giu lai de doc/diff; exe thi
# gitignore.
#
# ## VERIFY - TAI SAO KHONG LAM DUOC O DAY
# `verify` phai BIEN DICH roi CHAY .tkv, ma TokenVector chua co khoi dong
# tien trinh khac (subprocess) -> khong goi duoc tkvc.exe, cung khong chup
# duoc stdout. Nen `verify` CHI IN DUNG 2 LENH can chay. Bat buoc chay ca
# hai va doc exit code + output.
#
# ## DUNG --file KHI CAN DOC BANG MAY
# `print` cua TokenVector di qua System.Console::WriteLine, va khi stdout bi
# redirect thi .NET mac dinh ghi ra **UTF-16LE**, nen PowerShell 5.1 hien thi
# chu co dau thanh ra `?`. Noi dung thi dung, byte thi dung, chi hien thi sai.
# `--file <duong-dan>` ghi bang `path_write_text` (UTF-8) de doc khong can lo.
#
# ## GHI CHU KHI VIET BANG TOKENVECTOR (da probe, khong doan)
# - Hang so cap module KHONG doc duoc trong ham: chi `i32` global hoat dong,
#   `G: "str" = "x"` -> "bien 'G' chua duoc khai bao/tham so". Nen moi
#   chuoi ky tu dung NOI TRONG ham (`nl = chr(10)`).
# - TokenVector khong co escape trong chuoi nen dung `chr(39)` / `chr(34)` /
#   `chr(92)` thay cho `'` / `"` / `\`.
# - `re_search(pattern, s)` -> i32 0/1, thu tu NGUOC Python, KHONG tu them '^'.
# - `re_findall` tra ve **ca match**, khong phai group: dung `.find()` + slicing.
# - Regex cua .NET: `\p` la escape Unicode nen `\.pop` se NO, va `[(]`/`[)]`
#   an toan hon `\(`/`\)`. Moi luat lint deu co positive test o
#   tools\lint_fixtures\ + tools\lint_rules_gate.ps1.

# --- Compiler TokenVector-that (dang xay dung) ---
# Neu ban sua compiler: doc 	ools/compiler_tkv/README.md truoc. Day la
# phan compiler viet bang TokenVector THAT (khong phai Python),
# dang thay the tu dan chung cho st.parse.

def _nl() -> "str":
    return chr(10)


def _q() -> "str":
    return chr(39)


def _bs() -> "str":
    return chr(92)


def _dq() -> "str":
    return chr(34)


def _emit(buf: "str", out_file: "str") -> "i32":
    """In ra console, hoac ghi file UTF-8 khi co --file."""
    if out_file != "":
        path_write_text(out_file, buf)
        print("Da ghi: " + out_file)
        return 0
    print(buf)
    return 0


# ------------------------------------------------------------------ duong dan

def ref_path() -> "str":
    """Tim `docs/REFERENCE.md`. Thu tu EXE dang chay, roi thu muc hien hanh -
    de chay duoc ca khi copy exe ra cho."""
    argv = sys_argv()
    if len(argv) > 0:
        here = path_dirname(argv[0])
        c1 = path_join(path_dirname(here), "docs/REFERENCE.md")
        if file_exists(c1):
            return c1
        c2 = path_join(here, "docs/REFERENCE.md")
        if file_exists(c2):
            return c2
    if file_exists("3.code/docs/REFERENCE.md"):
        return "3.code/docs/REFERENCE.md"
    if file_exists("docs/REFERENCE.md"):
        return "docs/REFERENCE.md"
    return ""


def feat_dir() -> "str":
    """Tim thu muc module cua compiler TOKENVECTOR.

    2026-10-12 (tach repo): `compiler/` da sang submodule `compiler_py/`. Ban
    do dat sai o day nen tu dong dat vao 1 CA BA thu muc khong ton tai - `names`
    in "KHONG tim thay compiler/il_features/ - hay chay tu trong repo 3.code".
    Thu muc dung la `compiler_bootstrap/compiler/il_features` (cung nguon voi
    `tools/dang_ky_gate.py` qua `compiler_src/ds_gop.txt`).

    `3.code/` va `compiler/` giu lai chi de doc loi cu o ban build cao hon -
    CA BA thu muc deu khong ton tai o repo hien tai."""
    argv = sys_argv()
    if len(argv) > 0:
        here = path_dirname(argv[0])
        d1 = path_join(path_dirname(here), "compiler_bootstrap/compiler/il_features")
        if path_isdir(d1):
            return d1
    if path_isdir("compiler_bootstrap/compiler/il_features"):
        return "compiler_bootstrap/compiler/il_features"
    if path_isdir("3.code/compiler/il_features"):
        return "3.code/compiler/il_features"
    return ""


def tmp_dir() -> "str":
    t = os_getenv("TEMP")
    if t == "":
        return "."
    return t


def help() -> "i32":
    nl = _nl()
    dq = _dq()
    print("tkv_guide - nguon duy nhat, viet bang TokenVector" + nl)
    print(nl)
    print("  tkv_guide rules                     # 16 luat THAT su gay loi")
    print("  tkv_guide find <tu khoa>            # cu phap + tinh nang that")
    print("  tkv_guide names <loc>               # builtin theo module")
    print("  tkv_guide lint <file.tkv>           # bat loi bien dich BO QUA")
    print("  tkv_guide verify <file.tkv>         # in 2 lenh build + chay")
    print(nl)
    print("Them --file <duong-dan> o cuoi bat ky lenh nao de ghi ket qua ra file")
    print("UTF-8 (console Windows ghi UTF-16, PowerShell 5.1 hien sai chu co dau).")
    print(nl)
    print("Tai lieu day du: 3.code/docs/REFERENCE.md")
    print("Build lai tool:  powershell -File tools/build_tkv_guide.ps1")
    print(nl)
    print("Ghi chu: TokenVector chua co subprocess nen `verify` KHONG tu bien dich")
    print("duoc - no in ra 2 lenh, harness phai chay ca hai va doc exit code.")
    return 0


# ------------------------------------------------------------------- rules

def build_rules() -> "str":
    nl = _nl()
    dq = _dq()
    b = ""
    b = b + "# TokenVector - 16 luat THAT su gay loi" + nl + nl
    b = b + "1. BUILD XANH KHNG co nghia la DUNG. LUON `verify` truoc khi noi xong." + nl
    b = b + "   3 bug trong REPOSITORY-NOTES bien dich thanh cong roi HONG LUC CHAY," + nl
    b = b + "   2 tra ve KET QUA SAI ma khong loi gi. Compiler chi chan cai no BIET." + nl
    b = b + "2. LOCAL trong ham KHNG duoc annotate kieu: x: " + dq + "i32" + dq + " = 1 -> loi" + nl
    b = b + "   bien dich. Chi g/list/dict/func moi duoc tuong minh; local: x = 1" + nl
    b = b + "3. CAP MODULE KHNG CO bien nao. Chi: def, class, hang so, bien global co kieu" + nl
    b = b + "   vo huong (counter: " + dq + "i32" + dq + " = 0). xs = [1,2,3] bi tu choi." + nl
    b = b + "   HANG SO module kieu " + dq + "str" + dq + " doc trong ham se BIEN DICH FAIL" + nl
    b = b + "   (chi i32 global hoat dong) -> viet bieu thuc trong ham: s = chr(10)" + nl
    b = b + "4. str(x) NHAN MOI BIEU THUC: str(a + b), str(len(xs) + 1), str(xs[0])," + nl
    b = b + "   str(x > 0) deu chay dung (da probe 10/10). CHI fmt_float(v, n) moi" + nl
    b = b + "   BAT BUOC v la 1 bien don: fmt_float(7.0, 2) va fmt_float(a + b, 2)" + nl
    b = b + "   deu bi tu choi luc bien dich." + nl
    b = b + "5. Method chi goi tren BIEN, khong tren literal/bieu thuc:" + nl
    b = b + "   " + dq + ", " + dq + ".join(xs) -> loi bien dich." + nl
    b = b + "6. Method container la LENH DOC LAP, khong phai bieu thuc:" + nl
    b = b + "   xs.append(v) mot dong; y = xs.pop() -> loi bien dich." + nl
    b = b + "   Thay bang y = xs[len(xs) - 1]" + nl
    b = b + "7. Chuoi: nhay kep don HOAC 3 nhay kep deu duoc (da probe). Noi bang + str(v)." + nl
    b = b + "   TokenVector KHNG co escape nen dung chr(39) / chr(34) / chr(92)" + nl
    b = b + "8. f-string VA .format() cung DUOC (co test trong Testkit):" + nl
    b = b + "   f" + dq + "{n}" + dq + "   f" + dq + "{n:05d}" + dq + "   f" + dq + "{v:.2f}" + dq + nl
    b = b + "   " + dq + "{}" + dq + ".format(x)   " + dq + "{0}+{1}" + dq + ".format(a, b)" + nl
    b = b + "   CHI HAM format(v, spec) co rang buoc: spec phai literal, value phai bien." + nl
    b = b + "9. next(it, default): default phai CUNG dtype phan tu, khong tu nang rong" + nl
    b = b + "   kieu. Mot bien mot kieu." + nl
    b = b + "10. StopIteration va RuntimeError LA MOT CLR type, nen except RuntimeError:" + nl
    b = b + "    se BAT ca StopIteration. Kiem tra het du lieu bang next(it, default)." + nl
    b = b + "11. sort(key=)/sorted(key=) KHNG on dinh khi trung khoa (khac Python)." + nl
    b = b + "12. FIELD container cua record: uu tien list[int]. .ctor BO QUA field container" + nl
    b = b + "    nen phai gan ben ngoai: it = It(0) roi it.src = xs. Field list[i32] +" + nl
    b = b + "    list literal -> co the doc ra GIA TRI SAI ma build van xanh." + nl
    b = b + "13. int() tran o tren int32 (OverflowException). Dung int64(x)." + nl
    b = b + "14. hash() KHAC Python (FNV-1a, o dinh): duoc lam khoa, KHNG khop so voi Python." + nl
    b = b + "15. iter() chi o VI TRI GAN: it = iter(xs). next(iter(xs)) -> loi bien dich." + nl
    b = b + "    Nguon: list/set/frozenset/dict(khoa)/str(1 ky tu). KHONG dung tuple." + nl
    b = b + "16. open(p, mode) thi PHAI close(). Da sua loi khoa file 2026-10-02, nhung" + nl
    b = b + "    handle open() tra ve khong tu dong dong; with open(...) thi tu Dispose." + nl
    b = b + nl + "Cu phap/tinh nang CHI DAT cua tung ham: tkv_guide find <ten>" + nl
    return b


# -------------------------------------------------------------------- find

def build_find(query: "str") -> "str":
    nl = _nl()
    rp = ref_path()
    if rp == "":
        return "KHONG tim thay docs/REFERENCE.md - hay chay tu trong repo 3.code" + nl
    txt = path_read_text(rp)
    lines = txt.split(nl)
    ql = query.lower()
    head = ""
    shown = 0
    exact = 0
    b = "# Tra cuu REFERENCE.md: " + query + nl + nl
    i = 0
    n = len(lines)
    while i < n:
        line = lines[i]
        if line.startswith("## "):
            head = line
        if line.startswith("|"):
            if line.lower().find(ql) >= 0:
                cells = line.split("|")
                name = cells[1]
                name = name.strip()
                name = name.replace("`", "")
                shown = shown + 1
                if name.lower() == ql:
                    exact = exact + 1
                    b = b + head + nl
                    b = b + "   [TRUNG TEN] " + name + nl
                    b = b + "   " + line + nl + nl
                else:
                    if exact < 20:
                        b = b + "   " + line + nl
        i = i + 1
    if shown == 0:
        b = b + "KHONG co dong bang nao chua " + query + "." + nl
        b = b + "Thu tieu de khac: tkv_guide names " + query + nl
    else:
        if exact == 0:
            b = b + "(" + str(shown) + " dong chua chuoi can tim; KHONG co dong ten" + nl
            b = b + " TRUNG KHAO. Xem `find <ten>` rut gon hon.)" + nl
    return b


# ------------------------------------------------------------------- names

def _names_of(body: "str") -> "str":
    """Ten builtin trong 1 module, tach bang dau cach.

    2026-10-12: compiler TokenVector goi `register_expr_builtin(reg, 'ten', ...)`
    - co tham so `reg` o DAU. Ban dau ham nay khop dung chu ky
    `register_expr_builtin('ten'` nen doc nguon TokenVector ra 0 ten. Cach moi
    tach theo dau trich dan: `split(q)` cho
        reg, 'ten', ...  -> ["reg, ", "ten", ...]   parts[1] = ten
        'ten', ...       -> ["", "ten", ...]        parts[1] = ten
    nen mot hai nhanh deu ra cung dap an - dung ca hai compiler."""
    out = ""
    lines = body.split(_nl())
    marker = "register_expr_builtin("
    mlen = len(marker)
    i = 0
    n = len(lines)
    while i < n:
        line = lines[i]
        at = line.find(marker)
        if at >= 0:
            rest = line[at + mlen:]
            for qq in [_q(), chr(34)]:
                parts = rest.split(qq)
                if len(parts) >= 2 and parts[1].strip() != "":
                    out = out + parts[1].strip() + " "
                    break
        i = i + 1
    return out


def build_names(filt: "str") -> "str":
    nl = _nl()
    fd = feat_dir()
    b = "# Ham builtin (register_expr_builtin) theo module" + nl + nl
    if fd == "":
        return b + "KHONG tim thay compiler_bootstrap/compiler/il_features/ - chay tu trong goc repo" + nl
    files = os_list_files(fd)
    fl = filt.lower()
    total = 0
    i = 0
    n = len(files)
    while i < n:
        f = files[i]
        sp = path_splitext(f)
        if sp[1] == ".tkv":
            # `os_list_files` tra ve DUONG DAN DAY DU, nen dung `f` truc tiep.
            # Join them `fd` se tao "...il_features\...\il_features\x.tkv" va
            # nem DirectoryNotFoundException. Loi nay cu chua bao gio lo ra
            # vi `feat_dir()` truoc do tra ve "" nen nhanh nay chua tung chay.
            body = path_read_text(f)
            names = _names_of(body)
            if names != "":
                parts = names.split(" ")
                k = 0
                m = len(parts)
                line = ""
                head = ""
                hit = 0
                while k < m:
                    nm = parts[k]
                    if nm != "":
                        if fl == "" or nm.lower().find(fl) >= 0:
                            if line == "":
                                head = "## " + f + nl
                            line = line + nm + "  "
                            total = total + 1
                            hit = hit + 1
                            if len(line) > 150:
                                b = b + head + line + nl
                                head = ""
                                line = ""
                    k = k + 1
                if line != "":
                    b = b + head + line + nl
                if hit > 0:
                    b = b + nl
        i = i + 1
    b = b + "Tong so builtin khop bo loc: " + str(total) + nl + nl
    b = b + "Ban nay CHI quet nhom HAM BUILTIN. Danh muc DAY DU (376 ten: builtin," + nl
    b = b + "method chuoi, method container, trinh phan tinh) nam o REFERENCE.md muc 7." + nl
    return b


# -------------------------------------------------------------------- lint

def build_lint(path: "str") -> "str":
    nl = _nl()
    bs = _bs()
    dq = _dq()
    b = ""
    if file_exists(path) == 0:
        return "KHONG tim thay file: " + path + nl
    txt = path_read_text(path)
    lines = txt.split(nl)
    found = 0
    in_def = 0
    types = "(i32|i64|f32|f64|str|bool|int)"
    p_ann = "^" + bs + "s*(" + bs + "w+)" + bs + "s*:" + bs + "s*" + dq + types + dq + bs + "s*="
    p_exc = "^" + bs + "s*except" + bs + "s+RuntimeError" + bs + "b"
    p_pop = "^" + bs + "s*" + bs + "w+" + bs + "s*=" + bs + "s*(" + bs + "w+)" + bs + "s*[.]pop[(][)]" + bs + "s*$"
    # Buoc slice AM. Dung `\[.+:-` (bat ca `[:-1]`, `[1:-1]`, `[2::-1]`,
    # `[::-1]`) va KHONG bat `[0:2]` / `[1:5:2]`.
    # KHONG dung `\[\s*:\s*-`: `[::-1]` co HAI dau ':' nen nhanh do khop that.
    # KHONG dung `[^]]` sau `\[`: probe cho thay `\[` + char class `[^]]`
    # tra 0 (trong khi `[^]]` don le va `\[` don le deu dung) - dung `.+`.
    p_neg = bs + "[.+:-"
    p_fmt = "fmt_float[(](?![ ]*[A-Za-z_]" + bs + "w*[ ]*,)"
    i = 0
    n = len(lines)
    while i < n:
        line = lines[i]
        no = str(i + 1)
        cut = line.strip()
        indent = len(line) - len(cut)
        if cut.startswith("def "):
            in_def = 1
        if in_def == 1 and indent >= 4:
            if re_search(p_ann, line) != 0:
                b = b + path + ":" + no + " [LOI] local co annotate kieu. Bo han goc;" + nl
                b = b + "    compiler tu suy kieu tu ve phai: x = ..." + nl
                found = found + 1
        if re_search(p_exc, line) != 0:
            b = b + path + ":" + no + " [NGHIEM TRONG] except RuntimeError: cung BAT" + nl
            b = b + "    StopIteration (cung CLR type). Kiem tra het du lieu bang" + nl
            b = b + "    next(it, default) thay vi bat loi." + nl
            found = found + 1
        if re_search(p_pop, line) != 0:
            b = b + path + ":" + no + " [LOI] gan = <bien>.pop() - pop() la LENH DOC" + nl
            b = b + "    LAP, khong phai bieu thuc. Thay bang <b>[len(<b>) - 1]." + nl
            found = found + 1
        if re_search(p_neg, line) != 0:
            b = b + path + ":" + no + " [LOI] buoc slice AM khong ho tro (a[::-1]) - chi" + nl
            b = b + "    chap nhan buoc DUONG." + nl
            found = found + 1
        if re_search(p_fmt, line) != 0:
            b = b + path + ":" + no + " [LOI] fmt_float() chi nhan MOT bien don;" + nl
            b = b + "    literal va bieu thuc deu bi tu choi luc bien dich. Gan truoc:" + nl
            b = b + "    v = <bieu thuc>; fmt_float(v, 2)" + nl
            found = found + 1
        i = i + 1
    if found == 0:
        b = b + "KHONG bat duoc loi nao. Nhung loi CHAY MOI ra, hay ket qua SAI ma" + nl
        b = b + "build van xanh, thi CHAY `verify` (in 2 lenh) va so ket qua." + nl
    else:
        b = b + nl + str(found) + " canh bao." + nl
    return b


# ------------------------------------------------------------------ verify

def build_verify(path: "str") -> "str":
    nl = _nl()
    dq = _dq()
    b = ""
    b = b + "# VERIFY " + path + nl
    b = b + "# TokenVector chua co subprocess -> phai chay 2 lenh nay ROI DOC KET QUA." + nl
    b = b + "# (Bien dich xanh CHI chan loi compile; loi luc CHAY va ket qua SAI van con.)" + nl + nl
    b = b + "cd D:\\TokenVector\\3.code" + nl
    ex = path_join(tmp_dir(), "tkvg_check.exe")
    b = b + "dist\\tkvc.exe build " + path + " --out " + ex + " --entry run" + nl
    b = b + "& " + ex + nl + nl
    b = b + "#exit code khac 0 = BUILD FAIL.  Ket qua in ra SAI so voi mong doi =" + nl
    b = b + "#TEST FAIL (dung gi het, sua lai).  Moi noi 'xong' khi ca 2 deu sach." + nl
    b = b + nl
    b = b + "# Muon chay nguyen bo Testkit (117 file + 31 negative):" + nl
    b = b + "powershell -NoProfile -File tools\\testkit_gate.ps1" + nl
    b = b + nl
    b = b + "# Cross-check voi CPython (119 mau):" + nl
    b = b + "powershell -NoProfile -File tools\\parity_probe\\run.ps1" + nl
    return b


def run() -> "i32":
    nl = _nl()
    argv = sys_argv()
    if len(argv) < 2:
        return help()
    cmd = argv[1]
    out_file = ""
    rest = ""
    i = 2
    n = len(argv)
    while i < n:
        if argv[i] == "--file":
            if i + 1 < n:
                out_file = argv[i + 1]
                i = i + 2
                continue
        if rest == "":
            rest = argv[i]
        i = i + 1
    if cmd == "rules":
        return _emit(build_rules(), out_file)
    if cmd == "find":
        if rest == "":
            return help()
        return _emit(build_find(rest), out_file)
    if cmd == "names":
        return _emit(build_names(rest), out_file)
    if cmd == "lint":
        if rest == "":
            return help()
        return _emit(build_lint(rest), out_file)
    if cmd == "verify" or cmd == "check":
        if rest == "":
            return help()
        return _emit(build_verify(rest), out_file)
    return help()
