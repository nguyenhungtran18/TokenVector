# -*- coding: utf-8 -*-
"""Cong doi chieu IL (viet bang TokenVector): IL cua tv2s tren moi file test/**/*.tkv so voi IL VANG da luu.

IL vang = bang `test/il_vang.txt` (moi dong: ten TAB sha256 cua IL da chuan hoa | FAIL neu file khong dich duoc). Bang
nay duoc dung LAN DAU tu trang thai da kiem la khop trinh bien dich Python tren moi file (SAME, IL_DIFF=0) - nen cong
nay thay nua Python cu (`tools/py_lo.py`) ma khong mat tham chieu. Doi y co chu dich sinh ma -> chay `--cap-nhat`.

Moi LO (4 luong) khoi dong tv2s MOT lan: tv2s.exe @lo_i. Ten bien tam sinh tu bo dem toan cuc (vd __ss3, __fs0_s,
__strtmp1000018) phu thuoc cac file da dich truoc trong cung tien trinh, nen truoc khi bam IL ta DANH SO LAI chung theo
thu tu xuat hien (`chuan_hoa`).

Ket qua: SAME / IL_DIFF (IL khac vang) / NEW (chua co trong vang) / FAIL_DOI (dich duoc <-> khong dich duoc so voi vang).
Cach dung (goc du an): tools\\diff_il.exe [--cap-nhat]     Dich: _scratch\\tv\\tv2s.exe tools\\diff_il.tkv tools\\diff_il.exe main
"""

SO_LO = 4
THU_MUC = "_scratch\\dc2"
TV2S = "_scratch\\tv\\tv2s.exe"
TEP_VANG = "test\\il_vang.txt"


def ten_cua(duong: "str") -> "str":
    """Duong dan tuyet doi -> ten ngan 'test_xxx_yyy' (bo goc du an, '\\' -> '_', bo duoi .tkv)."""
    vi = duong.find("\\test\\")
    t = duong
    if vi >= 0:
        t = duong[vi + 1:]
    t = t.replace("\\", "_")
    if t.endswith(".tkv"):
        t = t[:len(t) - 4]
    return t


def la_ky_tu_ten(c: "str") -> "i32":
    if c.isalpha() or c.isdigit() or c == "_":
        return 1
    return 0


def chuan_hoa_dong(dong: "str", ten_cu: "list[str]") -> "str":
    """Doi moi token '__<chu/so>' co chua chu so thanh '__#k' (k = thu tu xuat hien dau tien trong ca file)."""
    ra = ""
    i = 0
    n = len(dong)
    while i < n:
        if dong.startswith("__", i) and (i == 0 or la_ky_tu_ten(dong[i - 1]) == 0):
            j = i + 2
            co_so = 0
            while j < n and la_ky_tu_ten(dong[j]) == 1:
                if dong[j].isdigit():
                    co_so = 1
                j += 1
            tok = dong[i:j]
            if co_so == 1:
                k = -1
                m = 0
                while m < len(ten_cu):
                    if ten_cu[m] == tok:
                        k = m
                        break
                    m += 1
                if k < 0:
                    ten_cu.append(tok)
                    k = len(ten_cu) - 1
                ra = ra + "__#" + str(k)
            else:
                ra = ra + tok
            i = j
        else:
            ra = ra + dong[i]
            i += 1
    return ra


def chuan_hoa(il: "str") -> "str":
    ten_cu = []
    ra = []
    for dong in il.replace(chr(13), "").split(chr(10)):
        if "__" in dong:
            ra.append(chuan_hoa_dong(dong, ten_cu))
        else:
            ra.append(dong)
    return chr(10).join(ra)


def lo_chay(lo: "i32", tp: "str") -> "i32":
    """Dich cac file cua lo `lo` bang tv2s (MOT tien trinh). tp = tien to pha ('' hoac 'e')."""
    ds2 = THU_MUC + "\\" + tp + "tv_" + str(lo) + ".txt"
    _b = proc_run("cmd.exe", "/c " + TV2S + " @" + ds2 + " > \"" + ds2 + ".log\" 2>&1")
    return 0


def lo0() -> "i32":
    return lo_chay(0, "")


def lo1() -> "i32":
    return lo_chay(1, "")


def lo2() -> "i32":
    return lo_chay(2, "")


def lo3() -> "i32":
    return lo_chay(3, "")


def e0() -> "i32":
    return lo_chay(0, "e")


def e1() -> "i32":
    return lo_chay(1, "e")


def e2() -> "i32":
    return lo_chay(2, "e")


def e3() -> "i32":
    return lo_chay(3, "e")


def chia_lo(tp: "str", nguon: "list[str]", ten: "list[str]", vao: "list[str]") -> "i32":
    """Ghi cac tep danh sach lo <tp>tv_k.txt (moi dong: nguon TAB exe TAB entry)."""
    tv_lo = []
    k = 0
    while k < SO_LO:
        tv_lo.append("")
        k += 1
    i = 0
    while i < len(nguon):
        lo = i % SO_LO
        tv_lo[lo] = tv_lo[lo] + nguon[i] + chr(9) + THU_MUC + "\\tv\\" + ten[i] + ".exe" + chr(9) + vao[i] + chr(10)
        i += 1
    k = 0
    while k < SO_LO:
        write_file(THU_MUC + "\\" + tp + "tv_" + str(k) + ".txt", tv_lo[k])
        k += 1
    return 0


def dau_van(ten: "str") -> "str":
    """sha256 cua IL chuan hoa cua `ten` ('FAIL' neu khong dich duoc)."""
    il_tv = THU_MUC + "\\tv\\" + ten + ".il"
    if not path_exists(il_tv):
        return "FAIL"
    return sha256_hex(chuan_hoa(read_file(il_tv)))


def doc_vang() -> "dict[str, str]":
    v: "dict[str, str]" = {}
    if path_exists(TEP_VANG):
        for dong in read_file(TEP_VANG).replace(chr(13), "").split(chr(10)):
            f = dong.split(chr(9))
            if len(f) == 2:
                v[f[0]] = f[1]
    return v


def phan_loai(ten: "str", dau: "str", vang: "dict[str, str]") -> "str":
    """SAME / IL_DIFF / NEW / FAIL_DOI / FAIL (khong dich duoc, giong vang) cho mot ten."""
    if ten not in vang:
        return "NEW"
    if vang[ten] == dau:
        if dau == "FAIL":
            return "FAIL"
        return "SAME"
    if dau == "FAIL" or vang[ten] == "FAIL":
        return "FAIL_DOI"
    return "IL_DIFF"


def ten_ham_dau(nguon: "str") -> "list[str]":
    """Toi da 3 ten ham cap module dau tien ('def ten(')."""
    ra = []
    for dong in read_file(nguon).replace(chr(13), "").split(chr(10)):
        if dong.startswith("def ") and "(" in dong:
            ra.append(dong[4:].split("(")[0].strip())
            if len(ra) >= 3:
                break
    return ra


def main() -> "i32":
    _bo = os_mkdir(THU_MUC)
    cap_nhat = 0
    tham = sys_argv()
    for t in tham:
        if t == "--cap-nhat":
            cap_nhat = 1
    vang = doc_vang()
    moi = []
    _bo2 = os_mkdir(THU_MUC + "\\tv")
    _d = proc_run("cmd.exe", "/c dir /s /b test\\*.tkv > \"" + THU_MUC + "\\files.txt\"")
    tat_ca = read_file(THU_MUC + "\\files.txt").replace(chr(13), "").split(chr(10))
    ten = []
    nguon = []
    vao = []
    for d in tat_ca:
        if d.strip() == "" or "\\dist\\" in d:
            continue
        nguon.append(d.strip())
        ten.append(ten_cua(d.strip()))
        vao.append("")
    # PHA 1: entry mac dinh
    chia_lo("", nguon, ten, vao)
    print(str(len(nguon)) + " file, " + str(SO_LO) + " lo")
    t0 = thread_spawn(lo0)
    t1 = thread_spawn(lo1)
    t2 = thread_spawn(lo2)
    t3 = thread_spawn(lo3)
    _r0 = thread_join(t0)
    _r1 = thread_join(t1)
    _r2 = thread_join(t2)
    _r3 = thread_join(t3)
    dem = [0, 0, 0, 0, 0]
    ten_loi = []
    nguon_loi = []
    i = 0
    while i < len(nguon):
        dau = dau_van(ten[i])
        moi.append(ten[i] + chr(9) + dau)
        kq = phan_loai(ten[i], dau, vang)
        if kq == "SAME":
            dem[0] += 1
        elif kq == "FAIL":
            dem[2] += 1
            ten_loi.append(ten[i])
            nguon_loi.append(nguon[i])
        else:
            if kq == "IL_DIFF":
                dem[1] += 1
            elif kq == "NEW":
                dem[3] += 1
            else:
                dem[4] += 1
            print(kq + " " + ten[i])
            if dau == "FAIL":
                ten_loi.append(ten[i])
                nguon_loi.append(nguon[i])
        i += 1
    print("PHA 1 (entry mac dinh): SAME=" + str(dem[0]) + " IL_DIFF=" + str(dem[1]) + " FAIL=" + str(dem[2]) + " NEW=" + str(dem[3]) + " FAIL_DOI=" + str(dem[4]))
    # PHA 2: file BOTH_FAIL -> thu 3 ham dau lam entry
    n2 = []
    t2n = []
    v2 = []
    i = 0
    while i < len(nguon_loi):
        for h in ten_ham_dau(nguon_loi[i]):
            n2.append(nguon_loi[i])
            t2n.append(ten_loi[i] + "__" + h)
            v2.append(h)
        i += 1
    chia_lo("e", n2, t2n, v2)
    print("pha 2: " + str(len(n2)) + " cap file/ham")
    u0 = thread_spawn(e0)
    u1 = thread_spawn(e1)
    u2 = thread_spawn(e2)
    u3 = thread_spawn(e3)
    _s0 = thread_join(u0)
    _s1 = thread_join(u1)
    _s2 = thread_join(u2)
    _s3 = thread_join(u3)
    dem2 = [0, 0, 0, 0, 0]
    i = 0
    while i < len(t2n):
        dau = dau_van(t2n[i])
        moi.append(t2n[i] + chr(9) + dau)
        kq = phan_loai(t2n[i], dau, vang)
        if kq == "SAME":
            dem2[0] += 1
        elif kq == "FAIL":
            dem2[2] += 1
        else:
            if kq == "IL_DIFF":
                dem2[1] += 1
            elif kq == "NEW":
                dem2[3] += 1
            else:
                dem2[4] += 1
            print(kq + " " + t2n[i])
        i += 1
    print("PHA 2 (3 ham dau): SAME=" + str(dem2[0]) + " IL_DIFF=" + str(dem2[1]) + " FAIL=" + str(dem2[2]) + " NEW=" + str(dem2[3]) + " FAIL_DOI=" + str(dem2[4]))
    if cap_nhat == 1:
        write_file(TEP_VANG, chr(10).join(moi) + chr(10))
        print("DA CAP NHAT " + TEP_VANG + ": " + str(len(moi)) + " dong")
        return 0
    if dem[1] + dem[3] + dem[4] + dem2[1] + dem2[3] + dem2[4] > 0:
        return 1
    return 0
