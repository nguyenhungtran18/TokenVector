# -*- coding: utf-8 -*-
"""Quet mot cay file .tkv va liet ke record nao khai field container CHUA
duoc gan trong `__init__` (2026-09-29; chuyen sang TokenVector 2026-10-12).

Dung khi compiler bao loi:
    class 'X': field 'y' kieu container ('list[str]') CHUA duoc gan trong __init__

Ban Python cu dung `ast.parse` vi file `.tkv` la Python that. Ban nay quet VAN
BAN - compiler TokenVector khong co module `ast`, va dung `ast` se phai chay
CPython, trai yeu cau "repo nay sach hoan toan".

    dist\tkvc-tv.exe tools\scan_container.tkv <thu-muc>
    dist\tkvc-tv.exe tools\scan_container.tkv D:\TokenVector.Inference

Mac dinh khong gan thu muc nao - `sys_argv()` la doi so cua lenh goi, thieu
thi in huong dan va thoat.

Tai sao can cong cu: loi nay chi lo ra MOT truong hop moi lan build, ma
Inference co 19 truong hop, Data co 31. Quet het mot luc de biet het pham vi
thay vi sua tung cai mot.
"""


def quet_dir(base: "str") -> "list[str]":
    """File .tkv trong MOT thu muc (khong de quy).

    GIOI HAN NEN TANG: TokenVector co `os_list_files(p)` nhung no CHI liet ke
    FILE, khong tra thu muc con, va khong co co de quy - khong ton tai builtin
    nao duyet duoc cay thu muc. Ban Python cu dung `os.walk` nen quet duoc ca
    cay; ban nay KHONG the, va giu nguyen gia dinh do se im lang bo sot file.

    Vì vay lenh goi nhan NHIEU thu muc:
        scan_container.tkv <thu-muc-1> <thu-muc-2> ...
    Muon quet ca cay, phai truyen tung thu muc (PowerShell:
        Get-ChildItem -Recurse -Directory | % { scan_container $_.FullName })"""
    ra: "list[str]" = []
    names = os_list_files(base)
    j = 0
    while j < len(names):
        p = names[j]
        j = j + 1
        if path_splitext(p)[1] == ".tkv":
            ra.append(p)
    return ra


def _thuoc_linh(c: "str") -> "bool":
    """Dong nam trong than (bat dau bang khoang trang hoac tab)."""
    if c == "":
        return 0
    c1 = c[0]
    if c1 == " " or c1 == chr(9):
        return 1
    return 0


def _indent(c: "str") -> "i32":
    """So khoang trang dau dong (dung de phan biet than class voi than ham)."""
    n = 0
    while n < len(c):
        c1 = c[n]
        if c1 != " " and c1 != chr(9):
            break
        n = n + 1
    return n


def _la_container(dt: "str") -> "bool":
    return 1 if dt.startswith("list[") or dt.startswith("dict[") or dt.startswith("set[") else 0


def quet_lop(ten: "str", body: "list[str]", p: "str") -> "list[str]":
    """Cac dong 'tenLop.tenTruong|dtype|file' cho truong container chua gan."""
    ra: "list[str]" = []
    # Indent cua than class = indent cua dong thuoc lhop dau tien co noi dung.
    # Field phai nam O DUNG indent nay; dong sau day la than ham.
    ind = -1
    for ln in body:
        if ln.strip() != "":
            ind = _indent(ln)
            break
    if ind < 0:
        return ra
    gan: "list[str]" = []
    # 1) `self.X =` trong THAN __init__.
    # Luu y: dong gan nam SAU indent cua than class (`ind`) - no o trong than
    # ham. Bo qua `self.xs = {}` o vi sai cho ra bao nhieu loi gia.
    # Ket thuc khi gap `def <ten>` khac o cung indent `ind`.
    in_init = 0
    for ln in body:
        i2 = _indent(ln)
        if i2 == ind:
            s = ln.strip()
            if s.startswith("def "):
                in_init = 1 if s.startswith("def __init__") else 0
            continue
        if in_init == 1 and i2 > ind:
            s = ln.strip()
            if s.startswith("self."):
                rest = s[5:]
                k = rest.find("=")
                if k > 0:
                    fld = rest[0:k].strip()
                    if fld != "":
                        gan.append(fld)
    # 2) khai bao field container o than class
    for ln in body:
        if _indent(ln) != ind:
            continue
        s = ln.strip()
        if s.startswith("def ") or s.startswith("self."):
            continue
        c = s.find(":")
        if c <= 0:
            continue
        fld = s[0:c].strip()
        if fld == "" or fld.startswith("self."):
            continue
        q1 = s.find(chr(34))
        q2 = s.find(chr(34), q1 + 1) if q1 >= 0 else -1
        if q1 < 0 or q2 < 0:
            continue
        dt = s[q1 + 1:q2]
        if _la_container(dt) == 0:
            continue
        ok = 0
        for g in gan:
            if g == fld:
                ok = 1
        if ok == 0:
            ra.append(ten + "|" + fld + "|" + dt + "|" + p)
    return ra


def quet_file(p: "str") -> "list[str]":
    """Quet 1 file: tach than class roi goi quet_lop."""
    ra: "list[str]" = []
    src = path_read_text(p)
    lines = src.split(chr(10))
    ten = ""
    body: "list[str]" = []
    for ln in lines:
        s = ln.strip()
        if s == "":
            body.append("")
            continue
        if _thuoc_linh(ln) == 0:
            if ten != "":
                for r in quet_lop(ten, body, p):
                    ra.append(r)
                ten = ""
                body = []
            if s.startswith("class "):
                h = s[6:]
                k = h.find(":")
                if k > 0:
                    h = h[0:k].strip()
                k2 = h.find("(")
                if k2 > 0:
                    h = h[0:k2].strip()
                if h != "":
                    ten = h
        else:
            if ten != "":
                body.append(ln)
    if ten != "":
        for r in quet_lop(ten, body, p):
            ra.append(r)
    return ra


def run() -> "i32":
    # `sys_argv()[0]` la DUONG DAN chuong trinh, doi so nguoi dung tu [1].
    argv = sys_argv()
    if len(argv) < 2:
        print("Dung: scan_container <thu-muc> [<thu-muc> ...]")
        print("  quet file .tkv, liet ke field container chua gan trong __init__")
        print("  (TokenVector khong co `os.walk` - trong TUNG thu muc mot lan)")
        return 1
    files: "list[str]" = []
    i = 1
    while i < len(argv):
        d = argv[i]
        if not path_isdir(d):
            print("BO QUA (khong phai thu muc): " + d)
        else:
            for p in quet_dir(d):
                files.append(p)
        i = i + 1
    hang: "list[str]" = []
    for p in files:
        for r in quet_file(p):
            hang.append(r)
    print("  " + str(len(hang)) + " truong container CHUA gan trong __init__ (quet " + str(len(files)) + " file .tkv)")
    for h in hang:
        a = h.split("|")
        if len(a) < 4:
            continue
        print("   " + a[0] + "." + a[1] + "  " + a[2] + "   (" + a[3] + ")")
    return 0
