# -*- coding: utf-8 -*-
"""Thu vien quet danh muc ten da dang ky - dung chung cho cac tool.

Module nay CHI chua ham du lieu va ham, KHONG co ham main. Moi tool chi can
khai bao:

    __tkv_import__ = "danh_muc_ten_lib"

Canh bao quan trong: TokenVector gop TOAN BO ham/global cua cac module vao
mot chuong trinh chung va BAO LOI neu trung ten ham/class. Vi vay moi thu
trong file nay deu co tien to `dm_`, va tool goi KHONG duoc dinh nghia lai
cac ten do.

Quy tac trich xuat:
  CHAC = lenh dang ky co chuoi literal o THAM SO THU HAI:
         `register_x(reg, 'ten', ...)`
  KHA  = khoa dict literal `'ten' : ...`
"""
DM_DS: "str" = "compiler_src\\ds_gop.txt"
DM_TEN: "list[str]" = []
DM_CHAC: "list[i32]" = []
DM_SO_FILE: "i32" = 0
DM_SO_KHA: "i32" = 0


def dm_la_so(c: "str") -> "i32":
    if c < "0":
        return 0
    if c > "9":
        return 0
    return 1


def dm_la_chu(c: "str") -> "i32":
    if c >= "a" and c <= "z":
        return 1
    if c >= "A" and c <= "Z":
        return 1
    return 0


def dm_la_ten(c: "str") -> "i32":
    if dm_la_so(c) == 1 or dm_la_chu(c) == 1 or c == "_":
        return 1
    return 0


def dm_het_ten(s: "str") -> "i32":
    if s == "":
        return 0
    i = 0
    while i < len(s):
        if dm_la_ten(s[i:i + 1]) == 0:
            return 0
        i = i + 1
    return 1


def dm_them(t: "str", chac: "i32") -> "i32":
    i = 0
    while i < len(DM_TEN):
        if DM_TEN[i] == t:
            if DM_CHAC[i] == 0 and chac == 1:
                DM_CHAC[i] = 1
            return 0
        i = i + 1
    DM_TEN.append(t)
    DM_CHAC.append(chac)
    if chac == 1:
        return 0
    return 1


def dm_quet_chac(s: "str") -> "i32":
    moc = "register_"
    i = 0
    dem = 0
    while i < len(s):
        if s[i:i + 9] == moc:
            dau = i
            while dau > 0 and s[dau - 1:dau] != "\n":
                dau = dau - 1
            k = dau
            while k < i:
                c = s[k:k + 1]
                if c != " " and c != "\t" and c != "\r":
                    break
                k = k + 1
            if k < i and s[k:k + 1] == "#":
                e = i
                while e < len(s) and s[e:e + 1] != "\n":
                    e = e + 1
                i = e
            else:
                j = i + 9
                while j < len(s) and dm_la_ten(s[j:j + 1]) == 1:
                    j = j + 1
                if j < len(s) and s[j:j + 1] == "(":
                    q = j + 1
                    muc = 1
                    trong = ""
                    dau_phay = -1
                    while q < len(s):
                        c = s[q:q + 1]
                        if trong != "":
                            if c == "\\":
                                q = q + 2
                            else:
                                if c == trong:
                                    trong = ""
                                q = q + 1
                        else:
                            if c == "'" or c == "\"":
                                trong = c
                            else:
                                if c == "(" or c == "[" or c == "{":
                                    muc = muc + 1
                                else:
                                    if c == ")" or c == "]" or c == "}":
                                        muc = muc - 1
                                        if muc == 0:
                                            break
                                    else:
                                        if c == "," and muc == 1:
                                            dau_phay = q
                                            break
                            q = q + 1
                    if dau_phay >= 0:
                        v = dau_phay + 1
                        while v < len(s):
                            c = s[v:v + 1]
                            if c != " " and c != "\t" and c != "\n" and c != "\r":
                                break
                            v = v + 1
                        if v < len(s) and (s[v:v + 1] == "'" or s[v:v + 1] == "\""):
                            nhay = s[v:v + 1]
                            k = v + 1
                            t = ""
                            while k < len(s) and s[k:k + 1] != nhay:
                                if dm_la_ten(s[k:k + 1]) == 0:
                                    break
                                t = t + s[k:k + 1]
                                k = k + 1
                            if dm_het_ten(t) == 1:
                                dm_them(t, 1)
                                dem = dem + 1
                                i = k + 1
                    i = j
                else:
                    i = i + 1
        else:
            i = i + 1
    return dem


def dm_quet_kha(s: "str") -> "i32":
    i = 0
    dem = 0
    while i < len(s) - 2:
        if s[i:i + 1] == "'":
            j = i + 1
            t = ""
            while j < len(s) and s[j:j + 1] != "'":
                if dm_la_ten(s[j:j + 1]) == 0:
                    break
                t = t + s[j:j + 1]
                j = j + 1
            if j < len(s) and s[j:j + 1] == "'" and dm_het_ten(t) == 1:
                k = j + 1
                while k < len(s) and s[k:k + 1] == " ":
                    k = k + 1
                if k < len(s) and s[k:k + 1] == ":":
                    if dm_them(t, 0) == 1:
                        dem = dem + 1
                    i = j + 1
                    continue
        i = i + 1
    return dem


def dm_quet_file(p: "str") -> "i32":
    global DM_SO_KHA
    if path_exists(p) == 0:
        return 0
    s = read_file(p)
    dm_quet_chac(s)
    DM_SO_KHA = DM_SO_KHA + dm_quet_kha(s)
    return 1


def dm_quet() -> "i32":
    global DM_SO_FILE
    ds = read_file(DM_DS).split("\n")
    i = 0
    while i < len(ds):
        d = ds[i].strip()
        if d != "":
            if dm_quet_file(d.replace("\\", "/")) == 1:
                DM_SO_FILE = DM_SO_FILE + 1
        i = i + 1
    return DM_SO_FILE


def dm_tra(t: "str") -> "i32":
    """2 = CHAC, 1 = KHA, 0 = THIEU."""
    i = 0
    while i < len(DM_TEN):
        if DM_TEN[i] == t:
            if DM_CHAC[i] == 1:
                return 2
            return 1
        i = i + 1
    return 0


def dm_tach_ten(noidung: "str") -> "list[str]":
    ra: "list[str]" = []
    dong = noidung.split("\n")
    i = 0
    while i < len(dong):
        dong_hien = dong[i]
        hien = ""
        j = 0
        while j < len(dong_hien):
            c = dong_hien[j:j + 1]
            if c == " " or c == "\t" or c == "\r":
                if hien != "":
                    ra.append(hien)
                    hien = ""
            else:
                hien = hien + c
            j = j + 1
        if hien != "":
            ra.append(hien)
        i = i + 1
    return ra
