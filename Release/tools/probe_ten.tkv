# -*- coding: utf-8 -*-
"""Probe xem 1 TEN co ton tai trong TokenVector khong - BAN TINH.

Ban nay KHONG goi compiler luc chay. No doc 125 file nguon trong
`compiler_src/ds_gop.txt` mot lan (qua module dung chung `danh_muc_ten_lib`)
va tra cuu cuc bo:

  CO     ten duoc lenh `register_*` dang ky bang chuoi literal
  KHA    ten chi xuat hien lam khoa dict; can kiem bang bien dich that
  THIEU  khong thay trong danh muc

Vi vay no KHONG chung minh mot ten goi duoc voi mot bo tham so cu the. Muon
chung minh goi that, dung mot chuong trinh mau bien dich - nhung do la cong
viec xac minh mot lan, khong phai phu thuoc moi cau tra loi.

Dung:  probe_ten.exe <ten.txt>
"""
__tkv_import__ = "danh_muc_ten_lib"


def in_nhom(tieu_de: "str", ds: "list[str]") -> "i32":
    print("")
    print(tieu_de + " (" + str(len(ds)) + "):")
    i = 0
    while i < len(ds):
        hang = ""
        j = 0
        while j < 6 and i + j < len(ds):
            hang = hang + ds[i + j] + "    "
            j = j + 1
        print("   " + hang)
        i = i + 6
    return 0


def main() -> "i32":
    tham = sys_argv()
    if len(tham) < 2:
        print("dung: probe_ten.exe <ten.txt>")
        return 2
    dm_quet()
    ten = dm_tach_ten(read_file(tham[1]))
    print("tra " + str(len(ten)) + " ten (tinh, khong goi compiler)")
    co: "list[str]" = []
    kha: "list[str]" = []
    thieu: "list[str]" = []
    i = 0
    while i < len(ten):
        r = dm_tra(ten[i])
        if r == 2:
            co.append(ten[i])
        if r == 1:
            kha.append(ten[i])
        if r == 0:
            thieu.append(ten[i])
        i = i + 1
    in_nhom("CO - dang ky literal", co)
    in_nhom("KHA - khoa dict, can kiem bang bien dich that", kha)
    in_nhom("THIEU - khong thay trong danh muc", thieu)
    return 0
