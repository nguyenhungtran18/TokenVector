# -*- coding: utf-8 -*-
# Bo loi Python (2026-09-30)
#
# Truoc day chi co 6 loai: Exception, IndexError, KeyError, OverflowError,
# ValueError, ZeroDivisionError. Python co ~75. Bo sung 15 loai co tuong
# duong CLR that sua (xem _EXC_TYPE_MAP va khoi "co y dinh KHONG them").
#
# Dong thoi sua loi thong diep `IndexError`: `ArgumentOutOfRangeException
# .ctor(string)` gan vao `ParamName` chu khong phai `Message`, nen
# `str(e)` ra "Parameter name: <msg>" va Message rong. Nay dung
# `.ctor(paramName, message)` voi ("", msg).
__tkv_import__ = ["tkv_test_lib"]


def run() -> "i32":
    total = 0
    tested = 0

    # --- 6 loai co san tu truoc: ghim lai de bao ve hoi quy ---
    try:
        raise ValueError("ve")
    except ValueError as e:
        tested = tested + 1
        total = total + check("exc_valueerror", str(e), "ve")
    try:
        raise KeyError("khoa")
    except KeyError as e:
        tested = tested + 1
        total = total + check("exc_keyerror", str(e), "khoa")

    # --- IndexError: PHAI ra dung thong diep nguoi viet ---
    try:
        raise IndexError("het rooc")
    except IndexError as e:
        tested = tested + 1
        total = total + check("exc_indexerror_msg", str(e), "het rooc")

    # --- 15 loai moi ---
    try:
        raise TypeError("sai kieu")
    except TypeError as e:
        tested = tested + 1
        total = total + check("exc_typeerror", str(e), "sai kieu")
    try:
        raise AttributeError("thieu field")
    except AttributeError as e:
        tested = tested + 1
        total = total + check("exc_attributeerror", str(e), "thieu field")
    try:
        raise RuntimeError("loi chay")
    except RuntimeError as e:
        tested = tested + 1
        total = total + check("exc_runtimeerror", str(e), "loi chay")
    try:
        raise NotImplementedError("chua lam")
    except NotImplementedError as e:
        tested = tested + 1
        total = total + check("exc_notimplemented", str(e), "chua lam")
    try:
        raise OSError("loi he dieu hanh")
    except OSError as e:
        tested = tested + 1
        total = total + check("exc_oserror", str(e), "loi he dieu hanh")
    try:
        raise FileNotFoundError("khong thay file")
    except FileNotFoundError as e:
        tested = tested + 1
        total = total + check("exc_filenotfound", str(e), "khong thay file")
    try:
        raise PermissionError("khong co quyen")
    except PermissionError as e:
        tested = tested + 1
        total = total + check("exc_permission", str(e), "khong co quyen")
    try:
        raise ArithmeticError("so hoc")
    except ArithmeticError as e:
        tested = tested + 1
        total = total + check("exc_arithmetic", str(e), "so hoc")
    try:
        raise EOFError("het du lieu")
    except EOFError as e:
        tested = tested + 1
        total = total + check("exc_eof", str(e), "het du lieu")
    try:
        raise MemoryError("het ram")
    except MemoryError as e:
        tested = tested + 1
        total = total + check("exc_memory", str(e), "het ram")
    try:
        raise StopIteration("het chuoi")
    except StopIteration as e:
        tested = tested + 1
        total = total + check("exc_stopiteration", str(e), "het chuoi")

    # --- 'except Exception' bat duoc moi loai (cha bat) ---
    caught = 0
    try:
        raise TypeError("x")
    except Exception:
        caught = 1
    tested = tested + 1
    total = total + check("exc_catchall_base", str(caught), "1")

    # --- raising that thi loi phai lan ra ---
    try:
        try:
            raise ValueError("khong bat")
        except TypeError:
            tested = tested + 1
            total = total + check("exc_khong_bat_nham", str(0), "1")
        tested = tested + 1
        total = total + check("exc_khong_bat_that", str(0), "1")
    except ValueError:
        tested = tested + 1
        total = total + check("exc_bat_dung_kieu", str(1), "1")

    # --- chuoi loi ---
    try:
        raise RuntimeError("noi bo")
    except RuntimeError as e:
        tested = tested + 1
        total = total + check("exc_chaining", str(e), "noi bo")

    return test_summary("python_exceptions_test", total, tested)