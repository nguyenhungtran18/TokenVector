# -*- coding: utf-8 -*-
"""GATE CHO LAMBDA (2026-09-28) - tinh nang DA TON TAI, chua duoc ghi ra.

CLAUDE.md va PLAN.md deu ghi 'lambda thieu'. Do SAI. Lambda da chay tu
Wave 3 (A2, 2026-07-29) qua duong khai bao kieu `func` - va no bat duoc
bien ngoai. Bai nay dat co lai chu ky do vao test, vi mot tinh nang co
nhung khong ai biet thi nguy hiem ngang voi tinh nang thieu.

BA THU DAT DUOC KIEM:

  1. Truyen TRUC TIEP cho tham so kieu `func`:
     `apply_it(lambda x: x + 1, 10)`.
  2. Gan vao bien da khai bao kieu `func`:
     `g: "func(i32) -> i32" = lambda x: x + 1`.
  3. BAT bien ngoai: `lambda x: x + n` trong ham co bien `n`. Ke ca chuyen
     nay cung chay - chi la thu duy nhat can closure thật, nen phai kiem
     rieng. Mot implementation chi 'ban' trong 2 truong hop dau ma sai
     o truong hop thu 3 la van im lang.

Diem can LUU Y: node lambda chi mang TEN tham so, khong kieu
(`('lambda', ['x'], body)`). Chu ky `Func<N>` lay tu khai bao kieu cua
DICH, nen `g = lambda x: ...` khong kieu se bao loi - va dieu do dung:
suy luan kieu la thuoc tinh cua chinh ngon ngu nay, khong phai hanh che.
Bai nay kiem ca hai chieu: duong co kieu chay, duong khong kieu bao loi
rieng cho 'lambda' chu khong phai "AST node khong ro".

Gia tri mong doi tinh tay.
"""

__tkv_import__ = ["tkv_test_lib"]


def apply_i(f: "func(i32) -> i32", v: "i32") -> "i32":
    """Ham nhan ham - day la noi lambda thuong duoc dung."""
    return f(v)


def apply2_i(f: "func(i32,i32) -> i32", a: "i32", b: "i32") -> "i32":
    return f(a, b)


def apply_f(f: "func(f64) -> f64", v: "f64") -> "f64":
    return f(v)


def lambda_passed_directly() -> "i32":
    total = 0
    tested = 0

    r1 = apply_i(lambda x: x + 1, 10)
    total = total + check("direct_one_arg", str(r1), "11")
    tested = tested + 1
    r2 = apply_i(lambda x: x * 2, 5)
    total = total + check("direct_captures_nothing", str(r2), "10")
    tested = tested + 1
    # Tham so khong dung trong than - van phai hop le
    r3 = apply_i(lambda x: 7, 99)
    total = total + check("direct_unused_param", str(r3), "7")
    tested = tested + 1

    return total


def lambda_two_params() -> "i32":
    total = 0
    tested = 0

    r1 = apply2_i(lambda p, q: p * q, 6, 7)
    total = total + check("two_params", str(r1), "42")
    tested = tested + 1
    r2 = apply2_i(lambda p, q: p - q, 10, 4)
    total = total + check("two_params_sub", str(r2), "6")
    tested = tested + 1

    return total


def lambda_float() -> "i32":
    total = 0
    tested = 0

    r1 = apply_f(lambda z: z / 2.0, 9.0)
    total = total + check("float_param_and_return", str(r1), "4.5")
    tested = tested + 1

    return total


def lambda_in_local() -> "i32":
    total = 0
    tested = 0

    g: "func(i32) -> i32" = lambda x: x + 1
    r1 = g(5)
    total = total + check("local_func_typed", str(r1), "6")
    tested = tested + 1
    # Dung lai nhieu lan
    r2 = g(10)
    total = total + check("local_func_reused", str(r2), "11")
    tested = tested + 1

    return total


def lambda_captures_outer() -> "i32":
    """Truong hop CAN closure that - phai co test rieng.

    Mot implementation chi chay o 2 truong hop dau ma sai o day van im
    lang, nen check ket qua CHI co y la du de phat hien."""
    total = 0
    tested = 0

    r1 = make_adder(100)
    total = total + check("captures_outer_100", str(r1), "101")
    tested = tested + 1
    r2 = make_adder(7)
    total = total + check("captures_outer_7", str(r2), "8")
    tested = tested + 1
    r3 = make_adder(0)
    total = total + check("captures_outer_0", str(r3), "1")
    tested = tested + 1

    return total


def make_adder(n: "i32") -> "i32":
    f: "func(i32) -> i32" = lambda x: x + n
    return f(1)


def run() -> "i32":
    total = 0
    tested = 0

    total = total + lambda_passed_directly()
    total = total + lambda_two_params()
    total = total + lambda_float()
    total = total + lambda_in_local()
    total = total + lambda_captures_outer()

    # 3 + 2 + 1 + 2 + 3 = 11
    return test_summary("lambda_test", total, 11)
