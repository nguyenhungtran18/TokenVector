# -*- coding: utf-8 -*-
# Regression v2 (2026-09-30): 3 loi SAI AM THAM phat hien khi ra soat lai
# so sanh voi CPython bang probe (tools/parity_probe). Tat ca deu chay XANH,
# bien dich khong loi, chi ra SO SAI - lo nguy hiem nhat.
#
#   1. '/' giua hai so nguyen phai tra FLOAT (7/2 == 3.5). Truoc day
#      `div` cua CIL (chia nguyen) duoc dung thang nen 7/2 ra 3.
#   2. int(<hang so thuc>) phai cat phan thap phan (int(3.9) == 3).
#      Truoc day bien dich sinh `ldc.i4 3.9` - IL khong hop le, ilasm bao loi.
#   3. str(<float> o khoang khoa hoc>) phai ra chuoi DOC LAI DUOC.
#      "1E-07" + them ".0" nen "1E-07.0" - khong parse lai duoc.
#
# Gia tri ky vong lay truc tiep tu CPython (khong doan):
#   python -c "print(7/2, -7/2, 7/-2, int(3.9), int(-3.9), str(1e-7), str(1e21))"
__tkv_import__ = ["tkv_test_lib"]


def run() -> "i32":
    total = 0
    tested = 0

    # --- 1. '/' nguyen/nguyen tra float ---
    a = 7
    b = 2
    c = -7
    d = -2
    tested = tested + 1
    total = total + check("div_int_pos", str(a / b), "3.5")
    tested = tested + 1
    total = total + check("div_int_neg_num", str(c / b), "-3.5")
    tested = tested + 1
    total = total + check("div_int_neg_den", str(a / d), "-3.5")
    # '//' VAN phai la chia nguyen - khong bi lan sang float.
    tested = tested + 1
    total = total + check("floordiv_still_int", str(a // b), "3")

    # --- 2. int() tren hang so thuc ---
    tested = tested + 1
    total = total + check("int_lit_pos", str(int(3.9)), "3")
    tested = tested + 1
    total = total + check("int_lit_neg", str(int(-3.9)), "-3")
    f = 3.9
    tested = tested + 1
    total = total + check("int_var", str(int(f)), "3")

    # --- 3. float o khoang khoa hoc ---
    tested = tested + 1
    total = total + check("sci_small", str(1e-7), "1e-07")
    tested = tested + 1
    total = total + check("sci_big", str(1e21), "1e+21")
    tested = tested + 1
    total = total + check("sci_edge", str(1e-5), "1e-05")
    # Chuoi do PHAI parse lai duoc - truoc day "1E-07.0" nem FormatException.
    tested = tested + 1
    total = total + check("sci_roundtrip", str(float(str(1e-7))), "1e-07")
    # Phan thap phan van phai co ".0" (fix cu, khong phai bo).
    tested = tested + 1
    total = total + check("whole_keeps_dot", str(2.0), "2.0")
    tested = tested + 1
    total = total + check("plain_keeps_dot", str(0.5), "0.5")

    return test_summary("parity_div_float_test", total, tested)
