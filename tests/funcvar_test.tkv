__tkv_import__ = ["tkv_test_lib"]


def apply_int(f: "func(i32)->i32", x: "i32") -> "i32":
    return f(x)


def double_it(x: "int") -> "int":
    return x * 2


def triple_it(x: "int") -> "int":
    return x * 3


def is_even(x: "int") -> "i32":
    if x % 2 == 0:
        return 1
    return 0


def add2(a: "int", b: "int") -> "int":
    return a + b


def store_and_call_lambda_twice() -> "i32":
    g: "func(i32)->i32" = lambda x: x * 2
    a = g(3)
    b = g(10)
    return a + b


def reassign_named_and_lambda() -> "str":
    g: "func(int)->int" = double_it
    a = g(5)
    g = triple_it
    b = g(5)
    g = lambda x: x + 1
    c = g(5)
    return str(a) + ":" + str(b) + ":" + str(c)


def map_doubles_str() -> "str":
    xs = [1, 2, 3, 4, 5]
    g: "func(int)->int" = double_it
    ys = map(g, xs)
    result = str(len(ys)) + ":" + str(ys[0]) + ":" + str(ys[4])
    return result


def filter_evens_str() -> "str":
    xs = [1, 2, 3, 4, 5]
    h: "func(int)->i32" = is_even
    zs = filter(h, xs)
    result = str(len(zs)) + ":" + str(zs[0]) + ":" + str(zs[1])
    return result


def reduce_sum_str() -> "str":
    xs = [1, 2, 3, 4, 5]
    add: "func(int, int)->int" = add2
    total = reduce(add, xs, 0)
    return str(total)


def run() -> "i32":
    total = 0
    tested = 0

    tested = tested + 1
    total = total + check("store_and_call_lambda_twice", str(store_and_call_lambda_twice()), "26")

    tested = tested + 1
    total = total + check("reassign_named_and_lambda", reassign_named_and_lambda(), "10:15:6")

    tested = tested + 1
    total = total + check("map_doubles", map_doubles_str(), "5:2:10")

    tested = tested + 1
    total = total + check("filter_evens", filter_evens_str(), "2:2:4")

    tested = tested + 1
    total = total + check("reduce_sum", reduce_sum_str(), "15")

    return test_summary("funcvar_test", total, tested)
