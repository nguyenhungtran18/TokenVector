# -*- coding: utf-8 -*-
"""REPRO cho bug IL hong chua tim ra nguyen nhan (tim ra 2026-10-14).

KHONG phai `*_test.tkv` nen `tools\testkit_gate.ps1` KHONG chay file nay - neu
no co ten do, gate se FAIL. Chay tay:

    dist\tkvc-tv.exe tests\bug_for_f32buf_il_repro.tkv build\repro.exe main
    .\build\repro.exe

KET QUA: `System.BadImageFormatException` (0x8007000B) tai `TKVApp.f2`.
`ilasm` **nhan** IL, chi JIT moi tu choi luc chay - nen do la bug bien dich,
khong phai loi nguon TokenVector.

DA BIET:
- Co san tu truoc, khong phai hoi qu P6: tai hien tren `00f0986`.
- Can ca BA dieu kien moi lo. Bo `if` -> qua. Doi `for` thanh `while` -> qua.
  Con mot `f32buf` -> qua.
- CHUA tim ra dong IL hong. Doan bo la khong gia tri.

Khong sua gi o day. Khi tim ra nguyen nhan, sua compiler roi XOA file nay.
"""

def f2(n: "i32", reps: "i32") -> "i32":
    a = f32buf(n)
    b = f32buf(n)
    r = f32buf(n)
    i = 0
    while i < n:
        a[i] = 1.0
        b[i] = 2.0
        i = i + 1
    best = 1.0e9
    d = 0.0
    k = 0
    while k < reps:
        d = time_perf()
        for i in range(n):
            r[i] = a[i] + b[i]
        if d < best:
            best = d
        k = k + 1
    cs = 0.0
    i = 0
    while i < n:
        cs = cs + r[i]
        i = i + 1
    f32buf_free(a)
    f32buf_free(b)
    f32buf_free(r)
    return int(cs)


def main() -> "i32":
    print("f2=" + str(f2(16, 3)))
    return 0