# -*- coding: utf-8 -*-
# `frozenset()` va `frozenset([...])` - bo sung 2026-09-30.
#
# `frozenset(ys)` da co san tu truoc (chi nhan BIEN list). Python con cho
# them dang rong va dang list literal.
#
# BA LOI da gap khi viet - ghim lai de khong lap:
#  1. `HashSet<T>::.ctor(int32)` ma khong day `ldc.i4 0` -> `newobj` thieu
#     tham so -> het stack -> InvalidProgramException LUC CHAY. Dung `.ctor()`.
#  2. Tu viet vong `Add` bang `ta.dtype` -> day sai kieu: kieu IL thuc cua
#     HashSet<Integer> da WIDEN sang `TkvInt`, con `ta.dtype` van la 'i32'.
#     Da dung lai `codegen_assign_set_literal`.
#  3. `infer_scope` o first-pass co the la `_DtypeOnlyScope` - chi co
#     `__getitem__`, KHONG co `.get`.
__tkv_import__ = ["tkv_test_lib"]


def run() -> "i32":
    total = 0
    tested = 0

    # --- frozenset() rong ---
    a = frozenset()
    tested = tested + 1
    total = total + check("fs_empty", str(len(a)), "0")

    # --- frozenset([...]) - trung lap bi loi nhu HashSet ---
    b = frozenset([3, 1, 3, 2])
    tested = tested + 1
    total = total + check("fs_lit_dedup", str(len(b)), "3")
    bl = b.to_list()
    tested = tested + 1
    total = total + check("fs_lit_to_list", str(len(bl)), "3")
    bl.sort()
    tested = tested + 1
    total = total + check("fs_lit_sorted", str(bl[0]) + "," + str(bl[2]), "1,3")

    # --- frozenset(ys) - hien hu chay duoc, ghim bao ve ---
    src = [7, 8]
    c = frozenset(src)
    tested = tested + 1
    total = total + check("fs_var", str(len(c)), "2")
    tested = tested + 1
    total = total + check("fs_var_src_unchanged", str(len(src)), "2")

    # --- rong + them vao duoc (khac set) ---
    e = frozenset()
    tested = tested + 1
    total = total + check("fs_empty_still", str(len(e)), "0")

    return test_summary("frozenset_ctor_test", total, tested)