# -*- coding: utf-8 -*-
# Ghim phep giai ma escape cua chuoi - PHẢI khớp Python (2026-09-30).
#
# Truoc day noi dung chuoi duoc day nguyen van cho `ldstr` va giao cho ilasm
# giai ma escape, nen hành vi escape do ILASM quyet dinh chu khong phai Python:
#   "\x41"        -> "x41"  (3 ky tu thay vi "A")
#   "\U0001F600"  -> "U0001F600" (9 ky tu thay vi emoji)
#   "\q"          -> "q"   (bi MAT dau backslash; Python giu: "\q")
#   "\0"          -> chuoi RONG
#
# Khong chi lech kien thuc - con HONG DU LIEU that. `TokenVector.Data` dung
# `"\x01"` lam dau phan cach truong khi ghep group key; khong giai ma thi chuoi
# do la 4 ky tu "\x01" chu khong phai byte 0x01. Hai ben deu vay nen test van
# xanh, nhung du lieu co chuoi "\x01" se bi cat nham sai.
#
# Gia tri ky vong lay truc tiep tu CPython, khong doan.
__tkv_import__ = ["tkv_test_lib"]


def run() -> "i32":
    total = 0
    tested = 0

    # Escape don gian
    a = "\n"
    tested = tested + 1
    total = total + check("esc_nl", str(len(a)), "1")
    b = "\t"
    tested = tested + 1
    total = total + check("esc_tab", str(len(b)), "1")
    c = "\\"
    tested = tested + 1
    total = total + check("esc_backslash", str(len(c)), "1")

    # Hex: PHAI ra ky tu THAT, khong phai chuoi "xNN"
    h1 = "\x41"
    tested = tested + 1
    total = total + check("esc_hex_len", str(len(h1)), "1")
    tested = tested + 1
    total = total + check("esc_hex_val", h1, "A")
    h2 = "a\x01b"
    tested = tested + 1
    total = total + check("esc_hex_mid_len", str(len(h2)), "3")
    tested = tested + 1
    total = total + check("esc_hex_mid_eq", str(h2 == "a" + chr(1) + "b"), "True")

    # Unicode 16 bit
    u1 = "\u00e9"
    tested = tested + 1
    total = total + check("esc_u_len", str(len(u1)), "1")
    tested = tested + 1
    total = total + check("esc_u_val", u1, "é")

    # Octal
    o1 = "\101"
    tested = tested + 1
    total = total + check("esc_oct_len", str(len(o1)), "1")
    tested = tested + 1
    total = total + check("esc_oct_val", o1, "A")

    # Escape LA: Python GIU dau backslash
    q1 = "\q"
    tested = tested + 1
    total = total + check("esc_unknown_len", str(len(q1)), "2")

    return test_summary("str_escape_test", total, tested)
