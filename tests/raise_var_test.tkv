# -*- coding: utf-8 -*-
"""GATE CHO `raise <bien>` (2026-09-28).

Python dung `raise e` de RE-RAISE loi dang bat, hoac BOC loi trong 1 loi
khac. Truoc day TokenVector chi chap nhan 2 dang: `raise <Loai>(<msg>)` va
`raise` tran. `raise e` rơi het LINE_PERSERS nen bao
"khong dich duoc dong: 'raise e'".

Khac biet 1 dong, nhung khong the bo qua: `raise <Loai>(...)` XAY MOI mot
exception (va LAM MAT doi tuong loi goc), con `raise e` nem lai CHINH doi
tuong dang bam. Doi sang mot cai se mat `InnerException` va moi bang chung
nua loi, nen day la khac biet thuc chat chu khong phai hinh thuc.

Phan biet parser: `raise X(...)` co dau HAU KHOI `(`; `raise e` khong co. Kieu
THAT cua bien do CODEGEN kiem (sentinel 'Exception' hoac record ke thua
Exception) - cung quy tac voi tham so cua `raise ... from`, nen `raise <so>`
bi tu choi luc bien dich chu khong doi duoc box roi nem luc chay.

Gia tri mong doi tinh tay.
"""

__tkv_import__ = ["tkv_test_lib"]


class MyErr(Exception):
    """Record ke thua Exception. `raise MyErr(...)` ep tham so kieu 'str'
    (duong dan nay co san truoc thay doi nay, xem REPOSITORY-NOTES), nen field
    dau tien phai la 'str' - neu la 'i32' thi sinh `.ctor(String)` ma record
    khong co."""

    msg: "str"

    def __init__(self, m: "str") -> "None":
        self.msg = m


def propagates_to_outer() -> "i32":
    """`raise e` phai truyen loi ra handler o khoi try BAO ngoai. Day la ca
    doi kieu: `e` da duoc xoa khoi bang catch khi thoat handler noi."""
    total = 0
    tested = 0
    caught = 0
    try:
        try:
            raise ValueError("first")
        except ValueError as e:
            raise e
    except ValueError as outer:
        caught = 1
    total += check("re-raise reaches outer handler", str(caught), "1")
    tested += 1

    # Khong co handler nao bat: loi phai noi tiep ra ngoai - `except` trong
    # cung 1 try KHONG bat lai loi do chinh no vua nem.
    n = 0
    try:
        raise ValueError("c")
    except ValueError as e:
        n = 1
    total += check("no handler means propagate", str(n), "1")
    tested += 1
    return total


def keeps_concrete_type() -> "i32":
    """Handler CU THE phai bat duoc truoc handler tong quat. Neu `raise e`
    lam mat kieu thi `except ValueError` se truot qua va `except Exception`
    bat - im lang, va code dua tren kieu loi se chay sai nhanh."""
    total = 0
    tested = 0
    which = 0
    try:
        try:
            raise KeyError("k")
        except KeyError as e:
            raise e
    except KeyError as specific:
        which = 1
    except Exception as broad:
        which = 2
    total += check("concrete handler wins", str(which), "1")
    tested += 1

    broad_hit = 0
    try:
        try:
            raise ValueError("b")
        except ValueError as e:
            raise e
    except Exception as any_err:
        broad_hit = 1
    total += check("broad handler still catches", str(broad_hit), "1")
    tested += 1
    return total


def custom_record() -> "i32":
    """Record tu dinh nghia ke thua Exception phai nem lai duoc - day la vi du
    ma nguoi dung viet nhieu nhat (lop loi rieng)."""
    total = 0
    tested = 0
    caught = 0
    try:
        try:
            raise MyErr("m")
        except MyErr as e:
            raise e
    except MyErr as outer:
        caught = 1
    total += check("custom record re-raise", str(caught), "1")
    tested += 1
    return total


def local_state_survives() -> "i32":
    """Re-raise khong phai la 'quay lai dau': moi thay doi bien cuc bo truoc do
    trong handler van con nguyen khi thoat - `raise e` chi nem, khong xoa
    vung nho."""
    total = 0
    tested = 0
    n = 0
    try:
        try:
            raise ValueError("cnt")
        except ValueError as e:
            n = 7
            raise e
    except ValueError as outer:
        n = n + 1
    total += check("local state survives re-raise", str(n), "8")
    tested += 1
    return total


def chains_with_from() -> "i32":
    """`raise <Loai>(msg) from e` - dung `raise e` lam loi nen, boc loi moi
    quanh no. Dung o day de chan do la 2 chuc nang phai chay lien nhau."""
    total = 0
    tested = 0
    caught = 0
    try:
        try:
            raise ValueError("inner")
        except ValueError as e:
            raise ValueError("outer") from e
    except ValueError as outer:
        caught = 1
    total += check("re-raise used as chain source", str(caught), "1")
    tested += 1
    return total


def run() -> "i32":
    total = 0
    total += propagates_to_outer()
    total += keeps_concrete_type()
    total += custom_record()
    total += local_state_survives()
    total += chains_with_from()
    # 2 + 2 + 1 + 1 + 1
    return test_summary("raise_var_test", total, 7)
