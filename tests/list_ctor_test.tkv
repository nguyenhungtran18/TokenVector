# -*- coding: utf-8 -*-
# `list()` va `list(ys)` - bo sung 2026-09-30 (Python co, TokenVector chi co
# literal `[]`). Tra ve MOI container: `list(ys)` phai la BAN SAO, sua `b`
# khong duoc sua `ys`.
__tkv_import__ = ["tkv_test_lib"]


def run() -> "i32":
    total = 0
    tested = 0

    # --- list() rong: dtype phan tu suy tu lan .append() dau tien ---
    a = list()
    a.append(3)
    a.append(1)
    tested = tested + 1
    total = total + check("list_new_len", str(len(a)), "2")
    tested = tested + 1
    total = total + check("list_new_first", str(a[0]), "3")
    tested = tested + 1
    total = total + check("list_new_last", str(a[1]), "1")

    # --- list(ys): copy ---
    ys = [7, 8, 9]
    b = list(ys)
    tested = tested + 1
    total = total + check("list_from_len", str(len(b)), "3")
    tested = tested + 1
    total = total + check("list_from_val", str(b[2]), "9")
    tested = tested + 1
    total = total + check("list_from_src_len", str(len(ys)), "3")

    # --- sua `b` KHONG duoc sua `ys` (khac `xs = ys`) ---
    b.append(10)
    tested = tested + 1
    total = total + check("copy_doc_nhan", str(len(ys)), "3")
    tested = tested + 1
    total = total + check("copy_tao_nhan", str(len(b)), "4")

    # --- list([]) co the toi (chen rong khong duoc) ---
    e = list()
    tested = tested + 1
    total = total + check("list_empty_ok", str(len(e)), "0")

    # --- ghep chuoi phai gan bien roi moi list() ---
    parts = ["a", "b", "c"]
    joined = ""
    tested = tested + 1
    total = total + check("list_of_str_ready", str(len(parts)), "3")

    return test_summary("list_ctor_test", total, tested)