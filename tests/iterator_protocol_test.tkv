__tkv_import__ = ["tkv_test_lib"]


class Range3:
    cur: "i32"
    stop: "i32"

    def __iter__(self) -> "Range3":
        return self

    def __next__(self) -> "(i32, i32)":
        if self.cur >= self.stop:
            return 0, 0
        v = self.cur
        self.cur = self.cur + 1
        return v, 1


class Bag:
    a: "i32"
    b: "i32"
    c: "i32"


class BagIter:
    src: "Bag"
    idx: "i32"

    def __iter__(self) -> "BagIter":
        return self

    def __next__(self) -> "(i32, i32)":
        s = self.src
        if self.idx == 0:
            self.idx = self.idx + 1
            return s.a, 1
        if self.idx == 1:
            self.idx = self.idx + 1
            return s.b, 1
        if self.idx == 2:
            self.idx = self.idx + 1
            return s.c, 1
        return 0, 0


class BagWithIter:
    a: "i32"
    b: "i32"
    c: "i32"

    def __iter__(self) -> "BagIter":
        bi = BagIter(self, 0)
        return bi


class BaseCounter:
    cur: "i32"
    stop: "i32"

    def __iter__(self) -> "BaseCounter":
        return self

    def __next__(self) -> "(i32, i32)":
        if self.cur >= self.stop:
            return 0, 0
        v = self.cur
        self.cur = self.cur + 1
        return v, 1


class SubCounter(BaseCounter):
    extra: "i32"


def basic_sum_test() -> "i32":
    r = Range3(0, 5)
    total = 0
    for x in r:
        total = total + x
    return total


def bag_iter_test() -> "str":
    bag = BagWithIter(10, 20, 30)
    out = ""
    for v in bag:
        out = out + str(v) + ","
    return out


def break_test() -> "i32":
    r = Range3(0, 10)
    total = 0
    for x in r:
        if x == 3:
            break
        total = total + x
    return total


def continue_test() -> "i32":
    r = Range3(0, 6)
    total = 0
    for x in r:
        if x == 2:
            continue
        total = total + x
    return total


def inherited_iter_test() -> "i32":
    sc = SubCounter(0, 4, 99)
    total = 0
    for x in sc:
        total = total + x
    return total


def run() -> "i32":
    total = 0
    tested = 0

    tested = tested + 1
    total = total + check("iter_basic_sum", str(basic_sum_test()), "10")

    tested = tested + 1
    total = total + check("iter_bag_diff_itertype", bag_iter_test(), "10,20,30,")

    tested = tested + 1
    total = total + check("iter_break", str(break_test()), "3")

    tested = tested + 1
    total = total + check("iter_continue", str(continue_test()), "13")

    tested = tested + 1
    total = total + check("iter_inherited", str(inherited_iter_test()), "6")

    return test_summary("iterator_protocol_test", total, tested)
