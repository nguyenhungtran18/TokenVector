# -*- coding: utf-8 -*-
"""GATE CHO set literal `s = {1, 2, 3}` (2026-09-28).

Truoc day `{` **khong co trong tokenizer** (nhom OP trong il_core.py), nen
`s = {1, 2, 3}` bao loi "khong tokenize duoc bieu thuc". Phai them vao
tokenizer + parser + codegen + first-pass + linter.

Hai diem phan biet bat buoc:

- `{}` la **dict rong** trong Python that (set rong la `set()`), va `d = {}` da
  ho tro san. Lan dau tien nhanh parser cua toi nem loi o `{}` va lam hong
  4 test - gap o day vi `{}` CO chay, dung xu ly bang cach tra node rong de
  duong gop di tiep.
- `{k: v}` la dict literal, van chua ho tro. Parser bao loi rieng cho no
  thay vi im lang lam nghiep - cung thu tu, nhung loi bao "dung vong for tuong
  minh" hon loi tokenizer chung chung.

PHAM VI: chi dang `ten_don = {...}` tren MOT dong. Dang inline
(`len({1,2,3})` / `x in {1,2,3}`) bi chan boi han che **co san** khac, khong
phai do set literal: `len(<bieu thuc>)` khong suy duoc hinh dang, va `in` chi
nhan 1 bien don. Da viet EXPR_CODEGEN roi BO vi khong test duoc.

Gia tri mong doi tinh tay, doi chieu CPython 3.11.
"""

__tkv_import__ = ["tkv_test_lib"]


def basic() -> "i32":
    total = 0
    tested = 0
    s = {1, 2, 3}
    total += check("int set length", str(len(s)), "3")
    tested += 1
    total += check("contains member", str(2 in s), "True")
    tested += 1
    total += check("rejects non-member", str(9 in s), "False")
    tested += 1
    return total


def dedup() -> "i32":
    """Set KHONG giu trung lap - 4 gia tri co 3 gia tri khac nhau thi len 3.
    Day la ly do su khac biet so voi list literal."""
    total = 0
    tested = 0
    a = {1, 2, 3, 2, 1}
    total += check("duplicates removed", str(len(a)), "3")
    tested += 1
    b = {5, 5, 5}
    total += check("all same", str(len(b)), "1")
    tested += 1
    return total


def string_elements() -> "i32":
    total = 0
    tested = 0
    s = {"a", "b", "c"}
    total += check("string set length", str(len(s)), "3")
    tested += 1
    total += check("string set contains", str("a" in s), "True")
    tested += 1
    return total


def widen_to_float() -> "i32":
    """`{1, 2.5}` phai ra set kieu float (Python: het float -> float) - cung
    logic widen ma declare_list_literal dung cho list literal."""
    total = 0
    tested = 0
    s = {1, 2.5}
    total += check("float widen keeps both", str(len(s)), "2")
    tested += 1
    total += check("float set contains int", str(1 in s), "True")
    tested += 1
    return total


def still_mutable() -> "i32":
    """Set literal van la set BINARY, khong phai frozenset - `.add()`/`.discard()`
    phai chay du."""
    total = 0
    tested = 0
    s = {1, 2}
    s.add(3)
    s.discard(1)
    total += check("add and discard", str(len(s)), "2")
    tested += 1
    total += check("discarded gone", str(1 in s), "False")
    tested += 1
    return total


def empty_dict_still_works() -> "i32":
    """Hoi quy: them '{' vao tokenizer duoc 'd = {}' chay nhu truoc. Day la
    dang DICT RONG (khong phai set rong - set rong la 'set()')."""
    total = 0
    tested = 0
    d = {}
    total += check("empty dict length", str(len(d)), "0")
    tested += 1
    d["k"] = 1
    total += check("empty dict then assign", str(len(d)) + "=" + str(d["k"]), "1=1")
    tested += 1
    return total


def run() -> "i32":
    total = 0
    total += basic()
    total += dedup()
    total += string_elements()
    total += widen_to_float()
    total += still_mutable()
    total += empty_dict_still_works()
    # 3 + 2 + 2 + 2 + 2 + 2
    return test_summary("set_literal_test", total, 13)
