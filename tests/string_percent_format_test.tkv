__tkv_import__ = ["tkv_test_lib"]

def run() -> "i32":
    total = 0
    tested = 0

    name = "World"
    tested = tested + 1
    total = total + check("percent_single_ident", "Hello, %s!" % name, "Hello, World!")

    n = 42
    tested = tested + 1
    total = total + check("percent_tuple_multi", "%s and %s" % (name, n), "World and 42")

    pi = 3.14159
    tested = tested + 1
    total = total + check("percent_float_precision", "pi is about %.2f" % pi, "pi is about 3.14")

    tested = tested + 1
    total = total + check("percent_d_conv", "n=%d" % n, "n=42")

    tested = tested + 1
    total = total + check("percent_escape_with_operator", "%d%% done" % n, "42% done")

    return test_summary("string_percent_format_test", total, tested)
