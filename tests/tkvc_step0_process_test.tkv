# -*- coding: utf-8 -*-
# BUOC 0 - chung minh mot chuong trinh TokenVector THUAN co the khoi dong
# tien trinh khac va nhan exit code. Day la dieu kiet tien yet cho mot compiler
# viet bang TokenVector: no PHAI goi `ilasm.exe` de bien dich `.il` -> `.exe`.
#
# Ket qua probe (2026-10-02): P/Invoke qua `__tkv_extern_pinvoke__` + `system()`
# cua CRT CHAY DUOC. Khong can `CreateProcessA` (do phai con tro cau truc
# `PROCESS_INFORMATION`, ma TokenVector chi truyen struct bang `Ten*`).
#
# Tai sao dung `system()` chu khong dung `CreateProcessA`: `system()` tra thang
# exit code truc tiep, khong can struct nao, con `CreateProcessA` thi phai co
# dia chi con tro toi `PROCESS_INFORMATION` de no ghi ket qua - va TokenVector
# chua co toan tu lay dia chi cho struct.
__tkv_extern_pinvoke__ = [
    {"name": "system", "dll": "msvcrt.dll", "symbol": "system", "convention": "cdecl",
     "params": ["str"], "returns": "i32"},
]

def make_il(il_path: "str") -> "str":
    nl = chr(10)
    q = chr(34)
    b = ""
    b = ".assembly extern mscorlib {}" + nl
    b = b + ".assembly TKVProbe {}" + nl
    b = b + ".module TKVProbe.exe" + nl
    b = b + ".class public auto ansi Program extends [mscorlib]System.Object" + nl
    b = b + "{" + nl
    b = b + "    .method public static void Main() cil managed" + nl
    b = b + "    {" + nl + "      .entrypoint" + nl + "      .maxstack 8" + nl
    b = b + "      ldstr " + q + "TKVC_ILASM_PROBE_OK" + q + nl
    b = b + "      call void [mscorlib]System.Console::WriteLine(string)" + nl
    b = b + "      ret" + nl
    b = b + "    }" + nl
    b = b + "  }" + nl
    path_write_text(il_path, b)
    return b

def run() -> "i32":
    total = 0
    checked = 0

    tmp = os_getenv("TEMP")
    il_dir = "C:" + chr(92) + "Windows" + chr(92) + "Microsoft.NET" + chr(92) + "Framework" + chr(92) + "v4.0.30319"
    ilasm = path_join(il_dir, "ilasm.exe")
    il = path_join(tmp, "tkvc_probe.il")
    exe = path_join(tmp, "tkvc_probe_ilasm.exe")

    checked = checked + 1
    if file_exists(ilasm) == 0:
        print("FAIL khong tim thay ilasm.exe tai " + il_dir)
        total = total + 1
    else:
        print("PASS tim thay ilasm.exe")

    if file_exists(exe) != 0:
        os_remove(exe)
    make_il(il)
    q = chr(34)
    inner = q + ilasm + q + " /exe /output:" + q + exe + q + " " + q + il + q
    rc = system("cmd.exe /S /C " + q + inner + q)
    checked = checked + 1
    if rc == 0 and file_exists(exe) != 0:
        print("PASS ilasm rc=0 va da tao .exe")
    else:
        print("FAIL ilasm rc=" + str(rc) + " exe_ton_tai=" + str(file_exists(exe)))
        total = total + 1

    bad = path_join(tmp, "tkvc_probe_bad.il")
    path_write_text(bad, "day KHONG phai IL hop le")
    inner2 = q + ilasm + q + " /exe /output:" + q + path_join(tmp, "tkvc_probe_bad.exe") + q + " " + q + bad + q
    rc2 = system("cmd.exe /S /C " + q + inner2 + q + " >nul 2>nul")
    checked = checked + 1
    if rc2 != 0:
        print("PASS ilasm tra rc != 0 khi IL sai (rc=" + str(rc2) + ") - loi bi phat hien")
    else:
        print("FAIL ilasm tra rc=0 cho IL sai")
        total = total + 1

    out_txt = path_join(tmp, "tkvc_probe_run.txt")
    if file_exists(out_txt) != 0:
        os_remove(out_txt)
    rc3 = system("cmd.exe /S /C " + q + q + exe + q + " > " + q + out_txt + q + q)
    checked = checked + 1
    if rc3 == 0 and path_read_text(out_txt).strip() == "TKVC_ILASM_PROBE_OK":
        print("PASS exe vua sinh chay duoc va in dung chuoi")
    else:
        print("FAIL exe vua sinh rc=" + str(rc3))
        total = total + 1

    print("")
    print("=== tkvc_step0_process: " + str(checked - total) + "/" + str(checked) + " PASS ===")
    if total == 0:
        return 0
    return 1
