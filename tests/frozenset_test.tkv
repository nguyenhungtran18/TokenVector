__tkv_import__ = ["tkv_test_lib"]

def run() -> "i32":
    total = 0
    tested = 0

    lst = [1, 2, 3, 2, 1]
    fs = frozenset(lst)
    tested = tested + 1
    total = total + check("frozenset_dedup_len", str(len(fs)), "3")

    has2 = 0
    if 2 in fs:
        has2 = 1
    tested = tested + 1
    total = total + check("frozenset_in_true", str(has2), "1")

    has99 = 0
    if 99 in fs:
        has99 = 1
    tested = tested + 1
    total = total + check("frozenset_in_false", str(has99), "0")

    xs = fs.to_list()
    s = 0
    for x in xs:
        s = s + x
    tested = tested + 1
    total = total + check("frozenset_to_list_sum", str(s), "6")

    return test_summary("frozenset_test", total, tested)
