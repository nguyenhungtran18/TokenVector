# -*- coding: utf-8 -*-
"""Thu vien test dung chung THUAN TokenVector - import qua '__tkv_import__
= "tkv_test_lib"' vao bat ky file test nao (khong copy-paste check()/
summary moi lan). Muc tieu: cu phap CHUAN, LAP LAI DUOC cho viec test cac
file .tkv thu vien/engine se viet trong tuong lai - KHONG lien quan viec
kiem tra ban than compiler tkvc.exe."""


def check(name: "str", got: "str", expected: "str") -> "i32":
    """1 ca kiem tra: so sanh 'got' (ket qua THAT) voi 'expected' (ket
    qua MONG DOI, ban tu tinh tay/doi chieu Python/toan hoc). Tra ve 1
    neu PASS, 0 neu FAIL - cong don vao 'total' o ham goi."""
    if got == expected:
        print("PASS " + name)
        return 1
    else:
        print("FAIL " + name + " got=" + got + " expected=" + expected)
        return 0


def test_summary(suite_name: "str", total: "i32", tested: "i32") -> "i32":
    """Goi 1 LAN DUY NHAT cuoi ham run() sau khi cong don het cac check().
    In dong tong ket chuan, tra ve MA THOAT chuan (0 = het PASS, dung lam
    exit code cua chuong trinh - vd 'echo %ERRORLEVEL%' sau khi chay .exe
    kiem tra duoc ca tu dong hoa/CI, khong chi doc mat)."""
    print("")
    print("=== " + suite_name + ": " + str(total) + "/" + str(tested) + " PASS ===")
    if total == tested:
        return 0
    return 1
