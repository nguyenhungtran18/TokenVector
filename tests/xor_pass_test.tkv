# -*- coding: utf-8 -*-
"""GATE CHO HAI LENH NGU NGU THIEU (2026-09-28): toan tu '^' va lenh 'pass'.

Ca hai deu bi compiler TU CHOI truoc day, va ca hai deu la thu TokenVector
khac Python ma nguoi dung se gap ngay:

  - `a ^ b`: '^' KHONG nam trong _EXPR_TOKEN_RE nen chet ngay o tokenizer
    voi loi chung chung "khong tokenize duoc bieu thuc tai ' ^ b)". Loi do
    KHONG noi len la thieu toan tu, nen nguoi dung tuong la day la da thu
    sai cu phap chu khong phai thieu tinh nang.
  - `pass`: "khong dich duoc dong: 'pass'". Thanh method rong trong class la
    vi du pho bien nhat (stub), va `syntax_baseline.tkv` co ghi chu ve
    `pass` trong khi danh chung mot file mau da khong con ton tai.

Gia tri mong doi tinh tay theo quy tac Python, KHONG chay CPython de sinh
ra (theo khuon cua Testkit: so sanh ngay trong code).

Ve thu tu uu tien cua '^' - Python: '|' < '^' < '&' < '<<'/'>>' < '+-' < '*/'.
  1 | 2 ^ 3  ==  1 | (2 ^ 3)  ==  1 | 1  ==  1
  1 ^ 3 & 2  ==  1 ^ (3 & 2)  ==  1 ^ 2  ==  3
Hai dong nay THAT BAY loi uu tien sai (de '^' nao cung rut len truoc hoac
sau thieu) - nen chung la 2 trong 2 dong kiem tra gia tri nghich dau nay.
"""

__tkv_import__ = ["tkv_test_lib"]


def xor_truth_table() -> "i32":
    total = 0
    tested = 0

    total = total + check("xor_12_10", str(12 ^ 10), "6")
    tested = tested + 1
    total = total + check("xor_same_zero", str(5 ^ 5), "0")
    tested = tested + 1
    total = total + check("xor_zero_zero", str(0 ^ 0), "0")
    tested = tested + 1
    total = total + check("xor_hex", str(240 ^ 15), "255")
    tested = tested + 1
    total = total + check("xor_one_ten", str(1 ^ 10), "11")
    tested = tested + 1

    # Bit cao cua 0x80 khong bi lan sang byte kieu 'or' se lam.
    total = total + check("xor_high_bit", str(128 ^ 1), "129")
    tested = tested + 1

    return total


def xor_precedence() -> "i32":
    """'|' < '^' < '&' - kiem bang gia tri NGHICH DAU theo Python."""
    total = 0
    tested = 0

    # 1 | (2 ^ 3) = 1 | 1 = 1   (neu '^' nao cung thi ra 1 ^ 1 = 0)
    total = total + check("prec_or_below_xor", str(1 | 2 ^ 3), "1")
    tested = tested + 1
    # 1 ^ (3 & 2) = 1 ^ 2 = 3   (neu '&' nao cung thi ra (1 ^ 3) & 2 = 0)
    total = total + check("prec_and_above_xor", str(1 ^ 3 & 2), "3")
    tested = tested + 1
    # 1 | 2 ^ 3 & 4 = 1 | (2 ^ 0) = 1 | 2 = 3
    total = total + check("prec_all_three", str(1 | 2 ^ 3 & 4), "3")
    tested = tested + 1

    return total


def xor_with_bignum() -> "i32":
    """'int' (TkvInt, so nguyen vo han) phai di duong i64 nhu '&'/'|'.

    `int("...")` CHUOI literal >2^31 thi R6 tu suy ra i64. Kieu so DO
    (khong phai chuoi) thi `int()` van i32, nen hang so phai vao qua
    chuoi/int64 - va neu nham se bao loi luc bien dich chu khong phat ra
    IL sai."""
    total = 0
    tested = 0

    a = int("4294967296")
    b = int(255)
    total = total + check("xor_int_low_byte", str(a ^ b), "4294967551")
    tested = tested + 1
    total = total + check("xor_int_self", str(a ^ a), "0")
    tested = tested + 1

    return total


def xor_i64_full_width() -> "i32":
    """XOR tren i64 phai giu duoc ca 64 bit, khong cat con 32.

    `int64()` la duong 64-bit RIENG (R6): `int()` mac dinh i32 nen hang so
    lon >2^31 di qua no se bao loi. Do la khuon dung khi can 64-bit."""
    total = 0
    tested = 0

    got_wide = int64(4294967296)
    got = got_wide ^ 255
    total = total + check("xor_i64_keeps_full_width", str(got), "4294967551")
    tested = tested + 1

    got_same = got_wide ^ got_wide
    total = total + check("xor_i64_self_is_zero", str(got_same), "0")
    tested = tested + 1

    return total


def xor_in_loop_accumulates() -> "i32":
    """XOR phai tinh dung tren bien, khong phai chi hang so."""
    total = 0
    tested = 0

    acc = 0
    for i in range(4):
        acc = acc ^ (i + 1)
    # 0^1=1, 1^2=3, 3^3=0, 0^4=4
    total = total + check("xor_loop_acc", str(acc), "4")
    tested = tested + 1

    return total


class Stub:
    """`pass` trong than method rong - vi du pho bien nhat cua lenh nay."""
    value: "i32"

    def __init__(self, value: "i32") -> "i32":
        self.value = value
        return 0

    def nothing(self) -> "i32":
        pass

    def something(self) -> "i32":
        pass
        return self.value


def pass_in_plain_body() -> "i32":
    total = 0
    tested = 0

    total = total + check("pass_class_stub_returns", str(Stub(5).nothing()), "0")
    tested = tested + 1
    total = total + check("pass_then_stmt_runs", str(Stub(5).something()), "5")
    tested = tested + 1
    return total


def pass_in_every_block() -> "i32":
    """`pass` phai hop le o MOI noi co the co khoi rong: if/except/for/while."""
    total = 0
    tested = 0

    def only_pass() -> "i32":
        pass
        return 7

    total = total + check("pass_only_stmt", str(only_pass()), "7")
    tested = tested + 1

    n = 0
    if n > 0:
        pass
    else:
        n = 1
    total = total + check("pass_in_if_branch", str(n), "1")
    tested = tested + 1

    got = 0
    try:
        raise ValueError("x")
    except:
        got = 2
        pass
    total = total + check("pass_in_except", str(got), "2")
    tested = tested + 1

    s = 0
    for i in range(3):
        if i == 1:
            pass
        s = s + i
    total = total + check("pass_in_for", str(s), "3")
    tested = tested + 1

    w = 0
    while w < 2:
        w = w + 1
        pass
    total = total + check("pass_in_while", str(w), "2")
    tested = tested + 1

    return total


def pass_does_not_swallow_neighbours() -> "i32":
    """Canh bao: `pass` phai CHI khop DUNG chu 'pass'.

    Neu khop moi 'pass' (vi du bang `startswith`) thi 1 bien ten chua 'pass'
    se bi nuot im lang - nhanh hon ca loi bao, va la loi kho phat hien."""
    total = 0
    tested = 0

    passed = 5
    total = total + check("identifier_with_pass_prefix", str(passed), "5")
    tested = tested + 1

    return total


def run() -> "i32":
    total = 0
    tested = 0

    total = total + xor_truth_table()
    total = total + xor_precedence()
    total = total + xor_with_bignum()
    total = total + xor_i64_full_width()
    total = total + xor_in_loop_accumulates()
    total = total + pass_in_plain_body()
    total = total + pass_in_every_block()
    total = total + pass_does_not_swallow_neighbours()

    # Dem so ca thu cong. Neu them/bot 1 check o bat ky ham con nao, sua
    # dong nay - test_summary in tong ra so khai bao nen lech se loi ngay.
    # 6 (xor_truth_table) + 3 (xor_precedence) + 2 (xor_with_bignum)
    # + 1 (xor_in_loop_accumulates) + 2 (xor_i64_full_width)
    # + 2 (pass_in_plain_body) + 6 (pass_in_every_block) + 1 (neighbours) = 25
    return test_summary("xor_pass_test", total, 22)
