# EXPECT-SUBSTRING: phai la list/dict literal
# -*- coding: utf-8 -*-
# Dict tao roi gan khoa (`{}` roi `d["a"] = 1`) co khoa CHAY moi biet, nen
# khong gan duoc vao tham so luc bien dich. Phai tu choi ro rang.
def k2(a: "i32", b: "i32") -> "i32":
    return a * 10 + b


def run() -> "i32":
    kw = {}
    kw["a"] = 1
    kw["b"] = 2
    return k2(**kw)
