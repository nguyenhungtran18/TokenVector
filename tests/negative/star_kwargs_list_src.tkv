# EXPECT-SUBSTRING: nguon '**' phai la dict literal
# -*- coding: utf-8 -*-
# `**` chi nhan dict; truyen list se khong gan duoc khoa nao vao tham so, nen
# phai bi tu choi RO RANG thay vi bien dich sai am tham.
def k2(a: "i32", b: "i32") -> "i32":
    return a * 10 + b


def run() -> "i32":
    return k2(**[1, 2])
