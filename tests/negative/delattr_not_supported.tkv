# EXPECT-SUBSTRING: STRUCT
# -*- coding: utf-8 -*-
# `delattr(o, "x")` PHAI bi tu choi o BIEN DICH.
#
# Khong thuc hien duoc: field cua record la FIELD CUA STRUCT trong IL, so
# luong va vi tri da CHOT luc bien dich. Khong the "xoa" 1 field ma giu nguyen
# phan tu - neu gia tri gia se hong IL, neu bo qua thi sai nghĩa so voi
# Python. Nen phai bao loi ro, kem goi y dung `del xs[i]` cho container.
class P:
    x: "i32"


def run() -> "i32":
    o = P(1)
    delattr(o, "x")
    print("should_not_build")
    return 0