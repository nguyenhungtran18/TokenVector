# EXPECT-SUBSTRING: khong co tham so keyword
# -*- coding: utf-8 -*-
# Keyword sai ten phai bi tu choi RO RANG. Bo qua qua di im lang la loai sai
# am thanh nguy hiem nhat: `max(xs, keyy=f)` se bien dich thanh max(xs) va
# cho ket qua DUNG SO VOI y nguoi viet - test nao cung xanh.
def by_len(s: "str") -> "i32":
    return len(s)


def f(xs: "list[str]") -> "str":
    return max(xs, keyy=by_len)


def run() -> "i32":
    print("should_not_build")
    return len(f(["a"]))