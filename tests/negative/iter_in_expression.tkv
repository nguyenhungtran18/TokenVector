# EXPECT-SUBSTRING: chi ho tro o VI TRI GAN
# -*- coding: utf-8 -*-
# `iter()` chi ho tro o VI TRI GAN (`it = iter(xs)`). `next(iter(xs))` la 1
# bien dich doc lap ma khong co con tro nao de gan - phai bao loi ro chu khong
# duoc bien dich im lang hay bao loi chung chung "ham khong ton tai".
def f(a: "list[i32]") -> "i32":
    return next(iter(a))


def run() -> "i32":
    print("should_not_build")
    return f([1, 2])