# EXPECT-SUBSTRING: khong phai bien LIST
# -*- coding: utf-8 -*-
# `yield from` chi ho tro bien LIST va goi ham generator. Nguon khac phai bi
# tu choi VOI LY DO ro rang - neu im lang sinh IL sai thi loi chi lo ra luc
# chay, hoac (te hon) khong lo ra bao gio.
#
# Do 2026-09-29 khi them `yield from`: chi ho tro 2 dang nay.
def not_a_list() -> "list[i32]":
    n = 5
    yield from n
    yield 1


def run() -> "i32":
    for v in not_a_list():
        print(str(v))
    return 0
