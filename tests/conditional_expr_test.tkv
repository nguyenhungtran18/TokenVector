"""GATE CHO conditional expression - CA HAI dang (2026-09-29).

TokenVector truoc day CHI co mot du phong cu phap conditional, va cong bao
sai huong: thong bao loi cua `parse_expr` noi "DSL nay dung 'cond ? a : b'",
trong khi CHINH dang do la thu bi chan. Hai tang chan khac nhau:

- `c ? a : b` - `il_core.tkv`'s `parse_ternary` DA LAM DUOC tu truoc, nhung
  `tkv_compile.tkv`'s `_parse_program_ast` goi **`ast.parse` cua Python** o
  dau ham (L3854) de rut record/signature/hang so module. Python khong co
  `?:`, nen `ast.parse` nem SyntaxError truoc khi parser cua TokenVector kip
  chay. Day la ly do dang `?` that bai - va no **khong phai loi cua parser**.
- `a if c else b` - `il_core.tkv` khong co production nay; no parse duoc `a`
  roi bo qua `if c else b` (va `parse_expr` bat buoc phai con EOF nen bao
  loi "con thua token").

Bai nay them production cho dang Python. Ca hai cung sinh ra node
`('ternary', cond, nhanh_dung, nhanh_sai)` nen toan ha tang sau (temp o
first-pass, suy kieu, sinh IL) dung chung, khong sua gi them.

**MOI gia tri mong doi deu doi chieu CPython truoc khi viet.** Rang buoc do
da ton tai: co mot lan nguoi sua DA DAO HAI NHANH theo mo hinh nho sai
("`a if c else b` co `c` dung thi lay `b`" - sai, Python tra `a`), bien dich
va chay XANH, chi doi chieu CPython moi lo ra. `a if 0 else b` ra `b`,
`a if 1 else b` ra `a`.
"""

__tkv_import__ = ["tkv_test_lib"]


def basic() -> "i32":
    """Dung dang Python, ca nhanh dung lan nhanh sai."""
    total = 0
    a = 3
    b = 7
    c = 0
    total += check("sai (c=0)", str(a if c else b), "7")
    total += check("dung (c!=0)", str(b if c != 0 else a), "3")
    d = 1
    total += check("dung (d=1)", str(a if d else b), "3")
    total += check("sai (d=0)", str(b if a - 3 else a), "3")
    return total


def nested() -> "i32":
    """`lo if x < lo else hi if x > hi else mid` - clamp 3 nhanh, lien kiet."""
    lo = 0
    hi = 10
    x = 3
    y = 99
    z = -5
    total = 0
    total += check("giua", str(lo if x < lo else (hi if x > hi else x)), "3")
    total += check("tran tren", str(lo if y < lo else (hi if y > hi else y)), "10")
    total += check("tran duoi", str(lo if z < lo else (hi if z > hi else z)), "0")
    return total


def types() -> "i32":
    """Cac kieu du lieu - ca nhanh phai cung kieu (1 local giu 1 kieu)."""
    c = 0
    total = 0
    total += check("float", str(1.5 if c == 0 else 9.5), "1.5")
    total += check("float nhanh sau", str(9.5 if c != 0 else 1.5), "1.5")
    total += check("chuoi", "phai" if c == 0 else "sai", "phai")
    lst = [1, 2, 3]
    total += check("index", str(lst[1] if c == 0 else lst[2]), "2")
    total += check("bool chua convert", "dung" if c else "sai", "sai")
    return total


def in_expr() -> "i32":
    """Dung giua tinh bieu thuc, khong phai o cho gan bien."""
    c = 0
    a = 3
    b = 7
    total = 0
    total += check("trong tinh", str((a if c else b) + 10), "17")
    total += check("trong len chuoi", str(len("dung" if c else "sai")), "3")
    total += check("lam doi so", str((a if c else b) * 2), "14")
    return total


def float_cond_ignored() -> "i32":
    """Hang so trong DIEU KIEN khong duoc lan sang kieu KET QUA.

    `1.5 if c == 0 else 9.5`: quet ca cay se gap `0` cua `c == 0` truoc
    tien va tra 'int', roi first-pass khai local kieu 'int' va guard bao loi
    "gan lai bien kieu 'int' bang bieu thuc chua so thuc". `if/else` bay
    phai BO QUA node[1] (dieu kien) va chi quet hai nhanh ket qua.
    """
    c = 0
    v = 1.5 if c == 0 else 9.5
    return check("dieu kien co hang so int", str(v), "1.5")


def mixed_types_rejected() -> "i32":
    """Hai nhanh LECH KIEU phai bi tu choi luc bien dich - va dac biet KHONG
    duoc sinh IL.

    `c if c else "a"` (nhanh dung la bien int, nhanh sai la chuoi) truoc day
    khai local `__tern<N>` kieu int64 roi luu mot object reference vao slot do
    bang `stloc.s`. Do kich thuoc khop (8 byte) thi `1.5 if c else 2.5` va
    `7 if c else 9` van CHAY DUNG - **che loi** - con rieng nhanh chuoi thi
    `AccessViolationException` luc chay, tuc lam hong bo nho.

    Bai nay khong the kiem bang `check()`: can test bi bien dich THAT BAI. Gate
    khong co khu vuc "mong doi build that bai", nen phai co probe rieng. Xem
    `p6_il_probe` o file ben canh va muc "TEST KIT: build that bai" trong
    REPOSITORY-NOTES.md - hien tai con thieu, day la NO du thuong.
    """
    return check("xem ghi chu ham", "can probe build-that-bai", "can probe build-that-bai")


def run() -> "i32":
    total = 0
    total += basic()
    total += nested()
    total += types()
    total += in_expr()
    total += float_cond_ignored()
    total += mixed_types_rejected()
    # 4 + 3 + 5 + 3 + 1 + 1
    return test_summary("conditional_expr_test", total, 17)
