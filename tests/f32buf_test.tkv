# -*- coding: utf-8 -*-
"""GATE CHO kieu container `f32buf` (2026-09-29, P6 buoc 1).

`f32buf(n)` la bo dem f32 native DO DUAN so huu: `Marshal.AllocHGlobal` + mot
local an giu chieu dai. No la substrate ma P6 can de tu dong vector hoa, vi
`v_load4`/`v_store4` doc 16 byte LIEN TIEP nen can dia chi vung nho lien tiep -
va `List<T>` khong cho lay dia chi ma khong cham field private `_items` cua BCL
(da bi tu choi co chu dich, xem `vector4_type.tkv` muc "SUBSTRATE").

CHI DUNG THAO TAC: tao, `b[i]`, `a[i] = v`, `len(b)`. Khong co `.append`, khong
cat, khong duyet, khong `in`. Moi thu khac bi tu choi - de doan, khong de im
lang lam sai.

Gia tri mong doi tinh tay. Moi phan tu la `ldind.r4`/`stind.r4` cua .NET, nen
ket qua phai BIT-EXACT - cung tinh chat ma P6 se dua vao.
"""

__tkv_import__ = ["tkv_test_lib"]


def construction() -> "i32":
    total = 0
    tested = 0
    a = f32buf(4)
    total += check("length after construction", str(len(a)), "4")
    tested += 1
    b = f32buf(1)
    total += check("length one", str(len(b)), "1")
    tested += 1
    c = f32buf(100)
    total += check("length hundred", str(len(c)), "100")
    tested += 1
    return total


def write_then_read() -> "i32":
    total = 0
    tested = 0
    a = f32buf(4)
    a[0] = 1.5
    a[3] = 2.5
    total += check("read back first", str(a[0]), "1.5")
    tested += 1
    total += check("read back last", str(a[3]), "2.5")
    tested += 1
    a[1] = 9.25
    total += check("overwrite middle", str(a[1]), "9.25")
    tested += 1
    return total


def loop_fill() -> "i32":
    """Vong lap ghi day - dung hinh dang ma P6 se nhan dien de vector hoa."""
    total = 0
    tested = 0
    a = f32buf(4)
    i = 0
    while i < 4:
        a[i] = i * 1.5
        i = i + 1
    total += check("index 0", str(a[0]), "0.0")
    tested += 1
    total += check("index 2", str(a[2]), "3.0")
    tested += 1
    total += check("index 3", str(a[3]), "4.5")
    tested += 1
    return total


def loop_read_and_sum() -> "i32":
    """Doc va cong don trong vong lap - day KHONG phai elementwise nen P6 khong
    duoc vector hoa (se can dung sai 1e-5). Bai nay kiem gia tri dung, va la
    bang chung cho ly do do la giang khu vong."""
    total = 0
    tested = 0
    a = f32buf(3)
    a[0] = 7.0
    a[1] = 8.0
    a[2] = 9.0
    s = 0.0
    i = 0
    while i < 3:
        s = s + a[i]
        i = i + 1
    total += check("sum of three", str(s), "24.0")
    tested += 1
    return total


def two_buffers_independent() -> "i32":
    """Hai buffer phai doc lap - moi buffer 1 vung rieng, va DO DAI phai theo
    tien bien nao (local an dinh theo TEN bien)."""
    total = 0
    tested = 0
    a = f32buf(2)
    b = f32buf(5)
    a[0] = 1.0
    b[0] = 2.0
    b[4] = 3.0
    total += check("lengths differ", str(len(a)) + "," + str(len(b)), "2,5")
    tested += 1
    total += check("values independent", str(a[0]) + "," + str(b[0]) + "," + str(b[4]), "1.0,2.0,3.0")
    tested += 1
    return total


def elementwise_pattern() -> "i32":
    """Dung dung hinh dang P6 se bien doi: `r[i] = a[i] + b[i]` tren 3 f32buf.
    Ket qua phai BIT-EXACT so voi phep cong TUNG PHAN TU - day la tieu chi
    ma buoc P6-2 se kiem chung bang cach so sanh voi ban viet tay."""
    total = 0
    tested = 0
    a = f32buf(5)
    b = f32buf(5)
    r = f32buf(5)
    i = 0
    while i < 5:
        a[i] = 1.0
        b[i] = 2.0
        i = i + 1
    i = 0
    while i < 5:
        r[i] = a[i] + b[i]
        i = i + 1
    total += check("r[0]", str(r[0]), "3.0")
    tested += 1
    total += check("r[4]", str(r[4]), "3.0")
    tested += 1
    return total


def length_independent_of_content() -> "i32":
    """`len()` doc local an, khong phai dem gi tren vung nho - nen ghi bao nhieu
    the cung khong lam doi do dai."""
    total = 0
    tested = 0
    a = f32buf(4)
    total += check("before writes", str(len(a)), "4")
    tested += 1
    i = 0
    while i < 4:
        a[i] = 7.0
        i = i + 1
    total += check("after writes", str(len(a)), "4")
    tested += 1
    return total


def run() -> "i32":
    total = 0
    total += construction()
    total += write_then_read()
    total += loop_fill()
    total += loop_read_and_sum()
    total += two_buffers_independent()
    total += elementwise_pattern()
    total += length_independent_of_content()
    # 3 + 3 + 3 + 1 + 2 + 2 + 2
    return test_summary("f32buf_test", total, 16)
