# -*- coding: utf-8 -*-
# `pass` trong than record (2026-10-12) - gap CHUNG giua ca compiler Python
# bootstrap va compiler tu-host, da dong o compiler tu-host.
#
#   `class B(A): pass` la dang Python that binh thuong (lop con khai bao gi
#   them ma van thuoc pha he cua base). Truoc day ca 2 compiler nem
#   TranspileError "chi ho tro cac dong khai bao field DON THUAN..." o dong
#   `pass`. Bay gio `pass` duoc bo qua y het trong than record, cung duong voi
#   docstring da duoc bo qua truoc do.
#
#   PHAM VI: CHI `pass` trong than RECORD. `pass` trong than HAM da hoat dong
#   tu truoc. `pass` o cap module van bi tu choi dung ly do (module chi nhan
#   def/class/HANG SO/bien co kieu/`__tkv_import__`). Record chi co `pass` ma
#   khong field nao VAN la loi bien dich - dung, vi khong co gi de sinh.
__tkv_import__ = ["tkv_test_lib"]


class A:
    v: "i32"


class B(A):
    pass


class C(A):
    pass


class D(C):
    w: "i32"
    pass


class E:
    "tai lieu o dau than class"
    x: "i32"
    pass
    y: "i32"


class G(A):
    def twice(self) -> "i32":
        pass

    def show(self) -> "i32":
        return self.v * 2


def run() -> "i32":
    total = 0
    tested = 0

    b = B(4)
    tested = tested + 1
    total = total + check("pass_only_body", str(b.v), "4")

    c = C(7)
    tested = tested + 1
    total = total + check("pass_only_2", str(c.v), "7")

    # 3 cap ke thua deu la `pass`; `twice` co than RONG nen tra 0 (gia tri
    # mac dinh cua i32) - day la hanh vi DUNG, khong phai bug.
    g = G(3)
    tested = tested + 1
    total = total + check("pass_empty_method_ret", str(g.twice()), "0")

    # `pass` + field moi: ctor phai nhan field ke thua VA field moi
    d = D(5, 6)
    tested = tested + 1
    total = total + check("pass_plus_field", str(d.v + d.w), "11")

    # docstring + `pass` xen ke field
    e = E(1, 2)
    tested = tested + 1
    total = total + check("pass_docstring", str(e.x + e.y), "3")

    # `pass` trong than HAM chua bao gio bi chan
    tested = tested + 1
    total = total + check("pass_in_method", str(g.show()), "6")

    # 2026-10-12: dung `test_summary` thay vi `return total`. `check()` tra 1
    # khi PASS nen `total` la SO CA PASS - tra no lam gia tri cho run() thi
    # bay gio la EXIT CODE, va 6 ca pass se ra exit 6 (gate bao "EXIT6").
    # `test_summary` tra ve MA THOAT chuan: 0 = het PASS, 1 = co FAIL - doc
    # dung contract ma moi 118 test con lai dung.
    return test_summary("class_pass_test", total, tested)