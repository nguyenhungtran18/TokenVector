__tkv_import__ = ["tkv_test_lib"]

def run() -> "i32":
    total = 0
    tested = 0

    d1 = datetime()
    d2 = datetime()
    t1 = datetime_ticks(d1)
    t2 = datetime_ticks(d2)

    tested = tested + 1
    total = total + check("ticks_monotonic_or_equal", str(t2 >= t1), "True")

    tested = tested + 1
    total = total + check("ticks_plausible_magnitude", str(t1 > 600000000000000000), "True")

    return test_summary("datetime_ticks_test", total, tested)
