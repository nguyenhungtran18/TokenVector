# -*- coding: utf-8 -*-
"""GATE CHO `try/except/else` (2026-09-28).

`else` cua `try` chay khi va CHI khi khong co exception nao duoc bat - khac
han `finally`, luon chay. Truoc day TokenVector tu choi `else` (nhac lai: len
dau 2026-09-28, lan thu cai dat dau tien da phai REVERT vi nhan `else` bi phat
TRUOC `.try`, tao vong lap vo han).

Phan giai `else` khong ton tai "nhan chung" voi nhan ket thuc cua try. Sau khoi
`.try`, ca duong "khong co loi" va duong "handler da bat loi" deu la `leave` toi
CUNG mot nhan - nhin tu ben ngoai thi khong phan biet duoc. Vay phai tach nhan
NGAY TRONG than try: than try `leave` toi nhan rieng, handler van `leave` toi
nhan ket thuc, va `else` chen giua hai nhan do. Handler `leave` thang qua nhan
`else` nen no bi bo qua khi co loi - dung y nghia Python.

Gia tri mong doi tinh tay, so doi voi CPython 3.11 tren cung bo case.
"""

__tkv_import__ = ["tkv_test_lib"]


def else_runs_when_clean() -> "i32":
    """Khong co loi -> `else` chay, handler KHONG chay."""
    total = 0
    tested = 0
    log = ""
    try:
        log = log + "B"
    except ValueError as e:
        log = log + "H"
    else:
        log = log + "E"
    total += check("else runs when no exception", log, "BE")
    tested += 1
    return total


def else_skipped_when_caught() -> "i32":
    """Co loi duoc bat -> `else` bi BO QUA. Day la mau quan trong nhat: neu
    `else` chay o day, code se tiep tuc chay duong danh duong co loi."""
    total = 0
    tested = 0
    log = ""
    try:
        log = log + "B"
        raise ValueError("x")
    except ValueError as e:
        log = log + "H"
    else:
        log = log + "E"
    total += check("else skipped when handler caught", log, "BH")
    tested += 1
    return total


def else_skipped_when_unmatched() -> "i32":
    """Khong handler nao khop -> `else` van bi bo qua va loi noi ra ngoai.
    Hay bat loi theo loai KHAC - handler ghi H se khong chay, `else` se khong
    chay, va handler o ngoai bat duoc loi that."""
    total = 0
    tested = 0
    log = ""
    try:
        try:
            raise KeyError("k")
        except ValueError as e:
            log = log + "H"
        else:
            log = log + "E"
    except KeyError as e2:
        log = log + "O"
    total += check("else skipped when no handler matches", log, "O")
    tested += 1
    return total


def order_with_finally() -> "i32":
    """`else` chay TRUOC `finally` - Python: finally la lop bao ngoai nen no
    chay sau moi thu tinh xong. Thu tu phai la BEF."""
    total = 0
    tested = 0
    log = ""
    try:
        log = log + "B"
    except ValueError as e:
        log = log + "H"
    else:
        log = log + "E"
    finally:
        log = log + "F"
    total += check("else runs before finally", log, "BEF")
    tested += 1
    return total


def multiple_handlers() -> "i32":
    """`else` nam sau TAT CA cac `except`, va chi chay khi KHONG handler nao
    bat duoc - ke ca khi handler dau tien khop."""
    total = 0
    tested = 0
    # handler 1 khop
    log = ""
    try:
        raise ValueError("a")
    except ValueError as e:
        log = log + "1"
    except KeyError as e:
        log = log + "2"
    else:
        log = log + "E"
    total += check("first handler wins, else skipped", log, "1")
    tested += 1
    # handler 2 khop
    log = ""
    try:
        raise KeyError("b")
    except ValueError as e:
        log = log + "1"
    except KeyError as e:
        log = log + "2"
    else:
        log = log + "E"
    total += check("second handler wins, else skipped", log, "2")
    tested += 1
    # khong handler nao khop
    log = ""
    try:
        log = log + "B"
    except ValueError as e:
        log = log + "1"
    except KeyError as e:
        log = log + "2"
    else:
        log = log + "E"
    total += check("else runs after all handlers", log, "BE")
    tested += 1
    return total


def break_in_else() -> "i32":
    """`break` trong `else` chay duoc khi khong co `finally` - `else` duoc sinh
    NGOAI vung .try nen `br` thuan hop le. i=0,1 tang len 3 roi i==2 thi
    break, nen ket qua 3 khong phai 5."""
    total = 0
    tested = 0
    n = 0
    for i in range(5):
        try:
            n = n + 1
        except ValueError as e:
            n = 0
        else:
            if i == 2:
                break
    total += check("break inside else", str(n), "3")
    tested += 1
    return total


def _via_handler() -> "i32":
    try:
        k = 1
    except ValueError as e:
        return 10
    else:
        return 20
    return 99


def _via_handler_raising() -> "i32":
    try:
        raise ValueError("z")
    except ValueError as e:
        return 10
    else:
        return 20
    return 99


def return_in_else() -> "i32":
    """`return` trong `else` phai ra luon - dong `return 99` sau khoi try khong
    bao gio chay."""
    total = 0
    tested = 0
    total += check("return in else", str(_via_handler()), "20")
    tested += 1
    total += check("return in handler, else skipped", str(_via_handler_raising()), "10")
    tested += 1
    return total


def run() -> "i32":
    total = 0
    total += else_runs_when_clean()
    total += else_skipped_when_caught()
    total += else_skipped_when_unmatched()
    total += order_with_finally()
    total += multiple_handlers()
    total += break_in_else()
    total += return_in_else()
    # 1 + 1 + 1 + 1 + 3 + 1 + 2
    return test_summary("try_except_else_test", total, 10)
