# -*- coding: utf-8 -*-
# Chuoi tam nhay `"""..."""` - mot dong va nhieu dong.
#
# Truoc day khong ho: parser doc TUNG DONG nen `"""` dong tren 1 dong khong
# dong duoc, va regex token khong co nhom tam nhay (no khop `""` roi le
# `m<nh dau>` thanh bien). Bai 2026-09-29 bo bang:
#   - `_join_triple_quoted` trong il_codegen.tkv noi cac dong cho khi dong,
#     doi newline thanh escape 2 ky tu `\` + `n` ngay tai noi noi dong;
#   - nhom `TRIPLESTR` trong `_EXPR_TOKEN_RE` (il_core.tkv) nhan noi dung.
#
# Luu y: chuoi IL cua .NET PHAI la MOT DONG, nen newline trong chuoi tam
# nhay duoc bien thanh escape truoc khi vao `ldstr`. Neu bo qua, ilasm bao
# "syntax error" - cai loi nay da gap that khi thu lai dau tien.
def one_line() -> "str":
    return """một dòng"""


def three_lines() -> "str":
    return """dòng một
dòng hai
dòng ba"""


def has_quotes() -> "str":
    return """chứa "dấu nháy" và nội dung nữa"""


def escapes() -> "str":
    return """tab:\there\nva-dau-xuong-dong"""


def unicode_ok() -> "str":
    return """tiếng Việt có dấu: ễ ọ ư ỗ"""


def hash_inside() -> "str":
    return """a # b"""


def joined(a: "str", b: "str") -> "str":
    return a + b


def count_char(s: "str", ch: "str") -> "i32":
    """Dem so lan `ch` xuat hien trong `s` - tu viet vi khong tin
    `str.count()` co san hay khong."""
    n = 0
    for part in s.split(ch):
        n += 1
    return n - 1


def run() -> "i32":
    fail = 0
    a = one_line()
    b = three_lines()
    c = has_quotes()
    d = escapes()
    e = unicode_ok()
    f = hash_inside()
    g = joined("""x""", """y""")
    if a == "một dòng":
        print("ok  1. tam nhay mot dong")
    else:
        print("FAIL 1. tam nhay mot dong")
        fail += 1
    if len(b) == 25:
        print("ok  2. tam nhay ba dong - do dai dung")
    else:
        print("FAIL 2. tam nhay ba dong - do dai dung")
        fail += 1
    if count_char(b, "\n") == 2:
        print("ok  3. hai newline that nam trong chuoi")
    else:
        print("FAIL 3. hai newline that nam trong chuoi")
        fail += 1
    if "\"dấu nháy\"" in c:
        print("ok  4. dau nhay kep ben trong khong lam hong ldstr")
    else:
        print("FAIL 4. dau nhay kep ben trong khong lam hong ldstr")
        fail += 1
    if "\t" in d and "\n" in d:
        print("ok  5. escape \\t va \\n giu nguyen")
    else:
        print("FAIL 5. escape \\t va \\n giu nguyen")
        fail += 1
    if e == "tiếng Việt có dấu: ễ ọ ư ỗ":
        print("ok  6. unicode trong tam nhay")
    else:
        print("FAIL 6. unicode trong tam nhay")
        fail += 1
    if f == "a # b":
        print("ok  7. dau # trong chuoi khong bi cat thanh chu thich")
    else:
        print("FAIL 7. dau # trong chuoi khong bi cat thanh chu thich")
        fail += 1
    if g == "xy":
        print("ok  8. tam nhay trong bieu thuc goi va noi noi dung")
    else:
        print("FAIL 8. tam nhay trong bieu thuc goi va noi noi dung")
        fail += 1
    print(fail)
    return fail
