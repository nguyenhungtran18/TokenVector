# -*- coding: utf-8 -*-
# Ghim cac thu DA DUNG chuyen bi bao o la loi (2026-09-30) trong khi ra soat
# so sanh voi CPython. Khong phai de sua bug - de LAN SAU khong do lai mot
# lan nua va bao nham.
#
#   1. `__eq__` / `__lt__` / `__gt__` / `__str__` tren record: HOAT DONG.
#      CLAUDE.md va docs tung ghi "__lt__/__gt__ dang hong - tra hang, bo than
#      ham" - do sai. Nguyen nhan toi bao loi la TEST: method phai THUT LONG
#      trong than class, dat o cap module thi compiler khong dang ky.
#   2. Chien tuple: hoat dong dung phan tu nao cung ra phan tu do.
#   3. Chuoi da byte (tieng Viet co dau, CJK): len/index/slice/find/upper/
#      replace/strip/split deu KHOP CPython - chi khu vuc ngoai BMP moi lech.
__tkv_import__ = ["tkv_test_lib"]


def pick(c: "bool") -> "str":
    if c:
        return "True"
    return "False"


class P:
    v: "i32"

    def __init__(self, v: "i32"):
        self.v = v

    def __eq__(self, o: "P") -> "i32":
        return 1 if self.v == o.v else 0

    def __lt__(self, o: "P") -> "i32":
        return 1 if self.v < o.v else 0

    def __str__(self) -> "str":
        return "P(" + str(self.v) + ")"


def run() -> "i32":
    total = 0
    tested = 0

    # --- 1. so sanh tren record ---
    a = P(3)
    b = P(3)
    c = P(5)
    tested = tested + 1
    total = total + check("rec_eq_same", pick(a == b), "True")
    tested = tested + 1
    total = total + check("rec_eq_diff", pick(a == c), "False")
    tested = tested + 1
    total = total + check("rec_ne_diff", pick(a != c), "True")
    tested = tested + 1
    total = total + check("rec_lt", pick(a < c), "True")
    tested = tested + 1
    total = total + check("rec_lt_rev", pick(c < a), "False")
    tested = tested + 1
    total = total + check("rec_gt", pick(c > a), "True")
    tested = tested + 1
    total = total + check("rec_str", str(a), "P(3)")

    # --- 2. chien tuple ---
    t = (5, 7)
    x, y = t
    tested = tested + 1
    total = total + check("tuple_x", str(x), "5")
    tested = tested + 1
    total = total + check("tuple_y", str(y), "7")
    f = 1.5
    g = 2.5
    tf = (f, g)
    p, q = tf
    tested = tested + 1
    total = total + check("tuple_float_p", str(p), "1.5")
    tested = tested + 1
    total = total + check("tuple_float_q", str(q), "2.5")

    # --- 3. chuoi da byte ---
    e = "é"
    cafe = "caf" + e
    sl = cafe[3:4]
    tested = tested + 1
    total = total + check("mb_len_cafe", str(len(cafe)), "4")
    tested = tested + 1
    total = total + check("mb_len_tieng", str(len("Tiếng")), "5")
    tested = tested + 1
    total = total + check("mb_len_cjk", str(len("日本語")), "3")
    tested = tested + 1
    total = total + check("mb_slice_eq", pick(sl == e), "True")
    tested = tested + 1
    total = total + check("mb_find", str(cafe.find(e)), "3")
    tested = tested + 1
    total = total + check("mb_replace", cafe.replace(e, "E"), "cafE")
    up = "Tiếng"
    tested = tested + 1
    total = total + check("mb_upper", up.upper(), "TIẾNG")
    sp = "  " + e + " "
    tested = tested + 1
    total = total + check("mb_strip", sp.strip(), e)
    src = "a" + e + ",b"
    parts = src.split(",")
    tested = tested + 1
    total = total + check("mb_split0", parts[0], "a" + e)

    return test_summary("rec_tuple_mb_test", total, tested)
