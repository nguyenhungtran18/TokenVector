def and_true(n: "i32") -> "i32":
    lst = []
    lst.append(7)
    i = 0
    if i < n and lst[i] == 7:
        return 1
    return 0

def or_short(n: "i32") -> "i32":
    lst = []
    lst.append(7)
    i = 5
    if n > 0 or lst[i] == 7:
        return 1
    return 0

def chain(a: "i32", b: "i32", c: "i32") -> "i32":
    if a < b and b < c:
        return 1
    return 0

def mixed(a: "i32", b: "i32") -> "i32":
    if a > 0 and b > 0 or a < 0:
        return 1
    return 0
