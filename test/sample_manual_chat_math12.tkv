def is_prime(n: "i32") -> "i32":
    if n < 2:
        return 0
    i = 2
    while i < n:
        if n % i == 0:
            return 0
        i += 1
    return 1


def count_primes_upto(n: "i32") -> "i32":
    count = 0
    num = 2
    while num < n:
        is_p = 1
        i = 2
        while i < num:
            if num % i == 0:
                is_p = 0
                break
            i += 1
        if is_p == 1:
            count += 1
        num += 1
    return count


def gcd_euclid(a: "i32", b: "i32") -> "i32":
    x = a
    y = b
    while y != 0:
        temp = y
        y = x % y
        x = temp
    return x


def lcm_via_gcd(a: "i32", b: "i32") -> "i32":
    if a == 0:
        return 0
    if b == 0:
        return 0
    x = a
    y = b
    while y != 0:
        temp = y
        y = x % y
        x = temp
    gcd_val = x
    res = a * b / gcd_val
    return res


def is_perfect_square(n: "i32") -> "i32":
    if n < 0:
        return 0
    i = 0
    while i * i <= n:
        if i * i == n:
            return 1
        i += 1
    return 0


def sum_of_digits(n: "i32") -> "i32":
    sum_val = 0
    temp = n
    while temp > 0:
        digit = temp % 10
        sum_val += digit
        temp = temp / 10
    return sum_val


def reverse_number(n: "i32") -> "i32":
    rev = 0
    temp = n
    while temp > 0:
        digit = temp % 10
        rev = rev * 10 + digit
        temp = temp / 10
    return rev


def is_palindrome_number(n: "i32") -> "i32":
    rev = 0
    temp = n
    while temp > 0:
        digit = temp % 10
        rev = rev * 10 + digit
        temp = temp / 10
    if rev == n:
        return 1
    else:
        return 0


def power_int(base: "i32", exp: "i32") -> "i32":
    res = 1
    i = 0
    while i < exp:
        res = res * base
        i += 1
    return res


def fibonacci_nth(n: "i32") -> "i32":
    if n == 0:
        return 0
    if n == 1:
        return 1
    a = 0
    b = 1
    i = 2
    while i <= n:
        c = a + b
        a = b
        b = c
        i += 1
    return b


def collatz_steps(n: "i32") -> "i32":
    steps = 0
    temp = n
    while temp > 1:
        if temp % 2 == 0:
            temp = temp / 2
        else:
            temp = temp * 3 + 1
        steps += 1
    return steps


def digital_root(n: "i32") -> "i32":
    temp = n
    while temp > 9:
        sum_val = 0
        curr = temp
        while curr > 0:
            digit = curr % 10
            sum_val += digit
            curr = curr / 10
        temp = sum_val
    return temp
