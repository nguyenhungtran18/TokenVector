def fact(n: "i32") -> "int":
    total = 1
    i = 1
    while i <= n:
        total = total * i
        i = i + 1
    return total


def pow2(n: "i32") -> "int":
    r = 1
    i = 0
    while i < n:
        r = r + r
        i = i + 1
    return r


def sum_to(n: "i32") -> "int":
    s = 0
    i = 1
    while i <= n:
        s = s + i
        i = i + 1
    return s


def big_minus(n: "i32") -> "int":
    a = fact(n)
    b = fact(n)
    return a - b


def cmp_big(n: "i32") -> "i32":
    a = fact(n)
    b = fact(n)
    c = a + 1
    if a == b:
        if c > a:
            if a < c:
                return 1
    return 0


def run(what: "str", n: "str") -> "str":
    k = int(n)
    if what == "fact":
        return str(fact(k))
    if what == "pow2":
        return str(pow2(k))
    if what == "sum":
        return str(sum_to(k))
    if what == "minus":
        return str(big_minus(k))
    if what == "cmp":
        return str(cmp_big(k))
    return "?"
