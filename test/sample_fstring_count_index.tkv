def greet(name: "str", age: "i32") -> "str":
    return f"Hello {name}, ban {age} tuoi"


def count_and_find(target: "i32") -> "i32":
    lst = []
    lst.append(3)
    lst.append(7)
    lst.append(3)
    lst.append(3)
    lst.append(9)
    c = lst.count(target)
    i = lst.index(7)
    return c * 100 + i
