# -*- coding: utf-8 -*-
"""Mau chinh thuc cho duck-typing qua type-inference tinh (Task 5/5, xem
docs/superpowers/plans/2026-08-17-duck-typing-inference.md). Gop cac case
DA XAC NHAN hoat dong dung qua Task 4 report + task4-critical-fix-report
(field, method, toan tu qua CUNG 1 dinh nghia nguon, ke thua, cache,
fixpoint 2 tang, generator goi ham inferred) thanh 1 chuong trinh chay
duoc qua main().

Record khong ke thua chung:
  Point(x, y)   - dung cho test field/toan tu scalar-hoa.
  Box(w, h)     - field 'w'/'h' KHAC ten Point, dung de test loi thieu field
                  (o file test rieng, khong dua vao day vi se lam main() loi).

Ke thua:
  Animal (cha) co field 'legs' + method speak().
  Dog(Animal)  ke thua ca hai, KHONG khai lai.

Toan tu qua CUNG 1 ham nguon 'add_them':
  goi voi (i32, i32) VA (Vec2, Vec2) - Vec2 co __add__.
"""


class Point:
    x: "i32"
    y: "i32"

    def __init__(self, x, y):
        self.x = x
        self.y = y


class Vec2:
    x: "i32"
    y: "i32"

    def __init__(self, x, y):
        self.x = x
        self.y = y

    def __add__(self, other: "Vec2") -> "i32":
        # Chu y: return_type cua ham 'add_them' (goi ben duoi) LUON co dinh
        # theo dinh nghia nguon (khong duoc suy tu tham so inferred - xem
        # spec muc "return type van theo co che khai bao hien co"), nen
        # __add__ tra "i32" (KHONG tra Vec2) de dam bao 2 ban monomorphize
        # cua add_them (i32,i32) va (Vec2,Vec2) DEU tra ve i32 nhat quan.
        return (self.x + other.x) + (self.y + other.y)


class Animal:
    legs: "i32"

    def __init__(self, legs):
        self.legs = legs

    def speak(self) -> "i32":
        return self.legs * 10


class Dog(Animal):
    def __init__(self, legs):
        self.legs = legs


# --- Step 1: field, tham so inferred, 2 kieu record khac nhau (Task 4 Test 2) ---
def get_x(p) -> "i32":
    return p.x


# --- Step 2: method, tham so inferred ---
def get_legs_score(a) -> "i32":
    return a.speak()


# --- Step 3: toan tu, CUNG 1 dinh nghia nguon cho ca scalar VA record co dunder ---
def add_them(a, b) -> "i32":
    return a + b


def main() -> "i32":
    p = Point(10, 20)
    v1 = Vec2(1, 2)
    v2 = Vec2(3, 4)
    dog = Dog(4)
    x1 = 3
    x2 = 4

    field_sum = get_x(p)                 # 10
    method_sum = get_legs_score(dog)      # 40 (ke thua field+method tu Animal)
    scalar_sum = add_them(x1, x2)         # 7
    vec_sum = add_them(v1, v2)            # (1+3)+(2+4) = 10, qua __add__

    total = field_sum * 1000 + method_sum * 100 + scalar_sum * 10 + vec_sum
    return total
