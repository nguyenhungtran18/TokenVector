# -*- coding: utf-8 -*-
"""Generator o hai cho `.maxstack` van con la HANG SO 8 sau ban va A2.

A2 chi sua `gen_il_function`. Generator di duong khac (`gen_il_generator_
function`), nen hai cho duoi day van sinh IL khong hop le - ilasm van
dich, CLR nem InvalidProgramException LUC CHAY:

  1. WRAPPER: day 1 `ldarg.s` cho MOI tham so roi `newobj`, nen generator
     tu 9 THAM SO tro len tran stack.
  2. Than `MoveNext()`: mot loi goi 9 doi so BEN TRONG generator.
"""


def add9(a0: "i32", a1: "i32", a2: "i32", a3: "i32", a4: "i32", a5: "i32", a6: "i32", a7: "i32", a8: "i32") -> "i32":
    """Ham 9 tham so - de goi tu TRONG than generator (bay 2)."""
    return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8


def gen_wide(a0: "i32", a1: "i32", a2: "i32", a3: "i32", a4: "i32", a5: "i32", a6: "i32", a7: "i32", a8: "i32") -> "list[i32]":
    """BAY 1: generator 9 THAM SO - wrapper day 9 gia tri truoc `newobj`."""
    yield a0 + a1
    yield a2 + a3
    yield a4 + a5
    yield a6 + a7
    yield a8


def gen_calls9(n: "i32") -> "list[i32]":
    """BAY 2: loi goi 9 doi so nam TRONG than `MoveNext()`."""
    i = 0
    while i < n:
        yield add9(i, i + 1, i + 2, i + 3, i + 4, i + 5, i + 6, i + 7, i + 8)
        i = i + 1


def demo_wide() -> "i32":
    total = 0
    for x in gen_wide(1, 2, 3, 4, 5, 6, 7, 8, 9):
        total = total + x
    return total


def demo_calls9() -> "i32":
    total = 0
    for x in gen_calls9(3):
        total = total + x
    return total
