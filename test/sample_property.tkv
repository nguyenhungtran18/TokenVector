# -*- coding: utf-8 -*-
"""@property (Phase C.3, 2026-07-29, xem project-tokenvector-wave2-status
memory) - getter tinh toan tu field, truy cap nhu 1 field ('c.area', khong
'()') qua desugar AST->goi method that ('obj.propname' -> 'obj.propname()')
TRUOC KHI vao pipeline compile_attr binh thuong."""


class Circle:
    r: "f32"

    def __init__(self, r):
        self.r = r

    @property
    def area(self) -> "f32":
        return 3.0 * self.r * self.r

    @property
    def diameter(self) -> "f32":
        return self.r * 2.0


def demo_property() -> "f32":
    c = Circle(2.0)
    return c.area + c.diameter
