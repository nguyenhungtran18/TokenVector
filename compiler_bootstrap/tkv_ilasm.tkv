# -*- coding: utf-8 -*-
"""Rap IL thanh .exe bang ilasm.exe (tach khoi tokenvector_compile.py, 2026-09-24).

VI SAO TACH: tokenvector_compile.py lam HAI viec - (1) rap IL -> .exe, can cho
MOI duong bien dich ke ca ban tu-host; (2) bien dich MOT MODEL sklearn
(compile_model/_check_model...), KHONG lien quan viec compiler tu dich chinh
no. Gop chung thi ca file nam trong tap tu-host va ~90 loi cua phan (2) tinh
vao nen, du khong ham nao cua compiler goi toi no. Nay (1) o day - nam tren
duong tu-host; (2) o lai tokenvector_compile.py, ngoai tap tu-host.

Duong dan CHUOI (2026-09-24): thao tac he dieu hanh chua co builtin nam
trong cac ham nho (_xoa_neu_co/_cho_on_dinh/_mo_doc_thu/_chay_ilasm). Bai
`if __tkv_chi_cpython__:` dinh nghia lai y het hanh vi cu CHO PYTHON da bi
XOA (2026-10-12) - xem ghi chu ben duoi ham `_xoa_neu_co`. TokenVector co
duong dien danh rieng cho tung ham nen khong can shim.
"""
# Cac thao tac he dieu hanh ma ban tu-host CHUA co builtin (2026-09-24).
# 2026-10-12: XOA khoi `if __tkv_chi_cpython__:` o cuoi file - thu la ban
# CPython dinh nghia lai cac ham nay bang `os`/`subprocess`/`pathlib` that.
# TokenVector KHONG dung nhung ban do (cac ham o tren moi la ban TokenVector
# that, va `_chay_ilasm` goi thang `proc_ra(_find_ilasm(), ...)` chu khong
# qua bien `ILASM` cua ben CPython), nen xoa khong lam gi.
# Ben CPython can hanh vi Path cua `assemble_il_to_exe` thi tu chuyen sang
# goi bang chuoi - xem `tools/build_tkvc.ps1`.
def _xoa_neu_co(p: "str") -> "i32":
    """Xoa file neu ton tai. Ban tu-host: bo qua - ilasm ghi de /output."""
    return 0


def _cho_on_dinh() -> "i32":
    """Cho quet-khi-ghi cua Defender. Ban tu-host: khong cho."""
    return 0


def _mo_doc_thu(p: "str") -> "str":
    """Mo file .exe doc 64 byte; tra '' neu duoc, thong bao loi neu bi chan.
    Ban tu-host: chi kiem ton tai."""
    if path_isfile(p):
        return ''
    return 'khong mo duoc ' + p


def _chay_ilasm(cac_doi_so: "list[str]", tep_ra: "str") -> "i32":
    """Chay ilasm, ghi stdout+stderr vao tep_ra, tra ma thoat."""
    chuoi = ''
    for d in cac_doi_so:
        if chuoi != '':
            chuoi = chuoi + ' '
        chuoi = chuoi + '"' + d + '"'
    return proc_ra(_find_ilasm(), chuoi, tep_ra)


def _doi_duoi(p: "str", duoi: "str") -> "str":
    """Doi phan mo rong (nhu Path.with_suffix): cat tu dau '.' cuoi cung
    NAM SAU dau phan cach thu muc cuoi cung."""
    cham = p.rfind('.')
    xet = p.rfind('/')
    xet2 = p.rfind('\\')
    if xet2 > xet:
        xet = xet2
    if cham > xet + 1:
        return p[:cham] + duoi
    return p + duoi


def _la_windows() -> "i32":
    """Ban tu-host chay tren .NET Framework - chi co Windows."""
    return True




def _find_ilasm() -> "str":
    """Tu do tim ilasm.exe tren MAY DICH bat ky (Wave 3, 2026-07-29 -
    "TokenVector - Only" portable folder) - KHONG the dong goi rieng
    ilasm.exe mang di may khac (da tu kiem chung THAT: copy rieng file
    nay ra ngoai thu muc cai dat .NET Framework bao STATUS_DLL_NOT_FOUND,
    no phu thuoc cac DLL khac nam CUNG thu muc cai dat, khong phai file
    doc lap) - nen thay vi hard-code 1 duong dan CO DINH (chi dung tren
    may nay), do tim qua CA 2 thu muc chuan (Framework64/Framework) x
    CAC phien ban .NET Framework co the co, uu tien ban moi nhat. May
    dich CHI can co san .NET Framework 4.x (rat pho bien tren Windows,
    khong can cai them gi khac) la chay duoc, khong con phu thuoc DUY
    NHAT 1 duong dan tuyet doi cua may nay."""
    # Chuoi thay Path (2026-09-24): do CAC thu muc phien ban da biet theo thu
    # tu ten GIAM DAN - cung ket qua voi cach cu (liet ke roi sort theo ten
    # thu muc, Framework64 truoc khi trung ten).
    candidates = []
    for ver in ['v4.0.30319', 'v2.0.50727', 'v1.1.4322', 'v1.0.3705']:
        for root in ['C:\\WINDOWS\\Microsoft.NET\\Framework64',
                     'C:\\WINDOWS\\Microsoft.NET\\Framework']:
            exe = path_join(path_join(root, ver), 'ilasm.exe')
            if path_isfile(exe):
                candidates.append(exe)
    if len(candidates) == 0:
        raise RuntimeError(
            "\n[tkvc] KHONG tim thay .NET Framework tren may nay (can de bien dich/chay .tkv).\n"
            "  Tai va cai .NET Framework 4.8 (chinh thuc tu Microsoft, mien phi) tai:\n"
            "  https://dotnet.microsoft.com/en-us/download/dotnet-framework/net48\n"
            "  Sau khi cai xong, chay lai lenh nay - KHONG can lam gi them.\n"
            "  (TokenVector KHONG tu dong tai/cai - de ban tu quyet dinh va thuc hien.)\n")
    return candidates[0]





class TokenVectorError(Exception):
    msg: "str"


class AvBlockedError(TokenVectorError):
    """Windows Defender chan/cach ly .exe VUA dung xong.

    KHONG phai loi bien dich - la duong tinh GIA cua bo phan loai hoc may
    (ho '!ml', vd Trojan:Win32/Wacatac.B!ml). Xem docstring cua
    assemble_il_to_exe ve LY DO va CACH tranh.

    Truong `msg` ke thua tu TokenVectorError (2026-09-25: khai lai o day bi
    trinh that tu choi - ghi de truong ke thua chua ho tro)."""


def assemble_il_to_exe(il_text: "str", out_exe: "str", debug: "i32" = False) -> "str":
    """Ghi IL ra file roi goi ilasm, TRANH khuon hanh vi ma Defender gan
    cho dropper malware (2026-08-05).

    ## Van de THAT (khong phai suy doan - da doc nhat ky Defender)

    Event 1116/1117: 'Trojan:Win32/Wacatac.B!ml' tren _arb_*.exe, Action
    Quarantine, Process Name = python.exe. Hau to '!ml' = phan quyet cua
    MO HINH heuristic, khong phai chu ky. Wacatac.B!ml la ten noi tieng
    nhat trong nhom duong-tinh-gia voi mot PE VUA duoc bien dich. Bo ba
    dac trung day diem qua nguong:
      1. PE HOAN TOAN MOI, prevalence = 0 (chua tung ton tai o dau).
      2. Khong ky so, nam trong %TEMP%.
      3. Do python.exe ghi ra roi CHAY NGAY - dung khuon dropper.
    Chay lai thi xanh vi ilasm nhung MVID (GUID ngau nhien) + timestamp
    moi moi lan -> bytes khac -> diem ML khac -> khi thi tren khi thi
    duoi nguong. Tuc diem nam SAT nguong; hich bat ky yeu to nao xuong
    la du.

    ## Cach tranh (khong tat Defender, khong them ngoai le)

    - Goi o day KHONG con ghi vao %TEMP% (caller chon out_exe trong cay
      repo) - go yeu to (2), la yeu to quyet dinh: FP CHI xay ra o duong
      arbiter, duong duy nhat truoc day dung %TEMP%.
    - Sau khi ilasm xong, MO file de doc mot lan: buoc nay dong bo voi
      quet-khi-truy-cap cua Defender (RTP quet luc mo), nen khi CHAY sau
      do khong con kich hoat duong FastPath-khi-thuc-thi hung hon. Neu bi
      chan, chinh open() nem OSError NGAY TAI DAY - bat duoc, bao ro, va
      dung lai bang mot lan nem AvBlockedError co ten, thay vi mot cu sap
      kho hieu luc chay o tan noi khac.
    - Bi chan thi DUNG LAI mot lan: ilasm lai cho bytes moi (MVID/
      timestamp khac) -> diem ML khac -> gan nhu chac chan qua. Day chinh
      la co che dang sau 'chay lai la xanh', nay tu dong.
    """

    il_path = _doi_duoi(out_exe, '.il')
    write_file(il_path, il_text)
    tep_ra = _doi_duoi(out_exe, '.ilasm.txt')
    last_err = ''
    for attempt in range(2):
        _xoa_neu_co(out_exe)
        ilasm_args = [il_path, '/exe', '/output:' + out_exe]
        if debug:
            ilasm_args.append('/debug')
        code = _chay_ilasm(ilasm_args, tep_ra)
        if code != 0:
            raise TokenVectorError(
                f"ilasm.exe that bai (code {code}):\n"
                f"{read_file(tep_ra)}")
        if not _la_windows():
            return out_exe
        # Cho quet-khi-ghi (bat dong bo) cua RTP kip bat dau, roi MO file
        # de bien no thanh diem dong bo (quet-khi-truy-cap).
        _cho_on_dinh()
        # Loi mo = WinError 225 'file contains a virus' hoac 'Access denied'
        # khi Defender dang cach ly: AV chan, khong phai loi doc thuong.
        last_err = _mo_doc_thu(out_exe)
        if last_err == '':
            return out_exe
    raise AvBlockedError(
        f"Windows Defender chan .exe vua dung ({path_basename(out_exe)}) sau 2 lan thu "
        f"- duong tinh gia '!ml' (xem docstring assemble_il_to_exe). "
        f"Nguyen nhan goc: {last_err}")
