    # qua bang de nua: no la `parse_typed_signature(<van ban>)`, mot HAM
    # THUAN chi can dung dong nguon - cung khuon voi `type_ann`. Ba truong
    # do first-pass tinh ra (`captures`/`closure_class`/`hidden_local`)
    # nam trong `ctx.nested_closures[<ten>]`, khong phai o day.
    "nested_def": "body,sig_text",
