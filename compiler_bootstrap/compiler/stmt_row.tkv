    "for_in_dict_items": "key_var,val_var,dict_name,body",
    "for_in_generator": "var,callee_name,arg_nodes_text,body",
    # `for_in_call_list` KHONG co producer rieng - chi toi duoc qua BANG DE
    # KIND tu 'for_in_generator' (generator_lazy). Row van la dong
    # 'for_in_generator', chi `kind_of` doc ra ten khac - nen layout phai
    # GIONG HET, neu khong thi tra cuu truong se truot im lang.
    "for_in_call_list": "var,callee_name,arg_nodes_text,body",
}


def _layout_of(kind: "str") -> "list[str]":
    """Danh sach ten truong cua `kind`; RONG neu kind chua chuyen sang row.

    Truoc 2026-09-18 ham nay tra `tuple(...)` HOAC `None` - mot union, va
    la mot trong nhung thu chan phep gop tai file nay. Doi `None` thanh
    DANH SACH RONG thi kieu tro nen don nhat ma khong mat thong tin nao:
    moi cho dung `lay` chi lam ba viec - `x in lay`, `lay.index(x)`, va
    phan biet "kind chua co row".

    DANH SACH RONG PHAN BIET DUOC that: `break` va `continue` CO layout
    nhung spec la chuoi rong, va `"".split(",")` cho `[""]` - mot phan tu,
    khong phai rong. Nen `[]` van chi co mot nghia duy nhat la "khong co
    layout". (Da kiem: 61 kind co layout, dung hai kind spec rong.)"""
    spec = _LAYOUT.get(kind)
    return [] if spec is None else spec.split(",")


# ---------------------------------------------------------------------------
# DOC TRUONG: ban CO KIEU
#
# `get()` tra ve chuoi / so / danh sach / `TypeAnn` / `Signature` tuy KHOA,
# nen khong mot kieu tra ve nao dung cho no - do la rao CUOI CUNG cua
# `stmt_row` tren duong gang. Cach go giong het `expr_row` o phep lat dau
# phien: mot ham noi bo tra VAN BAN O THO (luon la `str`, khai duoc that),
# roi moi accessor CO KIEU tu giai ma.
#
# Da do 2026-09-18 tren 458 diem goi: str 201 | TkvNode 127 | than 72 |
# list[TkvNode] 19 | handlers 15 | i32 9 | list[str] 6 | TypeAnn 5 |
# Signature 2 | byte 1. Moi diem goi KHOA DONG deu lap tren mot bo khoa
# DONG NHAT KIEU nen chon accessor tinh duoc het.
# ---------------------------------------------------------------------------


def _o_hang(stmt: "i32", key: "str") -> "str":
    """Van ban tho cua o `key`; None neu kind khong co o do.

    Ten co hau to `_hang` chu khong phai `_o_tho` nhu ban song sinh ben
    `expr_row`: phep gop lam phang MOI module vao MOT chuong trinh, nen
    hai ham cung ten o hai file la loi trung ten - va no chi lo ra khi
    phep gop di du xa de cham ca hai file."""
    lay = _layout_of(kind_of_stmt(stmt))
    if key not in lay:
        return None
    return field(stmt, lay.index(key))


def lay_str(stmt: "i32", key: "str") -> "str":
    """Truong VAN BAN. `kind` di qua day luon cho tien."""
    if key == "kind":
        return kind_of_stmt(stmt)
    return _o_hang(stmt, key)


def lay_i32(stmt: "i32", key: "str") -> "i32":
    """Truong SO ('dim'/'dim0'/'dim1'/'step', va 'src_line')."""
    if key == "src_line":
        return src_line_of(stmt)
    v = _o_hang(stmt, key)
    if v is None:
        return None
    return int(v)


def lay_nut(stmt: "i32", key: "str") -> "TkvNode":
    """Truong NODE BIEU THUC - o luu thang chi so, hoac van ban parse luoi.

    Giu nguyen thu tu uu tien va phep nho dem cua `get()` cu: o THANG
    thang o VAN BAN, va ban parse luoi phai nho dem theo `(chi so, khoa)`
    de danh tinh node on dinh qua CA HAI pass."""
    v = _o_hang(stmt, key)
    if v is not None:
        return int(v)
    v = _o_hang(stmt, key[:-5] + "_text")
    if v is None:
        return None
    khoa = _khoa_memo(stmt, key)
    # 'in' thay '.get(k) is None' (2026-09-25): gia tri la SO (chi so node),
    # None khong co dang i32 o ban tu-host.
    if khoa in _MEMO_NUT:
        return _MEMO_NUT[khoa]
    hit = parse_expr(v)
    _MEMO_NUT[khoa] = hit
    return hit


def lay_than(stmt: "i32", key: "str") -> "list[i32]":
    """Truong THAN - row giu chi so vung, phoi ra chinh list Python."""
    v = _o_hang(stmt, key)
    if v is None:
        return None
    return body_of(int(v))


def _lay_ds_so(stmt: "i32", key: "str") -> "list[i32]":
    """Than chung cua hai ban danh sach SO (node / byte) - co nho dem."""
    v = _o_hang(stmt, key + "_text")
    if v is None:
        return None
    _bo = _KHOA_DS[key]
    khoa = _khoa_memo(stmt, key)
    van = _MEMO_DS.get(khoa)
    if van is None:
        if _bo == "byte_literal":
            hit = _giai_ma_ds_byte(v)
        else:
            hit = _giai_ma_ds_nut(_bo, v)
        _MEMO_DS[khoa] = ",".join([str(x) for x in hit])
        return hit
    if van == "":
        return []
    # bien lap `t` (khong phai `x`): `x` o tren la int, ten chi co MOT local/ham (2026-09-29)
    return [int(t) for t in van.split(",")]


def lay_ds_nut(stmt: "i32", key: "str") -> "list[TkvNode]":
    """Truong DANH SACH NODE."""
    return _lay_ds_so(stmt, key)


def lay_ds_byte(stmt: "i32", key: "str") -> "list[i32]":
    """Truong DANH SACH BYTE ('values' cua 'assign_bytes_literal')."""
    return _lay_ds_so(stmt, key)


def lay_ds_str(stmt: "i32", key: "str") -> "list[str]":
    """Truong DANH SACH TEN. KHONG nho dem: memo ton tai de giu DINH DANH
    node on dinh giua hai pass, chuoi khong co nhu cau do."""
    v = _o_hang(stmt, key + "_text")
    if v is None:
        return None
    return _giai_ma_ds_ten(_KHOA_DS[key], v)


def lay_type_ann(stmt: "i32") -> "TypeAnn":
    """Truong KIEU - row luu van ban, parse lai (ham thuan)."""
    v = _o_hang(stmt, "type_text")
    if v is None:
        return None
    return parse_type_ann_str_mo(v)


def lay_chu_ky(stmt: "i32") -> "Signature":
    """Chu ky cua 'nested_def' - row luu van ban dong 'def'."""
    v = _o_hang(stmt, "sig_text")
    if v is None:
        return None
    return parse_typed_signature_mo(v)


def lay_handlers_vung(stmt: "i32") -> "list[i32]":
    """CHI SO VUNG than cua tung 'except' trong 'try' - goi `body_of` de
    lay than that.

    `get(stmt,'handlers')` cu ghep HAI truong song song thanh danh sach
    CAP `(ten ngoai le, than)` - mot `list[(str, list[i32])]`, kieu KHONG
    bieu dien duoc (phan tu tuple phai vo huong). Nhung hang VON DA luu
    hai truong song song; chinh `get` moi la cho zip chung lai mot cach
    gia tao.

    Tra CHI SO chu khong tra than: mot danh sach CAC THAN la
    `list[list[i32]]`, cung khong bieu dien duoc (container cap module lan
    kieu long deu chi nhan vo huong). Day la lan thu hai trong cung mot
    ham toi suyt khai mot kieu long - lan dau la `_BODIES`."""
    v = _o_hang(stmt, "handlers_body")
    if v is None:
        return []
    return [int(b) for b in v.split(",")]


def lay_handlers_exc(stmt: "i32") -> "list[str]":
    """Ten lop ngoai le cua tung 'except', SONG SONG voi
    `lay_handlers_than`. 'except:' tran -> phan tu la chuoi RONG."""
    v = _o_hang(stmt, "handlers_exc")
    if v is None:
        return []
    return [(t.strip() or None) for t in v.split(",")]


