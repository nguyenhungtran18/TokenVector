def items_nut(stmt: "i32") -> "list[(str,TkvNode)]":
    """CAP (ten truong, node) cho moi truong `*_node` CO gia tri.

    Thay cho `items()` o cac ham DUYET CHUNG khong biet truoc kind. Cap
    `(str, TkvNode)` BIEU DIEN DUOC vi ca hai phan tu deu vo huong - khac
    `items()` cu, tra ca chuoi lan so lan danh sach lan `TypeAnn` nen
    khong mot kieu nao dung."""
    spec = _KHOA_LOGIC.get(kind_of_stmt(stmt))
    if spec is None:
        return []
    ra = []
    for k in spec.split(","):
        if not k.endswith("_node"):
            continue
        v = lay_nut(stmt, k)
        if v is not None:
            ra.append((k, v))
    return ra


def cac_than_vung(stmt: "i32") -> "list[i32]":
    """CHI SO VUNG cua moi truong THAN co gia tri - goi `body_of` de lay
    than. Khong tra thang cac than vi mot danh sach cac than la
    `list[list[i32]]`, kieu khong bieu dien duoc.

    CHI cac khoa trong `_KHOA_THAN` - KHONG gom than cua `handlers`. Ban
    `items()` cu cung khong gom (khoa 'handlers' khong qua `la_khoa_than`
    va gia tri cua no khong lot nhanh nao), nen giu dung hanh vi do."""
    spec = _KHOA_LOGIC.get(kind_of_stmt(stmt))
    if spec is None:
        return []
    ra = []
    for k in spec.split(","):
        if k not in _KHOA_THAN:
            continue
        v = _o_hang(stmt, k)
        if v is not None:
            ra.append(int(v))
    return ra


def cac_nut_trong_ds(stmt: "i32") -> "list[TkvNode]":
    """MOI node nam trong cac truong DANH SACH NODE, gop phang.

    Khong tra cap `(ten, danh sach)`: do la `list[(str, list[TkvNode])]`,
    lai mot kieu long. Cho dung duy nhat (`closures`) khong can ten
    truong, chi duyet qua tung node."""
    spec = _KHOA_LOGIC.get(kind_of_stmt(stmt))
    if spec is None:
        return []
    ra = []
    for k in spec.split(","):
        if k not in _KHOA_DS:
            continue
        if _KHOA_DS[k] not in _MEMO_DS_DUOC or _KHOA_DS[k] == "byte_literal":
            continue
        _nguon_lap2 = lay_ds_nut(stmt, k)
        if not _nguon_lap2:
            _nguon_lap2 = []
        for x in _nguon_lap2:
            ra.append(x)
    return ra


def set_(stmt: "i32", key: "str", value: "str") -> "i32":
    """Ghi mot truong. Row la CHUOI bat bien -> tra ve BAN SAO (mot CHI SO
    MOI); caller PHAI dung gia tri tra ve."""
    if not isinstance(stmt, int):
        # Xem chu thich cung loai o `with_src_line`.
        raise TypeError(
            "stmt_row.set_: nhan dict - moi cau lenh phai la CHI SO row")
    if key == "src_line":
        return with_src_line(stmt, int(value))
    lay = _layout_of(kind_of_stmt(stmt))
    if key not in lay:
        raise KeyError("stmt_row.set_: kind '" + kind_of_stmt(stmt) + "' khong co truong '" + key + "'")
    if key in _KHOA_THAN:
        # Than la list Python SUA TAI CHO - ghi de ca danh sach la mot thao
        # tac khac han, va chua kind nao can. Chan som con hon de no am tham
        # ghi mot chi so vung sai.
        raise KeyError("stmt_row.set_: truong than '" + key + "' sua TAI CHO qua body_of(), khong ghi de")
    parts = _STMT_POOL[stmt].split("	")
    j = lay.index(key) + 2
    while len(parts) <= j:
        parts.append(ABSENT)
    parts[j] = esc(value)
    return intern("	".join(parts))


def dat_nut(stmt: "i32", key: "str", node: "TkvNode") -> "i32":
    """Ghi mot node vao truong node, SUA TAI CHO row, tra ve chinh chi so cu.

    Neu kind luu truong do bang VAN BAN (`rhs_text`) ma khong co `<key>` trong
    layout, ghi vao memo cua `lay_nut` - do la noi duy nhat `lay_nut` tim
    truoc van ban parse luoi, nen caller van nhan node moi o CA HAI pass."""
    lay = _layout_of(kind_of_stmt(stmt))
    gia_tri = VANG if node is None else str(node)
    if key in lay:
        parts = _STMT_POOL[stmt].split("\t")
        j = lay.index(key) + 2
        while len(parts) <= j:
            parts.append(ABSENT)
        parts[j] = gia_tri
        _STMT_POOL[stmt] = "\t".join(parts)
        return stmt
    _MEMO_NUT[_khoa_memo(stmt, key)] = int(gia_tri)
    return stmt


def thay_nut(stmt: "i32", key: "str", node: "TkvNode") -> "i32":
    """Thay mot truong dang VAN BAN thanh node index (tra ve chinh chi so cu).

    Khong tao hang moi: pool sua tai cho duoc, va caller van giu cung mot chi
    so nen khong can viet nguoc vao cha."""
    return dat_nut(stmt, key, node)


def dat_ds_nut(stmt: "i32", key: "str", nodes: "list[TkvNode]") -> "i32":
    """Ghi mot DANH SACH node, sua tai cho row, tra ve chinh chi so cu.

    Neu kind luu truong danh sach bang van ban (`<key>_text`) thi ghi vao memo
    cua `_lay_ds_so`."""
    lay = _layout_of(kind_of_stmt(stmt))
    van = ",".join([VANG if x is None else str(x) for x in nodes])
    if key in lay:
        parts = _STMT_POOL[stmt].split("\t")
        j = lay.index(key) + 2
        while len(parts) <= j:
            parts.append(ABSENT)
        parts[j] = van
        _STMT_POOL[stmt] = "\t".join(parts)
        return stmt
    _MEMO_DS[_khoa_memo(stmt, key)] = van
    return stmt


# ---------------------------------------------------------------------------
# Truy cap theo TEN cho kind 'assign_scalar' (pilot P8 Task 3).
# ---------------------------------------------------------------------------

def assign_name(stmt: "i32") -> "str":
    """Ten bien duoc gan."""
    if not is_row(stmt):
        raise TypeError(
            "stmt_row: nhan dict - moi cau lenh phai la CHI SO row")
    return field(stmt, 0)


def assign_rhs_node(stmt: "i32") -> "TkvNode":
    """Node bieu thuc ve phai.

    Row luu ve phai bang VAN BAN nen phai `parse_expr` lai; danh tinh on
    dinh do `get()` nho dem theo `(chi so, ten truong)`.

    PHAI di qua `get()`, KHONG duoc tu goi `parse_expr`: mot duong parse thu
    hai khong qua nho dem se sinh tuple khac cho CUNG mot lan xuat hien, va
    `nid()` lai lech - dung loi da lam pilot 2026-09-08 vo ("bien
    '__idiv3_a' chua duoc khai bao"), va no tai dien ngay o lan chay dau cua
    3b-2 vi ham nay con duong rieng."""
    return lay_nut(stmt, "rhs_node")
