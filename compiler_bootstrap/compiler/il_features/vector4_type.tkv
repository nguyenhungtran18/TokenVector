# -*- coding: utf-8 -*-
"""Kieu `f32x4` qua System.Numerics.Vector4 - SIMD 4 lane, THUAN TOKENVECTOR.

PORT tu compiler/il_features/vector4_type.tkv (2026-10-06). Doi ten de
tranh trung sau gop (trung ten ham = loi build, xem complex_type.tkv da
phai dat `compile_binop_complex`/`compile_ctor` rieng):
`compile_binop` -> `compile_binop_vector4`, `compile_attr` ->
`compile_attr_vector4`, `compile_ctor` -> `compile_ctor_vector4`,
`scratch_locals` -> `scratch_locals_vector4`. `register_vector4_dtype`
giu nguyen (chua trung) va goi trong bootstrap_vector4.

Vong `for i, field in enumerate(...)` trong push_v_hsum4 viet lai vong
index tren list module `_VEC4_LANES` (tuple-unpack trong for khong chac).
`import il_features.vector_block` de o CAP MODULE (vector_block khong
import nguoc lai nen khong vong tron).
"""

from il_core import IL_SCALAR
from il_dispatch import register_expr_builtin
import il_features.vector_block as _vb

__tkv_import__ = "il_dispatch"

# Class ref TRAN (khong 'valuetype' o truoc) - dung sau '::' trong 1 loi
# goi static/instance method, giong COMPLEX_CLASS cua complex_type.tkv.
VEC4_CLASS = '[System.Numerics]System.Numerics.Vector4'
# Mo ta VALUETYPE day du - dung lam kieu tra ve/tham so va khai bao local.
VEC4 = f'valuetype {VEC4_CLASS}'

# Vector4 dinh nghia day du 4 toan tu hai tham so. KHONG phai goi
# `Add`/`Multiply` nhu Complex - Complex co method tinh, Vector4 dung
# operator (op_*) vi no la kieu vector.
_VEC4_BINOPS: "dict[str,str]" = {'+': 'op_Addition', '-': 'op_Subtraction', '*': 'op_Multiply', '/': 'op_Division'}

# 4 LANE. KHONG PHAI property!
#
# Do bang reflection tren chinh System.Numerics.dll cua .NET Framework 4.8:
#   - `op_Addition`/`op_Subtraction`/`op_Multiply`/`op_Division` CO (dung duoc)
#   - `X`/`Y`/`Z`/`W` la FIELD `Single`, KHONG co `get_X`/... (GetMethod('get_X')
#     = null). Nen phai `ldfld`, khong duoc `call get_X` - ban doan sai se
#     bien dich duoc roi nem MissingMethodException luc CHAY.
#   - property thi chi co 6 cai STATIC: Zero/One/UnitX/UnitY/UnitZ/UnitW
_VEC4_PROPS: "dict[str,str]" = {'x': 'X', 'y': 'Y', 'z': 'Z', 'w': 'W'}
_VEC4_LANES: "list[str]" = ['X', 'Y', 'Z', 'W']


def register_vector4_dtype():
    IL_SCALAR['f32x4'] = VEC4


def compile_binop_vector4(op: "str", left: "TkvNode", right: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """'+'/'-'/'*'/'/' giua 2 gia tri 'f32x4' - goi THANG operator cua
    BCL. Mot lenh `call` = 4 (hoac 8 voi AVX2) MAC cung luc."""
    if op not in _VEC4_BINOPS:
        raise SyntaxError(
            "il_codegen: '" + op + "' khong ho tro tren 'f32x4' (chi +,-,*,/ - "
            "khong co % va khong co so sanh kieu vector)")
    method = _VEC4_BINOPS[op]
    ctx.compile_expr(left, scope, out, 'f32x4', ctx)
    ctx.compile_expr(right, scope, out, 'f32x4', ctx)
    out.append(f'    call {VEC4} {VEC4_CLASS}::{method}({VEC4}, {VEC4})')


def compile_attr_vector4(obj_name: "str", field_name: "str", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'.x'/'.y'/'.z'/'.w' tren 1 bien 'f32x4' - doc LANE.

    `X`/`Y`/`Z`/`W` la FIELD (khong phai property). Dia chi qua
    ctx.load_var_addr (KHONG hardcode ten slot IL), giong het
    complex_type.tkv's compile_attr. Ket qua la f32 nen ep sang `dtype` ma
    ben ngoai yeu cau.
    """
    field = _VEC4_PROPS[field_name]
    ctx.load_var_addr(obj_name, scope, out)
    out.append(f'    ldfld float32 {VEC4_CLASS}::{field}')
    ctx.widen_if_needed('f32', dtype, out)


def compile_ctor_vector4(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'f32x4(a, b, c, d)' - constructor 4 tham so, ca 4 ep ve f32."""
    if len(args) != 4:
        raise SyntaxError(
            "il_codegen: f32x4() chi nhan DUNG 4 tham so (4 lane; khong co "
            "constructor 1/2/3 tham so va khong co literal vector)")
    for a in args:
        ctx.compile_expr(a, scope, out, 'f32', ctx)
    out.append(
        f'    newobj instance void {VEC4_CLASS}::.ctor(float32, float32, float32, float32)')


# Local nhap de gom 4 lane ve 1 so - xem push_v_hsum4. KHONG DUNG `stloc`
# truc tiep tren bien nguoi viet: gia tri f32x4 da nam tren stack, can noi
# trung gian de doc lai 4 field. Khai bao VO DIEU KIEN trong moi ham
# (mirror complex_type.tkv's SCRATCH_STR) vi khong co duong de "co ho tro
# khi can" - va 16 byte/ham la chi phi nho so voi do gianh.
SCRATCH_H4 = '__v4hsum'


def scratch_locals_vector4() -> "list[(str,str)]":
    """(ten, dtype) local nhap can khai bao VO DIEU KIEN o moi ham."""
    return [(SCRATCH_H4, 'f32x4')]


def push_v_hsum4(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_hsum4(v)' - gom 4 lane ve 1 f32.

    Thu tu cong: CHON TUAN TU `((X+Y)+Z)+W`, KHONG dung ghep cap
    `(X+Y)+(Z+W)` de tai tao dung phep cong cua vong scalar (xem giai thich
    day du o ban bootstrap). Ket qua lech so voi scalar nen so bang dung sai.
    """
    if len(args) != 1:
        raise SyntaxError("il_codegen: v_hsum4(v) chi nhan 1 tham so")
    ctx.compile_expr(args[0], scope, out, 'f32x4', ctx)
    out.append(f'    stloc.s {SCRATCH_H4}')
    # `add` phai nam GIUA hai lenh nap, khong phai sau moi lenh nap. Ban
    # dau tien emit `add` ngay sau ldfld X -> stack chi con 1 toan hang ->
    # InvalidProgramException luc chay (bat duoc nho day). Chi them `add`
    # TU LAN NHAI troi.
    for i in range(4):
        out.append(f'    ldloca.s {SCRATCH_H4}')
        out.append(f'    ldfld float32 {VEC4_CLASS}::{_VEC4_LANES[i]}')
        if i > 0:
            out.append('    add')


def push_v_load4(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_load4(p, off)' - NAP 16 BYTE (4 lane) tu dia chi native, tra 1
    gia tri 'f32x4'. MOT lenh `ldobj` doc nguyen 16 byte (`off` tinh theo
    BYTE, giong read_f32/write_f32). Substrate la CON TRO THO
    (`alloc_bytes`), giong v_load8."""
    if len(args) != 2:
        raise SyntaxError("il_codegen: v_load4(p, off) can dung 2 tham so")
    _vb._vb_addr(args[0], args[1], 0, scope, out, ctx)
    out.append(f'    ldobj {VEC4}')


def push_v_store4(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_store4(p, off, v)' - ghi 16 BYTE (4 lane) xuong dia chi native.

    `stobj` pop [dia chi, gia tri] - dia chi phai DAY DUOI."""
    if len(args) != 3:
        raise SyntaxError(
            "il_codegen: v_store4(p, off, v) can dung 3 tham so")
    _vb._vb_addr(args[0], args[1], 0, scope, out, ctx)
    ctx.compile_expr(args[2], scope, out, 'f32x4', ctx)
    out.append(f'    stobj {VEC4}')
    out.append('    ldc.i4 0')


def bootstrap_vector4(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_vector4_dtype()
    register_expr_builtin(reg, 'f32x4', compile_ctor_vector4, 'f32x4')
    register_expr_builtin(reg, 'v_load4', push_v_load4, 'f32x4')
    register_expr_builtin(reg, 'v_store4', push_v_store4, 'i32')
    register_expr_builtin(reg, 'v_hsum4', push_v_hsum4, 'f32')
