# -*- coding: utf-8 -*-
"""stdlib_shutil.py - Plug-and-Play module cho Shutil File Operations (rmtree)

Cung cap:
- shutil_rmtree(dir_path) -> i32
"""

import stmt_row as _row
import re
from il_core import parse_expr
from il_dispatch import register_assign_rhs_parser, register_first_pass_walk, register_stmt_codegen
from tkv_types import TypeAnn
from stmt_row import intern, lay_nut, lay_str, make3

_RMTREE_RE = re.compile(r'^shutil_rmtree\((.+)\)$')


__tkv_import__ = ["il_dispatch", "tkv_types"]

def try_rhs_shutil_rmtree(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    m = _RMTREE_RE.match(rhs.strip())
    if not m:
        return None
    return intern(make3('assign_shutil_rmtree', name, m.group(1)))


def fpw_shutil_rmtree(stmt: "i32", ctx: "WalkCtx"):
    ta = TypeAnn('i32', None)
    ctx.declare_named(lay_str(stmt, 'name'), ta)
    ctx.collect_ternary_temps(lay_nut(stmt, 'arg_node'))


def codegen_shutil_rmtree(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    ctx.compile_expr(lay_nut(stmt, 'arg_node'), scope, body, 'str', ctx)
    body.append('    ldc.i4.1')
    body.append('    call void [mscorlib]System.IO.Directory::Delete(string, bool)')
    body.append('    ldc.i4.1')
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def bootstrap_stdlib_shutil(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_assign_rhs_parser(reg, 'shutil_rmtree', try_rhs_shutil_rmtree)
    register_first_pass_walk(reg, 'assign_shutil_rmtree', fpw_shutil_rmtree)
    register_stmt_codegen(reg, 'assign_shutil_rmtree', codegen_shutil_rmtree)
