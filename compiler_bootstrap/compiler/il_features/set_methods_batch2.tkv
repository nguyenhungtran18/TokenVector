# -*- coding: utf-8 -*-
"""set.remove(x)/set.discard(x) + set.union/intersection/difference
(2026-07-29, Huong A stdlib mo rong - nhom rieng thu 8, mo rong tren
set_type.py da co san (chi co set()/.add()/'in') KHONG SUA file do, giong
tinh than list_methods_batch2/batch3, string_methods_batch2/batch3 -
nhom moi = file rieng.

Da xac minh truoc khi viet (PowerShell reflection tren
HashSet`1[int].GetMethods()): Remove(T) tra bool, UnionWith/IntersectWith/
ExceptWith(IEnumerable<T>) deu CO THAT.

remove()/discard() (2026-08-13, batch 5.5b muc cuoi): CA HAI cung goi
Remove(T) (tra bool). discard() BO QUA ket qua (hanh vi im lang giong
Python that). remove() KIEM TRA ket qua - neu False (phan tu khong co
trong set) nem KeyNotFoundException, khop voi 'except KeyError:' co san
trong DSL (xem _EXC_TYPE_MAP trong control_flow.py).

union/intersection/difference: tra ve 1 SET MOI (KHONG sua 2 set nguon) -
tao ban sao tu set thu 1 (HashSet<T>::.ctor(IEnumerable<T>), giong ky
thuat list_copy.py) ROI goi UnionWith/IntersectWith/ExceptWith voi set
thu 2 - CA 2 phai CUNG dtype phan tu.

TU 2026-08-03 (Giai doan 0.2 nhom 6): 3 method nay dang ky qua
register_expr_method nen chay duoc o MOI vi tri bieu thuc, KHONG con gioi
han "chi RHS truc tiep 1 phep gan"; duong ASSIGN_RHS_PARSERS/
FIRST_PASS_WALK/STMT_CODEGEN cu da BO HAN. Can 1 BIEN AN (co che nhom 3,
EXPR_METHOD_TEMPS) vi ban cu GHI THANG ket qua vao bien dich roi NAP LAI
de goi UnionWith - dang do khong the la 1 bieu thuc; nay ban sao nam
trong bien an, goi UnionWith tren no, roi 'ldloc' o cuoi de tra gia tri.
Kieu tra ve = DUNG kieu cua set thu 1 (ham phan giai, co che nhom 5)."""
from il_core import nid
import stmt_row as _row
import re

from il_dispatch import (
    register_line_parser, register_stmt_codegen, register_first_pass_walk,
    register_expr_method,
)
from il_features.set_type import il_set_type
from stmt_row import intern, lay_nut, lay_str, make3
from expr_row import ea_str, ec_ds, ekind
import il_extern_dtype

_SET_REMOVE_RE = re.compile(r'^(\w+)\.remove\((.+)\)\s*$')
_SET_DISCARD_RE = re.compile(r'^(\w+)\.discard\((.+)\)\s*$')
_SET_COMBINE_METHOD: "dict[str, str]" = {
    'union': 'UnionWith',
    'intersection': 'IntersectWith',
    'difference': 'ExceptWith',
}


__tkv_import__ = "il_dispatch"


def _tu_match_set_remove(m: "match", kind: "str", pos: "i32", known_shapes: "dict[str,str]") -> "(i32,i32)":
    """Phan CHUNG cua set.remove()/set.discard(): tu ket qua khop regex ra
    mot dong da intern.

    CHI khoi dong khi known_shapes DA XAC NHAN la 'set' (nguoc lai voi
    list.remove() o list_type.py - regex giong het nhau, phai loai tru
    lan nhau ca 2 chieu de tranh nuot nham cua nhau, xem ghi chu sua
    trong list_type.py's try_parse_list_remove cung ngay).
    """
    if not m:
        return None
    # 'discard' CHI co o set (khong xung dot list.remove) nen KHONG can biet
    # truoc hinh dang - nhan ca set cap module (2026-09-29); 'remove' thi can.
    if kind != 'set_discard' and known_shapes.get(m.group(1)) not in ('set', 'frozenset'):
        return None
    name = m.group(1)
    arg_expr = m.group(2)
    return intern(make3(kind, name, arg_expr)), pos + 1


def try_parse_set_remove(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """LINE_PARSERS entry: 'st.remove(x)'."""
    return _tu_match_set_remove(_SET_REMOVE_RE.match(line), 'set_remove', pos, known_shapes)


def try_parse_set_discard(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """LINE_PARSERS entry: 'st.discard(x)'."""
    return _tu_match_set_remove(_SET_DISCARD_RE.match(line), 'set_discard', pos, known_shapes)


def _codegen_set_remove_like(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """set.discard(x): giu nguyen hanh vi cu (Remove(T) roi pop, khong
    kiem tra ket qua). set.remove(x) (batch 5.5b, muc cuoi, 2026-08-13):
    kiem tra bool tra ve tu Remove(T) - neu False (phan tu KHONG co
    trong set), nem KeyNotFoundException (gan nghia nhat voi KeyError
    cua Python - .NET khong co exception ten 'KeyError'). Khong tu viet
    message chua gia tri thieu - chap nhan sai khac nho ve loai/noi dung
    exception, giong tien le sample()/RFind da chap nhan truoc do."""
    ta = scope.tra(lay_str(stmt, 'name')).ta
    if ta.shape_ten != 'set' and ta.shape_ten != 'frozenset':
        ten_lenh = 'remove'
        if lay_str(stmt, 'kind') == 'set_discard':
            ten_lenh = 'discard'
        raise SyntaxError(
            f"il_codegen: '.{ten_lenh}(...)' chi dung duoc tren set, "
            f"'{lay_str(stmt, 'name')}' co shape={ta.shape_repr()}")
    if ta.shape_ten == 'frozenset':
        method = 'remove' if lay_str(stmt, 'kind') == 'set_remove' else 'discard'
        raise SyntaxError(
            f"il_codegen: '{lay_str(stmt, 'name')}' la frozenset (bat bien) - khong the .{method}()")
    ctx.load_var_ref(lay_str(stmt, 'name'), scope, body)
    ctx.compile_expr(lay_nut(stmt, 'value_node'), scope, body, ta.dtype, ctx)
    body.append(f'    callvirt instance bool {il_set_type(ta.dtype, ctx.records, il_extern_dtype._EXTERN_CLASS_DEFS)}::Remove(!0)')
    if lay_str(stmt, 'kind') == 'set_discard':
        body.append('    pop')
    else:
        ctx.label_counter[0] += 1
        n = ctx.label_counter[0]
        ok_lbl = f"{ctx.prefix}_setrm{n}_ok"
        body.append(f'    brtrue {ok_lbl}')
        body.append('    newobj instance void [mscorlib]System.Collections.Generic.KeyNotFoundException::.ctor()')
        body.append('    throw')
        body.append(f'  {ok_lbl}:')


def _fpw_set_remove_like(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'value_node'))


def _temps_set_combine(node: "TkvNode", ctx: "WalkCtx"):
    """FIRST PASS: 1 bien AN giu SET KET QUA (ban sao cua set thu 1), khoa
    = id(node) - xem stdlib_string_count.py cho quy uoc khoa."""
    try:
        a_ta = ctx.infer_scope.tra(ea_str(node)).ta
    except KeyError:
        return
    ctx.declare_named(f'__setcomb{nid(node)}_res', a_ta)


def _bo_set_combine(op: "str") -> "func(TkvNode, Scope, list[str], str, Ctx)->void":
    """Buoc `op` vao mot handler rieng cho tung ten method.

    Truoc day cho nay viet `(lambda op: lambda ...)(op)` - thu thuat cua
    Python de thoat khoi viec lambda bat bien theo THAM CHIEU. TokenVector
    KHONG dich duoc lambda long (ca trinh bien dich that lan hat giong),
    va cung khong CAN thu thuat do: lambda cua no bat theo GIA TRI. Nha
    may closure co ten thi ca hai ben deu dich duoc, va duoi CPython van
    cho moi vong mot o nho rieng vi `op` la THAM SO."""
    def fn(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
        nonlocal op
        _compile_set_combine(node, scope, out, dtype, ctx, op)
    return fn


def _compile_set_combine(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx", op: "str"):
    a_name, args = ea_str(node), ec_ds(node)
    if len(args) != 1 or ekind(args[0]) != 'var':
        raise SyntaxError(
            f"il_codegen: set.{op}() can DUNG 1 tham so la 1 BIEN set (vd "
            f"'a.{op}(b)') - bieu thuc long nhau chua ho tro")
    b_name = ea_str(args[0])
    a_ta = scope.tra(a_name).ta
    b_ta = scope.tra(b_name).ta
    if b_ta.shape_ten != 'set' or b_ta.dtype != a_ta.dtype:
        raise SyntaxError(
            f"il_codegen: '{a_name}.{op}({b_name})' can '{b_name}' la set cung "
            f"dtype ({a_ta.dtype!r})")
    res_idx = scope.tra(f'__setcomb{nid(node)}_res').idx
    set_type = il_set_type(a_ta.dtype, ctx.records, (ctx.extern_class_defs if ctx is not None else None))

    # res = new HashSet<T>(a)  (ban sao - KHONG sua 2 set nguon)
    ctx.load_var_ref(a_name, scope, out)
    out.append(
        f'    newobj instance void {set_type}::.ctor(class '
        f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    out.append(f'    stloc.s {res_idx}')
    # res.UnionWith(b) / IntersectWith / ExceptWith
    out.append(f'    ldloc.s {res_idx}')
    ctx.load_var_ref(b_name, scope, out)
    out.append(
        f'    callvirt instance void {set_type}::{_SET_COMBINE_METHOD[op]}(class '
        f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    out.append(f'    ldloc.s {res_idx}')





def bootstrap_set_methods_batch2(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_line_parser(reg, 'set_remove', try_parse_set_remove)
    register_line_parser(reg, 'set_discard', try_parse_set_discard)
    register_stmt_codegen(reg, 'set_remove', _codegen_set_remove_like)
    register_stmt_codegen(reg, 'set_discard', _codegen_set_remove_like)
    register_first_pass_walk(reg, 'set_remove', _fpw_set_remove_like)
    register_first_pass_walk(reg, 'set_discard', _fpw_set_remove_like)
        # Vong lap nay truoc day chay o CAP MODULE; P6 dua vao day, dat
        # DUNG vi tri cu trong chuoi dang ky (do bang nhat ky dang ky that).
    for _op in _SET_COMBINE_METHOD:
        register_expr_method(reg, 
            'set', _op,
            _bo_set_combine(_op),
            temps_fn=_temps_set_combine,
            # Kieu tra ve = DUNG kieu cua set thu 1 (co che nhom 5).
            return_ta_fn=lambda a_ta: a_ta,
            result_shape='set')
