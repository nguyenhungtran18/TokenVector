# -*- coding: utf-8 -*-
"""string.startswith()/.endswith()/.find()/.rfind()/.lstrip()/.rstrip()
(2026-07-29,
Huong A stdlib mo rong - nhom rieng, dang ky qua STR_METHODS-compatible
dict giong het string_methods_batch2.py, KHONG sua file do). Chi 5 ham co
anh xa 1:1 THAT SU voi 1 method .NET co san (dung tinh than "chi la du
lieu, khong logic moi"): cac ham Python string CHUA co anh xa 1:1 an toan
(count/isalpha/title/capitalize/zfill - ngu nghia khac .NET hoac can vong
lap) CHU Y KHONG dua vao day, de nhom rieng khi thuc su can va xac minh ky
ngu nghia. isdigit() da duoc dua vao day sau khi ledger P036/P041 chung minh
khoang trong compile_gap; no di qua TkvStr helper rieng vi chuoi rong cua
Python phai la False."""


__tkv_import__ = "il_dispatch"
from expr_row import ea_str, ec_ds


def _validate_str_method_caller_b3(obj_name: "str", scope: "Scope"):
    ta = scope.tra(obj_name).ta
    if ta.dtype != 'str' or not ta.la_vo_huong():
        raise SyntaxError(f"il_codegen: '{obj_name}' khong phai la bien string vo huong")


def _ensure_class_bat_dau(ctx: "Ctx"):
    """TkvBatDau::Tai(s, x, vi_tri) = s.startswith(x, vi_tri) cua Python: vi_tri
    am tinh tu cuoi (kep ve 0), vi_tri > len -> False; so sanh ORDINAL."""
    emitted = ctx.emitted_types
    if emitted is None or 'TkvBatDau' in emitted:
        return
    emitted.add('TkvBatDau')
    ctx.extra_classes.append([
        '.class public auto ansi beforefieldinit TkvBatDau extends [mscorlib]System.Object',
        '{',
        '  .method public static bool Tai(string s, string x, int32 p) cil managed',
        '  {',
        '    .maxstack 8',
        '    ldarg.2',
        '    ldc.i4.0',
        '    bge TKVBD_DUONG',
        '    ldarg.2',
        '    ldarg.0',
        '    callvirt instance int32 [mscorlib]System.String::get_Length()',
        '    add',
        '    starg.s 2',
        '    ldarg.2',
        '    ldc.i4.0',
        '    bge TKVBD_DUONG',
        '    ldc.i4.0',
        '    starg.s 2',
        '  TKVBD_DUONG:',
        '    ldarg.2',
        '    ldarg.0',
        '    callvirt instance int32 [mscorlib]System.String::get_Length()',
        '    ble TKVBD_TRONG',
        '    ldc.i4.0',
        '    ret',
        '  TKVBD_TRONG:',
        '    ldarg.0',
        '    callvirt instance int32 [mscorlib]System.String::get_Length()',
        '    ldarg.2',
        '    sub',
        '    ldarg.1',
        '    callvirt instance int32 [mscorlib]System.String::get_Length()',
        '    bge TKVBD_SO',
        '    ldc.i4.0',
        '    ret',
        '  TKVBD_SO:',
        '    ldarg.0',
        '    ldarg.2',
        '    ldarg.1',
        '    ldc.i4.0',
        '    ldarg.1',
        '    callvirt instance int32 [mscorlib]System.String::get_Length()',
        '    call int32 [mscorlib]System.String::CompareOrdinal(string, int32, string, int32, int32)',
        '    ldc.i4.0',
        '    ceq',
        '    ret',
        '  }',
        '}',
    ])


def compile_str_method_startswith(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """s.startswith(prefix[, vi_tri]) - so sanh ORDINAL nhu Python (2026-09-26:
    truoc day goi StartsWith(string) phu thuoc van hoa cua .NET)."""
    obj_name, args = ea_str(node), ec_ds(node)
    if len(args) != 1 and len(args) != 2:
        raise SyntaxError("il_codegen: s.startswith(x[, vi_tri]) can 1 hoac 2 tham so")
    _validate_str_method_caller_b3(obj_name, scope)
    ctx.load_var_ref(obj_name, scope, out)
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    if len(args) == 2:
        # s.startswith(x, vi_tri) (2026-09-26) - quy tac vi tri cua Python
        _ensure_class_bat_dau(ctx)
        ctx.compile_expr(args[1], scope, out, 'i32', ctx)
        out.append('    call bool TkvBatDau::Tai(string, string, int32)')
        return
    # Ordinal (4): StartsWith(string) cua .NET phu thuoc VAN HOA, Python so ma
    out.append('    ldc.i4.4')
    out.append('    callvirt instance bool [mscorlib]System.String::StartsWith(string, valuetype [mscorlib]System.StringComparison)')


def compile_str_method_endswith(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """s.endswith(suffix) - String::EndsWith(string), tuong tu startswith."""
    obj_name, args = ea_str(node), ec_ds(node)
    if len(args) != 1:
        raise SyntaxError("il_codegen: s.endswith(x) can dung 1 tham so")
    _validate_str_method_caller_b3(obj_name, scope)
    ctx.load_var_ref(obj_name, scope, out)
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    ldc.i4.4')
    out.append('    callvirt instance bool [mscorlib]System.String::EndsWith(string, valuetype [mscorlib]System.StringComparison)')


def compile_str_method_find(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """s.find(sub) / s.find(sub, start) - String::IndexOf(string) hoac
    IndexOf(string, int32), tra ve -1 khi khong tim thay, KHOP CHINH XAC
    ngu nghia Python str.find (khac str.index nem ValueError - khong lam
    index() o day vi can co che nem exception rieng, chua co trong DSL
    nay). Tham so 2 'start' them 2026-08-11 (Phase 1.5) - Python cho phep
    start > len(s) (tra -1 an toan), .NET IndexOf(string,int32) NEM
    ArgumentOutOfRangeException trong truong hop do - chua xu ly rieng vi
    it gap trong thuc te (canh bao trong docstring, khong am tham sai)."""
    obj_name, args = ea_str(node), ec_ds(node)
    if len(args) not in (1, 2):
        raise SyntaxError("il_codegen: s.find(x) hoac s.find(x, start) can 1 hoac 2 tham so")
    _validate_str_method_caller_b3(obj_name, scope)
    ctx.load_var_ref(obj_name, scope, out)
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    if len(args) == 2:
        ctx.compile_expr(args[1], scope, out, 'i32', ctx)
        out.append('    ldc.i4.4')
        out.append('    callvirt instance int32 [mscorlib]System.String::IndexOf(string, int32, valuetype [mscorlib]System.StringComparison)')
    else:
        out.append('    ldc.i4.4')
        out.append('    callvirt instance int32 [mscorlib]System.String::IndexOf(string, valuetype [mscorlib]System.StringComparison)')
    ctx.widen_if_needed('i32', dtype, out)


def compile_str_method_index(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """s.index(sub[, start]) (2026-09-26) - nhu find (ORDINAL) nhung khong thay
    thi nem ValueError (FormatException) nhu Python, khong tra -1."""
    obj_name, args = ea_str(node), ec_ds(node)
    if len(args) not in (1, 2):
        raise SyntaxError("il_codegen: s.index(x[, start]) can 1 hoac 2 tham so")
    _validate_str_method_caller_b3(obj_name, scope)
    ctx.load_var_ref(obj_name, scope, out)
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    if len(args) == 2:
        ctx.compile_expr(args[1], scope, out, 'i32', ctx)
        out.append('    ldc.i4.4')
        out.append('    callvirt instance int32 [mscorlib]System.String::IndexOf(string, int32, valuetype [mscorlib]System.StringComparison)')
    else:
        out.append('    ldc.i4.4')
        out.append('    callvirt instance int32 [mscorlib]System.String::IndexOf(string, valuetype [mscorlib]System.StringComparison)')
    ctx.label_counter[0] += 1
    ok = f'{ctx.prefix}_sidx{ctx.label_counter[0]}_ok'
    out.append('    dup')
    out.append('    ldc.i4.m1')
    out.append(f'    bne.un {ok}')
    out.append('    pop')
    out.append('    ldstr "substring not found"')
    out.append('    newobj instance void [mscorlib]System.FormatException::.ctor(string)')
    out.append('    throw')
    out.append(f'  {ok}:')
    ctx.widen_if_needed('i32', dtype, out)


def compile_str_method_rfind(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """s.rfind(sub) - B6 (2026-08-05): di qua TkvStr::RFind (khong goi
    thang String::LastIndexOf) vi do THAT bang arbiter lo lech o ca bien
    sub="": Python "hello".rfind("") = 5 (do dai chuoi), .NET's
    LastIndexOf("") = 4 - can re nhanh RIENG cho truong hop nay (xem
    tkvstr.py). 'sub' la bieu thuc bat ky luc chay nen khong quyet dinh
    duoc rong hay khong luc bien dich."""
    obj_name, args = ea_str(node), ec_ds(node)
    if len(args) != 1:
        raise SyntaxError("il_codegen: s.rfind(x) can dung 1 tham so")
    _validate_str_method_caller_b3(obj_name, scope)
    _tkvstr.ensure_class(ctx)
    ctx.load_var_ref(obj_name, scope, out)
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append(f'    call int32 {_tkvstr.TKVSTR_CLASS}::RFind(string, string)')
    ctx.widen_if_needed('i32', dtype, out)


def compile_str_method_isdigit(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """s.isdigit() - Python tra False cho chuoi rong va True chi khi moi
    ky tu la digit. Khong goi thang LINQ/all de tranh them dependency; helper
    TkvStr::IsDigit lap ro trong CIL."""
    obj_name, args = ea_str(node), ec_ds(node)
    if len(args) != 0:
        raise SyntaxError("il_codegen: s.isdigit() khong nhan tham so")
    _validate_str_method_caller_b3(obj_name, scope)
    _tkvstr.ensure_class(ctx)
    ctx.load_var_ref(obj_name, scope, out)
    out.append(f'    call int32 {_tkvstr.TKVSTR_CLASS}::IsDigit(string)')
    ctx.widen_if_needed('i32', dtype, out)


def _compile_is(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx", ten_py: "str", ten_il: "str"):
    """s.isalpha()/isalnum()/isspace() (2026-09-26) qua TkvStr (chuoi rong -> False)."""
    obj_name, args = ea_str(node), ec_ds(node)
    if len(args) != 0:
        raise SyntaxError(f"il_codegen: s.{ten_py}() khong nhan tham so")
    _validate_str_method_caller_b3(obj_name, scope)
    _tkvstr.ensure_class(ctx)
    ctx.load_var_ref(obj_name, scope, out)
    out.append(f'    call int32 {_tkvstr.TKVSTR_CLASS}::{ten_il}(string)')
    ctx.widen_if_needed('i32', dtype, out)


def compile_str_method_isalpha(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _compile_is(node, scope, out, dtype, ctx, 'isalpha', 'IsAlpha')


def compile_str_method_isalnum(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _compile_is(node, scope, out, dtype, ctx, 'isalnum', 'IsAlnum')


def compile_str_method_isspace(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    _compile_is(node, scope, out, dtype, ctx, 'isspace', 'IsSpace')


def compile_str_method_lstrip(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """s.lstrip() - String KHONG co overload TrimStart() KHONG tham so
    that su (xac minh qua PowerShell reflection: [string].GetMethods()
    CHI co 'TrimStart(Char[])') - C# 's.TrimStart()' duoc trinh bien dich
    tu dong nap 'null' cho tham so char[] nay, phai lam dung y het
    (ldnull truoc callvirt).
    s.lstrip(chars) them 2026-08-13: mirror compile_str_method_strip -
    'chars'.ToCharArray() truoc khi goi TrimStart(char[])."""
    obj_name, args = ea_str(node), ec_ds(node)
    if len(args) not in (0, 1):
        raise SyntaxError("il_codegen: s.lstrip() hoac s.lstrip(chars) can 0 hoac 1 tham so")
    _validate_str_method_caller_b3(obj_name, scope)
    ctx.load_var_ref(obj_name, scope, out)
    if len(args) == 1:
        ctx.compile_expr(args[0], scope, out, 'str', ctx)
        out.append('    callvirt instance char[] [mscorlib]System.String::ToCharArray()')
    else:
        out.append('    ldnull')
    out.append('    callvirt instance string [mscorlib]System.String::TrimStart(char[])')


def compile_str_method_rstrip(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """s.rstrip() - tuong tu lstrip(), TrimEnd(Char[]) voi null.
    s.rstrip(chars) them 2026-08-13: mirror compile_str_method_strip."""
    obj_name, args = ea_str(node), ec_ds(node)
    if len(args) not in (0, 1):
        raise SyntaxError("il_codegen: s.rstrip() hoac s.rstrip(chars) can 0 hoac 1 tham so")
    _validate_str_method_caller_b3(obj_name, scope)
    ctx.load_var_ref(obj_name, scope, out)
    if len(args) == 1:
        ctx.compile_expr(args[0], scope, out, 'str', ctx)
        out.append('    callvirt instance char[] [mscorlib]System.String::ToCharArray()')
    else:
        out.append('    ldnull')
    out.append('    callvirt instance string [mscorlib]System.String::TrimEnd(char[])')


def _ensure_class_swap(ctx: "Ctx"):
    """TkvSwap::Swap(s) - s.swapcase() (2026-10-01): hoa <-> thuong tung ky tu (Invariant)."""
    if ctx.emitted_types is None or 'TkvSwap' in ctx.emitted_types:
        return
    ctx.emitted_types.add('TkvSwap')
    C = '[mscorlib]System.Char'
    c = []
    c.append('.class public auto ansi beforefieldinit TkvSwap extends [mscorlib]System.Object')
    c.append('{')
    c.append('  .method public static string Swap(string s) cil managed')
    c.append('  {')
    c.append('    .maxstack 8')
    c.append('    .locals init (char[] a, int32 i, char c)')
    c.append('    ldarg.0')
    c.append('    callvirt instance char[] [mscorlib]System.String::ToCharArray()')
    c.append('    stloc.0')
    c.append('    ldc.i4.0')
    c.append('    stloc.1')
    c.append('  SW_L:')
    c.append('    ldloc.1')
    c.append('    ldloc.0')
    c.append('    ldlen')
    c.append('    conv.i4')
    c.append('    bge SW_E')
    c.append('    ldloc.0')
    c.append('    ldloc.1')
    c.append('    ldelem.u2')
    c.append('    stloc.2')
    c.append('    ldloc.2')
    c.append('    call bool ' + C + '::IsUpper(char)')
    c.append('    brfalse SW_NU')
    c.append('    ldloc.0')
    c.append('    ldloc.1')
    c.append('    ldloc.2')
    c.append('    call char ' + C + '::ToLowerInvariant(char)')
    c.append('    stelem.i2')
    c.append('    br SW_N')
    c.append('  SW_NU:')
    c.append('    ldloc.2')
    c.append('    call bool ' + C + '::IsLower(char)')
    c.append('    brfalse SW_N')
    c.append('    ldloc.0')
    c.append('    ldloc.1')
    c.append('    ldloc.2')
    c.append('    call char ' + C + '::ToUpperInvariant(char)')
    c.append('    stelem.i2')
    c.append('  SW_N:')
    c.append('    ldloc.1')
    c.append('    ldc.i4.1')
    c.append('    add')
    c.append('    stloc.1')
    c.append('    br SW_L')
    c.append('  SW_E:')
    c.append('    ldloc.0')
    c.append('    newobj instance void [mscorlib]System.String::.ctor(char[])')
    c.append('    ret')
    c.append('  }')
    c.append('  .method public static bool IsCase(string s, bool up) cil managed')
    c.append('  {')
    c.append('    .maxstack 8')
    c.append('    .locals init (int32 i, bool has, char c)')
    c.append('    ldc.i4.0')
    c.append('    stloc.0')
    c.append('    ldc.i4.0')
    c.append('    stloc.1')
    c.append('  IC_L:')
    c.append('    ldloc.0')
    c.append('    ldarg.0')
    c.append('    callvirt instance int32 [mscorlib]System.String::get_Length()')
    c.append('    bge IC_E')
    c.append('    ldarg.0')
    c.append('    ldloc.0')
    c.append('    callvirt instance char [mscorlib]System.String::get_Chars(int32)')
    c.append('    stloc.2')
    c.append('    ldloc.2')
    c.append('    call bool ' + C + '::IsUpper(char)')
    c.append('    brfalse IC_NU')
    c.append('    ldarg.1')
    c.append('    brfalse IC_BAD')
    c.append('    ldc.i4.1')
    c.append('    stloc.1')
    c.append('    br IC_N')
    c.append('  IC_NU:')
    c.append('    ldloc.2')
    c.append('    call bool ' + C + '::IsLower(char)')
    c.append('    brfalse IC_N')
    c.append('    ldarg.1')
    c.append('    brtrue IC_BAD')
    c.append('    ldc.i4.1')
    c.append('    stloc.1')
    c.append('  IC_N:')
    c.append('    ldloc.0')
    c.append('    ldc.i4.1')
    c.append('    add')
    c.append('    stloc.0')
    c.append('    br IC_L')
    c.append('  IC_BAD:')
    c.append('    ldc.i4.0')
    c.append('    ret')
    c.append('  IC_E:')
    c.append('    ldloc.1')
    c.append('    ret')
    c.append('  }')
    c.append('  .method public static bool IsTitle(string s) cil managed')
    c.append('  {')
    c.append('    .maxstack 8')
    c.append('    .locals init (int32 i, bool prev, bool has, char c)')
    c.append('    ldc.i4.0')
    c.append('    stloc.0')
    c.append('    ldc.i4.0')
    c.append('    stloc.1')
    c.append('    ldc.i4.0')
    c.append('    stloc.2')
    c.append('  IT_L:')
    c.append('    ldloc.0')
    c.append('    ldarg.0')
    c.append('    callvirt instance int32 [mscorlib]System.String::get_Length()')
    c.append('    bge IT_E')
    c.append('    ldarg.0')
    c.append('    ldloc.0')
    c.append('    callvirt instance char [mscorlib]System.String::get_Chars(int32)')
    c.append('    stloc.3')
    c.append('    ldloc.3')
    c.append('    call bool [mscorlib]System.Char::IsUpper(char)')
    c.append('    brfalse IT_NU')
    c.append('    ldloc.1')
    c.append('    brtrue IT_BAD')
    c.append('    ldc.i4.1')
    c.append('    stloc.1')
    c.append('    ldc.i4.1')
    c.append('    stloc.2')
    c.append('    br IT_N')
    c.append('  IT_NU:')
    c.append('    ldloc.3')
    c.append('    call bool [mscorlib]System.Char::IsLower(char)')
    c.append('    brfalse IT_UN')
    c.append('    ldloc.1')
    c.append('    brfalse IT_BAD')
    c.append('    ldc.i4.1')
    c.append('    stloc.2')
    c.append('    br IT_N')
    c.append('  IT_UN:')
    c.append('    ldc.i4.0')
    c.append('    stloc.1')
    c.append('  IT_N:')
    c.append('    ldloc.0')
    c.append('    ldc.i4.1')
    c.append('    add')
    c.append('    stloc.0')
    c.append('    br IT_L')
    c.append('  IT_BAD:')
    c.append('    ldc.i4.0')
    c.append('    ret')
    c.append('  IT_E:')
    c.append('    ldloc.2')
    c.append('    ret')
    c.append('  }')
    c.append('  .method public static bool IsAscii(string s) cil managed')
    c.append('  {')
    c.append('    .maxstack 8')
    c.append('    .locals init (int32 i)')
    c.append('    ldc.i4.0')
    c.append('    stloc.0')
    c.append('  IA_L:')
    c.append('    ldloc.0')
    c.append('    ldarg.0')
    c.append('    callvirt instance int32 [mscorlib]System.String::get_Length()')
    c.append('    bge IA_OK')
    c.append('    ldarg.0')
    c.append('    ldloc.0')
    c.append('    callvirt instance char [mscorlib]System.String::get_Chars(int32)')
    c.append('    ldc.i4 128')
    c.append('    bge IA_NO')
    c.append('    ldloc.0')
    c.append('    ldc.i4.1')
    c.append('    add')
    c.append('    stloc.0')
    c.append('    br IA_L')
    c.append('  IA_NO:')
    c.append('    ldc.i4.0')
    c.append('    ret')
    c.append('  IA_OK:')
    c.append('    ldc.i4.1')
    c.append('    ret')
    c.append('  }')
    c.append('}')
    ctx.extra_classes.append(c)


def compile_str_method_swapcase(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """s.swapcase() (2026-10-01)."""
    obj_name, args = ea_str(node), ec_ds(node)
    if len(args) != 0:
        raise SyntaxError("il_codegen: s.swapcase() khong co tham so")
    _validate_str_method_caller_b3(obj_name, scope)
    _ensure_class_swap(ctx)
    ctx.load_var_ref(obj_name, scope, out)
    out.append('    call string TkvSwap::Swap(string)')


