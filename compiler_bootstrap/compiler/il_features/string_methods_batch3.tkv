    """s.isupper() / s.islower() (2026-10-01): moi ky tu co hoa/thuong dung chieu, co it nhat 1 ky tu."""
    obj_name, args = ea_str(node), ec_ds(node)
    _validate_str_method_caller_b3(obj_name, scope)
    _ensure_class_swap(ctx)
    ctx.load_var_ref(obj_name, scope, out)
    out.append('    ldc.i4.1')
    out.append('    call bool TkvSwap::IsCase(string, bool)')


def compile_str_method_islower(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
