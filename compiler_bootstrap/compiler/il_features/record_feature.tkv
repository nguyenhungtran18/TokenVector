__tkv_import__ = ["il_dispatch", "tkv_types"]

_ATTR_ASSIGN_RE = re.compile(r'^(\w+)\.(\w+)\s*=\s*(.+)$')
_COMPOUND_ASSIGN_OPS: "dict[str, str]" = {'+=': '+', '-=': '-', '*=': '*', '/=': '/', '%=': '%', '//=': '//', '**=': '**', '&=': '&', '|=': '|', '^=': '^', '<<=': '<<', '>>=': '>>'}
_COMPOUND_OP_PATTERN = r'(//=|\*\*=|<<=|>>=|\+=|-=|\*=|/=|%=|&=|\|=|\^=)'
# Pattern VIET LIEN mot mach thay vi noi chuoi (2026-09-18): dang
# `re.compile(a + b)` lam `_re_compile_pattern` tu choi (no chi nhan
# MOT doi so la chuoi literal) -> chan phep gop self-host. Doan
# `(//=|\*\*=|<<=|>>=|\+=|-=|\*=|/=|%=|&=|\|=|\^=)` chinh la `_COMPOUND_OP_PATTERN` o tren -
# giu hang do lai vi cho khac con doc, nhung KHONG noi vao day nua.
_COMPOUND_ATTR_RE = re.compile(r'^(\w+)\.(\w+)\s*(//=|\*\*=|<<=|>>=|\+=|-=|\*=|/=|%=|&=|\|=|\^=)\s*(.+)$')






def is_record_ctor_rhs(rhs_node: "TkvNode", records: "dict[str,list[(str,TkvTypeAnn)]]") -> "i32":
    """declare_scalar (o core) goi ham nay de phat hien 'p = Point(1.0,
    2.0)' - ve phai la loi goi ham TRUNG TEN voi 1 record da khai bao,
    khac gan vo huong thong thuong."""
    return bool(records) and ekind(rhs_node) == 'call' and ea_str(rhs_node) in records


def try_expand_compound_attr(line: "str") -> "str":
    """MACRO_EXPANDERS entry - 'obj.field += expr' mo rong THANH VAN BAN
    sang dang gan-lai binh thuong (attr_assign), khong can codegen moi."""
    stripped = line.strip()
    ind = ' ' * (len(line) - len(line.lstrip(' ')))
    m = _COMPOUND_ATTR_RE.match(stripped)
    if not m:
        return None
    obj, field, cop, rhs = m.groups()
    op = _COMPOUND_ASSIGN_OPS[cop]
    return f'{ind}{obj}.{field} = {obj}.{field} {op} ({rhs})'


def try_parse_attr_assign(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    m = _ATTR_ASSIGN_RE.match(line)
    if not m:
        return None
    # 'p.x = expr' - ghi 1 field cua record; KIEM TRA THAT record co
    # field nay hay khong duoc hoan lai codegen (can bang 'records',
    # chua co o day - chi parse cu phap tho).
    obj_name, field_name, rhs = m.groups()
    return intern(make4('attr_assign', obj_name, field_name, rhs)), pos + 1


def codegen_attr_assign(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    obj_name, field_name = lay_str(stmt, 'obj_name'), lay_str(stmt, 'field_name')
    obj_ta = scope.tra(obj_name).ta
    if obj_ta.shape_ten == 'extern_class':
        # Task 3 (extern-class-property, 2026-08-18): ghi property qua
        # set_X (callvirt void) - doi xung voi nhanh doc get_X trong
        # compile_attr o tren (cung file). Import il_codegen CUC BO (tranh
        # circular import, cung ly do voi nhanh doc).
        decl = il_extern_dtype._EXTERN_CLASS_DEFS.get(obj_ta.dtype, 0)
        prop = 0
        if decl:
            prop = next((p for p in (il_extern_dtype.ex_tts(decl) or []) if il_extern_dtype.ex_tt_ten(p) == field_name), 0)
        if prop == 0:
            raise SyntaxError(
                f"il_codegen: '.{field_name}' khong phai property da khai cua "
                f"handle type {obj_ta.dtype!r}")
        if il_extern_dtype.ex_tt_readonly(prop):
            raise TranspileError(
                f"il_codegen: property {field_name!r} cua {obj_ta.dtype!r} la "
                f"readonly, khong the gan gia tri")
        registered = ctx.reg.expr_method_codegen.get(khoa_method('extern_class', f'set_{field_name}'))
        if registered is None:
            raise SyntaxError(
                f"il_codegen: setter cho property {field_name!r} chua duoc dang ky")
        fake_node = mk4('method_call', o_str(obj_name), o_str(f'set_{field_name}'), o_ds([lay_nut(stmt, 'value_node')]))
        registered(fake_node, scope, body, None, ctx)
        return
    if obj_ta.shape_ten != 'record':
        raise SyntaxError(
            f"il_codegen: '.{field_name}' chi dung duoc tren bien kieu record, "
            f"'{obj_name}' co shape={obj_ta.shape_repr()}")
    records = ctx.records or {}
    field_dtypes = dict(records.get(obj_ta.dtype, []))
    if field_name not in field_dtypes:
        raise SyntaxError(f"il_codegen: record '{obj_ta.dtype}' khong co field '{field_name}'")
    field_dtype = field_dtypes[field_name]
    # B1 (2026-07-29): record gio la REFERENCE TYPE (class, khong con
    # valuetype/struct) - stfld chi can 1 REFERENCE tren stack (load_var_ref),
    # khong can dia chi (load_var_addr) nua nhu luc con la struct.
    ctx.load_var_ref(obj_name, scope, body)
    if _la_rhs_rong(lay_str(stmt, 'value_text')):
        # 'self.x = []' / '{}' / 'set()' (2026-09-25): newobj THEO KIEU TRUONG.
        if field_dtype.shape_ten not in ('list', 'dict', 'set'):
            raise SyntaxError(
                f"il_codegen: gan container rong vao '{obj_name}.{field_name}' nhung truong "
                f"co kieu {field_dtype.shape_repr()}")
        kieu_tr = ctx.il_type_str(field_dtype, records)
        body.append(f'    newobj instance void {kieu_tr}::.ctor()')
        owner_r = _field_owner_class(ctx, obj_ta.dtype, field_name)
        body.append(f'    stfld {kieu_tr} {owner_r}::{ctx.il_ident(field_name)}')
        return
    # Sau chuan hoa 2026-09-15 moi field deu la TypeAnn, nen phep thu
    # "co phai container khong" KHONG con la `isinstance(.., str)` nua
    # ma la CO HINH DANG hay khong (vo huong co shape=None).
    if field_dtype.shape_ten == 'func':
        # Truong FUNC (2026-09-29): 'obj.f = (lambda a: g(a))' / 'obj.f = ten_ham'
        # - dung duong delegate cua doi so func; truoc day lambda roi vao
        # compile_expr va bao 'AST node khong ro'.
        ctx.compile_funcref_arg(lay_nut(stmt, 'value_node'), field_dtype, scope, body, ctx)
        owner_f = _field_owner_class(ctx, obj_ta.dtype, field_name)
        body.append(f'    stfld {ctx.il_type_str(field_dtype, records)} '
                    f'{owner_f}::{ctx.il_ident(field_name)}')
        return
    if not field_dtype.la_vo_huong():
        # Field CONTAINER (2026-08-03): gan lai ca doi tuong container.
        # Round 3 (2026-08-19): shape-string convention khi gan list-literal
        # long nhau vao field ('self.m = [[1,2],[3,4]]').
        ctx.compile_expr(lay_nut(stmt, 'value_node'), scope, body,
                            _value_dtype_spec_for_ta(field_dtype, lay_nut(stmt, 'value_node')), ctx)
        owner = _field_owner_class(ctx, obj_ta.dtype, field_name)
        body.append(f'    stfld {ctx.il_type_str(field_dtype, records)} '
                    f'{owner}::{ctx.il_ident(field_name)}')
        return
    # Chuan hoa 2026-09-15: field vo huong cung la TypeAnn -> lay `.dtype`
    # cho nhung cho van can TEN dtype dang chuoi.
    ctx.compile_expr(lay_nut(stmt, 'value_node'), scope, body, field_dtype.dtype, ctx)
    owner = _field_owner_class(ctx, obj_ta.dtype, field_name)
    body.append(f'    stfld {IL_SCALAR[field_dtype.dtype]} {owner}::{ctx.il_ident(field_name)}')


def _la_rhs_rong(van: "str") -> "i32":
    """Ve phai la container RONG viet thang."""
    if van is None:
        return False
    v = van.strip()
    return v == '[]' or v == '{}' or v == 'set()' or v == 'dict()' or v == 'list()'


def fpw_attr_assign(stmt: "i32", ctx: "WalkCtx"):
    if _la_rhs_rong(lay_str(stmt, 'value_text')):
        return
    ctx.collect_ternary_temps(lay_nut(stmt, 'value_node'))


def compile_attr_record(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"=None):
    obj_name, field_name = ea_str(node), eb_str(node)
    obj_ta = scope.tra(obj_name).ta
    if dt_attr_dtype(obj_ta.dtype, field_name) != '':
        compile_dt_attr(obj_name, field_name, obj_ta.dtype, scope, out, dtype, ctx)
        return
    if obj_ta.dtype == 'complex' and field_name in ('real', 'imag', 'magnitude'):
        # '.real'/'.imag'/'.magnitude' tren 1 bien 'complex' (muc 6.8,
        # 2/4, 2026-08-13) - uy quyen ra complex_type.py (dia chi qua
        # ctx['load_var_addr'], KHONG hardcode ten slot IL).
        compile_attr(obj_name, field_name, scope, out, dtype, ctx)
        return
    if obj_ta.dtype == 'f32x4' and field_name in ('x', 'y', 'z', 'w'):
        # (port 2026-10-06 tu bootstrap record_feature): '.x'/'.y'/'.z'/'.w'
        # tren 1 bien 'f32x4' - doc LANE (X/Y/Z/W la FIELD Single, phai
        # `ldfld`, khong duoc `call get_X`).
        compile_attr_vector4(obj_name, field_name, scope, out, dtype, ctx)
        return
    if obj_ta.shape_ten == 'dict_kvpair' and field_name in ('key', 'val'):
        # KeyValuePair<K,V> la VALUE TYPE - can DIA CHI (ldloca/ldarga) de
        # goi get_Key()/get_Value(), giong ky thuat da dung cho enumerator
        # 'cur' trong dict_type.py's codegen_for_in_dict_items (2026-07-29,
        # dict.items()-as-assign, xem dict_items_list.py). Dung '.val'
        # (KHONG phai '.value') VI 'value' nam trong _IL_RESERVED_WORDS
        # (il_core.py) - bi tu dong doi thanh 'value_' TRUOC khi parse
        # (bug that phat hien qua test dau tien: SyntaxError field '.value_'
        # khong ton tai), tranh dung cach doi ten reserved-word dai dong.
        kv_type = ctx.il_type_str(obj_ta, (ctx.records if ctx is not None else None))
        ctx.load_var_addr(obj_name, scope, out)
        if field_name == 'key':
            out.append(f'    call instance !0 {kv_type}::get_Key()')
            ctx.widen_if_needed(obj_ta.key_dtype, dtype, out)
        else:
            out.append(f'    call instance !1 {kv_type}::get_Value()')
            ctx.widen_if_needed(obj_ta.dtype, dtype, out)
        return
    if obj_ta.shape_ten == 'extern_class':
        # Task 2 (extern-class-property, 2026-08-18): doc property qua
        # get_X (callvirt) - tai dung TOAN BO pipeline method da co
        # (EXPR_METHOD_CODEGEN[('extern_class', 'get_X')], dang ky dong
        # trong tkv_compile.py) bang cach dung LAI CHINH fake_node shape
        # 'method_call' that (node[1]/node[2]/node[3], xac nhan qua
        # compile_method_call o duoi - obj_name/method_name/args). Import
        # il_codegen CUC BO (khong o top-level) de tranh circular import
        # (xem docstring dau file - ly do da dung ctx['il_type_str'] thay vi
        # import truc tiep o cac nhanh khac).
        decl = il_extern_dtype._EXTERN_CLASS_DEFS.get(obj_ta.dtype, 0)
        prop = 0
        if decl:
            prop = next((p for p in (il_extern_dtype.ex_tts(decl) or []) if il_extern_dtype.ex_tt_ten(p) == field_name), 0)
        if prop == 0:
            raise SyntaxError(
                f"il_codegen: '.{field_name}' khong phai property da khai cua "
                f"handle type {obj_ta.dtype!r}")
        registered = ctx.reg.expr_method_codegen.get(khoa_method('extern_class', f'get_{field_name}'))
        if registered is None:
            raise SyntaxError(
                f"il_codegen: getter cho property {field_name!r} chua duoc dang ky")
        fake_node = mk4('method_call', o_str(obj_name), o_str(f'get_{field_name}'), o_ds([]))
        registered(fake_node, scope, out, dtype, ctx)
        return
    if obj_ta.shape_ten == 'tuple' and field_name in ('key', 'val') and \
            obj_ta.tuple_dtypes is not None and len(obj_ta.tuple_dtypes) == 2:
        # Phase 11b (2026-08-28): '.key'/'.val' tren 1 bien TUPLE 2 phan
        # tu THAT (KHONG phai dict_kvpair record) - macro text-level
        # 'for_in_kvlist.py' ('for a, b in <ten bien tran>:') khong biet
        # dtype container luc khai trien, luon phat sinh '.key'/'.val'
        # bat ke container la List<KeyValuePair> (dict.items()-as-assign,
        # nhanh dict_kvpair o TREN) hay List<(T1,T2)> (list-of-tuple that
        # tu zip()/enumerate(), Phase 5.3). Nhanh nay la 'ben do' ngu
        # nghia cho truong hop tuple: '.key' == Item1 (phan tu 0),
        # '.val' == Item2 (phan tu 1) - CHI alias cho tuple DUNG 2 phan
        # tu (macro nay khong bao gio sinh ra tren tuple >2 phan tu).
        i = 0 if field_name == 'key' else 1
        # TEN RIENG: `field_dtype` o hai nhanh duoi la mot TypeAnn, con o
        # day la mot CHUOI dtype (phan tu cua tuple_dtypes). Trinh tu-host
        # chot kieu bien theo TEN tren toan ban gop, nen dung chung mot ten
        # cho hai kieu lam hong nhanh kia - va loi hien o dong DOC TRUONG
        # `field_dtype.dtype`, khong phai o day.
        pt_dtype = obj_ta.tuple_dtypes[i]
        tuple_il_type = il_tupleN_type(obj_ta.tuple_dtypes,
                                                   obj_ta.tuple_tas,
                                                   (ctx.records if ctx is not None else None),
                                                   ctx.il_type_str)
        ctx.load_var_ref(obj_name, scope, out)
        out.append(f'    callvirt instance !{i} {tuple_il_type}::get_Item{i + 1}()')
        ctx.widen_if_needed(pt_dtype, dtype, out)
        return
    if obj_ta.shape_ten != 'record':
        raise SyntaxError(
            f"il_codegen: '.{field_name}' chi dung duoc tren bien kieu record, "
            f"'{obj_name}' co shape={obj_ta.shape_repr()}")
    records = (ctx.records if ctx is not None else None) or {}
    field_dtypes = dict(records.get(obj_ta.dtype, []))
    if field_name not in field_dtypes:
        raise SyntaxError(f"il_codegen: record '{obj_ta.dtype}' khong co field '{field_name}'")
    field_dtype = field_dtypes[field_name]
    ctx.load_var_ref(obj_name, scope, out)
    owner = _field_owner_class(ctx, obj_ta.dtype, field_name)
    # Sau chuan hoa 2026-09-15 moi field deu la TypeAnn, nen phep thu
    # "co phai container khong" KHONG con la `isinstance(.., str)` nua
    # ma la CO HINH DANG hay khong (vo huong co shape=None).
    if not field_dtype.la_vo_huong():
        # Field CONTAINER (2026-08-03): kieu IL lay tu TypeAnn, va KHONG
        # widen (List/Dictionary la kieu tham chieu).
        out.append(f'    ldfld {ctx.il_type_str(field_dtype, records)} '
                   f'{owner}::{ctx.il_ident(field_name)}')
        return
    # Chuan hoa 2026-09-15: field vo huong cung la TypeAnn -> lay `.dtype`
    # cho nhung cho van can TEN dtype dang chuoi.
    out.append(f'    ldfld {IL_SCALAR[field_dtype.dtype]} {owner}::{ctx.il_ident(field_name)}')
    ctx.widen_if_needed(field_dtype.dtype, dtype, out)


def compile_attr_expr(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"=None):
    """'.ten' (KHONG dau ngoac) sau 1 BIEU THUC (khong phai ten bien don)
    - vd 'arr[i].Prop' (BUGS_TODO.md muc U, 2026-08-31, xac nhan root
    cause: '_parse_postfix_method' truoc day LUON gia dinh la method-call,
    gio co fallback tra ve node 'attr_expr' khi khong co '(' theo sau -
    xem il_core.py). Mirror phan extern_class cua compile_attr o tren,
    nhung obj KHONG phai 1 ten bien (khong co memory slot dat ten) - phai
    suy TypeAnn cua bieu thuc co so roi BIEN DICH NO len stack lam
    receiver truoc khi goi property getter, thay vi
    ctx['load_var_ref'](obj_name, ...) nhu compile_attr lam.

    Pham vi HIEN TAI: chi ho tro obj co shape 'extern_class' (dung cho
    case that RamGuard.tkv can: 'procs[j].Id') - cac shape khac (record/
    tuple/dict_kvpair) chua lam, bao loi ro rang de nguoi dung gan ra bien
    truoc (cach vong da xac nhan hoat dong dung, khong phai bat buoc doi
    voi cac shape do)."""
    base_node, field_name = ea_nut(node), eb_str(node)
    func_table = (ctx.func_table if ctx is not None else None) or {}
    records = (ctx.records if ctx is not None else None) or {}
    record_methods = (ctx.record_methods if ctx is not None else None) or {}
    # Dung LAI DUNG helper cua nhanh 'method_call_expr' (il_codegen.py) -
    # da xu ly ca 3 dang co so THAT ('index' vd 'procs[0].Prop', 'index_expr'
    # vd 's.split(",")[0].Prop', va fallback _infer_dtype cho call/method_call
    # khac) - KHONG viet lai rieng, tranh bo sot dang 'index' (chi so don
    # tren 1 bien - truong hop THAT SU pho bien nhat, vd RamGuard.tkv's
    # 'procs[j].Id').
    obj_ta = _ilc._method_call_expr_receiver_ta(ctx.reg, base_node, scope, func_table, records, record_methods)
    ten_rec = _ilc._ten_record_nhan(base_node, obj_ta, records)
    if ten_rec is not None and dict(records.get(ten_rec, [])).get(field_name) is not None:
        # TRUONG cua record tren 1 BIEU THUC (2026-09-26): nap bieu thuc roi ldfld
        fd = dict(records[ten_rec]).get(field_name)
        ctx.compile_expr(base_node, scope, out, ten_rec, ctx)
        owner = _field_owner_class(ctx, ten_rec, field_name)
        out.append(f'    ldfld {ctx.il_type_str(fd, records)} {owner}::{ctx.il_ident(field_name)}')
        if fd.la_vo_huong():
            ctx.widen_if_needed(fd.dtype, dtype, out)
        return
    if obj_ta is None or obj_ta.shape_ten != 'extern_class':
        raise SyntaxError(
            f"il_codegen: '.{field_name}' sau 1 bieu thuc phuc tap (khong phai ten "
            f"bien don) hien CHI ho tro khi bieu thuc do la 1 handle-type "
            f"(__tkv_extern_class__, vd 'arr[i].{field_name}') - gan bieu thuc ra 1 "
            f"bien truoc roi doc property tren bien do (xem BUGS_TODO.md muc U)")
    decl = il_extern_dtype._EXTERN_CLASS_DEFS.get(obj_ta.dtype, 0)
    prop = 0
    if decl:
        prop = next((p for p in (il_extern_dtype.ex_tts(decl) or []) if il_extern_dtype.ex_tt_ten(p) == field_name), 0)
    if prop == 0:
        raise SyntaxError(
            f"il_codegen: '.{field_name}' khong phai property da khai cua "
            f"handle type {obj_ta.dtype!r}")
    ctx.compile_expr(base_node, scope, out, obj_ta.dtype, ctx)
    prop_dtype = il_extern_dtype.ex_tt_dtype(prop)
    ret_il = _ilc._il_ctor_param_type(prop_dtype, il_extern_dtype._EXTERN_CLASS_DEFS)
    call_target = f"[{il_extern_dtype.ex_assembly(decl)}]{il_extern_dtype.ex_lop(decl)}"
    out.append(f"    callvirt instance {ret_il} {call_target}::get_{field_name}()")
    # Dtype PHIA TOKENVECTOR (mirror _tokenvector_facing_dtype cua
    # tkv_compile.py) - KHONG import truc tiep tu tkv_compile.py de tranh
    # circular import (compiler.il_features -> tkv_compile ->
    # compiler.il_codegen -> compiler.il_features...) - chi 3 nhanh nho,
    # trung lap co y thuc, ghi ro o day de dong bo neu tkv_compile.py's
    # ham goc thay doi.
    facing_dtype = prop_dtype
    if prop_dtype == 'bool':
        facing_dtype = 'i32'
    elif prop_dtype == 'u64':
        facing_dtype = 'i64'
    elif isinstance(prop_dtype, str) and prop_dtype.startswith('enum:'):
        facing_dtype = 'i32'
    ctx.widen_if_needed(facing_dtype, dtype, out)


def _la_bien(scope: "Scope", ten: "str") -> "i32":
    try:
        scope.tra(ten)
        return True
    except Exception:
        return False


_CO_RE: "dict[str,str]" = {'M': 'm', 'MULTILINE': 'm', 'S': 's', 'DOTALL': 's',
                           'I': 'i', 'IGNORECASE': 'i', 'X': 'x', 'VERBOSE': 'x'}


def _co_re_inline(n: "TkvNode") -> "str":
    """'re.M' / 're.M | re.S' -> '(?m)' / '(?ms)'."""
    k = ekind(n)
    if k == 'attr' and ea_str(n) == 're' and eb_str(n) in _CO_RE:
        return _CO_RE[eb_str(n)]
    if k == 'binop' and ea_str(n) == '|':
        return _co_re_inline(eb_nut(n)) + _co_re_inline(ec_nut(n))
    raise SyntaxError("il_codegen: co regex chi ho tro re.M/re.S/re.I/re.X (va '|')")


def _compile_re_module(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    ten, args = eb_str(node), ec_ds(node)
    rx = '[System]System.Text.RegularExpressions.Regex'
    if ten == 'escape':
        if len(args) != 1:
            raise SyntaxError("il_codegen: re.escape(s) nhan dung 1 tham so")
        ctx.compile_expr(args[0], scope, out, 'str', ctx)
        out.append(f'    call string {rx}::Escape(string)')
        return
    if ten == 'compile':
        if len(args) < 1 or len(args) > 2:
            raise SyntaxError("il_codegen: re.compile(p[, co]) nhan 1 hoac 2 tham so")
        co = _co_re_inline(args[1]) if len(args) == 2 else ''
        if co:
            out.append(f'    ldstr "(?{co})"')
        ctx.compile_expr(args[0], scope, out, 'str', ctx)
        if co:
            out.append('    call string [mscorlib]System.String::Concat(string, string)')
        out.append('    ldstr "(?P<"')
        out.append('    ldstr "(?<"')
        out.append('    callvirt instance string [mscorlib]System.String::Replace(string, string)')
        return
    if ten in ('match', 'search', 'fullmatch'):
        if len(args) != 2:
            raise SyntaxError(f"il_codegen: re.{ten}(p, s) nhan dung 2 tham so")
        ctx.compile_expr(args[1], scope, out, 'str', ctx)      # dau vao
        if ten == 'search':
            ctx.compile_expr(args[0], scope, out, 'str', ctx)
        else:
            out.append('    ldstr "^(?:"')
            ctx.compile_expr(args[0], scope, out, 'str', ctx)
            out.append('    call string [mscorlib]System.String::Concat(string, string)')
            out.append('    ldstr ")\\\\z"' if ten == 'fullmatch' else '    ldstr ")"')
            out.append('    call string [mscorlib]System.String::Concat(string, string)')
        out.append('    ldstr "(?P<"')
        out.append('    ldstr "(?<"')
        out.append('    callvirt instance string [mscorlib]System.String::Replace(string, string)')
        out.append(f'    call class [System]System.Text.RegularExpressions.Match {rx}::Match(string, string)')
        _rm._match_rong_thanh_null(out, ctx)
        return
    raise SyntaxError(f"il_codegen: re.{ten}(...) chua ho tro (chi match/search/fullmatch/escape/compile)")


def compile_method_call(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"=None):
    # HAM NAY NHAN HAI KIND, va o1 cua chung KHAC KIEU:
    #   'method_call'       o1 = TEN doi tuong (chuoi)   - qua bang dieu phoi
    #   'method_call_expr'  o1 = NODE bieu thuc nhan     - qua UY QUYEN tu
    #                            string_join.compile_method_call_expr, nhanh
    #                            `super().<method>(...)`
    # Duong uy quyen KHONG di qua bang dang ky nen moi bo suy dua vao
    # `register_expr_codegen` deu bo lo no. Kho mau cung bo lo: no chi co
    # `super().__init__()` chu khong co `super().<method>()` thuong - nen phep
    # do 1796 lan cung chi thay o1 la chuoi. Chi khi viet mot mau rieng va
    # boc chinh ten `compile_method_call` TRONG string_join moi thay duong nay
    # chay that (2026-09-18). Toi da mot lan ket luan nham day la ma chet.
    #
    # Hai kind -> HAI BIEN rieng (2026-09-24): truoc day ca hai do vao mot
    # `obj_name` luc chuoi luc node, roi `la_node(obj_name)` phan biet luc
    # chay - mot bien hai kieu, trinh that khong khai duoc.
    method_name, args = eb_str(node), ec_ds(node)
    if ekind(node) == 'method_call' and ea_str(node) == 're' and not _la_bien(scope, 're'):
        _compile_re_module(node, scope, out, dtype, ctx)
        return
    if ekind(node) == 'method_call_expr':
        nhan = ea_nut(node)
        if not (eso_o(nhan) >= 2 and ekind(nhan) == 'call' and ea_str(nhan) == 'super'):
            raise SyntaxError(
                f"il_codegen: '<bieu thuc>.{method_name}(...)' - qua duong nay chi "
                f"ho tro 'super().{method_name}(...)'")
        current_record = ctx.current_record
        record_bases = ctx.record_bases or {}
        base_name = base_that(record_bases, current_record)
        record_methods = ctx.record_methods or {}
        base_methods = record_methods.get(base_name, {})
        if method_name not in base_methods:
            raise SyntaxError(f"il_codegen: class base '{base_name}' khong co method '{method_name}'")
        m_sig = base_methods[method_name]
        out.append('    ldarg.0')
        compile_expr = ctx.compile_expr
        for arg_node, p in zip(args, m_sig.params):
            # Round 3 (2026-08-19): shape-string convention cho list-literal
            # long nhau lam doi so cua super().method(...).
            compile_expr(arg_node, scope, out,
                         _value_dtype_spec_for_ta(p.type_ann, arg_node), ctx)
        for p in m_sig.params[len(args):]:
            compile_expr(p.default_node, scope, out,
                         _value_dtype_spec_for_ta(p.type_ann, p.default_node), ctx)
        il_type_str = ctx.il_type_str
        ret_il = il_type_str(m_sig.return_type, None) if m_sig.return_type else 'void'
        params_il = ', '.join([il_type_str(p.type_ann, None) for p in m_sig.params])
        out.append(f'    call instance {ret_il} {base_name}::{ctx.il_ident(method_name)}({params_il})')
        if m_sig.return_type:
            ctx.widen_if_needed(m_sig.return_type.dtype, dtype, out)
        return
    obj_name = ea_str(node)
    if obj_name not in scope:
        # Phase 9d Part A, Task 3 (2026-08-26): 'ClassName.Method()' - static
        # method tren 1 __tkv_extern_class__ da khai bao, KHONG phai bien.
        # Parser dung CHUNG 1 node ('method_call', obj_name, method_name,
        # args) cho ca 2 truong hop ('obj.method()' voi obj la bien, va
        # 'ClassName.Method()' voi ClassName la ten class) - phan biet o
        # DAY qua obj_name co trong scope hay khong (khac han nhanh
        # 'super().method()' o tren, luon nhan dien qua hinh dang node).
        # Import CUC BO giong cac nhanh 'attr'/'attr_ren' o tren (tranh
        # circular import voi il_codegen).
        if obj_name in il_extern_dtype._EXTERN_CLASS_DEFS:
            # tkv_compile.py so huu logic codegen dong ('extern-class' method
            # resolution). Ham nay TRUOC day o tkv_compile.py va phai import
            # CUC BO vi chu trinh; 2026-09-18 da chuyen ve il_codegen (noi
            # ca hai phu thuoc cua no von da o san) nen het chu trinh.
            _ilc._compile_extern_static_class_method_call(
                node, scope, out, dtype, ctx, obj_name, method_name, args)
            return
        # GOI HAM CO TIEN TO MODULE (`mod.ham(...)`) - dang viet quen thuoc cua
        # Python nhung TokenVector KHONG ho tro, CO Y: `__tkv_import__` mang
        # ten vao KHONG CAN TIEN TO, nen them dang co tien to se tao cach goi
        # THU HAI cho cung mot thu. Nhung thong bao loi cu khong he goi ra dieu
        # do - no chi noi "khong phai bien da khai bao", khien nguoi viet di
        # tim mot bien khong ton tai.
        #
        # Nhan dang bang FUNC_TABLE: neu `method_name` la mot ham top-level da
        # biet thi gan nhu chac chan nguoi dung dang viet `mod.ham(...)`.
        func_table = (ctx.func_table if ctx is not None else None) or {}
        if method_name in func_table:
            raise SyntaxError(
                f"il_codegen: '{obj_name}.{method_name}(...)' - TokenVector khong "
                f"goi ham qua TIEN TO MODULE. '__tkv_import__' mang ten vao KHONG "
                f"CAN tien to, nen goi thang '{method_name}(...)'.")
        raise SyntaxError(
            f"il_codegen: '{obj_name}' khong phai bien da khai bao va cung "
            f"khong phai 1 extern-class da khai qua __tkv_extern_class__")
    obj_ta = scope.tra(obj_name).ta
    registered = ctx.reg.expr_method_codegen.get(khoa_method(obj_ta.shape_ten or obj_ta.dtype, method_name))
    if registered:
        # Giai doan 0.2 nhom 3 (2026-08-03): method can hidden local +
        # nhan IL, dang ky qua register_expr_method (xem il_dispatch.py) -
        # hidden local da duoc first-pass cap phat theo id(node).
        registered(node, scope, out, dtype, ctx)
        return
    if obj_ta.la_vo_huong() and obj_ta.dtype == 'str' and method_name in _STR_METHODS:
        # string la REFERENCE TYPE (giong List/Dictionary) - khac nhanh
        # record ben duoi (STRUCT, can dia chi qua load_var_addr) - noi
        # rieng o day (khong dung chung code ben duoi).
        _STR_METHODS[method_name](node, scope, out, dtype, ctx)
        return
    if obj_ta.shape_ten == 'list' and method_name == 'pop':
        _compile_list_method_pop(node, scope, out, dtype, ctx)
        return
    if obj_ta.shape_ten == 'list' and method_name == 'index':
        _compile_list_method_index(node, scope, out, dtype, ctx)
        return
    if obj_ta.shape_ten == 'dict' and method_name == 'get':
        _compile_dict_method_get(node, scope, out, dtype, ctx)
        return
    if obj_ta.shape_ten == 'dict' and method_name == 'pop':
        _compile_dict_method_pop(node, scope, out, dtype, ctx)
        return
    if obj_ta.shape_ten == 'dict' and method_name == 'setdefault':
        _compile_dict_method_setdefault(node, scope, out, dtype, ctx)
        return
    if obj_ta.shape_ten == 'file':
        _compile_file_method_call(node, scope, out, dtype, ctx)
        return
    if obj_ta.shape_ten != 'record':
        raise SyntaxError(
            f"il_codegen: '.{method_name}(...)' chi dung duoc tren bien kieu record, string "
            f"({sorted(_STR_METHODS)}), list.pop()/list.index(), dict.get()/dict.pop(), file-handle "
            f"('.write(x)'/'.read()'), hoac 'x = lst.count(...)' (chi RHS truc tiep 1 phep "
            f"gan) - '{obj_name}' co shape={obj_ta.shape_repr()} dtype={obj_ta.dtype!r}")
    records = (ctx.records if ctx is not None else None) or {}
    _fields = dict(records.get(obj_ta.dtype, []))
    _fta = _fields.get(method_name)
    if _fta is not None and not isinstance(_fta, str) and             _fta.shape_ten == 'func':
        # FIELD kieu HAM goi THANG: `c.f(x)` (2026-09-14). Truoc day moi
        # `obj.ten(...)` deu bi coi la loi goi METHOD, nen mot field kieu ham
        # bao "record khong co method" - buoc nguoi viet tach hai buoc
        # (`f = c.f` roi `f(x)`). Day la duong khien `ctx` thanh record ma
        # ~1500 cho `ctx['k'](...)` chi can doi thanh `ctx.k(...)`, khong phai
        # tach lenh.
        _owner = _field_owner_class(ctx, obj_ta.dtype, method_name)
        _fil = ctx.il_type_str(_fta, records)

        def _nap():
            nonlocal _fil, _owner, ctx, method_name, obj_name, out, scope
            ctx.load_var_ref(obj_name, scope, out)
            out.append('    ldfld %s %s::%s'
                       % (_fil, _owner, ctx.il_ident(method_name)))

        ctx.funcref_invoke(_fta, args, scope, out, dtype, ctx,
                                     '%s.%s' % (obj_name, method_name), _nap)
        return
    record_methods = (ctx.record_methods if ctx is not None else None) or {}
    methods = record_methods.get(obj_ta.dtype, {})
    if method_name not in methods:
        raise SyntaxError(f"il_codegen: record '{obj_ta.dtype}' khong co method '{method_name}'")
    m_sig = methods[method_name]
    # Phase 11a (2026-08-28): keyword argument cho method record - resolve
    # NGAY o day (truoc logic n_required/zip ben duoi deu doc `args`).
    args = resolve_call_args(m_sig.params, args, f'{obj_name}.{method_name}')
    n_required = sum([1 for p in m_sig.params if p.default_node < 0])
    if not (n_required <= len(args) <= len(m_sig.params)):
        raise SyntaxError(
            f"il_codegen: goi '{obj_name}.{method_name}(...)' voi {len(args)} tham so "
            f"nhung method can {n_required}"
            + (f'-{len(m_sig.params)}' if n_required != len(m_sig.params) else '')
            + " tham so")
    if m_sig.return_type is None and dtype != 'void':
        # dtype 'void' = noi goi CO Y bo ket qua (vd __init__ sau .ctor, 2026-09-25).
        raise SyntaxError(
            f"il_codegen: method '{method_name}' khong co return type (void) - chua ho "
            f"tro dung trong bieu thuc, chi dung duoc nhu 1 lenh doc lap")
    # '@staticmethod' (Wave 1 Nhom B, 2026-07-29): KHONG nap 'self' -
    # goi Python that van hop le qua instance ('obj.static_method(...)'),
    # nhung CIL phia duoi la 1 loi goi 'static' thuan, khong 'this'.
    is_static = m_sig.is_static
    if not is_static:
        # B1 (2026-07-29): record gio la REFERENCE TYPE - 'call instance'
        # chi can 1 REFERENCE (load_var_ref), khong can dia chi nua.
        ctx.load_var_ref(obj_name, scope, out)
    compile_expr = ctx.compile_expr
    for arg_node, p in zip(args, m_sig.params):
        if p.type_ann is not None and p.type_ann.shape_ten == 'func':
            # Tham so kieu HAM (2026-09-25, vd __init__(self, f: "func(...)")):
            # ten ham / lambda / truong func -> delegate.
            ctx.compile_funcref_arg(arg_node, p.type_ann, scope, out, ctx)
            continue
        # Round 3 (2026-08-19): shape-string convention cho list-literal long
        # nhau lam doi so method o VI TRI BIEU THUC ('n = h.sum2([[5,6]])').
        compile_expr(arg_node, scope, out,
                     _value_dtype_spec_for_ta(p.type_ann, arg_node), ctx)
    for p in m_sig.params[len(args):]:
        compile_expr(p.default_node, scope, out,
                     _value_dtype_spec_for_ta(p.type_ann, p.default_node), ctx)
    il_type_str = ctx.il_type_str
    if m_sig.is_async:
        # 'async def' method tren record (Task 3, 2026-08-12) - kieu tra ve
        # THAT cua .method la Task<T> (xem _gen_async_def), giong het cach
        # ham top-level 'async def' duoc goi (xem compile_expr's nhanh
        # 'is_async' o il_codegen.py ~dong 1750) - lenh 'call'/'callvirt'
        # phai khai bao dung Task<T>, KHONG phai T thuan.
        ret_il = f'class [mscorlib]System.Threading.Tasks.Task`1<{il_type_str(m_sig.return_type, None)}>'
    else:
        ret_il = 'void' if m_sig.return_type is None else il_type_str(m_sig.return_type, None)
    params_il = ', '.join([il_type_str(p.type_ann, None) for p in m_sig.params])
    # B1 (2026-07-29): dung 'callvirt' DONG LOAT cho method non-static (moi
    # method record gio la 'virtual', xem gen_record_types) - an toan theo
    # ECMA-335 tren CA method khong override (chi them 1 null-check), tranh
    # 2 duong dan 'call'/'callvirt' khac nhau tuy record co ke thua hay
    # khong (xem spike probe_inheritance.il da xac nhan callvirt dispatch
    # dung).
    call_op = 'call' if is_static else 'callvirt'
    call_kind = '' if is_static else 'instance '
    owner_cls = _method_owner_class(ctx, obj_ta.dtype, method_name)
    out.append(f'    {call_op} {call_kind}{ret_il} {owner_cls}::{ctx.il_ident(method_name)}({params_il})')
    if m_sig.return_type is not None:
        if dtype == 'void':
            # Noi goi Y BO KET QUA (REC(...)'s inner __init__) - vi call
            # 'callvirt instance int32' se de lai 1 int32 tren stack, ma la
            # tai noi goi dang mong 1 REC instance, lech stack ->
            # InvalidProgramException. Pop la phep hop le moi kieu tra.
            out.append('    pop')
        else:
            ctx.widen_if_needed(m_sig.return_type.dtype, dtype, out)


def bootstrap_record_feature(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    # Gop ba bang method chuoi - TRUOC moi dang ky, vi truoc day chung
    # duoc gop luc IMPORT tuc la som hon tat ca. Thu tu update GIU
    # nguyen thu tu cu cua `{**BASE, **EXTRA, **EXTRA2}` (cai sau ghi de
    # cai truoc). Hai cho doc _STR_METHODS deu nam TRONG ham (chay luc
    # codegen, sau bootstrap) nen khong co cua so rong.
    _STR_METHODS.update(_STR_METHODS_BASE)
    _STR_METHODS.update(_STR_METHODS_EXTRA)
    _STR_METHODS.update(_STR_METHODS_EXTRA2)

    # Dang ky vao il_dispatch NGAY LUC MODULE NAP.
    register_macro_expander(reg, 'compound_attr', try_expand_compound_attr)
    register_line_parser(reg, 'attr_assign', try_parse_attr_assign)
    register_stmt_codegen(reg, 'attr_assign', codegen_attr_assign)
    register_first_pass_walk(reg, 'attr_assign', fpw_attr_assign)
    register_expr_codegen(reg, 'attr', compile_attr_record)
    register_expr_codegen(reg, 'attr_expr', compile_attr_expr)
    register_expr_codegen(reg, 'method_call', compile_method_call)
