from il_features.string_methods_batch3 import STR_METHODS_EXTRA as _STR_METHODS_EXTRA
from il_features.string_methods_batch4 import STR_METHODS_EXTRA2 as _STR_METHODS_EXTRA2
# 2026-07-29 (Huong A stdlib mo rong, dang module rieng): nhom ham moi
# dang ky qua dict rieng o batch3/batch4, merge vao day - KHONG sua
# batch2.py/batch3.py, giu tinh plug-and-play (nhom moi = file moi + 1
# dong merge).
# 2026-09-17: khai RONG o day, DO DAY trong bootstrap_record_feature.
# Truoc do la `{**BASE, **EXTRA, **EXTRA2}` - mot LENH cap module, va do
# la rao duy nhat cua file nay o frontend tu-host. Khai bao kieu lay
# NGUYEN VAN tu ca ba nguon (string_methods_batch2/3/4 deu khai y het).
_STR_METHODS: "dict[str,func(TkvNode,Scope,list[str],str,Ctx)->void]" = {}
# Phase 10 (2026-08-28): center/rjust/ljust dang ky qua register_expr_method
# (khong phai dict STR_METHODS_EXTRA cu), CHAY DUOC O MOI VI TRI BIEU THUC
# ngay tu dau - KHONG can merge vao _STR_METHODS o day (import chi de
# module string_methods_batch5.py duoc NAP, kich hoat cac dong
# register_expr_method o cuoi file do). Xem compile_method_call ben duoi:
# _STR_METHODS chi la 1 nhanh fallback (danh sach method CU), nhanh
# EXPR_METHOD_CODEGEN (goi truoc trong il_codegen.py) da bat duoc
# center/rjust/ljust truoc khi roi xuong day.
import il_features.string_methods_batch5  # noqa: F401
from il_features.list_pop import compile_list_method_pop as _compile_list_method_pop
from il_features.dict_get import compile_dict_method_get as _compile_dict_method_get
from il_features.dict_pop import compile_dict_method_pop as _compile_dict_method_pop
