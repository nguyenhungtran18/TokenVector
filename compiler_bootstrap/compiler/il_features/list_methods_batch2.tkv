# -*- coding: utf-8 -*-
"""list.sort()/list.extend() (2026-07-29) - soan nhap boi Gemini, Claude
sua lai chu ky LINE_PARSERS/STMT_CODEGEN/FIRST_PASS_WALK cho khop dung
khuon that cua il_dispatch.py (draft goc dung sai chu ky kieu offset-scan
tu viet, khong phai khuon dang ky that cua he thong - xem list_type.py
lam mau chuan) truoc khi noi vao. Logic nghiep vu (Sort()/AddRange(),
kiem tra dtype khop nhau khi extend) giu nguyen y het draft, chi sua
phan "khung" tich hop.

key=/reverse= (2026-08-12, Phase 5 uu tien "list.sort key/reverse"):
- reverse=True/False: re, chi Sort() roi Reverse() (co san, xac minh THAT
  qua reflection - xem list_methods_batch3.py's list.reverse()).
- key=g: 'g' PHAI la 1 bien kieu 'func' da khai bao HOAC 1 ham top-level
  (dung LAI ha tang first-class function value cua map/filter/reduce -
  xem _resolve_func_ta/compile_funcref_arg trong stdlib_functional.py/
  il_codegen.py). Thuat toan "decorate-sort-undecorate": xay
  List<ValueTuple<K,T>> pairs = [(g(x), x) for x in lst], goi
  pairs.Sort() (dung Comparer<ValueTuple<K,T>>.Default CO SAN - so sanh
  Item1 truoc, Item2 sau - CHI dung duoc vi moi dtype DSL nay ho tro deu
  da IComparable: i32/i64/f32/f64/str qua CLR native, 'int' qua TkvInt
  (them rieng cho sorted(list[int]), xem int_type.py) - KHONG can dung
  Comparison<T> delegate tuy bien nao ca, tai dung nguyen co che
  list[(K,V)] da co (tien le most_common(c,n) trong counter_type.py)),
  roi ghi lai lst[i] = pairs[i].Item2. GIOI HAN CO Y THUC: sap xep KHONG
  ON DINH (not stable) khi co PHAN TU TRUNG KEY - Python that giu nguyen
  thu tu ban dau cho cac phan tu trung key, o day thu tu cac phan tu
  trung key co the bi DAO LAI vi tie-break qua Item2 (gia tri THAT, khong
  phai chi so goc) - danh doi de tranh viet 1 delegate Comparison<T> moi
  hoan toan, ghi ro trong docstring codegen_list_sort ben duoi."""
import stmt_row as _row
import re

from il_core import parse_expr, nid
from il_dispatch import register_line_parser, register_stmt_codegen, register_first_pass_walk
from il_features.tuple_type import il_tupleN_type
from il_features.stdlib_functional import _resolve_func_ta
from tkv_types import TypeAnn
from stmt_row import intern, lay_nut, lay_str, make3, make4
from il_features.list_type import compile_theo_ta, emit_list_sort, _record_stmt_fallback
from expr_row import mk2, o_str

_LIST_SORT_RE = re.compile(r'^(\w+)\.sort\(\s*(.*?)\s*\)\s*$')
_LIST_EXTEND_RE = re.compile(r'^(\w+)\.extend\((\w+)\)\s*$')
_LIST_EXTEND_EXPR_RE = re.compile(r'^(\w+)\.extend\((.+)\)\s*$')


__tkv_import__ = ["il_dispatch", "tkv_types"]

def _parse_sort_kwargs(args_text: "str", lst_name: "str") -> "(str,i32)":
    """'key=g, reverse=True' -> (key_name hoac None, reverse bool). CHI
    ho tro dung 2 kwarg nay, moi cai toi da 1 lan, 'reverse' phai la hang
    'True'/'False', 'key' phai la 1 TEN (khong bieu thuc phuc tap - xem
    _resolve_func_ta cho ly do)."""
    key_name = None
    reverse = False
    if not args_text:
        return key_name, reverse
    for part in args_text.split(','):
        part = part.strip()
        if not part:
            continue
        if '=' not in part:
            raise SyntaxError(
                f"il_codegen: '{lst_name}.sort(...)' chi nhan dang 'key=...'/'reverse=...' "
                f"(kwargs), khong nhan tham so vi tri")
        k, v = part.split('=', 1)
        k = k.strip()
        v = v.strip()
        if k == 'key':
            if key_name is not None:
                raise SyntaxError(f"il_codegen: '{lst_name}.sort(...)' 'key=' xuat hien 2 lan")
            if not re.fullmatch(r'\w+', v):
                raise SyntaxError(
                    f"il_codegen: '{lst_name}.sort(key=...)' 'key' chi nhan TEN 1 bien kieu "
                    f"'func' da khai bao hoac TEN 1 ham top-level - khong nhan lambda/bieu "
                    f"thuc phuc tap tai cho")
            key_name = v
        elif k == 'reverse':
            if v not in ('True', 'False'):
                raise SyntaxError(
                    f"il_codegen: '{lst_name}.sort(reverse=...)' chi nhan hang 'True'/'False'")
            reverse = (v == 'True')
        else:
            raise SyntaxError(
                f"il_codegen: '{lst_name}.sort(...)' khong nhan tham so '{k}' (chi ho tro "
                f"key=/reverse=)")
    return key_name, reverse


def try_parse_list_sort(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """LINE_PARSERS entry: 'lst.sort()'/'lst.sort(key=g)'/'lst.sort(reverse=True)'/
    'lst.sort(key=g, reverse=True)' - PHAI dang ky TRUOC method_call_stmt."""
    m = _LIST_SORT_RE.match(line)
    if not m:
        return None
    name, args_text = m.groups()
    key_name, reverse = _parse_sort_kwargs(args_text, name)
    # `reverse` la bool -> row luu chuoi: '1' that, '' gia. Moi consumer
    # deu dung theo CHAN LY ('if _row.get(stmt, "reverse")') nen '' gia dung
    # nhu False. `key_name` None -> sentinel vang mat, get() tra None.
    return intern(make4('list_sort', name, key_name or '',
                                  '1' if reverse else '')), pos + 1


def try_parse_list_extend(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """LINE_PARSERS entry: 'lst.extend(other)' - `other` PHAI la 1 TEN
    BIEN don (khong ho tro bieu thuc phuc tap - can doc scope['other']
    de doi chieu dtype phan tu luc codegen, ma parse_expr tren 1 bieu
    thuc bat ky khong dam bao chi la 1 ten bien)."""
    m = _LIST_EXTEND_RE.match(line)
    if not m:
        return None
    name, other_name = m.groups()
    return intern(make3('list_extend', name, other_name)), pos + 1


def _ensure_sort_cmp(ctx: "Ctx", tuple_type: "str", key_dtype: "str") -> "str":
    """Lop IComparer<Tuple<K,i32,T>>: so K (chuoi -> ORDINAL nhu Python, con lai Comparer<K>.Default)
    roi so chi so goc -> sort_key ON DINH nhu list.sort(key=) cua Python (2026-09-30)."""
    ten = 'TkvSortCmp'
    for c in tuple_type:
        if c.isalpha() or c.isdigit():
            ten = ten + c
        else:
            ten = ten + '_'
    if ctx.emitted_types is None or ten in ctx.emitted_types:
        return ten
    ctx.emitted_types.add(ten)
    kt = tuple_type[tuple_type.find('<') + 1:]
    ich = f'class [mscorlib]System.Collections.Generic.IComparer`1<{tuple_type}>'
    if key_dtype == 'str':
        so_k = ['    call int32 [mscorlib]System.String::CompareOrdinal(string, string)']
        truoc = []
    else:
        k_il = kt[:kt.find(',')]
        cmp_t = f'class [mscorlib]System.Collections.Generic.Comparer`1<{k_il}>'
        truoc = [f'    call class [mscorlib]System.Collections.Generic.Comparer`1<!0> {cmp_t}::get_Default()']
        so_k = [f'    callvirt instance int32 {cmp_t}::Compare(!0, !0)']
    L = []
    L.append(f'.class public auto ansi beforefieldinit {ten} extends [mscorlib]System.Object implements {ich}')
    L.append('{')
    L.append('  .method public hidebysig specialname rtspecialname instance void .ctor() cil managed')
    L.append('  {')
    L.append('    .maxstack 8')
    L.append('    ldarg.0')
    L.append('    call instance void [mscorlib]System.Object::.ctor()')
    L.append('    ret')
    L.append('  }')
    L.append(f'  .method public hidebysig newslot virtual final instance int32 Compare({tuple_type} x, {tuple_type} y) cil managed')
    L.append('  {')
    L.append('    .maxstack 8')
    L.append(f'    .override method instance int32 {ich}::Compare(!0, !0)')
    for d1 in truoc:
        L.append(d1)
    L.append('    ldarg.1')
    L.append(f'    callvirt instance !0 {tuple_type}::get_Item1()')
    L.append('    ldarg.2')
    L.append(f'    callvirt instance !0 {tuple_type}::get_Item1()')
    for d2 in so_k:
        L.append(d2)
    L.append('    dup')
    L.append('    brtrue CMP_RET')
    L.append('    pop')
    L.append('    ldarg.1')
    L.append(f'    callvirt instance !1 {tuple_type}::get_Item2()')
    L.append('    ldarg.2')
    L.append(f'    callvirt instance !1 {tuple_type}::get_Item2()')
    L.append('    sub')
    L.append('  CMP_RET:')
    L.append('    ret')
    L.append('  }')
    L.append('}')
    ctx.extra_classes.append(L)
    return ten


def codegen_list_sort(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'lst.sort()'/'lst.sort(key=g, reverse=...)'.

    GIOI HAN DA BIET (ke thua ban khong key): List<T>.Sort() dung
    Comparer<T>.Default - voi T la dtype so (i32/i64/f32/f64/'int' qua
    TkvInt) sap xep TANG DAN dung nhu Python list.sort() mac dinh; voi T
    la 1 class dang record se NEM InvalidOperationException luc CHAY
    (record chua implement IComparable) - danh doi thiet ke, khong phai
    bug, KHONG tu them IComparable cho record (ngoai pham vi).

    key=g (2026-08-12): xem docstring dau file cho thuat toan decorate-
    sort-undecorate qua List<ValueTuple<K,T>> - GIOI HAN THEM: khong on
    dinh (not stable) khi trung key, khac Python that (giu thu tu goc)."""
    name = lay_str(stmt, 'name')
    ta = scope.tra(name).ta
    list_type = ctx.il_type_str(ta, ctx.records)
    if not lay_str(stmt, 'key_name'):
        ctx.load_var_ref(name, scope, body)
        emit_list_sort(body, list_type, ta.dtype)
        if lay_str(stmt, 'reverse'):
            ctx.load_var_ref(name, scope, body)
            body.append(f'    callvirt instance void {list_type}::Reverse()')
        return

    key_node = mk2('var', o_str(lay_str(stmt, 'key_name')))
    la_len = lay_str(stmt, 'key_name') == 'len'
    if la_len:
        if ta.dtype != 'str':
            raise SyntaxError(f"il_codegen: '{name}.sort(key=len)' chi ho tro list[str]")
        f_ta = TypeAnn('i32', None)
    else:
        f_ta = _resolve_func_ta(key_node, scope, ctx.func_table, 'sort')
    if (not la_len) and f_ta.func_param_dtypes != [ta.dtype]:
        raise SyntaxError(
            f"il_codegen: '{name}.sort(key={lay_str(stmt, 'key_name')}, ...)' - chu ky key "
            f"(({', '.join(f_ta.func_param_dtypes)}) -> {f_ta.dtype}) khong khop dtype phan tu "
            f"cua '{name}' ({ta.dtype!r})")
    key = nid(stmt)
    try:
        f_idx = scope.tra(f'__sortkey{key}_f').idx
        pairs_idx = scope.tra(f'__sortkey{key}_pairs').idx
        idx_idx = scope.tra(f'__sortkey{key}_idx').idx
    except KeyError:
        raise SyntaxError(
            f"il_codegen: '{name}.sort(key=...)' - khong cap phat duoc local an (co the do "
            f"'{name}' chua duoc khai bao la list truoc dong nay)")
    tuple_dtypes = [f_ta.dtype, 'i32', ta.dtype]
    tuple_type = il_tupleN_type(tuple_dtypes)
    pairs_list_type = f'class [mscorlib]System.Collections.Generic.List`1<{tuple_type}>'
    func_il = ''
    n_params = 0
    if not la_len:
        func_il = ctx.il_type_str(f_ta, ctx.records)
        n_params = len(f_ta.func_params)
    # Vong lap thay `', '.join(f'!{i}' for i in range(N))`: trinh bien
    # dich tu-host chua chay `range` BEN TRONG mot bieu thuc sinh.
    _ps = []
    _i = 0
    while _i < n_params:
        _ps.append(f'!{_i}')
        _i = _i + 1
    invoke_params = ', '.join(_ps)

    if not la_len:
        ctx.compile_funcref_arg(mk2('var', o_str(lay_str(stmt, 'key_name'))), f_ta, scope, body, ctx)
        body.append(f'    stloc.s {f_idx}')
    body.append(f'    newobj instance void {pairs_list_type}::.ctor()')
    body.append(f'    stloc.s {pairs_idx}')

    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    build_start = f"{ctx.prefix}_sortkey{n}_build_start"
    build_end = f"{ctx.prefix}_sortkey{n}_build_end"
    wb_start = f"{ctx.prefix}_sortkey{n}_wb_start"
    wb_end = f"{ctx.prefix}_sortkey{n}_wb_end"

    # pairs.Add((g(lst[i]), lst[i])) voi i = 0..len(lst)-1
    body.append('    ldc.i4.0')
    body.append(f'    stloc.s {idx_idx}')
    body.append(f'  {build_start}:')
    body.append(f'    ldloc.s {idx_idx}')
    ctx.load_var_ref(name, scope, body)
    body.append(f'    callvirt instance int32 {list_type}::get_Count()')
    body.append(f'    bge {build_end}')
    body.append(f'    ldloc.s {pairs_idx}')
    if la_len:
        ctx.load_var_ref(name, scope, body)
        body.append(f'    ldloc.s {idx_idx}')
        body.append(f'    callvirt instance !0 {list_type}::get_Item(int32)')
        body.append('    callvirt instance int32 [mscorlib]System.String::get_Length()')
    else:
        body.append(f'    ldloc.s {f_idx}')
        ctx.load_var_ref(name, scope, body)
        body.append(f'    ldloc.s {idx_idx}')
        body.append(f'    callvirt instance !0 {list_type}::get_Item(int32)')
        body.append(f'    callvirt instance !{n_params} {func_il}::Invoke({invoke_params})')
    if lay_str(stmt, 'reverse'):
        ctx.load_var_ref(name, scope, body)
        body.append(f'    callvirt instance int32 {list_type}::get_Count()')
        body.append('    ldc.i4.1')
        body.append('    sub')
        body.append(f'    ldloc.s {idx_idx}')
        body.append('    sub')
    else:
        body.append(f'    ldloc.s {idx_idx}')
    ctx.load_var_ref(name, scope, body)
    body.append(f'    ldloc.s {idx_idx}')
    body.append(f'    callvirt instance !0 {list_type}::get_Item(int32)')
    body.append(f'    newobj instance void {tuple_type}::.ctor(!0, !1, !2)')
    body.append(f'    callvirt instance void {pairs_list_type}::Add(!0)')
    body.append(f'    ldloc.s {idx_idx}')
    body.append('    ldc.i4.1')
    body.append('    add')
    body.append(f'    stloc.s {idx_idx}')
    body.append(f'    br {build_start}')
    body.append(f'  {build_end}:')

    # pairs.Sort() (Comparer<ValueTuple<K,T>>.Default - so sanh Item1 truoc)
    cmp_cls = _ensure_sort_cmp(ctx, tuple_type, f_ta.dtype)
    body.append(f'    ldloc.s {pairs_idx}')
    body.append(f'    newobj instance void {cmp_cls}::.ctor()')
    body.append(f'    callvirt instance void {pairs_list_type}::Sort(class [mscorlib]System.Collections.Generic.IComparer`1<!0>)')

    # ghi lai lst[i] = pairs[i].Item2
    body.append('    ldc.i4.0')
    body.append(f'    stloc.s {idx_idx}')
    body.append(f'  {wb_start}:')
    body.append(f'    ldloc.s {idx_idx}')
    ctx.load_var_ref(name, scope, body)
    body.append(f'    callvirt instance int32 {list_type}::get_Count()')
    body.append(f'    bge {wb_end}')
    ctx.load_var_ref(name, scope, body)
    body.append(f'    ldloc.s {idx_idx}')
    body.append(f'    ldloc.s {pairs_idx}')
    body.append(f'    ldloc.s {idx_idx}')
    body.append(f'    callvirt instance !0 {pairs_list_type}::get_Item(int32)')
    body.append(f'    callvirt instance !2 {tuple_type}::get_Item3()')
    body.append(f'    callvirt instance void {list_type}::set_Item(int32, !0)')
    body.append(f'    ldloc.s {idx_idx}')
    body.append('    ldc.i4.1')
    body.append('    add')
    body.append(f'    stloc.s {idx_idx}')
    body.append(f'    br {wb_start}')
    body.append(f'  {wb_end}:')

    if lay_str(stmt, 'reverse'):
        ctx.load_var_ref(name, scope, body)
        body.append(f'    callvirt instance void {list_type}::Reverse()')


def codegen_list_extend(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'lst.extend(other)' - List<T>.AddRange(IEnumerable<T>).
    List<T> chinh no da implement IEnumerable<T> nen truyen thang duoc."""
    name, other_name = lay_str(stmt, 'name'), lay_str(stmt, 'other_name')
    _ext_node = mk2('num', o_str(other_name))
    if not other_name.lstrip('-').isdigit():
        _ext_node = mk2('var', o_str(other_name))
    _ext_list: "list[TkvNode]" = []
    _ext_list.append(_ext_node)
    if _record_stmt_fallback(name, 'extend', _ext_list, scope, body, ctx):
        return
    ta = scope.tra(name).ta
    ta_other = scope.tra(other_name).ta
    if ta_other.shape_ten != 'list':
        raise SyntaxError(f"il_codegen: '{name}.extend({other_name})' can '{other_name}' la list")
    if ta_other.dtype != ta.dtype:
        raise SyntaxError(
            f"il_codegen: '{name}.extend({other_name})' - dtype phan tu khac nhau "
            f"({ta.dtype!r} vs {ta_other.dtype!r})")
    list_type = ctx.il_type_str(ta, ctx.records)
    ctx.load_var_ref(name, scope, body)
    ctx.load_var_ref(other_name, scope, body)
    body.append(
        f'    callvirt instance void {list_type}::AddRange(class '
        f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')


def try_parse_list_extend_expr(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """'lst.extend(<bieu thuc list>)' (2026-09-28) - doi so khong phai ten
    bien: literal '[a, b]', loi goi 'f()'... Dich theo TypeAnn cua 'lst'."""
    m = _LIST_EXTEND_EXPR_RE.match(line.strip())
    if not m or _LIST_EXTEND_RE.match(line.strip()):
        return None
    nut = parse_expr(m.group(2))
    return intern(make4('list_extend_expr', m.group(1), m.group(2), str(nut))), pos + 1


def codegen_list_extend_expr(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    name = lay_str(stmt, 'name')
    ta = scope.tra(name).ta
    if ta.shape_ten != 'list':
        raise SyntaxError(f"il_codegen: '{name}.extend(...)' can '{name}' la list")
    list_type = ctx.il_type_str(ta, ctx.records)
    ctx.load_var_ref(name, scope, body)
    compile_theo_ta(lay_nut(stmt, 'expr_node'), ta, ta.dtype, scope, body, ctx)
    body.append(
        f'    callvirt instance void {list_type}::AddRange(class '
        f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')


def fpw_list_extend_expr(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'expr_node'))


def fpw_list_sort(stmt: "i32", ctx: "WalkCtx"):
    """FIRST_PASS_WALK entry: khi co 'key=g', cap phat 3 local an (delegate
    'f', List<ValueTuple<K,T>> 'pairs', chi so vong lap dung chung cho ca
    2 vong build/write-back) - giong cau truc _temps_map trong
    stdlib_functional.py."""
    key_name = lay_str(stmt, 'key_name')
    if not key_name:
        return
    infer_scope = ctx.infer_scope
    func_table = ctx.func_table
    name = lay_str(stmt, 'name')
    try:
        lst_ta = infer_scope.tra(name).ta
    except KeyError:
        return
    if lst_ta.shape_ten != 'list':
        return
    if key_name == 'len':
        f_ta = TypeAnn('i32', None)
    else:
        try:
            f_ta = _resolve_func_ta(mk2('var', o_str(key_name)), infer_scope, func_table, 'sort')
        except SyntaxError:
            return
        if f_ta.func_param_dtypes != [lst_ta.dtype]:
            return
    key = nid(stmt)
    ctx.declare_named(f'__sortkey{key}_f', f_ta)
    ctx.declare_named(f'__sortkey{key}_pairs', TypeAnn(
        f_ta.dtype, 'list', elem_ta=TypeAnn(lst_ta.dtype, 'tuple', tuple_dtypes=[f_ta.dtype, 'i32', lst_ta.dtype])))
    ctx.declare_named(f'__sortkey{key}_idx', TypeAnn('i32', None))


def fpw_list_extend(stmt: "i32", ctx: "WalkCtx"):
    pass


def bootstrap_list_methods_batch2(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_line_parser(reg, 'list_sort', try_parse_list_sort)
    register_line_parser(reg, 'list_extend', try_parse_list_extend)
    register_line_parser(reg, 'list_extend_expr', try_parse_list_extend_expr)
    register_stmt_codegen(reg, 'list_extend_expr', codegen_list_extend_expr)
    register_first_pass_walk(reg, 'list_extend_expr', fpw_list_extend_expr)
    register_stmt_codegen(reg, 'list_sort', codegen_list_sort)
    register_stmt_codegen(reg, 'list_extend', codegen_list_extend)
    register_first_pass_walk(reg, 'list_sort', fpw_list_sort)
    register_first_pass_walk(reg, 'list_extend', fpw_list_extend)
