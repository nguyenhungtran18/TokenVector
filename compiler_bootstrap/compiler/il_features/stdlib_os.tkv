# -*- coding: utf-8 -*-
"""stdlib_os.py - Plug-and-Play module cho OS Operations (System.Environment & System.IO.Directory)

Cung cap:
- os_getenv(name) -> str
- os_mkdir(path) -> i32
- os_list_files(path) -> list[str]
"""

import stmt_row as _row
import re
from il_core import parse_expr
from il_dispatch import (
    register_assign_rhs_parser, register_first_pass_walk, register_stmt_codegen,
    register_expr_builtin,
)
from tkv_types import TypeAnn
from stmt_row import intern, lay_nut, lay_str, make3

_GETENV_RE = re.compile(r'^os_getenv\((.+)\)$')
_MKDIR_RE = re.compile(r'^os_mkdir\((.+)\)$')
_LIST_FILES_RE = re.compile(r'^os_list_files\((.+)\)$')


__tkv_import__ = ["il_dispatch", "tkv_types"]

def _push_os_getenv(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    # Nhan DUY NHAT moi lan goi (Giai doan 0.2 nhom 2, 2026-08-03) - can
    # THIET vi builtin nay gio goi duoc NHIEU LAN trong CUNG 1 ham (vd
    # 'os_getenv("A") + os_getenv("B")'), nhan co dinh 'os_getenv_end'
    # nhu code cu se trung lap -> ilasm bao loi label da khai bao. Dung
    # lai co che label_counter/prefix da co san cho ternary (xem
    # _expr_ternary o il_codegen.py).
    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    end_lbl = f"{ctx.prefix}_osgetenv{n}_end"
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    call string [mscorlib]System.Environment::GetEnvironmentVariable(string)')
    out.append('    dup')
    out.append(f'    brtrue {end_lbl}')
    out.append('    pop')
    out.append('    ldstr ""')
    out.append(f'  {end_lbl}:')


def try_rhs_os_getenv(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    m = _GETENV_RE.match(rhs.strip())
    if not m:
        return None
    return intern(make3('assign_os_getenv', name, m.group(1)))


def fpw_os_getenv(stmt: "i32", ctx: "WalkCtx"):
    ta = TypeAnn('str', None)
    ctx.declare_named(lay_str(stmt, 'name'), ta)
    ctx.collect_ternary_temps(lay_nut(stmt, 'arg_node'))


def codegen_os_getenv(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    _push_os_getenv([lay_nut(stmt, 'arg_node')], scope, body, 'str', ctx)
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def _push_os_mkdir(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    call class [mscorlib]System.IO.DirectoryInfo [mscorlib]System.IO.Directory::CreateDirectory(string)')
    out.append('    pop')
    out.append('    ldc.i4 1')


def try_rhs_os_mkdir(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    m = _MKDIR_RE.match(rhs.strip())
    if not m:
        return None
    return intern(make3('assign_os_mkdir', name, m.group(1)))


def fpw_os_mkdir(stmt: "i32", ctx: "WalkCtx"):
    ta = TypeAnn('i32', None)
    ctx.declare_named(lay_str(stmt, 'name'), ta)
    ctx.collect_ternary_temps(lay_nut(stmt, 'arg_node'))


def codegen_os_mkdir(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    _push_os_mkdir([lay_nut(stmt, 'arg_node')], scope, body, 'i32', ctx)
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def _push_os_remove(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """os.remove(p) / os.unlink(p): xoa tep, tra 1 neu xoa duoc, 0 neu file
    khong ton tai (idempotent - goi lai nhieu lan deu duoc, KHONG nem loi).

    Port 2026-10-06 tu bootstrap (sua 2026-09-30): File::Delete KHONG nem
    khi file khong ton tai, nen kiem File::Exists truoc roi day 0/1. Nhan
    dung bo dem cua compiler (label_counter) vi goi nhieu lan trong 1 ham.
    `File::Delete` tra void va DA TIEU path -> stack rong sau no, KHONG
    them `pop` o nhanh xoa (da gap InvalidProgramException); chi nhanh
    `skip` moi con `path` tren stack va can `pop`."""
    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    skip = f'{ctx.prefix}_osrm{n}_skip'
    end = f'{ctx.prefix}_osrm{n}_end'
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    dup')
    out.append('    call bool [mscorlib]System.IO.File::Exists(string)')
    out.append(f'    brfalse {skip}')
    out.append('    call void [mscorlib]System.IO.File::Delete(string)')
    out.append('    ldc.i4.1')
    out.append(f'    br {end}')
    out.append(f'  {skip}:')
    out.append('    pop')
    out.append('    ldc.i4.0')
    out.append(f'  {end}:')


def _push_os_list_files(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    call string[] [mscorlib]System.IO.Directory::GetFiles(string)')
    out.append('    newobj instance void class [mscorlib]System.Collections.Generic.List`1<string>::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')


def try_rhs_os_list_files(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    m = _LIST_FILES_RE.match(rhs.strip())
    if not m:
        return None
    known_shapes[name] = 'list'
    return intern(make3('assign_os_list_files', name, m.group(1)))


def fpw_os_list_files(stmt: "i32", ctx: "WalkCtx"):
    ta = TypeAnn('str', 'list')
    ctx.declare_named(lay_str(stmt, 'name'), ta)
    ctx.collect_ternary_temps(lay_nut(stmt, 'arg_node'))


def codegen_os_list_files(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    _push_os_list_files([lay_nut(stmt, 'arg_node')], scope, body, 'str', ctx)
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def bootstrap_stdlib_os(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_assign_rhs_parser(reg, 'os_getenv', try_rhs_os_getenv)
    register_first_pass_walk(reg, 'assign_os_getenv', fpw_os_getenv)
    register_stmt_codegen(reg, 'assign_os_getenv', codegen_os_getenv)
    register_expr_builtin(reg, 'os_getenv', _push_os_getenv, 'str')
    register_expr_builtin(reg, 'os_remove', _push_os_remove, 'i32')
    register_assign_rhs_parser(reg, 'os_mkdir', try_rhs_os_mkdir)
    register_first_pass_walk(reg, 'assign_os_mkdir', fpw_os_mkdir)
    register_stmt_codegen(reg, 'assign_os_mkdir', codegen_os_mkdir)
    register_expr_builtin(reg, 'os_mkdir', _push_os_mkdir, 'i32')
    register_expr_builtin(reg, 'os_list_files', _push_os_list_files, 'str', return_shape='list')
    register_assign_rhs_parser(reg, 'os_list_files', try_rhs_os_list_files)
    register_first_pass_walk(reg, 'assign_os_list_files', fpw_os_list_files)
    register_stmt_codegen(reg, 'assign_os_list_files', codegen_os_list_files)
