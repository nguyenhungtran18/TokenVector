# -*- coding: utf-8 -*-
"""Kieu IL cua HashSet<T> dong - tach rieng file theo tinh nang
(2026-07-28).

Tu Phase 1 buoc 1 (2026-07-28), file nay CUNG so huu logic parse+codegen
+first-pass rieng cua set (khong chi ham kieu-IL thuan nhu truoc). Cac
ham can goi lai vao core nhan chung qua tham so `ctx` (dictionary duoc
'tiem' san cac ham do - xem gen_il_function trong il_codegen.py) THAY VI
import truc tiep tu il_codegen.py (tranh circular import). Dung chung
`find_first_append_dtype` voi list_type.py (import tu do, khong dinh
nghia lai)."""
import stmt_row as _row
import re

from il_core import parse_expr
from il_features.list_type import _has_append_stmt
from il_dispatch import (
    register_assign_rhs_parser, register_line_parser,
    register_stmt_codegen, register_first_pass_walk,
)
from il_features.list_type import (il_list_elem_ilstr, find_first_append_dtype, find_first_append_elem_ta, list_literal_elem_spec_of, _fold_elem, nguon_kieu_walk, _record_stmt_fallback, ta_elem_spec)
from expr_row import ea_ds, ekind
from tkv_types import TypeAnn
from stmt_row import intern, lay_nut, lay_str, make2, make3, lay_ds_nut


__tkv_import__ = ["il_dispatch", "tkv_types"]

def il_set_type(dtype: "str", records: "dict[str,list[(str,TkvTypeAnn)]]" = None, extern_class_defs: "dict[str,i32]" = None) -> "str":
    """Kieu IL cua 1 HashSet<T> DONG - xac minh THAT qua probe_hashset.il
    (2026-07-28): HashSet`1 nam trong assembly [System.Core], KHONG PHAI
    [mscorlib] nhu List`1/Dictionary`2 - bug that gap luc probe dau tien
    (TypeLoadException khi de nham [mscorlib]). '.assembly extern
    System.Core' phai duoc khai bao o dau file .il (xem tkv_compile.py).

    `extern_class_defs` (muc P, 2026-08-19): set/frozenset KHONG ho tro
    phan tu la handle type - HashSet<T> dua vao GetHashCode/Equals mac dinh
    (reference equality), rui ro tuong tu handle type lam khoa dict (da bi
    chan cung ly do o Phase 6). Tu choi RO RANG thay vi de roi vao nhanh
    loi chung cua il_list_elem_ilstr."""
    if extern_class_defs and dtype in extern_class_defs:
        raise SyntaxError(
            f"il_codegen: set/frozenset khong ho tro phan tu la handle type "
            f"('{dtype}' da khai qua __tkv_extern_class__) - HashSet<T> dua "
            f"vao GetHashCode/Equals mac dinh (reference equality), rui ro "
            f"tuong tu handle type lam khoa dict (da bi chan cung ly do)")
    return f'class [System.Core]System.Collections.Generic.HashSet`1<{il_list_elem_ilstr(dtype, records)}>'


_SET_NEW_RE = re.compile(r'^set\(\)\s*$')
_SET_ADD_RE = re.compile(r'^(\w+)\.add\((.+)\)\s*$')
_FROZENSET_NEW_RE = re.compile(r'^frozenset\((\w+)\)\s*$')
_FROZENSET_EMPTY_RE = re.compile(r'^frozenset\(\s*\)\s*$')
_FROZENSET_LIT_RE = re.compile(r'^frozenset\(\s*(\[.*\])\s*\)\s*$')


def compile_in_set(key_node: "TkvNode", coll_name: "str", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """CIL cho 'x in s' (s la set) - tag 'in' cua _compile_expr khi
    coll_ta.shape_ten=='set', xem il_codegen.py's _expr_in."""
    coll_ta = scope.tra(coll_name).ta
    ctx.load_var_ref(coll_name, scope, out)
    ctx.compile_expr(key_node, scope, out, coll_ta.dtype, ctx)
    set_type = il_set_type(coll_ta.dtype, (ctx.records if ctx is not None else None), (ctx.extern_class_defs if ctx is not None else None))
    out.append(f'    callvirt instance bool {set_type}::Contains(!0)')


def try_rhs_set_new(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    """ASSIGN_RHS_PARSERS entry: 's = set()' - dtype phan tu CHUA biet o
    day, suy sau tu LAN GOI '.add(...)' DAU TIEN, giong het list.append."""
    if not _SET_NEW_RE.match(rhs.strip()):
        return None
    known_shapes[name] = 'set'
    return intern(make2('assign_set_new', name))


def try_rhs_frozenset_new(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    """ASSIGN_RHS_PARSERS entry: 'fs = frozenset(lst)' - CHI nhan 1 BIEN
    list DON lam nguon (khong rong, khong bieu thuc phuc tap - gioi han
    cung theo plan 6.8). 'lst' PHAI da duoc khai bao/biet shape='list'
    TRUOC dong nay trong van ban nguon (known_shapes duoc cap nhat DAN
    theo thu tu parse - xem _lp_assign trong il_codegen.py) - neu chua,
    bao loi ro NGAY tai day thay vi de loi kho hieu ve sau."""
    m = _FROZENSET_NEW_RE.match(rhs.strip())
    if m:
        src = m.group(1)
        if known_shapes.get(src) != 'list':
            raise SyntaxError(
                f"il_codegen: frozenset({src}) - '{src}' phai la 1 BIEN list DA KHAI BAO "
                f"TRUOC dong nay (dang co known_shapes={known_shapes.get(src)!r}) - frozenset() "
                f"hien CHI ho tro frozenset(<bien_list_don>)")
        known_shapes[name] = 'frozenset'
        return intern(make3('assign_frozenset_new', name, src))
    if _FROZENSET_EMPTY_RE.match(rhs.strip()):
        known_shapes[name] = 'frozenset'
        return intern(make2('assign_frozenset_empty', name))
    m = _FROZENSET_LIT_RE.match(rhs.strip())
    if m:
        known_shapes[name] = 'frozenset'
        return intern(make3('assign_frozenset_literal', name, m.group(1)))
    return None


def try_parse_set_add(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """LINE_PARSERS entry: 's.add(x)' - PHAI dang ky TRUOC method_call_stmt
    (pattern method-call tong quat cung khop dong nay).

    2026-10-08 (port tu Python, 2026-09-29): phai loai tru khi
    `known_shapes` da XAC NHAN la kieu khac (vd `b.add(1)` la method cua
    record, KHONG phai set.add). Truoc day nhanh nay khong co guard nao.
    Giong `try_parse_list_sort`/`try_parse_container_clear` (cung loai tru
    shape khac 'set')."""
    m = _SET_ADD_RE.match(line)
    if not m:
        return None
    _sh = known_shapes.get(m.group(1))
    if _sh is not None and _sh != 'set' and _sh != 'frozenset':
        return None
    name, arg_expr = m.groups()
    return intern(make3('set_add', name, arg_expr)), pos + 1


def codegen_assign_set_new(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 's = set()'.

    (2026-10-11) `il_type_str` chu KHONG `il_set_type(ta.dtype)`: khi phan tu
    la container literal (`ss.add([1, 2])` -> HashSet<List<T>>) thi `ta.dtype`
    chi la LEAF, sinh `newobj HashSet<TkvInt>` lech voi local khai
    `HashSet<List<TkvInt>>` -> `AccessViolationException` luc chay."""
    ta = scope.tra(lay_str(stmt, 'name')).ta
    body.append(f'    newobj instance void {ctx.il_type_str(ta, ctx.records)}::.ctor()')
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def codegen_assign_frozenset_new(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'fs = frozenset(lst)' - HashSet<T>(IEnumerable<T>)
    dien san tu 'lst' (xac nhan THAT qua PowerShell reflection, Step 1 cua
    plan 6.8/frozenset) - phan tu trung lap trong 'lst' tu dong bi loai
    (ban chat HashSet). BAT BIEN sau khi tao: khong co duong codegen nao
    khac ghi lai vao 'fs' (.add()/.remove()/.discard() bi chan o guard
    rieng, xem codegen_set_add/_codegen_set_remove_like)."""
    ta = scope.tra(lay_str(stmt, 'name')).ta
    ctx.load_var_ref(lay_str(stmt, 'src'), scope, body)
    body.append(
        f'    newobj instance void {ctx.il_type_str(ta, ctx.records)}::.ctor(class '
        f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def codegen_set_add(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 's.add(x)' - HashSet<T>.Add(T) tra ve bool
    (khac List<T>.Add(T) la void, xac minh THAT qua probe_hashset.il) -
    can 'pop' bo ket qua khi dung nhu 1 lenh doc lap (khong gan bien)."""
    # Safety net R4/D6 (port tu Python, 2026-09-29): receiver THAT SU la
    # record nhung luc parse known_shapes chua biet nen van bi hieu nham
    # la set_add (`b.add(3)` la method cua record). Phat lai thanh record
    # method call o day - noi DUY NHAT con kieu de biet that.
    if _record_stmt_fallback(lay_str(stmt, 'name'), 'add', [lay_nut(stmt, 'value_node')], scope, body, ctx):
        return
    ta = scope.tra(lay_str(stmt, 'name')).ta
    if ta.shape_ten == 'frozenset':
        raise SyntaxError(
            f"il_codegen: '{lay_str(stmt, 'name')}' la frozenset (bat bien) - khong the .add()")
    ctx.load_var_ref(lay_str(stmt, 'name'), scope, body)
    # (2026-10-11) phan tu la CONTAINER literal: `il_set_type(ta.dtype)` bo
    # qua `elem_ta` nen sinh `HashSet<TkvInt>` cho `ss = set(); ss.add([1, 2])`
    # trong khi khai bao la HashSet<List<T>>. Dung `il_type_str` (DE QUY, giong
    # codegen_list_append) va truyen spec day du cho gia tri.
    value_dtype = ta_elem_spec(ta)
    ctx.compile_expr(lay_nut(stmt, 'value_node'), scope, body, value_dtype, ctx)
    body.append(f'    callvirt instance bool {ctx.il_type_str(ta, ctx.records)}::Add(!0)')
    body.append('    pop')


def declare_set(name: "str", ctx: "WalkCtx") -> "i32":
    """FIRST_PASS_WALK helper: khai bao local HashSet<T> - dtype phan tu
    suy tu find_first_append_dtype(kind='set_add'). `ctx` o day la walk_ctx
    (xem il_codegen.py _first_pass_collect_locals), can them 'stmts'/
    'infer_dtype'/'contains_float_literal'/'int_dtypes'/'TypeAnn' (tiem
    tu core)."""
    declared_names = ctx.declared_names
    if name in declared_names:
        return 0
    hint = ctx.container_arg_hints.get(name, None)
    if hint is not None and hint.shape_ten == 'set' and hint.elem_ta is None:
        # Chu thich TUONG MINH thang phong doan tu gia tri dau tien - xem
        # _container_arg_hints trong il_codegen.py.
        declared_names.add(name)
        ctx.locals_decl.append((name, hint))
        ctx.infer_scope.set(name, hint)
        return 0
    elem_dtype = find_first_append_dtype(
        ctx.stmts, name, ctx.infer_scope, ctx, kind='set_add')
    elem_ta = find_first_append_elem_ta(ctx.stmts, name, ctx.infer_scope, kind='set_add')
    if elem_dtype is None and elem_ta is None and not _has_append_stmt(ctx.stmts, name, 'set_add'):
        elem_dtype = 'i32'          # set RONG suot doi - xem declare_list
    if elem_dtype is None and elem_ta is None and not ctx.final_pass:
        ctx.defer(lambda: declare_set(name, ctx))
        return 0
    if elem_dtype is None and elem_ta is None:
        raise SyntaxError(
            f"il_codegen: khong suy duoc kieu PHAN TU cua set {name!r} - hay goi "
            f"'{name}.add(<gia tri co kieu ro rang>)' truoc. TRUOC 2026-08-03 cho nay am "
            f"tham lay kieu TRA VE cua ham dang bien dich (nguon cua 5 bug sai am tham).")
    # (2026-10-11) `ss = set()` roi `ss.add([1, 2])` - phan tu la CONTAINER
    # literal nen phai khai HashSet<List<T>>, khong phai HashSet<TkvInt>.
    # `find_first_append_dtype` chi tra ve chuoi dtype LEAF nen can
    # `find_first_append_elem_ta` de lay TypeAnn DAY DU.
    ta = TypeAnn(elem_dtype, 'set')
    if elem_ta is not None:
        ta = TypeAnn(elem_ta.dtype, 'set', elem_ta=elem_ta)
    declared_names.add(name)
    ctx.locals_decl.append((name, ta))
    ctx.infer_scope.set(name, ta)
    return 0


def declare_frozenset(name: "str", src: "str", ctx: "WalkCtx"):
    """FIRST_PASS_WALK helper: khai bao local HashSet<T> cho 'fs =
    frozenset(lst)' - dtype phan tu LAY THANG tu dtype cua 'lst' (khac
    declare_set: khong can suy tu .add() vi da co du lieu san). 'lst'
    PHAI da duoc first-pass xu ly XONG truoc do (rang buoc thu tu khai
    bao van ban cua plan 6.8/frozenset) - neu chua co trong infer_scope,
    day la loi that (khong defer, khac declare_set: gia tri phan tu cua
    'lst' KHONG the doi sau khi da khai bao)."""
    declared_names = ctx.declared_names
    if name in declared_names:
        return
    try:
        src_ta = ctx.infer_scope.tra(src).ta
    except KeyError:
        raise SyntaxError(
            f"il_codegen: frozenset({src}) - '{src}' chua duoc khai bao TRUOC dong nay "
            f"(frozenset can list nguon khai bao truoc trong van ban)")
    if src_ta.shape_ten != 'list':
        raise SyntaxError(
            f"il_codegen: frozenset({src}) can '{src}' la list (dang co shape={src_ta.shape_repr()})")
    ta = TypeAnn(src_ta.dtype, 'frozenset')
    declared_names.add(name)
    ctx.locals_decl.append((name, ta))
    ctx.infer_scope.set(name, ta)


def fpw_assign_set_new(stmt: "i32", ctx: "WalkCtx"):
    declare_set(lay_str(stmt, 'name'), ctx)


def fpw_assign_frozenset_new(stmt: "i32", ctx: "WalkCtx"):
    declare_frozenset(lay_str(stmt, 'name'), lay_str(stmt, 'src'), ctx)


def fpw_set_add(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'value_node'))


def codegen_assign_frozenset_empty(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'fs = frozenset()'."""
    ta = scope.tra(lay_str(stmt, 'name')).ta
    body.append(f'    newobj instance void {ctx.il_type_str(ta, ctx.records)}::.ctor()')
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def codegen_assign_frozenset_literal(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'fs = frozenset([1, 2, 3])'."""
    ta = scope.tra(lay_str(stmt, 'name')).ta
    elements = lay_ds_nut(stmt, 'elements')
    set_type = ctx.il_type_str(ta, ctx.records)
    body.append(f'    newobj instance void {set_type}::.ctor()')
    for el in elements:
        body.append('    dup')
        ctx.compile_expr(el, scope, body, ta.dtype, ctx)
        body.append(f'    callvirt instance bool {set_type}::Add(!0)')
        body.append('    pop')
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def fpw_assign_frozenset_empty(stmt: "i32", ctx: "WalkCtx"):
    """FIRST_PASS_WALK: 'fs = frozenset()' - dtype phan tu lay hint tu
    container_arg_hints, neu khong co thi mac dinh i32."""
    name = lay_str(stmt, 'name')
    declared_names = ctx.declared_names
    if name in declared_names:
        return
    hint = None
    if ctx.container_arg_hints is not None:
        hint = ctx.container_arg_hints.get(name, None)
    if hint is not None and hint.shape_ten == 'frozenset':
        ta = hint
    else:
        ta = TypeAnn('i32', 'frozenset')
    declared_names.add(name)
    ctx.locals_decl.append((name, ta))
    ctx.infer_scope.set(name, ta)


def fpw_assign_frozenset_literal(stmt: "i32", ctx: "WalkCtx"):
    """FIRST_PASS_WALK: 'fs = frozenset([1, 2])' - gom logic cua
    declare_list_literal (suy dtype phan tu CHUoi) roi chuyen shape sang
    'frozenset'."""
    name = lay_str(stmt, 'name')
    elements = lay_ds_nut(stmt, 'elements')
    declared_names = ctx.declared_names
    if name in declared_names:
        return
    hint = None
    if ctx.container_arg_hints is not None:
        hint = ctx.container_arg_hints.get(name, None)
    if hint is not None and hint.shape_ten == 'frozenset':
        ta = hint
        declared_names.add(name)
        ctx.locals_decl.append((name, ta))
        ctx.infer_scope.set(name, ta)
        for el in elements:
            ctx.collect_ternary_temps(el)
        return
    records = (ctx.records if ctx is not None else None) or {}
    record_bases = (ctx.record_bases if ctx is not None else None) or {}
    elem_dtype = None
    elem_ta = None
    for el in elements:
        d = list_literal_elem_spec_of(el, ctx.infer_scope, nguon_kieu_walk(ctx))
        if d is not None and d.startswith('list[') and d.endswith(']'):
            inner = d[len('list['):-1].strip()
            d = inner
            d_ta = TypeAnn(inner, 'list')
        else:
            d_ta = None
        moi = _fold_elem(elem_dtype, d, records, record_bases)
        if moi != elem_dtype:
            elem_dtype = moi
            elem_ta = d_ta
    if elem_dtype is None:
        elem_dtype = 'i32'
    if elem_ta is not None:
        ta = TypeAnn(elem_dtype, 'frozenset', elem_ta=elem_ta)
    else:
        ta = TypeAnn(elem_dtype, 'frozenset')
    declared_names.add(name)
    ctx.locals_decl.append((name, ta))
    ctx.infer_scope.set(name, ta)
    for el in elements:
        ctx.collect_ternary_temps(el)


def bootstrap_set_type(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    # Dang ky vao il_dispatch NGAY LUC MODULE NAP (il_dispatch.py khong phu
    # thuoc il_codegen.py nen import truc tiep an toan, khong circular).
    register_assign_rhs_parser(reg, 'set_new', try_rhs_set_new)
    register_assign_rhs_parser(reg, 'frozenset_new', try_rhs_frozenset_new)
    register_line_parser(reg, 'set_add', try_parse_set_add)
    register_stmt_codegen(reg, 'assign_set_new', codegen_assign_set_new)
    register_stmt_codegen(reg, 'assign_frozenset_new', codegen_assign_frozenset_new)
    register_stmt_codegen(reg, 'set_add', codegen_set_add)
    register_first_pass_walk(reg, 'assign_set_new', fpw_assign_set_new)
    register_first_pass_walk(reg, 'assign_frozenset_new', fpw_assign_frozenset_new)
    register_first_pass_walk(reg, 'set_add', fpw_set_add)
    register_stmt_codegen(reg, 'assign_frozenset_empty', codegen_assign_frozenset_empty)
    register_stmt_codegen(reg, 'assign_frozenset_literal', codegen_assign_frozenset_literal)
    register_first_pass_walk(reg, 'assign_frozenset_empty', fpw_assign_frozenset_empty)
    register_first_pass_walk(reg, 'assign_frozenset_literal', fpw_assign_frozenset_literal)
