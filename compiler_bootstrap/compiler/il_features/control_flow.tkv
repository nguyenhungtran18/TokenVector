}

_LICM_BO: "list[str]" = ['try', 'nested_def']

# Bien dem CUA CHINH VONG - phai gom vao `biend` tren, KHONG THE so ra tu than.
#
# DO: `codegen_for` (va cac `codegen_for_in_*`) KHONG cat lenh `x = x + 1` vao
# than vong trong AST - no tu sinh o nhan `cont_lbl` luc codegen. nen quet
# than vong KHONG thay bien dem, va `x * n` bi kiem "bat bien" SAI.
#
# HAY NGHEM: compiler tu bien dich chinh no. `gen_il_function` co
#     for idx, p in enumerate(sig.params):
#         scope.add_arg(p.name, idx + param_idx_base, p.type_ann)
# `idx` bi nho sai => MOI tham so deu nhan idx 0 => sanh ra `ldarg.s 0` cho
# TAT CA tham so khac 0. Do la mau truong hinh dung: bo nho mot bien MAU
# (counter) ma thuc te bien doi moi vong la bug sai KET QUA, khong phai la
# toan hoc sai.
#
# `while` khong can: nguoi dung viet `i = i + 1` trong than, `que` da thay.
_LICM_DEM_VONG: "dict[str,str]" = {
    "for": "var",
    "for_in_iter": "var,record_var",
    "for_in_dict_items": "key_var,val_var",
    "for_in_generator": "var",
    "for_in_call_list": "var",
}


def _licm_khoa(node: "TkvNode") -> "str":
    """Khoa VAN BAN cua bieu thuc `A + B` / `A - B` / `A * B` voi A, B la
    bien - `''` neu node khong dung dang do. Tinh thuan TU CAU TRUC (khong
    can scope) vi ca bo thu thap lan bo viet lai deu goi no."""
    if not la_node(node):
        return ''
    if ekind(node) != 'binop':
        return ''
    op = ea_str(node)
    if op != '+' and op != '-' and op != '*':
        return ''
    l = eb_nut(node)
    r = ec_nut(node)
    if not la_node(l) or ekind(l) != 'var':
        return ''
    if not la_node(r) or ekind(r) != 'var':
        return ''
    return op + '|' + ea_str(l) + '|' + ea_str(r)


def _licm_doc_duoc(scope: "Scope", ten: "str") -> "i32":
    """1 neu `ten` la bien VOHUONG ma phep nho duoc - xem ghi chu pham vi."""
    if ten not in scope.vars:
        return 0
    b = scope.tra(ten)
    if b.kind != 'local' and b.kind != 'arg' and b.kind != 'const':
        return 0
    if b.ta is None or not b.ta.la_vo_huong():
        return 0
    return 1


def _licm_la_bat_bien(scope: "Scope", biend: "set[str]", khoa: "str") -> "i32":
    if khoa == '':
        return 0
    ds = khoa.split('|')
    for ten in ds[1:]:
        if ten in biend:
            return 0
        if _licm_doc_duoc(scope, ten) == 0:
            return 0
    return 1


def _licm_con(node: "TkvNode") -> "list[TkvNode]":
    """CAC NODE CON cua 1 node bieu thuc, theo `KHUON` (expr_layout.tkv).
    RONG cho kind la - nghia la 'bo qua o duoi'.

    TUONG XUNG voi `_licm_viet_node`: hai ham phai doc CUNG khuong. `KHUON`
    hoa `str` / `nut` / `ds` la 3 kieu KHAC NHAU - goi `eb_nut` tren o 'ds'
    se goi int("12,34") va nem "Input string was not in a correct format".
    """
    k = ekind(node)
    if k == '':
        return []
    ra: "list[TkvNode]" = []
    if k == 'binop' or k == 'compare' or k == 'boolop':
        ra.append(eb_nut(node))
        ra.append(ec_nut(node))
        return ra
    if k == 'in':
        ra.append(ea_nut(node))
        ra.append(eb_nut(node))
        return ra
    if k == 'ternary':
        ra.append(ea_nut(node))
        ra.append(eb_nut(node))
        ra.append(ec_nut(node))
        return ra
    if k == 'index_expr':
        ra.append(ea_nut(node))
        ra.append(eb_nut(node))
        return ra
    if k == 'kwarg':
        ra.append(eb_nut(node))
        return ra
    if k == 'index_call':
        ra.append(ea_nut(node))
        for x in eb_ds(node):
            ra.append(x)
        return ra
    if k == 'star' or k == 'star2' or k == 'neg' or k == 'not' or k == 'await':
        ra.append(ea_nut(node))
        return ra
    if k == 'slice':
        if la_node(eb_nut(node)):
            ra.append(eb_nut(node))
        if la_node(ec_nut(node)):
            ra.append(ec_nut(node))
        return ra
    if k == 'call' or k == 'index':
        # 'call:1': 'str' (TEN HAM), 'call:2': 'ds' - danh sach node o O2.
        for x in eb_ds(node):
            ra.append(x)
        return ra
    if k == 'method_call':
        for x in ec_ds(node):
            ra.append(x)
        return ra
    if k == 'list_literal' or k == 'tuple_lit' or k == 'set_lit' or k == 'dict_lit':
        for x in ea_ds(node):
            ra.append(x)
        return ra
    return []


def _licm_tim_node(node: "TkvNode", scope: "Scope", biend: "set[str]", ra: "dict[str,TkvNode]", keys: "list[str]") -> "i32":
    """Ghi moi bieu thuc BAT BIEN tim duoc trong `node` vao `ra` (khoa ->
    node) va `keys` (thu tu). Tra 0 khi gap `walrus` (gan bien giua vong)."""
    if not la_node(node):
        return 1
    k = ekind(node)
    if k == 'walrus':
        return 0
    khoa = _licm_khoa(node)
    if khoa != '' and _licm_la_bat_bien(scope, biend, khoa) == 1 and khoa not in ra:
        ra[khoa] = node
        keys.append(khoa)
    for con in _licm_con(node):
        if _licm_tim_node(con, scope, biend, ra, keys) == 0:
            return 0
    return 1


def _licm_quet(stmts: "list[i32]", biend: "set[str]") -> "i32":
    """Gom vao `biend` TEN MOI BIEN duoc GAN o trong `stmts` (ke ca trong
    vong long, if/else, for...in, khuuc `with`). Tra 0 (bo LICM cho ca vong)
    neu gap cau lenh ma la khong doc."""
    for st in stmts:
        k = kind_of_stmt(st)
        for bo in _LICM_BO:
            if k == bo:
                return 0
        spec = _LICM_MUC.get(k)
        if spec is None:
            return 0
        if spec != '':
            for f in spec.split(','):
                v = lay_str(st, f)
                if v is None or v == '':
                    continue
                for t in v.split(','):
                    if t.strip() != '':
                        biend.add(t.strip())
        for vt in cac_than_vung(st):
            if _licm_quet(body_of(vt), biend) == 0:
                return 0
    return 1


def _licm_tim(stmts: "list[i32]", scope: "Scope", biend: "set[str]", ra: "dict[str,TkvNode]", keys: "list[str]") -> "i32":
    """Tim moi bieu thuc bat bien trong `stmts` (xem `_licm_tim_node`)."""
    for st in stmts:
        for khoa_trg, nut_trg in items_nut(st):
            if _licm_tim_node(nut_trg, scope, biend, ra, keys) == 0:
                return 0
        if kind_of_stmt(st) == 'idx_assign':
            for x in lay_ds_nut(st, 'idx_nodes'):
                if _licm_tim_node(x, scope, biend, ra, keys) == 0:
                    return 0
        for vt in cac_than_vung(st):
            if _licm_tim(body_of(vt), scope, biend, ra, keys) == 0:
                return 0
    return 1


def _licm_o_nut(node: "TkvNode", bang: "dict[str,str]") -> "str":
    """`o_nut` sau khi viet lai, giu nguyen o VANG khi node rong (`slice`)."""
    if not la_node(node):
        return o_nut(-1)
    return o_nut(_licm_viet_node(node, bang))


def _licm_viet_node(node: "TkvNode", bang: "dict[str,str]") -> "TkvNode":
    """Node MOI cho `node`: moi bieu thuc trong `bang` da duoc thay bang
    bien tam. Tra ve `node` luon neu khong co gi doi."""
    k = ekind(node)
    if k == '':
        return node
    khoa = _licm_khoa(node)
    if khoa != '' and khoa in bang:
        return mk2('var', o_str(bang[khoa]))
    if k == 'binop' or k == 'compare' or k == 'boolop':
        return mk4(k, o_str(ea_str(node)), o_nut(_licm_viet_node(eb_nut(node), bang)),
                   o_nut(_licm_viet_node(ec_nut(node), bang)))
    if k == 'in':
        return mk3(k, o_nut(_licm_viet_node(ea_nut(node), bang)),
                   o_nut(_licm_viet_node(eb_nut(node), bang)))
    if k == 'ternary':
        return mk4(k, o_nut(_licm_viet_node(ea_nut(node), bang)),
                   o_nut(_licm_viet_node(eb_nut(node), bang)),
                   o_nut(_licm_viet_node(ec_nut(node), bang)))
    if k == 'index_expr':
        return mk3(k, o_nut(_licm_viet_node(ea_nut(node), bang)),
                   o_nut(_licm_viet_node(eb_nut(node), bang)))
    if k == 'kwarg':
        return mk3(k, o_str(ea_str(node)), o_nut(_licm_viet_node(eb_nut(node), bang)))
    if k == 'index_call':
        return mk3(k, o_nut(_licm_viet_node(ea_nut(node), bang)),
                   o_ds(_licm_viet_ds(eb_ds(node), bang)))
    if k == 'star' or k == 'star2' or k == 'neg' or k == 'not' or k == 'await':
        return mk2(k, o_nut(_licm_viet_node(ea_nut(node), bang)))
    if k == 'slice':
        return mk4(k, o_str(ea_str(node)), _licm_o_nut(eb_nut(node), bang),
                   _licm_o_nut(ec_nut(node), bang))
    if k == 'call' or k == 'index':
        return mk3(k, o_str(ea_str(node)), o_ds(_licm_viet_ds(eb_ds(node), bang)))
    if k == 'method_call':
        return mk4(k, o_str(ea_str(node)), o_str(eb_str(node)), o_ds(_licm_viet_ds(ec_ds(node), bang)))
    if k == 'list_literal' or k == 'tuple_lit' or k == 'set_lit' or k == 'dict_lit':
        return mk2(k, o_ds(_licm_viet_ds(ea_ds(node), bang)))
    return node


def _licm_viet_ds(ds: "list[TkvNode]", bang: "dict[str,str]") -> "list[TkvNode]":
    ra: "list[TkvNode]" = []
    for x in ds:
        ra.append(_licm_viet_node(x, bang))
    return ra


def _licm_viet_stmts(stmts: "list[i32]", bang: "dict[str,str]") -> "i32":
    """Viet lai moi node bieu thuc trong `stmts` (ke ca trong vong long).

    GHI TAI CHO row (`dat_nut`) chu KHONG tao row moi: `intern` KHONG kiem
    trung (stmt_row.tkv) nen moi lan xuat hien la mot chi so rieng - sua cho
    1 khong lan sang khac. Ve phai thi dung node MOI (`_licm_viet_node`) vi node
    bieu thuc co ghi nho nen node cu dang dung o noi khac se doi theo."""
    for st in stmts:
        for khoa_trg, nut_trg in items_nut(st):
            dat_nut(st, khoa_trg, _licm_viet_node(nut_trg, bang))
        if kind_of_stmt(st) == 'idx_assign':
            dat_ds_nut(st, 'idx_nodes', _licm_viet_ds(lay_ds_nut(st, 'idx_nodes'), bang))
        for vt in cac_than_vung(st):
            if _licm_viet_stmts(body_of(vt), bang) == 0:
                return 0
    return 1


def _licm(stmt: "i32", scope: "Scope", body: "list[str]", ctx: "Ctx") -> "i32":
    """Dien LICM cho vong lap `stmt` ('while'/'for'). Tra 1 neu co nhu ho.

    Ghi phan tinh vao `body` (preheader, TRUOC nhan `start_lbl` cua vong) va
    khai local tam vao `ctx.locals_decl` - danh sach CHUNG voi chuoi
    `.locals init` (xem `tao_ctx` trong il_codegen.tkv) nen bien moi se co
    that trong file .il."""
    if ctx.gen_ctx is not None:
        return 0
    if lay_than(stmt, 'else_body') is not None:
        return 0
    stmts = lay_than(stmt, 'body')
    if stmts is None or len(stmts) == 0:
        return 0
    biend: "set[str]" = set()
    if _licm_quet(stmts, biend) == 0:
        return 0
    for f in _LICM_DEM_VONG.get(kind_of_stmt(stmt), '').split(','):
        v = lay_str(stmt, f)
        if v is not None and v != '':
            biend.add(v)
    ra: "dict[str,TkvNode]" = {}
    keys: "list[str]" = []
    if _licm_tim(stmts, scope, biend, ra, keys) == 0:
        return 0
    if len(keys) == 0:
        return 0
    # Chi phep phep SO - `+` tren chuoi la noi xau, 'f32x4' la lenh goi
    # Vector4 nen khong phai phep thuan tinh de nho.
    so: "list[str]" = []
    dt: "list[str]" = []
    for khoa in keys:
        d = ctx.infer_dtype(ra[khoa], scope, ctx.func_table, ctx.records,
                            ctx.record_methods, None)
        if d is None:
            continue
        if d not in ctx.int_dtypes and d not in ctx.float_dtypes:
            continue
        so.append(khoa)
        dt.append(d)
    if len(so) == 0:
        return 0
    # Khai local tam. Chi so o nho = VI TRI trong `ctx.locals_decl` (dung thu
    # tu hieu chuoi `.locals init` sinh o gen_il_function).
    bang: "dict[str,str]" = {}
    for i in range(len(so)):
        bang[so[i]] = '__licm' + str(len(ctx.locals_decl))
        ta = TypeAnn(dt[i], None)
        ctx.locals_decl.append((bang[so[i]], ta))
        scope.add_local(bang[so[i]], len(ctx.locals_decl) - 1, ta)
    # Preheader: tinh TAT CA truoc khi vao vong.
    for i in range(len(so)):
        ctx.compile_expr(ra[so[i]], scope, body, dt[i], ctx)
        ctx.store_var(bang[so[i]], scope, body)
    _licm_viet_stmts(stmts, bang)
    return 1


def codegen_for(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    var, bound_node = lay_str(stmt, 'var'), lay_nut(stmt, 'bound_node')
    start_node = lay_nut(stmt, 'start_node')
    step = lay_i32(stmt, 'step')
    if step is None:
        step = 1
    compile_expr, load_var_ref, store_var = ctx.compile_expr, ctx.load_var_ref, ctx.store_var
    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    start_lbl, end_lbl = f'{sig.name}_L{n}_start', f'{sig.name}_L{n}_end'
    # 'continue' phai nhay toi PHAN TANG bien vong lap (khong phai
    # start_lbl - dieu kien kiem tra ban dau), giu dung ngu nghia Python:
    # continue van tang bien roi kiem tra dieu kien lai, khong bo qua buoc
    # tang.
    cont_lbl = f'{sig.name}_L{n}_cont'
    if start_node is None:
        body.append('    ldc.i4.0')
    else:
        compile_expr(start_node, scope, body, 'i32', ctx)
    store_var(var, scope, body)
    emit_sb_setup(stmt, scope, body, ctx)
    # LICM: trich phan tinh DUOC nho ra truoc nhan start_lbl (sau buoc khoi
    # tao bien dem, vi 'var' cua vong for la bien bat bien).
    _licm(stmt, scope, body, ctx)
    body.append(f'  {start_lbl}:')
    load_var_ref(var, scope, body)
    compile_expr(bound_node, scope, body, 'i32', ctx)
    # step > 0 (mac dinh, hoac 'range(a,b)'): dung 'while var < stop'
    # (bge nhay toi end khi var>=stop). step < 0 ('range(a,b,-k)', Wave 3
    # 2026-07-29): dao nguoc thanh 'while var > stop' (ble nhay toi end
    # khi var<=stop) - giong het ngu nghia range() nghich cua Python that.
    body.append(f'    {"bge" if step > 0 else "ble"} {end_lbl}')
    ctx.loop_stack.append((cont_lbl, end_lbl))
    codegen_stmts_fn(lay_than(stmt, 'body'), scope, body, body_dtype, ctx, sig)
    ctx.loop_stack.pop()
    body.append(f'  {cont_lbl}:')
    load_var_ref(var, scope, body)
    if step >= 0:
        body.append(f'    ldc.i4 {step}')
        body.append('    add')
    else:
        body.append(f'    ldc.i4 {-step}')
        body.append('    sub')
    store_var(var, scope, body)
    body.append(f'    br {start_lbl}')
    body.append(f'  {end_lbl}:')
    # SAU nhan ket thuc: 'break' nhay toi day nen van duoc dong bo.
    emit_sb_flush(stmt, scope, body, ctx)


def _p6_num_is_one(node: "TkvNode") -> "i32":
    """1 neu node la hang so BANG 1 ('1', '1.0', '1.00')."""
    if not la_node(node) or ekind(node) != 'num':
        return 0
    v = ea_str(node)
    if v == '1':
        return 1
    if '.' in v or 'e' in v.lower() or 'E' in v:
        try:
            return 1 if float(v) == 1.0 else 0
        except ValueError:
            return 0
    try:
        return 1 if int(v) == 1 else 0
    except ValueError:
        return 0


def _p6_var_is(node: "TkvNode", ten: "str") -> "i32":
    """1 neu node la bien `ten`."""
    if not la_node(node) or ekind(node) != 'var':
        return 0
    return 1 if ea_str(node) == ten else 0


def _p6_vec_rhs_ok(node: "TkvNode") -> "i32":
    """Ve phai (sau khi viet lai) co THE bien dich thanh phep so hoc vector.

    Moi toan tu phai la `+`/`-`/`*`/`/`, va la phai la `v_load4` hoac hang so.
    Tu choi con lai - `a[i] > b[i]` tra i32 chu khong phai Vector4, nen se sinh
    IL sai ma bien dich VAN khong bao loi."""
    if not la_node(node):
        return 0
    if ekind(node) == 'call' and ea_str(node) == 'v_load4':
        return 1
    if ekind(node) == 'binop':
        op = ea_str(node)
        if op == '+' or op == '-' or op == '*' or op == '/':
            return _p6_vec_rhs_ok(eb_nut(node)) * _p6_vec_rhs_ok(ec_nut(node))
    return 0


def _p6_is_f32buf(scope: "Scope", ten: "str") -> "i32":
    try:
        ta = scope.tra(ten).ta
    except (KeyError, SyntaxError):
        return 0
    return 1 if ta is not None and ta.shape_ten == 'f32buf' else 0


def _p6_chi_so_la_iv(node: "TkvNode", iv: "str") -> "i32":
    """1 neu chi so cua `f[i]` DUNG `iv` (chi so khac lech byte -> tu choi)."""
    ds = eb_ds(node)
    if len(ds) != 1:
        return 0
    return _p6_var_is(ds[0], iv)


def _p6_viet_lai_rhs(node: "TkvNode", scope: "Scope", iv: "str", loads: "list[str]") -> "TkvNode":
    """Doi quy ve phai: moi `f[i]` tren f32buf -> `v_load4(f, i*4)`.

    Tra None neu gap thu gi khong hop le - thi ca vong lap khong vector hoa duoc
    (quy tac 'hoi nghi = tu choi').

    Node arena la CHI SO (i32) nen moi o con cua `mk*` (khai `str`) phai boc
    bang `o_nut`; `o_ds` nhan `list[TkvNode]` nen danh sach phai khai bao kieu
    truoc khi gan (khong truyen list literal - se bi suy sai kieu)."""
    if not la_node(node):
        return node
    k = ekind(node)
    if k == 'index':
        ten = ea_str(node)
        if _p6_is_f32buf(scope, ten) == 0:
            return None
        if _p6_chi_so_la_iv(node, iv) == 0:
            return None
        loads.append(ten)
        _n1 = mk2('var', o_str(ten))
        _c1 = mk2('var', o_str(iv))
        _c2 = mk2('num', o_str('4'))
        _n2 = mk4('binop', o_str('*'), o_nut(_c1), o_nut(_c2))
        args: "list[TkvNode]" = []
        args.append(_n1)
        args.append(_n2)
        return mk3('call', o_str('v_load4'), o_ds(args))
    if k == 'binop':
        l = _p6_viet_lai_rhs(eb_nut(node), scope, iv, loads)
        if l is None:
            return None
        r = _p6_viet_lai_rhs(ec_nut(node), scope, iv, loads)
        if r is None:
            return None
        return mk4('binop', o_str(ea_str(node)), o_nut(l), o_nut(r))
    return node


def _p6_vectorize_while(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void", n: "i32") -> "i32":
    """P6 (2026-09-29): TU DONG VECTOR HOA vong lap elementwise tren `f32buf`.

    Nhan dien MOT DANG duy nhat, het mong dong:

        i = 0
        while i < n:
            r[i] = a[i] + b[i]
            i = i + 1

    than giong het, nhung vong lap chay buoc 4 (nap/ghi 16 byte bang
    `v_load4`/`v_store4`) roi den DUOI SCALAR cho `n % 4` phan tu con lai.
    Bien dem `i` ket thuc o `n` y het ban goc, nen code sau vong lap khong
    nhin thay khac biet gi.

    **Tu choi ve 0 khi co BAT KY nghi nho nao.** Bien doi nay sua SO HOC cua code
    ma khong he nhac toi vector, mot loi se khong co trieu chung gi:

    - dieu kien phai la `<iv> < <n>`, ca hai la BIEN TRAN
    - than phai DUNG HAI cau lenh: 1 `idx_assign` va 1 phep tang `iv = iv + 1`
    - `r` phai la bien `f32buf`; moi `r[i]` trong ve phai dung CHUNG `iv`
    - ve phai chi gom phep so hoc ma vector ho tro, va MOI LA phai la
      `v_load4` (xem `_p6_vec_rhs_ok`)

    Vi sao KHONG chap nhan hang so trong ve phai (`a[i] * 1.5`): `_expr_num` tu
    choi moi dtype tru 'f32x4' (khong co lenh `ldc` nao sinh duoc mot vector), va
    khai bao intrinsic `v_set4` de broadcast thi CHUA ton tai. Thay vao do,
    vong lap do chay duong scalar binh thuong - dung, chi la cham hon."""

    if lay_than(stmt, 'else_body'):
        return 0
    stmts = lay_than(stmt, 'body')
    if len(stmts) != 2:
        return 0
    cond = lay_nut(stmt, 'cond_node')
    # Toan tu cua node `compare`/`binop` nam o FIELD 1 (`ea_str`), con so hang o
    # field 2/3 (`eb_nut`/`ec_nut`) - xem compile_compare o operators.tkv. Node
    # arena CHI co toi da 3 o (khong co `ed_nut`).
    if not la_node(cond) or ekind(cond) != 'compare' or ea_str(cond) != '<':
        return 0
    iv_node = eb_nut(cond)
    n_node = ec_nut(cond)
    if not la_node(iv_node) or ekind(iv_node) != 'var':
        return 0
    if not la_node(n_node) or ekind(n_node) != 'var':
        return 0
    iv = ea_str(iv_node)
    # Mot bien chi giu MOT kieu: stmt trong arena la chi so i32 nen dung -1 lam
    # CO HIEU thay vi None.
    idx_st = -1
    inc_st = -1
    for st in stmts:
        k = lay_str(st, 'kind')
        if k == 'idx_assign' and idx_st < 0:
            idx_st = st
        elif k == 'assign_scalar' and inc_st < 0:
            inc_st = st
    if idx_st < 0 or inc_st < 0:
        return 0
    if lay_str(inc_st, 'name') != iv:
        return 0
    inc_rhs = lay_nut(inc_st, 'rhs_node')
    if not la_node(inc_rhs) or ekind(inc_rhs) != 'binop' or ea_str(inc_rhs) != '+':
        return 0
    if _p6_var_is(eb_nut(inc_rhs), iv) == 0 or _p6_num_is_one(ec_nut(inc_rhs)) == 0:
        return 0
    dest = lay_str(idx_st, 'name')
    idx_nodes = lay_ds_nut(idx_st, 'idx_nodes')
    if len(idx_nodes) != 1 or _p6_var_is(idx_nodes[0], iv) == 0:
        return 0
    if _p6_is_f32buf(scope, dest) == 0:
        return 0
    loads: "list[str]" = []
    rewritten = _p6_viet_lai_rhs(lay_nut(idx_st, 'rhs_node'), scope, iv, loads)
    if rewritten is None or len(loads) == 0:
        return 0
    if _p6_vec_rhs_ok(rewritten) == 0:
        return 0
    vec_start = sig.name + '_W' + str(n) + '_vstart'
    vec_done = sig.name + '_W' + str(n) + '_vdone'
    tail_start = sig.name + '_W' + str(n) + '_tstart'
    end_lbl = sig.name + '_W' + str(n) + '_end'
    # Offset byte: `i * 4`. `_vb_addr` tu ep ve 'i64' nen dtype o day KHONG
    # quan trong - nhung van phai dung node that, khong hard-code.
    _o1 = mk2('var', o_str(iv))
    _o2 = mk2('num', o_str('4'))
    off = mk4('binop', o_str('*'), o_nut(_o1), o_nut(_o2))
    # VONG LAP VECTOR: chay khi con du 4 phan tu (iv + 3 < n)
    body.append('  ' + vec_start + ':')
    _g1 = mk2('var', o_str(iv))
    _g2 = mk2('num', o_str('3'))
    _g3 = mk4('binop', o_str('+'), o_nut(_g1), o_nut(_g2))
    _gc = mk4('compare', o_str('<'), o_nut(_g3), o_nut(n_node))
    _compile_cond(_gc, scope, body, body_dtype, ctx)
    body.append('    brfalse ' + vec_done)
    st_args: "list[TkvNode]" = []
    st_args.append(mk2('var', o_str(dest)))
    st_args.append(off)
    st_args.append(rewritten)
    ctx.compile_expr(mk3('call', o_str('v_store4'), o_ds(st_args)),
                     scope, body, 'i32', ctx)
    body.append('    pop')
    # `iv = iv + 4`. PHAI bien dich `iv + 4` o kieu THAT cua `iv`: trong test
    # `i` la bien so nguyen -> khai `int` (TkvInt, 16 byte). Bien dich voi
    # 'i32' roi `store_var` se chi ghi 4 byte vao local 16 byte, truong `big`
    # con rong -> `NullReferenceException` o lan doc TktInt sau do (da do
    # 2026-10-11).
    _ta_iv = scope.tra(iv).ta
    _i1 = mk2('var', o_str(iv))
    _i2 = mk2('num', o_str('4'))
    _ic = mk4('binop', o_str('+'), o_nut(_i1), o_nut(_i2))
    ctx.compile_expr(_ic, scope, body, _ta_iv.dtype, ctx)
    ctx.store_var(iv, scope, body)
    body.append('    br ' + vec_start)
    body.append('  ' + vec_done + ':')
    # DUOI SCALAR: phan con lai (n % 4) chay bang lenh goc
    body.append('  ' + tail_start + ':')
    _compile_cond(lay_nut(stmt, 'cond_node'), scope, body, body_dtype, ctx)
    body.append('    brfalse ' + end_lbl)
    ctx.loop_stack.append((tail_start, end_lbl))
    codegen_stmts_fn(lay_than(stmt, 'body'), scope, body, body_dtype, ctx, sig)
    ctx.loop_stack.pop()
    body.append('    br ' + tail_start)
    body.append('  ' + end_lbl + ':')
    return 1


def codegen_while(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    # P6: thu vector hoa TRUOC khi phat vong lap vohua. Neu khop mau, ham nay
    # tu phat ca vong vector + duoi scalar.
    if _p6_vectorize_while(stmt, scope, body, body_dtype, ctx, sig,
                           codegen_stmts_fn, n) == 1:
        return
    start_lbl, end_lbl = f'{sig.name}_W{n}_start', f'{sig.name}_W{n}_end'
    # 'continue' trong while nhay THANG ve start_lbl (kiem tra dieu kien
    # lai) - khac 'for' vi while khong co buoc tang rieng.
    emit_sb_setup(stmt, scope, body, ctx)
    # LICM: trich phan tinh DUOC nho ra truoc nhan start_lbl.
    _licm(stmt, scope, body, ctx)
    body.append(f'  {start_lbl}:')
    _compile_cond(lay_nut(stmt, 'cond_node'), scope, body, body_dtype, ctx)
    body.append(f'    brfalse {end_lbl}')
    ctx.loop_stack.append((start_lbl, end_lbl))
    codegen_stmts_fn(lay_than(stmt, 'body'), scope, body, body_dtype, ctx, sig)
    ctx.loop_stack.pop()
    body.append(f'    br {start_lbl}')
    body.append(f'  {end_lbl}:')
    # SAU nhan ket thuc: 'break' nhay toi day nen van duoc dong bo.
    emit_sb_flush(stmt, scope, body, ctx)


def _compile_cond(cond_node: "TkvNode", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx"):
    """Dieu kien cua if/while - 'brfalse' doi mot int32 tren stack.

    BUG THAT (moc 6 lat 3, 2026-08-05): truoc day dieu kien duoc bien
    dich voi body_dtype, tuc trong mot ham tra ve 'int' thi dieu kien
    duoc YEU CAU kieu 'int'. Bieu thuc nao co gia tri THAT la i32 -
    'any(xs)', 'k in d', mot ham tra i32 - deu bi _widen_if_needed nang
    len TkvInt, roi 'brfalse' nhin mot STRUCT nhu mot dia chi:
    AccessViolationException, khong phai mot loi bien dich. Cac dieu kien
    so sanh ('i <= n') sONG SOT chi vi chung tu sinh i32 va khong di qua
    duong widen - tuc lop bug nay AN NAP sau cai ve ngoai "if/while chay
    tot voi int".

    Nay: trong ngu canh 'int', dieu kien duoc bien dich o kieu TU NHIEN
    cua no (i32) - tru khi chinh no la mot gia tri 'int', luc do dung
    ngu nghia truthy cua Python (khac 0 la dung) qua TkvInt::IsZero."""
    # P6 (2026-09-08): `if m:` voi m la ket qua khop regex. KHONG duoc de
    # 'brfalse' nhin thang vao handle: Regex.Match tra ve Match.Empty (mot
    # doi tuong THAT, khong null) khi khong khop -> phep thu null luon cho
    # TRUE, tuc dieu kien LUON dung ma khong bao loi gi. Phai doc .Success.
    _nat = ctx.infer_dtype(cond_node, scope, ctx.func_table,
                           ctx.records, ctx.record_methods, None)
    if _nat == 'match':
        ctx.compile_expr(cond_node, scope, body, 'match', ctx)
        emit_success(body)
        return
    # Container TRUOC nhanh chuoi: 'list[str]' co infer_dtype='str' va 'attr' duoc
    # la_chuoi_vo_huong coi la chuoi -> IsNullOrEmpty(string) tren 1 List (2026-09-29).
    _ta_ct = container_var_ta(cond_node, scope, ctx)
    if _ta_ct is not None:
        # 'while stack:' / 'if d:' (2026-09-29): container khong rong.
        nap_container_khong_rong(cond_node, _ta_ct, scope, body, ctx)
        return
    if _nat == 'str' and la_chuoi_vo_huong(cond_node, scope):
        # 'if s:' / 'if a or b:' voi gia tri CHUOI (2026-09-26): chan ly Python
        # = khac rong. 'brfalse' tren tham chieu coi "" la DUNG - sai am tham.
        ctx.compile_expr(cond_node, scope, body, 'str', ctx)
        body.append('    call bool [mscorlib]System.String::IsNullOrEmpty(string)')
        body.append('    ldc.i4.0')
        body.append('    ceq')
        return
    if ekind(cond_node) == 'num' and '.' not in ea_str(cond_node):
        # Literal so lam dieu kien ('if 1:', 'if True:') luon la i32, KHONG
        # theo kieu tra ve cua ham (2026-09-29): ham tra 'str' tung nem
        # KeyError('str') o IL_LDC_OP.
        ctx.compile_expr(cond_node, scope, body, 'i32', ctx)
        return
    natural = ctx.infer_dtype(cond_node, scope, ctx.func_table,
                              ctx.records, ctx.record_methods, None)
    # Bien 'int' (TkvInt = STRUCT) lam dieu kien: LUON di duong IsZero, bat ke
    # kieu tra ve cua ham (2026-09-29). Truoc day chi khi ham tra 'int'; ham tra
    # record/str thi 'brfalse' nhin struct nhu dia chi -> AccessViolation
    # ('flag = False' roi 'elif flag:' trong ham tra record).
    if body_dtype != 'int' and natural != 'int':
        ctx.compile_expr(cond_node, scope, body, body_dtype, ctx)
        return
    if natural == 'int':
        ctx.compile_expr(cond_node, scope, body, 'int', ctx)
        emit_is_zero(body)
        body.append('    ldc.i4.0')
        body.append('    ceq')
        return
    ctx.compile_expr(cond_node, scope, body, 'i32', ctx)
    return


def codegen_break(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    if not ctx.loop_stack:
        raise SyntaxError("il_codegen: 'break' o ngoai vong lap for/while")
    # Trong try/except: nhay ra khoi vung bao ve PHAI dung 'leave' (2026-09-29),
    # 'br' lam CLR nem InvalidProgramException.
    op_nhay = 'leave' if ctx.try_depth > 0 else 'br'
    body.append(f'    {op_nhay} {ctx.loop_stack[-1][1]}')


def codegen_continue(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    if not ctx.loop_stack:
        raise SyntaxError("il_codegen: 'continue' o ngoai vong lap for/while")
    op_nhay = 'leave' if ctx.try_depth > 0 else 'br'
    body.append(f'    {op_nhay} {ctx.loop_stack[-1][0]}')


def codegen_if(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    else_lbl = f'{sig.name}_If{n}_else'
    end_lbl = f'{sig.name}_If{n}_end'
    _compile_cond(lay_nut(stmt, 'cond_node'), scope, body, body_dtype, ctx)
    body.append(f'    brfalse {else_lbl}')
    # THU HEP KIEU: trong than nhanh, `n` mang kieu da kiem. Thu tu BAT BUOC
    # la nap-ep-rebind-ghi: phai nap bien GOC truoc khi doi rang buoc scope,
    # neu khong thi khong con duong nao tro ve o nho cu.
    ten_bien, ten_lop = _mau_thu_hep(stmt, ctx.records)
    rang_buoc_cu = None
    if ten_lop is not None and ten_bien in scope:
        ten_an = _ten_local_thu_hep(stmt)
        ctx.load_var_ref(ten_bien, scope, body)
        body.append(f'    castclass {ten_lop}')
        rang_buoc_cu = scope.vars[ten_bien]
        scope.vars[ten_bien] = scope.vars[ten_an]
        ctx.store_var(ten_bien, scope, body)
    codegen_stmts_fn(lay_than(stmt, 'body'), scope, body, body_dtype, ctx, sig)
    if rang_buoc_cu is not None:
        # Khoi phuc NGAY khi ra khoi than nhanh: nhanh `else` va code phia sau
        # KHONG duoc thay kieu da thu hep.
        scope.vars[ten_bien] = rang_buoc_cu
    if lay_than(stmt, 'else_body') is not None:
        # Neu than if da ket thuc bang 'return' (ret), 1 dong 'br end_lbl'
        # ngay sau do la KHONG BAO GIO CHAY TOI (unreachable sau ret) -
        # bug that tim thay: CLR verifier nem InvalidProgramException voi
        # mau nay. Bo qua 'br' thua trong truong hop nay.
        if not _stmts_end_in_return(lay_than(stmt, 'body')):
            body.append(f'    br {end_lbl}')
        body.append(f'  {else_lbl}:')
        codegen_stmts_fn(lay_than(stmt, 'else_body'), scope, body, body_dtype, ctx, sig)
        body.append(f'  {end_lbl}:')
    else:
        body.append(f'  {else_lbl}:')


def _emit_try_and_handlers(end_lbl: "str", stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig",
                           codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void",
                           handler_excs: "list[str]", handler_vungs: "list[i32]", no_exc_lbl: "str"=None):
    # Khoi .try{...}catch{...}catch{...} (0..N handler that - xem
    # EXC_CLR) - dung CHUNG cho ca truong hop "chi except" LAN
    # "except + finally".
    # 'no_exc_lbl' (2026-09-28, cho 'else'): nhan RIENG cho duong khong co
    # exception. Cac handler van `leave end_lbl`, nen khi co loi duoc bat,
    # 'else' bi bo qua dung y Python. `br` thuan khong thoat duoc khoi .try,
    # nen van phai `leave` - va nhan do nam NGOAI vung .try.
    try_exit = no_exc_lbl or end_lbl
    body.append('    .try')
    body.append('    {')
    ctx.try_depth = ctx.try_depth + 1
    codegen_stmts_fn(lay_than(stmt, 'body'), scope, body, body_dtype, ctx, sig)
    ctx.try_depth -= 1
    # Bo qua 'leave' thua neu than try da chac chan thoat qua 'return'
    # (da tu emit 'leave epilogue' rieng) - cung ly do voi bug 'br
    # thua sau ret' da sua o nhanh if/else (_stmts_end_in_return).
    if not _stmts_end_in_return(lay_than(stmt, 'body')):
        body.append(f'      leave {try_exit}')
    body.append('    }')
    binds = lay_ds_str(stmt, 'handler_vars')
    if not binds:
        # vong lap thay '[None] * n' (2026-09-25): hat giong dich 'list * int'
        # thanh phep nhan SO tren tham chieu.
        binds = []
        for _k_h in range(len(handler_vungs)):
            binds.append(None)
    # Duyet theo CHI SO (2026-09-24): zip ba danh sach + tach tuple - hat
    # giong chua co. Dung o do dai NGAN NHAT, dung nhu zip.
    _n_h = min(min(len(handler_excs), len(handler_vungs)), len(binds))
    for _i_h in range(_n_h):
        exc_name = handler_excs[_i_h]
        handler_vung = handler_vungs[_i_h]
        bind = binds[_i_h]
        handler_body = body_of(handler_vung)
        clr_type = (_resolve_exc_clr_type(exc_name, ctx, f"'except {exc_name}:'")
                    if exc_name else '[mscorlib]System.Exception')
        body.append(f'    catch {clr_type}')
        body.append('    {')
        if bind is None:
            body.append('      pop')
        else:
            # 'except E as e:' - luu doi tuong loi vao local 'e' thay
            # vi bo di, de than handler doc duoc field/method cua no.
            bind_idx = scope.tra(bind).idx
            body.append(f'      stloc.s {bind_idx}')
        ctx.try_depth = ctx.try_depth + 1
        ctx.in_except_handler = ctx.in_except_handler + 1
        codegen_stmts_fn(handler_body, scope, body, body_dtype, ctx, sig)
        ctx.in_except_handler -= 1
        ctx.try_depth -= 1
        if not _stmts_end_in_return(handler_body):
            body.append(f'      leave {end_lbl}')
        body.append('    }')


def codegen_try(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    handler_excs = lay_handlers_exc(stmt)
    handler_vungs = lay_handlers_vung(stmt)
    finally_body = lay_than(stmt, 'finally_body')
    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]

    else_body = lay_than(stmt, 'else_body')
    if handler_vungs and finally_body is not None:
        # LONG: .try (ngoai, cho finally) { .try (trong, cho cac catch)
        # {...} catch {...} ... INNER_END: leave OUTER_END } finally
        # {...endfinally} OUTER_END: - 'leave' tu ben trong try/catch
        # LONG NHAU van tu dong kich hoat finally cua khoi ben ngoai
        # dung 1 lan, ke ca khi co ngoai le duoc bat hoac khong.
        inner_end_lbl = f'{sig.name}_Try{n}_end'
        inner_noexc_lbl = f'{sig.name}_Try{n}_noexc'
        outer_end_lbl = f'{sig.name}_TryF{n}_end'
        body.append('    .try')
        body.append('    {')
        _emit_try_and_handlers(inner_end_lbl, stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn,
                               handler_excs, handler_vungs,
                               inner_noexc_lbl if else_body is not None else None)
        if else_body is not None:
            # 'else' nam TRONG .try cua finally (nen finally van chay sau no),
            # va 'noexc' nam ngoai vung .try con, ben trong vung nay.
            body.append(f'  {inner_noexc_lbl}:')
            codegen_stmts_fn(else_body, scope, body, body_dtype, ctx, sig)
        body.append(f'  {inner_end_lbl}:')
        body.append(f'    leave {outer_end_lbl}')
        body.append('    }')
        body.append('    finally')
        body.append('    {')
        codegen_stmts_fn(finally_body, scope, body, body_dtype, ctx, sig)
        body.append('      endfinally')
        body.append('    }')
        body.append(f'  {outer_end_lbl}:')
    elif finally_body is not None:
        # 'try: ... finally:' KHONG co 'except' nao - Python cho phep dang
        # nay (finally luon chay, khong bat loi).
        end_lbl = f'{sig.name}_TryF{n}_end'
        body.append('    .try')
        body.append('    {')
        ctx.try_depth = ctx.try_depth + 1
        codegen_stmts_fn(lay_than(stmt, 'body'), scope, body, body_dtype, ctx, sig)
        ctx.try_depth -= 1
        if not _stmts_end_in_return(lay_than(stmt, 'body')):
            body.append(f'      leave {end_lbl}')
        body.append('    }')
        body.append('    finally')
        body.append('    {')
        codegen_stmts_fn(finally_body, scope, body, body_dtype, ctx, sig)
        body.append('      endfinally')
        body.append('    }')
        body.append(f'  {end_lbl}:')
    else:
        # Chi except (0 finally) - N handler (>= 1, da kiem tra luc parse),
        # tong quat hoa ban bare-except-1-handler cu.
        end_lbl = f'{sig.name}_Try{n}_end'
        no_exc_lbl = f'{sig.name}_Try{n}_noexc'
        _emit_try_and_handlers(end_lbl, stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn,
                               handler_excs, handler_vungs,
                               no_exc_lbl if else_body is not None else None)
        if else_body is not None:
            # Ca 2 nhan nam NGOAI vung .try nen 'break'/'continue' trong 'else'
            # van phat 'br' thuan binh thuong o truong hop nay.
            body.append(f'  {no_exc_lbl}:')
            codegen_stmts_fn(else_body, scope, body, body_dtype, ctx, sig)
        body.append(f'  {end_lbl}:')


def codegen_return(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    compile_expr, store_var = ctx.compile_expr, ctx.store_var
    # `return <v>` trong generator (2026-09-29, Giai doan 2): phai xu ly TRUOC
    # moi dong duoi vi `sig.return_type` cua generator da bi gen_il_program
    # thay bang TypeAnn(<TenLop>, 'generator').
    gen_ctx = ctx.gen_ctx
    if gen_ctx is not None and lay_nut(stmt, 'expr_node') is not None and ekind(lay_nut(stmt, 'expr_node')) == 'null':
        # `return None` trong generator: dung may trang thai, khong ghi
        # `__gen_ret__` (khong co gia tri).
        gen_class = gen_ctx.class_name
        body.append('    ldarg.0')
        body.append('    ldc.i4.m1')
        body.append('    stfld int32 ' + gen_class + '::__state')
        body.append('    ldc.i4.0')
        body.append('    ret')
        return
    gen_ctx = ctx.gen_ctx
    if gen_ctx is not None:
        rt = lay_ghi_chu(stmt, 'gen_ret_dtype')
        if rt is None:
            raise SyntaxError(
                "il_codegen: ham generator co 'return' nhung kieu cua '" + GEN_RET_NAME +
                "' chua duoc xac dinh (first-pass phai chay truoc codegen)")
        gen_class = gen_ctx.class_name
        program_class = ctx.class_name or 'Program'
        il_ret = ctx.il_scalar.get(rt, rt)
        compile_expr(lay_nut(stmt, 'expr_node'), scope, body, rt, ctx)
        body.append('    stsfld ' + il_ret + ' ' + program_class + '::' +
                    ctx.il_ident(GEN_RET_NAME))
        body.append('    ldarg.0')
        body.append('    ldc.i4.m1')
        body.append('    stfld int32 ' + gen_class + '::__state')
        body.append('    ldc.i4.0')
        body.append('    ret')
        return
    if sig.return_type is None and lay_nut(stmt, 'expr_node') is None:
        # `return` tran cua ham void: trong try thi `leave` toi epilogue
        # (epilogue cua ham void khong nap __ret_tmp), ngoai thi `ret`.
        if ctx.try_depth > 0:
            body.append(f'    leave {ctx.epilogue_lbl}')
        else:
            body.append('    ret')
        return
    # Critical round 2 (2026-08-19): 'return [[1,2],[3,4]]' trong 1 ham
    # '-> "list[list[i32]]"' phai truyen dtype dang CHUOI MANG SHAPE
    # ('list[list[i32]]') chu khong phai body_dtype PHANG ('i32') - neu
    # khong codegen_expr_list_literal sinh 'newobj List<int32>' (thieu 1
    # lop long) -> NullReferenceException luc chay. Dung CHUNG helper voi
    # duong doi so ham (il_features/list_type.py).
    if sig.return_type is not None:
        body_dtype = value_dtype_spec_for_ta(sig.return_type, lay_nut(stmt, 'expr_node'))
    if sig.return_type is None:
        # CIL cam `ret` mang gia tri tu 1 ham khai bao void - neu khong
        # chan o day, ILASM van assemble (khong xac minh), nhung CLR se
        # raise InvalidProgramException LUC CHAY dau tien - chan SOM o
        # Python thay vi de loi ro tan CLR.
        raise SyntaxError(
            f"il_codegen: ham '{sig.name}' khong khai bao return type (vd thieu "
            f"'-> f32') nhung than ham co 'return {lay_str(stmt, 'expr_text')}' - CIL khong "
            f"cho phep 'ret' mang gia tri tu ham void. Them '-> <type>' vao chu ky.")
    if ctx.try_depth > 0:
        # 'ret' TRUC TIEP ben trong .try/.catch la SAI cu phap CIL that su
        # (ECMA-335 III.3.64): phai luu gia tri vao __ret_tmp roi 'leave'
        # toi 1 nhan NGOAI ca try/catch (epilogue cuoi ham), noi moi 'ret'
        # THAT su.
        compile_theo_ta(lay_nut(stmt, 'expr_node'), sig.return_type, body_dtype, scope, body, ctx)
        store_var(ctx.ret_tmp_name, scope, body)
        body.append(f'    leave {ctx.epilogue_lbl}')
    else:
        compile_theo_ta(lay_nut(stmt, 'expr_node'), sig.return_type, body_dtype, scope, body, ctx)
        body.append('    ret')


_WITH_OPEN_RE = re.compile(r'^with\s+open\((.+),\s*"(\w)"\)\s+as\s+(\w+)\s*:\s*$')


def il_file_type(mode: "str") -> "str":
    """Kieu IL cua 1 file-handle (Wave 2, 2026-07-29) - StreamReader cho
    mode 'r', StreamWriter cho 'w'/'a' (ca 2 nam trong [mscorlib])."""
    return ('class [mscorlib]System.IO.StreamReader' if mode == 'r'
            else 'class [mscorlib]System.IO.StreamWriter')


_OPEN_CALL_RE = re.compile(r'^open\(\s*(.+?)\s*,\s*("[rwa]")\s*\)\s*$')


def _open_mode_of(mode_node: "TkvNode") -> "str":
    """'mode' phai la CHUOI LITERAL - compiler phai biet mode LUC BIEN DICH
    de chon StreamReader hay StreamWriter (khac runtime)."""
    if ekind(mode_node) != 'str_lit':
        raise SyntaxError(
            "il_codegen: open(path, mode) - 'mode' phai la CHUOI LITERAL "
            "(\"r\" / \"w\" / \"a\"), khong nhan bien dong")
    mode = ea_str(mode_node)
    mode = mode[1:-1]
    if mode != 'r' and mode != 'w' and mode != 'a':
        raise SyntaxError(
            "il_codegen: open(path, \"" + mode + "\") - chi nhan \"r\", \"w\", \"a\" "
            "(khu \"rb\"/\"wb\"/\"r+\" - StreamReader/StreamWriter khong co)")
    return mode


def _emit_open_handle(mode: "str", path_node: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """Day `path` len stack roi tao StreamReader/StreamWriter theo `mode`."""
    ctx.compile_expr(path_node, scope, out, 'str', ctx)
    if mode == 'r':
        out.append(f'    newobj instance void {il_file_type("r")}::.ctor(string)')
    else:
        if mode == 'a':
            out.append('    ldc.i4.1')
        else:
            out.append('    ldc.i4.0')
        out.append(f'    newobj instance void {il_file_type("w")}::.ctor(string, bool)')


def try_rhs_open_call(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    m = _OPEN_CALL_RE.match(rhs.strip())
    if not m:
        return None
    mode = _open_mode_of(parse_expr(m.group(2)))
    known_shapes[name] = 'file'
    p1 = m.group(1)
    return intern(make4('assign_open', name, p1.strip(), mode))


def fpw_assign_open(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'path_node'))
    if lay_str(stmt, 'name') in ctx.declared_names:
        return
    ctx.declared_names.add(lay_str(stmt, 'name'))
    ta = TypeAnn(lay_str(stmt, 'mode'), 'file')
    ctx.locals_decl.append((lay_str(stmt, 'name'), ta))
    ctx.infer_scope.set(lay_str(stmt, 'name'), ta)


def codegen_assign_open(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    _emit_open_handle(lay_str(stmt, 'mode'), lay_nut(stmt, 'path_node'), scope, body, ctx)
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def try_parse_with_open(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """'with open(path, "w"/"r"/"a") as f:' (Wave 2, 2026-07-29) - CHI ho
    tro mo file THAT (khong ho tro context-manager tong quat khac). Desugar
    THANH 1 stmt kind 'with_open' rieng, nhung CODEGEN cua no (xem
    codegen_with_open) phat sinh IL .try/finally Y HET nhanh 'finally_body
    is not None' cua codegen_try - tai dung ha tang try/finally DA XAC
    MINH (khong viet lai tu dau) de dam bao dong file/Dispose LUON chay du
    co return/loi trong khoi hay khong. `_contains_return`/
    `_contains_break_continue` (o tren) da TU DONG nhan dien 'with_open'
    qua nhanh else chung (kiem tra stmt.get('body')), KHONG can sua rieng -
    chi 'try' moi can nhanh dac biet (co 'handlers'/'finally_body' khac
    cau truc)."""
    m = _WITH_OPEN_RE.match(line)
    if not m:
        return None
    path_expr, mode, var_name = m.groups()
    if mode not in ('r', 'w', 'a'):
        raise SyntaxError(
            f"il_codegen: 'with open(..., \"{mode}\")' - mode chi ho tro "
            f"'r' (doc)/'w' (ghi de)/'a' (ghi noi tiep)")
    path_node = parse_expr(path_expr.strip())
    known_shapes[var_name] = 'file'
    pos += 1
    if pos >= len(lines) or lines[pos][0] <= indent_level:
        raise SyntaxError(
            f"il_codegen: 'with open(...) as {var_name}:' khong co than khoi (block rong)")
    body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
    return intern(make5('with_open', var_name, mode, path_expr.strip(),
                                 str(intern_body(body)))), pos


def fpw_with_open(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'path_node'))
    declared_names = ctx.declared_names
    infer_scope = ctx.infer_scope
    if lay_str(stmt, 'var') not in declared_names:
        declared_names.add(lay_str(stmt, 'var'))
        ta = TypeAnn(lay_str(stmt, 'mode'), 'file')
        ctx.locals_decl.append((lay_str(stmt, 'var'), ta))
        infer_scope.set(lay_str(stmt, 'var'), ta)
    else:
        # Bien 'f' dung LAI cho 1 'with open(...) as f:' KHAC trong CUNG
        # ham - CIL local slot da co san 1 KIEU CO DINH tu lan khai bao
        # DAU TIEN (StreamWriter hoac StreamReader), khac Python that (co
        # the gan lai bat ky object nao vao 1 ten) - neu mode lan nay
        # KHAC mode lan dau, gan vao CUNG slot se SAI KIEU (stloc mismatch,
        # CLR verifier tu choi luc chay) - chan RO RANG o day thay vi de
        # loi kho hieu tu ilasm/CLR, giong tinh than guard cua _expr_index.
        existing_ta = infer_scope.tra(lay_str(stmt, 'var')).ta
        prior_mode = existing_ta.dtype
        same_class = (prior_mode == lay_str(stmt, 'mode')) or (prior_mode in ('w', 'a') and lay_str(stmt, 'mode') in ('w', 'a'))
        if not same_class:
            raise SyntaxError(
                f"il_codegen: 'with open(..., \"{lay_str(stmt, 'mode')}\") as {lay_str(stmt, 'var')}:' - bien "
                f"'{lay_str(stmt, 'var')}' da dung cho mode '{prior_mode}' truoc do trong CUNG ham - "
                f"file-handle tai dung 1 ten PHAI cung nhom mode (r rieng, w/a chung nhau vi "
                f"cung la StreamWriter) vi CIL local co kieu CO DINH; dung ten bien KHAC neu "
                f"can mode khac nhom")
    if _contains_return(lay_than(stmt, 'body')):
        # Giong fpw_try: 'return' BEN TRONG khoi try/finally (o day la
        # khoi try/finally NGAM cua with) can epilogue (__ret_tmp + nhan
        # cuoi ham) - xem codegen_return/gen_il_function.
        ctx.needs_epilogue[0] = True
    ctx.walk_fn(lay_than(stmt, 'body'))


def fpp_with_open(stmt: "i32", ctx: "PrescanCtx"):
    ctx.prescan_fn(lay_than(stmt, 'body'))


_FILE_WRITE_METHODS: "set[str]" = {'write'}
_FILE_READ_METHODS: "set[str]" = {'read', 'readline'}


def compile_file_method_call(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'f.write(x)'/'f.read()' tren 1 file-handle (TypeAnn shape='file',
    dtype='r'/'w'/'a' - mode mo file) - dang ky boi record_feature.py's
    compile_method_call VA il_codegen.py's _stmt_method_call_stmt (dung
    duoc CA trong bieu thuc LAN nhu 1 lenh doc lap, khac list.count() CHI
    RHS vi khong can hidden-local/vong lap o day)."""
    obj_name, method_name, args = ea_str(node), eb_str(node), ec_ds(node)
    obj_ta = scope.tra(obj_name).ta
    mode = obj_ta.dtype
    compile_expr = ctx.compile_expr
    if method_name in _FILE_WRITE_METHODS:
        if mode == 'r':
            raise SyntaxError(
                f"il_codegen: '{obj_name}.write(...)' - file mo o mode 'r' (chi doc), "
                f"khong ghi duoc")
        if len(args) != 1:
            raise SyntaxError("il_codegen: f.write(text) chi nhan dung 1 tham so")
        ctx.load_var_ref(obj_name, scope, out)
        compile_expr(args[0], scope, out, 'str', ctx)
        out.append('    callvirt instance void [mscorlib]System.IO.TextWriter::Write(string)')
        return
    if method_name in _FILE_READ_METHODS:
        if mode != 'r':
            raise SyntaxError(
                f"il_codegen: '{obj_name}.read()' - file mo o mode '{mode}' (chi ghi), "
                f"khong doc duoc")
        if method_name == 'readline':
            # (port 2026-10-06 tu bootstrap): 'f.readline()' tra ve DONG KE
            # TIEP (TextReader::ReadLine) hoac NULL khi het file. Python-style:
            # null -> '' (chuoi rong) lam tin hieu EOF - vong
            # 'while line != "":' khong can check null rieng.
            if args:
                raise SyntaxError("il_codegen: f.readline() khong nhan tham so")
            ctx.load_var_ref(obj_name, scope, out)
            out.append('    callvirt instance string [mscorlib]System.IO.TextReader::ReadLine()')
            out.append('    dup')
            ctx.label_counter[0] += 1
            eof_lbl = f'__rl_notnull_{ctx.label_counter[0]}'
            out.append(f'    brtrue {eof_lbl}')
            out.append('    pop')
            out.append('    ldstr ""')
            out.append(f'  {eof_lbl}:')
            ctx.widen_if_needed('str', dtype, out)
            return
        if args:
            raise SyntaxError("il_codegen: f.read() khong nhan tham so (chi doc TOAN BO phan con lai)")
        ctx.load_var_ref(obj_name, scope, out)
        out.append('    callvirt instance string [mscorlib]System.IO.TextReader::ReadToEnd()')
        ctx.widen_if_needed('str', dtype, out)
        return
    if method_name == 'close':
        # `close()` - BAT BUOC khi mo file bang HAM `open(p, "w")`.
        # `with_open` tu Dispose trong khoi nen khong can, nhung handle do
        # `open()` tra ve thi nguoi dung phai tu dong. Close() cung Flush
        # nen du lieu ghi chua khong mat.
        # (port 2026-10-06 tu bootstrap, gom fix 2026-10-02: phai chon dung
        # TextReader (mode 'r') hay TextWriter - goi Dispose() cua TextWriter
        # tren StreamReader KHONG giai phong file, build van xanh, chi loi
        # luc chay voi IOException "file dang bi dung").
        if args:
            raise SyntaxError("il_codegen: f.close() khong nhan tham so")
        ctx.load_var_ref(obj_name, scope, out)
        if mode == 'r':
            out.append('    callvirt instance void [mscorlib]System.IO.TextReader::Close()')
        else:
            out.append('    callvirt instance void [mscorlib]System.IO.TextWriter::Close()')
        # `Close()` tra void va DA TIEU handle -> stack rong sau no, KHONG
        # them `pop`, KHONG day `ldc.i4.0` (de lai gia tri thua se lech stack).
        return
    raise SyntaxError(
        f"il_codegen: file-handle chi ho tro '.write(x)' (mode w/a), "
        f"'.read()' (mode r) hoac '.close()' (ca hai mode), gap '.{method_name}(...)'")


def codegen_with_open(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    var, mode = lay_str(stmt, 'var'), lay_str(stmt, 'mode')
    compile_expr = ctx.compile_expr
    compile_expr(lay_nut(stmt, 'path_node'), scope, body, 'str', ctx)
    if mode == 'r':
        body.append(f'    newobj instance void {il_file_type("r")}::.ctor(string)')
    else:
        # StreamWriter(string path, bool append) - 'w' ghi de (append=
        # false), 'a' ghi noi tiep (append=true).
        body.append('    ldc.i4.1' if mode == 'a' else '    ldc.i4.0')
        body.append(f'    newobj instance void {il_file_type("w")}::.ctor(string, bool)')
    ctx.store_var(var, scope, body)

    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    end_lbl = f'{sig.name}_With{n}_end'
    # Y HET nhanh 'try: ... finally:' (khong 'except') cua codegen_try -
    # Dispose() (dong file, tu dong Flush) LUON chay du than co return
    # hay khong, tai dung ha tang try/finally da xac minh THAT.
    body.append('    .try')
    body.append('    {')
    ctx.try_depth = ctx.try_depth + 1
    codegen_stmts_fn(lay_than(stmt, 'body'), scope, body, body_dtype, ctx, sig)
    ctx.try_depth -= 1
    if not _stmts_end_in_return(lay_than(stmt, 'body')):
        body.append(f'      leave {end_lbl}')
    body.append('    }')
    body.append('    finally')
    body.append('    {')
    ctx.load_var_ref(var, scope, body)
    body.append('      callvirt instance void [mscorlib]System.IDisposable::Dispose()')
    body.append('      endfinally')
    body.append('    }')
    body.append(f'  {end_lbl}:')


_FOR_IN_NAME_RE = re.compile(r'^for\s+(\w+)\s+in\s+(\w+)\s*:\s*$')


def try_parse_for_in_record(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """'for x in <bien_record>:' (6.7, iterator protocol tuy bien,
    2026-08-13) - CHI khop khi ve phai la 1 TEN don (khong 'range(...)').
    An toan LAC QUAN chap nhan o day: macro text-level 'for_in_list'
    (list/dict/set) da chay TRUOC va rewrite HET moi truong hop list/
    dict/set thanh 'for i in range(len(name)): x = name[i]' roi - bat ky
    'for x in <name>:' con SOT lai luc LINE_PARSERS chay CHAC CHAN
    khong phai list/dict/set. Validate that (co phai record hop le,
    co __iter__/__next__ hay khong) hoan toan HOAN sang first-pass-walk
    (fpw_for_in_iter), giong cach with_ctx (6.6) da lam."""
    m = _FOR_IN_NAME_RE.match(line)
    if not m:
        return None
    var, record_var = m.groups()
    pos += 1
    if pos >= len(lines) or lines[pos][0] <= indent_level:
        raise SyntaxError(f"il_codegen: 'for {var} in {record_var}:' khong co than khoi (block rong)")
    body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
    return intern(make4('for_in_iter', var, record_var,
                                 str(intern_body(body)))), pos


def _ten_iterobj(stmt: "i32") -> "str":
    """Ten local an giu doi tuong lap - HAM THUAN cua chi so cau lenh."""
    return "__iterobj%d" % nid(stmt)


def _ten_nexttmp(stmt: "i32") -> "str":
    """Ten local an giu ket qua `__next__` - ham thuan cua chi so."""
    return "__iternext%d" % nid(stmt)


def _ten_ctxmgr(stmt: "i32") -> "str":
    """Ten local an giu record cua `with` - ham thuan cua chi so."""
    return "__ctxmgr%d" % nid(stmt)


def fpw_for_in_iter(stmt: "i32", ctx: "WalkCtx"):
    var, record_var = lay_str(stmt, 'var'), lay_str(stmt, 'record_var')
    infer_scope = ctx.infer_scope
    declared_names = ctx.declared_names
    records = ctx.records
    record_methods = ctx.record_methods
    if record_var not in infer_scope:
        raise SyntaxError(
            f"il_codegen: 'for {var} in {record_var}:' - '{record_var}' chua duoc khai bao")
    record_ta = infer_scope.tra(record_var).ta
    if record_ta.shape_ten != 'record':
        raise SyntaxError(
            f"il_codegen: 'for {var} in {record_var}:' - '{record_var}' khong phai bien "
            f"kieu record (khong phai list/dict/set/range - cac dang do da duoc xu ly "
            f"o macro/parser rieng)")
    record_type = record_ta.dtype
    if record_type not in record_methods:
        raise SyntaxError(
            f"il_codegen: record '{record_type}' can dinh nghia "
            f"'def __iter__(self) -> \"IterT\": ...' (0 tham so, co return type) "
            f"de dung trong 'for {var} in {record_var}:'")
    _m_cua_record = record_methods[record_type]
    iter_m = _m_cua_record.get('__iter__', None)
    if iter_m is None or iter_m.params or iter_m.return_type is None:
        raise SyntaxError(
            f"il_codegen: record '{record_type}' can dinh nghia "
            f"'def __iter__(self) -> \"IterT\": ...' (0 tham so, co return type) "
            f"de dung trong 'for {var} in {record_var}:'")
    iter_ta = iter_m.return_type
    if iter_ta.shape_ten != 'record' or iter_ta.dtype not in records:
        raise SyntaxError(
            f"il_codegen: record '{record_type}' co __iter__ nhung kieu tra ve "
            f"'{iter_ta.dtype}' khong phai 1 record hop le")
    _ten_iter = iter_ta.dtype
    if _ten_iter not in record_methods:
        raise SyntaxError(
            f"il_codegen: record '{_ten_iter}' can dinh nghia "
            f"'def __next__(self) -> \"(T, i32)\": ...' de dung trong "
            f"'for {var} in {record_var}:'")
    _m_cua_iter = record_methods[_ten_iter]
    next_m = _m_cua_iter.get('__next__', None)
    if next_m is None or next_m.params or next_m.return_type is None or \
            next_m.return_type.shape_ten != 'tuple' or \
            len(next_m.return_type.tuple_dtypes) != 2 or \
            next_m.return_type.tuple_dtypes[1] != 'i32':
        raise SyntaxError(
            f"il_codegen: record '{iter_ta.dtype}' can dinh nghia "
            f"'def __next__(self) -> \"(T, i32)\": ...' (0 tham so, tra ve tuple 2 "
            f"phan tu, phan tu thu 2 la i32 - co con/het) de dung trong "
            f"'for {var} in {record_var}:'")
    elem_dtype = next_m.return_type.tuple_dtypes[0]
    dat_ghi_chu(stmt, '_iter_type', iter_ta.dtype)
    dat_ghi_chu(stmt, '_elem_dtype', elem_dtype)
    if var not in declared_names:
        declared_names.add(var)
        elem_ta = TypeAnn(elem_dtype, None)
        ctx.locals_decl.append((var, elem_ta))
        infer_scope.set(var, elem_ta)
    iterobj = _ten_iterobj(stmt)
    nexttmp = _ten_nexttmp(stmt)
    if iterobj not in declared_names:
        declared_names.add(iterobj)
        iter_local_ta = TypeAnn(iter_ta.dtype, 'record')
        ctx.locals_decl.append((iterobj, iter_local_ta))
        infer_scope.set(iterobj, iter_local_ta)
    if nexttmp not in declared_names:
        declared_names.add(nexttmp)
        tuple_ta = TypeAnn(elem_dtype, 'tuple', tuple_dtypes=[elem_dtype, 'i32'])
        ctx.locals_decl.append((nexttmp, tuple_ta))
        infer_scope.set(nexttmp, tuple_ta)
    plan_str_accum(stmt, ctx)
    ctx.walk_fn(lay_than(stmt, 'body'))


def fpp_for_in_iter(stmt: "i32", ctx: "PrescanCtx"):
    ctx.prescan_fn(lay_than(stmt, 'body'))


def codegen_for_in_iter(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    var, record_var = lay_str(stmt, 'var'), lay_str(stmt, 'record_var')
    iter_type = lay_ghi_chu(stmt, '_iter_type')
    elem_dtype = lay_ghi_chu(stmt, '_elem_dtype')
    # SUY LAI thay vi doc bang de: hai ten nay von la ham thuan cua
    # `nid(stmt)`, luu lai chi lam bang de phai chua gia tri thua.
    iterobj = _ten_iterobj(stmt)
    nexttmp = _ten_nexttmp(stmt)
    records = ctx.records
    record_type = scope.tra(record_var).ta.dtype

    iter_owner = _method_owner_class(ctx, record_type, '__iter__')
    iter_il = ctx.il_type_str(TypeAnn(iter_type, 'record'), records)
    ctx.load_var_ref(record_var, scope, body)
    body.append(f'    callvirt instance {iter_il} {iter_owner}::__iter__()')
    ctx.store_var(iterobj, scope, body)

    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    start_lbl, end_lbl = f'{sig.name}_ForIter{n}_start', f'{sig.name}_ForIter{n}_end'
    tuple_type_il = il_tupleN_type([elem_dtype, 'i32'])
    next_owner = _method_owner_class(ctx, iter_type, '__next__')

    emit_sb_setup(stmt, scope, body, ctx)
    body.append(f'  {start_lbl}:')
    ctx.load_var_ref(iterobj, scope, body)
    body.append(f'    callvirt instance {tuple_type_il} {next_owner}::__next__()')
    ctx.store_var(nexttmp, scope, body)
    ctx.load_var_ref(nexttmp, scope, body)
    body.append(f'    callvirt instance !1 {tuple_type_il}::get_Item2()')
    body.append(f'    brfalse {end_lbl}')
    ctx.load_var_ref(nexttmp, scope, body)
    body.append(f'    callvirt instance !0 {tuple_type_il}::get_Item1()')
    ctx.store_var(var, scope, body)
    ctx.loop_stack.append((start_lbl, end_lbl))
    codegen_stmts_fn(lay_than(stmt, 'body'), scope, body, body_dtype, ctx, sig)
    ctx.loop_stack.pop()
    body.append(f'    br {start_lbl}')
    body.append(f'  {end_lbl}:')
    emit_sb_flush(stmt, scope, body, ctx)


_WITH_CTX_RE = re.compile(r'^with\s+(.+?)\s+as\s+(\w+)\s*:\s*$')


def try_parse_with_ctx(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """'with <bieu_thuc_record> as v:' (6.6, context manager tuy bien,
    2026-08-13) - CHI ho tro (a) goi constructor truc tiep 'with Lock() as lk:'
    hoac (b) 1 bien DA khai bao kieu record 'with existing as lk:'. Dang ky
    SAU with_open trong LINE_PARSERS (khong sua with_open) - 'with open(...)'
    van di duong cu vi _WITH_OPEN_RE khop TRUOC (thu tu LINE_PARSERS o
    il_codegen.py). Xem docs/superpowers/plans/2026-08-13-context-manager.md."""
    m = _WITH_CTX_RE.match(line)
    if not m:
        return None
    expr_text, var_name = m.groups()
    if expr_text.strip().startswith('open('):
        # 'with open(...)' KHONG khop _WITH_OPEN_RE (vd thieu dau ngoac
        # dung, mode sai) se roi xuong day - bao loi RO thay vi hieu nham
        # thanh with_ctx (se that bai o buoc validate record ben duoi voi
        # thong bao khong lien quan).
        return None
    expr_node = parse_expr(expr_text.strip())
    pos += 1
    if pos >= len(lines) or lines[pos][0] <= indent_level:
        raise SyntaxError(
            f"il_codegen: 'with {expr_text} as {var_name}:' khong co than khoi (block rong)")
    body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
    return intern(make4('with_ctx', var_name, expr_text.strip(),
                                 str(intern_body(body)))), pos


def fpw_with_ctx(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'expr_node'))
    declared_names = ctx.declared_names
    infer_scope = ctx.infer_scope
    records = ctx.records
    record_methods = ctx.record_methods
    expr_node = lay_nut(stmt, 'expr_node')
    if ekind(expr_node) == 'call' and ea_str(expr_node) in records:
        record_name = ea_str(expr_node)
    elif ekind(expr_node) == 'var':
        var_ta = infer_scope.tra(ea_str(expr_node)).ta
        if var_ta.shape_ten != 'record':
            raise SyntaxError(
                f"il_codegen: 'with {ea_str(expr_node)} as {lay_str(stmt, 'var')}:' - '{ea_str(expr_node)}' "
                f"khong phai bien kieu record")
        record_name = var_ta.dtype
    else:
        raise SyntaxError(
            f"il_codegen: 'with <bieu_thuc> as {lay_str(stmt, 'var')}:' - chi ho tro goi "
            f"constructor record truc tiep (vd 'with Lock() as lk:') hoac 1 bien "
            f"da khai bao kieu record, khong ho tro bieu thuc phuc tap khac")
    _m_cua_ctx = record_methods.get(record_name, {})
    enter_m = _m_cua_ctx.get('__enter__', None)
    exit_m = _m_cua_ctx.get('__exit__', None)
    if enter_m is None or exit_m is None:
        raise SyntaxError(
            f"il_codegen: record '{record_name}' can dinh nghia CA __enter__ VA "
            f"__exit__ de dung trong 'with' (dang thieu: "
            f"{'__enter__' if enter_m is None else ''}"
            f"{'__exit__' if exit_m is None else ''})")
    if enter_m.params or enter_m.return_type is None:
        raise SyntaxError(
            f"il_codegen: record '{record_name}' co __enter__ nhung chu ky sai - "
            f"can dung 0 tham so va tra ve 1 kieu bat ky "
            f"('def __enter__(self) -> \"T\":')")
    if exit_m.params or exit_m.return_type is None:
        raise SyntaxError(
            f"il_codegen: record '{record_name}' co __exit__ nhung chu ky sai - "
            f"can dung 0 tham so va tra ve 1 kieu bat ky "
            f"('def __exit__(self) -> \"U\":')")
    dat_ghi_chu(stmt, '_record_name', record_name)
    if lay_str(stmt, 'var') not in declared_names:
        declared_names.add(lay_str(stmt, 'var'))
        ctx.locals_decl.append((lay_str(stmt, 'var'), enter_m.return_type))
        infer_scope.set(lay_str(stmt, 'var'), enter_m.return_type)
    hidden = _ten_ctxmgr(stmt)
    if hidden not in declared_names:
        declared_names.add(hidden)
        record_ta = TypeAnn(record_name, 'record')
        ctx.locals_decl.append((hidden, record_ta))
        infer_scope.set(hidden, record_ta)
    if _contains_return(lay_than(stmt, 'body')):
        ctx.needs_epilogue[0] = True
    ctx.walk_fn(lay_than(stmt, 'body'))


def fpp_with_ctx(stmt: "i32", ctx: "PrescanCtx"):
    ctx.prescan_fn(lay_than(stmt, 'body'))


def codegen_with_ctx(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    var, hidden = lay_str(stmt, 'var'), _ten_ctxmgr(stmt)
    record_name = lay_ghi_chu(stmt, '_record_name')
    compile_expr = ctx.compile_expr
    records = ctx.records
    # Sinh record instance (constructor hoac load bien) roi giu 1 BAN SAO
    # vao hidden local - can THIET vi __exit__ phai goi tren RECORD GOC,
    # con 'var' nhan ket qua __enter__ (co the la KIEU KHAC).
    compile_expr(lay_nut(stmt, 'expr_node'), scope, body, record_name, ctx)
    ctx.store_var(hidden, scope, body)
    enter_owner = _method_owner_class(ctx, record_name, '__enter__')
    # `_enter_ta` SUY LAI tu `_record_name`: no von chi la
    # `record_methods[record_name]['__enter__'].return_type`, va
    # `fpw_with_ctx` da kiem su ton tai lan chu ky truoc khi den day.
    _enter_m = None
    if record_name in ctx.record_methods:
        _m_cua_rec = ctx.record_methods[record_name]
        _enter_m = _m_cua_rec.get('__enter__', None)
    enter_il = ctx.il_type_str(_enter_m.return_type, records)
    ctx.load_var_ref(hidden, scope, body)
    body.append(f'    callvirt instance {enter_il} {enter_owner}::__enter__()')
    ctx.store_var(var, scope, body)

    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    end_lbl = f'{sig.name}_WithCtx{n}_end'
    body.append('    .try')
    body.append('    {')
    ctx.try_depth = ctx.try_depth + 1
    codegen_stmts_fn(lay_than(stmt, 'body'), scope, body, body_dtype, ctx, sig)
    ctx.try_depth -= 1
    if not _stmts_end_in_return(lay_than(stmt, 'body')):
        body.append(f'      leave {end_lbl}')
    body.append('    }')
    body.append('    finally')
    body.append('    {')
    record_methods = ctx.record_methods
    exit_m = record_methods[record_name]['__exit__']
    exit_owner = _method_owner_class(ctx, record_name, '__exit__')
    exit_il = ctx.il_type_str(exit_m.return_type, records)
    ctx.load_var_ref(hidden, scope, body)
    body.append(f'      callvirt instance {exit_il} {exit_owner}::__exit__()')
    if exit_il != 'void':
        body.append('      pop')
    body.append('      endfinally')
    body.append('    }')
    body.append(f'  {end_lbl}:')


def codegen_raise(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    if lay_str(stmt, 'bare') == '2':
        # 'raise loi': nem lai doi tuong ngoai le trong bien 'loi'.
        ten_loi = lay_str(stmt, 'exc_type')
        ta_loi = scope.tra(ten_loi).ta
        if not ((ta_loi.dtype == 'Exception' and ta_loi.la_vo_huong()) or (
                ta_loi.dtype in ctx.records and _derives_from_exception(ta_loi.dtype, ctx.record_bases))):
            raise SyntaxError(
                f"il_codegen: 'raise {ten_loi}' - '{ten_loi}' phai la 1 bien kieu Exception "
                f"(tu 'except ... as {ten_loi}:' hoac 1 record ke thua Exception hoac vua tao "
                f"bang 'x = LoiCuaToi(...)'), dang co dtype={ta_loi.dtype!r} shape={ta_loi.shape_repr()}")
        ctx.load_var_ref(ten_loi, scope, body)
        body.append('    throw')
        return
    if lay_str(stmt, 'bare'):
        # 'raise' TRAN (Phase 6.3, 2026-08-12) - 'rethrow' CHI hop le VE
        # MAT CU PHAP IL khi nam TRUC TIEP trong 1 khoi 'catch{}' (xem
        # ctx['in_except_handler'], dat boi codegen_try quanh than handler).
        if not ctx.in_except_handler:
            raise SyntaxError(
                "il_codegen: 'raise' (khong ten loi) chi hop le BEN TRONG 1 khoi 'except' "
                "(nem lai chinh exception dang bat) - Python that cung bao RuntimeError "
                "neu dung 'raise' tran ben ngoai 1 handler dang xu ly loi")
        body.append('    rethrow')
        return
    # 'raise ValueError("msg")' - TU xay dung + 'throw' 1 exception THAT
    # (khac 'except' chi BAT loi CLR tu nem) - da xac minh THAT bang
    # probe_raise.il: .ctor(string) gan dung Message (voi System.Exception),
    # va code SAU 'throw' (khong branch) khong bi verifier tu choi ('throw'
    # la 1 dang ket thuc khoi HOP LE, khong can 'br').
    # (2026-10-06) ArgumentOutOfRangeException (anh xa cua IndexError) dung
    # .ctor(string) 1 tham so se gan gia tri do vao 'paramName', KHONG PHAI
    # 'Message' - dung .ctor(string, string) voi ("", msg) nhu ban bootstrap
    # (_EXC_CTOR_2STR, 2026-09-30) de `str(e)` ra dung thong diep.
    clr_type = _resolve_exc_clr_type(lay_str(stmt, 'exc_type'), ctx,
                                      f"'raise {lay_str(stmt, 'exc_type')}(...)'")
    clr_type = _resolve_exc_clr_type(lay_str(stmt, 'exc_type'), ctx,
                                      f"'raise {lay_str(stmt, 'exc_type')}(...)'")
    from_name = lay_str(stmt, 'from_name')
    if from_name is not None:
        # 'raise X(...) from err' (exception chaining, 2026-08-12) - dung
        # .ctor(string, Exception) - CO SAN tren MOI class trong
        # EXC_CLR/record tu dinh nghia ke thua Exception (xac minh
        # THAT qua PowerShell reflection truoc khi viet, khong gia dinh:
        # System.Exception/DivideByZeroException/KeyNotFoundException/
        # ArgumentOutOfRangeException/FormatException/OverflowException
        # DEU co ctor nay). 'err' phai la 1 bien kieu Exception-tuong-thich
        # (sentinel 'Exception' hoac record ke thua Exception) - KHONG
        # kiem tra dtype cua record TU DINH NGHIA hien tai (throw() cho no
        # deu hop le, xem _resolve_exc_clr_type) nen chi can xac nhan
        # 'err' THAT la 1 trong 2 dang do, khong quan he gi voi loai dang
        # raise (Python that cung cho phep chain 2 loai loi khac nhau
        # hoan toan).
        from_ta = scope.tra(from_name).ta
        records = ctx.records
        record_bases = ctx.record_bases
        is_exc_compatible = (from_ta.dtype == 'Exception' and from_ta.la_vo_huong()) or (
            from_ta.dtype in records and _derives_from_exception(from_ta.dtype, record_bases))
        if not is_exc_compatible:
            raise SyntaxError(
                f"il_codegen: 'raise {lay_str(stmt, 'exc_type')}(...) from {from_name}' - '{from_name}' "
                f"phai la 1 bien kieu Exception (tu 'except ... as {from_name}:' hoac 1 "
                f"record ke thua Exception), dang co dtype={from_ta.dtype!r} shape={from_ta.shape_repr()}")
        if lay_nut(stmt, 'msg_node') is not None:
            ctx.compile_expr(lay_nut(stmt, 'msg_node'), scope, body, 'str', ctx)
        else:
            body.append('    ldstr ""')
        ctx.load_var_ref(from_name, scope, body)
        body.append(
            f'    newobj instance void {clr_type}::.ctor(string, class [mscorlib]System.Exception)')
        body.append('    throw')
        return
    if lay_nut(stmt, 'msg_node') is not None:
        if lay_str(stmt, 'exc_type') in _EXC_CTOR_2STR:
            # Loai nay co .ctor(string) rieng: tham so DAU la `paramName`,
            # KHONG phai `Message`. Dung .ctor(paramName, message) voi
            # ("", msg) => Message = msg (giong ban bootstrap).
            body.append('    ldstr ""')
            ctx.compile_expr(lay_nut(stmt, 'msg_node'), scope, body, 'str', ctx)
            body.append(
                f'    newobj instance void {clr_type}::.ctor(string, string)')
        else:
            ctx.compile_expr(lay_nut(stmt, 'msg_node'), scope, body, 'str', ctx)
            body.append(f'    newobj instance void {clr_type}::.ctor(string)')
    else:
        body.append(f'    newobj instance void {clr_type}::.ctor()')
    body.append('    throw')


def bootstrap_control_flow(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    # Dang ky vao il_dispatch NGAY LUC MODULE NAP.
    register_macro_expander(reg, 'for_in_list', try_expand_for_in_list)
    register_macro_expander(reg, 'assert', try_expand_assert)
    register_macro_expander(reg, 'set_op', try_expand_set_op)
    register_line_parser(reg, 'match', try_parse_match)
    register_line_parser(reg, 'if', try_parse_if)
    register_line_parser(reg, 'for', try_parse_for)
    register_line_parser(reg, 'while', try_parse_while)
    register_line_parser(reg, 'try', try_parse_try)
    register_line_parser(reg, 'break', try_parse_break)
    register_line_parser(reg, 'pass', try_parse_pass)
    register_line_parser(reg, 'continue', try_parse_continue)
    register_line_parser(reg, 'return', try_parse_return)
    register_line_parser(reg, 'raise', try_parse_raise)
    register_line_parser(reg, 'with_open', try_parse_with_open)
    register_assign_rhs_parser(reg, 'open_call', try_rhs_open_call)
    register_line_parser(reg, 'with_ctx', try_parse_with_ctx)
    register_line_parser(reg, 'for_in_iter', try_parse_for_in_record)
    register_first_pass_walk(reg, 'for', fpw_for)
    register_first_pass_walk(reg, 'while', fpw_while)
    register_first_pass_walk(reg, 'if', fpw_if)
    register_first_pass_walk(reg, 'try', fpw_try)
    register_first_pass_walk(reg, 'return', fpw_return)
    register_first_pass_walk(reg, 'raise', fpw_raise)
    register_first_pass_walk(reg, 'with_open', fpw_with_open)
    register_first_pass_walk(reg, 'assign_open', fpw_assign_open)
    register_first_pass_walk(reg, 'with_ctx', fpw_with_ctx)
    register_first_pass_walk(reg, 'for_in_iter', fpw_for_in_iter)
    register_first_pass_prescan(reg, 'for', fpp_for)
    register_first_pass_prescan(reg, 'while', fpp_while_if)
    register_first_pass_prescan(reg, 'if', fpp_while_if)
    register_first_pass_prescan(reg, 'try', fpp_try)
    register_first_pass_prescan(reg, 'with_open', fpp_with_open)
    register_first_pass_prescan(reg, 'with_ctx', fpp_with_ctx)
    register_first_pass_prescan(reg, 'for_in_iter', fpp_for_in_iter)
    register_stmt_codegen(reg, 'for', codegen_for)
    register_stmt_codegen(reg, 'while', codegen_while)
    register_stmt_codegen(reg, 'break', codegen_break)
    register_stmt_codegen(reg, 'pass', codegen_pass)
    register_stmt_codegen(reg, 'continue', codegen_continue)
    register_stmt_codegen(reg, 'if', codegen_if)
    register_stmt_codegen(reg, 'try', codegen_try)
    register_stmt_codegen(reg, 'return', codegen_return)
    register_stmt_codegen(reg, 'raise', codegen_raise)
    register_stmt_codegen(reg, 'with_open', codegen_with_open)
    register_stmt_codegen(reg, 'assign_open', codegen_assign_open)
    register_stmt_codegen(reg, 'with_ctx', codegen_with_ctx)
    register_stmt_codegen(reg, 'for_in_iter', codegen_for_in_iter)
