# -*- coding: utf-8 -*-
"""Native C Interop & FFI Bridge (Moc 27 & Moc 32, 2026-08-09) - ctypes & P/Invoke.

Cung mot file .tkv, 2 duong chay (CPython & TokenVector .exe), cung ket qua 100%.

CHUA HOAN THANH - KHONG DUOC NOI DAY (do that 2026-09-17)
=========================================================
Hang `FFI_CIL_HELPERS` ben duoi chua than IL cua cac method helper ma codegen o
day PHAT LOI GOI TOI. Hang do duoc dinh nghia MOT LAN va KHONG AI THAM
CHIEU - da grep toan repo. Hau qua do bang cach chay that: chuong trinh
bien dich TROT LOT roi nem `System.MissingMethodException: Method not
found: '...'` ngay khi goi.

Nen module nay CO Y khong nam trong `bootstrap_all`. Muon hoan thien:
boc khoi helper thanh mot class rieng theo khuon `IPOW_CLASS` trong
il_features/stdlib_math.py (`ctx.extra_classes.append(...)` co canh gac
`emitted_types`), roi doi cho goi tu `TKVApp::Tkv...` sang class do -
hien khong co co che "them method vao chinh class dang sinh".

Rieng module nay con la quyet dinh ve PHAM VI chu khong chi ky thuat:
helper la P/Invoke thang vao kernel32 (LoadLibraryA/GetProcAddress),
tuc mo mot duong goi ma native tuy y - can quyet dinh co dua vao tap
tinh nang cua ngon ngu hay khong truoc khi hoan thien."""
from il_dispatch import register_expr_builtin

__tkv_import__ = "il_dispatch"

FFI_CIL_HELPERS = '''  .method public static hidebysig pinvokeimpl("kernel32.dll" ansi winapi) native int LoadLibraryA(string lpLibFileName) cil managed preservesig {}
  .method public static hidebysig pinvokeimpl("kernel32.dll" ansi winapi) native int GetProcAddress(native int hModule, string lpProcName) cil managed preservesig {}
  .method public static hidebysig pinvokeimpl("ucrtbase.dll" ansi cdecl) int32 puts(string str) cil managed preservesig {}

  .method public static native int TkvLoadCDLL(string dllName) cil managed
  {
    .maxstack 8
    ldarg.0
    call native int TKVApp::LoadLibraryA(string)
    ret
  }
  .method public static int32 TkvCCall(string msg) cil managed
  {
    .maxstack 8
    ldarg.0
    call int32 TKVApp::puts(string)
    ret
  }
'''

def compile_c_puts(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """c_puts(msg) -> P/Invoke ucrtbase.dll puts(string)."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: c_puts(msg) nhan 1 tham so string")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    cn = ctx.class_name
    out.append(f'    call int32 {cn}::puts(string)')
    if dtype:
        ctx.widen_if_needed('i32', dtype, out)

def compile_ctypes_cdll(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """ctypes_cdll(dll_name) -> LoadLibraryA."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: ctypes_cdll(dll_name) nhan 1 tham so string")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    cn = ctx.class_name
    out.append(f'    call native int {cn}::TkvLoadCDLL(string)')
    if dtype:
        ctx.widen_if_needed('i64', dtype, out)

def compile_ctypes_call(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """ctypes_call(msg) -> C call wrapper."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: ctypes_call(msg) nhan 1 tham so string")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    cn = ctx.class_name
    out.append(f'    call int32 {cn}::TkvCCall(string)')
    if dtype:
        ctx.widen_if_needed('i32', dtype, out)


def bootstrap_ffi_feature(reg: "Registry") -> "i32":
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh giong moi bootstrap_<module>() khac. Truoc day
    cac loi goi nay nam o CAP MODULE va con dung chu ky cu (thieu
    tham so `reg`) - phep kiem cua P6 chi quet cay .py nen khong
    nhin thay file CHI-CO-TKV nay.
    """
    register_expr_builtin(reg, 'c_puts', compile_c_puts, return_dtype='i32')
    register_expr_builtin(reg, 'ctypes_cdll', compile_ctypes_cdll, return_dtype='i64')
    register_expr_builtin(reg, 'ctypes_call', compile_ctypes_call, return_dtype='i32')
    return 0
