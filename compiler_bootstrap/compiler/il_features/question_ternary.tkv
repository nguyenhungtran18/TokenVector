# -*- coding: utf-8 -*-
# `c ? a : b` -> `a if c else b` (2026-09-29). Tien xu ly VAN BAN truoc khi parse.
# Port tu compiler/question_ternary.tkv sang TokenVector (2026-10-08).
# Rang buoc: KHONG doi so dong. Khi khong chac ve bien thi giu nguyen van ban.

def _is_word_char(ch: "str") -> "i32":
    alnum = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    pos = alnum.find(ch, 0)
    if pos >= 0:
        return 1
    return 0


def _is_space(ch: "str") -> "i32":
    if ch == " ":
        return 1
    if ch == "\t":
        return 1
    return 0


def _is_binary_kw(word: "str") -> "i32":
    if word == "and":
        return 1
    if word == "or":
        return 1
    if word == "is":
        return 1
    if word == "in":
        return 1
    return 0


def _is_unary_kw(word: "str") -> "i32":
    if word == "not":
        return 1
    return 0


def _is_stop_kw(word: "str") -> "i32":
    if word == "if":
        return 1
    if word == "else":
        return 1
    if word == "elif":
        return 1
    if word == "while":
        return 1
    if word == "return":
        return 1
    if word == "for":
        return 1
    if word == "assert":
        return 1
    if word == "yield":
        return 1
    if word == "lambda":
        return 1
    if word == "def":
        return 1
    if word == "class":
        return 1
    if word == "in":
        return 1
    if word == "and":
        return 1
    if word == "or":
        return 1
    if word == "not":
        return 1
    if word == "is":
        return 1
    return 0


def _has_nl(s: "str") -> "i32":
    nl = chr(10)
    p = s.find(nl, 0)
    if p < 0:
        return 0
    return 1


def _skip_string(text: "str", i: "i32") -> "i32":
    n = len(text)
    c0 = text[i]
    triple = 0
    j1 = i + 1
    j2 = i + 2
    if j2 < n:
        c1 = text[j1]
        c2 = text[j2]
        if c1 == c0:
            if c2 == c0:
                triple = 1
    if triple == 1:
        j = i + 3
    else:
        j = i + 1
    bs = chr(92)
    nl = chr(10)
    while j < n:
        ch = text[j]
        if ch == bs:
            j = j + 2
            continue
        if triple == 1:
            k1 = j + 1
            k2 = j + 2
            if k2 < n:
                d1 = text[k1]
                d2 = text[k2]
                if ch == c0:
                    if d1 == c0:
                        if d2 == c0:
                            return j + 3
        else:
            if ch == c0:
                return j + 1
            if ch == nl:
                return j
        j = j + 1
    return n


def _skip_line(text: "str", i: "i32") -> "i32":
    n = len(text)
    nl = chr(10)
    pos = text.find(nl, i)
    if pos < 0:
        return n
    return pos + 1


def _find_question(text: "str", start: "i32") -> "i32":
    n = len(text)
    dq = chr(34)
    i = start
    while i < n:
        ch = text[i]
        if ch == dq:
            i = _skip_string(text, i)
            continue
        sq = "'"
        if ch == sq:
            i = _skip_string(text, i)
            continue
        if ch == "#":
            i = _skip_line(text, i)
            continue
        if ch == "?":
            nx0 = i + 1
            nx1 = i + 2
            nxt = text[nx0:nx1]
            if nxt == "?":
                return -1
            if nxt == "=":
                return -1
            return i
        i = i + 1
    return -1


def _operand_start(text: "str", q: "i32") -> "i32":
    n = len(text)
    nl = chr(10)
    i = q
    saw = 0
    while 1 == 1:
        ws_i = i
        while i > 0:
            im = i - 1
            c = text[im]
            if _is_space(c) == 1:
                i = i - 1
            else:
                break
        if i == 0:
            if saw == 1:
                return ws_i
            return -1
        im1 = i - 1
        ch = text[im1]
        if ch == ")" or ch == "]" or ch == "}":
            depth = 0
            while i > 0:
                im = i - 1
                c = text[im]
                if c == ")" or c == "]" or c == "}":
                    depth = depth + 1
                else:
                    if c == "(" or c == "[" or c == "{":
                        depth = depth - 1
                        if depth == 0:
                            i = i - 1
                            break
                    else:
                        if c == nl:
                            return -1
                i = i - 1
            saw = 1
        else:
            if _is_word_char(ch) == 1:
                j = i - 1
                while j > 0:
                    jm = j - 1
                    cj = text[jm]
                    if _is_word_char(cj) == 1:
                        j = j - 1
                    else:
                        break
                word = text[j:i]
                if _is_unary_kw(word) == 1:
                    i = j
                    continue
                if _is_binary_kw(word) == 1:
                    i = j
                    saw = 0
                    continue
                if _is_stop_kw(word) == 1:
                    k = i
                    while k < n:
                        ck = text[k]
                        if _is_space(ck) == 1:
                            k = k + 1
                        else:
                            break
                    if saw == 1:
                        return k
                    return -1
                i = j
                saw = 1
            else:
                dq = chr(34)
                sq = "'"
                if ch == dq or ch == sq:
                    j = i - 1
                    while j > 0:
                        jm = j - 1
                        cj = text[jm]
                        if cj == ch:
                            break
                        bs = chr(92)
                        if cj == bs:
                            j = j - 1
                        j = j - 1
                    if j > 0:
                        i = j - 1
                    else:
                        i = -1
                    if i < 0:
                        return -1
                    saw = 1
                else:
                    if saw == 0:
                        if ch == "-" or ch == "+" or ch == "~" or ch == "!":
                            i = i - 1
                            continue
                    if saw == 1:
                        return ws_i
                    return -1
        while 1 == 1:
            j = i
            while j > 0:
                jm = j - 1
                cj = text[jm]
                if _is_space(cj) == 1:
                    j = j - 1
                else:
                    break
            if j > 0:
                jm2 = j - 1
                cj2 = text[jm2]
                if cj2 == ".":
                    j = j - 1
                    while j > 0:
                        jm3 = j - 1
                        cj3 = text[jm3]
                        if _is_word_char(cj3) == 1:
                            j = j - 1
                        else:
                            break
                    i = j
                    continue
            br = 0
            if j > 0:
                jm4 = j - 1
                cj4 = text[jm4]
                if cj4 == ")" or cj4 == "]":
                    br = 1
            if br == 1:
                k = j
                depth = 0
                while k > 0:
                    km = k - 1
                    c = text[km]
                    if c == ")" or c == "]":
                        depth = depth + 1
                    else:
                        if c == "(" or c == "[":
                            depth = depth - 1
                            if depth == 0:
                                k = k - 1
                                break
                    k = k - 1
                i = k
                continue
            break


def _matching_colon(text: "str", q: "i32", depth0: "i32") -> "i32":
    n = len(text)
    nl = chr(10)
    dq = chr(34)
    sq = "'"
    i = q
    depth = depth0
    while i < n:
        ch = text[i]
        if ch == nl:
            return -1
        if ch == dq or ch == sq:
            i = _skip_string(text, i)
            continue
        if ch == "#":
            return -1
        if ch == "(" or ch == "[" or ch == "{":
            depth = depth + 1
        else:
            if ch == ")" or ch == "]" or ch == "}":
                if depth == depth0:
                    return -1
                depth = depth - 1
            else:
                if ch == ":":
                    if depth == depth0:
                        return i
        i = i + 1
    return -1


def _branch_end(text: "str", colon: "i32", depth0: "i32") -> "i32":
    n = len(text)
    nl = chr(10)
    dq = chr(34)
    sq = "'"
    i = colon + 1
    depth = depth0
    while i < n:
        ch = text[i]
        if ch == nl:
            return i
        if ch == dq or ch == sq:
            i = _skip_string(text, i)
            continue
        if ch == "#":
            return _skip_line(text, i)
        if ch == "(" or ch == "[" or ch == "{":
            depth = depth + 1
        else:
            if ch == ")" or ch == "]" or ch == "}":
                if depth == depth0:
                    return i
                depth = depth - 1
            else:
                if ch == "," or ch == ";":
                    if depth == depth0:
                        return i
        i = i + 1
    return n


def rewrite_question_ternary(source_text: "str", max_rounds: "i32"=64) -> "str":
    qm = "?"
    p0 = source_text.find(qm, 0)
    if p0 < 0:
        return source_text
    text = source_text
    n = len(text)
    r = 0
    while r < max_rounds:
        q = _find_question(text, 0)
        if q < 0:
            return text
        start = _operand_start(text, q)
        if start < 0:
            return text
        depth0 = 0
        k = 0
        while k < start:
            ch = text[k]
            if ch == "(" or ch == "[" or ch == "{":
                depth0 = depth0 + 1
            if ch == ")" or ch == "]" or ch == "}":
                depth0 = depth0 - 1
            k = k + 1
        colon = _matching_colon(text, q, depth0)
        if colon < 0:
            return text
        end = _branch_end(text, colon, depth0)
        n = len(text)
        cond_raw = text[start:q]
        cond = cond_raw.strip()
        q1 = q + 1
        yes_raw = text[q1:colon]
        yes = yes_raw.strip()
        c1 = colon + 1
        no_raw = text[c1:end]
        no = no_raw.strip()
        if cond == "":
            return text
        if yes == "":
            return text
        if no == "":
            return text
        if _has_nl(cond) == 1:
            return text
        if _has_nl(yes) == 1:
            return text
        if _has_nl(no) == 1:
            return text
        pre = text[0:start]
        post = text[end:n]
        text = pre + yes + " if " + cond + " else " + no + post
        n = len(text)
        r = r + 1
    return text
