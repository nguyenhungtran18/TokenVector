# -*- coding: utf-8 -*-
"""stdlib_pathlib.tkv - Module ho tro thao tac duong dan va file I/O theo phong cach pathlib.

Cung cap cac ham:
- path_stem(p) -> str (Phan ten file khong kem duoi mo rong, Path.GetFileNameWithoutExtension)
- path_suffix(p) -> str (Phan mo rong cua file, Path.GetExtension)
- path_name(p) -> str (Ten day du cua file, Path.GetFileName)
- path_parent(p) -> str (Duong dan thu muc cha, Path.GetDirectoryName)
- path_read_text(p) -> str (Doc toan bo noi dung text cua file, File.ReadAllText)
- path_write_text(p, text) -> i32 (Ghi text vao file, File.WriteAllText)

PORT tu compiler/il_features/stdlib_pathlib.tkv (2026-10-06). Toan bo la
port co hoc: ctx['compile_expr'] -> ctx.compile_expr, dang ky module-level
-> def bootstrap_stdlib_pathlib(reg). Them 'path_write_text' vao
_BUILTIN_LENH_DOC_LAP (file_io.tkv) de goi doc lap duoc.
"""

from il_dispatch import register_expr_builtin

__tkv_import__ = "il_dispatch"


def _push_path_stem(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 1:
        raise SyntaxError("il_codegen: path_stem(p) can dung 1 tham so")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    call string [mscorlib]System.IO.Path::GetFileNameWithoutExtension(string)')


def _push_path_suffix(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 1:
        raise SyntaxError("il_codegen: path_suffix(p) can dung 1 tham so")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    call string [mscorlib]System.IO.Path::GetExtension(string)')


def _push_path_name(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 1:
        raise SyntaxError("il_codegen: path_name(p) can dung 1 tham so")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    call string [mscorlib]System.IO.Path::GetFileName(string)')


def _push_path_parent(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 1:
        raise SyntaxError("il_codegen: path_parent(p) can dung 1 tham so")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    call string [mscorlib]System.IO.Path::GetDirectoryName(string)')


def _push_path_read_text(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 1:
        raise SyntaxError("il_codegen: path_read_text(p) can dung 1 tham so")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append('    call string [mscorlib]System.IO.File::ReadAllText(string)')
    out.append('    ldstr "\\r\\n"')
    out.append('    ldstr "\\n"')
    out.append('    callvirt instance string [mscorlib]System.String::Replace(string, string)')
    out.append('    ldstr "\\r"')
    out.append('    ldstr "\\n"')
    out.append('    callvirt instance string [mscorlib]System.String::Replace(string, string)')


def _push_path_write_text(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 2:
        raise SyntaxError("il_codegen: path_write_text(p, text) can dung 2 tham so")
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    ctx.compile_expr(args[1], scope, out, 'str', ctx)
    out.append('    call void [mscorlib]System.IO.File::WriteAllText(string, string)')
    out.append('    ldc.i4.1')


def bootstrap_stdlib_pathlib(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_expr_builtin(reg, 'path_stem', _push_path_stem, 'str')
    register_expr_builtin(reg, 'path_suffix', _push_path_suffix, 'str')
    register_expr_builtin(reg, 'path_name', _push_path_name, 'str')
    register_expr_builtin(reg, 'path_parent', _push_path_parent, 'str')
    register_expr_builtin(reg, 'path_read_text', _push_path_read_text, 'str')
    register_expr_builtin(reg, 'path_write_text', _push_path_write_text, 'i32')
