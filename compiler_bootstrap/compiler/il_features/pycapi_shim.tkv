# -*- coding: utf-8 -*-
"""CPython C-API Compatibility Shim (Moc 37, 2026-08-09) - PyObject & C-Extension interop.

Cung mot file .tkv, 2 duong chay (CPython & TokenVector .exe), cung ket qua 100%.

CHUA HOAN THANH - KHONG DUOC NOI DAY (do that 2026-09-17)
=========================================================
Hang `PYCAPI_SHIM_CIL_HELPERS` ben duoi chua than IL cua cac method helper ma codegen o
day PHAT LOI GOI TOI. Hang do duoc dinh nghia MOT LAN va KHONG AI THAM
CHIEU - da grep toan repo. Hau qua do bang cach chay that: chuong trinh
bien dich TROT LOT roi nem `System.MissingMethodException: Method not
found: '...'` ngay khi goi.

Nen module nay CO Y khong nam trong `bootstrap_all`. Muon hoan thien:
boc khoi helper thanh mot class rieng theo khuon `IPOW_CLASS` trong
il_features/stdlib_math.py (`ctx.extra_classes.append(...)` co canh gac
`emitted_types`), roi doi cho goi tu `TKVApp::Tkv...` sang class do -
hien khong co co che "them method vao chinh class dang sinh".
"""
from il_dispatch import register_expr_builtin

__tkv_import__ = "il_dispatch"

def compile_py_tuple_new(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """py_tuple_new(size) -> List<object> as PyTuple."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: py_tuple_new(size) nhan 1 tham so i32")
    ctx.compile_expr(args[0], scope, out, 'i32', ctx)
    out.append(f'    call class [mscorlib]System.Collections.Generic.List`1<object> class {ctx.class_name}::TkvPyTupleNew(int32)')
    if dtype:
        ctx.widen_if_needed('object', dtype, out)

def compile_py_dict_new(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """py_dict_new() -> Dictionary<object, object> as PyDict."""
    out.append(f'    call class [mscorlib]System.Collections.Generic.Dictionary`2<object,object> class {ctx.class_name}::TkvPyDictNew()')
    if dtype:
        ctx.widen_if_needed('object', dtype, out)


PYCAPI_SHIM_CIL_HELPERS = '''  .method public static class [mscorlib]System.Collections.Generic.List`1<object> TkvPyTupleNew(int32 size) cil managed
  {
    .maxstack 8
    ldarg.0
    newobj instance void class [mscorlib]System.Collections.Generic.List`1<object>::.ctor(int32)
    ret
  }
  .method public static class [mscorlib]System.Collections.Generic.Dictionary`2<object,object> TkvPyDictNew() cil managed
  {
    .maxstack 8
    newobj instance void class [mscorlib]System.Collections.Generic.Dictionary`2<object,object>::.ctor()
    ret
  }
'''


def bootstrap_pycapi_shim(reg: "Registry") -> "i32":
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh giong moi bootstrap_<module>() khac. Truoc day
    cac loi goi nay nam o CAP MODULE va con dung chu ky cu (thieu
    tham so `reg`) - phep kiem cua P6 chi quet cay .py nen khong
    nhin thay file CHI-CO-TKV nay.
    """
    register_expr_builtin(reg, 'py_tuple_new', compile_py_tuple_new, return_dtype='object')
    register_expr_builtin(reg, 'py_dict_new', compile_py_dict_new, return_dtype='object')
    return 0
