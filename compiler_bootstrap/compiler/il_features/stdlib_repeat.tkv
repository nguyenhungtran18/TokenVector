# -*- coding: utf-8 -*-
"""List/string repeat ('lst * n', Python that; 'repeat_str(s, n)' cho
string vi ly do duoi day) - Wave 3 quick-win cuoi cung (2026-07-29),
hoan tat nhom A con thieu (list/string multiplication).

'lst * n' (list): dung ASSIGN_RHS_PARSERS, GATE BAT BUOC qua
known_shapes.get(name)=='list' (giong het list.count()) - KHONG the
dung regex '^(\\w+)\\s*\\*\\s*(.+)$' don thuan vi se khop CA phep nhan
so hoc binh thuong 'x = a * b' (RAT PHO BIEN) - known_shapes CHI danh
dau ten da khai bao 'lst = []', bien so/scalar KHONG BAO GIO xuat hien
trong known_shapes nen gate nay AN TOAN, khong bao gio nham voi nhan so
hoc thuong.

'repeat_str(s, n)' (string): KHONG dung duoc cu phap 's * n' voi CUNG
ly do - string la scalar (assign_scalar chung, KHONG co known_shapes
danh dau nhu list) nen KHONG THE gate an toan qua parse-time regex (se
nham voi nhan so hoc) - dung 1 ham FLAT rieng, ten khong trung, an
toan 100% (giong json_dumps/list.count, khong the long trong bieu
thuc khac, CHI RHS truc tiep 1 phep gan don)."""
import stmt_row as _row
import re

from il_core import parse_expr, nid
from il_dispatch import register_assign_rhs_parser, register_first_pass_walk, register_stmt_codegen
from il_features.list_type import il_list_type
from tkv_types import TypeAnn
from stmt_row import intern, lay_nut, lay_str, make4

_LIST_REPEAT_RE = re.compile(r'^(\w+)\s*\*\s*(.+)$')
_REPEAT_STR_RE = re.compile(r'^repeat_str\((\w+),\s*(.+)\)$')


__tkv_import__ = ["il_dispatch", "tkv_types"]

def try_rhs_list_repeat(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    m = _LIST_REPEAT_RE.match(rhs.strip())
    if not m or known_shapes.get(m.group(1)) != 'list':
        return None
    known_shapes[name] = 'list'
    return intern(make4('assign_list_repeat', name, m.group(1), m.group(2)))


def try_rhs_repeat_str(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    m = _REPEAT_STR_RE.match(rhs.strip())
    if not m:
        return None
    return intern(make4('assign_repeat_str', name, m.group(1), m.group(2)))


def fpw_assign_list_repeat(stmt: "i32", ctx: "WalkCtx"):
    list_ta = ctx.infer_scope.tra(lay_str(stmt, 'list_name')).ta
    ctx.declare_named(lay_str(stmt, 'name'), list_ta)
    ctx.declare_named(f'__rep{nid(stmt)}_idx', TypeAnn('i32', None))
    ctx.collect_ternary_temps(lay_nut(stmt, 'count_node'))


def fpw_assign_repeat_str(stmt: "i32", ctx: "WalkCtx"):
    str_ta = ctx.infer_scope.tra(lay_str(stmt, 'str_name')).ta
    if str_ta.dtype != 'str' or not str_ta.la_vo_huong():
        raise SyntaxError(f"il_codegen: repeat_str(...) can '{lay_str(stmt, 'str_name')}' la string")
    ctx.declare_named(lay_str(stmt, 'name'), TypeAnn('str', None))
    ctx.declare_named(f'__rep{nid(stmt)}_idx', TypeAnn('i32', None))
    ctx.collect_ternary_temps(lay_nut(stmt, 'count_node'))


def codegen_assign_list_repeat(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    list_ta = scope.tra(lay_str(stmt, 'list_name')).ta
    list_type = ctx.il_type_str(list_ta, ctx.records)
    load_var_ref, store_var, compile_expr = ctx.load_var_ref, ctx.store_var, ctx.compile_expr
    idx_idx = scope.tra(f'__rep{nid(stmt)}_idx').idx

    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    start_lbl = f"{ctx.prefix}_rep{n}_start"
    end_lbl = f"{ctx.prefix}_rep{n}_end"

    body.append(f'    newobj instance void {list_type}::.ctor()')
    store_var(lay_str(stmt, 'name'), scope, body)
    body.append('    ldc.i4.0')
    body.append(f'    stloc.s {idx_idx}')

    body.append(f'  {start_lbl}:')
    body.append(f'    ldloc.s {idx_idx}')
    compile_expr(lay_nut(stmt, 'count_node'), scope, body, 'i32', ctx)
    body.append(f'    bge {end_lbl}')
    load_var_ref(lay_str(stmt, 'name'), scope, body)
    load_var_ref(lay_str(stmt, 'list_name'), scope, body)
    body.append(
        f'    callvirt instance void {list_type}::AddRange(class '
        f'[mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    body.append(f'    ldloc.s {idx_idx}')
    body.append('    ldc.i4.1')
    body.append('    add')
    body.append(f'    stloc.s {idx_idx}')
    body.append(f'    br {start_lbl}')
    body.append(f'  {end_lbl}:')


def codegen_assign_repeat_str(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    load_var_ref, store_var, compile_expr = ctx.load_var_ref, ctx.store_var, ctx.compile_expr
    idx_idx = scope.tra(f'__rep{nid(stmt)}_idx').idx

    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    start_lbl = f"{ctx.prefix}_reps{n}_start"
    end_lbl = f"{ctx.prefix}_reps{n}_end"

    body.append('    ldstr ""')
    store_var(lay_str(stmt, 'name'), scope, body)
    body.append('    ldc.i4.0')
    body.append(f'    stloc.s {idx_idx}')

    body.append(f'  {start_lbl}:')
    body.append(f'    ldloc.s {idx_idx}')
    compile_expr(lay_nut(stmt, 'count_node'), scope, body, 'i32', ctx)
    body.append(f'    bge {end_lbl}')
    load_var_ref(lay_str(stmt, 'name'), scope, body)
    load_var_ref(lay_str(stmt, 'str_name'), scope, body)
    body.append('    call string [mscorlib]System.String::Concat(string, string)')
    store_var(lay_str(stmt, 'name'), scope, body)
    body.append(f'    ldloc.s {idx_idx}')
    body.append('    ldc.i4.1')
    body.append('    add')
    body.append(f'    stloc.s {idx_idx}')
    body.append(f'    br {start_lbl}')
    body.append(f'  {end_lbl}:')


def bootstrap_stdlib_repeat(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_assign_rhs_parser(reg, 'list_repeat', try_rhs_list_repeat)
    register_assign_rhs_parser(reg, 'repeat_str', try_rhs_repeat_str)
    register_first_pass_walk(reg, 'assign_list_repeat', fpw_assign_list_repeat)
    register_first_pass_walk(reg, 'assign_repeat_str', fpw_assign_repeat_str)
    register_stmt_codegen(reg, 'assign_list_repeat', codegen_assign_list_repeat)
    register_stmt_codegen(reg, 'assign_repeat_str', codegen_assign_repeat_str)
