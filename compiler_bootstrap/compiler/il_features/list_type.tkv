__tkv_import__ = ["il_dispatch", "tkv_types"]


def _split_container_spec(spec: "str") -> "(str,str)":
    """(kind, inner) neu `spec` la CHUOI MANG SHAPE, ('', '') nguoc lai.

    NGUON SU THAT DUY NHAT cho viec 'co phai 1 spec container hay khong'.
    `spec` co the la dtype container that (i32/str/...) - khi do kind rong.
    `spec` co the la None (dieu kien dtype chua co) - phai chan TRUOC khi goi
    `str.endswith`, khong thi compiler chet NullReferenceException.
    Python: xem list_type.py's _split_container_spec (tra None)."""
    if spec is None or spec == '' or not spec.endswith(']'):
        return '', ''
    for kind in ('list', 'dict', 'set'):
        if spec.startswith(kind + '['):
            return kind, spec[len(kind) + 1:-1].strip()
    return '', ''


def il_list_elem_ilstr(dtype: "str", records: "dict[str,list[(str,TkvTypeAnn)]]" = None, extern_class_defs: "dict[str,i32]" = None) -> "str":
    """Kieu IL cua 1 PHAN TU List<T>/Dictionary value/HashSet<T> - dtype
    vo huong THAT (tra ve IL_SCALAR[dtype]) HOAC ten 1 'class dang record'
    da khai bao (tra ve 'class TenRecord' - khoang trong ngon ngu #2,
    "List chua record"; DA doi tu 'valuetype' sang 'class' cung B1,
    2026-07-29 - record gio la reference type, xem project-tokenvector-
    wave2-status memory) HOAC ten 1 extern-class da khai bao (tra ve
    'class [assembly]ClassName' - Task 2, extern-class-list, 2026-08-18).
    Dung CHUNG boi ca list_type.py/dict_type.py/set_type.py (khong dat
    rieng moi noi, tranh trung lap logic). `extern_class_defs` mac dinh
    None de KHONG pha cac call site cu (record-only, chua biet
    extern-class).

    2026-10-11 (literal long nhau): nhan them CHUOI MANG SHAPE
    ('list[i32]'/'dict[str,i32]'/'set[i32]') - chuyen ngay cho
    il_container_type_of_spec. Truoc day chi 'la' (noi nhieu noi goi truc
    tiep voi 1 dtype da bi boc sai cho 1 spec) nen chan sai am tham o giua
    duong, trong khi ham nay da bi thiet ke de la NOI CUOI CUNG cua 1 spec
    dang shape. KHONG phai noi long: khoi tao container long nhau van an
    toan."""
    elem = IL_SCALAR.get(dtype)
    if elem is not None:
        return elem
    if records and dtype in records:
        return f'class {dtype}'
    if extern_class_defs and dtype in extern_class_defs:
        d = extern_class_defs[dtype]
        return f"class [{il_extern_dtype.ex_assembly(d)}]{il_extern_dtype.ex_lop(d)}"
    k_ind, _inner = _split_container_spec(dtype)
    if k_ind != '':
        return il_container_type_of_spec(dtype, records, extern_class_defs)
    raise SyntaxError(
        f"il_codegen: List phan tu kieu {dtype!r} khong hop le - phai la dtype vo huong "
        f"(f32/f64/i32/i64/str) hoac ten 1 class dang record/extern-class da khai bao")


def il_list_type(dtype: "str", records: "dict[str,list[(str,TkvTypeAnn)]]" = None, extern_class_defs: "dict[str,i32]" = None) -> "str":
    """Kieu IL cua 1 List<T> DONG (closed generic) - dung CHUNG cho khai
    bao local, .ctor, va cac method Add/get_Item/get_Count (khi goi tren
    generic type DA DONG, IL ghi THANG kieu cu the, KHONG dung placeholder
    !0 - placeholder chi dung khi goi tren DINH NGHIA generic mo).
    `extern_class_defs` mac dinh None (Task 2, extern-class-list)."""
    return (f'class [mscorlib]System.Collections.Generic.List`1'
            f'<{il_list_elem_ilstr(dtype, records, extern_class_defs)}>')


def emit_str_chars(ctx: "Ctx", out: "list[str]"):
    """Chuoi tren stack -> List<string> cac ky tu (list(s) / sorted(s)), TkvChars::Of."""
    emitted = ctx.emitted_types
    if emitted is not None and 'TkvChars' not in emitted:
        emitted.add('TkvChars')
        L = 'class [mscorlib]System.Collections.Generic.List`1<string>'
        S = '[mscorlib]System.String'
        ctx.extra_classes.append([
            '.class public auto ansi beforefieldinit TkvChars extends [mscorlib]System.Object',
            '{',
            f'  .method public static {L} Of(string s) cil managed',
            '  {',
            '    .maxstack 8',
            f'    .locals init ({L} r, int32 i)',
            f'    newobj instance void {L}::.ctor()', '    stloc.0', '    ldc.i4.0', '    stloc.1',
            '  CH_LAP:',
            '    ldloc.1', '    ldarg.0', f'    callvirt instance int32 {S}::get_Length()', '    bge CH_HET',
            '    ldloc.0', '    ldarg.0', '    ldloc.1', '    ldc.i4.1', f'    callvirt instance string {S}::Substring(int32, int32)',
            f'    callvirt instance void {L}::Add(!0)',
            '    ldloc.1', '    ldc.i4.1', '    add', '    stloc.1', '    br CH_LAP',
            '  CH_HET:',
            '    ldloc.0', '    ret',
            '  }',
            '}',
        ])
    out.append('    call class [mscorlib]System.Collections.Generic.List`1<string> TkvChars::Of(string)')


def emit_list_sort(out: "list[str]", list_type: "str", dtype: "str"):
    """List<T>.Sort(): chuoi PHAI sap theo ORDINAL nhu Python (Comparer<string>.Default
    la culture-sensitive: 'a' < 'B' - sai am tham, 2026-09-30)."""
    if dtype == 'str':
        out.append('    call class [mscorlib]System.StringComparer [mscorlib]System.StringComparer::get_Ordinal()')
        out.append(f'    callvirt instance void {list_type}::Sort(class [mscorlib]System.Collections.Generic.IComparer`1<!0>)')
    else:
        out.append(f'    callvirt instance void {list_type}::Sort()')


def il_container_type_of_spec(spec: "str", records: "dict[str,list[(str,TkvTypeAnn)]]"=None, extern_class_defs: "dict[str,i32]"=None) -> "str":
    """Chuoi CIL cua 1 GIA TRI duoc mo ta boi `spec` - NGUON DUY NHAT cho
    quy uoc "dtype co the la 1 chuoi mang shape" dung xuyen suot codebase
    ('i32', 'Point', 'Sb', 'list[i32]', 'list[list[i32]]',
    'dict[str,i32]', 'dict[str,list[i32]]'...). Hop nhat 2 implementation
    TRUNG LAP truoc day - `_il_list_of` (duong list thuan .tkv, file nay)
    va `_il_ctor_param_type` (duong extern-class ctor/method,
    il_codegen.py) - moi ben tu de quy rieng, gay IL sai am tham khi 1
    ben duoc mo rong (them lop long/handle-type/dict long) con ben kia
    thi khong (xem docs/BUGS_TODO.md muc F, phat hien lai lai qua muc O/P
    voi 1 lop bug KHAC nhung CUNG goc "2 noi lam 1 viec").

    De quy 1 lop cho moi lop 'list['/'dict[' - dung LAI il_list_elem_ilstr
    cho phan tu la (i) scalar (IL_SCALAR), (ii) record da khai bao (can
    `records`), (iii) extern-class da khai bao qua __tkv_extern_class__
    (can `extern_class_defs`) - KHONG dinh nghia lai logic do o day.

    Luu y (final-review round 3, docs/BUGS_TODO.md muc F): ham nay KHONG
    tu validate `spec` - no CHAP NHAN nhieu input hon 2 caller goc tung
    chap nhan rieng le (vd: dict[...] lam element spec cua list[...], hay
    key khong-scalar cua dict[...]). Cac caller dua vao 1 lop validate O
    TREN (tkv_compile.py) da chan cac input do truoc khi toi codegen -
    hien tai vo hai vi khong con duong nao goi toi day voi input nhu vay,
    nhung ham nay tu no khong con la hang rao chan."""
    if extern_class_defs and spec in extern_class_defs:
        d = extern_class_defs[spec]
        return f"class [{il_extern_dtype.ex_assembly(d)}]{il_extern_dtype.ex_lop(d)}"
    if spec.startswith('list[') and spec.endswith(']'):
        inner_spec = spec[len('list['):-1].strip()
        inner_il = il_container_type_of_spec(inner_spec, records, extern_class_defs)
        return f'class [mscorlib]System.Collections.Generic.List`1<{inner_il}>'
    if spec.startswith('dict[') and spec.endswith(']'):
        kv = spec[len('dict['):-1]
        key_spec, val_spec = kv.split(',', 1)
        key_spec, val_spec = key_spec.strip(), val_spec.strip()
        key_il = il_container_type_of_spec(key_spec, records, extern_class_defs)
        val_il = il_container_type_of_spec(val_spec, records, extern_class_defs)
        return f'class [mscorlib]System.Collections.Generic.Dictionary`2<{key_il}, {val_il}>'
    if spec.startswith('set[') and spec.endswith(']'):
        inner_spec = spec[len('set['):-1].strip()
        # HashSet`1 nam trong [System.Core], KHONG phai [mscorlib] nhu
        # List`1/Dictionary`2 - xem il_features/set_type.tkv's il_set_type
        # (bug TypeLoadException luc probe, 2026-07-28).
        return il_set_type(inner_spec, records, extern_class_defs)
    return il_list_elem_ilstr(spec, records, extern_class_defs)


def reject_if_nested_container_elem(ta: "TypeAnn", fname: "str"):
    """Tu choi ro rang neu list nguon co phan tu la container long nhau
    (list[list[T]]/list[dict[K,V]], nhan biet qua ta.elem_ta khac None -
    xem TypeAnn.elem_ta trong typed_dsl_parser.py) - dung cho remove()/
    index()/count()/'in' (review vong 4, task-1-review-round4-report.md).
    GIOI HAN KIEN TRUC THAT, khong phai bug co the va don gian sua: cac
    ham nay dung List<T>.Remove/IndexOf/Contains, tat ca deu so sanh qua
    EqualityComparer<T>.Default - voi T la 1 container (List<T> khac),
    default comparer la SO SANH THAM CHIEU, khong phai noi dung. 1 gia
    tri list-literal MOI (newobj) tai diem goi se KHONG BAO GIO khop
    tham chieu voi phan tu da co trong list dich, du noi dung giong het -
    khong the vay bang shape-string dtype convention nhu 3 vong review
    truoc, PHAI chan o day (giong reject_if_handle_type_elem cho
    Nhom C/D/E o list-handle-type-aggregate-guard, muc P)."""
    if ta.elem_ta is not None:
        raise SyntaxError(
            f"il_codegen: {fname}() khong ho tro list chua container long nhau "
            f"(list[list[...]]/list[dict[...]]) - List<T> so sanh phan tu container "
            f"THEO THAM CHIEU (khong theo noi dung), ket qua se sai am tham")


def reject_if_elem_ta(ta: "TypeAnn", fname: "str"):
    """Tu choi list co phan tu la container/ham (ta.elem_ta khac None) o
    cac ham chi dung `il_list_type(ta.dtype)` - voi list[list[str]] hay
    list[func()->i32], `ta.dtype` la dtype VO HUONG ben trong ('str'/'i32')
    nen kieu IL sinh ra la List<string>/List<int32> tren mot doi tuong that
    ra la List<List<string>>/List<Func<int32>>: CLR van chay, sai am tham
    (lo ra 2026-09-24, xem nhanh len() trong il_codegen._expr_call)."""
    if ta.elem_ta is not None:
        raise SyntaxError(
            f"il_codegen: {fname}() chua ho tro list co phan tu la container/ham "
            f"(list[list[...]]/list[dict[...]]/list[func(...)]) - gan tung phan tu ra bien truoc")


def reject_if_handle_type_elem(ta: "TypeAnn", extern_class_defs: "dict[str,i32]", fname: "str"):
    """Tu choi ro rang neu list/set nguon co phan tu la handle type (extern-
    class da khai qua __tkv_extern_class__) - dung cho cac ham CAN so sanh/
    so hoc/serialize tren phan tu (sum/min/max/any/all/sorted/json_dumps),
    KHAC map/filter/reduce/choice/shuffle/sample (pass-through, khong dong
    den noi dung phan tu, nen KHONG goi ham nay - xem il_list_type's tham so
    extern_class_defs cho nhanh do thay vao do)."""
    if extern_class_defs and ta.dtype in extern_class_defs:
        raise SyntaxError(
            f"il_codegen: {fname}() khong ho tro list/set chua handle type "
            f"('{ta.dtype}' da khai qua __tkv_extern_class__) - .NET class "
            f"tuy y khong tu co IComparable/phep toan/serialize duoc")


# Co NOI TUYEN `(?s)` thay cho tham so `re.S` (2026-09-18): dang co co
# lam `_re_compile_pattern` tu choi -> chan phep gop self-host. `(?s)`
# la cu phap CA .NET Regex LAN Python `re` deu hieu, nen hanh vi khong
# doi va ban .py van chay duoi CPython y het.
_LIST_LIT_RE = re.compile(r'(?s)^\[.*\]$')
_LIST_APPEND_RE = re.compile(r'^(\w+)\.append\((.+)\)\s*$')
_BIEN_DON_RE = re.compile(r'^\w+$')


def try_rhs_list_call(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    """ASSIGN_RHS_PARSERS entry: `xs = list()` va `xs = list(ys)` (port tu
    Python 2026-09-30, sang TokenVector 2026-10-09).

    - `list()` rong: tra ve CUNG stmt kind `assign_list_new` nhu `xs = []`,
      nen moi phu thu `declare_list`/`codegen_assign_list_new` - het.
    - `list(ys)`: `ys` phai la 1 BIEN da khai bao co shape='list' (check qua
      known_shapes o day; fpw se check lai qua infer_scope).

    TokenVector: `m.groups()` chi unpack duoc ('a, b = m.groups()'), con
    `m.group(1)` KHONG ton tai - nen KHONG dung regex group de lay `src`;
    tach tay bang find/slice nhu tach ten ham o cac macro khac."""
    rhs_s = rhs.strip()
    # Tach tay: phai bat dau 'list(' va ket thuc ')' va khong co ngoac long.
    if not rhs_s.startswith('list(') or not rhs_s.endswith(')'):
        return None
    src = rhs_s[5:len(rhs_s) - 1].strip()
    if '(' in src or ')' in src:
        return None
    if not src:
        known_shapes[name] = 'list'
        return intern(make2('assign_list_new', name))
    known_shapes[name] = 'list'
    return intern(make3('assign_list_from', name, src))


def compile_index_list(name: "str", indices: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """CIL cho 'lst[i]' (doc 1 phan tu List<T>) - tag 'index' cua
    _compile_expr khi shape=='list', xem il_codegen.py's _expr_index.
    Dung ctx['il_type_str'] (DE QUY) thay vi il_list_type(dtype,...) THANG
    - can THIET tu Wave 2 (2026-07-29, container long nhau): khi 'lst' la
    List<List<T>>/List<Dict<K,V>> (type_ann.elem_ta khac None), chi
    il_type_str moi tinh dung kieu IL day du cua CHINH list nay (xem
    il_codegen.py's il_type_str) - voi list thuong (elem_ta=None), 2 ham
    cho ra CHUOI GIONG HET NHAU (khong doi hanh vi cu)."""
    if len(indices) != 1:
        raise SyntaxError(f"il_codegen: list '{name}' chi ho tro 1 chi so")
    type_ann = scope.tra(name).ta
    list_type = ctx.il_type_str(type_ann, (ctx.records if ctx is not None else None))
    ctx.load_var_ref(name, scope, out)
    emit_index_value(name, indices[0], scope, out, ctx,
                      f'callvirt instance int32 {list_type}::get_Count()')
    # QUAN TRONG: tra ve '!0' (placeholder generic param), KHONG phai
    # kieu da thay the (vd float32) - bug that phat hien qua test
    # (MissingMethodException luc chay): metadata cua get_Item duoc dinh
    # nghia TREN generic type DINH NGHIA MO voi kieu tra ve la !0;
    # methodref phai ghi DUNG nhu vay, phan <float32> chi cung cap ngu
    # canh thay the cho KIEU KHAI BAO, khong doi chu ky cua chinh method.
    out.append(f'    callvirt instance !0 {list_type}::get_Item(int32)')
    ctx.widen_if_needed(type_ann.dtype, dtype, out)


def try_rhs_list_literal(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    """ASSIGN_RHS_PARSERS entry: 'lst = []' HOAC 'xs = [3, 1, 2]' - Giai
    doan 0.1 (2026-08-03, dong Python-parity-gap v2): dung PARSER THAT
    (parse_expr, tag 'list_literal' vua them vao il_core.py's parse_factor)
    thay vi tu tach dau phay bang tay - tu dong dung ke ca phan tu chua
    bieu thuc long nhau/dau phay trong ham (vd '[f(1, 2), 3]').

    RONG ('[]'): dtype phan tu CHUA biet o day, suy sau tu LAN GOI
    '.append(...)' DAU TIEN tren bien nay (xem declare_list) - giu NGUYEN
    hanh vi cu (stmt kind 'assign_list_new'), khong doi gi.

    CO PHAN TU ('[3, 1, 2]'): dtype suy THANG tu chinh cac phan tu (xem
    declare_list_literal), khong can quet '.append()' sau do."""
    rhs_s = rhs.strip()
    if not _LIST_LIT_RE.match(rhs_s):
        return None
    node = parse_expr(rhs_s)
    if ekind(node) != 'list_literal':
        return None
    known_shapes[name] = 'list'
    if not ea_ds(node):
        return intern(make2('assign_list_new', name))
    return intern(make3('assign_list_literal', name, rhs_s))



def try_parse_list_append(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """LINE_PARSERS entry: 'lst.append(x)' - PHAI dang ky TRUOC
    method_call_stmt (pattern method-call tong quat cung khop dong nay).

    Loai tru known_shapes=='bytearray' (muc 6.8, 3/4, 2026-08-13, giong het
    cach try_parse_list_remove da loai tru set/frozenset o duoi): 'ba.append(x)'
    tren bytearray CAN codegen RIENG (chen 'conv.u1' truoc Add(!0) - xem
    bytearray_type.py) - neu KHONG loai tru o day, nhanh list nay se cuop
    mat truoc (list_type.py duoc import/dang ky TRUOC bytearray_type.py
    trong il_codegen.py, LINE_PARSERS thu THEO THU TU dang ky) va bo lo
    buoc narrow bat buoc do.

    Loai tru THEM known_shapes=='bytes' (muc 6.8, 4/4, 2026-08-13): 'data.append(x)'
    tren bien 'bytes' (bat bien) PHAI bi try_parse_bytes_append_blocked
    (bytes_type.py) bat va nem SyntaxError bat bien - neu KHONG loai tru o
    day, nhanh list nay se cuop mat truoc va sinh IL append hop le (SAI,
    'bytes' khong duoc mutate)."""
    m = _LIST_APPEND_RE.match(line)
    if not m:
        return None
    _sh = known_shapes.get(m.group(1))
    if _sh is not None and _sh != 'list':
        # R4/D6 (port tu Python, 2026-09-22): 'rec.append(x)' tren record/
        # str/dict/... phai roi xuong method_call_stmt, KHONG duoc cuop boi
        # nhanh list nay. None = chua ro (tuong thich nguoc: van coi nhu list).
        return None
    if _sh in ('bytearray', 'bytes'):
        return None
    name, arg_expr = m.groups()
    return intern(make3('list_append', name, arg_expr)), pos + 1


def codegen_assign_list_new(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'lst = []'. Dung ctx['il_type_str'] (DE QUY, xem
    il_codegen.py) thay il_list_type THANG - can THIET tu Wave 2
    (2026-07-29) de ho tro dung List<List<T>>/List<Dict<K,V>> khi ta.elem_ta
    khac None; voi list thuong ra CUNG 1 chuoi nhu truoc."""
    ta = scope.tra(lay_str(stmt, 'name')).ta
    body.append(f'    newobj instance void {ctx.il_type_str(ta, ctx.records)}::.ctor()')
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def _record_stmt_fallback(name: "str", method_name: "str", arg_nodes: "list[TkvNode]", scope: "Scope", body: "list[str]", ctx: "Ctx") -> "i32":
    """R4/D6 safety net (port tu Python bootstrap, 2026-09-29):
    'rec.add/append/insert/remove(...)' dang lenh doc lap nhung receiver
    THAT SU la record (luc parse known_shapes chua biet nen parser van
    hieu nham la container). Phat lai dung logic record-statement cua
    _stmt_method_call_stmt (load receiver + compile args theo m_sig +
    callvirt + pop neu co return). Tra 1 neu da xu ly, 0 neu receiver
    khong phai record (caller tiep tuc duong container nhu cu)."""
    rec_methods = ctx.record_methods or {}
    ta = scope.tra(name).ta
    if ta.shape_ten != 'record':
        return 0
    methods = rec_methods.get(ta.dtype, {})
    m_sig = methods.get(method_name)
    if m_sig is None:
        raise SyntaxError(
            f"il_codegen: record '{ta.dtype}' khong co method '{method_name}' "
            f"('{name}.{method_name}(...)' khong phai list.{method_name})")
    args = kwarg_resolve.resolve_call_args(m_sig.params, arg_nodes, f'{name}.{method_name}')
    n_required = 0
    for p in m_sig.params:
        if p.default_node < 0:
            n_required = n_required + 1
    if not (n_required <= len(args) <= len(m_sig.params)):
        raise SyntaxError(
            f"il_codegen: goi '{name}.{method_name}(...)' voi {len(args)} tham so "
            f"nhung method can {n_required}-{len(m_sig.params)} tham so")
    is_static = m_sig.is_static
    if not is_static:
        ctx.load_var_ref(name, scope, body)
    for arg_node, p in zip(args, m_sig.params):
        ctx.compile_expr(arg_node, scope, body,
                         value_dtype_spec_for_ta(p.type_ann, arg_node), ctx)
    for p in m_sig.params[len(args):]:
        ctx.compile_expr(p.default_node, scope, body,
                         value_dtype_spec_for_ta(p.type_ann, p.default_node), ctx)
    if m_sig.return_type is not None:
        ret_il = ctx.il_type_str(m_sig.return_type, None)
    else:
        ret_il = 'void'
    sep = ', '
    _ps = []
    for p in m_sig.params:
        _ps.append(ctx.il_type_str(p.type_ann, None))
    params_il = sep.join(_ps)
    if is_static:
        call_op = 'call'
    else:
        call_op = 'callvirt'
    if is_static:
        call_kind = ''
    else:
        call_kind = 'instance '
    qname = chr(39) + method_name + chr(39)
    body.append(f'    {call_op} {call_kind}{ret_il} {ta.dtype}::{qname}({params_il})')
    if m_sig.return_type is not None:
        body.append('    pop')
    return 1


def codegen_list_append(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'lst.append(x)' (x co the la 1 bien container
    khac khi lst la List long nhau, Wave 2 2026-07-29)."""
    if _record_stmt_fallback(lay_str(stmt, 'name'), 'append', [lay_nut(stmt, 'value_node')], scope, body, ctx):
        return
    ta = scope.tra(lay_str(stmt, 'name')).ta
    ctx.load_var_ref(lay_str(stmt, 'name'), scope, body)
    if ta.elem_ta is not None and ta.elem_ta.shape_ten == 'func':
        # P5 (2026-09-07): 'fns.append(add_ten)' voi fns la
        # list[func(...)->...] - gia tri la FUNCREF, phai sinh 'ldftn' qua
        # compile_funcref_arg; duong compile_expr thuong coi 'add_ten' la
        # TEN BIEN va bao 'chua duoc khai bao'.
        ctx.compile_funcref_arg(lay_nut(stmt, 'value_node'), ta.elem_ta, scope,
                                    body, ctx)
    elif (ta.elem_ta is not None and ta.elem_ta.shape_ten == 'tuple'
          and ekind(lay_nut(stmt, 'value_node')) == 'tuple_lit'):
        # 'lst.append((a, b))' (2026-09-25): kieu tung phan tu lay tu KHAI BAO
        # cua danh sach, khong doan tu gia tri.
        compile_tuple_lit_theo_ta(lay_nut(stmt, 'value_node'), ta.elem_ta, scope, body, ctx)
    else:
        ctx.compile_expr(lay_nut(stmt, 'value_node'), scope, body,
                            _append_value_dtype_spec(ta, lay_nut(stmt, 'value_node')), ctx)
    body.append(f'    callvirt instance void {ctx.il_type_str(ta, ctx.records)}::Add(!0)')


def compile_tuple_lit_theo_ta(node: "TkvNode", tuple_ta: "TypeAnn", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """'(a, b, ...)' voi kieu tuple DA BIET (tuple_ta.shape_ten == 'tuple'):
    moi phan tu dich theo dtype khai bao, roi newobj ValueTuple."""
    phan = ea_ds(node)
    dts = tuple_ta.tuple_dtypes
    if dts is None or len(dts) != len(phan):
        raise SyntaxError(
            f"il_codegen: tuple {len(phan)} phan tu khong khop kieu tuple khai bao "
            f"({'' if dts is None else ', '.join(dts)})")
    for i in range(len(phan)):
        ctx.compile_expr(phan[i], scope, out, dts[i], ctx)
    kieu = _tt.il_tupleN_type(dts, tuple_ta.tuple_tas, ctx.records, ctx.il_type_str)
    ts = []
    for i in range(len(dts)):
        ts.append('!' + str(i))
    out.append(f'    newobj instance void {kieu}::.ctor({", ".join(ts)})')


def compile_theo_ta(node: "TkvNode", ta: "TypeAnn", dtype: "str", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """Bieu thuc dich theo TypeAnn DAY DU khi biet (2026-09-26): list-literal
    cua tuple '[(a, b), ...]' -> newobj List<ValueTuple> + Add tung phan tu
    (duong list-literal chung chi biet dtype vo huong). Con lai: compile_expr."""
    if (ta is not None and ta.shape_ten == 'list' and ta.elem_ta is not None
            and ta.elem_ta.shape_ten == 'tuple' and ekind(node) == 'list_literal'):
        kieu_ds = ctx.il_type_str(ta, ctx.records)
        out.append(f'    newobj instance void {kieu_ds}::.ctor()')
        for el in ea_ds(node):
            out.append('    dup')
            if ekind(el) == 'tuple_lit':
                compile_tuple_lit_theo_ta(el, ta.elem_ta, scope, out, ctx)
            else:
                ctx.compile_expr(el, scope, out, ta.elem_ta.dtype, ctx)
            out.append(f'    callvirt instance void {kieu_ds}::Add(!0)')
        return
    if (ta is not None and ta.shape_ten == 'list' and ta.elem_ta is not None
            and ta.elem_ta.shape_ten in ('list', 'dict', 'set')
            and ekind(node) == 'list_literal' and len(ea_ds(node)) > 0):
        # '[[a, b], [c]]' theo kieu list[list[T]] DA BIET (2026-09-29), vd phan tu cua
        # 'return s, [[...], [...]]': truoc day dung List<T> phang -> ArrayTypeMismatch luc chay
        kieu_ds = ctx.il_type_str(ta, ctx.records)
        out.append(f'    newobj instance void {kieu_ds}::.ctor()')
        for el in ea_ds(node):
            out.append('    dup')
            compile_theo_ta(el, ta.elem_ta, ta.elem_ta.dtype, scope, out, ctx)
            out.append(f'    callvirt instance void {kieu_ds}::Add(!0)')
        return
    if (ta is not None and ta.shape_ten in ('list', 'dict', 'set')
            and (ekind(node) == 'dict_rong'
                 or (ekind(node) == 'list_literal' and len(ea_ds(node)) == 0)
                 or (ekind(node) == 'call' and ea_str(node) in ('set', 'dict', 'list')
                     and len(eb_ds(node)) == 0))):
        # 'return {}' / 'return []' / 'return set()' (2026-09-26): container
        # RONG theo kieu tra ve da khai
        out.append(f'    newobj instance void {ctx.il_type_str(ta, ctx.records)}::.ctor()')
        return
    if ta is not None and ta.shape_ten == 'tuple' and ekind(node) == 'tuple_lit':
        # 'return (a, b)' (2026-09-26): tuple trong ngoac theo kieu tra ve
        compile_tuple_lit_theo_ta(node, ta, scope, out, ctx)
        return
    if ta is not None and ta.shape_ten == 'dict' and ekind(node) == 'dict_lit':
        # '{k: v, ...}' theo kieu dict DA BIET (2026-09-26)
        kieu_d = ctx.il_type_str(ta, ctx.records)
        out.append(f'    newobj instance void {kieu_d}::.ctor()')
        cap = ea_ds(node)
        i = 0
        while i + 1 < len(cap):
            out.append('    dup')
            ctx.compile_expr(cap[i], scope, out, ta.key_dtype, ctx)
            if ta.elem_ta is not None:
                compile_theo_ta(cap[i + 1], ta.elem_ta, ta.elem_ta.dtype, scope, out, ctx)
            else:
                ctx.compile_expr(cap[i + 1], scope, out, ta.dtype, ctx)
            out.append(f'    callvirt instance void {kieu_d}::set_Item(!0, !1)')
            i = i + 2
        return
    ctx.compile_expr(node, scope, out, dtype, ctx)


def codegen_expr_dict_lit(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    print("NL_DICT " + str(dtype))
    """EXPR_CODEGEN entry: '{"a": 1}' o VI TRI BIEU THUC (2026-10-11, literal
    long nhau) - giong het codegen_expr_list_literal nhung cho dict.

    THIEU nhanh nay la 1 trong 2 nguyen nhan doc lap cua
    tests/nested_literal_test: node 'dict_lit' chi co 1 duong xu ly -
    `d = {...}` (macro `try_expand_dict_literal` ben tang TEXT). No khong duoc
    dang ky trong EXPR_CODEGEN nen khi xuat hien LONG trong 1 bieu thuc khac
    (la gia tri cua dict/list khac, vi du `ld = [{"a": 1}]`) `_compile_expr`
    nem loi ro rang.

    GIA TRI DUNG o day KHAC duong gan: duong gan giu ket qua tren stack roi
    `store_var` gan vao bien; ham nay GIU NGUYEN tren stack de caller dung
    tiep (giong khoi `dup/.../pop` cua codegen_assign_dict_literal -
    `newobj` + `dup` + set_Item + `dup` nen ket qua cuoi cung van dung 1 ban).

    `dtype` la NGU CANH (chuoi spec 'dict[K,V]' hoac dtype cua phan tu) -
    xuat phat tu cung quy uoc voi moi entry EXPR_CODEGEN khac. KHOA luon
    suy tu noi dung literal, KHONG bao gio lay tu `dtype` khi `dtype` chi la
    1 dtype vo huong: voi dict, `dtype` chi la dtype cua GIA TRI. Ly do
    xem ghi chu cùng tên trong ban Python (dict_type.tkv)."""
    pairs = ea_ds(node)
    key_spec, val_spec = dict_literal_spec_of(pairs, scope, nguon_kieu_ctx(ctx))
    k_ind, inner = _split_container_spec(dtype)
    if k_ind == 'dict':
        kv = inner.split(',', 1)
        if len(kv) == 2:
            key_spec = kv[0].strip()
            val_spec = kv[1].strip()
    elif k_ind == 'list':
        val_spec = inner
    elif dtype is not None:
        val_spec = dtype
    if key_spec is None or val_spec is None:
        raise SyntaxError(
            "il_codegen: khong suy duoc kieu KHOA/GIA TRI cho dict-literal o vi tri "
            "bieu thuc (khong co ngu canh kieu tu noi dung, va noi dung vuot pham vi "
            "suy kieu) - gan ra 1 bien co khai bao kieu truoc.")
    dict_il = il_container_type_of_spec(f'dict[{key_spec}, {val_spec}]', ctx.records,
                                        il_extern_dtype._EXTERN_CLASS_DEFS)
    out.append(f'    newobj instance void {dict_il}::.ctor()')
    for i in range(0, len(pairs) - 1, 2):
        out.append('    dup')
        ctx.compile_expr(pairs[i], scope, out, key_spec, ctx)
        ctx.compile_expr(pairs[i + 1], scope, out, val_spec, ctx)
        out.append(f'    callvirt instance void {dict_il}::set_Item(!0, !1)')


def codegen_expr_set_lit(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """EXPR_CODEGEN entry: '{1, 2}' o VI TRI BIEU THUC (2026-10-11).

    Node 'set_lit' (xem il_core.tkv, noi parse `{` ma khong co `:`). Duong GAN
    `s = {1, 2}` van di qua macro VAN BAN `try_expand_set_literal`
    (comprehension.tkv) - macro do giu nguyen kieu phan tu cho
    `set_iteration_test` (set[i64]); nhanh nay phuc vu set LONG NHAU trong 1
    literal khac, vi du `[{1,2},{3,4}]` va `{"k": {1,2}}`."""
    elements = ea_ds(node)
    k_ind, inner = _split_container_spec(dtype)
    if k_ind == 'set':
        elem_spec = inner
    elif k_ind == 'list':
        elem_spec = inner
    elif dtype is not None:
        elem_spec = dtype
    else:
        elem_spec = list_literal_elem_spec(elements, scope, nguon_kieu_ctx(ctx))
    if elem_spec is None:
        raise SyntaxError(
            "il_codegen: khong suy duoc dtype PHAN TU cho set-literal o vi tri "
            "bieu thuc (khong co ngu canh kieu tu noi dung, va noi dung vuot pham vi "
            "suy kieu) - gan ra 1 bien co khai bao kieu truoc.")
    set_il = il_container_type_of_spec(f'set[{elem_spec}]', ctx.records,
                                       il_extern_dtype._EXTERN_CLASS_DEFS)
    out.append(f'    newobj instance void {set_il}::.ctor()')
    for el in elements:
        out.append('    dup')
        ctx.compile_expr(el, scope, out, elem_spec, ctx)
        # HashSet<T>.Add tra BOOL (khac List<T>.Add tra void) - phai `pop` sau
        # moi khi giu duoc set tren stack cho caller (xem codegen_set_add).
        out.append(f'    callvirt instance bool {set_il}::Add(!0)')
        out.append('    pop')


def codegen_expr_tuple_lit(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'(a, b)' o vi tri bieu thuc chua biet kieu tuple: bao loi RO thay vi
    doan kieu phan tu (2026-09-25)."""
    raise SyntaxError(
        "il_codegen: tuple '(a, b, ...)' lam bieu thuc hien chi ho tro khi them vao "
        "danh sach da khai kieu list[(...)] ('lst.append((a, b))'), hoac 'return a, b'")


def ta_tu_spec(spec: "str") -> "TypeAnn":
    """NGUOC cua `ta_list_spec`: TypeAnn DAY DU cho 1 chuoi shape.

    Giu quy uoc 'dtype = dtype LEAF cuoi cung, elem_ta = TypeAnn cua 1 tang
    trong' ma `declare_list_literal` dung cho list long nhau. `dict[K,V]` lay
    `key_dtype` tu V, va `elem_ta` la TypeAnn cua GIA TRI (khong phai cua cap
    khoa-gia tri).

    KHONG dat sentinel '__nested__' vao `dtype` ma dung chinh dtype LEAF: phan
    con lai cua compiler so sanh `ta.dtype` voi chuoi dtype that (vd khi
    gan value vao container, hay khi truyen doi so) - sentinel se lam lech o
    do va bao loi o noi lam, khong phai noi sinh ra. Python: xem
    `ta_from_spec` trong list_type.tkv (ban Python)."""
    kind, inner = _split_container_spec(spec)
    if kind == 'list':
        ta_in = ta_tu_spec(inner)
        return TypeAnn(ta_in.dtype, 'list', elem_ta=ta_in)
    if kind == 'set':
        ta_in = ta_tu_spec(inner)
        return TypeAnn(ta_in.dtype, 'set', elem_ta=ta_in)
    if kind == 'dict':
        kv = inner.split(',', 1)
        if len(kv) == 2:
            key_spec = kv[0].strip()
            ta_in = ta_tu_spec(kv[1].strip())
            return TypeAnn(ta_in.dtype, 'dict', key_dtype=key_spec, elem_ta=ta_in)
    return TypeAnn(spec, None)


def _append_value_dtype_spec(ta: "TypeAnn", value_node: "TkvNode") -> "str":
    """dtype NGU CANH truyen xuong cho GIA TRI duoc Add vao List<T> cua
    `ta`. Voi list THUONG day la ta.dtype (giu nguyen hanh vi cu). Voi
    list LONG NHAU (ta.elem_ta.shape_ten == 'list', vd 'm = [[1,2],[3,4]]' ->
    ta = TypeAnn('i32','list',elem_ta=TypeAnn('i32','list'))) va gia tri
    dang Add LA 1 list-literal, ta.dtype ('i32') MO TA SAI gia tri do
    (no la 1 List<int32>, khong phai 1 int32) - tra ve chuoi MANG SHAPE
    'list[i32]' theo dung quy uoc "dtype co the la chuoi mang shape" da
    dung o il_codegen.py's _il_ctor_param_type (Task 2/Phase 7).

    CHI ap dung cho value_node la 'list_literal' (thu hep pham vi anh
    huong): khi gia tri la 1 BIEN container da khai bao, duong cu
    (ta.dtype) van dung - _expr_var khong hieu chuoi mang shape.

    Round 3 (2026-08-19): than ham nay TRUOC day tu tinh
    f'list[{ta.elem_ta.dtype}]' - chi dung 2 TANG, LECH voi ta_list_spec
    (de quy moi tang). Nay UY QUYEN cho ta_list_spec de chi con 1 NGUON
    SU THAT duy nhat cho "TypeAnn -> chuoi shape-string" (chong tai dien
    lop loi nay lan thu 4)."""
    if (value_node and ekind(value_node) == 'list_literal'
            and ta.elem_ta is not None and ta.elem_ta.shape_ten == 'list'):
        return ta_elem_spec(ta)
    return ta.dtype


def ta_to_spec(ta: "TypeAnn") -> "str":
    """Chuoi spec cua 1 TypeAnn - nguoc cua `ta_tu_spec`, va la nguon cho
    `dtype` NGU CANH khi bien dich 1 literal long nhau o VI TRI BIEU THUC
    (xem `_append_value_dtype_spec`/`value_dtype_spec_for_ta`).

    DE QUY vao `elem_ta` chu KHONG tin `ta.dtype`: 2 noi khai bao container
    long nhau dat `dtype` KHAC NHAU (`declare_dict` dat sentinel '__nested__',
    `declare_list_literal` dat dtype leaf) - de quy vao elem_ta cho ca 2 ra
    cung ket qua, nen khong phai dong y nhau ve sentinel (chinh la nguon cua
    'nhieu noi lam 1 viec' o muc F cua docs/BUGS_TODO.md).

    Thay the `ta_list_spec` (chi 2 tang, chi 'list[') - ham do SAI khi phan
    tu la dict/set: `list[dict[str,int32]]` ra `list[int32]`, bien dich xong
    nhung ghi sai kieu vao `List<Dictionary<..>>` roi
    `AccessViolationException` luc chay. Python: xem `ta_to_spec` trong
    list_type.tkv (ban Python)."""

    if ta is None:
        return None
    inner = ta_to_spec(ta.elem_ta) if ta.elem_ta is not None else ta.dtype
    if ta.shape_ten == 'dict':
        return f'dict[{ta.key_dtype}, {inner}]'
    if ta.shape_ten == 'list' or ta.shape_ten == 'set' or ta.shape_ten == 'frozenset':
        return f'{ta.shape_ten}[{inner}]'
    return ta.dtype


def ta_elem_spec(ta: "TypeAnn") -> "str":
    """Spec cua MOT PHAN TU/GIA TRI cua container `ta` - KHAC `ta_to_spec`
    (tra ve ca container) va `ta.dtype` (mat tang long nhau). Day la cai ma
    1 caller truyen xuong `compile_expr` cho CAI GIA TRI dang them vao 1
    container, nen 'dict[str,i32]' phai boc ra thanh 'i32' truoc khi con lai
    no la context dtype cho 1 literal long nhau ben trong."""
    if ta.elem_ta is not None:
        return ta_to_spec(ta.elem_ta)
    return ta.dtype


def ta_list_spec(ta: "TypeAnn") -> "str":
    """Chuoi dtype MANG SHAPE ('list[i32]', 'list[list[i32]]') tu 1 TypeAnn
    day du co shape=='list' - KHONG con dung o noi bien dich (chi con lai
    cho goi cu, xem `ta_to_spec` là nguon su that duy nhat)."""
    return ta_to_spec(ta)


def value_dtype_spec_for_ta(ta: "TypeAnn", value_node: "TkvNode") -> "str":
    """dtype NGU CANH truyen xuong cho 1 GIA TRI (doi so ham/gia tri
    return/tham so method) co kieu khai bao `ta`.

    Critical round 2 (2026-08-19): cac diem goi _compile_expr cho doi so/
    return truoc day dung `ta.dtype` PHANG - voi 'list[list[i32]]' thi
    ta.dtype chi la 'i32', MAT lop long nhau, khien
    codegen_expr_list_literal sinh 'newobj List<int32>' thay vi
    'List<List<int32>>' (AccessViolationException/NullReferenceException
    luc chay). Tra ve chuoi mang shape trong DUNG truong hop do.

    Pham vi HEP co y (chi list-literal long nhau): voi cac gia tri khac
    (bien, loi goi ham...) duong cu `ta.dtype` van dung - _expr_var va
    dong doi KHONG hieu chuoi mang shape."""
    if ta is None:
        return None
    # (2026-10-11) bo dieu kien 'cha la list' va chuyen sang `ta_to_spec` -
    # 1 nguon su that duy nhat cho ca 2 noi, giong ban Python. Nhanh
    # container DAY DU (thay vi `ta.dtype`) rat quan trong cho DICT: `dtype`
    # cua 1 TypeAnn shape='dict' chi la dtype cua GIA TRI, KHONG co khoa - neu
    # truyen no xuong cho 1 dict-literal thi khoa se bi suy sai (thuong la
    # 'i32' thay vi 'str') va `d[k]` luc chay se doc nho RAM
    # (AccessViolationException trong Dictionary::FindEntry).
    if (ta.shape_ten == 'list' or ta.shape_ten == 'dict' or ta.shape_ten == 'set'
            or ta.shape_ten == 'frozenset'):
        if ta.elem_ta is not None:
            return ta_to_spec(ta)
        if value_node is not None and la_node(value_node):
            k = ekind(value_node)
            if k == 'list_literal' or k == 'dict_lit' or k == 'set_lit':
                return ta_to_spec(ta)
    return ta.dtype


def _il_list_of(elem_spec: "str", records: "dict[str,list[(str,TkvTypeAnn)]]"=None, extern_class_defs: "dict[str,i32]"=None) -> "str":
    """Chuoi IL cua 1 List<elem_spec>. THIN WRAPPER quanh
    il_container_type_of_spec (muc F, docs/BUGS_TODO.md - hop nhat 2
    implementation trung lap). `extern_class_defs` THEM MOI (Task 1's
    investigation, task-1-report.md gia thuyet 1): TRUOC day ham nay
    KHONG nhan tham so nay, khien list-literal LONG NHAU chua phan tu
    extern-class (vd 'grid = [[a, b]]' voi a,b la handle-type) build FAIL
    - 'SyntaxError: List phan tu kieu Sb khong hop le' - du list[T] PHANG
    cung loai T da build duoc tu lau qua duong ctor/method (bat nhat).
    Ham nay boc them 1 lop 'List<...>' NGOAI CUNG so voi
    il_container_type_of_spec(elem_spec, ...) truc tiep - vi elem_spec o
    day la kieu PHAN TU (khong bao gom 'list[' ngoai cung nhu spec day
    du)."""
    inner = il_container_type_of_spec(elem_spec, records, extern_class_defs)
    return f'class [mscorlib]System.Collections.Generic.List`1<{inner}>'


def _literal_dtype_fallback(el: "TkvNode") -> "str":
    """dtype doan tu CU PHAP hang so truc tiep - luoi cuoi cung khi ctx
    KHONG co ctx['infer_literal_dtype'] (khoa nay CHI co trong walk_ctx
    cua first-pass, khong co trong ctx giai doan codegen)."""
    if la_node(el) and ekind(el) == 'num':
        return 'f64' if '.' in ea_str(el) or 'e' in ea_str(el).lower() else 'i32'
    if la_node(el) and ekind(el) == 'str_lit':
        return 'str'
    return None


class NguonKieu:
    """6 truong suy kieu phan tu list-literal can - CHUNG cho Ctx (codegen) va
    WalkCtx (first-pass), hai lop KHAC nhau cung mang cac truong nay
    (2026-09-25: truoc day ham nhan thang `ctx` luc la Ctx luc la WalkCtx - ban
    tu-host doc truong theo bo cuc SAI LOP)."""
    infer_dtype: "func(TkvNode, Scope, dict[str,TkvSig], TkvTable, TkvTable, TkvTable)->str"
    func_table: "dict[str,TkvSig]"
    records: "dict[str,list[(str,TkvTypeAnn)]]"
    record_methods: "dict[str,dict[str,Signature]]"
    record_bases: "dict[str,list[str]]"
    # `co_infer_literal` = 1 chi o PASS 1 (WalkCtx co `infer_literal_dtype`).
    # Dung CO HIEU thay vi `infer_literal_dtype is not None`: ham kieu
    # `func` so sanh voi None khong phai kieu ma trinh bien dich tu-host
    # chap nhan (xem ghi chu tuong tu o `_reverse_node_check`).
    infer_literal_dtype: "func(TkvNode)->str"
    co_infer_literal: "i32"

    def __init__(self, infer_dtype: "func(TkvNode, Scope, dict[str,TkvSig], TkvTable, TkvTable, TkvTable)->str",
                 func_table: "dict[str,TkvSig]", records: "dict[str,list[(str,TkvTypeAnn)]]",
                 record_methods: "dict[str,dict[str,Signature]]", record_bases: "dict[str,list[str]]",
                 infer_literal_dtype: "func(TkvNode)->str", co_infer_literal: "i32"):
        self.infer_dtype = infer_dtype
        self.func_table = func_table
        self.records = records
        self.record_methods = record_methods
        self.record_bases = record_bases
        self.infer_literal_dtype = infer_literal_dtype
        self.co_infer_literal = co_infer_literal


def _infer_literal_khong_co(node: "TkvNode") -> "str":
    """Ham stub cho pass 2 - `Ctx` khong co `infer_literal_dtype`. KHONG
    bao gio duoc goi (gu `co_infer_literal`); ton tai chi vi tham so kieu
    'func' khong chap nhan `None` lam doi so."""
    return None



def nguon_kieu_ctx(ctx: "Ctx") -> "NguonKieu":
    # Pass 2: `Ctx` KHONG co truong `infer_literal_dtype` -> co = 0.
    return NguonKieu(ctx.infer_dtype, ctx.func_table or {}, ctx.records or {},
                     ctx.record_methods or {}, ctx.record_bases or {},
                     _infer_literal_khong_co, 0)


def nguon_kieu_walk(ctx: "WalkCtx") -> "NguonKieu":
    # Pass 1: WalkCtx CO `infer_literal_dtype` (il_dispatch.WalkCtx) - day
    # la nhanh quyet dinh `[3, 1, 2]` la `list[int]` chu khong phai
    # `list[i32]` (xem `list_literal_elem_spec_of`).
    return NguonKieu(ctx.infer_dtype, ctx.func_table or {}, ctx.records or {},
                     ctx.record_methods or {}, ctx.record_bases or {},
                     ctx.infer_literal_dtype, 1)


def list_literal_elem_spec_of(el: "TkvNode", infer_scope: "Scope", nk: "NguonKieu") -> "str":
    """dtype (spec) cua MOT phan tu list-literal - NGUON SU THAT DUY NHAT,
    dung CHUNG boi declare_list_literal (first-pass) VA
    codegen_expr_list_literal (codegen). Truoc 2026-08-19 (final review C1)
    day la 2 duong suy kieu KHAC nhau trong CUNG 1 tinh nang, gay IL sai
    am tham. Tra ve chuoi vo huong, hoac 'list[T]' khi phan tu lai la 1
    list-literal long nhau. Cac khoa ctx chi co o first-pass
    (infer_literal_dtype/contains_float_literal/int_dtypes) duoc doc bang
    .get() + fallback de ham chay duoc o CA HAI giai doan."""
    if ekind(el) == 'list_literal':
        inner = list_literal_elem_spec(ea_ds(el), infer_scope, nk)
        return f'list[{inner}]' if inner is not None else None
    if ekind(el) == 'set_lit':
        # (2026-10-11) tap literal long nhau: '{[1,2],[3,4]}' -> 'set[list[i32]]'.
        inner = list_literal_elem_spec(ea_ds(el), infer_scope, nk)
        return f'set[{inner}]' if inner is not None else None
    if ekind(el) == 'dict_lit':
        # (2026-10-11) dict literal long nhau: '[{"a":1}]' -> 'dict[str,i32]'.
        print("NL_ELEM_DICT " + str(len(ea_ds(el))))
        kspec, vspec = dict_literal_spec_of(ea_ds(el), infer_scope, nk)
        print("NL_ELEM_DICT2 " + str(kspec) + "|" + str(vspec))
        if kspec is None or vspec is None:
            return None
        return f'dict[{kspec},{vspec}]'
    if ekind(el) == 'binop' and ea_str(el) == '*':
        # '[0] * n' / 'row * n' la phan tu list (2026-09-30): spec 'list[T]' nhu literal long nhau
        _lap_ta = _ta_list_lap(el, nk.func_table, infer_scope)
        if _lap_ta is not None and _lap_ta.elem_ta is None:
            return 'list[' + _lap_ta.dtype + ']'
    try:
        d = nk.infer_dtype(el, infer_scope, nk.func_table, nk.records, nk.record_methods, None)
    except (KeyError, SyntaxError):
        d = None
    # Nhanh `infer_literal_dtype` (2026-10-10, Khoi phuc):
    # comment "Bo hai nhanh CHET" ben duoi (2026-09-25) dung khi code con
    # la PYTHON bo kha nho thi `ctx` la dict CPython va `ctx.get(...)` lam
    # vo hieu hoa `infer_literal_dtype`. Trong ban tu-host `ctx` la OBJECT
    # (`WalkCtx`) va truong do CO THAT - bo nhanh nay ngam say "so nguyen
    # trong list-literal" xuong 'i32'.
    #
    # HAQ QUANG: `xs = [3, 1, 2]` khai List<int32> thay vi List<TkvInt>.
    # Moi noi doc dtype phan tu cua `xs` roi so sanh chu ky se lech - vi du
    # `sorted(xs, key=f)` bao "chu ky key ((int) -> int) khong khop dtype
    # phan tu cua list (i32)". Bootstrap Python tra 'int' o day.
    if d is None and nk.co_infer_literal == 1:
        d = nk.infer_literal_dtype(el)
    # NHANH `contains_float_literal` (int-family -> 'f32') van CHUA dua
    # lai: no gan 'f32' trong khi phan con lai cua compiler (va
    # `_literal_dtype_fallback` ben duoi) dung 'f64' cho so thuc. Dua no
    # ve se tao list[float32] cho `[1, 2.5]` - lech voi phan con lai. Sua
    # rieng cho nhanh do can mot phien rieng.
    if d is None:
        d = _literal_dtype_fallback(el)
    return d


def _chuoi_to_tien(record_bases: "dict[str,list[str]]", ten: "str") -> "list[str]":
    """Chuoi to tien GAN TRUOC: [ten, base, base-cua-base, ...].

    NO DA BIET: vong lap nay la BAN THU BA - `duck_typing._ancestors` va
    `operators.compile_binop` deu lap lai no (xem docstring cua _ancestors).
    Ban do tra ve TAP, con cho nay can THU TU de lay to tien GAN NHAT. Gom ba
    ban lam mot la tai cau truc code khong lien quan -> ghi vao
    docs/BUGS_TODO.md thay vi tu lam.

    GIOI HAN GIU NGUYEN nhu hai ban kia: `record_bases[x]` co the la mot LIST
    khi record co nhieu base (xem _extract_record_def) - luc do vong lap dung
    lai. Da ke thua GIUA NHIEU RECORD von khong duoc CLR ho tro (1 base class
    that), nen day khong phai thieu sot moi."""
    chuoi = [ten]
    walk = ten
    while len(cac_base(record_bases, walk)) == 1:
        walk = cac_base(record_bases, walk)[0]
        chuoi.append(walk)
    return chuoi


def _to_tien_chung(record_bases: "dict[str,list[str]]", a: "str", b: "str") -> "str":
    """To tien chung GAN NHAT cua hai record; None neu khong co."""
    if a == b:
        return a
    tap_b = set(_chuoi_to_tien(record_bases, b))
    for x in _chuoi_to_tien(record_bases, a):
        if x in tap_b:
            return x
    return None


def _fold_elem(elem_dtype: "str", d: "str", records: "dict[str,list[(str,TkvTypeAnn)]]", record_bases: "dict[str,list[str]]") -> "str":
    """Gop dtype phan tu dang co voi phan tu ke tiep - MOT luat duy nhat.

    VI SAO CO HAM NAY (2026-09-10): luat fold TRUOC DAY co HAI BAN - mot o
    `list_literal_elem_spec`, mot o `declare_list_literal`. Docstring cua
    `list_literal_elem_spec_of` khang dinh no la "nguon su that duy nhat" ve
    suy kieu TUNG PHAN TU, nhung phep FOLD thi khong. Hau qua: sua luat o mot
    ban ma quen ban kia thi khong co gi bao - dung cach loi record-tron-lop-con
    song sot qua lan sua dau tien cua chinh no.

    Hai luat, theo thu tu:
      - widen ve float: [1, 2.0] la list[float] (giong Python that).
      - record tron lop con: lay TO TIEN CHUNG GAN NHAT; khong co -> bao loi
        RO LUC COMPILE thay vi de chet ArrayTypeMismatchException luc chay."""
    if elem_dtype is None:
        return d
    if elem_dtype not in ('f32', 'f64') and d in ('f32', 'f64'):
        return d
    if d != elem_dtype and d in records and elem_dtype in records:
        chung = _to_tien_chung(record_bases, elem_dtype, d)
        if chung is None:
            raise SyntaxError(
                "il_codegen: list tron cac record KHONG co to tien chung (%s va %s) - CIL can mot kieu phan tu duy nhat. Cho chung ke thua mot base chung, hoac tach thanh hai list."
                % (elem_dtype, d))
        return chung
    return elem_dtype


def _fold_spec_widen(cur: "str", d: "str") -> "str":
    """Widen ve float nhu Python (Python that: `[1, 2.0]` la `list[float]`).
    Dung chung cho ca phep gan list-literal va dict-literal nen 2 noi khong
    the tach nhamh 'float' mot noi khong - nguyen tac cua muc F
    (docs/BUGS_TODO.md): 1 noi, 1 su that."""
    if cur is None:
        return d
    if cur not in ('f32', 'f64') and d in ('f32', 'f64'):
        return d
    return cur


def dict_literal_spec_of(pairs: "list[TkvNode]", infer_scope: "Scope", nk: "NguonKieu") -> "(str,str)":
    """(key_spec, val_spec) cho 1 dict literal - suy THANG tu cac cap trong
    literal, khong can quet 'd[k] = v' sau do.

    Dat O DAY (list_type.tkv) chu khong phai trong dict_type.tkv vi
    `list_literal_elem_spec_of` - ham suy spec cua MOT phan tu, duoc goi boi
    ca 3 loai literal - can no o noi ma 3 duong do cung dung 1 ham (dong do
    voi muc F cua docs/BUGS_TODO.md: khong de 2 noi lam 1 viec).

    `pairs` la danh sach khoa/gia tri XEN KE (nhu node 'dict_lit')."""
    key_spec = None
    val_spec = None
    for i in range(0, len(pairs) - 1, 2):
        kspec = list_literal_elem_spec_of(pairs[i], infer_scope, nk)
        vspec = list_literal_elem_spec_of(pairs[i + 1], infer_scope, nk)
        key_spec = _fold_spec_widen(key_spec, kspec)
        val_spec = _fold_spec_widen(val_spec, vspec)
    return key_spec, val_spec


def list_literal_elem_spec(elements: "list[TkvNode]", infer_scope: "Scope", nk: "NguonKieu") -> "str":
    """dtype (spec) PHAN TU cua CA list-literal - fold quy tac widen ve
    float (Python that: [1, 2.0] la list[float]) tren
    list_literal_elem_spec_of. Xem docstring ham do ve ly do dung chung.

    RECORD TRON LOP CON (2026-09-10): truoc day fold nay giu PHAN TU DAU, nen
    `[Name(...), Num(...)]` ra `List<Name>` va `Add(Num)` chet
    `ArrayTypeMismatchException` LUC CHAY. Nay lay TO TIEN CHUNG GAN NHAT.
    Khong co to tien chung -> bao loi RO LUC COMPILE, khong de chet luc chay.

    Truoc thay doi nay, cung mot dong `[a, b]` chay hay chet con phu thuoc
    RANG BUOC TU XA: neu ve sau co ham nhan `ds: "list[Base]"` thi kieu phan
    tu duoc suy tu cho dung do va no chay; khong co thi chet. Do la loai bat
    ngo te nhat cho nguoi dung."""
    elem_dtype = None
    for el in elements:
        d = list_literal_elem_spec_of(el, infer_scope, nk)
        elem_dtype = _fold_elem(elem_dtype, d, nk.records, nk.record_bases)
    return elem_dtype


def codegen_expr_list_literal(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"=None):
    """EXPR_CODEGEN entry: '[3, 1, 2]' o VI TRI BIEU THUC (Phase 7 follow-up,
    2026-08-19, Gap 2) - KHAC codegen_assign_list_literal (statement-level,
    RHS truc tiep cua 1 phep gan): tag 'list_literal' truoc day CHI dang
    ky duoc xu ly o tang STATEMENT, chua co entry trong EXPR_CODEGEN nen
    khi no xuat hien LONG trong 1 bieu thuc khac (vi du: la 1 PHAN TU cua
    1 list-literal NGOAI, nhu 'grid = [[1, 2], [3, 4]]' - codegen_list_append
    goi ctx['compile_expr'] tren TUNG phan tu, va phan tu do LAI la 1
    'list_literal' khac) se nem SyntaxError "AST node khong ro".

    dtype NGU CANH (tham so `dtype`, do CALLER truyen xuong) la NGUON UU
    TIEN cho dtype phan tu - dung quy uoc chung cua MOI entry EXPR_CODEGEN
    (xem _compile_expr/_expr_call: doi so duoc compile voi
    p.type_ann.dtype, tuc voi 'def total(xs: "list[f64]")' thi dtype='f64'
    CHINH LA dtype phan tu ky vong). Sua final-review C1 (2026-08-19):
    truoc day ham BO QUA `dtype` va tu suy bang 1 duong suy kieu THU HAI
    -> 'total([1.5, 2.5])' dung List<float32> cho tham so List<float64>
    (in ra 8.0000019 thay vi 4.0), 'list[int]' (TkvInt) nem
    AccessViolationException, 'm = [[1,2],[3,4]]' nem
    ArrayTypeMismatchException.

    `dtype` co the la chuoi MANG SHAPE 'list[T]' (khi literal nay la 1
    PHAN TU cua 1 list-literal NGOAI, xem _append_value_dtype_spec) - khi
    do phan boc 'list[' cho ra dtype phan tu THAT cua literal nay, dung
    quy uoc cua il_codegen.py's _il_ctor_param_type.

    Khi dtype la None (khong co ngu canh), suy bang CHINH ham dung chung
    voi declare_list_literal (list_literal_elem_spec) - MOT nguon su that
    duy nhat, khong con 2 duong suy kieu lech nhau."""
    elements = ea_ds(node)
    if dtype is not None and isinstance(dtype, str) \
            and dtype.startswith('list[') and dtype.endswith(']'):
        elem_spec = dtype[len('list['):-1].strip()
    elif dtype is not None:
        elem_spec = dtype
    else:
        elem_spec = list_literal_elem_spec(elements, scope, nguon_kieu_ctx(ctx))
    if elem_spec is None:
        raise SyntaxError(
            "il_codegen: khong suy duoc dtype PHAN TU cho list-literal o vi tri "
            "bieu thuc (khong co ngu canh kieu tu noi dung, va noi dung vuot "
            "pham vi suy kieu) - gan ra 1 bien co khai bao kieu truoc.")
    # Sanity check (Minor 1, re-review round 2 2026-08-19): `dtype` NGU
    # CANH duoc TIN TUONG hoan toan o tren - neu no lech voi noi dung
    # literal that (vd '[1.5, 2.5]' o vi tri can 'list[i32]') thi IL sinh
    # ra sai va loi chi lo ra o tang toolchain tho ('ilasm.exe that bai').
    # Chan SOM truong hop de gap+de nhan biet nhat: phan tu la hang so
    # THUC nhung ngu canh doi kieu NGUYEN.
    if elem_spec in ('i32', 'i64', 'int'):
        for el in elements:
            if _literal_dtype_fallback(el) in ('f32', 'f64'):
                raise SyntaxError(
                    f"il_codegen: list-literal chua hang so thuc ({ea_str(el)!r}) nhung ngu "
                    f"canh doi kieu phan tu nguyen '{elem_spec}' - sua khai bao kieu "
                    f"(vd 'list[f64]') hoac dung hang so nguyen.")
    list_type = _il_list_of(elem_spec, (ctx.records if ctx is not None else None),
                             (ctx.extern_class_defs if ctx is not None else None))
    out.append(f'    newobj instance void {list_type}::.ctor()')
    for el in elements:
        out.append('    dup')
        ctx.compile_expr(el, scope, out, elem_spec, ctx)
        out.append(f'    callvirt instance void {list_type}::Add(!0)')


def _dtype_phan_tu_hang(e: "TkvNode", scope: "Scope") -> "str":
    """dtype vo huong cua 1 phan tu literal (so/chuoi/bien vo huong) - None neu khong suy duoc."""
    if not la_node(e):
        return None
    k = ekind(e)
    if k == 'num':
        if '.' in ea_str(e):
            return 'f64'
        return 'i32'
    if k == 'neg':
        return _dtype_phan_tu_hang(ea_nut(e), scope)
    if k == 'str_lit':
        return 'str'
    if k == 'var':
        try:
            ta = scope.tra(ea_str(e)).ta
        except (KeyError, SyntaxError):
            return None
        if ta is not None and ta.la_vo_huong():
            return ta.dtype
    return None


def _ta_ds_hang(node: "TkvNode", scope: "Scope") -> "TypeAnn":
    """TypeAnn list cua literal '[a, b, ...]' (phan tu dau quyet dinh dtype); None neu rong/khong suy duoc."""
    if not la_node(node) or ekind(node) != 'list_literal':
        return None
    es = ea_ds(node)
    if len(es) == 0:
        return None
    d = _dtype_phan_tu_hang(es[0], scope)
    if d is None:
        return None
    return TypeAnn(d, 'list')


def _ta_ds_mot_ben(ben: "TkvNode", func_table: "dict[str,TkvSig]", scope: "Scope") -> "TypeAnn":
    """TypeAnn list cua MOT toan hang '+'/'*' (bien / cat lat / loi goi ham / '+' long nhau), hoac None."""
    k = ekind(ben)
    if k == 'var' or k == 'slice':
        try:
            ta = scope.tra(ea_str(ben)).ta
        except (KeyError, SyntaxError):
            ta = None
        if ta is not None and ta.shape_ten == 'list':
            return ta
    elif k == 'call' and func_table and ea_str(ben) in func_table:
        rt = func_table[ea_str(ben)].return_type
        if rt is not None and rt.shape_ten == 'list':
            return rt
    elif k == 'binop' and ea_str(ben) == '+':
        return _ta_list_cong(ben, func_table, scope)
    return None


def _ta_list_cong(node: "TkvNode", func_table: "dict[str,TkvSig]", scope: "Scope") -> "TypeAnn":
    """TypeAnn list cua phep '+' hai list, hoac None."""
    for ben in (eb_nut(node), ec_nut(node)):
        ta = _ta_ds_mot_ben(ben, func_table, scope)
        if ta is not None:
            return ta
    return None


_SET_OPS_TOAN_TU: "dict[str, str]" = {'|': 'UnionWith', '&': 'IntersectWith', '-': 'ExceptWith', '^': 'SymmetricExceptWith'}


def ta_set_toan_tu(node: "TkvNode", scope: "Scope") -> "TypeAnn":
    """TypeAnn (shape 'set') cua 'a | b' / 'a & b' / 'a - b' / 'a ^ b' khi mot ben la BIEN set (2026-09-30); None neu khong."""
    k = ekind(node)
    if k == 'var':
        try:
            ta = scope.tra(ea_str(node)).ta
        except (KeyError, SyntaxError):
            return None
        if ta is not None and ta.shape_ten == 'set':
            return ta
        return None
    if k == 'binop' and ea_str(node) in _SET_OPS_TOAN_TU:
        t = ta_set_toan_tu(eb_nut(node), scope)
        if t is not None:
            return t
        return ta_set_toan_tu(ec_nut(node), scope)
    return None


def _ta_list_lap(node: "TkvNode", func_table: "dict[str,TkvSig]", scope: "Scope") -> "TypeAnn":
    """TypeAnn list cua 'ds * n' / 'n * ds' (lap list), ds la bien/literal/loi goi; None neu khong phai."""
    for ben in (eb_nut(node), ec_nut(node)):
        ta = _ta_ds_hang(ben, scope)
        if ta is None:
            ta = _ta_ds_mot_ben(ben, func_table, scope)
        if ta is not None:
            return ta
    return None


def find_first_append_dtype(stmts: "list[i32]", name: "str", infer_scope: "Scope", ctx: "WalkCtx", kind: "str"='list_append') -> "str":
    """Tim LAN GOI '.append(...)' (hoac '.add(...)' cho set, `kind=
    'set_add'`) DAU TIEN tren list/set `name` (duyet CA cay, ke ca long
    trong for/if/while) va suy dtype phan tu tu gia tri do - can THIET
    vi 'lst = []'/'s = set()' KHONG mang thong tin dtype (giu dung cu
    phap Python that, khong bia syntax rieng). Best-effort: neu gia tri
    tham chieu bien CHUA duoc khai bao (tham chieu xuoi hiem gap), tra
    ve None (caller se fallback ve body_dtype). Dung ctx['infer_dtype']/
    ctx['contains_float_literal']/ctx['int_dtypes'] (tiem tu core - xem
    _fpp_ctx trong il_codegen.py) vi suy dtype la logic core, KHONG the
    import truc tiep (circular import)."""
    func_table, records = ctx.func_table, ctx.records
    for stmt in stmts:
        if lay_str(stmt, 'kind') == kind and lay_str(stmt, 'name') == name:
            try:
                # record_methods (2026-08-03): thieu no thi
                # 'toks.append(lx.next_tok())' KHONG suy duoc kieu tra ve
                # cua method record -> roi ve body_dtype (vd 'str') ->
                # list bi khai bao List<string> trong khi THAT SU chua
                # record. Cung LOAI bug voi 2 ghi chu ben duoi.
                d = ctx.infer_dtype(lay_nut(stmt, 'value_node'), infer_scope, func_table, records,
                                       ctx.record_methods, None)
            except KeyError:
                return None
            # Bug that tim thay 2026-07-28 (giong het loai da vay cho
            # 'compare'/dict): '.append(i * 1.0)' voi 'i' la bien i32 va
            # '1.0' la hang so float LONG trong 1 binop - infer_dtype
            # short-circuit tren 'i' truoc, bo lo hang so float, khien
            # list bi khai bao List<i32> thay vi List<f32> -> codegen
            # sau do ep '1.0' thanh 'ldc.i4 1.0' (loi cu phap ILASM that).
            if d in ctx.int_dtypes and ctx.contains_float_literal(lay_nut(stmt, 'value_node')):
                d = 'f64'
            # Bug that KHAC tim thay 2026-07-29 (giong het loai da vay cho
            # dict-value, xem _infer_literal_dtype trong il_codegen.py):
            # '.append(1)' voi '1' la hang so KHONG dtype co dinh (infer_dtype
            # tra None co y) trong 1 HAM TRA VE 'str' (vd dumps_int_list()
            # -> "str") truoc day roi thang ve ctx['body_dtype']='str' ->
            # IL_LDC_OP['str'] KeyError luc codegen (khong co ma lenh 'ldc'
            # cho string). Thu doan CHINH cu phap hang so (co dau '.' hay
            # khong) TRUOC KHI roi vao body_dtype.
            return d or ctx.infer_literal_dtype(lay_nut(stmt, 'value_node'))
        for sub_key in ('body', 'else_body'):
            sub = lay_than(stmt, sub_key)
            if sub:
                found = find_first_append_dtype(sub, name, infer_scope, ctx, kind)
                if found:
                    return found
    return None


def _spec_elem_lit(vn: "TkvNode") -> "str":
    """dtype cua 1 phan tu LITERAL don (hang so / chuoi) theo dung quy tac
    cua `_literal_dtype_fallback` - None la node khong phai literal vong huong.

    Rieng cho `_spec_container_literal_of`: ham do duoc goi o ca 2 giai doan
    (first-pass va codegen) nen KHONG co `ctx` de dua vao `NguonKieu`; container
    literal long nhau trong thuc te co phan tu la hang so/chuoi nen du ham nay
    du (2026-10-11)."""
    if not la_node(vn):
        return None
    if ekind(vn) == 'num':
        s = ea_str(vn)
        return 'f64' if '.' in s or 'e' in s.lower() else 'int'
    if ekind(vn) == 'str_lit':
        return 'str'
    return None


def _spec_ds_lit(ds: "list[TkvNode]") -> "str":
    """dtype chung cua cac phan tu trong 1 danh sach literal (widen ve float
    nhu Python that: `[1, 2.0]` -> `f64`). '' neu khong suy duoc duoc.

    Phan tu la CONTAINER literal thi de quy sang `_spec_container_literal_of` -
    can cho `[{"n": 1}, {"n": 2}]` (long 3 cap)."""
    cur = None
    for el in ds:
        d = _spec_elem_lit(el)
        if d is None and la_node(el):
            k = ekind(el)
            if k == 'list_literal' or k == 'set_lit' or k == 'dict_lit':
                d = _spec_container_literal_of(el, None)
        if d is None:
            continue
        if cur is None or (cur not in ('f32', 'f64') and d in ('f32', 'f64')):
            cur = d
    return '' if cur is None else cur


def _spec_container_literal_of(vn: "TkvNode", infer_scope: "Scope") -> "str":
    """Shape-string cua 1 container LITERAL (`[..]`/`{k: v}`/`{a, b}`) -
    '' neu node khong phai literal container hoac co phan tu chua suy duoc."""
    k = ekind(vn)
    if k == 'list_literal':
        inner = _spec_ds_lit(ea_ds(vn))
        return f'list[{inner}]' if inner != '' else ''
    if k == 'set_lit':
        inner = _spec_ds_lit(ea_ds(vn))
        return f'set[{inner}]' if inner != '' else ''
    if k == 'dict_lit':
        caps = ea_ds(vn)
        ks = _spec_ds_lit([caps[i] for i in range(0, len(caps) - 1, 2)])
        vs = _spec_ds_lit([caps[i + 1] for i in range(0, len(caps) - 1, 2)])
        if ks == '' or vs == '':
            return ''
        return f'dict[{ks},{vs}]'
    return ''


def find_first_append_elem_ta(stmts: "list[i32]", name: "str", infer_scope: "Scope", kind: "str"='list_append') -> "TypeAnn":
    """Container long nhau (Wave 2, 2026-07-29): giong find_first_append_dtype
    nhung tra ve TypeAnn DAY DU cua gia tri append/add DAU TIEN, CHI khi
    gia tri do la 1 BIEN tham chieu THANG 1 container KHAC (list/dict) -
    dung de declare_list biet phan tu cua 'lst' co phai CHINH NO la 1
    List/Dict khac hay khong (khong the bieu dien bang 1 dtype string
    don nhu truong hop vo huong/record). Tra None khi khong tim thay HOAC
    gia tri DAU TIEN khong phai container (khi do find_first_append_dtype
    (goi RIENG, khong o day) xu ly truong hop vo huong/record nhu cu).

    GIOI HAN THU TU DA BIET (xac nhan qua test that): bien duoc THAM
    CHIEU (vd 'inner' trong 'outer.append(inner)') PHAI duoc khai bao
    ('inner = []'/'inner = {}') o dong VAN BAN dung TRUOC dong khai bao
    'outer' - vi infer_scope duoc dien DAN theo thu tu WALK (khong phai
    lookahead toan cuc du ham nay tu no CO quet ca cay `stmts`), giong
    het gioi han da ghi nhan cho dtype khoa cua dict (xem STATUS.md).
    Sai thu tu se khien 'outer' bi suy NHAM thanh list vo huong (KHONG
    bao loi im lang - loi ro rang se lo ra sau o _expr_index khi doc lai
    phan tu, xem il_codegen.py)."""
    for stmt in stmts:
        if lay_str(stmt, 'kind') == kind and lay_str(stmt, 'name') == name:
            vn = lay_nut(stmt, 'value_node')
            if ekind(vn) == 'binop' and ea_str(vn) == '*':
                # 'g.append([0] * n)' / 'g.append(row * n)' (2026-09-30): phan tu la list moi
                _lap_ta = _ta_list_lap(vn, None, infer_scope)
                if _lap_ta is not None:
                    return _lap_ta
            if ekind(vn) == 'var':
                try:
                    var_ta = infer_scope.tra(ea_str(vn)).ta
                except KeyError:
                    return None
                # 'tuple' (2026-09-28): '[fd for fd in <list tuple>]' -> list tuple;
                # truoc day chi con dtype nen 'for a, b in <ket qua>' doc sai.
                if var_ta.shape_ten in ('list', 'dict', 'tuple'):
                    return var_ta
            # (2026-10-11) gia tri la CONTAINER LITERAL chu bien dich, vd
            # `ss.add([1, 2])` (HashSet<List<T>>) hoac `ls.append({"a": 1})`
            # (List<Dict<K,V>>) - phai TypeAnn DAY DU chu khong phai dtype
            # LEAF, nen dung `list_literal_elem_spec` de suy roi boc bang
            # `ta_tu_spec`.
            if ekind(vn) == 'list_literal' or ekind(vn) == 'set_lit' or ekind(vn) == 'dict_lit':
                spec = _spec_container_literal_of(vn, infer_scope)
                if spec != '':
                    return ta_tu_spec(spec)
            return None
        for sub_key in ('body', 'else_body'):
            sub = lay_than(stmt, sub_key)
            if sub:
                found = find_first_append_elem_ta(sub, name, infer_scope, kind)
                if found is not None:
                    return found
    return None


def _params_of_call(call_node: "TkvNode", ctx: "WalkCtx") -> "list[Param]":
    """Danh sach Param cua ham/method ma 'call_node' goi toi (None neu
    khong tra cuu duoc)."""
    func_table = ctx.func_table or {}
    if ekind(call_node) == 'call':
        sig = func_table.get(ea_str(call_node))
        return sig.params if sig is not None else None
    if ekind(call_node) == 'method_call':
        record_methods = ctx.record_methods or {}
        try:
            obj_ta = ctx.infer_scope.tra(ea_str(call_node)).ta
        except KeyError:
            return None
        methods = record_methods.get(obj_ta.dtype) or {}
        sig = methods.get(eb_str(call_node))
        return sig.params if sig is not None else None
    return None


def _scan_nodes_for_arg_use(node: "TkvNode", name: "str", ctx: "WalkCtx") -> "str":
    """Tim 'name' xuat hien lam DOI SO cua 1 loi goi trong cay bieu thuc
    'node'; tra ve dtype phan tu khai bao cua tham so tuong ung."""
    if not la_node(node):
        return None
    if node and ekind(node) in ('call', 'method_call'):
        args = eb_ds(node) if ekind(node) == 'call' else ec_ds(node)
        params = _params_of_call(node, ctx)
        if params is not None:
            for i in range(min(len(args), len(params))):
                a = args[i]
                if la_node(a) and ekind(a) == 'var' and ea_str(a) == name:
                    ta = params[i].type_ann
                    if ta is not None and ta.shape_ten == 'list':
                        return ta.dtype
    for sub in con_nut(node):
        found = _scan_nodes_for_arg_use(sub, name, ctx)
        if found:
            return found
    return None


def _elem_dtype_from_arg_use(stmts: "list[i32]", name: "str", ctx: "WalkCtx") -> "str":
    """Duyet CA cay cau lenh, tim lan dau 'name' duoc TRUYEN lam doi so
    cho 1 ham/method co khai bao tham so 'list[T]' -> tra ve T."""
    for stmt in stmts:
        for key in ('rhs_node', 'expr_node', 'value_node', 'call_node', 'cond_node'):
            node = lay_nut(stmt, key)
            if node is not None:
                found = _scan_nodes_for_arg_use(node, name, ctx)
                if found:
                    return found
        for sub_key in ('body', 'else_body', 'finally_body'):
            sub = lay_than(stmt, sub_key)
            if sub:
                found = _elem_dtype_from_arg_use(sub, name, ctx)
                if found:
                    return found
        for handler_body in [body_of(_v) for _v in lay_handlers_vung(stmt)]:
            found = _elem_dtype_from_arg_use(handler_body, name, ctx)
            if found:
                return found
    return None


def _has_append_stmt(stmts: "list[i32]", name: "str", kind: "str") -> "i32":
    """Co bat ky '<name>.append(...)' / '<name>.add(...)' nao trong cay
    cau lenh khong - phan biet 'container rong suot doi' (kieu phan tu
    khong quan sat duoc VA khong anh huong gi) voi 'co manh moi nhung
    chua suy duoc' (phai hoan lai hoac bao loi)."""
    for stmt in stmts:
        if lay_str(stmt, 'kind') == kind and lay_str(stmt, 'name') == name:
            return True
        for sub_key in ('body', 'else_body', 'finally_body'):
            sub = lay_than(stmt, sub_key)
            if sub and _has_append_stmt(sub, name, kind):
                return True
        for handler_body in [body_of(_v) for _v in lay_handlers_vung(stmt)]:
            if _has_append_stmt(handler_body, name, kind):
                return True
    return False


def _elem_dtype_from_extend(stmts: "list[i32]", name: "str", infer_scope: "Scope", ctx: "WalkCtx") -> "str":
    """dtype phan tu cua `name` suy tu lan '.extend(<nguon>)' DAU TIEN khi khong co
    '.append' nao (2026-09-29): 'q = []' roi 'q.extend(f(x))' khai bao List<i32> mac dinh
    -> chua List<string> vao List<int32> (EntryPointNotFoundException luc chay)."""
    for stmt in stmts:
        k = lay_str(stmt, 'kind')
        if lay_str(stmt, 'name') == name:
            if k == 'list_extend':
                try:
                    return infer_scope.tra(lay_str(stmt, 'other_name')).ta.dtype
                except (KeyError, SyntaxError):
                    return None
            if k == 'list_extend_expr':
                try:
                    return ctx.infer_dtype(lay_nut(stmt, 'expr_node'), infer_scope, ctx.func_table, ctx.records,
                                           ctx.record_methods, None)
                except KeyError:
                    return None
        for sub_key in ('body', 'else_body'):
            sub = lay_than(stmt, sub_key)
            if sub:
                found = _elem_dtype_from_extend(sub, name, infer_scope, ctx)
                if found:
                    return found
    return None


def declare_list(name: "str", ctx: "WalkCtx") -> "i32":
    """FIRST_PASS_WALK helper: khai bao local List<T> - dtype phan tu suy
    tu find_first_append_dtype. `ctx` o day la walk_ctx (xem il_codegen.py
    _first_pass_collect_locals) - CHUA them 'infer_dtype'/'contains_float_literal'/
    'int_dtypes'/'stmts' (tiem lien tu core, xem noi goi ham nay).

    Wave 2 (2026-07-29): thu tim container long nhau TRUOC (xem
    find_first_append_elem_ta) - neu lan '.append(...)' DAU TIEN tren
    'name' la 1 bien list/dict khac, 'name' tro thanh List<List<T>>/
    List<Dict<K,V>> (elem_ta = TypeAnn DAY DU cua bien do); nguoc lai
    (append gia tri vo huong/record nhu cu) roi ve nhanh CU khong doi."""
    declared_names = ctx.declared_names
    if name in declared_names:
        return 0
    hint = ctx.container_arg_hints.get(name, None)
    if hint is not None and hint.shape_ten == 'list' and (
            hint.elem_ta is None or hint.elem_ta.shape_ten == 'tuple'):
        # Chu thich TUONG MINH (tham so cua ham duoc goi, hoac kieu tra ve
        # cua chinh ham nay) thang phong doan tu lan '.append()' dau tien -
        # xem _container_arg_hints trong il_codegen.py. Chi ap dung cho
        # list phan tu VO HUONG (elem_ta None): container long nhau van do
        # find_first_append_elem_ta lo, no chinh xac hon.
        declared_names.add(name)
        ctx.locals_decl.append((name, hint))
        ctx.infer_scope.set(name, hint)
        return 0
    tuple_ta = _list_tuple_ta_tu_append(ctx.stmts, name, ctx)
    nested_ta = find_first_append_elem_ta(ctx.stmts, name, ctx.infer_scope)
    if tuple_ta is not None:
        ta = tuple_ta
    elif nested_ta is not None:
        ta = TypeAnn('__nested__', 'list', elem_ta=nested_ta)
    else:
        elem_dtype = (find_first_append_dtype(ctx.stmts, name, ctx.infer_scope, ctx)
                      # 2026-08-03: list KHONG duoc append trong CHINH ham
                      # nay ma chi TRUYEN cho ham/method khac ('vals = []'
                      # roi 'store.assign(names, vals, ...)') - suy kieu
                      # phan tu tu KHAI BAO THAM SO cua noi nhan. Truoc
                      # day roi thang ve body_dtype -> List<string> cho 1
                      # list THAT SU chua so, sai am tham.
                      or _elem_dtype_from_arg_use(ctx.stmts, name, ctx)
                      or _elem_dtype_from_extend(ctx.stmts, name, ctx.infer_scope, ctx))
        if elem_dtype is None and not _has_append_stmt(ctx.stmts, name, 'list_append'):
            # KHONG co '.append(...)' nao trong ca ham -> list RONG suot
            # doi (vd 'lst = []' roi 'json_dumps(lst)'): kieu phan tu
            # khong the quan sat duoc VA cung khong anh huong ket qua.
            # Chon 1 kieu trung tinh thay vi doan theo kieu tra ve cua ham.
            elem_dtype = 'i32'
        if elem_dtype is None and not ctx.final_pass:
            # Manh moi co the nam o 1 bien khai bao SAU (vd bien vong lap)
            # - hoan lai, thu lai sau khi di het than ham.
            ctx.defer(lambda: declare_list(name, ctx))
            return 0
        if elem_dtype is None:
            raise SyntaxError(
                f"il_codegen: khong suy duoc kieu PHAN TU cua list {name!r} - hay cho 1 "
                f"manh moi ('{name}.append(<gia tri co kieu ro rang>)' truoc, hoac truyen "
                f"'{name}' cho 1 ham co khai bao tham so 'list[...]'). TRUOC 2026-08-03 cho "
                f"nay am tham lay kieu TRA VE cua ham dang bien dich - nguon cua 5 bug sai "
                f"am tham trong 1 phien.")
        ta = TypeAnn(elem_dtype, 'list')
    declared_names.add(name)
    ctx.locals_decl.append((name, ta))
    ctx.infer_scope.set(name, ta)
    return 0


def _nut_append_dau(stmts: "list[i32]", name: "str") -> "TkvNode":
    """Node gia tri cua '.append(...)' DAU TIEN tren `name` (duyet ca cay)."""
    for stmt in stmts:
        if lay_str(stmt, 'kind') == 'list_append' and lay_str(stmt, 'name') == name:
            return lay_nut(stmt, 'value_node')
        for sub_key in ('body', 'else_body'):
            sub = lay_than(stmt, sub_key)
            if sub:
                found = _nut_append_dau(sub, name)
                if found is not None:
                    return found
    return None


def _list_tuple_ta_tu_append(stmts: "list[i32]", name: "str", ctx: "WalkCtx") -> "TypeAnn":
    """'lst = []' ma lan append dau la TUPLE viet thang '(a, b)' (2026-09-25):
    kieu list[(t1, t2, ...)] suy tu tung phan tu. Phan tu nao chua suy duoc
    -> None (duong cu bao loi / hoan lai)."""
    nut = _nut_append_dau(stmts, name)
    if nut is None or ekind(nut) != 'tuple_lit':
        return None
    kieu = []
    tas_el = []
    co_container = False
    for el in ea_ds(nut):
        try:
            d = ctx.infer_dtype(el, ctx.infer_scope, ctx.func_table, ctx.records,
                                ctx.record_methods, None)
        except KeyError:
            return None
        if d is None:
            return None
        kieu.append(d)
        t_el = None
        if ekind(el) == 'var':
            # phan tu la BIEN container (vd 'bodies.append((sig, body_lines))'): infer_dtype chi
            # tra dtype phan tu ('str'), mat hinh dang list -> khai List<Tuple<..,string>> sai (2026-09-29)
            try:
                v_ta = ctx.infer_scope.tra(ea_str(el)).ta
            except KeyError:
                v_ta = None
            if v_ta is not None and v_ta.shape_ten in ('list', 'dict', 'set', 'tuple'):
                t_el = v_ta
                co_container = True
        tas_el.append(t_el)
    ten_rec: "set[str]" = set()
    for r in (ctx.records or {}):
        ten_rec.add(r)
    if co_container and 2 <= len(kieu) <= 7:
        tas_day = []
        for i in range(len(kieu)):
            if tas_el[i] is not None:
                tas_day.append(tas_el[i])
            else:
                tas_day.append(parse_type_ann_str(kieu[i], record_names=ten_rec))
        tup = TypeAnn(kieu[0], 'tuple', tuple_dtypes=kieu, tuple_tas=tas_day)
        return TypeAnn(kieu[0], 'list', elem_ta=tup)
    return parse_type_ann_str('list[(' + ','.join(kieu) + ')]', record_names=ten_rec)


def fpw_assign_list_new(stmt: "i32", ctx: "WalkCtx"):
    declare_list(lay_str(stmt, 'name'), ctx)


def declare_list_literal(name: "str", elements: "list[TkvNode]", ctx: "WalkCtx"):
    """FIRST_PASS_WALK helper: khai bao local List<T> cho 'xs = [3, 1, 2]'
    (Giai doan 0.1, 2026-08-03) - dtype phan tu suy THANG tu chinh cac
    phan tu literal (KHONG can quet '.append()' sau do nhu declare_list).
    Widen ve float NEU BAT KY phan tu nao la float (Python that: [1, 2.0]
    la list[float]) - giong het logic widen da co cho '.append()' dau
    tien trong find_first_append_dtype."""
    declared_names = ctx.declared_names
    if name in declared_names:
        return
    declared_names.add(name)
    infer_scope = ctx.infer_scope
    hint = ctx.container_arg_hints.get(name, None)
    if hint is not None and hint.shape_ten == 'list':
        # Chu thich cua ham nhan thang phong doan tu hang so - xem
        # _container_arg_hints trong il_codegen.py.
        ctx.locals_decl.append((name, hint))
        infer_scope.set(name, hint)
        return
    records = (ctx.records if ctx is not None else None) or {}
    record_bases = (ctx.record_bases if ctx is not None else None) or {}
    elem_dtype = None
    elem_ta = None
    for el in elements:
        # NGUON SU THAT DUY NHAT ve suy kieu phan tu, dung CHUNG voi
        # codegen_expr_list_literal (final-review C1, 2026-08-19) - phan
        # tu la 1 list-literal LONG NHAU (vd 'grid = [[1,2],[3,4]]') tra
        # ve chuoi MANG SHAPE 'list[T]', boc ra thanh TypeAnn(T,'list')
        # lam elem_ta cua phan tu nay.
        d = list_literal_elem_spec_of(el, infer_scope, nguon_kieu_walk(ctx))
        k_ind, _inner = _split_container_spec(d)
        if k_ind == 'list':
            # HANH VI CU (2026-08-19) cho list long nhau: boc 'list[' ra
            # inner, `dtype` = LEAF, elem_ta = TypeAnn(inner, 'list') - KHONG
            # dung `ta_tu_spec` o day (no tao them 1 tang elem_ta, lam
            # `+` tren list long nhau roi vao nhanh "chua ho tro").
            inner_elem_dtype = _inner
            d = inner_elem_dtype
            d_ta = TypeAnn(inner_elem_dtype, 'list')
        elif k_ind == 'dict' or k_ind == 'set':
            # (2026-10-11) '[{"a":1}]' -> 'dict[str,i32]', '{[1,2]}' ->
            # 'set[list[i32]]': container MOI trong literal long nhau.
            d_ta = ta_tu_spec(d)
            d = d_ta.dtype
        else:
            d_ta = None
        moi = _fold_elem(elem_dtype, d, records, record_bases)
        if moi != elem_dtype:
            elem_dtype = moi
            elem_ta = d_ta
    if elem_ta is not None:
        ta = TypeAnn(elem_dtype, 'list', elem_ta=elem_ta)
    else:
        logic = 0
        if elem_dtype == 'i32' and len(elements) > 0:
            # '[True, False, a > b]' (2026-10-01): moi phan tu mang nghia logic -> list[bool]
            logic = 1
            for el in elements:
                if ekind(el) != 'not' and ekind(el) != 'compare' and ekind(el) != 'in':
                    logic = 0
        ta = TypeAnn(elem_dtype, 'list', logic=logic)
    ctx.locals_decl.append((name, ta))
    ctx.infer_scope.set(name, ta)


def fpw_assign_list_literal(stmt: "i32", ctx: "WalkCtx"):
    declare_list_literal(lay_str(stmt, 'name'), lay_ds_nut(stmt, 'elements'), ctx)
    for el in lay_ds_nut(stmt, 'elements'):
        ctx.collect_ternary_temps(el)


def fpw_assign_list_from(stmt: "i32", ctx: "WalkCtx"):
    """FIRST_PASS_WALK: `xs = list(ys)` (port 2026-10-09) - khai List<T> voi
    dtype phan tu lay THANG tu `ys` (ban sao cung kieu phan tu)."""
    name = lay_str(stmt, 'name')
    if name in ctx.declared_names:
        return
    src = lay_str(stmt, 'src')
    src_ta = ctx.infer_scope.tra(src).ta
    if src_ta.shape_ten != 'list':
        raise SyntaxError(f"il_codegen: list({src}) can '{src}' la list")
    ctx.declared_names.add(name)
    # Dung THANG src_ta (nhung bien container khac) thay TypeAnn(...) moi:
    # local moi tu constructor khong duoc infer kieu cho tuple append.
    ctx.locals_decl.append((name, src_ta))
    ctx.infer_scope.set(name, src_ta)


def codegen_assign_list_from(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN: `xs = list(ys)` (port 2026-10-09) - `List<T>(IEnumerable<T>)`."""
    ctx.load_var_ref(lay_str(stmt, 'src'), scope, body)
    ta = scope.tra(lay_str(stmt, 'name')).ta
    list_il = ctx.il_type_str(ta, ctx.records)
    body.append(f'    newobj instance void {list_il}::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def codegen_assign_list_literal(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'xs = [3, 1, 2]' (Giai doan 0.1, 2026-08-03) -
    tai dung 100% codegen_assign_list_new (newobj + store) roi codegen_list_append
    tung phan tu (tuong duong 'xs = []' + N lan '.append()'), khong viet
    lai logic newobj/Add rieng - dung nguyen tac DRY."""
    codegen_assign_list_new(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn)
    for el in lay_ds_nut(stmt, 'elements'):
        # Cau lenh TAM, dung roi bo. Truoc 2026-09-18 no la mot DICT -
        # cai dict cuoi cung trong cay. No khong vao than nao nen khong
        # chan `body_of`, nhung no di THANG vao codegen, noi nay chi con
        # nhan row. Dung o luu THANG chi so node (co che A1) vi `el` la
        # node dung san, khong co van ban nguon.
        codegen_list_append(intern(make4('list_append', lay_str(stmt, 'name'), None, str(el))),
                             scope, body, body_dtype, ctx, sig, codegen_stmts_fn)


def fpw_list_append(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'value_node'))


_LIST_REMOVE_RE = re.compile(r'^(\w+)\.remove\((.+)\)\s*$')
_LIST_INSERT_RE = re.compile(r'^(\w+)\.insert\(\s*(.+?)\s*,\s*(.+)\s*\)\s*$')


def try_parse_list_remove(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """LINE_PARSERS entry: 'lst.remove(x)' - PHAI dang ky TRUOC
    method_call_stmt (pattern method-call tong quat cung khop dong nay),
    giong list_append. 2026-07-29 (Huong A stdlib mo rong, khi them
    set.remove() o set_methods_batch2.py): them dieu kien loai tru
    known_shapes=='set' - regex 'x.remove(...)' giong het set.remove(),
    NEU KHONG loai tru se cuop mat luon moi loi goi set.remove() (LINE_PARSERS
    la list thu THEO THU TU dang ky, file nay import TRUOC nen luon thang
    neu khong co dieu kien nay)."""
    m = _LIST_REMOVE_RE.match(line)
    if not m or known_shapes.get(m.group(1)) in ('set', 'frozenset', 'bytearray'):
        return None
    name, arg_expr = m.groups()
    return intern(make3('list_remove', name, arg_expr)), pos + 1


def codegen_list_remove(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'lst.remove(x)' - xoa phan tu DAU TIEN khop
    gia tri x. GIOI HAN DA BIET: Python list.remove() nem ValueError neu
    khong tim thay x; .NET List<T>.Remove(T) chi tra ve bool (khong nem
    loi) - o day CHAP NHAN hanh vi .NET (bo qua gia tri bool tra ve qua
    'pop'), KHONG gia lap ValueError."""
    if _record_stmt_fallback(lay_str(stmt, 'name'), 'remove', [lay_nut(stmt, 'value_node')], scope, body, ctx):
        return
    ta = scope.tra(lay_str(stmt, 'name')).ta
    reject_if_nested_container_elem(ta, 'list.remove')
    ctx.load_var_ref(lay_str(stmt, 'name'), scope, body)
    ctx.compile_expr(lay_nut(stmt, 'value_node'), scope, body, ta.dtype, ctx)
    body.append(f'    callvirt instance bool {ctx.il_type_str(ta, ctx.records)}::Remove(!0)')
    body.append('    pop')


def fpw_list_remove(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'value_node'))


def try_parse_list_insert(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """LINE_PARSERS entry: 'lst.insert(i, x)' - PHAI dang ky TRUOC
    method_call_stmt, giong list_append/list_remove."""
    m = _LIST_INSERT_RE.match(line)
    if not m or known_shapes.get(m.group(1)) == 'bytearray':
        return None
    name, idx_expr, val_expr = m.groups()
    return intern(make4('list_insert', name, idx_expr, val_expr)), pos + 1


def codegen_list_insert(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'lst.insert(i, x)' - List<T>.Insert(int32, !0)."""
    if _record_stmt_fallback(lay_str(stmt, 'name'), 'insert', [lay_nut(stmt, 'index_node'), lay_nut(stmt, 'value_node')], scope, body, ctx):
        return
    ta = scope.tra(lay_str(stmt, 'name')).ta
    ctx.load_var_ref(lay_str(stmt, 'name'), scope, body)
    ctx.compile_expr(lay_nut(stmt, 'index_node'), scope, body, 'i32', ctx)
    ctx.compile_expr(lay_nut(stmt, 'value_node'), scope, body, ta.dtype, ctx)
    body.append(f'    callvirt instance void {ctx.il_type_str(ta, ctx.records)}::Insert(int32, !0)')


def fpw_list_insert(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'index_node'))
    ctx.collect_ternary_temps(lay_nut(stmt, 'value_node'))




def fpw_for_in_call_list(stmt: "i32", ctx: "WalkCtx"):
    """FIRST_PASS_WALK cho 'for x in f(...):' khi f tra ve 1 LIST thuong
    (2026-08-03, dot 2) - khai bao 1 local AN giu ket qua loi goi, 1 local
    dem, va bien vong lap."""
    sig = ctx.func_table[lay_str(stmt, 'callee_name')]
    ret_ta = sig.return_type
    src_ta = ret_ta
    if ret_ta.shape_ten == 'set' or ret_ta.shape_ten == 'frozenset':
        # 'for x in f()' voi f tra SET (2026-09-29): sao ra List<T> roi duyet theo chi so
        # (HashSet khong co get_Item).
        src_ta = TypeAnn(ret_ta.dtype, 'list')
    ctx.declare_named(f'__forsrc{nid(stmt)}', src_ta)
    ctx.declare_named(f'__foridx{nid(stmt)}', TypeAnn('i32', None))
    # Task 3 review fix thu 4 (extern-class-list, 2026-08-18): doi xung voi
    # declare_scalar/_fpp_assign_scalar (il_codegen.py) - 'for x in f(...):'
    # khi f() tra ve list[HandleType] phai suy shape='extern_class' cho 'x',
    # khong chi biet nhanh 'record'. Thieu nhanh nay -> shape=None ->
    # il_type_str's nhanh shape=None tra IL_SCALAR[dtype] -> KeyError, va
    # 'x.method()'/'x.field' sau do tra cuu SAI (khong dung extern-class).
    extern_class_defs = ctx.extern_class_defs
    if extern_class_defs and ret_ta.dtype in extern_class_defs:
        elem_shape = 'extern_class'
    elif ctx.records and ret_ta.dtype in ctx.records:
        elem_shape = 'record'
    else:
        elem_shape = None
    ctx.declare_named(lay_str(stmt, 'var'), TypeAnn(ret_ta.dtype, elem_shape))
    for arg_node in lay_ds_nut(stmt, 'arg_nodes'):
        ctx.collect_ternary_temps(arg_node)
    ctx.walk_fn(lay_than(stmt, 'body'))


def codegen_for_in_call_list(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN cho 'for x in f(...):' (f tra ve list) - goi ham 1 LAN,
    do ket qua vao 1 local an, roi lap theo chi so nhu 'for x in bien:'."""
    callee = ctx.func_table[lay_str(stmt, 'callee_name')]
    compile_expr = ctx.compile_expr
    il_type_str = ctx.il_type_str
    records = ctx.records
    _rb = scope.tra(f'__forsrc{nid(stmt)}')
    src_idx = _rb.idx
    src_ta = _rb.ta
    idx_idx = scope.tra(f'__foridx{nid(stmt)}').idx
    list_type = il_type_str(src_ta, records)

    for arg_node, p in zip(lay_ds_nut(stmt, 'arg_nodes'), callee.params):
        # Round 3 (2026-08-19): shape-string convention cho list-literal
        # long nhau lam doi so ('for x in rows([[1,2],[3,4]]):').
        compile_expr(arg_node, scope, body,
                     value_dtype_spec_for_ta(p.type_ann, arg_node), ctx)
    params_il = ', '.join([il_type_str(p.type_ann, records) for p in callee.params])
    class_name = ctx.class_name or 'Program'
    ret_il = il_type_str(callee.return_type, records)
    body.append(f"    call {ret_il} {class_name}::{ctx.il_ident(lay_str(stmt, 'callee_name'))}({params_il})")
    if callee.return_type.shape_ten == 'set' or callee.return_type.shape_ten == 'frozenset':
        body.append(f'    newobj instance void {list_type}::.ctor(class [mscorlib]System.Collections.Generic.IEnumerable`1<!0>)')
    body.append(f'    stloc.s {src_idx}')

    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    start_lbl = f"{ctx.prefix}_FCL{n}_start"
    cont_lbl = f"{ctx.prefix}_FCL{n}_cont"
    end_lbl = f"{ctx.prefix}_FCL{n}_end"
    body.append('    ldc.i4.0')
    body.append(f'    stloc.s {idx_idx}')
    body.append(f'  {start_lbl}:')
    body.append(f'    ldloc.s {idx_idx}')
    body.append(f'    ldloc.s {src_idx}')
    body.append(f'    callvirt instance int32 {list_type}::get_Count()')
    body.append(f'    bge {end_lbl}')
    body.append(f'    ldloc.s {src_idx}')
    body.append(f'    ldloc.s {idx_idx}')
    body.append(f'    callvirt instance !0 {list_type}::get_Item(int32)')
    ctx.store_var(lay_str(stmt, 'var'), scope, body)
    ctx.loop_stack.append((cont_lbl, end_lbl))
    codegen_stmts_fn(lay_than(stmt, 'body'), scope, body, body_dtype, ctx, sig)
    ctx.loop_stack.pop()
    body.append(f'  {cont_lbl}:')
    body.append(f'    ldloc.s {idx_idx}')
    body.append('    ldc.i4.1')
    body.append('    add')
    body.append(f'    stloc.s {idx_idx}')
    body.append(f'    br {start_lbl}')
    body.append(f'  {end_lbl}:')


def bootstrap_list_type(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    # Dang ky vao il_dispatch NGAY LUC MODULE NAP (il_dispatch.py khong phu
    # thuoc il_codegen.py nen import truc tiep an toan, khong circular).
    register_assign_rhs_parser(reg, 'list_literal', try_rhs_list_literal)
    register_assign_rhs_parser(reg, 'list_call', try_rhs_list_call)
    register_line_parser(reg, 'list_append', try_parse_list_append)
    register_line_parser(reg, 'list_remove', try_parse_list_remove)
    register_line_parser(reg, 'list_insert', try_parse_list_insert)
    register_stmt_codegen(reg, 'assign_list_new', codegen_assign_list_new)
    register_stmt_codegen(reg, 'assign_list_literal', codegen_assign_list_literal)
    register_stmt_codegen(reg, 'assign_list_from', codegen_assign_list_from)
    register_stmt_codegen(reg, 'list_append', codegen_list_append)
    register_stmt_codegen(reg, 'list_remove', codegen_list_remove)
    register_stmt_codegen(reg, 'list_insert', codegen_list_insert)
    register_first_pass_walk(reg, 'assign_list_new', fpw_assign_list_new)
    register_first_pass_walk(reg, 'assign_list_literal', fpw_assign_list_literal)
    register_first_pass_walk(reg, 'assign_list_from', fpw_assign_list_from)
    register_first_pass_walk(reg, 'list_append', fpw_list_append)
    register_first_pass_walk(reg, 'list_remove', fpw_list_remove)
    register_first_pass_walk(reg, 'list_insert', fpw_list_insert)
    # Gap 2 (Phase 7 follow-up, 2026-08-19): 'list_literal' o VI TRI BIEU THUC
    # (long trong 1 list-literal khac) - xem codegen_expr_list_literal.
    register_expr_codegen(reg, 'list_literal', codegen_expr_list_literal)
    register_expr_codegen(reg, 'tuple_lit', codegen_expr_tuple_lit)
    register_expr_codegen(reg, 'dict_lit', codegen_expr_dict_lit)
    register_expr_codegen(reg, 'set_lit', codegen_expr_set_lit)
    register_stmt_codegen(reg, 'for_in_call_list', codegen_for_in_call_list)
    register_first_pass_walk(reg, 'for_in_call_list', fpw_for_in_call_list)
