# -*- coding: utf-8 -*-
"""Don chuoi trong vong lap: dung StringBuilder thay vi noi chuoi O(n^2).

VAN DE DA DO DUOC (2026-08-04, cung phien, cung tai may):

    out = out + "x"  trong 'while', so voi CPython chay CHINH doan do:
      n= 20.000   CPython   159 ms   TokenVector   154 ms   hoa
      n= 50.000   CPython   269 ms   TokenVector   574 ms   CPython nhanh 2,1x
      n=100.000   CPython   583 ms   TokenVector  3303 ms   CPython nhanh 5,7x
      n=200.000   CPython  1756 ms   TokenVector 18025 ms   CPython nhanh 10,3x

Khoang cach NOI RONG theo n - dau hieu O(n^2): chuoi .NET BAT BIEN nen moi
phep '+' cap phat va chep lai TOAN BO chuoi. CPython co duong rieng cho
`s += x`: mo rong TAI CHO khi refcount == 1, thanh O(n) khau hao.

Day la mot trong rat it cho TokenVector CHAM HON Python, va no danh thang
vao muc tieu so 1 cua du an. Nguy hiem o cho no IM LANG: ket qua van dung
tung byte, chi la cham gap 10 lan.

PHAM VI CO Y THU HEP (chu du an chot 2026-08-04: "khoan sua rong"):
Bien doi nay ap dung TRONG DUNG MOT VONG LAP, khong doi bieu dien cua bien
o bat ky cho nao khac:

    sb = new StringBuilder(out)      <- truoc vong lap
    while ...:
        sb.Append(<bieu thuc>)       <- thay cho 'out = out + <bieu thuc>'
    out = sb.ToString()              <- sau vong lap

Ngoai vong lap, 'out' van la mot 'string' binh thuong. Nho vay khong phai
dong den moi cho DOC bien - do moi la phan rong, de sau.

DIEU KIEN AN TOAN (thieu MOT dieu la bo qua, giu nguyen cach cu):
  1. Bien co kieu 'str' va la local thuong.
  2. Trong than vong lap, bien CHI xuat hien o dung mot cho: ve trai va
     toan hang trai cua chinh phep don. Doc no o cho khac se thay chuoi
     CHUA duoc dong bo -> sai ket qua, nen tu choi thang.
  3. Than vong lap KHONG co 'return': 'return' thoat ra ma khong chay buoc
     dong bo, bien se giu gia tri cu -> sai am tham. 'break'/'continue'
     thi AN TOAN vi buoc dong bo dat SAU nhan ket thuc vong lap.
  4. Khong co 'nested_def'/'yield': closure co the bat bien, generator cat
     doi luong dieu khien.
"""
import stmt_row as _row
from il_dispatch import register_stmt_codegen, register_first_pass_walk
from tkv_types import TypeAnn
from stmt_row import assign_name, assign_rhs_node, body_of, co_ghi_chu, dat_ghi_chu_ds, intern, items_nut, kind_of_stmt, lay_ghi_chu_ds, lay_handlers_vung, lay_i32, lay_nut, lay_str, lay_than, make4, with_src_line
from expr_row import con_nut, ea_str, eb_nut, eb_str, ec_nut, ekind, eso_o, la_node

_SB_IL = 'class [mscorlib]System.Text.StringBuilder'


__tkv_import__ = ["il_dispatch", "tkv_types"]

def _walk_stmts(stmts: "list[i32]") -> "list[i32]":
    """Duyet DE QUY moi cau lenh, ke ca trong than long nhau."""
    _nguon_lap1 = stmts
    if not _nguon_lap1:
        _nguon_lap1 = []
    for stmt in _nguon_lap1:
        yield stmt
        for key in ('body', 'else_body', 'finally_body'):
            for sub in _walk_stmts(lay_than(stmt, key)):
                yield sub
        for handler_body in [body_of(_v) for _v in lay_handlers_vung(stmt)]:
            for sub in _walk_stmts(handler_body):
                yield sub


def _walk_slots(stmts: "list[i32]") -> "list[(list[i32],i32,i32)]":
    """Nhu `_walk_stmts` nhung sinh (danh_sach, chi_so, cau_lenh).

    Can cho cho GHI: row la CHUOI BAT BIEN nen khong sua tai cho duoc - phai
    ghi NGUOC vao danh sach cha. Dict thi sua tai cho van chay, nhung dung
    chung mot duong de khong con hai ngu nghia song song."""
    # Thu SAN thanh list (2026-09-28) thay vi generator: trinh that chi co
    # generator phan tu vo huong. Cung thu tu duyet; cho goi duy nhat chi ghi
    # de DUNG o dang xet bang 1 lenh khong co than nen ket qua khong doi.
    ra: "list[(list[i32],i32,i32)]" = []
    _thu_slots(stmts or [], ra)
    return ra


def _thu_slots(lst: "list[i32]", ra: "list[(list[i32],i32,i32)]"):
    for i, stmt in enumerate(lst):
        ra.append((lst, i, stmt))
        for key in ('body', 'else_body', 'finally_body'):
            _thu_slots(lay_than(stmt, key) or [], ra)
        for handler_body in [body_of(_v) for _v in lay_handlers_vung(stmt)]:
            _thu_slots(handler_body, ra)


def _node_refs(node: "TkvNode", name: "str") -> "i32":
    """Dem so lan ('var', name) xuat hien trong 1 cay bieu thuc."""
    if not la_node(node):
        return 0
    if eso_o(node) == 2 and ekind(node) == 'var' and ea_str(node) == name:
        return 1
    total = 0
    # Receiver cua loi goi phuong thuc ('ra.rstrip()', 'ra.endswith(..)') la O CHUOI chu khong phai node 'var':
    # khong dem thi doc `ra` giua vong lap se thay chuoi CHUA dong bo (sai am tham). Dem du (trung ten -> tu choi) la an toan.
    if ekind(node) not in ('var', 'str_lit') and (ea_str(node) == name or eb_str(node) == name):
        total += 1
    for part in con_nut(node):
        total += _node_refs(part, name)
    return total


def _is_accum(stmt: "i32", name: "str") -> "i32":
    """'name = name + <bieu thuc>' - phep don len chinh no."""
    if kind_of_stmt(stmt) != 'assign_scalar' or assign_name(stmt) != name:
        return False
    rhs = assign_rhs_node(stmt)
    return (la_node(rhs) and eso_o(rhs) == 4 and ekind(rhs) == 'binop'
            and ea_str(rhs) == '+' and la_node(eb_nut(rhs))
            and eso_o(eb_nut(rhs)) == 2 and ekind(eb_nut(rhs)) == 'var' and ea_str(eb_nut(rhs)) == name)


def _candidate_names(body: "list[i32]") -> "list[str]":
    """Ten bien co it nhat mot phep don trong than vong lap."""
    names = []
    for stmt in _walk_stmts(body):
        if lay_str(stmt, 'kind') != 'assign_scalar':
            continue
        name = lay_str(stmt, 'name')
        if name and name not in names and _is_accum(stmt, name):
            names.append(name)
    return names


def _body_is_safe(body: "list[i32]") -> "i32":
    """Dieu kien 3 va 4 - xem docstring module."""
    for stmt in _walk_stmts(body):
        if lay_str(stmt, 'kind') in ('return', 'return_tuple', 'nested_def',
                                'yield_stmt'):
            return False
    return True


def _only_used_as_accumulator(body: "list[i32]", name: "str") -> "i32":
    """Dieu kien 2: trong than vong lap, 'name' chi xuat hien o dung cho
    toan hang trai cua phep don, khong o dau khac."""
    for stmt in _walk_stmts(body):
        accum = _is_accum(stmt, name)
        for key, node in items_nut(stmt):
            hits = _node_refs(node, name)
            if accum and key == 'rhs_node':
                # Dung mot lan o ve trai cua '+' la hop le; nhieu hon la
                # co doc them o cho khac trong cung bieu thuc.
                if hits != 1:
                    return False
            elif hits:
                return False
        # Bi gan bang mot cach KHAC (vd 'name = f()') -> tu choi.
        if (lay_str(stmt, 'name') == name and not accum
                and lay_str(stmt, 'kind').startswith('assign')):
            return False
        if lay_str(stmt, 'var') == name or lay_str(stmt, 'target') == name:
            return False
    return True


def _declare_sb_locals(names: "list[str]", ctx: "WalkCtx", infer_scope: "Scope"):
    """Khai bao local StringBuilder an cho tung bien don. Goi lai duoc
    nhieu lan (moi luot mot cua lượt một co 'locals_decl' rieng)."""
    for name in names:
        sb_name = '__sb_' + name
        if sb_name in ctx.declared_names:
            continue
        ctx.declared_names.add(sb_name)
        sb_ta = TypeAnn('str', 'strbuf')
        ctx.locals_decl.append((sb_name, sb_ta))
        infer_scope.set(sb_name, sb_ta)


def plan_str_accum(stmt: "i32", ctx: "WalkCtx"):
    """Goi tu fpw_for/fpw_while TRUOC khi duyet than vong lap.

    Neu tim duoc bien don an toan: cap phat local StringBuilder, doi cac
    cau lenh don thanh kind 'sb_append', va ghi danh sach vao chinh stmt
    de luc sinh ma biet phai dung khung truoc/sau vong lap.
    """
    body = lay_than(stmt, 'body')
    if not body:
        return
    infer_scope = ctx.infer_scope

    # PHAI LUY DANG: lượt một chay NHIEU LAN (co co che hoan lai/defer, xem
    # ctx['final_pass'] trong dict_type.py), moi lan mot 'locals_decl' MOI.
    # Lan dau da doi kind thanh 'sb_append' nen lan sau khong con nhan ra
    # mau nua -> local '__sb_x' khong duoc khai bao lai -> "bien chua duoc
    # khai bao" luc sinh ma. Nen neu da phan tich roi thi chi khai bao lai.
    if co_ghi_chu(stmt, '__sb_vars'):
        _declare_sb_locals(lay_ghi_chu_ds(stmt, '__sb_vars'), ctx, infer_scope)
        return

    if not _body_is_safe(body):
        return
    chosen = []
    for name in _candidate_names(body):
        try:
            ta = infer_scope.tra(name).ta
        except KeyError:
            continue                      # chua khai bao truoc vong lap
        if ta is None or ta.dtype != 'str' or not ta.la_vo_huong():
            continue
        if not _only_used_as_accumulator(body, name):
            continue
        chosen.append(name)

    if not chosen:
        return
    _declare_sb_locals(chosen, ctx, infer_scope)
    for name in chosen:
        sb_name = '__sb_' + name
        for lst, i, sub in _walk_slots(body):
            if _is_accum(sub, name):
                # Dat 'value_node'/'sb_name' TRUOC khi doi 'kind': neu co
                # loi giua chung thi khong de lai cau lenh nua voi (kind
                # moi ma thieu truong) - rat kho truy khi do.
                #
                # P8: cau lenh co the la ROW (chuoi bat bien) nen khong sua
                # tai cho duoc - dung `sb_append` DICT moi roi GHI NGUOC vao
                # danh sach cha. Voi dict thi ket qua giong het cach cu.
                _new = intern(make4('sb_append', lay_str(sub, 'name'), sb_name,
                                   str(ec_nut(lay_nut(sub, 'rhs_node')))))
                _sl = lay_i32(sub, 'src_line')
                if _sl:
                    _new = with_src_line(_new, _sl)
                lst[i] = _new
    # P8 Task 3/4: row bat bien nen khong ghi thang vao cau lenh duoc nua.
    # Bang ghi chu phu khoa theo CHI SO pool tai lap chinh xac hanh vi cu
    # (pass MOT ghi, pass HAI doc) - xem chu thich dau `_GHI_CHU`.
    dat_ghi_chu_ds(stmt, '__sb_vars', chosen)


def emit_sb_setup(stmt: "i32", scope: "Scope", body: "list[str]", ctx: "Ctx"):
    """Truoc vong lap: sb = new StringBuilder(<gia tri hien tai>)."""
    for name in lay_ghi_chu_ds(stmt, '__sb_vars'):
        ctx.load_var_ref(name, scope, body)
        body.append('    newobj instance void '
                    '[mscorlib]System.Text.StringBuilder::.ctor(string)')
        ctx.store_var('__sb_' + name, scope, body)


def emit_sb_flush(stmt: "i32", scope: "Scope", body: "list[str]", ctx: "Ctx"):
    """Sau vong lap: <bien> = sb.ToString() - dong bo lai mot lan duy nhat."""
    for name in lay_ghi_chu_ds(stmt, '__sb_vars'):
        ctx.load_var_ref('__sb_' + name, scope, body)
        body.append('    callvirt instance string '
                    '[mscorlib]System.Object::ToString()')
        ctx.store_var(name, scope, body)


def codegen_sb_append(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """sb.Append(<bieu thuc>) - thay cho 'x = x + <bieu thuc>'.

    Append tra ve chinh StringBuilder do nen phai 'pop' bo khoi stack."""
    ctx.load_var_ref(lay_str(stmt, 'sb_name'), scope, body)
    ctx.compile_expr(lay_nut(stmt, 'value_node'), scope, body, 'str', ctx)
    body.append('    callvirt instance class [mscorlib]System.Text.StringBuilder '
                '[mscorlib]System.Text.StringBuilder::Append(string)')
    body.append('    pop')


def fpw_sb_append(stmt: "i32", ctx: "WalkCtx"):
    ctx.collect_ternary_temps(lay_nut(stmt, 'value_node'))


def bootstrap_str_accum(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_stmt_codegen(reg, 'sb_append', codegen_sb_append)
    register_first_pass_walk(reg, 'sb_append', fpw_sb_append)
