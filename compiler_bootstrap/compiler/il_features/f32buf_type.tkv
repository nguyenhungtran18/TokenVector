# -*- coding: utf-8 -*-
"""Kieu container `f32buf` - bo dem f32 native DO TOKENVECTOR TU QUAN LY.

PORT tu compiler/il_features/f32buf_type.tkv (2026-10-07). Chuyen doi chinh:
- ctx['...']/stmt['...']/scope[...] dict-style -> ctx.<field> /
  lay_str(lay_nut)/scope.tra().ta.
- try_rhs tra intern(make4(...)) thay vi dict Python; count luu DUOI DANG
  TEXT (parse lai o fpw/codegen qua lay_nut), giong with_open luu path_expr.
- `from il_features.nativebuf import _compile_n_i32` de o CAP MODULE
  (nativebuf khong import nguoc lai nen khong vong tron).
- Ham long `_emit_count_as_i32` viet thang if/else tai cho (tranh nested def).
"""

import re

from il_dispatch import (
    register_assign_rhs_parser, register_stmt_codegen, register_first_pass_walk,
    register_line_parser,
)
from il_features.nativebuf import _compile_n_i32
from tkv_types import TypeAnn
from stmt_row import intern, lay_nut, lay_str, make3, make2

__tkv_import__ = "il_dispatch"

_MARSHAL = '[mscorlib]System.Runtime.InteropServices.Marshal'

# Ten IL cua Marshal, dung o ca il_codegen (khi xu ly lenh goi
# `f32buf_free`) nen phai EXPORT chung chu khong tai su bien private.
# (Giu ca 2 ten nhu ban bootstrap; F32BUF_MARSHAL chi la alias doc.)

# Kieu IL: con trong 'native int'. Giong het gia tri ma `alloc_bytes` tra ve
# (`conv.i8` nen con la i64) - nhung TypeAnn cua f32buf la `('f32','f32buf')`
# nen moi noi doc shape, khong phai nhan dang so nguyen.
F32BUF_IL = 'native int'

_F32BUF_NEW_RE = re.compile(r'^f32buf\(\s*(\w+)\s*\)\s*$')
# `f32buf_free(b)` - CHI chap nhan 1 BIEN, khong nhan bieu thuc: bien can
# duoc dat 0 sau khi giai phong nen phai la bien that, khong phai ket qua bieu
# thuc tam thoi.
_F32BUF_FREE_RE = re.compile(r'^f32buf_free\(\s*(\w+)\s*\)\s*$')


def il_f32buf_type() -> "str":
    return F32BUF_IL


def f32buf_len_name(name: "str") -> "str":
    """Ten local AN giu CHIEU DAI cua buffer `name`.

    Vung nho chi co dia chi, khong co do dai - `Marshal.AllocHGlobal` tra ve
    `IntPtr` khong luu kich thuoc. Do do do dai phai la 1 local rieng, khai
    trong first-pass. Ten lay theo TEN BIEN nen moi bien 1 local rieng, tranh
    do dai 2 buffer cung ten trong cung ham."""
    return f'__f32buf_{name}_len'


def next_f32buf_label(ctx: "Ctx", name: "str") -> "str":
    """Nhan ten nhanh de toi uu cho phan kiem tra gioi han."""
    ctx.label_counter[0] += 1
    n = ctx.label_counter[0]
    return f'_f32b{n}_{name}_ok'


def emit_f32buf_index_check(out: "list[str]", len_local: "str", label: "str", var_name: "str"):
    """KIEM TRA GIOI HAN cho `b[i]` - nem IndexOutOfRangeException neu `i`
    ra ngoai `[0, len)`.

    Stack khi VAO : [dia_chi_base, i32_index]
    Stack khi RA  : [dia_chi_base, native_int_index]  (nhanh khong loi)

    `conv.u` + `blt.un` la so sanh KHONG DAU: `(uint)i < (uint)len` DUNG khi
    va CHI khi `0 <= i < len`. Neu dung `blt` co dau, chi so am nhu `b[-1]`
    se LOT qua va tinh ra dia chi truoc base - doc nham vung nho khac.
    """
    out.append('    conv.i8')
    out.append('    dup')
    out.append('    conv.u')
    out.append(f'    ldloc {len_local}')
    out.append('    conv.i8')
    out.append('    conv.u')
    out.append(f'    blt.un {label}')
    out.append(f'    ldstr "IndexError: chi so cua f32buf \'{var_name}\' nam ngoai do dai"')
    out.append('    newobj instance void [mscorlib]System.IndexOutOfRangeException::.ctor(string)')
    out.append('    throw')
    out.append(f'  {label}:')


def try_rhs_f32buf_new(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    """ASSIGN_RHS_PARSERS entry: 'a = f32buf(n)' - cap n PHAN TU f32 (n * 4
    byte). CHI chap nhan n la bien/chu so: khong chap nhan bieu thuc, de
    kich thuoc luon tinh 1 lan."""
    rhs_s = rhs.strip()
    m = _F32BUF_NEW_RE.match(rhs_s)
    if not m:
        return None
    known_shapes[name] = 'f32buf'
    return intern(make3('assign_f32buf_new', name, m.group(1)))


def fpw_assign_f32buf_new(stmt: "i32", ctx: "WalkCtx"):
    """FIRST_PASS_WALK: khai local con tro (dtype f32 shape f32buf) + local
    AN giu chieu dai."""
    ctx.declare_named(lay_str(stmt, 'name'), TypeAnn('f32', 'f32buf'))
    ctx.declare_named(f32buf_len_name(lay_str(stmt, 'name')), TypeAnn('i32', None))
    ctx.collect_ternary_temps(lay_nut(stmt, 'count_node'))


def codegen_assign_f32buf_new(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'a = f32buf(n)'.

    Cap `n * 4` byte (4 byte/phan tu) roi luu dia chi vao bien. CHIEU DAI luu
    vao local AN rieng - xem f32buf_len_name.

    'count_node' duoc bien dich HAI LAN (mot lan cho kich thuoc cap, mot lan
    cho chieu dai). Gia tri la thuan so nen tinh lai khong ton nhieu - va no
    giup tranh phai giu mot local tam, don gian hon.
    """
    count_node = lay_nut(stmt, 'count_node')
    count_dtype = ctx.infer_dtype(count_node, scope, ctx.func_table, ctx.records, ctx.record_methods, None)
    # dia chi: n * 4 byte
    if count_dtype == 'i64':
        ctx.compile_expr(count_node, scope, body, 'i64', ctx)
        body.append('    ldc.i4.4')
        body.append('    conv.i8')
        body.append('    mul')
    else:
        _compile_n_i32(count_node, scope, body, ctx)
        body.append('    ldc.i4.4')
        body.append('    mul')
    body.append(f'    call native int {_MARSHAL}::AllocHGlobal(int32)')
    body.append('    conv.i8')
    ctx.store_var(lay_str(stmt, 'name'), scope, body)
    # chieu dai (so phan tu, khong phai byte)
    if count_dtype == 'i64':
        ctx.compile_expr(count_node, scope, body, 'i64', ctx)
        body.append('    conv.ovf.i4')
    else:
        _compile_n_i32(count_node, scope, body, ctx)
    ctx.store_var(f32buf_len_name(lay_str(stmt, 'name')), scope, body)


def emit_f32buf_free(out: "list[str]", var_name: "str", scope: "Scope", ctx: "Ctx", dtype: "str") -> "i32":
    """Phat `Marshal.FreeHGlobal` cho bien `var_name`, roi dat con tro va do
    dai ve 0. Tra 1 neu thanh cong.

    Dat 0 KHONG phai lam dep ma la chu dich an toan: moi truy cap `b[i]` sau
    do loai o kiem tra gioi han (`0 <= i < 0` sai voi moi `i`) va nem
    IndexError. Tuc la "dung bo dem da giai phong" bien tu CORRUPT MEMORY
    thanh LOI SACH thay vi segfault. `FreeHGlobal(IntPtr.Zero)` la no-op nen
    goi hai lan cung khong hong.

    Tra ve 0 (va KHONG phat gi) neu `var_name` khong phai bien f32buf de
    nguoi goi tu quyet dinh bao loi nao cho hieu hon.
    """
    if var_name not in scope:
        return 0
    ta = scope.tra(var_name).ta
    if ta is None or ta.shape_ten != 'f32buf':
        return 0
    ctx.load_var_ref(var_name, scope, out)
    # KHONG co 'pop' sau loi goi: `FreeHGlobal` tra `void`, khong day gi len
    # stack. Pop o day se lam IL mat can bang -> InvalidProgramException.
    out.append(f'    call void {_MARSHAL}::FreeHGlobal(native int)')
    out.append('    ldc.i4.0')
    out.append('    conv.i8')
    ctx.store_var(var_name, scope, out)
    out.append('    ldc.i4.0')
    ctx.store_var(f32buf_len_name(var_name), scope, out)
    out.append('    ldc.i4.0')
    return 1


def _try_lp_f32buf_free(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """LINE_PARSERS: `f32buf_free(b)` nhu 1 LENH DOC LAP."""
    m = _F32BUF_FREE_RE.match(line)
    if not m:
        return None
    return intern(make2('f32buf_free_stmt', m.group(1))), pos + 1


def _codegen_f32buf_free_stmt(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    if emit_f32buf_free(body, lay_str(stmt, 'name'), scope, ctx, body_dtype) == 0:
        raise SyntaxError(
            "il_codegen: f32buf_free(" + lay_str(stmt, 'name') + ") - '" +
            lay_str(stmt, 'name') + "' khong phai bien f32buf")
    # lenh doc lap: ket qua kieu i32 (0) van phai co tren stack de lam don,
    # giong moi lenh goi doc lap khac cua TokenVector.
    body.append('    pop')


def bootstrap_f32buf(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_assign_rhs_parser(reg, 'f32buf_new', try_rhs_f32buf_new)
    register_stmt_codegen(reg, 'assign_f32buf_new', codegen_assign_f32buf_new)
    register_first_pass_walk(reg, 'assign_f32buf_new', fpw_assign_f32buf_new)
    register_line_parser(reg, 'f32buf_free_stmt', _try_lp_f32buf_free)
    register_stmt_codegen(reg, 'f32buf_free_stmt', _codegen_f32buf_free_stmt)
