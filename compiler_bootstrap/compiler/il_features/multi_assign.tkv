# -*- coding: utf-8 -*-
"""Multi-target assignment (Moc 20, 2026-08-09): a = b = c = expr."""
import re
import stmt_row as _row
from il_dispatch import (
    register_line_parser, register_first_pass_walk, register_stmt_codegen
)
from tkv_types import TypeAnn
from stmt_row import intern, lay_ds_str, lay_nut, make3

__tkv_import__ = ["il_dispatch", "tkv_types"]

_TEN_HOP_LE_RE = re.compile(r'^[A-Za-z_]\w*$')


def _moi_target_hop_le(targets: "list[str]") -> "i32":
    """True neu MOI target la mot ten bien hop le.

    Tach khoi `_split_top_level_assigns` (truoc day la `all(re.match(...)
    for t in targets)`) vi generator expression khong thuoc tap cu phap
    ma TokenVector bien dich duoc."""
    for t in targets:
        if not _TEN_HOP_LE_RE.match(t):
            return False
    return True


def _split_top_level_assigns(line: "str") -> "(list[str],str)":
    """Tach 'a = b = c = 10' thanh targets ['a', 'b', 'c'] va rhs '10'.

    Tra ve (None, None) khi dong khong phai gan nhieu dich - cho goi duy
    nhat kiem `if not targets`."""
    parts = []
    current = []
    in_quote = False
    quote_char = None
    depth = 0

    i = 0
    while i < len(line):
        ch = line[i]
        if ch in ('"', "'"):
            if not in_quote:
                in_quote = True
                quote_char = ch
            elif quote_char == ch:
                in_quote = False
        elif not in_quote:
            if ch in ('(', '[', '{'):
                depth += 1
            elif ch in (')', ']', '}'):
                depth -= 1
            elif ch == '=' and depth == 0 and i + 1 < len(line) and line[i+1] != '=' and (i == 0 or line[i-1] not in ('=', '!', '<', '>')):
                parts.append(''.join(current).strip())
                current = []
                i += 1
                continue
        current.append(ch)
        i += 1
    parts.append(''.join(current).strip())

    if len(parts) >= 3:
        targets = parts[:-1]
        rhs = parts[-1]
        # Kiem tra tat ca targets la ten bien hop le
        if _moi_target_hop_le(targets):
            return targets, rhs
    return None, None


def try_parse_multi_assign(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """LINE_PARSERS entry: 'a = b = c = expr'.

    Luu dang HANG ARENA ('targets_text,rhs_text' - xem so do trong
    stmt_row.py) thay vi dict Python: hai bang so do cua stmt_row da lo
    san co che nay cho 'idx_assign' (rhs_text -> rhs_node tu parse khi
    doc) va 'tuple_assign' (targets_text -> danh sach ten)."""
    targets, rhs = _split_top_level_assigns(line.strip())
    if not targets:
        return None
    for t in targets:
        known_shapes[t] = None
    return intern(make3('assign_multi_target', ','.join(targets), rhs)), pos + 1


def fpw_assign_multi_target(stmt: "i32", ctx: "WalkCtx"):
    infer_scope = ctx.infer_scope
    records = ctx.records
    record_methods = ctx.record_methods
    func_table = ctx.func_table
    rhs_node = lay_nut(stmt, 'rhs_node')

    rhs_dtype = ctx.infer_dtype(rhs_node, infer_scope, func_table, records, record_methods, None)
    if not rhs_dtype:
        rhs_dtype = ctx.body_dtype
    ta = TypeAnn(rhs_dtype, None)
    for name in lay_ds_str(stmt, 'targets'):
        ctx.declare_named(name, ta)
    ctx.collect_ternary_temps(rhs_node)


def codegen_assign_multi_target(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    targets = lay_ds_str(stmt, 'targets')
    rhs_node = lay_nut(stmt, 'rhs_node')

    # Suy dtype cua target dau tien
    first_ta = scope.tra(targets[0]).ta
    rhs_dtype = first_ta.dtype

    ctx.compile_expr(rhs_node, scope, body, rhs_dtype, ctx)
    for name in targets[:-1]:
        body.append('    dup')
        ctx.store_var(name, scope, body)
    ctx.store_var(targets[-1], scope, body)


def bootstrap_multi_assign(reg: "Registry") -> "i32":
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh giong moi bootstrap_<module>() khac. Truoc day
    cac loi goi nay nam o CAP MODULE va con dung chu ky cu (thieu
    tham so `reg`) - phep kiem cua P6 chi quet cay .py nen khong
    nhin thay file CHI-CO-TKV nay.
    """
    register_line_parser(reg, 'multi_assign', try_parse_multi_assign)
    register_first_pass_walk(reg, 'assign_multi_target', fpw_assign_multi_target)
    register_stmt_codegen(reg, 'assign_multi_target', codegen_assign_multi_target)
    return 0
