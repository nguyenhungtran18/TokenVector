# -*- coding: utf-8 -*-
"""API datetime kieu Python tren kieu 'datetime'/'timedelta' co san (int64 ticks .NET) (2026-10-02).

Them vao `datetime_type.py`: datetime_make(y, m, d[, h, mi, s, us]), timedelta_make(days, hours, minutes, seconds),
thuoc tinh d.year/month/day/hour/minute/second/microsecond, td.days/seconds, phuong thuc d.weekday()/isoweekday()/date()/
isoformat(), td.total_seconds(), va in str(d)/str(td) dung dinh dang Python. Macro `datetime_py` (comprehension.py) dich
`datetime.datetime.now()`, `datetime.datetime(...)`, `timedelta(days=1)`... sang cac ham tren. `date` duoc bieu dien bang datetime luc 0 gio."""
from il_core import IL_SCALAR
from il_dispatch import register_expr_builtin, register_expr_method
from il_features.datetime_type import _compile_strftime
from tkv_types import TypeAnn
from expr_row import ea_str, eb_str, ec_ds


__tkv_import__ = ["il_dispatch", "tkv_types"]

_DT_CLASS = 'TkvDt'
_DT = 'valuetype [mscorlib]System.DateTime'
_STR = '[mscorlib]System.String'
_INV_DT = 'call class [mscorlib]System.Globalization.CultureInfo [mscorlib]System.Globalization.CultureInfo::get_InvariantCulture()'
_TICKS_DAY = '864000000000'


def _getter(ten: "str", prop: "str") -> "list[str]":
    return [
        f'  .method public static int32 {ten}(int64 t) cil managed',
        '  {',
        '    .maxstack 8',
        f'    .locals init ({_DT} d)',
        '    ldarg.0',
        '    newobj instance void [mscorlib]System.DateTime::.ctor(int64)',
        '    stloc.0',
        '    ldloca.s 0',
        f'    call instance int32 [mscorlib]System.DateTime::get_{prop}()',
        '    ret',
        '  }',
    ]


def _fmt_method(ten: "str", fmt: "str") -> "list[str]":
    """string ten(int64 t): ngay-gio theo `fmt`, them '.uuuuuu' neu micro-giay khac 0 (nhu str(datetime) cua Python)."""
    return [
        f'  .method public static string {ten}(int64 t) cil managed',
        '  {',
        '    .maxstack 8',
        f'    .locals init ({_DT} d, int64 us, string s)',
        '    ldarg.0',
        '    newobj instance void [mscorlib]System.DateTime::.ctor(int64)',
        '    stloc.0',
        '    ldloca.s 0',
        f'    ldstr "{fmt}"',
        '    ' + _INV_DT,
        '    call instance string [mscorlib]System.DateTime::ToString(string, class [mscorlib]System.IFormatProvider)',
        '    stloc.2',
        '    ldarg.0',
        '    ldc.i8 10000000',
        '    rem',
        '    ldc.i8 10',
        '    div',
        '    stloc.1',
        '    ldloc.1',
        '    brtrue DT_US',
        '    ldloc.2',
        '    ret',
        '  DT_US:',
        '    ldstr "{0}.{1:D6}"',
        '    ldloc.2',
        '    ldloc.1',
        '    box int64',
        f'    call string {_STR}::Format(string, object, object)',
        '    ret',
        '  }',
    ]


def _gen_class() -> "list[str]":
    c = []
    c.append('.class public auto ansi beforefieldinit TkvDt extends [mscorlib]System.Object')
    c.append('{')
    for ten, prop in [('Year', 'Year'), ('Month', 'Month'), ('Day', 'Day'), ('Hour', 'Hour'), ('Minute', 'Minute'), ('Second', 'Second')]:
        c.extend(_getter(ten, prop))
    # Microsecond
    c.extend([
        '  .method public static int32 Micro(int64 t) cil managed', '  {', '    .maxstack 8',
        '    ldarg.0', '    ldc.i8 10000000', '    rem', '    ldc.i8 10', '    div', '    conv.i4', '    ret', '  }',
    ])
    # Weekday (Mon=0) / IsoWeekday (Mon=1)
    for ten, extra in [('Weekday', []), ('IsoWeekday', ['    ldc.i4.1', '    add'])]:
        c.extend([
            f'  .method public static int32 {ten}(int64 t) cil managed', '  {', '    .maxstack 8',
            f'    .locals init ({_DT} d)',
            '    ldarg.0', '    newobj instance void [mscorlib]System.DateTime::.ctor(int64)', '    stloc.0', '    ldloca.s 0',
            '    call instance valuetype [mscorlib]System.DayOfWeek [mscorlib]System.DateTime::get_DayOfWeek()',
            '    ldc.i4.6', '    add', '    ldc.i4.7', '    rem',
        ] + extra + ['    ret', '  }'])
    # Date: cat ve 0 gio
    c.extend([
        '  .method public static int64 Date(int64 t) cil managed', '  {', '    .maxstack 8',
        '    ldarg.0', '    ldarg.0', f'    ldc.i8 {_TICKS_DAY}', '    rem', '    sub', '    ret', '  }',
    ])
    # Make(y, m, d, h, mi, s, us)
    c.extend([
        '  .method public static int64 Make(int32 y, int32 m, int32 d, int32 h, int32 mi, int32 s, int32 us) cil managed',
        '  {', '    .maxstack 8', f'    .locals init ({_DT} v)',
        '    ldarg.0', '    ldarg.1', '    ldarg.2', '    ldarg.3', '    ldarg.s 4', '    ldarg.s 5',
        '    newobj instance void [mscorlib]System.DateTime::.ctor(int32, int32, int32, int32, int32, int32)',
        '    stloc.0', '    ldloca.s 0', '    call instance int64 [mscorlib]System.DateTime::get_Ticks()',
        '    ldarg.s 6', '    conv.i8', '    ldc.i8 10', '    mul', '    add', '    ret', '  }',
    ])
    c.extend([
        '  .method public static int64 Parse(string s) cil managed', '  {', '    .maxstack 8', f'    .locals init ({_DT} v)',
        '    ldarg.0', '    ' + _INV_DT,
        '    call valuetype [mscorlib]System.DateTime [mscorlib]System.DateTime::Parse(string, class [mscorlib]System.IFormatProvider)',
        '    stloc.0', '    ldloca.s 0', '    call instance int64 [mscorlib]System.DateTime::get_Ticks()', '    ret', '  }',
    ])
    c.extend([
        '  .method public static int64 Today() cil managed', '  {', '    .maxstack 8', f'    .locals init ({_DT} v)',
        '    call valuetype [mscorlib]System.DateTime [mscorlib]System.DateTime::get_Today()',
        '    stloc.0', '    ldloca.s 0', '    call instance int64 [mscorlib]System.DateTime::get_Ticks()', '    ret', '  }',
    ])
    c.extend(_fmt_method('Str', 'yyyy-MM-dd HH:mm:ss'))
    c.extend(_fmt_method('Iso', "yyyy-MM-dd'T'HH:mm:ss"))
    c.extend([
        '  .method public static string DStr(int64 t) cil managed', '  {', '    .maxstack 8', f'    .locals init ({_DT} d)',
        '    ldarg.0', '    newobj instance void [mscorlib]System.DateTime::.ctor(int64)', '    stloc.0', '    ldloca.s 0',
        '    ldstr "yyyy-MM-dd"', '    ' + _INV_DT,
        '    call instance string [mscorlib]System.DateTime::ToString(string, class [mscorlib]System.IFormatProvider)', '    ret', '  }',
    ])
    # timedelta: days (floor), seconds (0..86399), total_seconds, str
    c.extend([
        '  .method public static int32 TdDays(int64 t) cil managed', '  {', '    .maxstack 8', '    .locals init (int64 q)',
        '    ldarg.0', f'    ldc.i8 {_TICKS_DAY}', '    div', '    stloc.0',
        '    ldarg.0', f'    ldc.i8 {_TICKS_DAY}', '    rem', '    ldc.i8 0', '    bge TD_P',
        '    ldloc.0', '    ldc.i8 1', '    sub', '    stloc.0',
        '  TD_P:', '    ldloc.0', '    conv.i4', '    ret', '  }',
        '  .method public static int32 TdSeconds(int64 t) cil managed', '  {', '    .maxstack 8', '    .locals init (int64 r)',
        '    ldarg.0', f'    ldc.i8 {_TICKS_DAY}', '    rem', '    stloc.0',
        '    ldloc.0', '    ldc.i8 0', '    bge TS_P',
        '    ldloc.0', f'    ldc.i8 {_TICKS_DAY}', '    add', '    stloc.0',
        '  TS_P:', '    ldloc.0', '    ldc.i8 10000000', '    div', '    conv.i4', '    ret', '  }',
        '  .method public static float64 TotalSeconds(int64 t) cil managed', '  {', '    .maxstack 8',
        '    ldarg.0', '    conv.r8', '    ldc.r8 10000000.0', '    div', '    ret', '  }',
    ])
    # TdStr: "[N day(s), ]H:MM:SS[.uuuuuu]"
    c.extend([
        '  .method public static string TdStr(int64 t) cil managed', '  {', '    .maxstack 8',
        '    .locals init (int32 days, int64 r, string s, int64 us)',
        '    ldarg.0', f'    call int32 {_DT_CLASS}::TdDays(int64)', '    stloc.0',
        '    ldarg.0', '    ldloc.0', '    conv.i8', f'    ldc.i8 {_TICKS_DAY}', '    mul', '    sub', '    stloc.1',
        '    ldstr "{0}:{1:D2}:{2:D2}"',
        '    ldloc.1', '    ldc.i8 36000000000', '    div', '    conv.i4', '    box int32',
        '    ldloc.1', '    ldc.i8 600000000', '    div', '    ldc.i8 60', '    rem', '    conv.i4', '    box int32',
        '    ldloc.1', '    ldc.i8 10000000', '    div', '    ldc.i8 60', '    rem', '    conv.i4', '    box int32',
        f'    call string {_STR}::Format(string, object, object, object)', '    stloc.2',
        '    ldloc.1', '    ldc.i8 10000000', '    rem', '    ldc.i8 10', '    div', '    stloc.3',
        '    ldloc.3', '    brfalse TDS_NOUS',
        '    ldstr "{0}.{1:D6}"', '    ldloc.2', '    ldloc.3', '    box int64',
        f'    call string {_STR}::Format(string, object, object)', '    stloc.2',
        '  TDS_NOUS:',
        '    ldloc.0', '    brtrue TDS_DAY', '    ldloc.2', '    ret',
        '  TDS_DAY:',
        '    ldstr "{0} day{1}, {2}"', '    ldloc.0', '    box int32',
        '    ldloc.0', '    ldc.i4.1', '    beq TDS_S1', '    ldloc.0', '    ldc.i4.m1', '    beq TDS_S1',
        '    ldstr "s"', '    br TDS_S2', '  TDS_S1:', '    ldstr ""', '  TDS_S2:',
        '    ldloc.2',
        f'    call string {_STR}::Format(string, object, object, object)', '    ret', '  }',
    ])
    c.append('}')
    return c


def ensure_class_dt(ctx: "Ctx"):
    if ctx.emitted_types is None or _DT_CLASS in ctx.emitted_types:
        return
    ctx.emitted_types.add(_DT_CLASS)
    ctx.extra_classes.append(_gen_class())


def push_datetime_make(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) < 3 or len(args) > 7:
        raise SyntaxError("il_codegen: datetime(y, m, d[, h, mi, s, us]) can 3..7 tham so nguyen")
    ensure_class_dt(ctx)
    for i in range(7):
        if i < len(args):
            ctx.compile_expr(args[i], scope, out, 'i32', ctx)
        else:
            out.append('    ldc.i4.0')
    out.append(f'    call int64 {_DT_CLASS}::Make(int32, int32, int32, int32, int32, int32, int32)')


def push_date_make(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 3:
        raise SyntaxError("il_codegen: date(y, m, d) can 3 tham so nguyen")
    ensure_class_dt(ctx)
    for i in range(3):
        ctx.compile_expr(args[i], scope, out, 'i32', ctx)
    for _ in range(4):
        out.append('    ldc.i4.0')
    out.append(f'    call int64 {_DT_CLASS}::Make(int32, int32, int32, int32, int32, int32, int32)')


def push_datetime_fromisoformat(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 1:
        raise SyntaxError("il_codegen: datetime.fromisoformat(s) can 1 tham so chuoi")
    ensure_class_dt(ctx)
    ctx.compile_expr(args[0], scope, out, 'str', ctx)
    out.append(f'    call int64 {_DT_CLASS}::Parse(string)')


def push_date_today(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 0:
        raise SyntaxError("il_codegen: date_today() khong nhan tham so")
    ensure_class_dt(ctx)
    out.append(f'    call int64 {_DT_CLASS}::Today()')


def push_timedelta_make(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if len(args) != 4:
        raise SyntaxError("il_codegen: timedelta_make(days, hours, minutes, seconds) can 4 tham so")
    he_so = ['864000000000', '36000000000', '600000000', '10000000']
    for i in range(4):
        ctx.compile_expr(args[i], scope, out, 'i64', ctx)
        out.append(f'    ldc.i8 {he_so[i]}')
        out.append('    mul')
        if i > 0:
            out.append('    add')


def _ham_dt(ten: "str") -> "str":
    if ten == 'year':
        return 'Year'
    if ten == 'month':
        return 'Month'
    if ten == 'day':
        return 'Day'
    if ten == 'hour':
        return 'Hour'
    if ten == 'minute':
        return 'Minute'
    if ten == 'second':
        return 'Second'
    if ten == 'microsecond':
        return 'Micro'
    return ''


def _ham_td(ten: "str") -> "str":
    if ten == 'days':
        return 'TdDays'
    if ten == 'seconds':
        return 'TdSeconds'
    return ''


def dt_attr_dtype(obj_dtype: "str", ten: "str") -> "str":
    """dtype cua obj.ten khi obj la datetime/timedelta; '' neu khong phai thuoc tinh ho tro."""
    if (obj_dtype == 'datetime' or obj_dtype == 'date') and _ham_dt(ten) != '':
        return 'i32'
    if obj_dtype == 'timedelta' and _ham_td(ten) != '':
        return 'i32'
    return ''


def compile_dt_attr(obj_name: "str", ten: "str", obj_dtype: "str", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    if dt_attr_dtype(obj_dtype, ten) == '':
        raise SyntaxError(f"il_codegen: '{obj_name}.{ten}' khong phai thuoc tinh ho tro cua {obj_dtype} (year/month/day/hour/minute/second/microsecond, days/seconds)")
    ensure_class_dt(ctx)
    ham = _ham_td(ten)
    if obj_dtype == 'datetime' or obj_dtype == 'date':
        ham = _ham_dt(ten)
    ctx.load_var_ref(obj_name, scope, out)
    out.append(f'    call int32 {_DT_CLASS}::{ham}(int64)')
    ctx.widen_if_needed('i32', dtype, out)


def la_dtype_ngay_gio(d: "str") -> "i32":
    return d == 'datetime' or d == 'date' or d == 'timedelta'


def hop_kieu_ngay_gio(op: "str", l: "str", r: "str") -> "str":
    """dtype cua `l op r` khi mot ben la datetime/date/timedelta (Python): dt/date +- td -> dt/date, dt-dt -> td, td +- td -> td,
    td * int, td // int -> td. '' neu khong thuoc cac quy tac nay."""
    if op == '+':
        if (l == 'datetime' or l == 'date') and r == 'timedelta':
            return l
        if l == 'timedelta' and (r == 'datetime' or r == 'date'):
            return r
        if l == 'timedelta' and r == 'timedelta':
            return 'timedelta'
        return ''
    if op == '-':
        if (l == 'datetime' or l == 'date') and r == 'timedelta':
            return l
        if (l == 'datetime' and r == 'datetime') or (l == 'date' and r == 'date'):
            return 'timedelta'
        if l == 'timedelta' and r == 'timedelta':
            return 'timedelta'
        return ''
    if op == '*' or op == '//':
        if l == 'timedelta' and r != 'timedelta' and not la_dtype_ngay_gio(r):
            return 'timedelta'
        if op == '*' and r == 'timedelta' and not la_dtype_ngay_gio(l):
            return 'timedelta'
    return ''


def _method_goi(spec: "str") -> "func(TkvNode,Scope,list[str],str,Ctx)->void":
    """spec = 'TenHam kieu_IL_tra_ve' (vd 'Weekday int32') - mot bien bat duy nhat vi `nonlocal` chi nhan mot ten."""
    def f(node: "TkvNode", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
        nonlocal spec
        if len(ec_ds(node)) != 0:
            raise SyntaxError(f"il_codegen: '.{eb_str(node)}()' khong nhan tham so")
        ensure_class_dt(ctx)
        ctx.load_var_ref(ea_str(node), scope, out)
        phan = spec.split(' ')
        out.append(f'    call {phan[1]} {_DT_CLASS}::{phan[0]}(int64)')
    return f


def bootstrap_datetime_py(reg: "Registry"):
    IL_SCALAR['date'] = 'int64'
    register_expr_method(reg, 'date', 'strftime', _compile_strftime, 'str')
    register_expr_builtin(reg, 'datetime_make', push_datetime_make, 'datetime')
    register_expr_builtin(reg, 'timedelta_make', push_timedelta_make, 'timedelta')
    register_expr_builtin(reg, 'date_make', push_date_make, 'date')
    register_expr_builtin(reg, 'date_today', push_date_today, 'date')
    register_expr_builtin(reg, 'datetime_fromisoformat', push_datetime_fromisoformat, 'datetime')
    register_expr_method(reg, 'datetime', 'weekday', _method_goi('Weekday int32'), 'i32')
    register_expr_method(reg, 'datetime', 'isoweekday', _method_goi('IsoWeekday int32'), 'i32')
    register_expr_method(reg, 'datetime', 'date', _method_goi('Date int64'), 'date')
    register_expr_method(reg, 'date', 'weekday', _method_goi('Weekday int32'), 'i32')
    register_expr_method(reg, 'date', 'isoweekday', _method_goi('IsoWeekday int32'), 'i32')
    register_expr_method(reg, 'date', 'isoformat', _method_goi('DStr string'), 'str')
    register_expr_method(reg, 'datetime', 'isoformat', _method_goi('Iso string'), 'str')
    register_expr_method(reg, 'timedelta', 'total_seconds', _method_goi('TotalSeconds float64'), 'f64')
