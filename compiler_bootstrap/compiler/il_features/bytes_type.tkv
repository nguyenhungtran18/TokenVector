# -*- coding: utf-8 -*-
"""Kieu 'bytes' (muc 6.8, 4/4, 2026-08-13) - literal b"..." ASCII, BAT
BIEN. Tai dung 100% ha tang List<uint8> cua 'bytearray' (bytearray_type.py,
commit 3773217) cho ca kieu IL LAN doc (index/len/for-in) - CHI khac o
2 diem: (1) tao ra bang cach unroll N gia tri hang so biet truoc luc
gan bien MOI (khong '.append()' runtime), (2) '.append()'/mutate BI CHAN
hoan toan (SyntaxError) vi Python that 'bytes' bat bien.

Dieu tra Step 1 (2026-08-13) phat hien: KHONG co san 1 ham unescape
str_lit rieng biet o phia Python de tai dung - 'str_lit' (STR token cua
il_core.py) duoc GIU NGUYEN CA DAU NGOAC va cac escape (vd '\\n') ngay
tu tokenizer, chuyen THANG cho 'ldstr' trong IL (xem
il_features/string_feature.py's compile_str_lit: 'ldstr {node[1]}') -
IL ldstr chap nhan cu phap escape gan giong C tren chinh chuoi tho do,
nen phia Python KHONG BAO GIO thuc su giai ma escape thanh gia tri
ky tu that. Vi bytes literal can GIA TRI BYTE THAT (ord() cua tung ky
tu) de unroll thanh hang so IL luc compile-time (khac ldstr - ldstr
giao het viec giai ma escape cho runtime .NET), KHONG the tai dung
'nguyen ham' nay - file nay tu viet 1 unescape TOI THIEU (chi cac escape
pho bien: \\\\ \\" \\n \\t \\r \\0 \\xHH), dung PHAM VI cua task (chi
b"..." literal ASCII gan truc tiep bien moi).

LECH SO VOI KE HOACH (plan 2026-08-13-bytes.md): plan de xuat mo rong
'declare_scalar' (il_codegen.py, dong ~2734) voi 1 nhanh 'bytes_lit'.
Dieu tra THAT cho thay 'declare_scalar' CHI la fallback cuoi cung cua
duong gan bien (_lp_assign trong il_codegen.py) - moi container literal
(list_literal, bytearray()) di theo duong RIENG qua ASSIGN_RHS_PARSERS/
FIRST_PASS_WALK/STMT_CODEGEN (dang ky boi list_type.py/bytearray_type.py),
KHONG BAO GIO cham toi declare_scalar. File nay di THEO DUNG kien truc
THAT (giong het bytearray_type.py) thay vi them nhanh vao declare_scalar
- gan bien moi 'data = b"AB"' duoc bat boi try_rhs_bytes_literal (dang
ky vao ASSIGN_RHS_PARSERS), KHONG BAO GIO roi toi assign_scalar/
declare_scalar."""



__tkv_import__ = ["il_dispatch", "tkv_types"]



import stmt_row as _row
import re

from il_core import parse_expr, parse_bytes_literal
from il_dispatch import (
    register_assign_rhs_parser, register_line_parser,
    register_stmt_codegen, register_first_pass_walk,
)
from il_features.bytearray_type import il_bytearray_type
from tkv_types import TypeAnn
from stmt_row import intern, lay_ds_byte, lay_str, make3
from expr_row import ea_str, ekind


_BYTES_LIT_RE = re.compile(r'^b"(?:[^"\\]|\\.)*"\s*$')
_BYTES_APPEND_RE = re.compile(r'^(\w+)\.append\((.+)\)\s*$')


def try_rhs_bytes_literal(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    """ASSIGN_RHS_PARSERS entry: 'data = b"AB"' - literal ASCII gan TRUC
    TIEP vao bien MOI (khong constructor bytes(x)/noi '+', ngoai pham vi
    task theo dung Global Constraints cua plan). Dung PARSER THAT
    (parse_expr, tag 'bytes_lit' vua them vao il_core.py's
    _parse_factor_primary), giong het cach try_rhs_list_literal lam voi
    'list_literal'."""
    rhs_s = rhs.strip()
    if not _BYTES_LIT_RE.match(rhs_s):
        return None
    node = parse_expr(rhs_s)
    if ekind(node) != 'bytes_lit':
        return None
    known_shapes[name] = 'bytes'
    values = parse_bytes_literal(ea_str(node))
    return intern(make3('assign_bytes_literal', name, rhs_s))


def try_parse_bytes_append_blocked(reg: "Registry", line: "str", lines: "list[(i32,str)]", pos: "i32", indent_level: "i32", sig: "TkvSig", known_shapes: "dict[str,str]", parse_block_fn: "func(list[(i32,str)], i32, i32, TkvSig, dict[str,str])->(list[i32], i32)") -> "(i32,i32)":
    """LINE_PARSERS entry: chan '.append()' tren bien 'bytes' NGAY tai
    parser - PHAI dang ky TRUOC list_append/bytearray_append (thu tu dang
    ky trong LINE_PARSERS quyet dinh thu tu thu, giong het cach
    bytearray_type.py's try_parse_bytearray_append phai dang ky truoc de
    khong bi list.append 'cuop' - o day NGUOC LAI: bytes phai tu CHAN
    truoc khi list_append/bytearray_append kip khop, vi 'bytes' la bat
    bien, KHAC bytearray van cho .append() binh thuong)."""
    m = _BYTES_APPEND_RE.match(line)
    if not m or known_shapes.get(m.group(1)) != 'bytes':
        return None
    raise SyntaxError(
        f"il_codegen: '{m.group(1)}' la kieu 'bytes' (bat bien, tao tu literal "
        f"b\"...\") - KHONG the .append()/mutate. Dung 'bytearray' neu can thay doi duoc.")


def codegen_assign_bytes_literal(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'data = b"AB"' - unroll N gia tri hang so BIET
    TRUOC luc compile-time thanh N lan 'dup'+'ldc.i4'+'conv.u1'+'Add(!0)'
    (KHONG vong lap runtime - so phan tu da co san luc bien dich), theo
    mau codegen_assign_bytearray_new + codegen_bytearray_append cua
    bytearray_type.py nhung GHEP THANG khong qua stmt trung gian."""
    body.append(f'    newobj instance void {il_bytearray_type()}::.ctor()')
    for value in lay_ds_byte(stmt, 'values'):
        body.append('    dup')
        body.append(f'    ldc.i4 {value}')
        body.append('    conv.u1')
        body.append(f'    callvirt instance void {il_bytearray_type()}::Add(!0)')
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def fpw_assign_bytes_literal(stmt: "i32", ctx: "WalkCtx"):
    """FIRST_PASS_WALK: khai bao local List<uint8> voi shape='bytes'
    (KHAC 'bytearray' - il_type_str/_expr_index/len() se can nhan them
    'bytes' o cac diem doc, xem il_codegen.py; '.append()' thi KHONG
    bao gio toi duoc codegen vi da bi chan o parser, try_parse_bytes_append_blocked)."""
    ctx.declare_named(lay_str(stmt, 'name'), TypeAnn('i32', 'bytes'))


# ================= CONSTRUCTOR bytes(...) =================
# Port tu compiler/il_features/bytes_type.tkv (bootstrap) L177-289. Chu y:
# KHONG dung raw.encode('utf-8') nhu ban bootstrap - tren duong
# TokenVector `.encode` KHONG co o compiler tu-host. Thay bang _decode_and_utf8
# thu cong: giai ma escape, ord tung char, encode UTF-8 bang cong thuc
# so hoc (khong dung .encode/int() de tranh tran compiler).

_BYTES_REPEAT_RE = re.compile(r'^bytes\(\s*(\d+)\s*\)\s*$')
_BYTES_STR_RE = re.compile(r'^bytes\(\s*("(?:[^"\\]|\\.)*")\s*,\s*("(?:[^"\\]|\\.)*"|\'(?:[^\'\\]|\\.)*\')\s*\)\s*$')
_BYTES_STR_VAR_RE = re.compile(r'^bytes\(\s*(\w+)\s*,\s*("(?:[^"\\]|\\.)*"|\'(?:[^\'\\]|\\.)*\')\s*\)\s*$')
_BYTES_LIST_RE = re.compile(r'^bytes\(\s*\[([^\[\]]*)\]\s*\)\s*$')


def _encoding_ok(enc_text: "str") -> "i32":
    """True neu tham so ma hoa la chuoi literal 'utf-8' (hoa thuong)."""
    e = enc_text.strip().strip('"').strip("'").lower().replace('-', '')
    if e in ('utf8', 'u8'):
        return True
    raise SyntaxError(
        f"il_codegen: bytes(chuoi, ma-hoa) - chi ho tro 'utf-8' trong giai "
        f"doan, nhan '{enc_text.strip()}'. Ma hoa khac can ep thanh byte thu "
        f"cong o bien dich rieng.")


def _push_utf8_of(c: "i32", out: "list[i32]"):
    """Encode 1 code point Unicode thanh 1-4 byte UTF-8. Khong dung .encode:
    bang cac phep tinh so hoc thuan (i32), tiec bus big-fast. c phai >= 0 va
    < 0x110000 (ord của char)."""
    if c < 128:
        out.append(c)
    elif c < 2048:
        out.append(192 + c // 64)
        out.append(128 + c % 64)
    elif c < 65536:
        out.append(224 + c // 4096)
        out.append(128 + (c // 64) % 64)
        out.append(128 + c % 64)
    else:
        out.append(240 + c // 262144)
        out.append(128 + (c // 4096) % 64)
        out.append(128 + (c // 64) % 64)
        out.append(128 + c % 64)


def _decode_and_utf8(raw: "str") -> "list[i32]":
    """raw: noi dung giua 2 dau nhay cua 1 string literal (con nguyen escape).
    Giai ma cac escape pho bien (\\ \\" \\n \\t \\r \\0 \\xHH), roi encode
    tung code point thanh byte UTF-8. Tra ve list[i32] cac byte.
    KHONG phai truong hop escape lai: goi truc tiep."""
    out: "list[i32]" = []
    i = 0
    n = len(raw)
    while i < n:
        ch = raw[i]
        if ch == '\\' and i + 1 < n:
            nxt = raw[i + 1]
            if nxt == 'x' and i + 3 < n:
                hex_digits = raw[i + 2:i + 4]
                hex_val = int(hex_digits, 16)
                _push_utf8_of(hex_val, out)
                i = i + 4
                continue
            if nxt == '0':
                out.append(0)
                i = i + 2
                continue
            if nxt == 'n':
                out.append(10)
                i = i + 2
                continue
            if nxt == 't':
                out.append(9)
                i = i + 2
                continue
            if nxt == 'r':
                out.append(13)
                i = i + 2
                continue
            if nxt == '\\':
                out.append(92)
                i = i + 2
                continue
            if nxt == '"':
                out.append(34)
                i = i + 2
                continue
            if nxt == "'":
                out.append(39)
                i = i + 2
                continue
            _push_utf8_of(ord(nxt), out)
            i = i + 2
            continue
        _push_utf8_of(ord(ch), out)
        i = i + 1
    return out


def try_rhs_bytes_new(rhs: "str", name: "str", known_shapes: "dict[str,str]") -> "i32":
    """ASSIGN_RHS_PARSERS entry: 'b = bytes(...)' cua bootstrap tu trunk."""
    s = rhs.strip()
    m = _BYTES_REPEAT_RE.match(s)
    if m:
        known_shapes[name] = 'bytes'
        return intern(make3('assign_bytes_new', name, s))
    m = _BYTES_STR_RE.match(s)
    if m:
        _encoding_ok(m.group(2))
        node = parse_expr(m.group(1))
        if ekind(node) != 'str_lit':
            return None
        known_shapes[name] = 'bytes'
        return intern(make3('assign_bytes_new', name, s))
    m = _BYTES_STR_VAR_RE.match(s)
    if m:
        _encoding_ok(m.group(2))
        raise SyntaxError(
            "il_codegen: bytes(<bien chuoi>, \"utf-8\") - duong chay (dung "
            "Encoding.UTF8.GetBytes) CHUA san: `List<byte>` khong co ctor "
            "nhan IEnumerable ma `List<int>` co, nen bien dich duoc roi chay "
            "thi nem EntryPointNotFoundException. Hay truyen CHUOI LITERAL "
            "(bytes(\"abc\", \"utf-8\")) - duong do giai ma ngay luc bien dich.")
    m = _BYTES_LIST_RE.match(s)
    if m:
        known_shapes[name] = 'bytes'
        return intern(make3('assign_bytes_new', name, s))
    return None


def codegen_assign_bytes_new(stmt: "i32", scope: "Scope", body: "list[str]", body_dtype: "str", ctx: "Ctx", sig: "TkvSig", codegen_stmts_fn: "func(list[i32], Scope, list[str], str, Ctx, TkvSig)->void"):
    """STMT_CODEGEN entry: 'data = bytes(...)' - moi hinh thuc deu unroll
    N gia tri THUC (count 0 va count literal) thanh N lan 'dup'+'ldc.i4'+
    'conv.u1'+'Add(!0)', theo mau byte literal (see code gen assign_bytes_literal)."""
    rhs = lay_str(stmt, 'values_text').strip()
    m = _BYTES_REPEAT_RE.match(rhs)
    if m:
        values: "list[i32]" = []
        for i in range(int(m.group(1))):
            values.append(0)
    else:
        m = _BYTES_STR_RE.match(rhs)
        if m:
            q = m.group(1)
            values = _decode_and_utf8(q[1:-1])
        else:
            m = _BYTES_LIST_RE.match(rhs)
            if m:
                values = []
                parts = m.group(1).split(',')
                for piece in parts:
                    p = piece.strip()
                    if p:
                        values.append(int(p))
            else:
                raise SyntaxError(f"il_codegen: assign_bytes_new khong khop dang bytes(...): {rhs}")
    body.append(f'    newobj instance void {il_bytearray_type()}::.ctor()')
    for value in values:
        body.append('    dup')
        body.append(f'    ldc.i4 {value}')
        body.append('    conv.u1')
        body.append(f'    callvirt instance void {il_bytearray_type()}::Add(!0)')
    ctx.store_var(lay_str(stmt, 'name'), scope, body)


def fpw_assign_bytes_new(stmt: "i32", ctx: "WalkCtx"):
    ctx.declare_named(lay_str(stmt, 'name'), TypeAnn('i32', 'bytes'))


def bootstrap_bytes_type(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_assign_rhs_parser(reg, 'bytes_literal', try_rhs_bytes_literal)
    register_line_parser(reg, 'bytes_append_blocked', try_parse_bytes_append_blocked)
    register_stmt_codegen(reg, 'assign_bytes_literal', codegen_assign_bytes_literal)
    register_first_pass_walk(reg, 'assign_bytes_literal', fpw_assign_bytes_literal)
    register_assign_rhs_parser(reg, 'bytes_new', try_rhs_bytes_new)
    register_stmt_codegen(reg, 'assign_bytes_new', codegen_assign_bytes_new)
    register_first_pass_walk(reg, 'assign_bytes_new', fpw_assign_bytes_new)
