# -*- coding: utf-8 -*-
"""Khoi vector 8 lane f32 (P1, 2026-09-23) - SIMD thu cong bang struct.

PORT tu compiler/il_features/vector_block.tkv (2026-10-06). Doi ten de
tranh trung sau gop (trung ten ham = loi build): `ensure_class` ->
`ensure_class_vectorblock` (tkvstr.tkv da co `ensure_class`),
`scratch_locals` -> `scratch_locals_vectorblock` (int_type.tkv da co),
`register_vector_dtype` giu nguyen (chua trung) va goi trong
bootstrap_vector_block nhu complex_type lam.

`_literal_int`: khong dung isinstance (chua dang ky) va int(s, 0) (chi
ho tro base 2/8/10/16) - dung ekind/ea_str + kiem chu so + int(s).
`_push_lanewise`: khong dung `for arg, op in zip(...)` (tuple-unpack
trong for) - dung vong while theo chi so.
"""

from il_core import IL_SCALAR
from il_dispatch import register_expr_builtin
from expr_row import ea_str, ekind
from tkv_types import TypeAnn

__tkv_import__ = "il_dispatch"

VEC_W = 8
VEC_DTYPE = 'f32x8'
VEC_CLASS = 'VBuf8'
VEC_LOCAL = '__vbuf8'
VEC_IL = f'valuetype {VEC_CLASS}'


def register_vectorblock_dtype():
    """Goi luc bootstrap - dang ky 'f32x8' vao bang kieu IL dung chung."""
    IL_SCALAR[VEC_DTYPE] = f'valuetype {VEC_CLASS}'


def scratch_locals_vectorblock() -> "list[(str,str)]":
    """(ten, dtype) local nhap - GIU LAI de tai lieu nhung KHONG goi vo
    dieu kien: class VBuf8 chi duoc phat khi co v_* that su (ensure lazily),
    nen khai bao local vo dieu kien se tao .locals dan toi class chua phat
    -> ilasm hong. Dung _temps_vbuf ben duoi (declare-on-use qua temps_fn)."""
    return [(VEC_LOCAL, VEC_DTYPE)]


def _declare_vbuf(ctx: "WalkCtx"):
    if VEC_LOCAL not in ctx.declared_names:
        ctx.declared_names.add(VEC_LOCAL)
        ta = TypeAnn('f32x8', None)
        ctx.locals_decl.append((VEC_LOCAL, ta))
        ctx.infer_scope.set(VEC_LOCAL, ta)


def _temps_vbuf(node: "TkvNode", ctx: "WalkCtx"):
    """temps_fn cho moi builtin v_*: khai bao __vbuf8 khi ham that su dung
    khoi vector (declare-on-use, giong cach find_first_append_dtype quet
    .add cho set/list nhung don gian hon vi khong can suy kieu)."""
    _declare_vbuf(ctx)


def _vb_op1_method(d: "list[str]", method: "str", ilop: "str"):
    """Chen 1 method `v.fN = v.fN <ilop> x` vao dong class `d`.

    `cil managed aggressiveinlining` (2026-10-13) - BAT BUOC. Than method
    nay ~60 byte IL, VUOT ha nguong inline mac dinh cua JIT (~32 byte) nen
    KHONG duoc inline -> moi phep vector la MOT CALL THAT. Do la ly do do
    2026-10-13: ban goi 1 method nay CHAM HON ban 8 vong lap phep scalar
    inline (223 ms -> 278 ms) du IL mat 9x. `aggressiveinlining` noi
    bien nguong, cho phep SLP vector hoa than method.

    `ldfld` POP con tro khoi stack nen day `ldarg.1` HAI LAN: mot cho
    `ldfld` doc, mot con lai cho `stfld` ghi (2026-10-13).
    """
    d.append('  .method assembly static void ' + method + '(float32 x, '
             + VEC_IL + '& v)')
    d.append('    cil managed aggressiveinlining')
    d.append('  {')
    lane = 0
    while lane < VEC_W:
        d.append('    ldarg.1')
        d.append('    ldarg.1')
        d.append('    ldfld float32 ' + VEC_CLASS + '::f' + str(lane))
        d.append('    ldarg.0')
        d.append('    ' + ilop)
        d.append('    stfld float32 ' + VEC_CLASS + '::f' + str(lane))
        lane = lane + 1
    d.append('    ret')
    d.append('  }')
    d.append('')


def _vb_muladd_method(d: "list[str]"):
    """`v_mul8_add8(x, y)`: v.fN = v.fN * x + y - 8 lane, MOT lenh goi."""
    d.append('  .method assembly static void MulAddS(float32 x, float32 y, '
             + VEC_IL + '& v)')
    d.append('    cil managed aggressiveinlining')
    d.append('  {')
    lane = 0
    while lane < VEC_W:
        d.append('    ldarg.2')
        d.append('    ldarg.2')
        d.append('    ldfld float32 ' + VEC_CLASS + '::f' + str(lane))
        d.append('    ldarg.0')
        d.append('    mul')
        d.append('    ldarg.1')
        d.append('    add')
        d.append('    stfld float32 ' + VEC_CLASS + '::f' + str(lane))
        lane = lane + 1
    d.append('    ret')
    d.append('  }')
    d.append('')


def _vb_fill_method(d: "list[str]"):
    """`v_fill8(x)`: v.fN = x - 8 lane, MOT lenh goi."""
    d.append('  .method assembly static void FillS(float32 x, ' + VEC_IL + '& v)')
    d.append('    cil managed aggressiveinlining')
    d.append('  {')
    lane = 0
    while lane < VEC_W:
        d.append('    ldarg.1')
        d.append('    ldarg.0')
        d.append('    stfld float32 ' + VEC_CLASS + '::f' + str(lane))
        lane = lane + 1
    d.append('    ret')
    d.append('  }')
    d.append('')


def ensure_class_vectorblock(ctx: "Ctx"):
    """Chen class VBuf8 vao assembly MOT LAN (khuon int_type.ensure_class_int).

    2026-10-13: them 5 method tinh ca 8 lane (AddS/SubS/MulS/MulAddS/FillS).
    Xem `_vb_op1_method` ly do `aggressiveinlining`.
    """
    emitted = ctx.emitted_types
    if emitted is None or VEC_CLASS in emitted:
        return
    emitted.add(VEC_CLASS)
    d = []
    d.append('.class private auto ansi sequential ' + VEC_CLASS)
    d.append('       extends [mscorlib]System.ValueType')
    d.append('{')
    lane = 0
    while lane < VEC_W:
        d.append('  .field public float32 f' + str(lane))
        lane = lane + 1
    d.append('')
    _vb_op1_method(d, 'AddS', 'add')
    _vb_op1_method(d, 'SubS', 'sub')
    _vb_op1_method(d, 'MulS', 'mul')
    _vb_muladd_method(d)
    _vb_fill_method(d)
    d.append('}')
    ctx.extra_classes.append([chr(10).join(d)])


def _local_idx_vectorblock(scope: "Scope") -> "i32":
    """Chi so IL cua dem xuong __vbuf8 trong ham dang bien dich."""
    if VEC_LOCAL not in scope:
        raise SyntaxError(
            f'il_codegen: khoi vector ({VEC_DTYPE}) - local "{VEC_LOCAL}" chua '
            f'duoc khai bao trong ham nay (co the ham nay duoc sinh truc tiep '
            f'boi 1 duong khong qua _first_pass_collect_locals).')
    return scope.tra(VEC_LOCAL).idx


def _vb_addr(p_node: "TkvNode", ofs_node: "TkvNode", lane_byte_off: "i32", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """Day 'native int' cua p + ofs + lane_byte_off len stack.

    `ofs` tinh theo BYTE - giong het read_f32/write_f32/read_i32/... o
    nativebuf.tkv."""
    ctx.compile_expr(p_node, scope, out, 'i64', ctx)
    _ofs_native(ofs_node, scope, out, ctx)
    out.append('    add')
    if lane_byte_off:
        out.append(f'    ldc.i4.s {lane_byte_off}')
        out.append('    conv.i8')
        out.append('    add')
    out.append('    conv.i')


def _ofs_native(ofs_node: "TkvNode", scope: "Scope", out: "list[str]", ctx: "Ctx"):
    """Offset byte len dang `native int` (i64) - dung thang, KHONG hep ve i32."""
    ctx.compile_expr(ofs_node, scope, out, 'i64', ctx)


def _ldflda(idx: "i32", lane: "i32", out: "list[str]"):
    """Day dia chi QUAN LY cua lane -> float32&."""
    out.append(f'    ldloca.s {idx}')
    out.append(f'    ldflda float32 {VEC_CLASS}::f{lane}')


def push_v_load8(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_load8(p, off)' - nap 8 lane (32 byte) tu dia chi native, `off`
    tinh theo BYTE nhu read_f32/write_f32, tra lane 0."""
    if len(args) != 2:
        raise SyntaxError("il_codegen: v_load8(p, off) can dung 2 tham so")
    ensure_class_vectorblock(ctx)
    idx = _local_idx_vectorblock(scope)
    for lane in range(VEC_W):
        # [VBuf8&] (cho stfld) + dia chi native -> ldind.r4 -> stfld
        out.append(f'    ldloca.s {idx}')
        _vb_addr(args[0], args[1], lane * 4, scope, out, ctx)
        out.append('    ldind.r4')
        out.append(f'    stfld float32 {VEC_CLASS}::f{lane}')
    out.append(f'    ldloc.s {idx}')
    out.append(f'    ldfld float32 {VEC_CLASS}::f0')


def push_v_store8(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_store8(p, off)' - ghi 8 lane (32 byte) xuong dia chi native,
    `off` tinh theo BYTE, tra 0 de goi dang lenh doc lap."""
    if len(args) != 2:
        raise SyntaxError("il_codegen: v_store8(p, off) can dung 2 tham so")
    ensure_class_vectorblock(ctx)
    idx = _local_idx_vectorblock(scope)
    for lane in range(VEC_W):
        # [dia chi native] roi moi den [dia chi field] de lay gia tri:
        # stind.r4 pop value truoc, dia chi native o duoi.
        _vb_addr(args[0], args[1], lane * 4, scope, out, ctx)
        _ldflda(idx, lane, out)
        out.append('    ldind.r4')
        out.append('    stind.r4')
    out.append('    ldc.i8 0')


def _vb_call(idx: "i32", method: "str", args: "list[TkvNode]", scope: "Scope", out: "list[str]", ctx: "Ctx", name: "str"):
    """Day `args` (f32) roi dia chi `__vbuf8`, goi MOT method tinh 8 lane
    (co `aggressiveinlining`), roi rut lane 0 - hop dong cua moi `v_*`."""
    ensure_class_vectorblock(ctx)
    tsig = 'float32'
    j = 1
    while j < len(args):
        tsig = tsig + ', float32'
        j = j + 1
    j = 0
    while j < len(args):
        ctx.compile_expr(args[j], scope, out, 'f32', ctx)
        j = j + 1
    out.append(f'    ldloca.s {idx}')
    out.append(f'    call void {VEC_CLASS}::{method}({tsig}, {VEC_IL}&)')
    out.append(f'    ldloc.s {idx}')
    out.append(f'    ldfld float32 {VEC_CLASS}::f0')


def _push_lanewise(args: "list[TkvNode]", scope: "Scope", out: "list[str]", ctx: "Ctx", method: "str", nsig: "i32", name: "str"):
    """Chung cho v_add8/v_sub8/v_mul8/v_mul8_add8.

    2026-10-13: GOI MOT method tinh ca 8 lane thay vi 8 vong lap phep
    SCALAR. Ban vong lap nay phai 8 x (`ldflda`+`dup`+`ldind.r4`+
    `stind.r4`) va DICH TOAN HANG 8 LAN (moi lane mot lan).

    LAN 1 (2026-10-13, KHONG co `aggressiveinlining`): CHAM HON ban vong
    lap - 223 ms -> 278 ms du IL mat 9x, vi than method vuot ha inline
    mac dinh nen moi phep la mot CALL THAT.
    LAN 2 (cung ngay): them `cil managed aggressiveinlining` vao method ->
    han nguong, SLP co hoi hop. Do la thu nghiem dang chay.
    """
    if len(args) != nsig:
        raise SyntaxError(
            f"il_codegen: {name} - so tham so ({len(args)}) khong khop so phep "
            f"({nsig})")
    _vb_call(_local_idx_vectorblock(scope), method, args, scope, out, ctx, name)


def push_v_add8(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_add8(x)' - moi lane = lane + x."""
    _push_lanewise(args, scope, out, ctx, 'AddS', 1, 'v_add8(x)')


def push_v_sub8(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_sub8(x)' - moi lane = lane - x."""
    _push_lanewise(args, scope, out, ctx, 'SubS', 1, '_sub8(x)')


def push_v_mul8(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_mul8(x)' - moi lane = lane * x."""
    _push_lanewise(args, scope, out, ctx, 'MulS', 1, 'v_mul8(x)')


def push_v_fill8(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_fill8(x)' - nap ca 8 lane = x (broadcast), tra lane 0."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: v_fill8(x) can dung 1 tham so")
    _vb_call(_local_idx_vectorblock(scope), 'FillS', args, scope, out, ctx,
             'v_fill8(x)')


def push_v_mul8_add8(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_mul8_add8(x, y)' - moi lane = lane * x + y. Gop 2 phep trong
    1 vong ghi field (v_mul8 roi v_add8 se ghi 2 lan)."""
    _push_lanewise(args, scope, out, ctx, 'MulAddS', 2, 'v_mul8_add8(x, y)')


def push_v_hsum(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_hsum()' - tong 8 lane trong dem xuong (dung o duoi khoi).

    `ldfld` POP 1 phan tu (doi tuong) nen phai day `ldloc` LAI truoc
    MOI `ldfld`."""
    if len(args) != 0:
        raise SyntaxError("il_codegen: v_hsum() khong co tham so")
    ensure_class_vectorblock(ctx)
    idx = _local_idx_vectorblock(scope)
    for lane in range(VEC_W):
        out.append(f'    ldloc.s {idx}')
        out.append(f'    ldfld float32 {VEC_CLASS}::f{lane}')
        if lane > 0:
            out.append('    add')


def push_v_lane(args: "list[TkvNode]", scope: "Scope", out: "list[str]", dtype: "str", ctx: "Ctx"):
    """'v_lane(i)' - rut lane i (CHI HANG SO 0..7)."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: v_lane(i) can dung 1 tham so")
    n = _literal_int(args[0])
    if n < 0 or n >= VEC_W:
        hi = VEC_W - 1
        raise SyntaxError(
            f"il_codegen: v_lane(i) - chi nhan HANG SO trong 0..{hi}")
    ensure_class_vectorblock(ctx)
    out.append('    ldloc ' + str(_local_idx_vectorblock(scope)))
    out.append(f'    ldfld float32 {VEC_CLASS}::f{n}')


def _literal_int(node: "TkvNode") -> "i32":
    """Gia tri int cua 1 node 'num' thap phan, -1 neu khong phai.

    KHONG dung None lam sentinel: `n is None` voi n kieu so CRASH luc chay
    (TkvInt.Cmp khong nhan null - probe 2026-10-07). Lane hop le la 0..7
    nen -1 lam sentinel an toan."""
    if ekind(node) != 'num':
        return -1
    raw = ea_str(node)
    txt = raw.strip()
    neg = False
    if len(txt) > 0 and txt[0] == '-':
        neg = True
        txt = txt[1:]
    if txt == "":
        return -1
    for ch in txt:
        if ch < '0' or ch > '9':
            return -1
    v = int(txt)
    if neg:
        return 0 - v
    return v


def bootstrap_vector_block(reg: "Registry"):
    """Dang ky cua module nay - P6: KHONG chay luc import.

    Goi tuong minh tu compiler/bootstrap_all.py theo thu tu co dinh
    (thu tu dang ky la MOT PHAN cua hanh vi - xem docstring o do).
    """
    register_vectorblock_dtype()
    register_expr_builtin(reg, 'v_load8', push_v_load8, 'f32', temps_fn=_temps_vbuf)
    register_expr_builtin(reg, 'v_store8', push_v_store8, 'i64', temps_fn=_temps_vbuf)
    register_expr_builtin(reg, 'v_fill8', push_v_fill8, 'f32', temps_fn=_temps_vbuf)
    register_expr_builtin(reg, 'v_add8', push_v_add8, 'f32', temps_fn=_temps_vbuf)
    register_expr_builtin(reg, 'v_sub8', push_v_sub8, 'f32', temps_fn=_temps_vbuf)
    register_expr_builtin(reg, 'v_mul8', push_v_mul8, 'f32', temps_fn=_temps_vbuf)
    register_expr_builtin(reg, 'v_mul8_add8', push_v_mul8_add8, 'f32', temps_fn=_temps_vbuf)
    register_expr_builtin(reg, 'v_hsum', push_v_hsum, 'f32', temps_fn=_temps_vbuf)
    register_expr_builtin(reg, 'v_lane', push_v_lane, 'f32', temps_fn=_temps_vbuf)
