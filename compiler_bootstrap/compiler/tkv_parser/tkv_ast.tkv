# -*- coding: utf-8 -*-
"""tkv_ast - kho node AST dang arena list[str] cho self-host parser (P2).
Moi node 1 dong NAM TRUONG: '<kind>\t<a>\t<b>\t<children_csv>\t<lines>'
(P2b Task 3 them cot thu 5 `lines`). `lines` = '<dong_dau>-<dong_cuoi>'
voi node statement, RONG voi node bieu thuc. Node id = chi so trong
`pool` (list[str] dung chung, append-only). Data dictionary day du:
docs/superpowers/plans/2026-09-03-selfhost-P2a-tkv-expr.md.

CANH BAO (`a`/`b` DA duoc bao ve tu Task 10 bang _esc_field/_unesc_field;
`kind` va `lines` thi CHUA): `kind`/`lines` KHONG DUOC chua ky tu tab that
('\t') - moi accessor doc lai bang `row.split("\t", 4)`, mot tab lac trong
1 truong se lam lech toan bo truong phia sau MA KHONG bao loi. Cac task
sau (2+) sinh gia tri cho `a`/`b` tu dinh danh/ky hieu toan tu nguon -
RUI RO THAP nhung PHAI tranh dua van ban tho (vd noi dung chuoi source
chua tab that) vao `a`/`b` ma khong qua buoc lam sach."""


def _ast_atoi(s: "str") -> "i32":
    """Chuyen chuoi so nguyen KHONG AM -> i32. Dung bang tra, khong ord()."""
    digits = "0123456789"
    v = 0
    i = 0
    while i < len(s):
        d = digits.find(s[i])
        if d < 0:
            return v
        v = v * 10 + d
        i = i + 1
    return v


def _atoi_signed(s: "str") -> "i32":
    """Nhu _ast_atoi nhung cho phep dau '-' dan dau (dung cho sentinel -1)."""
    if len(s) == 0:
        return 0
    if s[0] == "-":
        return 0 - _ast_atoi(s[1:])
    return _ast_atoi(s)


def _esc_field(s: "str") -> "str":
    """Ma hoa 1 truong a/b truoc khi ghi row: tab that -> '\\t', backslash
    -> '\\\\'. Mot tab lac trong a/b lam row.split("\\t", 3) lech HET cac
    truong phia sau MA KHONG bao loi - ca thuc te: const_str cua literal
    nguon "a\\tb" mang dung mot tab that."""
    out = []
    i = 0
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "\\":
            out.append("\\\\")
        elif ch == "\t":
            out.append("\\t")
        else:
            out.append(ch)
        i = i + 1
    return "".join(out)


def _unesc_field(s: "str") -> "str":
    """Giai ma nguoc _esc_field (dung trong node_a/node_b)."""
    out = []
    i = 0
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "\\":
            if i + 2 <= n:
                nxt = s[i + 1]
                if nxt == "t":
                    out.append("\t")
                    i = i + 2
                    continue
                if nxt == "\\":
                    out.append("\\")
                    i = i + 2
                    continue
        out.append(ch)
        i = i + 1
    return "".join(out)


def new_node(pool: "list[str]", kind: "str", a: "str", b: "str", children_csv: "str") -> "i32":
    """Them 1 node BIEU THUC vao `pool`, tra ve chi so (node id). Lop mong
    goi new_stmt_node voi cot `lines` rong."""
    return new_stmt_node(pool, kind, a, b, children_csv, "")


def new_stmt_node(pool: "list[str]", kind: "str", a: "str", b: "str", children_csv: "str", lines: "str") -> "i32":
    """Nhu new_node nhung ghi them cot `lines` = '<dau>-<cuoi>' (so dong
    nguon). Node bieu thuc dung new_node (lines rong). `a`/`b` di qua
    _esc_field, node_a/node_b giai ma nguoc - nen tab that trong gia tri
    chuoi khong pha vo row (khong lam lech ca cot `lines` phia sau)."""
    pool.append(kind + "\t" + _esc_field(a) + "\t" + _esc_field(b)
                + "\t" + children_csv + "\t" + lines)
    return len(pool) - 1


def node_kind(pool: "list[str]", id: "i32") -> "str":
    row = pool[id]
    return row.split("\t", 4)[0]


def node_a(pool: "list[str]", id: "i32") -> "str":
    row = pool[id]
    return _unesc_field(row.split("\t", 4)[1])


def node_b(pool: "list[str]", id: "i32") -> "str":
    row = pool[id]
    return _unesc_field(row.split("\t", 4)[2])


def node_children(pool: "list[str]", id: "i32", out: "list[i32]") -> "i32":
    """Giai ma children_csv cua node `id` -> `out`. Tra so phan tu."""
    row = pool[id]
    csv = row.split("\t", 4)[3]
    return _split_csv_into(csv, out)


def set_node_lines(pool: "list[str]", id: "i32", lines: "str") -> "i32":
    """Ghi de cot `lines` cua mot node da tao. Tra 1.

    P3 Task 4: cac ham _parse_* dat `lines` = '<dong dau>-<dong dau>' vi
    chung khong biet cau lenh ket thuc o dong nao. Dung voi cau lenh don
    mot dong, SAI voi cau lenh ghep va cau lenh don trai nhieu dong - do
    that: 4512/13670 cau lenh trong compiler/**/*.py co `end_lineno` sai.
    `parse_stmt` goi ham nay de vie lai sau khi da biet token cuoi."""
    row = pool[id]
    parts = row.split("\t", 4)
    while len(parts) < 5:
        parts.append("")
    pool[id] = (parts[0] + "\t" + parts[1] + "\t" + parts[2] + "\t"
                + parts[3] + "\t" + lines)
    return 1


def node_lines(pool: "list[str]", id: "i32") -> "str":
    """Tra '<dau>-<cuoi>' cua node statement; rong voi node bieu thuc."""
    row = pool[id]
    parts = row.split("\t", 4)
    if len(parts) < 5:
        return ""
    return parts[4]


def _split_csv_into(csv: "str", out: "list[i32]") -> "i32":
    """Tach chuoi so nguyen (co the am) ngan cach dau phay -> out. Rong -> 0."""
    if len(csv) == 0:
        return 0
    start = 0
    i = 0
    n = 0
    while i < len(csv):
        if csv[i] == ",":
            out.append(_atoi_signed(csv[start:i]))
            n = n + 1
            start = i + 1
        i = i + 1
    out.append(_atoi_signed(csv[start:i]))
    n = n + 1
    return n


def csv_of(ids: "list[i32]") -> "str":
    """Ma hoa list[i32] -> chuoi CSV. Rong -> ''."""
    if len(ids) == 0:
        return ""
    out = str(ids[0])
    i = 1
    while i < len(ids):
        out = out + "," + str(ids[i])
        i = i + 1
    return out
