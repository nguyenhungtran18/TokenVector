from il_features.regex_match import bootstrap_regex_match

__tkv_import__ = "il_dispatch"


def bootstrap_all(reg: "Registry"):
    """Goi moi `bootstrap_<module>()` da chuyen doi, theo thu tu DO DUOC."""
    bootstrap_async_await(reg)
    bootstrap_bytearray_type(reg)
    bootstrap_bytes_type(reg)
    bootstrap_closures(reg)
    bootstrap_complex_type(reg)
    bootstrap_comprehension(reg)
    bootstrap_list_type(reg)
    bootstrap_tuple_type(reg)
    # PHAI truoc bootstrap_il_codegen: LINE_PARSERS thu THEO THU TU dang ky,
    # ma bootstrap_il_codegen dang ky parser gan tong quat 'assign' - dong
    # 'a = b = c = 10' khop ca hai, ai dang ky truoc thi thang. Da do that:
    # dat sau thi try_parse_multi_assign KHONG BAO GIO duoc goi. Dat canh
    # tuple_type vi cung ho (nhieu dich mot lenh gan).
    bootstrap_multi_assign(reg)
    # Khong rang buoc thu tu: hai builtin nay vao BANG expr_builtin_codegen
    # (tra cuu theo ten), khong vao danh sach thu tuan tu.
    bootstrap_metaprogramming(reg)
    bootstrap_str_accum(reg)
    bootstrap_control_flow(reg)
    bootstrap_dict_type(reg)
    bootstrap_counter_type(reg)
    bootstrap_datetime_type(reg)
    bootstrap_stdlib_functional(reg)
    bootstrap_dict_items_list(reg)
    bootstrap_dict_keys_values(reg)
    bootstrap_divmod_builtin(reg)
    bootstrap_expr_hoist(reg)
    bootstrap_pickle_feature(reg)
    # Khong rang buoc thu tu: LOG_STMT_CODEGEN chi duoc DOC trong
    # file_io.py luc codegen, tuc sau toan bo bootstrap.
    bootstrap_logging_feature(reg)
    # Khong rang buoc thu tu: `proc_run` vao BANG expr_builtin_codegen
    # (tra cuu theo ten), khong vao danh sach thu tuan tu.
    bootstrap_process_feature(reg)
    bootstrap_stdlib_sys(reg)
    bootstrap_stdlib_random(reg)
    bootstrap_file_io(reg)
    bootstrap_float_builtin(reg)
    bootstrap_for_in_kvlist(reg)
    bootstrap_fstring(reg)
    bootstrap_generator_lazy(reg)
    bootstrap_int_builtin(reg)
    bootstrap_int_type(reg)
    bootstrap_iter_next(reg)
    bootstrap_list_copy(reg)
    bootstrap_list_count_index(reg)
    bootstrap_list_methods_batch2(reg)
    bootstrap_list_methods_batch3(reg)
    bootstrap_operators(reg)
    bootstrap_string_builtin(reg)
    bootstrap_string_methods_batch3(reg)
    bootstrap_string_methods_batch5(reg)
    bootstrap_record_feature(reg)
    bootstrap_set_type(reg)
    bootstrap_set_methods_batch2(reg)
    bootstrap_set_to_list(reg)
    bootstrap_lap_chung(reg)
    bootstrap_slicing(reg)
    bootstrap_stdlib_aggregates(reg)
    bootstrap_stdlib_base64(reg)
    bootstrap_stdlib_cjson(reg)
    bootstrap_stdlib_eval(reg)
    bootstrap_stdlib_hashlib(reg)
    bootstrap_tuple_methods(reg)
    bootstrap_stdlib_str_translate(reg)
    bootstrap_datetime_py(reg)
    bootstrap_stdlib_http(reg)
    bootstrap_stdlib_http_full(reg)
    bootstrap_stdlib_input(reg)
    bootstrap_stdlib_itertools(reg)
    bootstrap_stdlib_itertools_expr(reg)
    bootstrap_stdlib_itertools_real(reg)
    bootstrap_stdlib_json(reg)
    bootstrap_stdlib_json_get(reg)
    bootstrap_stdlib_os(reg)
    bootstrap_stdlib_path(reg)
    bootstrap_stdlib_pathlib(reg)
    bootstrap_vector_block(reg)
    bootstrap_vector4(reg)
    bootstrap_nativebuf(reg)
    bootstrap_stdlib_re(reg)
    bootstrap_stdlib_repeat(reg)
    bootstrap_stdlib_shutil(reg)
    bootstrap_stdlib_sqlite(reg)
    bootstrap_stdlib_string_count(reg)
    bootstrap_stdlib_string_zfill(reg)
    bootstrap_stdlib_xml(reg)
    bootstrap_stdlib_zipfile(reg)
    bootstrap_string_feature(reg)
    bootstrap_string_format(reg)
    bootstrap_string_join(reg)
    bootstrap_string_percent_format(reg)
    bootstrap_string_split(reg)
    bootstrap_string_title(reg)
    bootstrap_threading_feature(reg)
    bootstrap_simd_feature(reg)
    bootstrap_typecheck(reg)
    bootstrap_win32_gui_window(reg)
    bootstrap_stdlib_math(reg)
    # PHAI sau bootstrap_stdlib_math: xem docstring cua ham do.
    bootstrap_stdlib_math_trig(reg)
    bootstrap_il_codegen(reg)
    bootstrap_regex_match(reg)
