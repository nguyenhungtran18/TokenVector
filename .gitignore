__pycache__/
*.pyc
*.pyo

# --- Build output of the COMPILER (repo root) -----------------------------
# `/` o DAU la quan trong: `build/` (khong co dau) se KHOP CA
# `packaging/build/`, noi MSBuild props/targets DANG duoc track.
/build/
/dist/
/tests/temp_test_*

# --- Ad-hoc scratch dirs tu cac phien debug --------------------------------
_d6probe/
.freebuff/

# --- San pham bien dich canh mot file .tkv ---------------------------------
# tkvc ghi `.exe` cho moi file .tkv va them mot `.il` khi --emit-il, ca hai
# deu nam canh file nguon. Track chung nghia la mot lan chay da ghi de 240
# binary da track va tao ~240 dong git status che mat vai dong sua source that.
# Moi file deu sinh lai boi `build_tkvc.ps1`; khong file nao la golden file.
*.exe
*.il

# --- Da dem xuat ban, khong phai nguon -------------------------------------
# packaging/*.nupkg duoc `packaging/pack.ps1` tao lai; .nuspec + pack.ps1 +
# MSBuild props/targets ben canh **co** duoc track.
/packaging/*.nupkg

# --- Scratch data ghi vao repo root boi benchmark/test ---------------------
_p[dt]_t*.csv
_r[t]*.csv
_t[0-9]*.csv
test_out.csv
*_tmp.feather
pkl_*_test.bin

# --- File rac do goi sai lenh ----------------------------------------------
# `tkvc --emit-il --out.il` bi parser doc `--out` lam TEN file, tao ra file
# ten bat thuong `--out.il` o repo root.
/--out.il
/--*.il

# --- Anh dan dung nhot nua khong co ten -------------------------------------
# Mot file .jfif 216 KB ten UUID da duoc commit o repo root trong khi
# `assets/` moi la noi dung dung cho.
/*.jfif
/*.jpeg
/*.png
# Output cua bo test .ca (runner tạo exe + .lst + .log cho tung file)
/build/tkv_suite/
/tests_suite/*.exe

# --- Ban Release: duoc TRACK (2026-10-12) ---------------------------------
# Truoc day ignore vi coi la ban sao. Bay no la SAN PHAM BAN GIAO nen phai
# di kem git - clone repo la co ngay ban phat hanh.
#
# `.exe` o tren bo SAI (dung chung, khong dau) nen phai bo lai 2 binary
# san pham cua chinh ban Release. Quy tac phai NAM SAU `*.exe` moi co hieu luc.
# `Release/.gitignore` lo phan con lai (build/, .il, .log, vong.exe).
!Release/dist/
!Release/dist/bin/
!Release/dist/tkvc-tv.exe
!Release/dist/bin/tkv_guide.exe

# --- Release/ gio la SAN PHAM chinh cua repo (2026-10-15) ---------------------
# Root chi con README + LICENSE + Release/. Moi binary trong Release phai nam
# trong git, nen phai bo lai tung file duoi quy tac *.exe o tren.
!Release/tools/vong.exe
!Release/tools/diff_il.exe
!Release/tests_suite/chay.exe

Release/benchmark/run_benchmark.exe
Release/tools/vong.exe
Release/tools/diff_il.exe
Release/tests_suite/chay.exe
