__pycache__/
*.pyc
3.code/build/
3.code/Testkit/temp_test_*

# Ad-hoc scratch dirs created at the repo root during debugging sessions.
# _d6probe/ held a throwaway IL repro (repro.tkv + its .exe/.il) that is
# fully regenerable from the compiler.
_d6probe/
.freebuff/

# Scratch files the Testkit pickle test writes into the CWD.
pkl_*_test.bin

# Build products of a release, not sources.
# nuget/*.nupkg is rebuilt by nuget/pack.ps1; the .nuspec + pack.ps1 + the
# MSBuild props/targets next to it ARE tracked.
nuget/*.nupkg

# Compiler output, not sources. tkvc writes an .exe for every .tkv it builds
# and an extra .il under --emit-il, both landing next to the source. Tracking
# them meant one test run rewrote 240 tracked binaries and produced a ~240-line
# git status that buried the handful of real source edits. Every one of them is
# regenerated by `3.code/build_tkvc.ps1`; none is a golden file - the
# *_regress.il files are full assembly dumps that no test reads.
*.exe
*.il

# PyInstaller output. dist/ holds a copy of every il_features/*.tkv plus the
# bundled tkvc.exe, so it duplicates the sources in 3.code/compiler/.
3.code/dist/

# Scratch emitted by the direct-smoke runner and by ad-hoc benchmark probes.
3.code/test/_direct_smoke_out/
3.code/test/verify/tmp_*

# Scratch data files written into the repo root by benchmark and test runs.
_p[dt]_t*.csv
_r[t]*.csv
_t[0-9]*.csv
test_out.csv
*_tmp.feather
