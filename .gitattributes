# 1. Ẩn mã nguồn TokenVector và mã IL khỏi thống kê ngôn ngữ của GitHub
*.tkv linguist-generated=true
*.il linguist-generated=true

# 2. Ẩn toàn bộ mã build, thư mục release, UI và công cụ phụ trợ
release/** linguist-generated=true
2.UI/** linguist-generated=true
3.code/** linguist-generated=true
*.exe binary

# 3. Đánh dấu tài liệu
docs/** linguist-documentation=true
outreach/** linguist-documentation=true
llms.txt linguist-documentation=true

# 4. Loại bỏ các script build/tiện ích khỏi thống kê Languages bar của GitHub
*.bat linguist-vendored=true
