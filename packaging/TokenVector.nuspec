<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>TokenVector</id>
    <version>2026.1.0</version>
    <title>TokenVector Compiler Platform</title>
    <authors>Nguyen Hung Tran, TokenVector Compiler Engineering Team</authors>
    <owners>nguyenhungtran18</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/nguyenhungtran18/TokenVector</projectUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <description>TokenVector Compiler Platform - High-performance ahead-of-time (AOT) compiler with Pythonic syntax and native .NET/CIL backend, zero Python runtime dependency, and no-GIL multithreading.</description>
    <summary>TokenVector AOT compiler tool for Pythonic syntax to native PE/CIL executables with full .NET interop.</summary>
    <releaseNotes>Release 2026.1 - Standalone compiler tkvc.exe with full self-hosted TokenVector libraries and .NET interop support.</releaseNotes>
    <copyright>Copyright (c) 2026 Nguyen Hung Tran</copyright>
    <tags>tokenvector compiler python dotnet cil aot no-gil high-performance native roslyn msbuild cli</tags>
    <repository type="git" url="https://github.com/nguyenhungtran18/TokenVector" />
  </metadata>
  <files>
    <file src="..\README.md" target="README.md" />
    <file src="..\LICENSE" target="LICENSE" />
    <!-- Icon = images\preview.png. TRUOC day la images\icon.png, mot ban
         copy trung byte cua preview.png; da bo ban copy do (chi giu 1 file)
         va tro nuspec ve day. -->
    <file src="..\assets\preview.png" target="icon.png" />
    <file src="..\dist\tkvc.exe" target="tools\tkvc.exe" />
    <file src="..\dist\il_features\*.tkv" target="tools\il_features\" />
    <file src="build\**\*" target="build\" />
  </files>
</package>
