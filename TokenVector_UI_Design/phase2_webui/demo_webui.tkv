# -*- coding: utf-8 -*-
# demo_webui.tkv - TokenVector Phase 2 Web UI Bridge - Full Integration Demo
# Mô phỏng vòng lặp request-response giữa Backend TokenVector và Frontend HTML5

class ApiRequest:
    method: "str"
    path: "str"
    body: "str"

    def __init__(self, method, path, body):
        self.method = method
        self.path = path
        self.body = body

class ApiResponse:
    status: "i32"
    body: "str"
    content_type: "str"

    def __init__(self, status, body, content_type):
        self.status = status
        self.body = body
        self.content_type = content_type

def json_str(key: "str", val: "str") -> "str":
    return "\"" + key + "\": \"" + val + "\""

def json_int(key: "str", val: "i32") -> "str":
    return "\"" + key + "\": " + str(val)

def build_json(fields: "str") -> "str":
    return "{" + fields + "}"

def handle_route(req: "ApiRequest") -> "ApiResponse":
    if req.path == "/api/info":
        body = build_json(
            json_str("name", "TokenVector") + ", " +
            json_str("version", "2026.1.0") + ", " +
            json_str("compiler", "tkvc") + ", " +
            json_str("output", "Native AOT .exe")
        )
        return ApiResponse(200, body, "application/json")
    elif req.path == "/api/status":
        body = build_json(
            json_str("status", "running") + ", " +
            json_int("uptime_ms", 100) + ", " +
            "\"no_gil\": true, " +
            json_int("threads", 4)
        )
        return ApiResponse(200, body, "application/json")
    elif req.path == "/api/benchmark":
        body = build_json(
            json_int("integer_loop_10M_ms", 410) + ", " +
            json_int("float_ops_2M_ms", 429) + ", " +
            json_int("multithread_4t_ms", 244) + ", " +
            json_int("speedup_vs_python", 10)
        )
        return ApiResponse(200, body, "application/json")
    elif req.path == "/api/compile" and req.method == "POST":
        body = build_json(
            json_str("status", "queued") + ", " +
            json_str("message", "Compilation scheduled") + ", " +
            json_str("source", req.body)
        )
        return ApiResponse(201, body, "application/json")
    body = build_json(json_str("error", "Route not found: " + req.path))
    return ApiResponse(404, body, "application/json")

def print_request(req: "ApiRequest") -> "i32":
    print("  \x1b[90m>>> " + req.method + " " + req.path + "\x1b[0m")
    return 1

def print_response(resp: "ApiResponse") -> "i32":
    if resp.status == 200 or resp.status == 201:
        print("  \x1b[32m<<< " + str(resp.status) + "\x1b[0m " + resp.body)
    else:
        print("  \x1b[31m<<< " + str(resp.status) + "\x1b[0m " + resp.body)
    return 1

def main() -> "i32":
    print("\x1b[1m\x1b[36m=== TOKENVECTOR WEB UI BRIDGE - PHASE 2 DEMO ===\x1b[0m")
    print("")
    print("\x1b[33m  Simulating HTTP API request-response cycle...\x1b[0m")
    print("")

    req1 = ApiRequest("GET", "/api/info", "")
    print_request(req1)
    print_response(handle_route(req1))
    print("")

    req2 = ApiRequest("GET", "/api/status", "")
    print_request(req2)
    print_response(handle_route(req2))
    print("")

    req3 = ApiRequest("GET", "/api/benchmark", "")
    print_request(req3)
    print_response(handle_route(req3))
    print("")

    req4 = ApiRequest("POST", "/api/compile", "hello.tkv")
    print_request(req4)
    print_response(handle_route(req4))
    print("")

    req5 = ApiRequest("GET", "/api/unknown", "")
    print_request(req5)
    print_response(handle_route(req5))
    print("")

    print("\x1b[90m  -----------------------------------------------\x1b[0m")
    print("\x1b[32m  [OK] Phase 2 Web UI Bridge logic: 100% functional\x1b[0m")
    print("\x1b[36m  [HTML] Template: TokenVector_UI_Design/phase2_webui/templates/dashboard.html\x1b[0m")
    print("\x1b[90m  Next: Connect tkvc_http to .NET HttpListener for real HTTP serving\x1b[0m")
    return 1
