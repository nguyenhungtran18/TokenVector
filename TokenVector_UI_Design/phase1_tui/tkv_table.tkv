# -*- coding: utf-8 -*-
# tkv_table.tkv - TokenVector ASCII Table Rendering Module

def pad_right(text: "str", width: "i32") -> "str":
    result = text
    pad = width - len(text)
    i = 0
    for i in range(pad):
        result = result + " "
    return result

def print_row_separator(col1w: "i32", col2w: "i32", col3w: "i32") -> "i32":
    sep = "├"
    i = 0
    for i in range(col1w + 2):
        sep = sep + "─"
    sep = sep + "┼"
    for i in range(col2w + 2):
        sep = sep + "─"
    sep = sep + "┼"
    for i in range(col3w + 2):
        sep = sep + "─"
    sep = sep + "┤"
    print("\x1b[90m" + sep + "\x1b[0m")
    return 1

def print_top_border(col1w: "i32", col2w: "i32", col3w: "i32") -> "i32":
    top = "┌"
    i = 0
    for i in range(col1w + 2):
        top = top + "─"
    top = top + "┬"
    for i in range(col2w + 2):
        top = top + "─"
    top = top + "┬"
    for i in range(col3w + 2):
        top = top + "─"
    top = top + "┐"
    print("\x1b[90m" + top + "\x1b[0m")
    return 1

def print_bottom_border(col1w: "i32", col2w: "i32", col3w: "i32") -> "i32":
    bot = "└"
    i = 0
    for i in range(col1w + 2):
        bot = bot + "─"
    bot = bot + "┴"
    for i in range(col2w + 2):
        bot = bot + "─"
    bot = bot + "┴"
    for i in range(col3w + 2):
        bot = bot + "─"
    bot = bot + "┘"
    print("\x1b[90m" + bot + "\x1b[0m")
    return 1

def print_row(c1: "str", c2: "str", c3: "str", col1w: "i32", col2w: "i32", col3w: "i32", highlight: "i32") -> "i32":
    row = "\x1b[90m│\x1b[0m " + pad_right(c1, col1w) + " \x1b[90m│\x1b[0m " + pad_right(c2, col2w) + " \x1b[90m│\x1b[0m " + pad_right(c3, col3w) + " \x1b[90m│\x1b[0m"
    if highlight == 1:
        print("\x1b[32m" + row + "\x1b[0m")
    else:
        print(row)
    return 1

def main() -> "i32":
    print("=== TKV_TABLE MODULE TEST ===")
    print_top_border(20, 15, 12)
    print_row("Language", "Speed vs Python", "File Size", 20, 15, 12, 0)
    print_row_separator(20, 15, 12)
    print_row("TokenVector AOT", "8x - 10x", "~35 KB", 20, 15, 12, 1)
    print_row_separator(20, 15, 12)
    print_row("CPython 3.12", "1x (baseline)", "25+ MB", 20, 15, 12, 0)
    print_row_separator(20, 15, 12)
    print_row("C++ Native", "10x - 12x", "~50 KB", 20, 15, 12, 0)
    print_bottom_border(20, 15, 12)
    return 1
