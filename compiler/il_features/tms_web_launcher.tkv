def ensure_server_class(ctx):
    emitted = ctx.get('emitted_types')
    if emitted is not None and 'TmsNativeServer' in emitted:
        return
    if emitted is not None:
        emitted.add('TmsNativeServer')
    ctx['extra_classes'].append(_SERVER_CLASS_IL)


def _push_launch_tms_web(args, scope, out, dtype, ctx):
    if len(args) != 1:
        raise SyntaxError("il_codegen: launch_tms_web(html_path) nhan dung 1 tham so")
    
    ensure_server_class(ctx)

    # 1. Khoi dong Native Server tren luong nen
    out.append('    call void TmsNativeServer::StartServer()')
    
    # 2. Tao thu muc Export va Backup trong thu muc ung dung
    out.append('    call class [mscorlib]System.AppDomain [mscorlib]System.AppDomain::get_CurrentDomain()')
    out.append('    callvirt instance string [mscorlib]System.AppDomain::get_BaseDirectory()')
    out.append('    ldstr "Export"')
    out.append('    call string [mscorlib]System.IO.Path::Combine(string, string)')
    out.append('    call class [mscorlib]System.IO.DirectoryInfo [mscorlib]System.IO.Directory::CreateDirectory(string)')
    out.append('    pop')
    
    out.append('    call class [mscorlib]System.AppDomain [mscorlib]System.AppDomain::get_CurrentDomain()')
    out.append('    callvirt instance string [mscorlib]System.AppDomain::get_BaseDirectory()')
    out.append('    ldstr "Backup"')
    out.append('    call string [mscorlib]System.IO.Path::Combine(string, string)')
    out.append('    call class [mscorlib]System.IO.DirectoryInfo [mscorlib]System.IO.Directory::CreateDirectory(string)')
    out.append('    pop')
    
    # Cho 250ms de Native Server san sang
    out.append('    ldc.i4 250')
    out.append('    call void [mscorlib]System.Threading.Thread::Sleep(int32)')
    
    out.append('    ldstr "[TokenVector Server] San sang tai: http://127.0.0.1:18890/ui/index.html"')
    out.append('    call void [mscorlib]System.Console::WriteLine(string)')

    # 3. Khoi chay Browser App Mode
    out.append('    .try')
    out.append('    {')
    out.append('      ldstr "msedge.exe"')
    out.append('      ldstr "--app=http://127.0.0.1:18890/ui/index.html --start-maximized"')
    out.append('      call class [System]System.Diagnostics.Process [System]System.Diagnostics.Process::Start(string, string)')
    out.append('      pop')
    out.append('      leave LAUNCH_DONE')
    out.append('    }')
    out.append('    catch [mscorlib]System.Exception')
    out.append('    {')
    out.append('      pop')
    out.append('      .try')
    out.append('      {')
    out.append('        ldstr "chrome.exe"')
    out.append('        ldstr "--app=http://127.0.0.1:18890/ui/index.html --start-maximized"')
    out.append('        call class [System]System.Diagnostics.Process [System]System.Diagnostics.Process::Start(string, string)')
    out.append('        pop')
    out.append('        leave LAUNCH_DONE')
    out.append('      }')
    out.append('      catch [mscorlib]System.Exception')
    out.append('      {')
    out.append('        pop')
    out.append('        ldstr "explorer.exe"')
    out.append('        ldstr "http://127.0.0.1:18890/ui/index.html"')
    out.append('        call class [System]System.Diagnostics.Process [System]System.Diagnostics.Process::Start(string, string)')
    out.append('        pop')
    out.append('        leave LAUNCH_DONE')
    out.append('      }')
    out.append('    }')

    out.append('    LAUNCH_DONE:')
    out.append('    ldstr "[TokenVector] Da khoi chay giao dien Desktop App!"')
    out.append('    call void [mscorlib]System.Console::WriteLine(string)')
    out.append('    call void TmsNativeServer::KeepServerRunning()')
    out.append('    ldc.i4.1')

register_expr_builtin('launch_tms_web', _push_launch_tms_web, 'i32')
