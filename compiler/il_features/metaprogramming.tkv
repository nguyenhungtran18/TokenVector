# -*- coding: utf-8 -*-
"""Metaprogramming (Moc 17, 2026-08-09): hasattr(obj, "attr") & getattr(obj, "attr", default)."""
from il_dispatch import register_expr_builtin
from il_core import IL_SCALAR
from typed_dsl_parser import TypeAnn
from il_features import int_type as _int_type
from il_features import tkvstr as _tkvstr
from il_features.record_feature import _field_owner_class as _field_owner


def _attr_lit_name(attr_arg):
    """Ten attribute tu 1 node chuoi literal ('x' hoac "x")."""
    if isinstance(attr_arg, tuple) and len(attr_arg) >= 2:
        return str(attr_arg[1]).strip('"\'')
    if isinstance(attr_arg, str):
        return attr_arg.strip('"\'')
    return None


def _field_dtype(records, rec_name, attr_name):
    """Kieu THAT cua field `attr_name` cua record `rec_name`, hoac None neu
    record/field khong ton tai.

    `records[ten]` la list `(ten_field, dtype)` voi dtype la `str` cho scalar
    (xem il_codegen: `fields = [fd for fd in records[name] ...]`) va `TypeAnn`
    cho field record/container. Do do phai tra ve CHINH gia tri do - ham nao
    tu doan lai (vi du gan 'str') thi bien dich ra IL LECH KIEU."""
    raw = (records or {}).get(rec_name)
    if not raw:
        return None
    for fd in raw:
        if fd and fd[0] == attr_name:
            fdt = fd[1]
            return fdt if isinstance(fdt, str) else fdt.dtype
    return None


def _field_raw_dtype(records, rec_name, attr_name):
    """Ban ghi field GOC (str cho scalar, TypeAnn cho container/record)."""
    for fd in ((records or {}).get(rec_name) or []):
        if fd and fd[0] == attr_name:
            return fd[1]
    return None


def _expr_dtype(node, scope, ctx):
    """Suy kieu cua mot bieu thuc don gian - dung cho gia tri MAC DINH cua
    getattr. Thu ctx['infer_dtype'] truoc; neu khong co thi doan theo dang
    literal/bien. Tra None neu khong xac dinh duoc."""
    infer = (ctx or {}).get('infer_dtype')
    if callable(infer):
        try:
            d = infer(node, scope, (ctx or {}).get('func_table'))
            if d:
                return d
        except Exception:
            pass
    if not isinstance(node, tuple) or not node:
        return None
    tag = node[0]
    if tag == 'str_lit':
        return 'str'
    if tag == 'num':
        text = str(node[1])
        try:
            val = float(text) if ('.' in text or 'e' in text.lower()) else int(text, 0)
        except ValueError:
            return None
        return 'f64' if isinstance(val, float) else 'i32'
    if tag == 'var':
        try:
            _, _, ta = scope[node[1]]
        except Exception:
            return None
        return ta.dtype if ta is not None else None
    return None


def _field_names(records, rec_name):
    raw = (records or {}).get(rec_name)
    if not raw:
        return []
    if isinstance(raw, list):
        return [f[0] for f in raw]
    return list(raw.keys())


def push_hasattr_builtin(args, scope, out, dtype, ctx):
    _int_type.ensure_class(ctx)
    if len(args) != 2:
        raise SyntaxError("il_codegen: hasattr(obj, attr_name) nhan dung 2 tham so")
    obj_arg, attr_arg = args[0], args[1]
    if obj_arg[0] != 'var':
        raise SyntaxError("il_codegen: hasattr(obj, attr_name) can tham so 1 la 1 bien")
    obj_name = obj_arg[1]
    if obj_name not in scope:
        raise SyntaxError(f"il_codegen: bien '{obj_name}' chua duoc khai bao")
    _, _, obj_ta = scope[obj_name]
    
    attr_name = _attr_lit_name(attr_arg)
    records = (ctx or {}).get('records') or {}
    record_methods = (ctx or {}).get('record_methods') or {}
    methods = record_methods.get(obj_ta.dtype, {})
    field_names = _field_names(records, obj_ta.dtype)

    has_attr = bool(attr_name) and (attr_name in field_names or attr_name in methods)

    if has_attr:
        out.append('    ldc.i4.1')
    else:
        out.append('    ldc.i4.0')

def push_getattr_builtin(args, scope, out, dtype, ctx):
    _int_type.ensure_class(ctx)
    _tkvstr.ensure_class(ctx)
    if len(args) < 2 or len(args) > 3:
        raise SyntaxError("il_codegen: getattr(obj, attr_name, default) nhan 2 hoac 3 tham so")
    obj_arg, attr_arg = args[0], args[1]
    default_arg = args[2] if len(args) == 3 else None

    if obj_arg[0] != 'var':
        raise SyntaxError("il_codegen: getattr(obj, attr_name) can tham so 1 la 1 bien")
    obj_name = obj_arg[1]
    if obj_name not in scope:
        raise SyntaxError(f"il_codegen: bien '{obj_name}' chua duoc khai bao")
    _, _, obj_ta = scope[obj_name]

    attr_name = _attr_lit_name(attr_arg)
    if attr_name is None:
        raise SyntaxError(
            "il_codegen: getattr(obj, attr_name) - attr_name phai la CHUOI "
            "LITERAL (vi du getattr(o, \"x\")). Bien chuoi co the chua ten "
            "bat ky gi se khong khop duoc voi field nao - xu ly chuoi la "
            "runtime, ma field cua record la compile-time.")

    records = (ctx or {}).get('records') or {}
    field_dtype = _field_dtype(records, obj_ta.dtype, attr_name)

    if field_dtype is not None:
        # PHAI dung `field_dtype` (kieu THAT cua field). Truoc day ham nay
        # compile voi `dtype` la kieu DA DANG KY cua builtin - la 'str' - nen
        # `getattr(o, "x")` tren field `i32` bien dich ra doc ldfld int32
        # nhung noi lai nhu chuoi. Ket qua: bien bien dich XANH, chay thi
        # nem NullReferenceException trong String.Concat. Loi AM THANH -
        # nguy hiem hon loi bien dich vi khong gi bao loi.
        ctx['compile_expr'](('attr', obj_name, attr_name), scope, out,
                            field_dtype, ctx)
        return

    if default_arg is not None:
        # Field khong ton tai va co default: ghi ra gia tri mac dinh. Kieu
        # phai lay tu CHINH bieu thuc default - gan 'str' (kieu dang ky cua
        # builtin) se sinh IL lech kieu, y het loi da gap o nhanh field o tren.
        d_dt = _expr_dtype(default_arg, scope, ctx)
        if d_dt is None:
            raise SyntaxError(
                f"il_codegen: getattr(obj, \"{attr_name}\", <default>) - record "
                f"'{obj_ta.dtype}' khong co field '{attr_name}', va gia tri "
                f"mac dinh khong phai literal/bien co kieu biet truoc (chi ho "
                f"tro 'int'/'float'/'str' va bien da khai bao). Hay gan bien "
                f"mac dinh ra bien truoc roi truyen vao.")
        ctx['compile_expr'](default_arg, scope, out, d_dt, ctx)
        return

    raise SyntaxError(
        f"il_codegen: record '{obj_ta.dtype}' khong co field '{attr_name}' va "
        f"getattr khong co tham so default. Python nem AttributeError; o day "
        f"bao loi bien dich (dung getattr(o, \"{attr_name}\", <gia tri mac dinh>))")


def _getattr_dtype_fn(args, scope, func_table=None, ctx=None):
    """dtype tra ve cua getattr = KIEU THAT cua field duoc doc (2026-09-30).

    Truoc day getattr duoc dang ky return_dtype CUNG 'str', nen bien dich tai
    choi 'v = getattr(o, "x")' biet `v` la chuoi trong khi IL phat ra int32 -
    moi thu sau do (str(v), + noi chuoi) deu sinh sai. Day la ly do phai suy
    kieu thay vi gan cung. Can `ctx` de doc ban ghi field -> opt-in qua
    `dtype_fn_wants_ctx`."""
    records = (ctx or {}).get('records') or {}
    if len(args) < 2 or args[0][0] != 'var':
        return 'str'
    # `scope` o tang suy kieu la `_DtypeOnlyScope` (chi co `__getitem__`, KHONG
    # co `.get`) - xem _infer_dtype. Dung `[]` boc try cho ca hai loai scope.
    try:
        _, _, obj_ta = scope[args[0][1]]
    except Exception:
        return 'str'
    if obj_ta is None:
        return 'str'
    fd = _field_dtype(records, obj_ta.dtype, _attr_lit_name(args[1]))
    if fd is not None:
        return fd
    if len(args) >= 3:
        d_dt = _expr_dtype(args[2], scope, ctx)
        if d_dt is not None:
            return d_dt
    return 'str'


def push_setattr_builtin(args, scope, out, dtype, ctx):
    _int_type.ensure_class(ctx)
    if len(args) != 3:
        raise SyntaxError("il_codegen: setattr(obj, attr_name, value) nhan dung 3 tham so")
    obj_arg, attr_arg, value_arg = args[0], args[1], args[2]
    if obj_arg[0] != 'var':
        raise SyntaxError("il_codegen: setattr(obj, attr_name, value) can tham so 1 la 1 bien")
    obj_name = obj_arg[1]
    if obj_name not in scope:
        raise SyntaxError(f"il_codegen: bien '{obj_name}' chua duoc khai bao")
    _, _, obj_ta = scope[obj_name]

    attr_name = _attr_lit_name(attr_arg)
    if attr_name is None:
        raise SyntaxError(
            "il_codegen: setattr(obj, attr_name, value) - attr_name phai la "
            "CHUOI LITERAL (vi du setattr(o, \"x\", 5)).")
    records = (ctx or {}).get('records') or {}
    raw_fd = _field_raw_dtype(records, obj_ta.dtype, attr_name)
    if raw_fd is None:
        raise SyntaxError(
            f"il_codegen: record '{obj_ta.dtype}' khong co field '{attr_name}' "
            f"nen setattr khong gan duoc. Python nem AttributeError.")
    # stfld: day reference cua object, day value - giong `o.x = v` trong method.
    # `_field_owner` BAT BUOC cho ldfld/stfld dung: CIL doi hoi ghi dung class
    # KHAI BAO field do, khong phai class con ke thua (xem record_feature).
    # Ten field lay NGUYEN BAN - KHONG dung ctx['il_ident']: ham do boc dau
    # nhay don cho ILASM (xem _il_ident) nhung tkvc.exe JIT truc tiep IL nen
    # `P::'x'` khong hop le -> InvalidProgramException luc chay.
    ctx['load_var_ref'](obj_name, scope, out)
    if isinstance(raw_fd, str):
        ctx['compile_expr'](value_arg, scope, out, raw_fd, ctx)
        out.append(f'    stfld {IL_SCALAR[raw_fd]} '
                   f'{_field_owner(ctx, obj_ta.dtype, attr_name)}::{attr_name}')
    else:
        ctx['compile_expr'](value_arg, scope, out, raw_fd.dtype, ctx)
        out.append(f'    stfld {ctx["il_type_str"](raw_fd, records)} '
                   f'{_field_owner(ctx, obj_ta.dtype, attr_name)}::{attr_name}')
    # setattr tra ve None -> de lai MOT gia tri 0 lam ket qua. KHONG `pop`:
    # `stfld` da tieu CA object reference LAN value roi, nen sau no stack
    # rong - them `pop` se lam hu stack (InvalidProgramException luc chay).
    out.append('    ldc.i4.0')


# ===========================================================================
# NHOM HAM PHAI CHIEU - bo sung 2026-09-30
#
# Python co: callable, dir, id, hash, ascii, delattr. TKV thi chua. Dinh
# nghia la chay theo y nghia LUON - khong gan ket qua sai - va bat buoc
# phai NOI RONG khi khong lam duoc (xem tung ham).
# ===========================================================================


def _var_ta(args, scope, what):
    """Tham so 1 phai la 1 BIEN da khai bao. Tra (ten, TypeAnn)."""
    if len(args) != 1 or args[0][0] != 'var':
        raise SyntaxError(
            f"il_codegen: {what}(x) - tham so phai la 1 BIEN da khai bao "
            f"(vd {what}(xs)), khong nhan bieu thuc tai day")
    name = args[0][1]
    try:
        _, _, ta = scope[name]
    except (KeyError, TypeError):
        raise SyntaxError(f"il_codegen: bien '{name}' chua duoc khai bao")
    return name, ta


def push_callable_builtin(args, scope, out, dtype, ctx):
    """`callable(x)` -> 1 neu x la HAM, 0 neu khong (giong Python).

    TokenVector la AOT: kieu cua bien biet LUC BIEN DICH nen tra loi ngay o
    bien dich, khong can doi gia tri runtime."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: callable(x) nhan dung 1 tham so")
    node = args[0]
    if node[0] != 'var':
        raise SyntaxError(
            "il_codegen: callable(x) - x phai la BIEN dang co kieu, vi kieu la "
            "thu biet duoc o bien dich (AOT). Hay gan bien truoc: "
            "`f2 = my_func; callable(f2)`")
    name = node[1]
    try:
        _, _, ta = scope[name]
    except (KeyError, TypeError):
        raise SyntaxError(f"il_codegen: bien '{name}' chua duoc khai bao")
    out.append('    ldc.i4.1' if getattr(ta, 'shape', None) == 'func' else '    ldc.i4.0')


def push_dir_builtin(args, scope, out, dtype, ctx):
    """`dir(o)` -> List<string> ten truong + method cua record `o`.

    Danh sach BIET LUC BIEN DICH (compiler da phai khai bao record truoc) nen
    sinh san `List<string>` thay vi do khoi tao luc chay."""
    name, ta = _var_ta(args, scope, 'dir')
    records = (ctx or {}).get('records') or {}
    record_methods = (ctx or {}).get('record_methods') or {}
    names = list(_field_names(records, ta.dtype))
    names += sorted((record_methods.get(ta.dtype) or {}).keys())
    if not names:
        raise SyntaxError(
            f"il_codegen: dir({name}) - '{name}' co kieu '{ta.dtype}' khong co "
            f"truong/method nao; dir() chi ap dung cho record da khai bao")
    from il_features.list_type import il_list_type
    list_il = il_list_type('str', ctx.get('records'))
    # `.ctor()` KHONG tham so - do la day `ldc.i4 len(names)` se thua, gay
    # InvalidProgramException (da gap).
    out.append(f'    newobj instance void {list_il}::.ctor()')
    for nm in names:
        out.append('    dup')
        out.append(f'    ldstr "{nm}"')
        out.append(f'    callvirt instance void {list_il}::Add(!0)')


def push_id_builtin(args, scope, out, dtype, ctx):
    """`id(x)` -> so nguyen danh tinh. Dung `RuntimeHelpers.GetHashCode` -
    gia tri NAO DAO, khong cam khi on dinh giua hai lan chay (Python cung vay).

    Tham so phai la BIEN: len(int literal) khong co y nghia gi trong Python
    (`id(3)` tra so moi lan), nen tu choi de khong tao cam giac sai."""
    name, ta = _var_ta(args, scope, 'id')
    kind, idx, _ta = scope[name]
    out.append(f'    ldarg.s {idx}' if kind == 'arg' else f'    ldloc.s {idx}')
    if ta.shape is None:
        scalar_il = IL_SCALAR.get(ta.dtype)
        if scalar_il is None:
            raise SyntaxError(
                f"il_codegen: id({name}) - kieu '{ta.dtype}' khong co ban do IL")
        out.append(f'    box {scalar_il}')
    out.append('    call int32 [mscorlib]System.Runtime.CompilerServices'
               '.RuntimeHelpers::GetHashCode(object)')


def _fnv1a_64(s):
    """FNV-1a 64-bit tren UTF-8 cua `s`. Dung cho `hash()` cua chuoi.

    KHONG dung `String.GetHashCode()` cua .NET: ham do BI NGAU NHIEN THEO
    TIEN TRINH, cung mot chuoi se ra so khac giua 2 lan chay - trai voi
    Python (hash o dinh). Tinh san o bien dich nen chi ap dung cho LITERAL."""
    h = 0xcbf29ce484222325
    for b in s.encode('utf-8'):
        h ^= b
        h = (h * 0x100000001b3) & 0xFFFFFFFFFFFFFFFF
    return h - 0x10000000000000000 if h >= 0x8000000000000000 else h


def push_hash_builtin(args, scope, out, dtype, ctx):
    """`hash(x)` -> i64.

    - So nguyen: giong Python - tra CHINH gia tri (`hash(42)` = 42).
    - Chuoi LITERAL: FNV-1a 64-bit tren UTF-8. **KHAC Python** (Python dung
      SipHash co khoa muoi) - o dinh giua cac lan chay nen DUNG DUOC de
      lam khoa/kiem tra, nhung KHONG dung de khop so voi Python.
    - Bien chuoi / container: bao loi ro."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: hash(x) nhan dung 1 tham so")
    node = args[0]
    if node[0] == 'str_lit':
        out.append(f'    ldc.i8 {_fnv1a_64(node[1][1:-1])}')
        return
    if node[0] == 'num':
        txt = str(node[1])
        if '.' in txt or 'e' in txt.lower():
            raise SyntaxError(
                "il_codegen: hash(<so thuc>) - Python hash theo gia tri bit "
                "(hash(1.0) = hash(1)); TokenVector chi ho tro so nguyen")
        out.append(f'    ldc.i8 {int(txt, 0)}')
        return
    if node[0] != 'var':
        raise SyntaxError(
            "il_codegen: hash(x) - x phai la so nguyen, chuoi LITERAL, hoac bien")
    name, ta = _var_ta(args, scope, 'hash')
    if ta.dtype == 'str':
        raise SyntaxError(
            f"il_codegen: hash({name}) - bien chuoi chua ho tro: phai tinh tren "
            f"byte luc CHAY ma bien dich chi sinh IL co so bien dich. Dung chuoi "
            f"LITERAL: hash(\"abc\")")
    if ta.shape is not None:
        raise SyntaxError(
            f"il_codegen: hash({name}) - khong hash duoc container "
            f"(shape={ta.shape!r}); Python cung nem TypeError")
    ctx['compile_expr'](node, scope, out, 'i64', ctx)


def push_ascii_builtin(args, scope, out, dtype, ctx):
    """`ascii(s)` -> chuoi voi ky tu > 127 viet dang `\\xNN` (giong Python).

    CHI nhan CHUOI LITERAL (tinh luc bien dich)."""
    if len(args) != 1:
        raise SyntaxError("il_codegen: ascii(s) nhan dung 1 tham so")
    node = args[0]
    if node[0] != 'str_lit':
        raise SyntaxError(
            "il_codegen: ascii(s) - chi nhan CHUOI LITERAL (vd ascii(\"abc\")); "
            "voi bien chuoi se phai quet tung ky tu luc chay")
    raw = node[1][1:-1]
    # PHẢI x4 dau `\` trong nguon Python: 2 cho chuoi Python + 2 cho IL.
    # IL khong co escape `\x` - `ldstr "h\xe9llo"` se lam mat dau `\` va ra
    # "hxe9llo". Can `\\x` moi ra duoc 1 dau `\`.
    # Boc dau nhay don nhu Python: ascii("abc") == "'abc'" (Python ascii() =
    # repr(), nen co con dau nhay).
    esc = ''.join(ch if ord(ch) < 128 else '\\\\x%02x' % ord(ch) for ch in raw)
    out.append(f"    ldstr \"'{esc}'\"")


def push_delattr_builtin(args, scope, out, dtype, ctx):
    """`delattr(o, "x")` -> bao loi BIEN DICH, khong tao gia tri gia.

    KHONG thuc hien duoc: field cua record la FIELD CUA STRUCT, so luong va vi
    tri da chot luc bien dich - khong the xoa ma giu nguyen phan tu. `del xs[i]`
    (mien container) thi lam duoc."""
    # Python: `delattr(object, name)` - 2 THAM SO (da viet nham 3, copy-paste
    # tu `setattr`; bien dich that bai loi 2026-09-30).
    if len(args) != 2:
        raise SyntaxError(
            f"il_codegen: delattr(o, attr_name) nhan 2 tham so (nhan {len(args)})")
    raise SyntaxError(
        "il_codegen: delattr(o, \"x\") chua ho tro - field cua record la field "
        "CUA STRUCT, so luong chot luc bien dich nen khong xoa duoc. Muon xoa "
        "phan tu container thi dung `del xs[i]` (hieu nghia giong Python)")


register_expr_builtin('hasattr', push_hasattr_builtin, 'i32')
register_expr_builtin('getattr', push_getattr_builtin, 'str',
                      return_dtype_fn=_getattr_dtype_fn,
                      dtype_fn_wants_ctx=True)
register_expr_builtin('setattr', push_setattr_builtin, 'i32')
register_expr_builtin('callable', push_callable_builtin, 'i32')
register_expr_builtin('id', push_id_builtin, 'i32')
register_expr_builtin('hash', push_hash_builtin, 'i64')
register_expr_builtin('ascii', push_ascii_builtin, 'str')
register_expr_builtin('delattr', push_delattr_builtin, 'i32')
# `dir` tra CONTAINER nen can return_ta (dtype phan tu + shape), khong dung
# return_dtype (chi dung cho gia tri vo huong).
register_expr_builtin('dir', push_dir_builtin, None,
                      return_ta=TypeAnn('str', 'list'))
