# -*- coding: utf-8 -*-
"""Kieu IL cua ValueTuple<T1..TN> - tach rieng file theo tinh nang
(2026-07-28).

Tu Phase 1 buoc 3 (2026-07-28), file nay CUNG so huu logic parse+codegen
+first-pass cua 'tuple_assign' (x, y = ...) VA 'return_tuple' (return a,
b, ...), cung quy uoc dependency-injection qua `ctx` nhu list/set/dict.
NGOAI LE (theo dung plan da duyet): line-parser cua 'return_tuple' VAN O
CORE - no dung CHUNG 1 ham (`_lp_return`) voi 'return' (scalar) vi CA
HAI cung xuat phat tu 1 regex `_RETURN_RE`/`return_tuple`-vs-`return`
chi phan biet duoc SAU KHI parse xong danh sach bieu thuc (so luong gia
tri) - khong the tach thanh 2 line-parser doc lap ma khong parse 2 lan.
Se chuyen dich vao target import khi control_flow.py (so huu 'return')
ra doi o buoc 10."""
import re

from il_core import IL_SCALAR, parse_expr, parse_expr_list
from il_dispatch import (register_assign_rhs_parser, register_expr_codegen,
                        register_line_parser, register_stmt_codegen,
                          register_first_pass_walk, EXPR_BUILTIN_RETURN_TA,
                          EXPR_BUILTIN_RETURN_TA_FN)

MAX_TUPLE_ARITY = 7  # ValueTuple`1..`7 co san (`8 can TRest long nhau, ngoai pham vi)


def il_tupleN_type(dtypes: list) -> str:
    """Kieu IL cua System.ValueTuple<T1,...,TN> (struct, co san trong
    mscorlib). Xac minh THAT bang probe .il rieng cho N=2 (session truoc)
    VA N=3 (probe_tuple3.il, 2026-07-28, tong quat hoa tu ban CHI ho tro
    2 phan tu) - cung 1 pattern Item1..ItemN cho moi arity, khong co gi
    khac biet giua N=2 va N=3 ngoai so luong tham so generic."""
    n = len(dtypes)
    if not (2 <= n <= MAX_TUPLE_ARITY):
        raise SyntaxError(f"il_codegen: tuple {n} phan tu khong hop le (chi ho tro 2-{MAX_TUPLE_ARITY})")
    params = ', '.join(IL_SCALAR[d] for d in dtypes)
    return f'valuetype [mscorlib]System.ValueTuple`{n}<{params}>'


_TUPLE_ASSIGN_RE = re.compile(r'^(\w+(?:\s*,\s*\w+)+)\s*=\s*(.+)$')


def try_parse_tuple_assign(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    """LINE_PARSERS entry: 'x, y, ... = ...' (2-7 target) - hoac giai nen
    1 loi goi ham tra ve tuple N phan tu (xem 'return_tuple'), hoac gan
    song song N bieu thuc doc lap ('x, y, z = a, b, c', ke ca hoan doi
    'x, y = y, x') - CHUA BIET o day RHS thuoc dang nao (can func_table,
    chi co o first-pass/codegen) - luu CA HAI kha nang (rhs_nodes co the
    co 1 hoac N phan tu) de quyet dinh sau."""
    m = _TUPLE_ASSIGN_RE.match(line)
    if not m:
        return None
    targets_text, rhs = m.groups()
    targets = [t.strip() for t in targets_text.split(',')]
    rhs_nodes = parse_expr_list(rhs)
    if len(rhs_nodes) not in (1, len(targets)):
        raise SyntaxError(
            f"il_codegen: '{targets_text} = {rhs}' - ve phai co {len(rhs_nodes)} gia "
            f"tri, can 1 (goi ham tra ve tuple {len(targets)} phan tu) hoac "
            f"{len(targets)} (gan song song)")
    return {'kind': 'tuple_assign', 'targets': targets, 'rhs_nodes': rhs_nodes}, pos + 1


def codegen_return_tuple(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 'return a, b, ...'."""
    if sig.return_type is None or sig.return_type.shape != 'tuple' or \
            len(sig.return_type.tuple_dtypes) != len(stmt['expr_nodes']):
        raise SyntaxError(
            f"il_codegen: ham '{sig.name}' co 'return {stmt['expr_text']}' "
            f"({len(stmt['expr_nodes'])} gia tri) nhung chu ky khong khai bao return "
            f"type dang tuple cung so phan tu")
    dtypes = sig.return_type.tuple_dtypes
    tuple_type = il_tupleN_type(dtypes)
    compile_expr = ctx['compile_expr']
    for expr_node, d in zip(stmt['expr_nodes'], dtypes):
        compile_expr(expr_node, scope, body, d, ctx)
    ctor_params = ', '.join(f'!{i}' for i in range(len(dtypes)))
    body.append(f'    newobj instance void {tuple_type}::.ctor({ctor_params})')
    if ctx.get('try_depth', 0) > 0:
        ctx['store_var'](ctx['ret_tmp_name'], scope, body)
        body.append(f'    leave {ctx["epilogue_lbl"]}')
    else:
        body.append('    ret')


def codegen_tuple_assign(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 'x, y, ... = ...'."""
    rhs_nodes = stmt['rhs_nodes']
    targets = stmt['targets']
    compile_expr = ctx['compile_expr']
    store_var = ctx['store_var']
    if len(rhs_nodes) == 1 and rhs_nodes[0][0] == 'index':
        # 'k, v = lst[i]' (Phase 3.2, 2026-08-11 - most_common(c,n) tra ve
        # list[(K,i32)], can doc lai tung phan tu) - 'lst' phai la 1 BIEN
        # list-cua-tuple (elem_ta.shape=='tuple'). Dung LAI y het mau
        # ldloc-roi-ldfld cua nhanh 'call' ben duoi (da xac minh THAT) -
        # chi khac buoc lay GIA TRI tuple: get_Item(int32) thay vi goi ham.
        idx_node = rhs_nodes[0]
        list_name, indices = idx_node[1], idx_node[2]
        if len(indices) != 1:
            raise SyntaxError(f"il_codegen: '{', '.join(targets)} = {list_name}[...]' chi ho tro 1 chi so")
        _, _, list_ta = scope[list_name]
        dtypes = list_ta.elem_ta.tuple_dtypes
        tuple_type = il_tupleN_type(dtypes)
        list_type = ctx['il_type_str'](list_ta, ctx.get('records'))
        _, tmp_idx, _ = scope[f'__tupleassign{id(stmt)}_tmp']
        ctx['load_var_ref'](list_name, scope, body)
        compile_expr(indices[0], scope, body, 'i32', ctx)
        body.append(f'    callvirt instance !0 {list_type}::get_Item(int32)')
        body.append(f'    stloc.s {tmp_idx}')
        for i, t in enumerate(targets):
            body.append(f'    ldloc.s {tmp_idx}')
            body.append(f'    ldfld !{i} {tuple_type}::Item{i + 1}')
            store_var(t, scope, body)
    elif (len(rhs_nodes) == 1 and isinstance(rhs_nodes[0], tuple)
          and len(rhs_nodes[0]) == 2 and rhs_nodes[0][0] == 'tuple_literal'):
        # 'a, b = (3, 4)' - ben phai la TUPLE LITERAL (2026-09-29).
        # Dat TRUOC nhanh 'call' ben duoi: nhanh do lay kieu tu func_table
        # theo TEN HAM, ma literal khong co ten ham - se no KeyError.
        _, tmp_idx, tmp_ta = scope[f'__tupleassign{id(stmt)}_tmp']
        # Lay dtype tu TypeAnn da khai bao o FIRST-PASS, KHONG tu suy lai o day
        # (xem emit_tuple_literal's docstring ve vi sao 2 tang phai dung
        # cung nguon su that).
        dtypes = tmp_ta.tuple_dtypes
        tuple_type = il_tupleN_type(dtypes)
        emit_tuple_literal(rhs_nodes[0][1], dtypes, scope, body, ctx)
        body.append(f'    stloc.s {tmp_idx}')
        for i, t in enumerate(targets):
            body.append(f'    ldloc.s {tmp_idx}')
            body.append(f'    ldfld !{i} {tuple_type}::Item{i + 1}')
            store_var(t, scope, body)
    elif len(rhs_nodes) == 1 and rhs_nodes[0][0] == 'var':
        # 'x, y = inner' - ben phai la 1 BIEN kieu tuple (2026-09-29). Doc
        # ValueTuple (value type) qua local tam roi lay 'ItemN' n lan - dung
        # y het mau 'call' ben duoi, chi khac buoc nap lai gia tri.
        var_node = rhs_nodes[0]
        dtypes = scope[var_node[1]][2].tuple_dtypes
        tuple_type = il_tupleN_type(dtypes)
        _, tmp_idx, _ = scope[f'__tupleassign{id(stmt)}_tmp']
        ctx['load_var_ref'](var_node[1], scope, body)
        body.append(f'    stloc.s {tmp_idx}')
        for i, t in enumerate(targets):
            body.append(f'    ldloc.s {tmp_idx}')
            body.append(f'    ldfld !{i} {tuple_type}::Item{i + 1}')
            store_var(t, scope, body)
    elif len(rhs_nodes) == 1:
        # 'x, y, ... = f(...)' - f co the la HAM NGUOI DUNG (func_table)
        # HOAC 1 BUILTIN dang ky return_ta shape='tuple' (xem
        # fpw_tuple_assign o tren, CUNG logic phan nhanh). f tra ve 1
        # ValueTuple<T1..TN> that - luu vao local tam TRUOC roi doc lai
        # N lan (ldfld doc truc tiep tren 1 gia tri value-type KHONG can
        # dia chi, nhung can nap lai MOI LAN vi ldfld 'tieu thu' instance
        # tren dinh stack - da xac minh THAT bang probe .il rieng, N=2
        # session truoc + N=3 probe_tuple3.il).
        call_node = rhs_nodes[0]
        builtin_name = call_node[1]
        if ctx.get('func_table') and builtin_name in ctx['func_table']:
            dtypes = ctx['func_table'][builtin_name].return_type.tuple_dtypes
        else:
            from il_dispatch import EXPR_BUILTIN_RETURN_TA as _EBRT
            from il_dispatch import EXPR_BUILTIN_RETURN_TA_FN as _EBRTFN
            if builtin_name in _EBRT:
                dtypes = _EBRT[builtin_name].tuple_dtypes
            else:
                dtypes = _EBRTFN[builtin_name](call_node[2], scope).tuple_dtypes
        tuple_type = il_tupleN_type(dtypes)
        _, tmp_idx, _ = scope[f'__tupleassign{id(stmt)}_tmp']
        compile_expr(call_node, scope, body, dtypes[0], ctx)
        body.append(f'    stloc.s {tmp_idx}')
        for i, t in enumerate(targets):
            body.append(f'    ldloc.s {tmp_idx}')
            body.append(f'    ldfld !{i} {tuple_type}::Item{i + 1}')
            store_var(t, scope, body)
    else:
        # 'x, y, ... = a, b, ...' - danh gia CA N ve vao local tam
        # TRUOC roi moi gan vao target - dam bao ngu nghia hoan doi
        # dung THAT (vd 'x, y = y, x'), khong bi ghi de giua chung.
        for i, rhs_node in enumerate(rhs_nodes):
            _, tmp_idx, tmp_ta = scope[f'__tupleassign{id(stmt)}_t{i + 1}']
            compile_expr(rhs_node, scope, body, tmp_ta.dtype, ctx)
            body.append(f'    stloc.s {tmp_idx}')
        for i, t in enumerate(targets):
            _, tmp_idx, _ = scope[f'__tupleassign{id(stmt)}_t{i + 1}']
            body.append(f'    ldloc.s {tmp_idx}')
            store_var(t, scope, body)


def _tuple_literal_dtypes(elements, scope, ctx):
    """(dtypes) cho tuple literal - suy tu TUNG phan tu, dung CHUNG logic voi
    list/dict/set literal (xem list_type.py's `list_literal_elem_spec_of` la
    nguon su that duy nhat, tranh 2 bo suy kieu lech nhau)."""
    from il_features.list_type import list_literal_elem_spec_of
    return [list_literal_elem_spec_of(el, scope, ctx) for el in elements]


def codegen_expr_tuple_literal(node, scope, out, dtype, ctx=None):
    """EXPR_CODEGEN entry cho tag 'tuple_literal' - `(1, 2)` o VI TRI BIEU THUC
    (2026-09-29).

    KHONG `store_var`: gia tri phai de LEN DONG cho noi goi dung (trái voi
    `codegen_return_tuple`/`codegen_tuple_assign` la bien cua cau lenh).

    Khu vuc dung y het `codegen_return_tuple` (`newobj ... ::.ctor(!0, !1)`) -
    `ValueTuple` la value type nen moi phan tu la 1 arg cua ctor chu khong
    phai gan vao field nao ca.
    """
    elements = node[1]
    dtypes = _tuple_literal_dtypes(elements, scope, ctx)
    for d in dtypes:
        if d is None:
            raise SyntaxError(
                f"il_codegen: khong suy duoc kieu cua 1 phan tu trong tuple literal "
                f"({', '.join(str(x) for x in elements)}) - gan bien trung gian truoc "
                f"roi truyen vao thay vi viet literal")
    emit_tuple_literal(elements, dtypes, scope, out, ctx)


def emit_tuple_literal(elements, dtypes, scope, out, ctx):
    """Day 1 `ValueTuple` len TREN DONG, voi `dtypes` do CALLER quyet dinh.

    Tach rieng vi nguyen nhan quan trong (2026-09-29): first-pass va codegen suy
    kieu int literal KHAC NHAU - `infer_scope` cho 'int' (TkvInt) con scope that
    cho 'i32'. Neu hai tang tu suy rieng thi first-pass khai bao
    `a: TkvInt` trong khi codegen `newobj ValueTuple<int32,int32>` -> doc `Item1`
    (int32) vao 1 bien TkvInt (16 byte) -> lenh lech kich thuoc va
    `NullReferenceException` luc chay, KHONG phai loi bien dich.
    Voi duong lenh (gan/pahuy literal) thi `dtypes` lay tu TypeAnn da khai bao
    o first-pass - mot nguon su that duy nhat cho ca hai tang.
    """
    compile_expr = ctx['compile_expr']
    for el, d in zip(elements, dtypes):
        compile_expr(el, scope, out, d, ctx)
    tuple_type = il_tupleN_type(dtypes)
    ctor_params = ', '.join(f'!{i}' for i in range(len(dtypes)))
    out.append(f'    newobj instance void {tuple_type}::.ctor({ctor_params})')


def try_rhs_tuple_literal(rhs, name, known_shapes):
    """ASSIGN_RHS_PARSERS entry: 't = (1, 2)' (2026-09-29).

    CUNG khuong 'ten_don = <literal>' voi list/dict/set literal, va cung ly do:
    parser THAT sinh node 'tuple_literal' o vi tri bieu thuc, nhung khai bao
    local kieu tuple chi lam duoc o first-pass - ma `assign_scalar` (duong
    fallback cua `_lp_assign`) chi ghi `known_shapes`, khong khai bao gi. Khong
    co entry nay thi `x, y = t` bao "'t' khong phai bien kieu tuple".
    """
    rhs_s = rhs.strip()
    if not (rhs_s.startswith('(') and rhs_s.endswith(')')):
        return None
    try:
        node = parse_expr(rhs_s)
    except SyntaxError:
        return None
    if not (isinstance(node, tuple) and len(node) == 2 and node[0] == 'tuple_literal'):
        return None
    known_shapes[name] = 'tuple'
    return {'kind': 'assign_tuple_literal', 'name': name, 'rhs_node': node}


_TUPLE_CALL_RE = re.compile(r'^tuple\(\s*(.*?)\s*\)\s*$')


def _elem_src_text(node):
    """Van ban cua 1 phan tu trong list literal, de thong diep loi doc duoc
    (`1`, `2`) thay vi lo AST ngoi bo `('num', '1')`."""
    if isinstance(node, tuple) and len(node) >= 2:
        return str(node[1])
    return str(node)


def try_rhs_tuple_call(rhs, name, known_shapes):
    """ASSIGN_RHS_PARSERS entry: `t = tuple(...)` (them 2026-09-30).

    KHAC BIET KIEN TRUC - doc ky truoc khi sua:
    `tuple` cua TokenVector KHONG phai container bien do dai nhu Python. No la
    `System.ValueTuple<T1..TN>`, mot VALUE TYPE co so luong phan tu CO DINH
    2..MAX_TUPLE_ARITY biet luc bien dich (`il_tupleN_type` tu choi N<2).
    Vi vay khong the lam ton tai mot `tuple()` rong (arity 0) hay
    `tuple(xs)` khi do dai cua `xs` chua biet.

    Do la xung dot THIET KE, khong phai thieu cong code - nen phai bao loi ro
    thay vi "tra ve thu gi do". Chi lam duoc phan BIEU DIEN DUOC:
      - `tuple(t)`          - t da la tuple: tra ve chinh t (Python cung vay:
                              `tuple(t) is t`)
      - `tuple([a, b, c])`  - LIST LITERAL: do dai biet luc bien dich nen
                              doi duoc sang ValueTuple<T...>
    Con lai bao loi, kem goi y cach viet thay the."""
    m = _TUPLE_CALL_RE.match(rhs.strip())
    if not m:
        return None
    arg = m.group(1)
    if arg == '':
        raise SyntaxError(
            "il_codegen: tuple() - tuple cua TokenVector la ValueTuple co so "
            "phan tu CO DINH (2..%d, biet luc bien dich), khong co dang rong "
            "nhu Python. Hay viet `(1, 2)` cho tuple 2 phan tu." % MAX_TUPLE_ARITY)
    if re.match(r'^\w+$', arg):
        if arg in known_shapes and known_shapes.get(arg) == 'tuple':
            known_shapes[name] = 'tuple'
            return {'kind': 'assign_tuple_identity', 'name': name, 'src': arg}
        if arg in known_shapes:
            if known_shapes.get(arg) == 'list':
                raise SyntaxError(
                    f"il_codegen: tuple({arg}) - '{arg}' la LIST, do dai chua "
                    f"biet luc bien dich nen khong doi duoc sang ValueTuple "
                    f"(co so phan tu co dinh 2..{MAX_TUPLE_ARITY}). Hay viet "
                    f"truc tiep `(a, b, c)`, hoac `tuple([a, b, c])` neu muon "
                    f"chuyen tu list literal.")
            raise SyntaxError(
                f"il_codegen: tuple({arg}) - '{arg}' co shape="
                f"{known_shapes.get(arg)!r}, khong phai tuple")
        raise SyntaxError(
            f"il_codegen: tuple({arg}) - bien '{arg}' chua duoc khai bao TRUOC "
            f"dong nay (tuple can bien nguon khai bao truoc trong van ban)")
    # Con lai: co the la LIST LITERAL - do dai biet luc bien dich
    try:
        node = parse_expr(arg)
    except SyntaxError:
        node = None
    if isinstance(node, tuple) and len(node) == 2 and node[0] == 'list_literal':
        elems = node[1]
        if len(elems) < 2:
            shown = ', '.join(_elem_src_text(e) for e in elems) or 'rong'
            raise SyntaxError(
                f"il_codegen: tuple([{shown}]) - chi {len(elems)} phan tu; "
                f"ValueTuple yeu cau it nhat 2")
        known_shapes[name] = 'tuple'
        return {'kind': 'assign_tuple_literal', 'name': name,
                'rhs_node': ('tuple_literal', elems)}
    if isinstance(node, tuple) and len(node) == 2 and node[0] == 'tuple_literal':
        # `tuple((4, 5))` - giong het dang literal `(4, 5)` (Python cung tra ve
        # chinh tuple do). Do dai da biet nen doi duoc truc tiep.
        elems = node[1]
        known_shapes[name] = 'tuple'
        return {'kind': 'assign_tuple_literal', 'name': name,
                'rhs_node': node}
    raise SyntaxError(
        f"il_codegen: tuple({arg}) - chi nhan BIEN da khai bao (kieu tuple), "
        f"LIST LITERAL `tuple([a, b])`, hoac TUPLE LITERAL `tuple((a, b))`, vi "
        f"ValueTuple can SO PHAN TU biet luc bien dich. Khong nhan bieu thuc "
        f"bien dong (`tuple(xs)` khi xs la bien list) vi do dai xs chua biet. "
        f"Hay viet truc tiep `(a, b, c)`.")


def fpw_assign_tuple_identity(stmt, ctx):
    """FIRST_PASS_WALK: `t = tuple(u)` - khai lai y kieu tuple cua `u`
    (chi can gan lai - gia tri se duoc gan o codegen)."""
    name = stmt['name']
    if name in ctx['declared_names']:
        return
    src = stmt['src']
    try:
        src_ta = ctx['infer_scope'][src][2]
    except KeyError:
        raise SyntaxError(
            f"il_codegen: tuple({src}) - '{src}' chua duoc khai bao TRUOC dong nay")
    if src_ta.shape != 'tuple':
        raise SyntaxError(f"il_codegen: tuple({src}) - '{src}' khong phai tuple")
    ctx['declared_names'].add(name)
    ta = ctx['TypeAnn'](src_ta.dtype, 'tuple',
                        tuple_dtypes=list(src_ta.tuple_dtypes))
    ctx['locals_decl'].append((name, ta))
    ctx['infer_scope'].set(name, ta)


def codegen_assign_tuple_identity(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN: `t = tuple(u)` - `u` da la ValueTuple nen chi can gan
    lai (ValueTuple la VALUE TYPE: copy bang `ldloc`, khong can `newobj`)."""
    ctx['load_var_ref'](stmt['src'], scope, body)
    ctx['store_var'](stmt['name'], scope, body)


def fpw_assign_tuple_literal(stmt, ctx):
    """FIRST_PASS_WALK: khai bao local kieu tuple cho 't = (1, 2)'."""
    name = stmt['name']
    if name in ctx['declared_names']:
        return
    dtypes = _tuple_literal_dtypes(stmt['rhs_node'][1], ctx['infer_scope'], ctx)
    if any(d is None for d in dtypes):
        return  # de error ro hon o codegen
    ctx['declared_names'].add(name)
    ta = ctx['TypeAnn'](dtypes[0], 'tuple', tuple_dtypes=dtypes)
    ctx['locals_decl'].append((name, ta))
    ctx['infer_scope'].set(name, ta)
    for el in stmt['rhs_node'][1]:
        ctx['collect_ternary_temps'](el)


def codegen_assign_tuple_literal(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN entry: 't = (1, 2)'.

    Gia tri da duoc day len DONG boi `codegen_expr_tuple_literal` (no KHONG
    store_var) - o day chi gan vao bien.
    """
    _, _, ta = scope[stmt['name']]
    # Dtype lay tu local da khai bao o first-pass - xem emit_tuple_literal.
    emit_tuple_literal(stmt['rhs_node'][1], ta.tuple_dtypes, scope, body, ctx)
    ctx['store_var'](stmt['name'], scope, body)


_FOR_PAIR_RE = re.compile(r'^for\s+(\w+)\s*,\s*(\w+)\s+in\s+(\[.*\]|\(\w+\))\s*:\s*$')


def try_parse_for_tuple_pairs(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    """LINE_PARSERS entry: 'for a, b in <nguon>:' (2026-09-29).

    Ly do can LINE_PARSER rieng: macro `for_in_list` (control_flow.tkv) chay
    TRUOC khi co thong tin kieu va chi viet duoi dang 'for <1 bien> in <ten
    bien>:' - 2 bien no khong khop, rơi xuong "khong dich duoc dong".

    Regex chi nhan container la list literal (`[...]`) hoac bien trong ngoac
    don (`(<ten>)`) de khong cuop `for k, v in d.items()` hay bien tran cua
    cac duong hien co. Bien trong ngoac duoc giu lai de first-pass bao loi
    ro rang thay vi macro xu ly nham.

    KHONG dua vao he spec (`list[...]`/`dict[...]`/`set[...]`): spec dung dau
    ngoac VUONG, con tuple la `(i32,i32)` - ngoac TRON. Ep tuple vao he spec
    se lam `is_container_spec` tra True cho 1 gia tri KHONG phai container, va
    `ta.elem_ta is not None` chinh la cach codebase nhan biet 'phan tu la
    container' (reject_if_nested_container_elem) - se lo doi nham.
    """
    m = _FOR_PAIR_RE.match(line)
    if not m:
        return None
    var_a, var_b, src_text = m.groups()
    pos += 1
    if pos >= len(lines) or lines[pos][0] <= indent_level:
        raise SyntaxError(
            f"il_codegen: 'for {var_a}, {var_b} in {src_text}:' khong co than khoi (block rong)")
    body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
    return {'kind': 'for_tuple_pairs', 'var_a': var_a, 'var_b': var_b,
            'src_text': src_text, 'body': body}, pos


def _pair_src_tuple_dtypes(stmt, ctx):
    """(dtypes, elements) cua cac tuple trong nguon cua 'for a, b in <nguon>'.

    Phien ban nay CHI chap nhan list literal chua cac tuple literal.
    Ly do: nguon duoc tach thanh HAI LIST vo huong song song. Duong
    `List<T>.Add(!0)` voi T la tuple chua TkvInt thi ilasm van assemble nhung
    CLR nem InvalidProgramException luc chay; mang ValueTuple cung khong doc
    duoc (`ldelem`/`ldelema` deu bi verifier tu choi voi kieu nay). Tach ra
    hai `List<vo huong>` chi dung cac lenh da co tien le chay dung.
    Nguon la bien list-cua-tuple bi tu choi RO RANG cho den khi co duong doc
    hop le cho no.
    """
    src = parse_expr(stmt['src_text'])
    infer_scope = ctx['infer_scope']
    if src[0] == 'var':
        return None, None, (f"'{src[1]}' la bien: phien ban nay chi ho tro list literal "
                            "chua cac tuple literal (`for i, j in [...]`)")
    if src[0] != 'list_literal' or len(src[1]) < 1:
        return None, None, 'chi ho tro list literal khong rong chua cac tuple literal'
    first = src[1][0]
    if not (isinstance(first, tuple) and len(first) == 2 and first[0] == 'tuple_literal'):
        return None, None, 'list literal phai chua cac tuple literal'
    dtypes = _tuple_literal_dtypes(first[1], infer_scope, ctx)
    if any(d is None for d in dtypes):
        return None, None, 'khong suy duoc kieu cua phan tu trong tuple literal'
    if len(dtypes) != 2:
        return None, None, 'vong lap co hai bien nen moi tuple phai co dung hai phan tu'
    for pos, el in enumerate(src[1][1:], start=2):
        if not (isinstance(el, tuple) and len(el) == 2 and el[0] == 'tuple_literal'):
            return None, None, f'phan tu thu {pos} khong phai tuple literal'
        cur = _tuple_literal_dtypes(el[1], infer_scope, ctx)
        if any(d is None for d in cur) or len(cur) != 2 or cur != dtypes:
            return None, None, f'phan tu thu {pos} khong cung kieu voi tuple dau tien'
    for el in src[1]:
        for part in el[1]:
            ctx['collect_ternary_temps'](part)
    return dtypes, list(src[1]), None


def fpw_for_tuple_pairs(stmt, ctx):
    """FIRST_PASS_WALK cho 'for a, b in <nguon>:'."""
    dtypes, elements, err = _pair_src_tuple_dtypes(stmt, ctx)
    if dtypes is None:
        raise SyntaxError(
            f"il_codegen: 'for {stmt['var_a']}, {stmt['var_b']} in {stmt['src_text']}:' - {err}")
    sid = id(stmt)
    stmt['pair_elements'] = elements
    TypeAnn = ctx['TypeAnn']
    elem_ta = TypeAnn(dtypes[0], 'tuple', tuple_dtypes=dtypes)
    ctx['declare_named'](f'__tfp_asrc{sid}', TypeAnn(dtypes[0], 'list'))
    ctx['declare_named'](f'__tfp_bsrc{sid}', TypeAnn(dtypes[1], 'list'))
    ctx['declare_named'](f'__tfp_idx{sid}', TypeAnn('i32', None))
    ctx['declare_named'](f'__tfp_tmp{sid}', elem_ta)
    ctx['declare_named'](stmt['var_a'], TypeAnn(dtypes[0], None))
    ctx['declare_named'](stmt['var_b'], TypeAnn(dtypes[1], None))
    ctx['walk_fn'](stmt['body'])


def codegen_for_tuple_pairs(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    """STMT_CODEGEN cho 'for a, b in <nguon>:'.

    Moi tuple duoc xay mot lan, doc `Item1`/`Item2` ra, roi nap hai thanh phan
    vao HAI LIST vo huong song song. Ly do da kiem chung THAT voi tuple chua
    TkvInt: `List<T>.Add(!0)` voi T la tuple thi assemble duoc nhung CLR nem
    InvalidProgramException; `ldelem`/`ldelema` tren mang tuple cung bi
    verifier tu choi. Tach ra hai `List<vo huong>` thi vong lap chi dung
    `get_Count`/`get_Item` vo huong - cac lenh da co tien le chay dung.
    """
    sid = id(stmt)
    _, a_src_idx, a_src_ta = scope[f'__tfp_asrc{sid}']
    _, b_src_idx, b_src_ta = scope[f'__tfp_bsrc{sid}']
    _, idx_idx, _ = scope[f'__tfp_idx{sid}']
    _, tmp_idx, tmp_ta = scope[f'__tfp_tmp{sid}']
    dtypes = tmp_ta.tuple_dtypes
    records = ctx.get('records')
    a_list_type = ctx['il_type_str'](a_src_ta, records)
    b_list_type = ctx['il_type_str'](b_src_ta, records)

    # Nguon: chi list literal da duoc first-pass kiem tra va luu lai.
    elements = stmt.get('pair_elements')
    if not elements:
        raise SyntaxError(
            "il_codegen: codegen cua 'for a, b in ...' thieu danh sach tuple da "
            "duoc first-pass kiem tra")
    body.append(f'    newobj instance void {a_list_type}::.ctor()')
    body.append(f'    stloc.s {a_src_idx}')
    body.append(f'    newobj instance void {b_list_type}::.ctor()')
    body.append(f'    stloc.s {b_src_idx}')
    for el in elements:
        emit_tuple_literal(el[1], dtypes, scope, body, ctx)
        body.append(f'    stloc.s {tmp_idx}')
        body.append(f'    ldloc.s {a_src_idx}')
        body.append(f'    ldloc.s {tmp_idx}')
        body.append(f'    ldfld !0 {il_tupleN_type(dtypes)}::Item1')
        body.append(f'    callvirt instance void {a_list_type}::Add(!0)')
        body.append(f'    ldloc.s {b_src_idx}')
        body.append(f'    ldloc.s {tmp_idx}')
        body.append(f'    ldfld !1 {il_tupleN_type(dtypes)}::Item2')
        body.append(f'    callvirt instance void {b_list_type}::Add(!0)')
    body.append('    ldc.i4.0')
    body.append(f'    stloc.s {idx_idx}')

    ctx['label_counter'][0] += 1
    n = ctx['label_counter'][0]
    start_lbl = f"{ctx['prefix']}_TFP{n}_start"
    cont_lbl = f"{ctx['prefix']}_TFP{n}_cont"
    end_lbl = f"{ctx['prefix']}_TFP{n}_end"

    body.append(f'  {start_lbl}:')
    body.append(f'    ldloc.s {idx_idx}')
    body.append(f'    ldloc.s {a_src_idx}')
    body.append(f'    callvirt instance int32 {a_list_type}::get_Count()')
    body.append(f'    bge {end_lbl}')
    body.append(f'    ldloc.s {a_src_idx}')
    body.append(f'    ldloc.s {idx_idx}')
    body.append(f'    callvirt instance !0 {a_list_type}::get_Item(int32)')
    ctx['store_var'](stmt['var_a'], scope, body)
    body.append(f'    ldloc.s {b_src_idx}')
    body.append(f'    ldloc.s {idx_idx}')
    body.append(f'    callvirt instance !0 {b_list_type}::get_Item(int32)')
    ctx['store_var'](stmt['var_b'], scope, body)
    ctx['loop_stack'].append((cont_lbl, end_lbl))
    codegen_stmts_fn(stmt['body'], scope, body, body_dtype, ctx, sig)
    ctx['loop_stack'].pop()
    body.append(f'  {cont_lbl}:')
    body.append(f'    ldloc.s {idx_idx}')
    body.append('    ldc.i4.1')
    body.append('    add')
    body.append(f'    stloc.s {idx_idx}')
    body.append(f'    br {start_lbl}')
    body.append(f'  {end_lbl}:')


def fpw_return_tuple(stmt, ctx):
    collect_ternary_temps = ctx['collect_ternary_temps']
    for expr_node in stmt['expr_nodes']:
        collect_ternary_temps(expr_node)


def fpw_tuple_assign(stmt, ctx):
    rhs_nodes = stmt['rhs_nodes']
    targets = stmt['targets']
    func_table = ctx['func_table']
    declare_named = ctx['declare_named']
    collect_ternary_temps = ctx['collect_ternary_temps']
    TypeAnn = ctx['TypeAnn']
    infer_scope = ctx.get('infer_scope')
    if len(rhs_nodes) == 1 and rhs_nodes[0][0] == 'index' and infer_scope is not None:
        # 'k, v = lst[i]' (Phase 3.2, 2026-08-11) - 'lst' phai la 1 BIEN
        # list-cua-tuple da khai bao (elem_ta.shape=='tuple') - xem
        # codegen_tuple_assign's nhanh tuong ung.
        idx_node = rhs_nodes[0]
        list_name, indices = idx_node[1], idx_node[2]
        try:
            list_ta = infer_scope[list_name][2]
        except KeyError:
            raise SyntaxError(f"il_codegen: '{', '.join(targets)} = {list_name}[...]' - '{list_name}' chua duoc khai bao")
        if list_ta.shape != 'list' or list_ta.elem_ta is None or list_ta.elem_ta.shape != 'tuple':
            raise SyntaxError(
                f"il_codegen: '{', '.join(targets)} = {list_name}[...]' - '{list_name}' phai la "
                f"1 list-cua-tuple (vd 'list[(K,i32)]' tra ve tu most_common(...))")
        dtypes = list_ta.elem_ta.tuple_dtypes
        if len(dtypes) != len(targets):
            raise SyntaxError(
                f"il_codegen: '{', '.join(targets)} = {list_name}[...]' - can {len(dtypes)} "
                f"target (tuple {len(dtypes)} phan tu), gap {len(targets)}")
        for t, d in zip(targets, dtypes):
            declare_named(t, TypeAnn(d, None))
        declare_named(f'__tupleassign{id(stmt)}_tmp',
                      TypeAnn(dtypes[0], 'tuple', tuple_dtypes=dtypes))
        for idx_expr in indices:
            collect_ternary_temps(idx_expr)
    elif (len(rhs_nodes) == 1 and isinstance(rhs_nodes[0], tuple)
          and len(rhs_nodes[0]) == 2 and rhs_nodes[0][0] == 'tuple_literal'):
        # 'a, b = (3, 4)' - ben phai la TUPLE LITERAL (2026-09-29).
        # Dat TRUOC nhanh 'call' ben duoi: nhanh do tra `builtin_name =
        # call_node[1]` va tu choi moi thu khong phai 'call' - ma literal
        # khong co ten ham nen se bao loi sai.
        lit = rhs_nodes[0]
        dtypes = _tuple_literal_dtypes(lit[1], infer_scope, ctx)
        if any(d is None for d in dtypes):
            raise SyntaxError(
                f"il_codegen: '{', '.join(targets)} = ({...})' - khong suy duoc kieu cua "
                f"it nhat 1 phan tu. Chan tai DAY (first-pass) thay vi de codegen sinh "
                f"CIL sai")
        if len(dtypes) != len(targets):
            raise SyntaxError(
                f"il_codegen: tuple literal co {len(dtypes)} phan tu nhung "
                f"'{', '.join(targets)}' co {len(targets)} bien ben trai")
        for t, d in zip(targets, dtypes):
            declare_named(t, TypeAnn(d, None))
        declare_named(f'__tupleassign{id(stmt)}_tmp',
                      TypeAnn(dtypes[0], 'tuple', tuple_dtypes=dtypes))
        for el in lit[1]:
            collect_ternary_temps(el)
    elif len(rhs_nodes) == 1 and rhs_nodes[0][0] == 'var' and infer_scope is not None:
        # 'x, y = inner' - ben phai la 1 BIEN da khai bao kieu tuple (2026-09-29).
        # Truoc day chi co 3 dang: 'lst[i]', 'f(...)', va 'a, b' gan song song.
        # Bien chua duoc gap o 2 dang dau nen rơi xuong nhanh 'call' va bao loi
        # sai ("phai la 1 loi goi ham tra ve tuple").
        var_node = rhs_nodes[0]
        try:
            var_ta = infer_scope[var_node[1]][2]
        except KeyError:
            var_ta = None
        if var_ta is None or var_ta.shape != 'tuple':
            raise SyntaxError(
                f"il_codegen: '{', '.join(targets)} = {var_node[1]}' - "
                f"'{var_node[1]}' khong phai bien kieu tuple. 'x, y = <bien>' chi dung "
                f"duoc khi ben phai la 1 tuple (gap bang 1 literal '({', '.join(['dtype'] * len(targets))})'"
                f" o ben phai)")
        dtypes = var_ta.tuple_dtypes
        if len(dtypes) != len(targets):
            raise SyntaxError(
                f"il_codegen: '{var_node[1]}' la tuple {len(dtypes)} phan tu nhung "
                f"'{', '.join(targets)}' co {len(targets)} bien ben trai")
        for t, d in zip(targets, dtypes):
            declare_named(t, TypeAnn(d, None))
        declare_named(f'__tupleassign{id(stmt)}_tmp',
                      TypeAnn(dtypes[0], 'tuple', tuple_dtypes=dtypes))
    elif len(rhs_nodes) == 1:
        # 'x, y, ... = f(...)' - f tra ve 1 tuple that. f co the la HAM
        # NGUOI DUNG (tra func_table, nhu truoc gio) HOAC 1 BUILTIN dang
        # ky return_ta shape='tuple' (batch 5.5b muc 4, 2026-08-13 - vd
        # path_splitext(p) -> (str,str)) - tra EXPR_BUILTIN_RETURN_TA
        # TRUOC, chi raise loi neu CA HAI deu khong khop.
        call_node = rhs_nodes[0]
        if call_node[0] != 'call':
            raise SyntaxError(
                f"il_codegen: '{', '.join(targets)} = ...' voi 1 gia tri ben phai "
                f"phai la 1 loi goi ham TRA VE TUPLE {len(targets)} phan tu "
                f"(vd 'x, y = f(...)')")
        builtin_name = call_node[1]
        if func_table and builtin_name in func_table:
            callee = func_table[builtin_name]
            if callee.return_type is None or callee.return_type.shape != 'tuple' or \
                    len(callee.return_type.tuple_dtypes) != len(targets):
                raise SyntaxError(
                    f"il_codegen: ham '{builtin_name}' khong tra ve tuple {len(targets)} "
                    f"phan tu (can '-> \"({', '.join(['dtype'] * len(targets))})\"' trong chu ky)")
            dtypes = callee.return_type.tuple_dtypes
        elif builtin_name in EXPR_BUILTIN_RETURN_TA and \
                EXPR_BUILTIN_RETURN_TA[builtin_name].shape == 'tuple':
            builtin_ta = EXPR_BUILTIN_RETURN_TA[builtin_name]
            if len(builtin_ta.tuple_dtypes) != len(targets):
                raise SyntaxError(
                    f"il_codegen: '{builtin_name}(...)' tra ve tuple "
                    f"{len(builtin_ta.tuple_dtypes)} phan tu, khong khop "
                    f"{len(targets)} target ben trai")
            dtypes = builtin_ta.tuple_dtypes
        elif builtin_name in EXPR_BUILTIN_RETURN_TA_FN:
            # dtype PHU THUOC tham so (vd divmod(a,b) - batch 5.5b muc
            # cuoi, 2026-08-13). Goi fn(args, infer_scope) NGAY O FIRST
            # PASS de suy dtype tu bien 'a' da khai bao truoc do.
            dyn_ta = EXPR_BUILTIN_RETURN_TA_FN[builtin_name](call_node[2], infer_scope)
            if dyn_ta is None or dyn_ta.shape != 'tuple':
                raise SyntaxError(
                    f"il_codegen: '{builtin_name}(...)' khong suy duoc kieu tra ve tuple "
                    f"(tham so dau co the chua phai 1 BIEN da khai bao kieu ro rang)")
            if len(dyn_ta.tuple_dtypes) != len(targets):
                raise SyntaxError(
                    f"il_codegen: '{builtin_name}(...)' tra ve tuple "
                    f"{len(dyn_ta.tuple_dtypes)} phan tu, khong khop "
                    f"{len(targets)} target ben trai")
            dtypes = dyn_ta.tuple_dtypes
        else:
            raise SyntaxError(
                f"il_codegen: '{', '.join(targets)} = ...' voi 1 gia tri ben phai "
                f"phai la 1 loi goi ham TRA VE TUPLE {len(targets)} phan tu "
                f"(vd 'x, y = f(...)')")
        for t, d in zip(targets, dtypes):
            declare_named(t, TypeAnn(d, None))
        declare_named(f'__tupleassign{id(stmt)}_tmp',
                      TypeAnn(dtypes[0], 'tuple', tuple_dtypes=dtypes))
        collect_ternary_temps(call_node)
    else:
        # Local tam RIENG cho tung ve (KHONG gan thang vao target) - dam
        # bao ngu nghia hoan doi dung THAT ('x, y = y, x' phai danh gia
        # CA N ve TRUOC khi gan bat ky target nao, giong Python that).
        infer_scope = ctx['infer_scope']
        body_dtype = ctx['body_dtype']
        infer_dtype = ctx['infer_dtype']
        for i, (t, rhs_node) in enumerate(zip(targets, rhs_nodes)):
            d = infer_dtype(rhs_node, infer_scope, func_table) or body_dtype
            declare_named(t, TypeAnn(d, None))
            declare_named(f'__tupleassign{id(stmt)}_t{i + 1}', TypeAnn(d, None))
            collect_ternary_temps(rhs_node)


# Dang ky vao il_dispatch NGAY LUC MODULE NAP. 'return_tuple' KHONG dang
# ky LINE_PARSERS o day (van o core's _lp_return, xem docstring dau file).
register_expr_codegen('tuple_literal', codegen_expr_tuple_literal)
register_assign_rhs_parser('tuple_literal', try_rhs_tuple_literal)
register_assign_rhs_parser('tuple_call', try_rhs_tuple_call)
register_first_pass_walk('assign_tuple_identity', fpw_assign_tuple_identity)
register_stmt_codegen('assign_tuple_identity', codegen_assign_tuple_identity)
register_first_pass_walk('assign_tuple_literal', fpw_assign_tuple_literal)
register_stmt_codegen('assign_tuple_literal', codegen_assign_tuple_literal)
register_line_parser('tuple_assign', try_parse_tuple_assign)
register_line_parser('for_tuple_pairs', try_parse_for_tuple_pairs)
register_first_pass_walk('for_tuple_pairs', fpw_for_tuple_pairs)
register_stmt_codegen('for_tuple_pairs', codegen_for_tuple_pairs)
register_stmt_codegen('return_tuple', codegen_return_tuple)
register_stmt_codegen('tuple_assign', codegen_tuple_assign)
register_first_pass_walk('return_tuple', fpw_return_tuple)
register_first_pass_walk('tuple_assign', fpw_tuple_assign)
