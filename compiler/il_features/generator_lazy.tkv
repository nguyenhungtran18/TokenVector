# -*- coding: utf-8 -*-
"""Generator LAZY THAT (Wave 3, 2026-07-29) - thay the hoan toan B2(c)'s
eager-list desugar (nguoi dung chon huong "Ho tro tong quat": yield o bat
ky dau, long nhau tuy y). Class-emission chinh (field-hoisting, switch
tren state, ...) nam trong il_codegen.py's gen_il_generator_function -
file nay CHI so huu 2 cu phap nguoi dung go THAT:

1. 'yield <expr>' - LINE_PARSER (thay macro text cu) -> stmt 'yield_stmt'.
   Codegen: luu <expr> vao field '__current', dong bo TOAN BO field-hoisted
   local->field (xem gen_il_generator_function's docstring), set '__state'
   = so thu tu (danh theo THU TU codegen gap yield, luu trong ctx['gen_ctx']),
   tra ve true, roi phat nhan resume NGAY SAU DO - code sau 'yield' tiep
   tuc binh thuong tu nhan nay khi MoveNext() duoc goi lai.

2. 'for k in gen(...):' (RHS la 1 LOI GOI TRUC TIEP, KHONG phai bien tran)
   - CHỦ Ý gioi han o dang goi truc tiep (khong ho tro 'x = gen(...); for
   k in x:') de TRANH va cham quy tac voi macro 'for_in_list' co san cua
   control_flow.py (regex do khop BAT KY 'for VAR in TEN_BIEN_TRAN:' va
   se desugar SAI thanh len()+index tren 1 gia tri generator - khong the
   phan biet o cap macro-text vi khong co known_shapes luc do). Voi cu
   phap goi TRUC TIEP, regex '(\\w+)\\(...\\)' KHONG khop dang bien-tran-
   don cua macro cu nen khong va cham - CHI 1 gioi han that (khong phai
   suy dien), khop y "for x in gen_three():" moi test da viet."""
import re

from il_core import parse_expr, parse_expr_list
from il_dispatch import register_line_parser, register_first_pass_walk, register_stmt_codegen

_YIELD_RE = re.compile(r'^yield\s+(.+)$')
_YIELD_FROM_RE = re.compile(r'^yield\s+from\s+(.+)$')
_FOR_IN_GEN_RE = re.compile(r'^for\s+(\w+)\s+in\s+(\w+)\((.*)\)\s*:\s*$')


def _lookup_ta(ctx, name):
    """Doc TypeAnn da biet cua `name` tu infer_scope cua first-pass, hoac None
    neu chua biet. `infer_scope` la _DtypeOnlyScope: KHONG co .get(), va
    `sc[name]` tra ve 3-tuple ('local', None, ta) - phai lay `[2]`."""
    sc = ctx.get('infer_scope')
    if sc is None:
        return None
    try:
        return sc[name][2]
    except Exception:
        return None


def _emit_yield_here(gen_ctx, scope, body, ctx, value_emitter):
    """Phat 1 phan tu: 'value_emitter(out)' day lenh gia tri len TREN cung
    (sau 'ldarg.0' da duoc day), roi lam phan con lai cua may trang thai.

    Tach rieng de `yield <expr>` va `yield from <nguon>` DUNG CHUNG - tranh
    copy-pam phan de nhat hieu nhat cot phat sinh state."""
    class_name = gen_ctx['class_name']
    elem_iltype = gen_ctx['current_iltype']
    il_type_str = ctx['il_type_str']

    value_emitter(body)
    body.append(f'    stfld {elem_iltype} {class_name}::__current')

    # Dong bo local(cache trong 1 lan MoveNext)->field(nguon THAT, song
    # qua nhieu lan goi MoveNext) cho TOAN BO bien first-pass da hoist.
    for name, ta in gen_ctx['field_vars']:
        idx = scope[name][1]
        il_t = il_type_str(ta, ctx.get('records'))
        body.append('    ldarg.0')
        body.append(f'    ldloc.s {idx}')
        body.append(f'    stfld {il_t} {class_name}::{name}')

    gen_ctx['next_state'][0] += 1
    n = gen_ctx['next_state'][0]
    resume_lbl = f"{ctx['prefix']}_GENRESUME{n}"
    gen_ctx['state_labels'].append(resume_lbl)

    body.append('    ldarg.0')
    # 'ldc.i4.s' chi mang 1 byte (-128..127). Generator co tren 127 yield se
    # lam ilasm bao loi - dung 'ldc.i4' (4 byte) khi can.
    body.append(f'    ldc.i4.s {n}' if -128 <= n <= 127 else f'    ldc.i4 {n}')
    body.append(f'    stfld int32 {class_name}::__state')
    body.append('    ldc.i4.1')
    body.append('    ret')
    body.append(f'  {resume_lbl}:')


def try_parse_yield(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    m = _YIELD_RE.match(line)
    if not m:
        return None
    return {'kind': 'yield_stmt', 'expr_node': parse_expr(m.group(1))}, pos + 1


def try_parse_yield_from(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    """'yield from <nguon>' - phai khai bao TRUOC 'yield <expr>': `_YIELD_RE`
    khop ca cum 'from <nguon>' va dua `from` vao parse_expr lam bien (nen bao
    'con thua token')."""
    m = _YIELD_FROM_RE.match(line)
    if not m:
        return None
    return {'kind': 'yield_from_stmt', 'expr_node': parse_expr(m.group(1))}, pos + 1


def fpw_yield_stmt(stmt, ctx):
    ctx['collect_ternary_temps'](stmt['expr_node'])


def codegen_yield_stmt(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    gen_ctx = ctx.get('gen_ctx')
    if gen_ctx is None:
        raise SyntaxError("il_codegen: 'yield' chi dung duoc ben trong 1 ham generator "
                           "(return type '\"list[dtype]\"' + co it nhat 1 'yield')")
    compile_expr = ctx['compile_expr']
    body.append('    ldarg.0')
    _emit_yield_here(gen_ctx, scope, body, ctx,
                     lambda out: compile_expr(stmt['expr_node'], scope, out, body_dtype, ctx))


def try_parse_for_in_generator(line, lines, pos, indent_level, sig, known_shapes, parse_block_fn):
    m = _FOR_IN_GEN_RE.match(line)
    if not m:
        return None
    var, callee_name, args_text = m.groups()
    if callee_name == 'range':
        return None  # 'for i in range(...):' - da co LINE_PARSER rieng (control_flow.py)
    args_text = args_text.strip()
    arg_nodes = parse_expr_list(args_text) if args_text else []
    pos += 1
    if pos >= len(lines) or lines[pos][0] <= indent_level:
        raise SyntaxError(f"il_codegen: 'for {var} in {callee_name}(...):' khong co than khoi (block rong)")
    body, pos = parse_block_fn(lines, pos, lines[pos][0], sig, known_shapes)
    return {'kind': 'for_in_generator', 'var': var, 'callee_name': callee_name,
            'arg_nodes': arg_nodes, 'body': body}, pos


def _FPW_FOR_IN_CALL_LIST(stmt, ctx):
    from il_features.list_type import fpw_for_in_call_list
    return fpw_for_in_call_list(stmt, ctx)


def _builtin_list_return_ta(stmt, ctx):
    """TypeAnn cua list do BUILTIN tra ve, hoac None neu callee khong phai
    builtin tra list.

    Dung danh SACH TA khai bao thay vi tra bang kieu cua il_dispatch: do
    phai tra qua bang o module khac, ma nhung bang do luu `(None, 'list')`
    khi builtin duoc dang ky bang `return_shape` + `return_dtype=None` -
    phu thuoc vao no de khong on dinh. Danh sach nay nho va rat them bien
    moi; khi them builtin tra list moi, hay bo sung vao day.
    """
    name = stmt.get('callee_name')
    if name not in _LIST_RETURNING_BUILTINS:
        return None
    args = stmt.get('arg_nodes') or []
    if not args or args[0][0] != 'var':
        return None
    try:
        elem = ctx['infer_scope'][args[0][1]][2].dtype
    except (KeyError, TypeError, IndexError):
        return None
    return ctx['TypeAnn'](elem, 'list')


# Builtin tra ve list, dung duoc truc tiep trong `for x in f(...):`.
_LIST_RETURNING_BUILTINS = ('sorted', 'reversed')


def fpw_for_in_generator(stmt, ctx):
    func_table = ctx['func_table']
    callee_name = stmt['callee_name']
    callee_sig = func_table.get(callee_name)
    if (callee_sig is not None and not getattr(callee_sig, 'is_generator', False)
            and callee_sig.return_type is not None
            and callee_sig.return_type.shape in ('list', 'set')):
        # 'for x in f(...):' voi f tra ve 1 LIST thuong (2026-08-03, dot 2)
        # - truoc day bao loi, bat nguoi viet gan ra 1 bien truoc. Doi
        # CHINH cau lenh nay sang dang 'for_in_call_list' (xem
        # il_features/list_type.py) roi de duong do lo lieu.
        stmt['kind'] = 'for_in_call_list'
        return _FPW_FOR_IN_CALL_LIST(stmt, ctx)
    # (2026-09-30) BUILTIN tra ve list - `sorted(xs)` / `reversed(xs)`.
    # Chúng KHONG co trong `func_table` (do la ham nghuyen danh, khong phai
    # ham nguoi viet) nen nhanh tren khong khop va bien dich bao loi
    # "'reversed' khong phai 1 HAM GENERATOR" - dung nhung ca hai HAM CO
    # that, chi la duong duyet list chua duoc mo cho builtin.
    # Sua o day: nhan dien qua bang kieu cua builtin, tach kieu phan tu, roi
    # dua vao DUNG duong `for_in_call_list`. Cac doan doc `func_table[...]`
    # trong fpw/codegen cua list_type se doc `stmt['ret_ta']` truoc.
    if callee_sig is None:
        _ret_ta = _builtin_list_return_ta(stmt, ctx)
        if _ret_ta is not None:
            stmt['kind'] = 'for_in_call_list'
            stmt['ret_ta'] = _ret_ta
            return _FPW_FOR_IN_CALL_LIST(stmt, ctx)
    if callee_name not in func_table or not getattr(func_table[callee_name], 'is_generator', False):
        raise SyntaxError(
            f"il_codegen: 'for {stmt['var']} in {callee_name}(...):' - '{callee_name}' khong phai "
            f"1 ham generator (khong co 'yield' trong than) - 'for x in f(...):' hien CHI ho tro "
            f"goi TRUC TIEP 1 ham generator, khong ho tro list/dict thuong o day (gan ra 1 bien "
            f"roi 'for x in bien:' voi list/dict thuong)")
    callee = func_table[callee_name]
    # Important fix (2026-08-18, duck-typing-inference): 'for x in gen(...):'
    # DI THANG toi codegen_for_in_generator (KHONG qua _expr_call), nen
    # KHONG co resolve_call_site nao chay cho tham so 'inferred' - neu goi
    # 1 ham-generator co con tham so 'inferred', il_type_str(p.type_ann) ben
    # duoi (codegen_for_in_generator) se KeyError 'inferred' - crash Python
    # THO thay vi loi bien dich ro rang. Chan SOM o day (first-pass walk,
    # truoc khi codegen chay) - GIOI HAN DA BIET, chua ho tro resolve day du
    # qua duong nay (khac Critical 1/_expr_call).
    if any(p.type_ann is not None and p.type_ann.dtype == 'inferred' for p in callee.params):
        # Muc K item 1 (docs/BUGS_TODO.md, task4-critical-fix-report.md):
        # dinh so dong nguon vao message NEU co du thong tin (thong ke
        # 'src_line' chi duoc _parse_block gan cho statement o TOP-LEVEL
        # than ham - xem docstring _parse_block, il_codegen.py - statement
        # long trong if/for khac CHUA co, giu nguyen message cu trong
        # truong hop do, khong bat buoc).
        loc_suffix = ''
        src_line = stmt.get('src_line')
        source_path = ctx.get('source_path')
        if src_line is not None and source_path:
            loc_suffix = f" (o dong {src_line} cua file {source_path})"
        raise SyntaxError(
            f"il_codegen: goi ham-generator '{callee_name}' co tham so kieu suy tu dong "
            f"'inferred' qua 'for {stmt['var']} in {callee_name}(...):' chua duoc ho tro "
            f"(gioi han da biet - dung tham so kieu cu the cho ham generator goi qua "
            f"'for...in'){loc_suffix}")
    TypeAnn = ctx['TypeAnn']
    ctx['declare_named'](stmt['var'], TypeAnn(callee.generator_elem_dtype, None))
    ctx['declare_named'](f'__geniter{id(stmt)}', TypeAnn(callee.generator_class_name, 'generator'))
    for arg_node in stmt['arg_nodes']:
        ctx['collect_ternary_temps'](arg_node)
    ctx['walk_fn'](stmt['body'])


def emit_generator_drain_as_container(arg_node, gen_class_name, param_ta, scope, out, ctx):
    """GOI HAM GENERATOR (hoac doc 1 bien dang giu may trang thai) o DIEM GOI
    THUONG khi tham so nhan kieu `list[...]` - rut het may trang thai ve 1 list
    MOI roi tra ve no tren stack. Tra True neu da lam viec.

    Ly do: kieu khai bao cua generator la `list[...]` nen phep kiem kieu o
    diem goi cho qua, nhung gia tri that tren stack la may trang thai
    (`IEnumerator<T>`) - `ilasm` khong kiem tra kieu nen exe bien dich duoc
    roi CHI hỏng luc chay (do doc nham dia chi `List<T>` o sai cho: xem
    `docs/SO_SANH_TOKENVECTOR_VS_PYTHON.md` muc 3.2).

    `arg_node` co the la `('call', ten, args)` (goi truc tiep) hoac `('var',
    ten)` (bien dang giu ket qua goi do) - ca hai cung khoi may trang thai.
    Cung co bang mau voi `codegen_for_in_generator` (MoveNext + get_Current),
    khac o cho do them 1 buoc: ghi tung phan tu vao container moi.
    """
    from il_features.list_type import value_dtype_spec_for_ta
    from typed_dsl_parser import TypeAnn as _TypeAnn
    compile_expr = ctx['compile_expr']
    il_type_str = ctx['il_type_str']
    TypeAnn = _TypeAnn
    gen_class = il_type_str(TypeAnn(gen_class_name, 'generator'),
                            ctx.get('records'))
    list_il = il_type_str(param_ta, ctx.get('records'))
    func_table = (ctx or {}).get('func_table') or {}
    callee = func_table.get(arg_node[1])
    elem_iltype = 'int32'
    if callee is not None:
        elem_iltype = ctx['il_scalar'].get(callee.generator_elem_dtype,
                                          callee.generator_elem_dtype)
    tag = f'__genaslst{id(arg_node)}'
    _, it_idx, _ = scope[f'{tag}_it']
    _, acc_idx, _ = scope[f'{tag}_acc']
    ctx['label_counter'][0] += 1
    n = ctx['label_counter'][0]
    start_lbl = f'{tag}_L{n}_start'
    end_lbl = f'{tag}_L{n}_end'
    if arg_node[0] == 'call':
        for a, p in zip(arg_node[2], callee.params):
            compile_expr(a, scope, out, value_dtype_spec_for_ta(p.type_ann, a), ctx)
        callee_params_il = ', '.join(il_type_str(p.type_ann) for p in callee.params)
        class_name = ctx.get('class_name') or 'Program'
        out.append(f'    call {gen_class} {class_name}::{arg_node[1]}({callee_params_il})')
    else:
        # bien dang giu may trang thai: gia tri da san tren stack theo kieu
        # cua chinh no (xem _expr_var - khong ep gi).
        compile_expr(arg_node, scope, out, _TypeAnn(gen_class_name, 'generator'), ctx)
    out.append(f'    stloc.s {it_idx}')
    out.append(f'    newobj instance void {list_il}::.ctor()')
    # container moi phai duoc giu de gan tung phan tu, roi day lai len stack
    # o cuoi - de iem `dup` truoc moi lan stloc khong hop len. Local `acc` da
    # duoc khai o FIRST PASS (xem il_codegen's _declare_coerce_temps_for_call).
    _, acc_idx, _ = scope[f'{tag}_acc']
    out.append(f'    stloc.s {acc_idx}')
    out.append(f'  {start_lbl}:')
    out.append(f'    ldloc.s {it_idx}')
    out.append(f'    callvirt instance bool {gen_class}::MoveNext()')
    out.append(f'    brfalse {end_lbl}')
    out.append(f'    ldloc.s {acc_idx}')
    out.append(f'    ldloc.s {it_idx}')
    out.append(f"    callvirt instance {elem_iltype} {gen_class}::"
               f"'System.Collections.Generic.IEnumerator<{elem_iltype}>.get_Current'()")
    out.append(f'    callvirt instance void {list_il}::Add(!0)')
    out.append('    br ' + start_lbl)
    out.append(f'  {end_lbl}:')
    out.append(f'    ldloc.s {acc_idx}')
    return True


def codegen_for_in_generator(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    func_table = ctx['func_table']
    callee = func_table[stmt['callee_name']]
    compile_expr = ctx['compile_expr']
    store_var = ctx['store_var']
    il_type_str = ctx['il_type_str']

    _, iter_idx, iter_ta = scope[f'__geniter{id(stmt)}']
    gen_class = il_type_str(iter_ta, ctx.get('records'))
    elem_iltype = ctx['il_scalar'].get(callee.generator_elem_dtype, callee.generator_elem_dtype)

    # Lazy import (cung ky thuat da dung o fpw_for_in_call_list, dong ~99)
    # de tranh circular import list_type <-> generator_lazy.
    from il_features.list_type import value_dtype_spec_for_ta
    for arg_node, p in zip(stmt['arg_nodes'], callee.params):
        # Round 3 (2026-08-19): shape-string convention cho list-literal
        # long nhau lam doi so generator ('for x in gen([[1,2],[3,4]]):').
        compile_expr(arg_node, scope, body,
                     value_dtype_spec_for_ta(p.type_ann, arg_node), ctx)
    callee_params_il = ', '.join(il_type_str(p.type_ann) for p in callee.params)
    class_name = ctx.get('class_name') or 'Program'
    body.append(f'    call {gen_class} {class_name}::{stmt["callee_name"]}({callee_params_il})')
    body.append(f'    stloc.s {iter_idx}')

    ctx['label_counter'][0] += 1
    n = ctx['label_counter'][0]
    start_lbl = f"{ctx['prefix']}_forgen{n}_start"
    end_lbl = f"{ctx['prefix']}_forgen{n}_end"

    body.append(f'  {start_lbl}:')
    body.append(f'    ldloc.s {iter_idx}')
    body.append(f'    callvirt instance bool {gen_class}::MoveNext()')
    body.append(f'    brfalse {end_lbl}')
    body.append(f'    ldloc.s {iter_idx}')
    body.append(f"    callvirt instance {elem_iltype} {gen_class}::"
                f"'System.Collections.Generic.IEnumerator<{elem_iltype}>.get_Current'()")
    store_var(stmt['var'], scope, body)
    ctx['loop_stack'].append((start_lbl, end_lbl))
    codegen_stmts_fn(stmt['body'], scope, body, body_dtype, ctx, sig)
    ctx['loop_stack'].pop()
    body.append(f'    br {start_lbl}')
    body.append(f'  {end_lbl}:')


def fpw_yield_from_stmt(stmt, ctx):
    """Phan loai nguon cua `yield from` o FIRST-PASS (noi co infer_scope de
    biet kieu cua bien) va khai bao cac local an can dung.

    Chi ho tro 2 dang - xem docs/PLAN.md muc 5:
      - bien list          -> vong lap theo chi so
      - goi 1 ham generator -> ban giao MoveNext/get_Current
    Dang khac bi tu choi VOI LY DO, khong de sinh CIL hong."""
    TypeAnn = ctx['TypeAnn']
    node = stmt['expr_node']
    sid = id(stmt)
    kind = node[0] if isinstance(node, tuple) else None
    what = f"yield from {ctx.get('il_ident', lambda s: s)(_expr_src(node))}".replace('\n', ' ')

    if kind == 'var':
        ta = _lookup_ta(ctx, node[1])
        if ta is not None and ta.shape == 'list':
            elem = ctx.get('gen_elem_dtype')
            if elem is not None and ta.dtype != elem and ta.dtype != 'int':
                raise SyntaxError(
                    f"il_codegen: {what} - list '{node[1]}' co phan tu kieu '{ta.dtype}' "
                    f"nhung generator nay yield phan tu kieu '{elem}'. Chi chuyen doi duoc "
                    f"tu '{ta.dtype}' (so nguyen lon) sang kieu so nguyen nho hon")
            stmt['yf_mode'] = 'list'
            stmt['yf_src_elem'] = ta.dtype
            ctx['declare_named'](f'__yfsrc{sid}', ta)
            ctx['declare_named'](f'__yfidx{sid}', TypeAnn('i32', None))
            return
        raise SyntaxError(
            f"il_codegen: '{node[1]}' khong phai bien LIST - chi ho tro "
            f"'yield from <bien kieu list>' va 'yield from <ham generator>(...)'. "
            f"Chi chuyen doi duoc tu '{ta.dtype}' (so nguyen lon) sang kieu so nguyen nho hon"
            if ta is not None else
            f"il_codegen: '{node[1]}' khong phai bien LIST - chi ho tro "
            f"'yield from <bien kieu list>' va 'yield from <ham generator>(...)'")

    if kind == 'call':
        callee = ctx['func_table'].get(node[1])
        if callee is not None and getattr(callee, 'is_generator', False):
            stmt['yf_mode'] = 'gen'
            ctx['declare_named'](f'__yfiter{sid}',
                                 TypeAnn(callee.generator_class_name, 'generator'))
            for arg_node in node[2]:
                ctx['collect_ternary_temps'](arg_node)
            return
        raise SyntaxError(
            f"il_codegen: {what} - '{node[1]}' khong phai 1 HAM GENERATOR "
            f"(khong co 'yield' trong than). 'yield from' chi ho tro "
            f"bien list va goi truc tiep 1 ham generator")

    raise SyntaxError(
        f"il_codegen: {what} - chi ho tro 'yield from <bien kieu list>' va "
        f"'yield from <ham generator>(...)', khong ho tro bieu thuc khac")


def _tkvint_to(dtype):
    """Ten phuong thuc TkvInt ep ve kieu so nguyen nho (xem operators.tkv)."""
    return {'i32': 'ToI32', 'i64': 'ToI64'}.get(dtype, 'ToI32')


def _expr_src(node):
    """Tra ve dang TEXT cua node (chi dung cho thong bao loi)."""
    if isinstance(node, tuple):
        if node[0] == 'var':
            return node[1]
        if node[0] == 'call':
            return f"{node[1]}(...)"
        if node[0] == 'num':
            return str(node[1])
        if node[0] == 'str_lit':
            return '<chuoi>'
    return '<bieu thuc>'


def codegen_yield_from_stmt(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    gen_ctx = ctx.get('gen_ctx')
    if gen_ctx is None:
        raise SyntaxError("il_codegen: 'yield from' chi dung duoc ben trong 1 ham generator "
                           "(return type '\"list[dtype]\"' + co it nhat 1 'yield')")
    compile_expr = ctx['compile_expr']
    store_var = ctx['store_var']
    il_type_str = ctx['il_type_str']
    records = ctx.get('records')
    sid = id(stmt)

    ctx['label_counter'][0] += 1
    n = ctx['label_counter'][0]
    start_lbl = f"{ctx['prefix']}_YF{n}_start"
    end_lbl = f"{ctx['prefix']}_YF{n}_end"

    if stmt['yf_mode'] == 'list':
        src_name = f'__yfsrc{sid}'
        idx_name = f'__yfidx{sid}'
        _, src_idx, src_ta = scope[src_name]
        _, idx_idx, _ = scope[idx_name]
        list_type = il_type_str(src_ta, records)

        # Khoi tao CHAY MOT LAN: o state 0, truoc nhan start. Sau moi lan
        # resume, luoi quay ve `start_lbl` - khong qua khoi tao lai.
        compile_expr(stmt['expr_node'], scope, body, src_ta.dtype, ctx)
        store_var(src_name, scope, body)
        body.append('    ldc.i4.0')
        body.append(f'    stloc.s {idx_idx}')

        body.append(f'  {start_lbl}:')
        body.append(f'    ldloc.s {idx_idx}')
        body.append(f'    ldloc.s {src_idx}')
        body.append(f'    callvirt instance int32 {list_type}::get_Count()')
        body.append(f'    bge {end_lbl}')

        def _emit_item(out):
            out.append('    ldarg.0')
            out.append(f'    ldloc.s {src_idx}')
            out.append(f'    ldloc.s {idx_idx}')
            out.append(f'    callvirt instance !0 {list_type}::get_Item(int32)')
            # List literal 'xs = [10, 20, 30]' co phan tu kieu 'int' (TkvInt,
            # so nguyen lon) trong khi generator khai bao 'list[i32]'. IL thi
            # kiem tra kich thuoc stack - stfld int32 nhung get_Item day 16 byte
            # se lam LECH STACK va pha MoveNext (da gap that). Phai ep ve.
            src_elem = stmt.get('yf_src_elem')
            if src_elem == 'int' and src_elem != gen_ctx['elem_dtype']:
                out.append(f'    call {gen_ctx["current_iltype"]} '
                           f'TkvInt::{_tkvint_to(gen_ctx["elem_dtype"])}(valuetype TkvInt)')

        _emit_yield_here(gen_ctx, scope, body, ctx, _emit_item)

        body.append(f'    ldloc.s {idx_idx}')
        body.append('    ldc.i4.1')
        body.append('    add')
        body.append(f'    stloc.s {idx_idx}')
        body.append(f'    br {start_lbl}')
        body.append(f'  {end_lbl}:')
        return

    # ---- dang goi 1 ham generator ----
    iter_name = f'__yfiter{sid}'
    _, iter_idx, iter_ta = scope[iter_name]
    sub_class = il_type_str(iter_ta, records)
    node = stmt['expr_node']
    callee = ctx['func_table'][node[1]]
    elem_iltype = ctx['il_scalar'].get(callee.generator_elem_dtype, callee.generator_elem_dtype)

    from il_features.list_type import value_dtype_spec_for_ta
    for arg_node, p in zip(node[2], callee.params):
        compile_expr(arg_node, scope, body, value_dtype_spec_for_ta(p.type_ann, arg_node), ctx)
    callee_params_il = ', '.join(il_type_str(p.type_ann, records) for p in callee.params)
    program_class = ctx.get('class_name') or 'Program'
    body.append(f'    call {sub_class} {program_class}::{ctx["il_ident"](node[1])}({callee_params_il})')
    body.append(f'    stloc.s {iter_idx}')

    body.append(f'  {start_lbl}:')
    body.append(f'    ldloc.s {iter_idx}')
    body.append(f'    callvirt instance bool {sub_class}::MoveNext()')
    body.append(f'    brfalse {end_lbl}')

    def _emit_item(out):
        out.append('    ldarg.0')
        out.append(f'    ldloc.s {iter_idx}')
        out.append(f"    callvirt instance {elem_iltype} {sub_class}::"
                   f"'System.Collections.Generic.IEnumerator<{elem_iltype}>.get_Current'()")

    _emit_yield_here(gen_ctx, scope, body, ctx, _emit_item)

    body.append(f'    br {start_lbl}')
    body.append(f'  {end_lbl}:')


register_line_parser('yield_from_stmt', try_parse_yield_from)
register_first_pass_walk('yield_from_stmt', fpw_yield_from_stmt)
register_stmt_codegen('yield_from_stmt', codegen_yield_from_stmt)
register_line_parser('yield_stmt', try_parse_yield)
register_first_pass_walk('yield_stmt', fpw_yield_stmt)
register_stmt_codegen('yield_stmt', codegen_yield_stmt)
register_line_parser('for_in_generator', try_parse_for_in_generator)
register_first_pass_walk('for_in_generator', fpw_for_in_generator)
register_stmt_codegen('for_in_generator', codegen_for_in_generator)
