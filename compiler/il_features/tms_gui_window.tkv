    L.append('    newobj instance void [System.Drawing]System.Drawing.Point::.ctor(int32, int32)')
    L.append('    callvirt instance void [System.Windows.Forms]System.Windows.Forms.Control::set_Location(valuetype [System.Drawing]System.Drawing.Point)')
    L.append('    ldloc.s %d' % loc)
    L.append('    ldc.i4.1')
    L.append('    callvirt instance void [System.Windows.Forms]System.Windows.Forms.Control::set_AutoSize(bool)')
    L.append('    %s' % host)
    L.append('    callvirt instance class [System.Windows.Forms]System.Windows.Forms.Control/ControlCollection [System.Windows.Forms]System.Windows.Forms.Control::get_Controls()')
    L.append('    ldloc.s %d' % loc)
    L.append('    callvirt instance void [System.Windows.Forms]System.Windows.Forms.Control/ControlCollection::Add(class [System.Windows.Forms]System.Windows.Forms.Control)')


