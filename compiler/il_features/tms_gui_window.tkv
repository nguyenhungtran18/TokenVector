def ensure_db_class(ctx):
    emitted = ctx.get('emitted_types')
    if emitted is not None and 'DbForm' in emitted:
        return
    if emitted is not None:
        emitted.add('DbForm')
    cls = [
        '.class public auto ansi beforefieldinit DbForm extends [System.Windows.Forms]System.Windows.Forms.Form',
        '{',
    ]
    cls += _db_lines()
    ctx['extra_classes'].append(cls)


def ensure_opt_class(ctx):
    emitted = ctx.get('emitted_types')
    if emitted is not None and 'OptForm' in emitted:
        return
    if emitted is not None:
        emitted.add('OptForm')
    cls = [
        '.subsystem 0x0002',
        '.class public auto ansi beforefieldinit OptForm extends [System.Windows.Forms]System.Windows.Forms.Form',
        '{',
    ]
    cls += _opt_lines()
    ctx['extra_classes'].append(cls)


def ensure_tms_class(ctx):
    ensure_opt_class(ctx)
    ensure_db_class(ctx)
    emitted = ctx.get('emitted_types')
    if emitted is not None and _HELPER_CLASS in emitted:
        return
    if emitted is not None:
        emitted.add(_HELPER_CLASS)
    cls = [
        '.class public auto ansi beforefieldinit %s extends [System.Windows.Forms]System.Windows.Forms.Form' % _HELPER_CLASS,
        '{',
    ]
    cls += _SQLITE_PINVOKE
    cls += _field_lines()
    cls += _ctor_lines()
    cls += _ctor_toolbar_grid_lines()
    cls += _ctor_entry_lines()
    cls += _helpers_lines()
    cls += _log_lines()
    cls += _learnopt_lines()
    cls += _dbopen_lines()
    cls += _refresh_lines()
    cls += _handlers_lines()
    cls += _filter_handlers_lines()
    cls += _top_lines()
    cls += _paint_lines()
    cls += _export_lines()
    cls += _startgui_lines()
    ctx['extra_classes'].append(cls)


def _push_launch_tms_gui(args, scope, out, dtype, ctx):
    ensure_tms_class(ctx)
    if len(args) != 1:
        raise SyntaxError("il_codegen: launch_tms_gui(db_path) nhan dung 1 tham so")
    ctx['compile_expr'](args[0], scope, out, 'str', ctx)
    out.append('    stsfld string TmsForm::dbPath')
    out.append('    call void TmsForm::StartGui()')
    out.append('    ldc.i4.0')


register_expr_builtin('launch_tms_gui', _push_launch_tms_gui, 'i32')

