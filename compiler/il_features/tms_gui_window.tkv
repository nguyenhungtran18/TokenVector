    L.append('    ldstr "%s"' % text)
    L.append('    callvirt instance void [System.Windows.Forms]System.Windows.Forms.Control::set_Text(string)')
    L.append('    ldloc.s %d' % loc)
    L.append('    ldc.i4 %d' % x)
