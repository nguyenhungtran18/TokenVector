def _ctor_entry_lines():
    L = []
    H = '    ldloc.s 5'
    _emit_label(L, 'NHAP NHANH CHUYEN MOI', 12, 4, H, 4)
    L.append('    ldloc.s 4')
    L.append('    ldstr "Segoe UI"')
    L.append('    ldc.r4 10.0')
    L.append('    ldc.i4.1')
    L.append('    newobj instance void [System.Drawing]System.Drawing.Font::.ctor(string, float32, valuetype [System.Drawing]System.Drawing.FontStyle)')
    L.append('    callvirt instance void [System.Windows.Forms]System.Windows.Forms.Control::set_Font(class [System.Drawing]System.Drawing.Font)')
    L.append('    ldloc.s 4')
    L.append('    ldc.i4 22')
    L.append('    ldc.i4 119')
    L.append('    ldc.i4 255')
    L.append('    call valuetype [System.Drawing]System.Drawing.Color [System.Drawing]System.Drawing.Color::FromArgb(int32, int32, int32)')
    L.append('    callvirt instance void [System.Windows.Forms]System.Windows.Forms.Control::set_ForeColor(valuetype [System.Drawing]System.Drawing.Color)')
    _emit_label(L, 'Click o - Go phim Enter de luu.', 280, 6, H, 4)
    _emit_checkbox(L, 'chkKeep', 'Giu lai Ngay & So Xe', 980, 4, 280, H, 1)
    _emit_checkbox(L, 'chkLearn', 'Tu hoc danh muc moi', 980, 26, 280, H, 1)
    row1 = [('NGAY', 'txtNgay', 12, 100), ('SO XE', 'txtSoXe', 122, 100),
            ('NOI LAY', 'txtNoiLay', 232, 150), ('NOI GIAO', 'txtNoiGiao', 392, 150),
            ('NOI HA', 'txtNoiHa', 552, 150), ('LOAI HANG', 'txtLoaiHang', 712, 140)]
    for lab, fld, x, w in row1:
        _emit_label(L, lab, x, 26, H, 4)
        _emit_textbox_field(L, fld, x, 44, w, H)
    row2 = [('SO CONT', 'txtSoCont', 12, 100), ('LOAI CONT', 'txtLoaiCont', 122, 100),
            ('SO LUONG', 'txtSoLuong', 232, 100), ('CHU HANG', 'txtChuHang', 342, 200),
            ('GHI CHU', 'txtGhiChu', 552, 300)]
    for lab, fld, x, w in row2:
        _emit_label(L, lab, x, 74, H, 4)
        _emit_textbox_field(L, fld, x, 92, w, H)
    _emit_button(L, 'btnAdd', 'ADD', 700, 126, 110, 32, 'OnAddClick', H, 1)
    _emit_button(L, 'btnUpdate', 'UPDATE', 820, 126, 110, 32, 'OnUpdateClick', H)
    _emit_button(L, 'btnDelete', 'DELETE', 940, 126, 110, 32, 'OnDeleteClick', H)
    _emit_button(L, 'btnDuplicate', 'DUPLICATE', 1060, 126, 110, 32, 'OnDuplicateClick', H)
    for _ef in ['txtNgay', 'txtSoXe', 'txtNoiLay', 'txtNoiGiao', 'txtNoiHa', 'txtLoaiHang', 'txtSoCont', 'txtLoaiCont', 'txtSoLuong', 'txtChuHang', 'txtGhiChu']:
        L.append('    ldarg.0')
        L.append('    ldfld class [System.Windows.Forms]System.Windows.Forms.TextBox TmsForm::%s' % _ef)
        L.append('    ldarg.0')
        L.append('    ldftn instance void TmsForm::OnEntryKey(object, class [System.Windows.Forms]System.Windows.Forms.KeyEventArgs)')
        L.append('    newobj instance void [System.Windows.Forms]System.Windows.Forms.KeyEventHandler::.ctor(object, native int)')
        L.append('    callvirt instance void [System.Windows.Forms]System.Windows.Forms.Control::add_KeyDown(class [System.Windows.Forms]System.Windows.Forms.KeyEventHandler)')
    L.append('    ldarg.0')
    L.append('    call instance void TmsForm::RefreshGrid()')
    L.append('    ret')
    L.append('  }')
    L.append('')
    return L


def _col_text_lines(L, col, tag):
    L.append('    ldloc.1')
    L.append('    ldc.i4 %d' % col)
    L.append('    call int64 TmsForm::__tms_sqlite3_column_text(int64, int32)')
    L.append('    conv.i')
    L.append('    dup')
    L.append('    brfalse %s%d_NULL' % (tag, col))
    L.append('    stloc.s 11')
    L.append('    ldloc.1')
    L.append('    ldc.i4 %d' % col)
    L.append('    call int32 TmsForm::__tms_sqlite3_column_bytes(int64, int32)')
    L.append('    stloc.s 12')
    L.append('    ldloc.s 12')
    L.append('    newarr [mscorlib]System.Byte')
    L.append('    stloc.s 13')
    L.append('    ldloc.s 11')
    L.append('    ldloc.s 13')
    L.append('    ldc.i4.0')
    L.append('    ldloc.s 12')
    L.append('    call void [mscorlib]System.Runtime.InteropServices.Marshal::Copy(native int, uint8[], int32, int32)')
    L.append('    call class [mscorlib]System.Text.Encoding [mscorlib]System.Text.Encoding::get_UTF8()')
    L.append('    ldloc.s 13')
    L.append('    callvirt instance string [mscorlib]System.Text.Encoding::GetString(uint8[])')
    L.append('    br %s%d_END' % (tag, col))
    L.append('  %s%d_NULL:' % (tag, col))
    L.append('    pop')
    L.append('    ldstr ""')
    L.append('  %s%d_END:' % (tag, col))


