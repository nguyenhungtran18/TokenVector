# -*- coding: utf-8 -*-
"""TMS WinForms GUI plugin for TokenVector (TmsForm).
Same architecture as win32_gui_window.tkv: registers expr builtin
launch_tms_gui(db_path) and injects a WinForms Form class (CIL) into
ctx['extra_classes']. Full CRUD grid over SQLite via P/Invoke.
Rules applied: ASCII-only ldstr, 4-byte branches, Concat<=4 args,
STA thread, subsystem GUI, correct assembly qualification.
"""

import re
from il_dispatch import register_expr_builtin

_HELPER_CLASS = 'TmsForm'

_SQLITE_PINVOKE = [
    '  .method public hidebysig static pinvokeimpl("sqlite3.dll" as "sqlite3_open" cdecl)',
    '      int32 __tms_sqlite3_open(string filename, int64& db) cil managed preservesig {}',
    '  .method public hidebysig static pinvokeimpl("sqlite3.dll" as "sqlite3_prepare_v2" cdecl)',
    '      int32 __tms_sqlite3_prepare_v2(int64 db, string sql, int32 nbyte, int64& stmt, int64 tail) cil managed preservesig {}',
    '  .method public hidebysig static pinvokeimpl("sqlite3.dll" as "sqlite3_step" cdecl)',
    '      int32 __tms_sqlite3_step(int64 stmt) cil managed preservesig {}',
    '  .method public hidebysig static pinvokeimpl("sqlite3.dll" as "sqlite3_finalize" cdecl)',
    '      int32 __tms_sqlite3_finalize(int64 stmt) cil managed preservesig {}',
    '  .method public hidebysig static pinvokeimpl("sqlite3.dll" as "sqlite3_column_text" cdecl)',
    '      int64 __tms_sqlite3_column_text(int64 stmt, int32 col) cil managed preservesig {}',
    '  .method public hidebysig static pinvokeimpl("sqlite3.dll" as "sqlite3_column_int64" cdecl)',
    '      int64 __tms_sqlite3_column_int64(int64 stmt, int32 col) cil managed preservesig {}',
    '  .method public hidebysig static pinvokeimpl("sqlite3.dll" as "sqlite3_column_double" cdecl)',
    '      float64 __tms_sqlite3_column_double(int64 stmt, int32 col) cil managed preservesig {}',
    '  .method public hidebysig static pinvokeimpl("sqlite3.dll" as "sqlite3_column_bytes" cdecl)',
    '      int32 __tms_sqlite3_column_bytes(int64 stmt, int32 col) cil managed preservesig {}',
    '  .method public hidebysig static pinvokeimpl("sqlite3.dll" as "sqlite3_close" cdecl)',
    '      int32 __tms_sqlite3_close(int64 db) cil managed preservesig {}',
    '  .method public hidebysig static pinvokeimpl("sqlite3.dll" as "sqlite3_errmsg" cdecl)',
    '      int64 __tms_sqlite3_errmsg(int64 db) cil managed preservesig {}',
    '',
]


