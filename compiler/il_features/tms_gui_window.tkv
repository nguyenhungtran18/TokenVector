def _read_boxes_lines(L):
    for i, f in enumerate(['txtNgay', 'txtSoXe', 'txtNoiLay', 'txtNoiGiao', 'txtNoiHa',
                           'txtLoaiHang', 'txtSoCont', 'txtLoaiCont', 'txtSoLuong',
                           'txtChuHang', 'txtGhiChu']):
        L.append('    ldarg.0')
        L.append('    ldfld class [System.Windows.Forms]System.Windows.Forms.TextBox TmsForm::%s' % f)
        L.append('    callvirt instance string [System.Windows.Forms]System.Windows.Forms.Control::get_Text()')
        L.append('    stloc.s %d' % (12 + i))
        L.append('    ldarg.0')
        L.append('    ldloc.s %d' % (12 + i))
        L.append('    call instance string TmsForm::Escape(string)')
        L.append('    stloc.s %d' % (12 + i))


def _require_lines(L, idx, fieldname):
    L.append('    ldloc.s %d' % idx)
    L.append('    callvirt instance int32 [mscorlib]System.String::get_Length()')
    L.append('    brtrue REQ%d_OK' % idx)
    L.append('    ldstr "Please fill NGAY, SO XE, CHU HANG, LOAI CONT."')
    L.append('    ldstr "Missing data"')
    L.append('    ldc.i4.0')
    L.append('    ldc.i4 48')
    L.append('    call valuetype [System.Windows.Forms]System.Windows.Forms.DialogResult [System.Windows.Forms]System.Windows.Forms.MessageBox::Show(string, string, valuetype [System.Windows.Forms]System.Windows.Forms.MessageBoxButtons, valuetype [System.Windows.Forms]System.Windows.Forms.MessageBoxIcon)')
    L.append('    pop')
    L.append('    ret')
    L.append('  REQ%d_OK:' % idx)


