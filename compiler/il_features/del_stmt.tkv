# -*- coding: utf-8 -*-
"""`del` - xoá PHAN TU container va khoa dict (2026-09-29, Giai doan 2 cua PLAN).

PHAM VI - va ly do KHONG lam ca hai ve cua lenh `del` trong Python:

| viet | xu ly | vi sao |
|---|---|---|
| `del lst[i]` | **CO** | `List<T>.RemoveAt(i32)` - dung nghia Python |
| `del d[k]` | **CO** | `Dictionary<K,V>.Remove(K)` - dung nghia Python |
| `del x` (bien) | **TU CHOI** | xem ben duoi |

**Vi sao `del x` bi tu choi chu khong lam.** Local cua TokenVector la local IL
co kieu khai BAO. Python `del x` tao ra trai thai "khong con binding": dung `x`
sau do la `NameError`. Mu `TokenVector` tao duoc dung trai thai do, moi noi
dung `x` deu phai kiem tra "co con binding khong" - tuc them vao **moi** diem
doc bien, va chi mot quyet dinh sai se bien loi `NameError` thanh gia tri rac
(Khong phai loi on ao ma la loi SAI). Do la thay doi kien truc lon, khong phai
viec them mot nhanh lenh.

Neu chi muon giu diai chua bien: gan gia tri mac dinh cua kieu
(`x = 0` / `x = 0.0` / `x = ""` / `x = None`). Local kieu container nen gan
`None` - BCL se nhan object reference null, container cu the bi giai phong boi
GC, dung tac dung giong `del x` ve bo nho.

Mot khac biet can biet: `del lst[i]` **doi chieu (re-index)** cac phan tu sau
do, dung nhu Python. Do `List<T>.RemoveAt` lam viec do, nen day la hanh vi
dung, khong phai dien giai rieng.
"""

import re

from il_core import parse_expr
from il_dispatch import (
    register_line_parser, register_stmt_codegen, register_first_pass_walk,
)

# `del <ten>` hoac `del <ten>[<chi so>]`. KHONG cho phep nhieu muc
# (`del a, b`) - Python cho, nhung day la cum chay lien tiep, de them sau.
_DEL_RE = re.compile(r'^del\s+(\w+)((?:\[[^\[\]]*\])*)\s*$')
_DEL_IDX_RE = re.compile(r'\[([^\[\]]*)\]')


def try_parse_del(line, lines, pos, indent_level, sig, known_shapes,
                  parse_block_fn):
    """LINE_PARSERS: `del lst[0]` / `del d["a"]` / `del x`."""
    m = _DEL_RE.match(line)
    if not m:
        return None
    name, brackets = m.group(1), m.group(2)
    idx_texts = _DEL_IDX_RE.findall(brackets)
    if len(idx_texts) > 1:
        raise SyntaxError(
            f'il_codegen: del chi ho tro 1 chi so theo sau, khong ho tro '
            f'nhieu chi so (`del {name}{brackets}`) - xoá tu 1 cho toi')
    target = {
        'name': name,
        'index_node': parse_expr(idx_texts[0]) if idx_texts else None,
    }
    return {'kind': 'del_stmt', **target}, pos + 1


def fpw_del_stmt(stmt, ctx):
    """FIRST_PASS_WALK: chi can quet bieu thuc chi so de khai temp."""
    if stmt['index_node'] is not None:
        ctx['collect_ternary_temps'](stmt['index_node'])


def _container_il(scope, name, ctx):
    entry = scope[name]
    return entry[2]


def codegen_del_stmt(stmt, scope, body, body_dtype, ctx, sig, codegen_stmts_fn):
    name = stmt['name']
    idx_node = stmt['index_node']
    if idx_node is None:
        ta = _container_il(scope, name, ctx)
        raise SyntaxError(
            f'il_codegen: `del {name}` (xoa BIEN) chua ho tro. Local cua '
            f'TokenVector co kieu khai bao san nen khong the "go bo binding" '
            f'như Python. Neu chi muon gia tri mac dinh: gan '
            f'`{name} = 0` / `= 0.0` / `= ""` / `= None`.'
            + (f' `{name}` kieu container nen gan None se nha container cu the '
               f'cho GC.' if ta is not None and ta.shape else ''))
    ta = _container_il(scope, name, ctx)
    if ta is None:
        raise SyntaxError(
            f'il_codegen: khong suy duoc hinh dang cua `{name}` trong `del`')
    records = ctx.get('records')
    col_type = ctx['il_type_str'](ta, records)
    load = ctx['load_var_ref']
    if ta.shape == 'list':
        load(name, scope, body)
        ctx['compile_expr'](idx_node, scope, body, 'i32', ctx)
        # RemoveAt KHONG tra ve -> khong co gi tren stack, khong can pop.
        body.append(f'    callvirt instance void {col_type}::RemoveAt(int32)')
        return
    if ta.shape == 'dict':
        load(name, scope, body)
        ctx['compile_expr'](idx_node, scope, body, ta.key_dtype, ctx)
        # Remove tra bool - day la lenh DOC LAP nen phai bo ket qua.
        body.append(f'    callvirt instance bool {col_type}::Remove(!0)')
        body.append('    pop')
        return
    raise SyntaxError(
        f'il_codegen: `del {name}[...]` chi ap dung cho list/dict - `{name}` '
        f'co shape={ta.shape!r}. Xoa phan tu khoi chuoi hoac bo dem co dinh '
        f'khong co y nghia (xoa giua se lam lech chi so).')


register_line_parser('del_stmt', try_parse_del)
register_stmt_codegen('del_stmt', codegen_del_stmt)
register_first_pass_walk('del_stmt', fpw_del_stmt)
