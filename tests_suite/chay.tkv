# -*- coding: utf-8 -*-
"""Bo test TokenVector THUAN (khong Python): doc cac tep ca vang `test/tkv_suite/ca/*.ca`, dich nguon bang trinh bien dich
tu-host (tv2s.exe, che do hang loat `@ds` - MOT lan khoi dong moi tep .ca), chay exe voi tung bo doi so (proc_ra) va so
stdout + ma thoat voi gia tri vang.

Moi dong .ca: nguon TAB entry TAB ma_thoat TAB doi_so (cach nhau ky tu 30) TAB stdout (\\n, \\t, \\\\ da thoat).
Chay SO_LO luong song song; moi tep .ca dung ten exe/log RIENG -> khong giam chan nhau.

Dung: chay.exe [chuoi_loc]
"""

SO_LO = 4
THU_MUC_CA = "tests_suite\\ca"
THU_MUC_TAM = "build\\tkv_suite"
TRINH_DICH = "dist\\tkvc-tv.exe"


def ten_ngan(duong: "str") -> "str":
    vi = duong.rfind("\\")
    if vi >= 0:
        return duong[vi + 1:]
    return duong


def bo_thoat(s: "str") -> "str":
    """\\n -> xuong dong, \\t -> TAB, \\\\ -> \\ (da thoat khi ghi tep .ca)."""
    ra = []
    i = 0
    n = len(s)
    while i < n:
        c = s[i]
        if c == chr(92) and i + 1 < n:
            d = s[i + 1]
            if d == "n":
                ra.append(chr(10))
            elif d == "t":
                ra.append(chr(9))
            elif d == chr(92):
                ra.append(chr(92))
            else:
                ra.append(c)
                ra.append(d)
            i += 2
        else:
            ra.append(c)
            i += 1
    return "".join(ra)


def chuan(s: "str") -> "str":
    return s.replace(chr(13), "")


def xoa_neu_co(duong: "str") -> "i32":
    if path_exists(duong):
        _x = os_remove(duong)
    return 0


def chay_ca(duong_ca: "str") -> "i32":
    """Chay mot tep .ca; tra so ca TRUOT."""
    ten = ten_ngan(duong_ca)
    dong = []
    for ln in read_file(duong_ca).replace(chr(13), "").split(chr(10)):
        if ln.strip() != "":
            dong.append(ln)
    # 1) cac cap (nguon, entry) khac nhau -> mot lan dich hang loat
    khoa_ds = []
    exe_ds = []
    ds_txt = ""
    for ln in dong:
        f = ln.split(chr(9))
        khoa = f[0] + chr(9) + f[1]
        co = 0
        for kk in khoa_ds:
            if kk == khoa:
                co = 1
        if co == 0:
            exe = THU_MUC_TAM + "\\" + ten + "_" + str(len(khoa_ds)) + ".exe"
            xoa_neu_co(exe)
            khoa_ds.append(khoa)
            exe_ds.append(exe)
            ds_txt = ds_txt + f[0] + chr(9) + exe + chr(9) + f[1] + chr(10)
    lst = THU_MUC_TAM + "\\" + ten + ".lst"
    write_file(lst, ds_txt)
    _m = proc_ra(TRINH_DICH, "@" + lst, lst + ".log")
    # 2) chay tung ca
    truot = 0
    k = 0
    for ln in dong:
        f = ln.split(chr(9))
        khoa = f[0] + chr(9) + f[1]
        vt = 0
        j = 0
        while j < len(khoa_ds):
            if khoa_ds[j] == khoa:
                vt = j
            j += 1
        exe2 = exe_ds[vt]
        k = k + 1
        if not path_exists(exe2):
            print("  TRUOT " + ten + " ca " + str(k) + ": khong dich duoc " + f[0])
            truot = truot + 1
            continue
        doi_so = ""
        if f[3] != "":
            for a in f[3].split(chr(30)):
                doi_so = doi_so + " \"" + a + "\""
        ra = exe2 + "." + str(k) + ".out"
        ma2 = proc_ra(exe2, doi_so, ra)
        ma3: "i64" = ma2
        if ma3 < 0:
            ma3 = ma3 + 4294967296
        thuc = chuan(read_file(ra))
        mong = chuan(bo_thoat(f[4]))
        # ma thoat khac 0 = ca loi co y (ngoai le chua bat): proc_ra tron ca stderr vao stdout nen chi so ma thoat
        sai_ra = thuc != mong
        if f[2] != "0":
            sai_ra = False
        if sai_ra or str(ma3) != f[2]:
            print("  TRUOT " + ten + " ca " + str(k) + " args=" + f[3] + " rc=" + str(ma3) + " (mong " + f[2] + ")")
            truot = truot + 1
    if truot == 0:
        print("  DAT   " + ten + " (" + str(k) + " ca)")
    return truot


def chay_lo(lo: "i32") -> "i64":
    ds = os_list_files(THU_MUC_CA)
    loc = ""
    av = sys_argv()
    if len(av) > 1:
        loc = av[1]
    truot = 0
    i = lo
    n = len(ds)
    while i < n:
        d = ds[i]
        if d.endswith(".ca") and (loc == "" or loc in d):
            truot = truot + chay_ca(d)
        i = i + SO_LO
    return truot


def lo0() -> "i64":
    return chay_lo(0)


def lo1() -> "i64":
    return chay_lo(1)


def lo2() -> "i64":
    return chay_lo(2)


def lo3() -> "i64":
    return chay_lo(3)


def main() -> "i32":
    _bo = os_mkdir(THU_MUC_TAM)
    t0 = thread_spawn(lo0)
    t1 = thread_spawn(lo1)
    t2 = thread_spawn(lo2)
    t3 = thread_spawn(lo3)
    truot = thread_join(t0) + thread_join(t1) + thread_join(t2) + thread_join(t3)
    print("")
    print("=== TRUOT: " + str(truot) + " ===")
    if truot > 0:
        return 1
    return 0
