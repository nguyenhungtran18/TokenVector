import datetime
from datetime import timedelta, date

def tao() -> "str":
    d = datetime.datetime(2024, 3, 5, 7, 8, 9)
    e = d + datetime.timedelta(days=2, hours=3)
    return str(d) + "|" + str(e) + "|" + str(e - d) + "|" + e.strftime("%Y-%m-%d %H:%M")


def truong() -> "str":
    d = datetime.datetime(2024, 3, 5, 7, 8, 9)
    return str(d.year) + str(d.month) + str(d.day) + str(d.hour) + str(d.minute) + str(d.second) + str(d.weekday()) + str(d.isoweekday())


def ngay() -> "str":
    g = date(2024, 12, 25)
    h = g - date(2024, 1, 1)
    d = datetime.datetime(2024, 3, 5, 7, 8, 9)
    return str(g) + "|" + str(h.days) + "|" + str(g.weekday()) + "|" + str(d.date()) + "|" + g.isoformat()


def phep_toan() -> "str":
    a = datetime.datetime(2024, 1, 1)
    b = a + timedelta(days=1)
    r = ""
    if a < b:
        r = r + "lt"
    if b > a and b != a:
        r = r + "gt"
    td = timedelta(weeks=1, minutes=30)
    return r + str(b - a) + str((b - a).days) + "|" + str(td) + "|" + str(td * 2) + "|" + str((b - a).total_seconds())


def doc_chuoi() -> "str":
    d = datetime.datetime.strptime("2023-12-31 23:59:58", "%Y-%m-%d %H:%M:%S")
    e = datetime.datetime.fromisoformat("2024-01-02T03:04:05")
    return str(d) + "|" + str(e) + "|" + str((e - d).total_seconds()) + "|" + e.isoformat()


def hien_tai() -> "str":
    t = datetime.datetime.now()
    u = datetime.date.today()
    return str(t.year >= 2024) + str(u.year >= 2024)
