def dem() -> "str":
    t = (1, 2, 2, 3)
    return str(t.count(2)) + str(t.count(9))


def vi_tri() -> "str":
    t = (1, 2, 2, 3)
    s = ("a", "b", "c")
    return str(t.index(3)) + str(s.index("b"))


def thuoc() -> "str":
    t = (1, 2, 3)
    u = ("x", "y")
    a = 2 in t
    b = 5 in t
    return str(a) + str(b) + str("y" in u)


def duyet() -> "str":
    t = (4, 5, 6)
    u = ("a", "b", "c")
    k = 1
    s = 0
    for v in t:
        s += v
    r = ""
    for w in u:
        r = r + w
    for i in range(len(t)):
        s += t[i]
    return r + str(s) + str(t[k]) + str(t[-1]) + str(u[-3])


def ngoai_khoang() -> "str":
    t = (1, 2, 3)
    k = 5
    try:
        return str(t[k])
    except IndexError:
        return "IE"


def index_thieu() -> "str":
    t = (1, 2, 3)
    try:
        return str(t.index(9))
    except ValueError:
        return "VE"
