# -*- coding: utf-8 -*-
"""Bo dieu phoi hoi quy viet bang TokenVector - ban chuyen tu `run_tests.py`.

DO TRUOC KHI VIET, de khong hua sai: bo dieu phoi CHI chiem ~0,05% thoi
gian (0,67 s CPU tren 1371 s). 99,95% nam trong 265 tien trinh con - moi
cai tu khoi dong Python, nap 113 module trinh bien dich, dich .tkv, goi
ilasm, chay .exe. Nen ban nay **KHONG nhanh hon** ban Python. Gia tri cua
no la khac: mot chuong trinh THAT, dung hang ngay, viet bang TokenVector,
va bo mot cho phu thuoc CPython khoi duong chay test.

KHAC ban Python (noi ro, khong giau):
  - Khong co `--exclude <nhan>`: nhan test nam trong `verify/_manifest.py`,
    la ma Python. Ban nay khong doc no.
  - Khong co cot "<-- CHAM": nguong nam trong cung file manifest do.
  - `_results.json` co it truong hon (khong co tags/git_sha/python).

Cach dung:
    run_tests.exe                 # chay het
    run_tests.exe --only <chuoi>  # chi bai co <chuoi> trong ten
    run_tests.exe --list          # chi liet ke
    run_tests.exe --tat-ca        # ke ca bai da di tru sang tkv_suite

Bai nam trong `test/verify/_da_di_tru.txt` (chi kiem stdout, da co tep .ca tuong ung trong test/tkv_suite/ca)
bi BO QUA mac dinh - do chay bang `test/tkv_suite/chay.exe`. Bai kiem IL/cau truc van chay o day.
"""

THU_MUC = "test\\verify"
TEP_KQ = "test\\verify\\_results_tkv.json"
TEP_DA_DI_TRU = "test\\verify\\_da_di_tru.txt"
THU_MUC_TAM = "_scratch\\ra_test"


def la_bai_test(ten: "str") -> "i32":
    """'*_test.py' va khong bat dau bang '_' (bo file tro giup)."""
    if not ten.endswith("_test.py"):
        return 0
    if ten.startswith("_"):
        return 0
    return 1


def ten_ngan(duong: "str") -> "str":
    vi = duong.rfind("\\")
    if vi >= 0:
        return duong[vi + 1:]
    return duong


def giay_tu(t0: "i64", t1: "i64") -> "str":
    """Hai moc ticks -> chuoi giay mot chu so thap phan. 1 tick = 100 ns."""
    ms = (t1 - t0) // 10000
    nguyen = ms // 1000
    le = (ms % 1000) // 100
    return str(nguyen) + "." + str(le)


def thoat_json(s: "str") -> "str":
    """Thoat toi thieu cho mot chuoi JSON."""
    r = s.replace("\\", "\\\\")
    r = r.replace("\"", "\\\"")
    r = r.replace("\n", "\\n")
    r = r.replace("\r", "")
    r = r.replace("\t", "\\t")
    return r


def main() -> "i32":
    """Bo boc CLI do `compile_tkv_cli` sinh ra IN gia tri tra ve chu
    KHONG dung no lam ma thoat - nen phai goi `sys_exit` tuong minh,
    va `main` tra 0 cho moi duong (gia tri nay chi de in)."""
    tham = sys_argv()
    loc = ""
    chi_liet_ke = 0
    tat_ca = 0
    i = 1
    while i < len(tham):
        if tham[i] == "--only" and i + 1 < len(tham):
            loc = tham[i + 1]
            i = i + 1
        if tham[i] == "--list":
            chi_liet_ke = 1
        if tham[i] == "--tat-ca":
            tat_ca = 1
        i = i + 1

    _bo = os_mkdir(THU_MUC_TAM)
    da_di_tru = []
    if tat_ca == 0 and path_exists(TEP_DA_DI_TRU):
        for dong in read_file(TEP_DA_DI_TRU).replace(chr(13), "").split(chr(10)):
            if dong.strip() != "":
                da_di_tru.append(dong.strip())
    ds_tep = os_list_files(THU_MUC)
    bai = []
    j = 0
    while j < len(ds_tep):
        d = ds_tep[j]
        if la_bai_test(ten_ngan(d)) == 1 and ten_ngan(d) not in da_di_tru:
            if loc == "" or ten_ngan(d).find(loc) >= 0:
                bai.append(d)
        j = j + 1

    if len(bai) == 0:
        print("KHONG tim thay test nao - kiem lai --only/duong dan.")
        sys_exit(1)
        return 0

    if chi_liet_ke == 1:
        k = 0
        while k < len(bai):
            print(ten_ngan(bai[k]))
            k = k + 1
        print("")
        print("Tong: " + str(len(bai)) + " test")
        return 0

    t_dau = datetime_ticks(datetime())
    so_dat = 0
    so_truot = 0
    ten_truot = []
    dong_json = []
    k = 0
    while k < len(bai):
        duong = bai[k]
        ten = ten_ngan(duong)
        ra_f = THU_MUC_TAM + "\\" + ten + ".out"
        t0 = datetime_ticks(datetime())
        ma = proc_ra("python", "\"" + duong + "\"", ra_f)
        t1 = datetime_ticks(datetime())
        gy = giay_tu(t0, t1)
        if ma == 0:
            so_dat = so_dat + 1
            trang = "PASS"
        else:
            so_truot = so_truot + 1
            trang = "FAIL"
            ten_truot.append(ten)
        print("[" + str(k + 1) + "/" + str(len(bai)) + "] " + trang
              + "  " + gy + "s  " + ten)
        dong_json.append("  {\"name\": \"" + thoat_json(ten)
                         + "\", \"status\": \"" + trang.lower()
                         + "\", \"seconds\": " + gy
                         + ", \"returncode\": " + str(ma) + "}")
        k = k + 1
    t_cuoi = datetime_ticks(datetime())

    print("")
    print("=== PASS " + str(so_dat) + " / FAIL " + str(so_truot)
          + "  (tong " + str(len(bai)) + ", " + giay_tu(t_dau, t_cuoi) + "s) ===")
    if so_truot > 0:
        print("")
        print("TRUOT:")
        k = 0
        while k < len(ten_truot):
            ten = ten_truot[k]
            print("---- " + ten + " ----")
            noi = read_file(THU_MUC_TAM + "\\" + ten + ".out")
            if len(noi) > 1500:
                noi = noi[len(noi) - 1500:]
            print(noi)
            k = k + 1

    js = "{\n \"schema\": 1,\n \"summary\": {\"pass\": " + str(so_dat) \
        + ", \"fail\": " + str(so_truot) + ", \"total\": " + str(len(bai)) \
        + ", \"seconds\": " + giay_tu(t_dau, t_cuoi) + "},\n \"tests\": [\n" \
        + ",\n".join(dong_json) + "\n ]\n}\n"
    write_file(TEP_KQ, js)
    print("")
    print("Chi tiet: " + TEP_KQ)
    if so_truot > 0:
        sys_exit(1)
    sys_exit(0)
    return 0
