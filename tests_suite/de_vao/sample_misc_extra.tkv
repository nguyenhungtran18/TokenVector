# -*- coding: utf-8 -*-
"""Mau cho misc_extra_test: getattr/hasattr/issubclass/most_common/
complex/eval_arith/sys_argv."""


class Diem:
    x: "i32"
    y: "i32"
    ten: "str"

    def __init__(self, x: "i32", y: "i32", ten: "str"):
        self.x = x
        self.y = y
        self.ten = ten


class Diem3(Diem):
    z: "i32"

    def __init__(self, x: "i32", y: "i32", ten: "str", z: "i32"):
        self.x = x
        self.y = y
        self.ten = ten
        self.z = z


# HAI GIOI HAN da gap:
#  - ten thuoc tinh PHAI la hang luc bien dich - hasattr(d, bien) bao
# "record khong co attribute 'bien'". Dung voi mot trinh bien dich TINH.
def co_truong() -> "str":
    d = Diem(1, 2, "A")
    r = ""
    if hasattr(d, "x"):
        r = r + "x"
    if hasattr(d, "z"):
        r = r + "z"
    return r


#  - getattr() chi doc duoc truong kieu 'str'
def doc_truong() -> "str":
    d = Diem(3, 4, "B")
    a = getattr(d, "ten")
    return a


def la_lop_con() -> "str":
    if issubclass(Diem3, Diem):
        return "dung"
    return "sai"


def so_phuc(a: "f64", b: "f64") -> "str":
    z = complex(a, b)
    return str(z)


def tinh_bieu_thuc(s: "str") -> "str":
    v = eval_arith(s)
    return fmt_float(v, 2)


def so_tham_so() -> "str":
    xs = sys_argv()
    n = len(xs)
    return str(n)
