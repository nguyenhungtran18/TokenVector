"""Probe: raise/except SyntaxError, va KHONG bat nham IndexError."""


def nem(n: "i32") -> "str":
    if n > 0:
        raise SyntaxError("sai cu phap")
    return "khong nem"


def bat_dung(n: "i32") -> "str":
    try:
        return nem(n)
    except SyntaxError:
        return "bat SyntaxError"
    except Exception:
        return "bat Exception"


def khong_bat_nham(n: "i32") -> "str":
    lst = [1, 2, 3]
    try:
        x = lst[n]
        return "ok"
    except SyntaxError:
        return "SAI - SyntaxError bat nham IndexError"
    except Exception:
        return "dung - roi xuong Exception"


def main() -> "str":
    return bat_dung(1) + " | " + khong_bat_nham(10)
