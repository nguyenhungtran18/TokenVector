def thu_tu_sau_xoa() -> "str":
    d = {}
    d["b"] = 1
    d["a"] = 2
    d["c"] = 3
    d.pop("a")
    d["a"] = 9
    del d["b"]
    d["z"] = 7
    d["b"] = 5
    r = ""
    for k in d:
        r = r + k + str(d[k])
    return r


def so_nguyen() -> "str":
    e = {}
    e[1] = 10
    e[2] = 20
    e[3] = 30
    v = e.pop(2)
    e[4] = 40
    e[2] = 25
    return str(list(e.keys())) + str(v) + str(len(e)) + str(e.pop(99, -1))


def gia_tri_list() -> "str":
    d: "dict[str, list[i32]]" = {}
    d["x"] = [1]
    d["y"] = [2, 3]
    d["z"] = []
    d.pop("y")
    d["y"] = [9]
    r = ""
    for k in d:
        r = r + k + str(len(d[k]))
    return r


def xoa_het_roi_them() -> "str":
    d = {}
    d["p"] = 1
    d.pop("p")
    d["q"] = 2
    d["p"] = 3
    return str(list(d.keys()))


def xoa_lien_tiep() -> "str":
    d: "dict[i32, i32]" = {}
    for i in range(50):
        d[i] = i
    for i in range(0, 50, 2):
        d.pop(i)
    d[100] = 1
    d[0] = 2
    return str(len(d)) + str(list(d.keys())[0]) + str(list(d.keys())[-2]) + str(list(d.keys())[-1])
