# -*- coding: utf-8 -*-
"""Kiem chung fix BUGS_TODO.md muc U (2026-08-31): 'expr[index].property'
(doc property KHONG dau ngoac ngay sau 1 index-expression) - truoc day bi
parser tu choi (SyntaxError: ky vong '(', gap ...) vi '_parse_postfix_method'
chi ho tro '.method(...)'. Nay co fallback tra ve node 'attr_expr' khi
KHONG co '(' theo sau, va codegen moi (compile_attr_expr,
compiler/il_features/record_feature.py) bien dich duoc cho obj co shape
'extern_class' (__tkv_extern_class__)."""
__tkv_extern_assembly__ = [("System", None, None)]
__tkv_extern_class__ = [
    {
        "name": "Process", "assembly": "System", "class": "System.Diagnostics.Process",
        "ctor": [],
        "methods": [],
        "static_methods": [
            {"name": "GetProcesses", "params": [], "returns": "array[Process]"},
        ],
        "properties": [
            {"name": "ProcessName", "dtype": "str", "readonly": True},
            {"name": "WorkingSet64", "dtype": "i64", "readonly": True},
            {"name": "Id", "dtype": "i32", "readonly": True},
        ],
    },
]


def run_direct_return(a: "str") -> "str":
    # 'procs[0].ProcessName' TRUC TIEP trong 'return', khong qua bien
    # trung gian - case 1 (that su gay loi truoc day).
    procs = Process.GetProcesses()
    return procs[0].ProcessName


def run_as_call_arg(a: "str") -> "str":
    # 'procs[0].Id' lam THAM SO TRUC TIEP cua str() - case da gay loi
    # trong RamGuard.tkv ('trim_process_ram(procs[j].Id)').
    procs = Process.GetProcesses()
    return str(procs[0].Id)


def run_assigned_then_arith(a: "str") -> "str":
    # gan ra 1 bien roi lam toan hang so hoc - xac nhan type-inference
    # dung dtype THAT (i64), khong phai mac dinh sai.
    procs = Process.GetProcesses()
    x = procs[0].WorkingSet64
    y = x + 1
    return str(y)


def run_in_concat(a: "str") -> "str":
    # toan hang GIUA 1 chuoi noi '+' nhieu doan.
    procs = Process.GetProcesses()
    return "name=" + procs[0].ProcessName + "!"
