# -*- coding: utf-8 -*-
"""Kiem chung fix BUGS_TODO.md muc T.1 (2026-08-31): int(str) truoc day
LUON dung Int32.Parse bat ke dtype dich, gay OverflowException that voi
gia tri i64 lon hon i32.MaxValue (vd datetime_ticks() dang chuoi trong
RamGuard.tkv). Gia tri test '639237657423996539' la 1 gia tri ticks THAT
da ghi trong state.json cua RamGuard luc chay thu that (xem
.superpowers/sdd/task-5-report.md) - vuot xa i32.MaxValue (2147483647)."""


def parse_as_i64(s: "str") -> "i64":
    # 'return int(s)' truyen dtype dich = kieu tra ve khai bao cua ham
    # ('i64') xuong _compile_expr - day chinh la ngu canh kich hoat nhanh
    # Int64.Parse moi them (khong the ep local var qua cu phap 'x: "i64" =
    # ...' vi TokenVector chi ho tro cu phap do cho func(...)/defaultdict/
    # Counter/list[(K,V)], KHONG cho scalar - xac nhan that qua loi bien
    # dich luc viet test nay).
    return int(s)


def parse_as_i32(s: "str") -> "i32":
    return int(s)


def run_i64_overflow(a: "str") -> "str":
    x = parse_as_i64("639237657423996539")
    return str(x)


def run_i32_still_works(a: "str") -> "str":
    # dam bao fix khong lam hong duong i32 cu (dtype != 'i64' van dung
    # Int32.Parse nhu truoc).
    x = parse_as_i32("42")
    return str(x)


def run_i64_small_value(a: "str") -> "str":
    # gia tri nho (nam trong pham vi i32) nhung dich la i64 - phai dung
    # dung gia tri, khong bi cat/sai do nham lan giua 2 nhanh.
    x = parse_as_i64("42")
    return str(x)
