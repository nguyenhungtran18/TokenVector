"""Fixture cho json_loads_test.py (Task 1, RamGuard rewrite, 2026-08-31).

Field 'active' khai 'i32' (KHONG phai 'bool' - TokenVector khong co kieu
bool rieng cho record field, xem LUU Y trong compiler/il_features/
stdlib_json.py) - JSON gia tri 'true'/'false' duoc json_loads() tu dong
doi thanh 1/0 cho field i32/i64, quy uoc GIONG HET cach True/False Python
duoc parse thang thanh literal so trong il_core.py.

Chuoi JSON viet bang dau nhay KEP voi dau nhay ben trong duoc thoat bang
backslash ('\\"...\\"') - tokenizer bieu thuc cua ngon ngu nay (il_core.py's
_EXPR_TOKEN_RE) CHI chap nhan chuoi nhay KEP, KHONG ho tro nhay DON lam dau
phan cach (khac Python that, da xac nhan qua loi tokenize THAT khi thu voi
nhay don)."""


class Config:
    threshold: "i32"
    ratio: "f64"
    label: "str"
    active: "i32"


def run_full(a: "str") -> "str":
    text = "{\"threshold\": 42, \"ratio\": 3.5, \"label\": \"hello\", \"active\": true}"
    cfg = json_loads(text, Config)
    return str(cfg.threshold) + "|" + str(cfg.ratio) + "|" + cfg.label + "|" + str(cfg.active)


def run_missing_field(a: "str") -> "str":
    # 'label' va 'active' bi thieu trong JSON - phai giu gia tri mac dinh
    text = "{\"threshold\": 7, \"ratio\": 1.5}"
    cfg = json_loads(text, Config)
    return str(cfg.threshold) + "|" + str(cfg.ratio) + "|[" + cfg.label + "]|" + str(cfg.active)


def run_extra_field(a: "str") -> "str":
    # field 'unknown_extra' trong JSON KHONG co trong record - phai bi bo qua, khong loi
    text = "{\"threshold\": 9, \"ratio\": 2.0, \"label\": \"x\", \"active\": false, \"unknown_extra\": 999}"
    cfg = json_loads(text, Config)
    return str(cfg.threshold) + "|" + str(cfg.ratio) + "|" + cfg.label + "|" + str(cfg.active)


def run_reordered(a: "str") -> "str":
    # thu tu field trong JSON DAO nguoc so voi thu tu khai record - van phai dung
    text = "{\"active\": true, \"label\": \"z\", \"ratio\": 9.25, \"threshold\": 3}"
    cfg = json_loads(text, Config)
    return str(cfg.threshold) + "|" + str(cfg.ratio) + "|" + cfg.label + "|" + str(cfg.active)


def run_roundtrip(a: "str") -> "str":
    # json_dumps(dict) -> json_loads(Config) khong duoc dung truc tiep vi
    # json_dumps chi ho tro dict[str, 1-kieu] - test roundtrip qua 1 chuoi
    # JSON tay viet dai dien cho dung dinh dang json_dumps that sinh ra.
    text = "{\"threshold\":100,\"ratio\":0.5,\"label\":\"rt\",\"active\":false}"
    cfg = json_loads(text, Config)
    return str(cfg.threshold) + "|" + str(cfg.ratio) + "|" + cfg.label + "|" + str(cfg.active)
