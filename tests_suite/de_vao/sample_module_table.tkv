KEYWORDS: "set[str]" = {"def", "class", "return"}
NAMES: "list[str]" = ["alpha", "beta", "gamma"]
SIZES: "list[i32]" = [10, 20, 30]


def is_kw(w: "str") -> "i32":
    if w in KEYWORDS:
        return 1
    return 0


def total() -> "i32":
    s = 0
    for n in SIZES:
        s = s + n
    return s


def run_module_table() -> "str":
    return (NAMES[1] + "-" + str(SIZES[2]) + "-" + str(len(NAMES))
            + "-" + str(is_kw("class")) + str(is_kw("xyz")) + "-" + str(total()))
