# Mau cho random_props_test: random/randint/randrange/uniform.
#
# Bon o nay nam trong ma tran voi trang thai [!] (duoc nhan, khong test
# nao chay) va KHONG THE khoa bang cach viet tay mot gia tri mong doi -
# ket qua la ngau nhien.
#
# CACH KHOA: khoa TINH CHAT, khong khoa gia tri.
#   1. Lap lai duoc: cung seed -> cung day (seed(n) gan lai rng, xem
#      docstring stdlib_random.py). Day la dieu duy nhat khien mot
#      chuong trinh dung random co the kiem thu duoc.
#   2. Bien do: moi gia tri phai nam dung doan, VA hai dau mut phai
#      that su xuat hien (chan kieu bug "luon tra a" hoac "lech 1").
#
# NGU NGHIA DA GHI TRONG NGUON: randint(a,b) DONG ca hai dau [a,b];
# randrange(a,b) NUA MO [a,b). Hai ca duoi day khoa dung cho khac biet
# do - neu ai do gop chung mot duong sinh ma, cong nay FAIL.
#
# Chuong trinh TU phan xu roi in mot chuoi xac dinh; phia Python chi so
# chuoi do, khong doan so ngau nhien.


# GIOI HAN DA GAP luc viet mau: random/randint/randrange/uniform deu
# dang ky voi return_dtype None, nen 'v = randint(3,5)' KHONG suy ra
# duoc kieu va roi ve 'str' -> so sanh 'v < 3' no KeyError 'str' trong
# _expr_num. Boc qua mot ham co KIEU TRA VE tuong minh thi het. Ghi ro
# thay vi giau: day la mot gap THAT cua suy kieu, khong phai loi mau.
def mot_randint(a: "i32", b: "i32") -> "i32":
    return randint(a, b)


def mot_randrange(a: "i32", b: "i32") -> "i32":
    return randrange(a, b)


def mot_random() -> "f64":
    return random()


def mot_uniform(a: "f64", b: "f64") -> "f64":
    return uniform(a, b)


def day_tu_seed(s: "i32") -> "str":
    seed(s)
    r = ""
    i = 0
    while i < 5:
        r = r + str(mot_randint(1, 1000000)) + ","
        i = i + 1
    return r


def lap_lai_duoc() -> "str":
    a = day_tu_seed(42)
    b = day_tu_seed(42)
    if a == b:
        return "GIONG"
    return "KHAC"


def khac_seed() -> "str":
    a = day_tu_seed(1)
    b = day_tu_seed(2)
    if a == b:
        return "GIONG"
    return "KHAC"


def bien_do_randint() -> "str":
    seed(7)
    thap = 999
    cao = -999
    i = 0
    while i < 500:
        v = mot_randint(3, 5)
        if v < thap:
            thap = v
        if v > cao:
            cao = v
        i = i + 1
    return str(thap) + ".." + str(cao)


def bien_do_randrange() -> "str":
    seed(7)
    thap = 999
    cao = -999
    i = 0
    while i < 500:
        v = mot_randrange(3, 5)
        if v < thap:
            thap = v
        if v > cao:
            cao = v
        i = i + 1
    return str(thap) + ".." + str(cao)


def bien_do_random() -> "str":
    seed(11)
    ngoai = 0
    i = 0
    while i < 500:
        v = mot_random()
        if v < 0.0:
            ngoai = ngoai + 1
        if v >= 1.0:
            ngoai = ngoai + 1
        i = i + 1
    return "ngoai=" + str(ngoai)


def bien_do_uniform() -> "str":
    seed(13)
    ngoai = 0
    i = 0
    while i < 500:
        v = mot_uniform(2.5, 3.5)
        if v < 2.5:
            ngoai = ngoai + 1
        if v > 3.5:
            ngoai = ngoai + 1
        i = i + 1
    return "ngoai=" + str(ngoai)
