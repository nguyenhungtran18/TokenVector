# -*- coding: utf-8 -*-
"""Mau cho container_extra_test"""
import re

SO_RE = re.compile(r"[0-9]+")


# Mau cho container_extra_test: cac dang GAN va thao tac container ma ma
# tran phu cho thay chua co test nao chay exe.


def lap_ds(a: "str", n: "i32") -> "str":
    xs = a.split(",")
    ys = xs * n
    m = len(ys)
    return str(m) + "|" + ys[0]


def lap_chuoi(t: "str", n: "i32") -> "str":
    s = repeat_str(t, n)
    return s


def gan_nhieu_dich(v: "i32") -> "str":
    a = b = v
    return str(a) + "|" + str(b)


def noi_them(a: "str", b: "str") -> "str":
    xs = a.split(",")
    ys = b.split(",")
    xs.extend(ys)
    m = len(xs)
    return str(m) + "|" + "-".join(xs)


def sap_xep(s: "str") -> "str":
    xs = s.split(",")
    xs.sort()
    return "-".join(xs)


def tap_dong(s: "str") -> "str":
    xs = s.split(",")
    fs = frozenset(xs)
    n = len(fs)
    return str(n)


def mang_byte(n: "i32") -> "str":
    b = bytearray()
    i = 0
    while i < n:
        b.append(65 + i)
        i = i + 1
    n2 = len(b)
    return str(n2)


def hang_byte() -> "str":
    b = b"abc"
    n = len(b)
    return str(n)


def khop_dau_cuoi(s: "str") -> "str":
    m = SO_RE.search(s)
    if not m:
        return "khong"
    return str(m.start()) + "|" + str(m.end())
