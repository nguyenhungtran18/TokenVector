# -*- coding: utf-8 -*-
"""Kiem chung list[func(...)->...] - symmetry voi dict."""


def add_ten(x: "i32") -> "i32":
    return x + 10


def add_twenty(x: "i32") -> "i32":
    return x + 20


def run_list_call() -> "str":
    fns: "list[func(i32)->i32]" = []
    fns.append(add_ten)
    fns.append(add_twenty)
    a = fns[0](1)
    b = fns[1](1)
    return str(a) + "," + str(b)
