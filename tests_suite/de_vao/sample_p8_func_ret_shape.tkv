# Bao phu cho 'func(...) tra ve kieu tham chieu' (plan 2026-09-09).
#
# Truoc plan nay, tap cong co DUNG 0 mau dung `func(...)` tra ve container -
# nen cong khong the noi gi ve duong nay. Bai hoc da tra gia nhieu lan trong
# P8: cong chi manh bang tap mau cua no.

def tao_ds(s: "str") -> "list[str]":
    ra = []
    ra.append(s)
    ra.append(s)
    return ra


def tao_bang(s: "str") -> "dict[str,i32]":
    d = {}
    d[s] = 1
    return d


def dem_qua_tham_so(f: "func(str)->list[str]", x: "str") -> "i32":
    # `f` la THAM SO kieu func tra ve container.
    xs = f(x)
    return len(xs)


def dem_qua_bien(x: "str") -> "i32":
    # `g` la BIEN DIA PHUONG co annotation - duong khac voi tham so.
    g: "func(str)->list[str]" = tao_ds
    xs = g(x)
    return len(xs)


def dem_dict(f: "func(str)->dict[str,i32]", x: "str") -> "i32":
    d = f(x)
    return len(d)


def long_nhau(f: "func(str)->list[str]", x: "str") -> "i32":
    # Goi LONG: ket qua cua f duoc dung ngay lam doi so.
    return len(f(x)) + len(f(x))


def thu() -> "str":
    a = dem_qua_tham_so(tao_ds, "m")
    b = dem_qua_bien("m")
    c = dem_dict(tao_bang, "m")
    d = long_nhau(tao_ds, "m")
    return str(a) + "," + str(b) + "," + str(c) + "," + str(d)
