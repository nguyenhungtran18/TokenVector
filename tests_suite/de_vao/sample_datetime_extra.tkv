# -*- coding: utf-8 -*-
"""Mau cho datetime_extra_test.

datetime() la GIO HIEN TAI nen khong khoa duoc gia tri - chi khoa TINH
CHAT (nam >= 2020, va hai lan goi lien nhau cach nhau duoi 1 ngay). Moi
thu khac deu dung moc CO DINH qua datetime_strptime nen so chuoi duoc.
"""


def dinh_dang(s: "str") -> "str":
    d = datetime_strptime(s, "%Y-%m-%d %H:%M:%S")
    return d.strftime("%Y/%m/%d %H:%M:%S")


def cong_ngay(s: "str", n: "i32") -> "str":
    d = datetime_strptime(s, "%Y-%m-%d %H:%M:%S")
    td = timedelta_days(n)
    d2 = datetime_add(d, td)
    return d2.strftime("%Y-%m-%d")


def tru_gio(s: "str", n: "i32") -> "str":
    d = datetime_strptime(s, "%Y-%m-%d %H:%M:%S")
    td = timedelta_hours(n)
    d2 = datetime_sub(d, td)
    return d2.strftime("%Y-%m-%d %H:%M:%S")


def cong_phut_giay(s: "str", p: "i32", g: "i32") -> "str":
    d = datetime_strptime(s, "%Y-%m-%d %H:%M:%S")
    t1 = timedelta_minutes(p)
    t2 = timedelta_seconds(g)
    d2 = datetime_add(d, t1)
    d3 = datetime_add(d2, t2)
    return d3.strftime("%H:%M:%S")


def khoang_cach(a: "str", b: "str") -> "str":
    d1 = datetime_strptime(a, "%Y-%m-%d %H:%M:%S")
    d2 = datetime_strptime(b, "%Y-%m-%d %H:%M:%S")
    td = datetime_diff(d1, d2)
    d3 = datetime_add(d2, td)
    return d3.strftime("%Y-%m-%d %H:%M:%S")


def gio_hien_tai_hop_ly() -> "str":
    d = datetime()
    nam = d.strftime("%Y")
    if nam >= "2020":
        return "hop-ly"
    return "vo-ly"
