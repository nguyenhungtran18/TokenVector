
__tkv_extern_class__ = [
    {
        "name": "Sb", "assembly": "mscorlib", "class": "System.Text.StringBuilder",
        "ctor": ["str"],
        "methods": [{"name": "ToString", "params": [], "returns": "str"}],
    },
]

def main() -> "i32":
    a = Sb("x")
    b = Sb("y")
    c = Sb("z")
    xs = [a, b, c]
    picked = choice(xs)
    print(picked.ToString())
    shuffle(xs)
    for s in xs:
        print(s.ToString())
    return 0
