def main() -> "i32":
    # Check 1: marshal DOI SO List<List<Item>> -> Item[][] - tong dung,
    # ke ca hang KHONG DEU do dai (jagged that su) VA phan tu la handle-type
    # (Item instance, khong phai scalar).
    x1 = Item(1)
    x2 = Item(2)
    x3 = Item(3)
    total = NestedHandleTypeFixture.SumItemsNested([[x1, x2], [x3]])
    print(total)

    # Check 2: marshal KET QUA Item[][] -> List<List<Item>> - kich thuoc
    # tam giac dung VA getValue() tung phan tu dung cong thuc i*10+j (xac
    # nhan thu tu KHONG lech qua vong lap marshal LAN qua handle-type ctor).
    tri = NestedHandleTypeFixture.MakeItemsTriangle(3)
    print(len(tri))
    row0 = tri[0]
    row2 = tri[2]
    print(len(row0))
    print(len(row2))
    # Gan phan tu vao 1 bien truoc khi goi method (idiom Phase 9h's
