
class A:
    v: "i32"
    def __init__(self, v):
        self.v = v

class B_C:
    v: "i32"
    def __init__(self, v):
        self.v = v

class A_B:
    v: "i32"
    def __init__(self, v):
        self.v = v

class C:
    v: "i32"
    def __init__(self, v):
        self.v = v

def f(a, b) -> "i32":
    return a.v * 1000 + b.v

def main() -> "i32":
    r1 = f(A(1), B_C(2))
    r2 = f(A_B(3), C(4))
    return r1 * 1000000 + r2
