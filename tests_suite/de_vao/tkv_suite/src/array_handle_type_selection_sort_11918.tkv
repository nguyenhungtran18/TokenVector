
__tkv_extern_assembly__ = [("ItemApi", None, None)]
__tkv_extern_class__ = [
    {
        "name": "Item", "assembly": "ItemApi", "class": "Item",
        "ctor": ["i32"],
        "methods": [
            {"name": "getValue", "params": [], "returns": "i32"},
        ],
    },
    {
        "name": "ItemApi", "assembly": "ItemApi", "class": "ItemApi",
        "ctor": [],
        "methods": [],
        "static_methods": [
            {"name": "MakeUnsorted", "params": [], "returns": "array[Item]"},
        ],
    },
]


def main() -> "i32":
    items = ItemApi.MakeUnsorted()
    n = len(items)
    # Selection sort GIAM DAN - thuat toan DAY DU, co SWAP THAT qua gan
    # chi so (khong phai partial-selection ne tranh nhu RamGuard.tkv).
    i = 0
    while i < n:
        best = i
        j = i + 1
        while j < n:
            if items[j].getValue() > items[best].getValue():
                best = j
            j = j + 1
        if best != i:
            tmp = items[i]
            items[i] = items[best]
            items[best] = tmp
        i = i + 1
    k = 0
    while k < n:
        print(items[k].getValue())
        k = k + 1
    return 0
