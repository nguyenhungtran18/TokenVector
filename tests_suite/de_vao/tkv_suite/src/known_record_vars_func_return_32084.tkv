
class Bag:
    a: "i32"
    b: "i32"
    c: "i32"


class BagIter:
    src: "Bag"
    idx: "i32"

    def __iter__(self) -> "BagIter":
        return self

    def __next__(self) -> "(i32, i32)":
        s = self.src
        if self.idx == 0:
            self.idx = self.idx + 1
            return s.a, 1
        if self.idx == 1:
            self.idx = self.idx + 1
            return s.b, 1
        if self.idx == 2:
            self.idx = self.idx + 1
            return s.c, 1
        return 0, 0


class BagWithIter:
    a: "i32"
    b: "i32"
    c: "i32"

    def __iter__(self) -> "BagIter":
        bi = BagIter(self, 0)
        return bi

    def __len__(self) -> "i32":
        return 3

    def __getitem__(self, i: "i32") -> "i32":
        return 999


def make_bag() -> "BagWithIter":
    bag = BagWithIter(10, 20, 30)
    return bag


def main() -> "i32":
    b = BagWithIter(10, 20, 30)
    total = 0
    for x in b:
        total = total + x
    return total
