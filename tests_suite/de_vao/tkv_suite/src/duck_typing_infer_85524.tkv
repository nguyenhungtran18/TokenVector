
class Point:
    x: "i32"
    y: "i32"
    def __init__(self, x, y):
        self.x = x
        self.y = y

def get_x(p) -> "i32":
    return p.x

def gen_from_point(p: "Point") -> "list[i32]":
    yield get_x(p)
    yield get_x(p) + 1

def main() -> "i32":
    total = 0
    pt = Point(10, 20)
    for v in gen_from_point(pt):
        total = total + v
    return total
