
__tkv_extern_assembly__ = [("WidgetFactory", None, None)]
__tkv_extern_class__ = [
    {
        "name": "Widget", "assembly": "WidgetFactory", "class": "Widget",
        "ctor": [], "methods": [],
    },
]
__tkv_extern_method__ = [
    {
        "name": "make_widget", "assembly": "WidgetFactory", "class": "WidgetFactory",
        "method": "MakeWidget", "params": ["i32"], "returns": "Widget",
    },
    {
        "name": "describe_widget", "assembly": "WidgetFactory", "class": "WidgetFactory",
        "method": "Describe", "params": ["Widget"], "returns": "str",
    },
]


def main() -> "i32":
    # Vi tri 1: return dtype handle-type -> gan bien -> dung lai (truyen
    # tiep vao 1 __tkv_extern_method__ khac nhan dung handle-type do).
    w = make_widget(1)
    print(describe_widget(w))
    # Vi tri 2: long truc tiep (return dtype handle-type dung lam tham so
    # handle-type NGAY trong 1 loi goi khac, khong qua bien trung gian).
    print(describe_widget(make_widget(2)))
    # Vi tri 3: handle-type tao qua __tkv_extern_class__ ctor thuong (KHONG
    # phai tu __tkv_extern_method__) van truyen duoc vao tham so handle-
    # type cua __tkv_extern_method__ - xac nhan khong regressive/dtype ca 2
    # nguon deu tuong thich.
    w2 = Widget()
    print(describe_widget(w2))
    return 0
