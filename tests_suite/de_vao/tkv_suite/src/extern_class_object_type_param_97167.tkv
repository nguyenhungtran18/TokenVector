def take_str_via_extern_method(s: "str") -> "str":
    return describe_it(s)

def roundtrip_boxed_via_extern_method(x: "i32") -> "str":
    boxed = make_boxed(x)
    return describe_it(boxed)

def main() -> "i32":
    # (a) 'object' lam tham so tren __tkv_extern_method__ - string (reference
    # type, khong box) truyen THANG.
    print(take_str_via_extern_method("hello"))
    # (b) 'type' lam tham so tren __tkv_extern_method__ - typeof(Widget).
    print(type_name_len(typeof(Widget)))
