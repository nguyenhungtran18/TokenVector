def khong_ngu() -> "str":
    return "xong"


def ngu(ms: "str") -> "str":
    # GIOI HAN DA GAP: thread_sleep dang ky la BIEU THUC tra i32, nen
    # dung o dang lenh doc lap bi tu choi ("khong tim thay ham nay
    # trong chuong trinh") - phai gan vao mot bien bo di.
    bo = thread_sleep(int(ms))
    return "xong"
