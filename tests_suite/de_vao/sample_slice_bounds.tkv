def main(n: "i32") -> "str":
    i = n - 3
    j = n + 4
    a = [1, 2, 3, 4, 5]
    b = a[i:]
    c = a[:j]
    d = a[3:1]
    e = a[-9:2]
    f = a[1:-1]
    g = a[j:]
    s = "hello"
    t = s[-3:]
    u = s[2:99]
    v = s[4:1]
    w = s[i:j]
    return str(b) + str(c) + str(d) + str(e) + str(f) + str(g) + "|" + t + "|" + u + "|" + v + "|" + w
