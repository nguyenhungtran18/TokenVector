def pop_mot() -> "str":
    d = {}
    d["x"] = 5
    d["y"] = 7
    v = d.pop("x")
    d.pop("y")
    r = str(v) + str(len(d))
    try:
        d.pop("zz")
    except KeyError:
        r = r + "KE"
    return r


def ordered() -> "str":
    d = OrderedDict()
    d["b"] = 1
    d["a"] = 2
    return str(list(d.keys()))
