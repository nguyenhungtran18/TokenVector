# -*- coding: utf-8 -*-
"""Kiem chung fix bug that: thread_join() ep sai kieu i64 khi worker
thread_spawn() trai kieu khac i64 (vd f64/i32) - xem docs/BUGS_TODO.md,
phat hien luc benchmark that 2026-08-31 (InvalidCastException Task<Double>
-> Task<Int64> luc chay, khong bi bat luc bien dich). Root cause kep:
1) FIRST PASS: EXPR_BUILTIN_DTYPE['thread_join'] la HANG SO TINH 'i64',
   khien bien nhan ('r1') bi khai bao SAI kieu tru khi worker THAT tra i64.
2) SECOND PASS: ctx['_assign_target_name'] duoc DOC (threading_feature.py)
   nhung chua tung duoc GHI o dau ca (_stmt_assign_scalar) - khien
   ctx['_thread_ret_types'] luon rong, castclass luon mac dinh Task<int64>."""


def worker_f64() -> "f64":
    total = 0.0
    i = 0
    while i < 100:
        total = total + 1.5
        i = i + 1
    return total


def worker_i32() -> "i32":
    total = 0
    i = 0
    while i < 100:
        total = total + 2
        i = i + 1
    return total


def run_f64() -> "str":
    h1 = thread_spawn(worker_f64)
    h2 = thread_spawn(worker_f64)
    r1 = thread_join(h1)
    r2 = thread_join(h2)
    return str(r1 + r2)


def run_i32() -> "str":
    h1 = thread_spawn(worker_i32)
    r1 = thread_join(h1)
    return str(r1)


def run_mixed() -> "str":
    # 2 handle f64 + 1 handle i32 trong CUNG 1 ham - xac nhan thread_ret_types
    # tra dung theo TUNG TEN BIEN, khong bi tram lan giua cac dtype khac nhau.
    hf1 = thread_spawn(worker_f64)
    hi1 = thread_spawn(worker_i32)
    hf2 = thread_spawn(worker_f64)
    rf1 = thread_join(hf1)
    ri1 = thread_join(hi1)
    rf2 = thread_join(hf2)
    return str(rf1) + "|" + str(ri1) + "|" + str(rf2)
