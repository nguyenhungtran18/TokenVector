"""Probe R1i: @__tkv_cpython_only__ tren method record."""

from tkv_pragma import __tkv_cpython_only__


class Ctx:
    prefix: "str"
    fns: "dict[str,func(i32)->i32]"

    def __init__(self, prefix, fns):
        self.prefix = prefix
        self.fns = fns

    @__tkv_cpython_only__
    def __getitem__(self, k):
        """Cau di tru: ban .py con doc ctx['prefix']."""
        return getattr(self, k)


def chay(c: "Ctx", ten: "str", v: "i32") -> "i32":
    f = c.fns[ten]
    return f(v)


def main(c: "Ctx") -> "i32":
    return chay(c, "x", 21)
