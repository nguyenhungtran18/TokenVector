# -*- coding: utf-8 -*-
"""Comprehension o VI TRI BIEU THUC (khong phai ve phai cua mot phep gan).

Macro comprehension (comprehension.py) khop `ten = [... for ...]` - CHI dang
GAN. Dang nam TRONG mot bieu thuc lon hon thi khong khop, va parser bao
"ky vong ']', gap 'for'".

Day la rao cuoi cua nhom "rao ngon ngu" do 2026-09-10.

CPython that tra 312."""


def demo(s: "str") -> "i32":
    n = len([t for t in s.split(",")])
    tong = 0
    for v in [x * 2 for x in [1, 2, 3]]:
        tong = tong + v
    return n * 100 + tong
