# test_reflection.tkv - Test module reflection.tkv
__tkv_import__ = "reflection"

def main() -> "i32":
    attrs = {}
    attrs["_seed"] = ""
    r1 = set_field_str(attrs, "name", "TokenVector")
    r2 = set_field_str(attrs, "version", "2.0")
    
    val = get_field_str(attrs, "name")
    has_v = has_field_str(attrs, "version")
    
    if r1 == 1 and r2 == 1 and val == "TokenVector" and has_v == 1:
        return 1
    return 0
