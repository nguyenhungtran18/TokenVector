# test_buffer.tkv - Test module buffer.tkv
#
# CO Y dung 64 va 7 (KHONG phai 1024): ban cu cua test dung dung 1024 -
# CHINH con so ma buffer_size() hardcode - nen no PASS ke ca khi ham sai
# hoan toan. Doi so lam test that su phan biet dung/sai (2026-08-03).
__tkv_import__ = "buffer"

def main() -> "i32":
    b = create_buffer(64)
    sz = buffer_size(b)
    b2 = create_buffer(7)
    sz2 = buffer_size(b2)
    if len(b) > 0 and sz == 64 and sz2 == 7:
        return 1
    return 0
