# test_http_server.tkv - Test module http_server.tkv
__tkv_import__ = "http_server"

def main() -> "i32":
    raw_req = "GET /api/v1/status HTTP/1.1\r\nHost: localhost\r\n\r\n"
    req_info = parse_http_request(raw_req)
    
    m = req_info["method"]
    p = req_info["path"]
    
    resp = build_http_response(200, "<h1>TokenVector Web Server OK</h1>")
    
    if m == "GET" and p == "/api/v1/status" and len(resp) > 0:
        return 1
    return 0
