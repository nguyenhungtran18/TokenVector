# test_collections.tkv - Test cho thu vien collections.tkv
__tkv_import__ = "collections"

def main() -> "i32":
    counts = {}
    counts["apple"] = 0
    counts = counter_add(counts, "apple")
    counts = counter_add(counts, "banana")
    counts = counter_add(counts, "apple")
    counts = counter_add(counts, "orange")
    counts = counter_add(counts, "apple")
    
    top = counter_most_common(counts)
    val = counter_get(counts, "apple")
    if top == "apple" and val == 3:
        return 1
    return 0
