# bench_suite.tkv - In-Process Benchmark Suite for TokenVector
__tkv_import__ = ["hashlib", "base64", "math", "eval", "datetime"]

def bench_sha256() -> "i64":
    t0 = datetime_ticks()
    i = 0
    while i < 100000:
        h = sha256("hello tokenvector benchmark")
        i = i + 1
    t1 = datetime_ticks()
    res = t1 - t0
    return res


def bench_math() -> "i64":
    t0 = datetime_ticks()
    i = 0
    while i < 1000000:
        g = gcd(4800, 1800)
        i = i + 1
    t1 = datetime_ticks()
    res = t1 - t0
    return res


def main() -> "i32":
    t_sha = bench_sha256()
    t_math = bench_math()
    
    if t_sha > 0 and t_math > 0:
        return 1
    return 0
