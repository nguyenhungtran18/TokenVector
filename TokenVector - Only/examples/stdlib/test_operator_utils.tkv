# test_operator_utils.tkv - Test module operator_utils.tkv
__tkv_import__ = "operator_utils"

def main() -> "i32":
    a = op_add_i32(10, 20)
    s = op_sub_i32(50, 15)
    m = op_mul_i32(4, 5)
    e = op_eq_str("hello", "hello")
    
    if a == 30 and s == 35 and m == 20 and e == 1:
        return 1
    return 0
