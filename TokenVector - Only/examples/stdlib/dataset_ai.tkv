# dataset_ai.tkv - 2 phep tinh so hoc, KHONG sinh du lieu nao
#
# ===================== NHAN: MOCK / PROTOTYPE =====================
# Ten "AI Dataset Generation Engine" la PHONG DAI. KHONG sinh dataset,
# KHONG doc/ghi file, KHONG co ngau nhien: generate_ai_dataset_sample()
# chi so tong 2 so voi 350; dataset_split_ratio() chi nhan 80/100.
# ==================================================================
def generate_ai_dataset_sample(id_num: "i32", f1: "i32", f2: "i32") -> "i32":
    tot = f1 + f2
    if tot > 350:
        return 1
    return 0


def dataset_split_ratio(samples: "i32") -> "i32":
    train_count = (samples * 80) / 100
    return train_count
