# compress_num_cli.tkv - CHE DO 'numbered': bo comment + docstring NHUNG giu
# SO DONG GOC o dau moi dong ('1435: ...'). Day la che do dung THUONG XUYEN:
# ban nen van dung duoc de SUA code (trich dan dung file:line), khong chi de
# doc hieu - nen khong con phai doc lai ban goc sau khi nen.
# Ngon ngu chua co argv nen dung chung 2 duong dan co dinh voi compress_cli.
__tkv_import__ = "universal_context_compressor"

def main() -> "i32":
    in_path = "D:\\Claude AI Project\\TokenVector\\TokenVector - Only\\examples\\stdlib\\_compress_in.txt"
    out_path = "D:\\Claude AI Project\\TokenVector\\TokenVector - Only\\examples\\stdlib\\_compress_out.txt"

    payload = read_file(in_path)
    compressed = compress_universal_num(payload, 1)
    savings = calculate_savings_percentage(len(payload), len(compressed))

    header = "[tkv-num|type:" + detect_content_type(payload) + "|savings_byte:" + str(savings) + "%|so dau dong = so dong GOC]\n"
    write_file(out_path, header + compressed)
    return savings
