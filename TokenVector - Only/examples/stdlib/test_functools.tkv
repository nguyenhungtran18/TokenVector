# test_functools.tkv - Test cho thu vien functools.tkv
__tkv_import__ = "functools"

def double_val(x: "i32") -> "i32":
    return x * 2

def is_even(x: "i32") -> "i32":
    if x % 2 == 0:
        return 1
    return 0

def main() -> "i32":
    nums = []
    nums.append(1)
    nums.append(2)
    nums.append(3)
    nums.append(4)
    
    doubled = map_i32(nums, double_val)
    evens = filter_i32(nums, is_even)

    if len(doubled) == 4 and len(evens) == 2:
        if doubled[0] == 2 and doubled[3] == 8:
            if evens[0] == 2 and evens[1] == 4:
                return 1
    return 0
