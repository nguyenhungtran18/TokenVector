# test_csv.tkv - Test cho thu vien csv.tkv
__tkv_import__ = "csv"

def main() -> "i32":
    line = "apple,10,fresh"
    fields = parse_csv_line(line)
    if len(fields) == 3:
        if fields[0] == "apple":
            formatted = format_csv_line(fields)
            if formatted == line:
                return 1
    return 0
