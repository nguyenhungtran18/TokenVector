# powerpoint_suite.tkv - TokenVector Enterprise PowerPoint (.pptx) Generator & Parser
__tkv_import__ = "zipfile"

def create_powerpoint_slide_xml(title_text: "str", body_text: "str") -> "str":
    # OpenXML PowerPoint Slide XML Schema
    slide_xml = "<?xml version='1.0'?><p:sld xmlns:p='http://schemas.openxmlformats.org/presentationml/2006/main'><p:cSld><p:spTree><p:sp><p:txBody><p:p><p:r><p:t>" + title_text + "</p:t></p:r></p:p></p:txBody></p:sp><p:sp><p:txBody><p:p><p:r><p:t>" + body_text + "</p:t></p:r></p:p></p:txBody></p:sp></p:spTree></p:cSld></p:sld>"
    return slide_xml


def package_pptx_presentation(dir_path: "str", pptx_output_path: "str", slide_title: "str") -> "i32":
    xml_data = create_powerpoint_slide_xml(slide_title, "Generated by TokenVector Native Compiler")
    slide_file = dir_path + "\\slide1.xml"
    write_file(slide_file, xml_data)
    ok = create_zip(dir_path, pptx_output_path)
    return ok
