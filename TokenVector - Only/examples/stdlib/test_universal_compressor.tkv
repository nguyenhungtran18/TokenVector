# test_universal_compressor.tkv - Test Universal AI Context Compressor Engine
__tkv_import__ = "universal_context_compressor"

def main() -> "i32":
    code_raw = "# Comment 1\n# Comment 2\n# Comment 3\nimport os\nimport sys\n\ndef process_data(item: str) -> bool:\n    x = 100\n    y = 200\n    return True\n"
    
    ctype_code = detect_content_type(code_raw)
    compressed_code = compress_code(code_raw)
    savings_code = calculate_savings_percentage(len(code_raw), len(compressed_code))
    
    log_raw = "2026-08-02 10:00:00 INFO Starting service with PID 12345 verbose log message\n2026-08-02 10:00:01 DEBUG Verbose heartbeat 1 checking network status\n2026-08-02 10:00:02 DEBUG Verbose heartbeat 2 checking cache status\n2026-08-02 10:00:03 DEBUG Verbose heartbeat 3 checking disk status\n2026-08-02 10:00:04 ERROR NullPointerException at DatabaseConnection.java:42\n2026-08-02 10:00:05 Traceback (most recent call last):\n2026-08-02 10:00:06 FAILED to connect to DB\n"
    
    ctype_log = detect_content_type(log_raw)
    compressed_log = compress_log(log_raw)
    savings_log = calculate_savings_percentage(len(log_raw), len(compressed_log))
    
    formatted_gemini = format_universal_ai_request("Antigravity-Gemini", code_raw)
    formatted_claude = format_universal_ai_request("Claude-Code", log_raw)
    
    if ctype_code == "code" and ctype_log == "log":
        if savings_code > 0 and savings_log > 0:
            if len(formatted_gemini) > 0 and len(formatted_claude) > 0:
                return 1
                
    return 0
