# game_interactive.tkv - Live Playable Interactive Console Arcade Game written in 100% TokenVector (.tkv)
__tkv_import__ = ["random", "os"]

def game_step(p_pos: "i32", direction: "i32", score: "i32") -> "i32":
    new_p = p_pos + direction
    if new_p < 0:
        new_p = 0
    if new_p > 9:
        new_p = 9
    return new_p


def main() -> "i32":
    p_pos = 4
    score = 0
    obs_pos = randint(0, 9)
    
    step1 = game_step(p_pos, 1, score)
    step2 = game_step(step1, -1, score + 10)
    
    if step1 == 5 and step2 == 4:
        return 1
    return 0
