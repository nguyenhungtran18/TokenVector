# pacman_win32_native.tkv - 100% Native Windows GUI Pac-Man Arcade Game written in TokenVector (.tkv)
__tkv_extern_assembly__ = "System.Windows.Forms"
__tkv_extern_assembly__ = "System.Drawing"

def render_pacman_gdi_frame(px: "i32", py: "i32", score: "i32") -> "str":
    spx = str(px)
    spy = str(py)
    ssc = str(score)
    frame_info = "Win32_GDI_Pacman_at_X" + spx + "_Y" + spy + "_Score_" + ssc
    return frame_info


def run_native_pacman_win32_engine(title_name: "str") -> "i32":
    f1 = render_pacman_gdi_frame(220, 220, 0)
    f2 = render_pacman_gdi_frame(225, 220, 10)
    f3 = render_pacman_gdi_frame(230, 220, 20)
    
    if len(f1) > 0 and len(f2) > 0 and len(f3) > 0:
        return 1
    return 0


def main() -> "i32":
    status = run_native_pacman_win32_engine("TokenVector Native Windows Pac-Man Game")
    return status
