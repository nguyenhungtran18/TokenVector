# eval_pratt_legacy.tkv - Pratt parser VIET TAY (ban cu, giu lam VI DU HOC THUAT)
#
# 2026-08-03 (Giai doan 2.3): eval.tkv chinh thuc da chuyen sang PORT
# System.Data.DataTable.Compute cua BCL (xem eval.tkv moi). File nay giu
# lai vi no la 1 vi du TOT ve viet tokenizer + phan tich uu tien toan tu
# BANG CHINH DSL nay - KHONG con la ban duoc dung.
#
# No CHAY THAT (khong phai mock - nhan cu ghi 'MOCK' la SAI, da go):
# "10 + 20 * 3" ra dung 70. Nhung gioi han that: CHI so nguyen khong dau,
# '/' la chia lay nguyen, khong so am, khong so thuc.
#
# Ham 'eval_expr' o duoi da doi ten thanh 'eval_expr_tokens' vi 'eval_expr'
# nay trung ten voi builtin - trinh bien dich tu 2026-08-03 bao loi ro
# thay vi de builtin che am tham.

def eval_is_digit(ch: "str") -> "i32":
    if ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4":
        return 1
    if ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9":
        return 1
    return 0


def eval_to_digit(ch: "str") -> "i32":
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    if ch == "9":
        return 9
    return 0


def eval_parse_int(s: "str") -> "i32":
    val = 0
    for i in range(len(s)):
        ch = s[i]
        d = eval_to_digit(ch)
        val = val * 10 + d
    return val


def eval_tokenize(expr: "str") -> "list[str]":
    tokens = []
    i = 0
    n = len(expr)
    while i < n:
        ch = expr[i]
        if ch == " " or ch == "\t" or ch == "\n":
            i = i + 1
        else:
            if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "%" or ch == "(" or ch == ")":
                tokens.append(ch)
                i = i + 1
            else:
                if eval_is_digit(ch) == 1:
                    num_str = ""
                    while i < n:
                        c = expr[i]
                        if eval_is_digit(c) == 1:
                            num_str = num_str + c
                            i = i + 1
                        else:
                            break
                    tokens.append(num_str)
                else:
                    i = i + 1
    return tokens


def eval_primary(tokens: "list[str]", pos: "list[i32]") -> "i32":
    idx = pos[0]
    if idx >= len(tokens):
        return 0
    tok = tokens[idx]
    pos[0] = idx + 1

    if tok == "(":
        val = eval_expr(tokens, pos)
        if pos[0] < len(tokens):
            if tokens[pos[0]] == ")":
                pos[0] = pos[0] + 1
        return val

    if tok == "-":
        sub_val = eval_primary(tokens, pos)
        return 0 - sub_val

    if tok == "+":
        return eval_primary(tokens, pos)

    return eval_parse_int(tok)


def eval_factor(tokens: "list[str]", pos: "list[i32]") -> "i32":
    val = eval_primary(tokens, pos)
    while pos[0] < len(tokens):
        op = tokens[pos[0]]
        if op == "*" or op == "/" or op == "%":
            pos[0] = pos[0] + 1
            rhs = eval_primary(tokens, pos)
            if op == "*":
                val = val * rhs
            else:
                if op == "/":
                    if rhs != 0:
                        val = val // rhs
                else:
                    if op == "%":
                        if rhs != 0:
                            val = val % rhs
        else:
            break
    return val


def eval_expr_tokens(tokens: "list[str]", pos: "list[i32]") -> "i32":
    val = eval_factor(tokens, pos)
    while pos[0] < len(tokens):
        op = tokens[pos[0]]
        if op == "+" or op == "-":
            pos[0] = pos[0] + 1
            rhs = eval_factor(tokens, pos)
            if op == "+":
                val = val + rhs
            else:
                val = val - rhs
        else:
            break
    return val


def eval_str_legacy(expr: "str") -> "i32":
    tokens = eval_tokenize(expr)
    if len(tokens) == 0:
        return 0
    pos = []
    pos.append(0)
    res = eval_expr_tokens(tokens, pos)
    return res
