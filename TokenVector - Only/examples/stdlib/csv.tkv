# csv.tkv - CSV Parser & Formatter (RFC-4180 toi gian)
#
# 2026-08-03 (Giai doan 2.2): thay line.split(",") bang state machine
# kinh dien co co in_quotes. Ban cu tach SAI moi dong co dau ',' BEN
# TRONG truong trich dan - vd 'a,"x,y",b' ra 4 truong thay vi 3, va giu
# nguyen ca dau nhay kep trong ket qua.
#
# LAM DUNG RFC-4180: truong boc "..." giu nguyen dau ',' ben trong; dau
# nhay kep doi "" ben trong truong trich dan = 1 dau nhay kep that;
# truong rong; dong rong -> 1 truong rong (giong csv.reader cua Python).
# CHUA LAM (ghi ro): xuong dong BEN TRONG truong trich dan (RFC-4180 cho
# phep) - ham nay xu ly TUNG DONG mot nen khong thay duoc; dau phan cach
# khac ',' (chua tham so hoa).

def parse_csv_line(line: "str") -> "list[str]":
    fields = []
    cur = ""
    in_quotes = 0
    i = 0
    n = len(line)
    while i < n:
        ch = line[i]
        if in_quotes == 1:
            if ch == "\"":
                nxt = ""
                if i + 1 < n:
                    nxt = line[i + 1]
                if nxt == "\"":
                    cur = cur + "\""
                    i = i + 1
                else:
                    in_quotes = 0
            else:
                cur = cur + ch
        else:
            if ch == "\"":
                in_quotes = 1
            else:
                if ch == ",":
                    fields.append(cur)
                    cur = ""
                else:
                    cur = cur + ch
        i = i + 1
    fields.append(cur)
    return fields


def csv_field_needs_quote(field: "str") -> "i32":
    i = 0
    n = len(field)
    while i < n:
        ch = field[i]
        if ch == "," or ch == "\"":
            return 1
        i = i + 1
    return 0


def csv_quote_field(field: "str") -> "str":
    res = "\""
    i = 0
    n = len(field)
    while i < n:
        ch = field[i]
        if ch == "\"":
            res = res + "\"\""
        else:
            res = res + ch
        i = i + 1
    res = res + "\""
    return res


def format_csv_line(fields: "list[str]") -> "str":
    result = ""
    for i in range(len(fields)):
        piece = fields[i]
        if csv_field_needs_quote(piece) == 1:
            piece = csv_quote_field(piece)
        if i > 0:
            result = result + "," + piece
        else:
            result = piece
    return result
