# test_itertools.tkv - Test module itertools.tkv
__tkv_import__ = "itertools"

def main() -> "i32":
    items = []
    items.append(10)
    items.append(20)
    items.append(30)
    items.append(40)
    items.append(50)
    
    t = take_i32(items, 3)
    r = repeat_i32(7, 4)
    
    if len(t) == 3 and len(r) == 4:
        return 1
    return 0
