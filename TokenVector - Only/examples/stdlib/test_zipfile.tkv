# test_zipfile.tkv - Test module zipfile.tkv (create_zip & extract_zip)
__tkv_import__ = ["os", "zipfile", "shutil", "datetime"]

def main() -> "i32":
    t = datetime_ticks()
    ticks_str = str(t)
    src_dir = "temp_zip_src_" + ticks_str
    out_zip = "temp_output_" + ticks_str + ".zip"
    dest_dir = "temp_zip_dest_" + ticks_str
    
    _res_dir = os_mkdir(src_dir)
    r1 = create_zip(src_dir, out_zip)
    r2 = extract_zip(out_zip, dest_dir)
    
    rm1 = rmtree(src_dir)
    rm2 = rmtree(dest_dir)
    
    if r1 == 1 and r2 == 1 and _res_dir == 1:
        return 1
    return 0
