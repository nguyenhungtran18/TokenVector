# lexer.tkv - Self-Hosted TokenVector Lexer / Tokenizer

def is_alpha(ch: "str") -> "i32":
    if ch >= "a" and ch <= "z":
        return 1
    if ch >= "A" and ch <= "Z":
        return 1
    if ch == "_":
        return 1
    return 0


def is_digit(ch: "str") -> "i32":
    if ch >= "0" and ch <= "9":
        return 1
    return 0


def is_alnum(ch: "str") -> "i32":
    a = is_alpha(ch)
    d = is_digit(ch)
    if a == 1 or d == 1:
        return 1
    return 0


def tokenize_line(line: "str") -> "list[str]":
    tokens = []
    n = len(line)
    i = 0
    while i < n:
        ch = line[i]
        if ch == " " or ch == "\t":
            i = i + 1
        else:
            if is_alpha(ch) == 1:
                start = i
                while i < n:
                    if is_alnum(line[i]) == 1:
                        i = i + 1
                    else:
                        break
                tok = line[start:i]
                tokens.append(tok)
            else:
                if is_digit(ch) == 1:
                    start = i
                    while i < n:
                        if is_digit(line[i]) == 1:
                            i = i + 1
                        else:
                            break
                    tok = line[start:i]
                    tokens.append(tok)
                else:
                    if ch == "\"" or ch == "'":
                        quote = ch
                        start = i
                        i = i + 1
                        while i < n:
                            if line[i] != quote:
                                i = i + 1
                            else:
                                break
                        if i < n:
                            i = i + 1
                        tok = line[start:i]
                        tokens.append(tok)
                    else:
                        tokens.append(ch)
                        i = i + 1
    return tokens
