# test_cross_platform.tkv - Test module cross_platform.tkv
__tkv_import__ = "cross_platform"

def main() -> "i32":
    b_win = build_cross_target_binary("app", "windows")
    b_lin = build_cross_target_binary("app", "linux")
    b_mac = build_cross_target_binary("app", "macos")
    b_wasm = build_cross_target_binary("app", "web")
    
    n1 = len(b_win)
    n2 = len(b_lin)
    n3 = len(b_mac)
    n4 = len(b_wasm)
    
    if n1 > 0 and n2 > 0 and n3 > 0 and n4 > 0:
        return 1
    return 0
