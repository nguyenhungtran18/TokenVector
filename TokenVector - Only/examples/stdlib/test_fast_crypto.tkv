# test_fast_crypto.tkv - Test module fast_crypto.tkv
__tkv_import__ = "fast_crypto"

def main() -> "i32":
    h1 = sha256_fast_direct("tokenvector direct crypto speed")
    h2 = md5_fast_direct("tokenvector direct crypto speed")
    
    if len(h1) == 64 and len(h2) == 32:
        return 1
    return 0
