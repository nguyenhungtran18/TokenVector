# -*- coding: utf-8 -*-

def bm_add(reps: "i32", n: "i32") -> "i32":
    half = n // 2
    a = []
    b = []
    r = []
    i = 0
    while i < n:
        a.append(0.0)
        i = i + 1
    i = 0
    while i < half:
        b.append(0.0)
        i = i + 1
    i = 0
    while i < half:
        r.append(0.0)
        i = i + 1
    i = 0
    while i < n:
        a[i] = (i % 97) * 0.1
        i = i + 1
    i = 0
    while i < half:
        b[i] = (i % 4) + 1.0
        i = i + 1
    k = 0
    cs = 0.0
    csq = 0.0
    while k < reps:
        i = 0
        while i < half:
            r[i] = a[i] + b[i]
            i = i + 1
        i = 0
        while i < half:
            r[i] = a[half + i] + b[i]
            i = i + 1
        cs = 0.0
        csq = 0.0
        i = 0
        while i < half:
            cs = cs + r[i]
            csq = csq + r[i] * r[i]
            i = i + 1
        k = k + 1
    print("sum=" + str(cs) + " sumsq=" + str(csq))
    return 0


def main() -> "i32":
    bm_add(20, 262144)
    return 0
