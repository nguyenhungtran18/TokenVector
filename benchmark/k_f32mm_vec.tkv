# -*- coding: utf-8 -*-
# P4: matmul f32 vector hoa, de DO do lech do v_hsum4 gay ra.
#
# Dung CHUNG du lieu voi k_f32mm.tkv: a[i]=(i%97)*0.1, b[i]=(i%89)*0.07, n=32.
# Ban scalar in ra 4 probe tung phan tu + tong; ban nay in y het de doi
# truc tiep voi chuan f64 chinh xac (py_ref_f32.py) bang dung sai 1e-5
# theo phan tu - dung sai do O P0, KHONG phai doan.
#
# Hinh thuc tich luy (dung, va la noi duy nhat goi v_hsum4):
#   acc = 0 (4 lane) ; acc += va*vb theo k buoc 4 ; s = v_hsum4(acc)
# => chi MOT lan goi hsum cho ca 32 buoc k, va 4 tich luy tang len song.
# Tái sắp xếp vì thay co la 4 chuoi cong TICH LUY song song roi gop mot
# lan cuoi, thay vi mot chuoi cong tuan tu.

def main() -> "i32":
    n = 32
    m = n * n
    a = []
    b = []
    i = 0
    while i < m:
        a.append((i % 97) * 0.1)
        i = i + 1
    i = 0
    while i < m:
        b.append((i % 89) * 0.07)
        i = i + 1

    # DUA DU LIEU VAO CON TRO THO de v_load4 nap duoc 16 byte lien tiep.
    #
    # `pt` la B DA DONG GOI THEO COT - BAT BUOC, khong phai toi uu. Ban
    # scalar doc `b[kk*n + j]`: boi do doc COT j cua B, buoc nhay k lien
    # tuc 1 cach nhay n, nen khong nap duoc bang 1 lenh 16 byte. Neu nap
    # `b[j*n + k]` (HAO) thi doc HANG j - ket qua sai hoan toan (do: rel-err
    # ~0.5, khong phai lech lam tron).
    pa = alloc_bytes(m * 4)
    pb = alloc_bytes(m * 4)
    pt = alloc_bytes(m * 4)
    i = 0
    while i < m:
        write_f32(pa, i * 4, a[i])
        write_f32(pb, i * 4, b[i])
        i = i + 1
    i = 0
    while i < n:
        j = 0
        while j < n:
            write_f32(pt, (j * n + i) * 4, b[i * n + j])
            j = j + 1
        i = i + 1

    r = []
    i = 0
    while i < m:
        r.append(0.0)
        i = i + 1

    # 100 matmul nhu ban scalar (k_f32mm.tkv goi bm_f32mm(100, 32)) - de chi phi
    # dung buffer/transpose duoc amortization, cong bang ve so matmul. So 100
    # chu khong phai 4 vi ly do do o k_f32mm.tkv: 4 vong chi ton ~1.3ms so
    # voi ~25ms khoi dong, tuc 95% phong do la khoi dong va tru no con mang
    # sai so loi hon ca phan tinh.
    reps = 100
    rp = 0
    while rp < reps:
        i = 0
        while i < n:
            j = 0
            while j < n:
                acc = f32x4(0.0, 0.0, 0.0, 0.0)
                k = 0
                while k + 3 < n:
                    va = v_load4(pa, (i * n + k) * 4)
                    vb = v_load4(pt, (j * n + k) * 4)
                    acc = acc + va * vb
                    k = k + 4
                r[i * n + j] = v_hsum4(acc)
                j = j + 1
            i = i + 1
        rp = rp + 1

    cs = 0.0
    i = 0
    while i < m:
        cs = cs + r[i]
        i = i + 1
    print("p0=" + str(r[0]) + " p1=" + str(r[7]) + " p2=" + str(r[500]) + " p3=" + str(r[1023]) + " sum=" + str(cs))
    free_bytes(pa)
    free_bytes(pb)
    free_bytes(pt)
    return 0
