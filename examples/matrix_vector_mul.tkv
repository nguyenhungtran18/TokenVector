def matvec_sum(n: "i32") -> "f32":
    m = []
    for i in range(n):
        for j in range(n):
            m.append((i + j) * 1.0)
    v = []
    for i in range(n):
        v.append(i * 1.0)
    y = []
    for i in range(n):
        s = 0.0
        for j in range(n):
            s = s + m[i * n + j] * v[j]
        y.append(s)
    total = 0.0
    for i in range(n):
        total = total + y[i]
    return total
